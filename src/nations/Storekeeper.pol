import Agents.World.Bill;
program AgentsExe;

// WHAT A PLACE THAT KEEPS GOODS CAN BE ASKED, so a city can answer like its own store.
//
// The nation layout gives the city two delegates and this is one of them: `City` HAS a `Storehouse`
// and answers like it, so `if (city >= cost)` is written once, at the affordability question, and
// the fourteen hand-written forwarders never get written.
//
// TWO DELEGATES ON ONE CLASS is legal only because the two interfaces share no method name, and
// this is the second of the pair -- `Landholder` is the other. Nothing here is called `claim`,
// `release`, `owns` or `area`.
public bundle Agents {
    public namespace Nations {

        public interface Storekeeper {
            // Whether what is held covers a bill, item for item. Not a total: a store with four
            // hundred berries and no wood does not cover a hut, and a sum would say it did.
            method covers(Bill cost) returns boolean;

            // Take goods out, and put goods in. Both saturate at nothing rather than going negative:
            // a negative in a store is a debt nothing in this world can hold.
            method draw(Bill cost) returns void;
            method take(Bill got) returns void;

            // How much of one good is here.
            method howMuch(int good) returns int;

            // Everything, whatever the kind -- what a larder answers when asked how much food it has
            // rather than which foods.
            method stock() returns int;

            // ONE GOOD AT A TIME, which is what a person walking in with an armful actually does: a
            // carrier holds a kind and an amount, not a bill. `takeOut` answers how much was really
            // got, because the caller has to know whether it may eat.
            method put(int good, int many) returns void;
            method takeOut(int good, int many) returns int;
        }
    }
}
