program AgentsExe;

// WHICH NATION, as a type of its own rather than an int.
//
// The same reason every id here is a `newtype`: a nation index, a city index, a subdivision index
// and an agent index are all integers, they are all in scope in the same methods, and nothing but
// the type stops one being passed where another belongs. See `CityId`, which came first.
public bundle Agents {
    public namespace Nations {

        public newtype NationId = int;
    }
}
