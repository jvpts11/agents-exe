import System.Collections.ArrayList;
import System.Errors.Result;
import System.Errors.Ok;
import System.Errors.Err;
import Agents.Nations.Nation;
import Agents.Nations.NationId;
import Agents.Nations.Subdivision;
import Agents.Nations.SubdivisionId;
import Agents.Nations.Building;
import Agents.Nations.City;
import Agents.Nations.Refusal;
import Agents.People.BuildingId;
import Agents.People.CityId;
import Agents.People.Population;
import Agents.People.Whereabouts;

program AgentsExe;

// THE NATIONS AND WHAT THEY HOLD -- the other half of the world, beside `Population`.
//
// The Sim's own note said this arrives the way the crowd did, adding one line to the tick, and this
// is that. What it ticks today is one question: is there a country yet, and if not, why not.
//
// WHY THE REFUSALS ARE COUNTED HERE. The nation model requires a world that never founds a city to
// say which of six reasons it was. That answer has to survive to the end of a run, and the thing
// that lives that long is this. `match` over the sealed `Refusal` is what makes the tally complete
// by construction: a seventh reason does not compile until it has an arm here.
public bundle Agents {
    public namespace Nations {

        public class Atlas {
            // One roll of the subdivision's room, so a nation is not the same shape every run.
            public static fixed int LEAST_ROOM = 4;
            public static fixed int MOST_ROOM = 8;

            // The countries. Owned: an Atlas that goes takes the whole tree with it.
            private mutable ArrayList<Nation*>* nations;
            // How many cities have ever been founded, which is also the next city's name.
            private mutable int founded;
            // How many subdivisions have ever been made, likewise.
            private mutable int divisions;
            // One counter per refusal, indexed by the enum's ordinal. See `noteRefusal`.
            private mutable int[] refusals;
            // WHO HOLDS EVERY CELL IN THE WORLD -- a city's number plus one, or zero for nobody.
            //
            // ON THE ATLAS AND NOT ON THE GROUND, for the reason the layout gives about ruins: who
            // owns a tile is a political fact and not a property of the earth. A `Grid` that carried
            // it would answer a question about nations while claiming to be the terrain.
            //
            // ONE MAP, because a cell has one owner. Every city's `Territory` writes its own cells
            // into this one array, so "who holds this" is one read rather than a walk of every city
            // -- which is what the border draw and the growth both do per cell.
            private mutable int[] owner;

            public constructor Atlas(int cells) {
                this.nations = new ArrayList<Nation*>() on heap;
                this.founded = 0;
                this.divisions = 0;
                this.refusals = new int[Refusal.count()]();
                this.owner = new int[cells]();
            }

            // Who holds a cell: a city's number, or -1 for nobody. The map stores number+1 so that
            // an array that arrives zeroed already reads as unowned.
            public method ownerAt(int cell) returns CityId {
                if (cell < 0 || cell >= owner.length()) {
                    return cast<CityId>(0 - 1);
                }
                return cast<CityId>(owner[cell] - 1);
            }

            // The map itself, for the part that holds ground. Borrowed: the Atlas owns it, and a
            // `Territory` writes its own cells into it.
            public method ownerMap() returns int[] {
                return owner;
            }

            public method nationCount() returns int {
                return nations.size();
            }
            public method nationAt(int i) returns Nation* {
                return nations.get(i);
            }
            public method cityCount() returns int {
                mutable int total = 0;
                for (var one in nations.toArray()) {
                    total = total + one.cityCount();
                }
                return total;
            }
            public method population() returns int {
                mutable int total = 0;
                for (var one in nations.toArray()) {
                    total = total + one.population();
                }
                return total;
            }

            // THE CITY WITH THAT NAME, or none. A walk of the tree rather than an index beside it:
            // an agent asks this when it wants to go home, which is a handful of times in a life,
            // and a second structure holding the same cities is the second place they can disagree.
            // If cities ever number in the thousands and this is asked every tick, that is the
            // moment to keep one -- and not before, on a measurement rather than a guess.
            public method cityNamed(CityId which) returns nullable City* {
                for (int n in 0..nations.size()) {
                    Nation* who = nations.get(n);
                    for (int s in 0..who.subdivisionCount()) {
                        Subdivision* part = who.subdivisionAt(s);
                        for (int c in 0..part.cityCount()) {
                            City* one = part.cityAt(c);
                            if (one.nameOf() == which) {
                                return one;
                            }
                        }
                    }
                }
                return null;
            }

            // THE BUILDING SOMEBODY SLEEPS IN, or none -- for the two questions an agent asks about
            // its bed: whether it is worth walking to one, and where. Both go through here so they
            // cannot answer differently, which is the same rule the seam itself is kept by.
            public method homeOf(CityId city, BuildingId which) returns nullable Building* {
                int at = cast<int>(which);
                if (at == Whereabouts.NOWHERE) {
                    return null;
                }
                nullable City* town = cityNamed(city);
                if (town == null) {
                    return null;
                }
                if (at < 0 || at >= town.buildingCount()) {
                    return null;
                }
                return town.buildingAt(at);
            }

            // THE FIRST CITY MAKES THE COUNTRY. A city needs a subdivision to sit in and a
            // subdivision needs a nation, so founding on an empty Atlas builds all three -- and the
            // city that did it is the capital. Every later city finds a subdivision with room, and
            // is refused when there is none rather than growing one nobody asked for.
            //
            // `dice` decides the subdivision's room, once, when one is made.
            // `folk` is handed straight through rather than held: the Atlas asks the population
            // nothing, but every city it makes must reach it -- a resident's `homeCity` is written
            // by the city's own enrolment socket, which is the only place that field is written.
            public method found(Population* folk, int centreX, int centreY, int storeX, int storeY,
                                int room) returns Result<City*, Refusal> {
                mutable Nation* home = 0 as Nation*;
                if (nations.size() == 0) {
                    home = new Nation(cast<NationId>(0)) on heap;
                    nations.add(home);
                } else {
                    home = nations.get(0);
                }
                mutable nullable Subdivision* where = home.roomy();
                if (where == null && home.subdivisionCount() > 0) {
                    return new Err<City*, Refusal>(Refusal.NoRoomInSubdivision) on heap;
                }
                if (where == null) {
                    Subdivision* made = new Subdivision(cast<SubdivisionId>(divisions), room) on heap;
                    divisions = divisions + 1;
                    home.take(made);
                    where = made;
                }
                // THE COUNTER BECOMES A NAME HERE, and this is the only line in the game where it
                // does. A counter is a number while it counts and an id from the moment it names
                // something, so the cast belongs at the `new` -- not at each of the seams below,
                // which is where it used to be and where it said nothing about what had happened.
                CityId named = cast<CityId>(founded);
                City* one = new City(folk, named, centreX, centreY, storeX, storeY, owner) on heap;
                where.take(one);
                if (cast<int>(home.capitalCity()) == Nation.NO_CAPITAL) {
                    home.setCapital(named);
                }
                founded = founded + 1;
                return new Ok<City*, Refusal>(one) on heap;
            }

            // WHY A CITY WAS NOT FOUNDED, counted so the end of a run can say it. Indexed by the
            // constant's own ordinal, over an array the enum sizes -- so a seventh refusal is
            // counted the day it is declared, with nothing here to remember.
            public method noteRefusal(Refusal why) returns void {
                int slot = cast<int>(why);
                refusals[slot] = refusals[slot] + 1;
                return;
            }

            public method refusedFor(Refusal why) returns int {
                return refusals[cast<int>(why)];
            }

            // WHAT TO CALL A REFUSAL, and the one place a seventh one stops the build.
            //
            // The counting above cannot fail to include a new constant, and that is exactly why it
            // is not where the guarantee lives: a counter nobody prints is a counter nobody reads.
            // This `match` has no `default` and no fall-through, so the compiler names the constant
            // that has no sentence here -- and the run says all six reasons or does not build.
            private static method sentence(Refusal why) returns String {
                match (why) {
                    case NobodyLeft { return "nobody left"; }
                    case NoReachableGround { return "no reachable ground"; }
                    case TooClose { return "too close to another claim"; }
                    case NoRoomInSubdivision { return "no room in any subdivision"; }
                    case DiedOnTheRoad { return "died on the road"; }
                    case ArrivedWithoutTrades { return "arrived without trades"; }
                }
                return "";
            }

            // WHY THIS WORLD HAS NO COUNTRY, in one line, or "" when it has one. This is the
            // sentence the nation model demands: a world that never founds a city must say which of
            // the six it was, and it must say it in the run rather than in a debugger.
            public method whyNoCity() returns String {
                if (nations.size() > 0) {
                    return "";
                }
                mutable String said = "no city:";
                for (int i in 0..Refusal.count()) {
                    Refusal why = cast<Refusal>(i);
                    int many = refusals[i];
                    if (many > 0) {
                        said = said + " " + Atlas.sentence(why) + " x" + many.toString();
                    }
                }
                return said;
            }

            public destructor ~Atlas() returns void {
                for (var one in nations.toArray()) {
                    delete one;
                }
                delete nations;
                delete refusals;
                delete owner;
                return;
            }
        }
    }
}
