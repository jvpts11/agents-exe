import System.Collections.ArrayList;
import Agents.People.AgentId;
import Agents.People.BuildingId;
import Agents.People.CityId;
import Agents.People.Population;
import Agents.People.Agent;
import Agents.People.Whereabouts;
import Agents.Sim.Chain;
import Agents.Sim.TEnroller;
import Agents.Nations.Building;
import Agents.World.BuildingKind;
import Agents.Nations.Landholder;
import Agents.Nations.Storehouse;
import Agents.Nations.Storekeeper;
import Agents.Nations.Subdivision;
import Agents.Nations.Territory;

program AgentsExe;

// A CITY: THE ONLY THING IN THE GAME THAT HOLDS GROUND.
//
// A nation and a subdivision own nothing. The nation model is explicit about it -- the territory of
// a subdivision is the sum of its cities' and the territory of a nation is the sum of its
// subdivisions', so both are computed and neither is stored. That is what stops the churn the old
// model had, where three layers each kept their own idea of who owned a tile and drifted apart.
//
// WHAT IS HERE, AND WHAT IS NOT. The centre, the two buildings a founding places, what has since
// been raised, and the people who live here. Not the era, not the arrived technologies -- each
// arrives with the item that gives it a reader.
//
// THE RESIDENTS ARE IDS AND NOT POINTERS, and that is the seam rule rather than a preference: agents
// die and their slot is reused, so a pointer held by a city would one day name somebody else's
// person. The chain lives in the same pool every other chain in the game does.
public bundle Agents {
    public namespace Nations {

        public class City implements Landholder, Storekeeper applies TEnroller {
            // Its number, which is its name until there is a table of names to draw one from. A
            // `CityId` rather than an int because that is what the rest of the game already calls
            // it: `Atlas.cityNamed` looks a city up by this, a resident's `homeCity` holds this, and
            // both had to cast it back out of an int to compare. A city that is called "3" still
            // reads honestly as a city nobody has named yet.
            private mutable CityId name;
            // WHO LEADS IT. The city's ruler is the one the model calls new, and it calls its
            // absence a hole rather than a simplification: a city grew, fed itself, raised buildings
            // and sent out colonists with nobody accountable for any of it, while the two layers
            // above it had faces. A city is where people actually live.
            // AND IT IS AN `AgentId`, not an int. All three ids in this game are integers and all
            // three would compile where another was meant -- and handing a `CityId` here does not
            // crash, it indexes the people by a city's number and returns a plausible person.
            private mutable AgentId ruler;
            // The founding cell. Growth starts here and the town hall stands on it.
            private mutable int centreX;
            private mutable int centreY;
            // Where the storage building went. The model's founding places two things: the town hall
            // on the centre, and beside it the storehouse of the nation's era, "this way, a city
            // always have a way to storage things".
            //
            // STILL TWO CELLS AND NOT TWO `Building`s. `standing` now exists and these two could
            // move into it -- but a town hall with a roof of nought and no posts would be an entry
            // that answers no question the two ints do not, and the entry that DOES answer one (who
            // works there) arrives with the work layer. They join the list when they have a reason
            // to be in it.
            private mutable int storeX;
            private mutable int storeY;
            // WHAT IS UP. Owned: a city that goes takes its buildings with it. Houses today; the
            // workshops, the walls and the rest arrive with raising (S4.3).
            private mutable ArrayList<Building*>* standing;
            // The people this city's residents are drawn from, so the enrolment socket can reach
            // them. Borrowed -- the population outlives every city in the world.
            private mutable Population* folk;
            // THE GROUND, AND THE CITY ANSWERS LIKE IT. A delegate rather than a transformer, on the
            // layout's own test: a territory is a thing in its own right -- it has cells, you can
            // ask it what it holds, it would still mean something if no city existed. So the city
            // HAS one and forwards to it, and the fourteen hand-written forwarders never get
            // written. What a transformer takes over is the other shape -- a part invented only to
            // carry a field -- and this is not that.
            private delegate Territory territory;
            // AND WHAT IT HAS IN HAND, the second of the two delegates the layout gives the city.
            // Two on one class is legal because `Landholder` and `Storekeeper` share no method name
            // -- nothing in the store is called `claim`, `owns` or `area` -- and this is the first
            // place in the project to lean on that rule.
            //
            // A storehouse is a thing in its own right, so the city HAS one and answers like it:
            // `city.covers(cost)` is the affordability question asked of the city, once, with no
            // forwarder written by hand.
            private delegate Storehouse storehouse;

            public constructor City(Population* folk, CityId name, int centreX, int centreY,
                                    int storeX, int storeY, int[] owner) {
                this.folk = folk;
                this.name = name;
                this.ruler = Subdivision.NOBODY;
                this.centreX = centreX;
                this.centreY = centreY;
                this.storeX = storeX;
                this.storeY = storeY;
                this.standing = new ArrayList<Building*>() on heap;
                this.territory = new Territory(owner, name) on stack;
                this.storehouse = new Storehouse() on stack;
                // THE APPLIED FIELD IS THE OWNER'S TO MAKE. `TEnroller` has no constructor and
                // cannot fill this; the compiler refuses the class until this line exists.
                this.roll = new Chain<AgentId>() on heap;
            }

            public method nameOf() returns CityId {
                return name;
            }
            public method x() returns int {
                return centreX;
            }
            public method y() returns int {
                return centreY;
            }
            public method storeAtX() returns int {
                return storeX;
            }
            public method storeAtY() returns int {
                return storeY;
            }

            public method ruledBy() returns AgentId {
                return ruler;
            }
            public method setRuler(AgentId who) returns void {
                ruler = who;
                return;
            }
            public method headless() returns boolean {
                return ruler == Subdivision.NOBODY;
            }

            // THE ENROLMENT SOCKETS. A resident points back with `whereabouts.homeCity`, and this
            // is the only place in the game that field is written -- which is the difference between
            // this and the comment that used to stand here asking the caller to remember.
            protected procedure bindBack(AgentId who) returns void {
                Agent* body = folk.at(who);
                body.whereabouts.homeCity = name;
                return;
            }

            protected procedure unbindBack(AgentId who) returns void {
                Agent* body = folk.at(who);
                body.whereabouts.homeCity = cast<CityId>(Whereabouts.NOWHERE);
                return;
            }

            // ---- what is standing here -------------------------------------------------------

            // PUT ONE UP. The city makes its own buildings, and that is not ceremony: a building's
            // id IS its index here, and anything that could hold one before the city named it could
            // also admit a dweller and write "nowhere" into them. Made and named in one breath,
            // there is no such moment.
            public method raise(BuildingKind what, int cx, int cy) returns Building* {
                // The size becomes a name here, which is the one line where it does.
                Building* one = new Building(folk, cast<BuildingId>(standing.size()),
                                             what, cx, cy) on heap;
                standing.add(one);
                return one;
            }

            public method buildingCount() returns int {
                return standing.size();
            }

            public method buildingAt(int at) returns Building* {
                return standing.get(at);
            }

            // How many people this city can put a roof over, counting every roofed building it has.
            public method roofs() returns int {
                mutable int total = 0;
                for (int b in 0..standing.size()) {
                    total = total + standing.get(b).capacity();
                }
                return total;
            }

            // Whether one of its people has nowhere to sleep. Asked of the agent, which is the far
            // end of `THouser` and therefore the same fact the buildings' chains hold.
            public method unroofed(AgentId who) returns boolean {
                return folk.at(who).whereabouts.homeless();
            }

            // HOW MANY OF ITS PEOPLE HAVE NOWHERE TO SLEEP. Walked rather than counted, for the
            // reason the population is: two facts about one thing are two facts that can disagree.
            //
            // This is one of the two inputs to the lower engine of colonisation -- "no house, too
            // many people for the houses there are" -- and until this slice it was a number the
            // model asked for and nobody computed.
            public method homeless() returns int {
                mutable int many = 0;
                mutable int link = firstResident();
                while (link >= 0) {
                    if (folk.at(residentAt(link)).whereabouts.homeless()) {
                        many = many + 1;
                    }
                    link = afterResident(link);
                }
                return many;
            }

            public destructor ~City() returns void {
                // Everybody out of the roll and the links back to the pool, then the roll itself --
                // the applied field is the city's to free, and the compiler names it if this is
                // forgotten.
                dissolve();
                delete roll;
                for (int b in 0..standing.size()) {
                    delete standing.get(b);
                }
                delete standing;
                return;
            }
        }
    }
}
