import System.IO.Console;
import Agents.World.Good;
import Agents.World.Goods;
import Agents.World.Builds;
import Agents.World.BuildingKind;

// A BUILDING BEING RAISED. A thing in the world from the moment it is ordered.
//
// The version this replaces did not exist: a city "had" four hundred buildings because four
// hundred integers were in a list, and the world showed a field with a dome in it. Nothing was
// carried, nobody worked, and the number went up on a timer. A frame on the ground is the smallest
// honest version of a building that is not finished yet.
//
// Two rules from the design doc live here and nowhere else, because they are the two that a
// convenient implementation always quietly drops:
//
//   MATERIAL DELIVERED TO A SITE NEVER LEAVES IT. Once a plank is on this ground it belongs to
//   this building. Without that rule, two orders and one forest's worth of wood means both sites
//   hold half of what they need forever, and a poor village's normal state is more orders than
//   material.
//
//   A SITE WITH NOTHING RESERVED DOES NOT START. The reservation happens in the store before
//   anything is carried, so an order the city cannot afford never opens a hole to pour into.
program AgentsExe;

public bundle Agents {
    public namespace Nations {

        public class Site {
            public mutable int id;
            public mutable int kind;          // BuildingKind ordinal
            public mutable int city;
            public mutable int x;
            public mutable int y;
            // Which way it will face when it stands: 0 north, 1 east, 2 south, 3 west. Decided
            // when the ground is broken, so the frame and the finished building agree.
            public mutable int facing;

            // WHAT IT IS OWED, WHAT IS ON THE GROUND, AND WHAT IS WALKING TOWARDS IT.
            //
            // Three numbers per good and not two. Without `coming`, every builder who looks at the
            // site sees the same shortfall and they all fetch the same plank -- the queue defect
            // from the gathering slice, reappearing at the other end of the chain. A load that is
            // on somebody's shoulder is spoken for.
            public mutable int[] needs;
            public mutable int[] onSite;
            public mutable int[] coming;

            // Hashes made, of hashes wanted. Both from the kind's complexity, so they cannot drift.
            public mutable int work;
            public mutable int done;
            public mutable int ceiling;       // builders allowed at once, capped at sixteen
            public mutable int hands;         // builders on it right now

            public constructor Site(int who, int what, int inCity, int atX, int atY) {
                this.id = who;
                this.kind = what;
                this.city = inCity;
                this.x = atX;
                this.y = atY;
                // Fixed by the tile, so it never changes once broken and two neighbours do not
                // end up facing the same way by accident.
                this.facing = (((atX * 73856093) ^ (atY * 19349663)) >> 5) & 3;
                this.needs = new int[Goods.count()]();
                this.onSite = new int[Goods.count()]();
                this.coming = new int[Goods.count()]();
                this.work = Builds.totalWork(what);
                this.done = 0;
                this.ceiling = Builds.builderCeiling(what);
                this.hands = 0;
                this.needs[cast<int>(Good.Wood)] = Builds.woodCost(what);
                this.needs[cast<int>(Good.Stone)] = Builds.stoneCost(what);
                int third = Builds.matCost(what);
                if (third != cast<int>(Good.Nothing)) {
                    this.needs[third] = this.needs[third] + Builds.matCostN(what);
                }
            }

            public destructor ~Site() returns void {
                delete this.needs;
                delete this.onSite;
                delete this.coming;
                return;
            }

            // How much of a good the site is still short of, counting what is already walking
            // towards it. This is the number a builder acts on, and the reason it counts `coming`
            // is above.
            public method short(int good) returns int {
                int gap = this.needs[good] - this.onSite[good] - this.coming[good];
                if (gap < 0) {
                    return 0;
                }
                return gap;
            }

            // The first good this site is short of, or Nothing when everything has arrived.
            public method wants() returns int {
                mutable int g = 0;
                while (g < Goods.count()) {
                    if (this.short(g) > 0) {
                        return g;
                    }
                    g = g + 1;
                }
                return cast<int>(Good.Nothing);
            }

            // Whether the material is all here. Hashes only count once it is: a wall does not go
            // up faster because somebody is swinging at ground that has no stone on it.
            public method stocked() returns boolean {
                mutable int g = 0;
                while (g < Goods.count()) {
                    if (this.onSite[g] < this.needs[g]) {
                        return false;
                    }
                    g = g + 1;
                }
                return true;
            }

            public method finished() returns boolean {
                return this.done >= this.work;
            }

            // Dropped at the site, and from here it belongs to this building and no other. There
            // is deliberately no method that takes it back out.
            public method deliver(int good, int many) returns void {
                this.onSite[good] = this.onSite[good] + many;
                this.coming[good] = this.coming[good] - many;
                if (this.coming[good] < 0) {
                    this.coming[good] = 0;
                }
                return;
            }

            public method promise(int good, int many) returns void {
                this.coming[good] = this.coming[good] + many;
                return;
            }

            // A load that never arrived -- its carrier died, or the city was taken. The promise is
            // released so somebody else fetches it, which is not the same as the material moving.
            public method forget(int good, int many) returns void {
                this.coming[good] = this.coming[good] - many;
                if (this.coming[good] < 0) {
                    this.coming[good] = 0;
                }
                return;
            }

            // HOW FAR ALONG IT LOOKS, 0..1. The renderer raises the frame out of the ground by
            // this, which is what makes a site something you watch rather than something you read
            // about afterwards.
            public method progress() returns float {
                if (this.work <= 0) {
                    return 1.0;
                }
                return cast<float>(this.done) / cast<float>(this.work);
            }
        }
    }
}
