import System.IO.Console;
import System.Collections.ArrayList;
import Agents.World.Goods;
import Agents.Nations.Site;

// THE ONLY THING IN THE GAME THAT OWNS GROUND.
//
// A subdivision's territory is the sum of its cities'; a nation's is the sum of its subdivisions'.
// Neither of them stores a single cell. That is the whole shape of the model: territory exists in
// exactly one place, so it cannot disagree with itself.
//
// The one it replaces could. A nation was a label, and its ground was worked out from wherever its
// buildings happened to stand -- which meant the answer to "whose is this" depended on who was
// asking and when.
program AgentsExe;

public bundle Agents {
    public namespace Nations {

        public class City {
            public mutable int id;
            public mutable int name;          // catalogue number, not the text
            public mutable int subdivision;   // which subdivision it belongs to
            // WHERE IT STARTED. Expansion grows outwards from here and the hard radius is measured
            // from here, so a city that is founded knows its own shape before it owns anything.
            public mutable int cx;
            public mutable int cy;
            // THE CELLS IT OWNS, as packed y*w+x. This is the city's own view; the Realm keeps the
            // other one, per cell, for the renderer. Both are written by one method and checked
            // against each other by another -- see Realm.
            public mutable ArrayList<int>* tiles;
            public mutable ArrayList<int>* buildings;
            // WHAT EACH ONE IS, parallel to `buildings`. Until this existed a city held four
            // hundred cell indices and nothing said whether they were huts, kilns or the town hall
            // -- so the renderer could only ever draw the seat, and the economy could only count.
            public mutable ArrayList<int>* kinds;
            // WHICH WAY EACH ONE FACES: 0 north, 1 east, 2 south, 3 west. Four, not any angle --
            // a building sits square on its tile, and a row of huts at arbitrary angles reads as
            // debris rather than a village.
            public mutable ArrayList<int>* facing;
            // THE ONES NOT UP YET. A frame on the ground is a building in progress, and it stands
            // in the world from the moment the order is given rather than appearing finished out
            // of nothing. See Site.
            public mutable ArrayList<Site*>* sites;
            public mutable ArrayList<int>* residents;

            // WHAT THE CITY HAS IN HAND, by Good ordinal.
            //
            // The store is the city's, not a building's, until there is a StoragePit to hold it --
            // and that is the point: with nowhere to put things a gatherer walks to the town
            // centre, and with a pit he walks to the pit. The flow is source -> store -> site, and
            // this is the middle of it.
            public mutable int[] stock;
            // WHERE THIS TOWN LAST FOUND EACH KIND OF WORK, as a packed tile, or -1.
            //
            // A ring search out to a hundred tiles reads fifty thousand tiles for one answer, and
            // a miss reads all of them. Doing that fresh for every asker every pass was ninety per
            // cent of the frame. A town knows where its wood is: it looks there first and only
            // sweeps the country when the remembered place has run out.
            public mutable int[] lastFound;

            public constructor City(int who, int atX, int atY, int inSub) {
                this.id = who;
                this.cx = atX;
                this.cy = atY;
                this.subdivision = inSub;
                this.name = 0 - 1;
                this.tiles = new ArrayList<int>() on heap;
                this.buildings = new ArrayList<int>() on heap;
                this.kinds = new ArrayList<int>() on heap;
                this.facing = new ArrayList<int>() on heap;
                this.sites = new ArrayList<Site*>() on heap;
                this.residents = new ArrayList<int>() on heap;
                this.stock = new int[Goods.count()]();
                this.lastFound = new int[8]();
                mutable int h = 0;
                while (h < 8) {
                    this.lastFound[h] = 0 - 1;
                    h = h + 1;
                }
            }

            public destructor ~City() returns void {
                mutable int s = 0;
                while (s < this.sites.size()) {
                    delete this.sites.get(s);
                    s = s + 1;
                }
                delete this.sites;
                delete this.tiles;
                delete this.buildings;
                delete this.kinds;
                delete this.facing;
                delete this.residents;
                delete this.stock;
                delete this.lastFound;
                return;
            }

            // A building of this kind, standing. Asked before ordering another one, and asked by
            // the store to find out whether there is a StoragePit to keep anything in.
            public method has(int kind) returns boolean {
                mutable int b = 0;
                while (b < this.kinds.size()) {
                    if (this.kinds.get(b) == kind) {
                        return true;
                    }
                    b = b + 1;
                }
                return false;
            }

            public method howMany(int kind) returns int {
                mutable int n = 0;
                mutable int b = 0;
                while (b < this.kinds.size()) {
                    if (this.kinds.get(b) == kind) {
                        n = n + 1;
                    }
                    b = b + 1;
                }
                return n;
            }

            // Counting the frames as well as the finished ones. Without this a city orders a
            // second kiln every tick until the first one is up, because "do I have a kiln" is
            // false the whole time it is being built.
            public method building(int kind) returns int {
                mutable int n = 0;
                mutable int s = 0;
                while (s < this.sites.size()) {
                    if (this.sites.get(s).kind == kind) {
                        n = n + 1;
                    }
                    s = s + 1;
                }
                return n;
            }

            // Taken OUT of the store, and it fails rather than going negative. Reserving material
            // for a site is the one place that matters: a reservation that silently overdraws is
            // the same as no reservation at all.
            public method draw(int good, int many) returns boolean {
                if (this.stock[good] < many) {
                    return false;
                }
                this.stock[good] = this.stock[good] - many;
                return true;
            }

            public method have(int good) returns int {
                return this.stock[good];
            }

            public method take(int good, int many) returns void {
                this.stock[good] = this.stock[good] + many;
                return;
            }

            public method area() returns int {
                return this.tiles.size();
            }

            public method population() returns int {
                return this.residents.size();
            }

            public method houses() returns int {
                return this.buildings.size();
            }
        }
    }
}
