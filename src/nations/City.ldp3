import System.IO.Console;
import System.Collections.ArrayList;

// THE ONLY THING IN THE GAME THAT OWNS GROUND.
//
// A subdivision's territory is the sum of its cities'; a nation's is the sum of its subdivisions'.
// Neither of them stores a single cell. That is the whole shape of the model: territory exists in
// exactly one place, so it cannot disagree with itself.
//
// The one it replaces could. A nation was a label, and its ground was worked out from wherever its
// buildings happened to stand -- which meant the answer to "whose is this" depended on who was
// asking and when.
program AgentsExe;

public bundle Agents {
    public namespace Nations {

        public class City {
            public mutable int id;
            public mutable int name;          // catalogue number, not the text
            public mutable int subdivision;   // which subdivision it belongs to
            // WHERE IT STARTED. Expansion grows outwards from here and the hard radius is measured
            // from here, so a city that is founded knows its own shape before it owns anything.
            public mutable int cx;
            public mutable int cy;
            // THE CELLS IT OWNS, as packed y*w+x. This is the city's own view; the Realm keeps the
            // other one, per cell, for the renderer. Both are written by one method and checked
            // against each other by another -- see Realm.
            public mutable ArrayList<int>* tiles;
            public mutable ArrayList<int>* buildings;
            public mutable ArrayList<int>* residents;

            public constructor City(int who, int atX, int atY, int inSub) {
                this.id = who;
                this.cx = atX;
                this.cy = atY;
                this.subdivision = inSub;
                this.name = 0 - 1;
                this.tiles = new ArrayList<int>() on heap;
                this.buildings = new ArrayList<int>() on heap;
                this.residents = new ArrayList<int>() on heap;
            }

            public destructor ~City() returns void {
                delete this.tiles;
                delete this.buildings;
                delete this.residents;
                return;
            }

            public method area() returns int {
                return this.tiles.size();
            }

            public method population() returns int {
                return this.residents.size();
            }

            public method houses() returns int {
                return this.buildings.size();
            }
        }
    }
}
