program AgentsExe;

// WHICH SUBDIVISION. A `newtype` for the same reason as `NationId` and `CityId`: the layer between
// a nation and its cities is indexed like the other two, and an index that is only an int is an
// index that ends up in the wrong table exactly once.
public bundle Agents {
    public namespace Nations {

        public newtype SubdivisionId = int;
    }
}
