program AgentsExe;

// THE SIX WAYS FOUNDING A CITY FAILS, and the reason this is a type.
//
// The nation model requires that a world which never founds a city must be able to say WHICH of the
// six it was. Written as a boolean and a comment, that answer is a thing somebody remembers to
// count; written as a sealed enum behind a `Result`, it is a thing the compiler will not let a
// caller drop -- `match` over it does not compile until every refusal has an arm.
//
// A SEVENTH REASON ADDED NEXT YEAR IS A COMPILE ERROR, not a silent `continue`. That is the whole
// argument for the shape, and it is the defect this project has already paid for twice.
//
// Two of the six can fire today and four cannot, and that is not a reason to leave them out: they
// are the reasons a COLONIST fails, and colonists arrive in S3.2. A counter that reads zero until
// the code that raises it exists is honest; a reason that has to be invented later, when the arm
// that would have caught it is already written as a default, is not.
public bundle Agents {
    public namespace Nations {

        public sealed enum Refusal permits
            NobodyLeft,             // no band anywhere had enough people to be a city
            NoReachableGround,      // nobody was standing where a town may be built
            TooClose,               // the site is inside somebody else's claim (S3.2)
            NoRoomInSubdivision,    // every subdivision is at its capacity (S3.2)
            DiedOnTheRoad,          // the colonists never arrived (S3.2)
            ArrivedWithoutTrades;   // they arrived, and could not build (S4)
    }
}
