import Agents.World.CellId;

program AgentsExe;

// WHAT IT IS TO HOLD GROUND. A city answers these because it delegates to a `Territory`, which is
// the part that actually holds them -- the layout's own test for a delegate rather than a
// transformer: a territory would still mean something if no city existed.
//
// Four methods and no fifth. `claim` and `release` are the only two that WRITE, which is what makes
// the pair of structures behind them keepable: the list of cells and the world's owner map are
// written in one body, never separately.
public bundle Agents {
    public namespace Nations {

        public interface Landholder {
            // Is this cell ours.
            method owns(CellId cell) returns boolean;
            // How many cells we hold.
            method area() returns int;
            // Take a cell. False when somebody already holds it -- claiming is never a fight, and
            // never silently takes.
            method claim(CellId cell) returns boolean;
            // Give all of it back. The ground becomes ownerless, which is the model's §9: nothing is
            // merged, and a place that ends releases what it held.
            method release() returns void;
            // The `i`th cell held, so that whoever must walk this land can. The renderer draws the
            // border from it and the growth reads outward from it -- and both would otherwise have
            // to be handed the map and told which mark to look for, which is the holder's business
            // and nobody else's.
            //
            // `i` IS A POSITION IN THIS HOLDER'S LIST and the answer is a cell of the world: the
            // two numbers a method apart from each other in this interface, and the reason `CellId`
            // exists at all. See its own file.
            method cellAt(int i) returns CellId;
        }
    }
}
