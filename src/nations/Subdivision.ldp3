import System.Collections.ArrayList;

// THE LAYER BETWEEN, WHICH OWNS NOTHING.
//
// A subdivision has no cells of its own -- ask it for territory and it answers by asking its
// cities. What it has instead is a RULER, and that is not decoration: a duke of a prospering
// subdivision is a person with means, and people with means are what mount expeditions. The layer
// earns its place through him rather than through land.
//
// `capacity` is rolled once, between four and eight, when the subdivision is created. A new city
// joins a subdivision that has room; when none has room, another subdivision is created. That is
// the only rule the layer needs, and it is why two nations of the same size are not administered
// the same way.
program AgentsExe;

public bundle Agents {
    public namespace Nations {

        public class Subdivision {
            public mutable int id;
            public mutable int name;          // catalogue number, not the text
            public mutable int nation;
            public mutable int ruler;         // agent id
            public mutable int capacity;      // 4..8, rolled at creation
            public mutable ArrayList<int>* cities;

            public constructor Subdivision(int who, int inNation, int holds) {
                this.id = who;
                this.nation = inNation;
                this.capacity = holds;
                this.name = 0 - 1;
                this.ruler = 0 - 1;
                this.cities = new ArrayList<int>() on heap;
            }

            public destructor ~Subdivision() returns void {
                delete this.cities;
                return;
            }

            public method hasRoom() returns boolean {
                return this.cities.size() < this.capacity;
            }
        }
    }
}
