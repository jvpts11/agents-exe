import System.IO.Console;
import System.Math.Math;
import System.Collections.ArrayList;
import Agents.World.Grid;
import Agents.World.Biomes;
import Agents.People.Folk;
import Agents.People.Agent;
import Agents.World.Nodes;
import Agents.World.NodeKind;
import Agents.World.Good;
import Agents.World.Goods;
import Agents.World.Harvest;
import Agents.World.Craft;
import Agents.World.Gathers;
import Agents.World.Builds;
import Agents.World.BuildingKind;
import Agents.Sim.Meter;
import Agents.Sim.Phase;
import Agents.Nations.Site;
import Agents.Nations.Nation;
import Agents.Nations.Subdivision;
import Agents.Nations.City;

// EVERY POLITICAL THING IN THE WORLD, AND WHO OWNS EACH CELL.
//
// The register lives apart from the Grid on purpose. The Grid is the PHYSICAL world -- elevation,
// biome, what is buried under a cell -- and none of that changes because somebody drew a border.
// Who owns a cell is not a physical fact, so it does not belong in the description of the rock.
//
// NOTHING IS EVER MERGED. Not cities, not subdivisions, not nations. There is no merge counter and
// no guard here because there is nothing to guard against: no such code is written. Merging is not
// something a program does by accident -- it takes a function that moves one place's tiles onto
// another, and nobody writes that without meaning to. A place that runs out of people ceases to
// exist and its ground goes back to having no owner, which is `disband` below.
program AgentsExe;

public bundle Agents {
    public namespace Nations {

        public class Realm {
            private mutable ArrayList<Nation*>* nations;
            private mutable ArrayList<Subdivision*>* subs;
            private mutable ArrayList<City*>* cities;
            // WHOSE IS THIS CELL, as a city id, or -1 for nobody's.
            //
            // The city keeps its own list of cells because it needs to walk what is hers. This
            // keeps the reverse, because the renderer asks "whose is this cell" for every cell on
            // screen every frame, and answering that by searching every city's list is the sweep
            // this project has already paid for twice.
            //
            // Two views of one fact drift apart. So exactly one method writes them (`claim`) and
            // exactly one unwrites them (`release`), and `audit` checks that they still agree.
            private mutable int[] cityOf;
            private mutable int w;
            private mutable int h;
            private mutable int bw;          // fog blocks across
            private mutable int bh;
            private mutable int seed;
            private mutable long claims;     // cells taken, over the run
            private mutable long releases;   // cells given back
            // WHY A CITY STOPPED GROWING, counted rather than guessed at. A city that never
            // expands has to name the condition that refused it.
            private mutable long atCeiling;    // its buildings entitle it to no more
            private mutable long refusedBoxed; // nothing free next to it at all
            private mutable long refusedFar;   // past the hard radius
            private mutable long refusedWet;   // the ground beside it cannot be walked
            private mutable long noPlot;       // wanted a house, owned nowhere to put one
            private mutable boolean changed;   // ground changed hands since anybody last asked
            private mutable boolean mapCut;    // something was taken off the map since then
            // WHAT THE GATHERING DID, counted. A city whose store stays empty has to say which of
            // these it was: nobody sent, nothing within reach, or somebody else got there first.
            private mutable long sentOut;
            private mutable long gathered;
            private mutable long delivered;
            private mutable long noNode;
            private mutable long tooLate;
            private mutable long yieldsNothing;
            private mutable long strayed;        // sent home for having wandered out of reach
            // WHAT THE TRADES AND THE SITES DID. Same discipline: a city that raises nothing has
            // to name which gate stopped it -- no plot, no material, no builder, or a site that
            // was already at its ceiling of hands.
            private mutable long learned;        // took a trade off somebody who had it
            private mutable long selfTaught;     // nobody in the city had it; the founders' road
            private mutable long ordered;        // frames put on the ground
            private mutable long raised;         // frames that became buildings
            private mutable long cannotAfford;   // wanted one, could not pay the bill
            private mutable long sitesFull;      // too many frames open at once
            private mutable long siteFull;       // a builder turned away, ceiling reached
            private mutable long hashes;         // work done at sites, over the run
            private mutable long hauled;         // loads carried store -> site
            private mutable long gaveBack;       // temporary builders returned to being trade-less
            private mutable int nextSite;
            private mutable boolean townsCut;    // a building or a frame changed since anybody asked
            // THE ERA-ONE MENU, in the order a settlement wants it. Housing and the store are
            // handled ahead of this list because they are not preferences.
            private mutable int[] era1;
            // The frame meter, so each of the town's five passes can be timed apart. Held rather
            // than passed: `grow` is called from one place and threading a meter through five
            // methods to answer one question is worse than a field.
            private mutable nullable Meter* clock;

            public static fixed int FOG = 32;
            // How many frames a city may have open at once. A cap, so it is announced: a town with
            // eight half-built things and no finished ones is a town that built nothing.
            public static fixed int MAX_SITES = 24;
            // How many the hall itself shelters.
            public static fixed int SEATS = 24;
            // One builder per this many residents, and not more. The first run taught the trade to
            // a hundred and seventy-six people for three places on one hut, and turned nine
            // hundred thousand of them away at the site in a single arc.
            public static fixed int PER_BUILDER = 12;
            // People served by one store. A town of hundreds keeps several.
            public static fixed int PER_PIT = 60;
            // The appetite for a good the town has none of, and the amount in store that halves
            // it. Only the RATIO between two goods' appetites matters, so FULL_WANT is just
            // headroom for the integer arithmetic.
            public static fixed int FULL_WANT = 1000;
            public static fixed int SOFT = 400;
            public static fixed int ERA1_N = 6;

            public constructor Realm(Grid* g, int withSeed) {
                this.w = g.width();
                this.h = g.height();
                this.bw = (this.w + Realm.FOG - 1) / Realm.FOG;
                this.bh = (this.h + Realm.FOG - 1) / Realm.FOG;
                this.seed = withSeed;
                this.claims = 0;
                this.releases = 0;
                this.atCeiling = 0;
                this.refusedBoxed = 0;
                this.refusedFar = 0;
                this.refusedWet = 0;
                this.noPlot = 0;
                this.changed = false;
                this.mapCut = false;
                this.sentOut = 0;
                this.gathered = 0;
                this.delivered = 0;
                this.noNode = 0;
                this.tooLate = 0;
                this.yieldsNothing = 0;
                this.strayed = 0;
                this.learned = 0;
                this.selfTaught = 0;
                this.ordered = 0;
                this.raised = 0;
                this.cannotAfford = 0;
                this.sitesFull = 0;
                this.siteFull = 0;
                this.hashes = 0;
                this.hauled = 0;
                this.gaveBack = 0;
                this.nextSite = 0;
                this.townsCut = false;
                this.clock = null;
                // The era-one workshops, after housing and the store. Sawmill first because the
                // wrights are already felling and the planks have nowhere to be made.
                this.era1 = new int[Realm.ERA1_N]();
                this.era1[0] = cast<int>(BuildingKind.Sawmill);
                this.era1[1] = cast<int>(BuildingKind.Kiln);
                this.era1[2] = cast<int>(BuildingKind.Pottery);
                this.era1[3] = cast<int>(BuildingKind.CharcoalKiln);
                this.era1[4] = cast<int>(BuildingKind.StoneCircle);
                this.era1[5] = cast<int>(BuildingKind.Harbor);
                this.nations = new ArrayList<Nation*>() on heap;
                this.subs = new ArrayList<Subdivision*>() on heap;
                this.cities = new ArrayList<City*>() on heap;
                this.cityOf = new int[this.w * this.h]();
                mutable int i = 0;
                int n = this.w * this.h;
                while (i < n) {
                    this.cityOf[i] = 0 - 1;
                    i = i + 1;
                }
            }

            // The lists hold POINTERS, so deleting a list frees the list and not what is in it.
            // Everything the realm made, the realm frees.
            public destructor ~Realm() returns void {
                mutable int i = 0;
                while (i < this.cities.size()) {
                    delete this.cities.get(i);
                    i = i + 1;
                }
                i = 0;
                while (i < this.subs.size()) {
                    delete this.subs.get(i);
                    i = i + 1;
                }
                i = 0;
                while (i < this.nations.size()) {
                    delete this.nations.get(i);
                    i = i + 1;
                }
                delete this.nations;
                delete this.subs;
                delete this.cities;
                delete this.cityOf;
                return;
            }

            // ---- reading ----

            public method fogBlocks() returns int {
                return this.bw * this.bh;
            }

            public method nationCount() returns int {
                return this.nations.size();
            }

            public method subCount() returns int {
                return this.subs.size();
            }

            public method cityCount() returns int {
                return this.cities.size();
            }

            public method nationAt(int i) returns Nation* {
                return this.nations.get(i);
            }

            public method subAt(int i) returns Subdivision* {
                return this.subs.get(i);
            }

            public method cityAt(int i) returns City* {
                return this.cities.get(i);
            }

            // Whose cell is this? -1 for nobody's. The renderer's question, answered by a lookup.
            public method ownerOf(int x, int y) returns int {
                if (x < 0 || y < 0 || x >= this.w || y >= this.h) {
                    return 0 - 1;
                }
                return this.cityOf[y * this.w + x];
            }

            // Climbing the hierarchy from a cell. The renderer needs these to decide, for one edge
            // between two cells, which of the three borders it is -- and the answer is which level
            // the two sides first differ at.
            public method subOfCity(int city) returns int {
                if (city < 0 || city >= this.cities.size()) {
                    return 0 - 1;
                }
                return this.cities.get(city).subdivision;
            }

            public method nationOfCity(int city) returns int {
                int s = this.subOfCity(city);
                if (s < 0) {
                    return 0 - 1;
                }
                return this.subs.get(s).nation;
            }

            // ---- founding ----

            public method foundNation(Grid* g, int atX, int atY, int government,
                                      int ideology) returns int {
                int nid = this.nations.size();
                mutable Nation* n = new Nation(nid, this.bw * this.bh) on heap;
                n.government = government;
                n.ideology = ideology;
                this.nations.add(n);
                // A nation begins as ONE subdivision holding the capital.
                int sid = this.openSubdivision(nid);
                int cid = this.foundCity(g, atX, atY, sid);
                n.capital = cid;
                return nid;
            }

            // A subdivision holds between four and eight cities, rolled here and fixed for its
            // life. It is why two nations the same size are not administered the same way.
            public method openSubdivision(int nation) returns int {
                int sid = this.subs.size();
                int span = 4 + ((this.seed * 2654435761 + sid * 40503) & 0x7FFFFFFF) % 5;
                mutable Subdivision* s = new Subdivision(sid, nation, span) on heap;
                this.subs.add(s);
                this.nations.get(nation).subdivisions.add(sid);
                return sid;
            }

            public method foundCity(Grid* g, int atX, int atY, int inSub) returns int {
                int cid = this.cities.size();
                mutable City* c = new City(cid, atX, atY, inSub) on heap;
                this.cities.add(c);
                this.subs.get(inSub).cities.add(cid);
                // The founding cell is the city's first ground, so a city always owns at least the
                // square it stands on -- there is no moment where a city exists nowhere.
                this.claim(cid, atX, atY);
                // AND THE HALL IS A BUILDING LIKE ANY OTHER.
                //
                // It never was. It was drawn straight from `cx,cy` and appeared in no list, so
                // nothing in the model could count it: not the roof a birth is against, not the
                // territory that follows the houses, not the plots. The instant housing stopped
                // being conjured, `sustained(0)` returned one against a city that already owned
                // one cell, and the whole country froze at a single square with a dome on it --
                // which is exactly what João photographed.
                //
                // A settlement is founded WITH its hall. Put it in the list and every one of
                // those questions answers itself.
                c.buildings.add(atY * this.w + atX);
                c.kinds.add(cast<int>(BuildingKind.TownHall));
                c.facing.add(0);
                // AND ITS STORE, standing on the day it is founded. A settlement arrives with
                // somewhere to keep what it brings home; waiting to build one means the first
                // gatherers have nowhere to put anything.
                mutable int px = atX + 2;
                mutable int py = atY;
                if (px >= this.w) {
                    px = atX - 2;
                }
                if (this.claim(cid, px, py)) {
                    c.buildings.add(py * this.w + px);
                    c.kinds.add(cast<int>(BuildingKind.StoragePit));
                    c.facing.add(2);
                }
                return cid;
            }

            // ---- the only two ways ground changes hands ----

            // THE ONE PLACE A CELL IS TAKEN. Both views are written here and nowhere else.
            public method claim(int city, int x, int y) returns boolean {
                if (x < 0 || y < 0 || x >= this.w || y >= this.h) {
                    return false;
                }
                int at = y * this.w + x;
                if (this.cityOf[at] >= 0) {
                    return false;                       // already somebody's; never taken by force here
                }
                this.cityOf[at] = city;
                this.cities.get(city).tiles.add(at);
                this.claims = this.claims + 1;
                return true;
            }

            // THE ONE PLACE A CELL IS GIVEN BACK. Only ever called for the whole of a city at once
            // (see `disband`) -- there is no partial retreat in this model.
            private method release(int city, int at) returns void {
                if (this.cityOf[at] == city) {
                    this.cityOf[at] = 0 - 1;
                    this.releases = this.releases + 1;
                }
                return;
            }

            // A CITY THAT RAN OUT OF PEOPLE STOPS EXISTING, and every cell it held goes back to
            // having no owner. It is not absorbed by a neighbour, it is not merged, and nobody
            // inherits it. Whatever was built on that ground stays standing as ruins -- the
            // buildings are not touched here.
            public method disband(int city) returns void {
                mutable City* c = this.cities.get(city);
                mutable int i = 0;
                while (i < c.tiles.size()) {
                    this.release(city, c.tiles.get(i));
                    i = i + 1;
                }
                c.tiles.clear();
                return;
            }

            // ---- growing ----

            // WHAT A CITY'S BUILDINGS ENTITLE IT TO.
            //
            //     tilesSustained = K * sqrt(houses)
            //
            // Doubling the territory takes FOUR TIMES the buildings. The rising cost lives in the
            // exponent rather than in a price, and that is the whole point: the first model priced
            // expansion with a heuristic and was unusable, because a made-up price has nothing in
            // the world to check it against. When the world came out wrong there was no telling
            // whether the number, the recipe or the formula was at fault. Territory tracking
            // buildings is a relation that can always be read back off the world.
            //
            // K and MAX_RADIUS are not chosen here. They are the two numbers this slice exists to
            // MEASURE, and whatever is written below came off a run.
            public static fixed int PER_HOUSE = 4;      // residents a house holds
            public static fixed int MAX_RADIUS = 90;
            // How much a tile's own fixed value may bend the frontier, in squared tiles. Large
            // enough that the edge wanders by several tiles, small enough that the claim still
            // grows outward from the town rather than off across the map.
            public static fixed int WOBBLE = 900;
            // How hard each already-owned neighbour pulls a tile forward. Larger than the whole
            // wobble range on purpose: three owned neighbours must beat any amount of wobble, so
            // a hole is always closed before the frontier advances again.
            // Per-block bend: whole stretches of frontier advance or hold back together.
            public static fixed int SWELL = 5000;
            public static fixed int ENCLOSED = 9000;
            // The eight neighbours, as offsets. Written once here rather than inline in three
            // loops that could drift apart.
            private static mutable int[] RX;
            private static mutable int[] RY;

            onClassLoad {
                Realm.RX = new int[8]();
                Realm.RY = new int[8]();
                Realm.RX[0] = 1;  Realm.RY[0] = 0;
                Realm.RX[1] = 0 - 1; Realm.RY[1] = 0;
                Realm.RX[2] = 0;  Realm.RY[2] = 1;
                Realm.RX[3] = 0;  Realm.RY[3] = 0 - 1;
                Realm.RX[4] = 1;  Realm.RY[4] = 1;
                Realm.RX[5] = 1;  Realm.RY[5] = 0 - 1;
                Realm.RX[6] = 0 - 1; Realm.RY[6] = 1;
                Realm.RX[7] = 0 - 1; Realm.RY[7] = 0 - 1;
            }
            // Tiles a city may claim in one tick. A bound, so it is announced rather than assumed.
            // FAST, because the claim starts as a camp and has to become a country. The bound
            // exists so a founding cannot take a province in one frame, not to make growth slow.
            public static fixed int EXPAND_RATE = 24;
            // Fruitless node searches one city may pay for in one tick. Each miss walks six
            // thousand tiles, so this is the difference between a frame and a slideshow.
            public static fixed int SEARCH_TRIES = 48;
            // Errands a town may hand out in one pass. A settlement does not queue its workforce
            // single file: one at a time meant 1605 of 1620 people standing about.
            public static fixed int SEND_RATE = 64;
            // How far from his own town a gatherer may be before he is simply lost. Measured in
            // tiles walked, not as the crow flies, and generous -- a forest can be a long way off.
            // Past it he goes home rather than searching for a node further out still.
            public static fixed int HOME_REACH = 60;
            // How far a town looks for work, in tiles. Well past its border: a settlement has no
            // guarantee of clay or rock inside its own ground.
            public static fixed int WORK_REACH = 110;
            // The short look around a remembered patch, before the country-wide sweep.
            public static fixed int NEAR_REACH = 14;
            // Country-wide sweeps a town may pay for in one pass. Each reads about fifty thousand
            // tiles, so this is the single number that decides the frame rate.
            public static fixed int WIDE_SWEEPS = 2;    // hard ceiling from the centre, in cells
            // HOW MANY HOUSES STAND ON ONE CELL.
            //
            // This was one, and one is impossible. A house needs a cell, so a city with n houses
            // needs n cells -- but its entitlement is K*sqrt(n), and K*sqrt(n) >= n only holds
            // while n <= K*K. Past nine houses the city was owed less ground than its houses
            // already stood on, and it locked: it could not build without more ground and could
            // not claim ground without more buildings. The run showed it exactly, stuck at seven
            // cells with `nowhere to build` firing seven thousand times.
            //
            // Cities are dense. A cell holds several houses, and the entitlement then holds up to
            // (K*PLOTS) squared houses -- beyond which the city stops spreading and can only
            // thicken, which is the pressure §4 turns into colonists.
            // TILES OF CLEAR GROUND REQUIRED BETWEEN TWO BUILDINGS, measured on each axis. Two
            // means a building and its neighbour have two empty tiles between them.
            // THE CLOSEST TWO BUILDINGS MAY EVER STAND, in tiles on each axis. A floor and
            // nothing more: it says how near they MAY be, never how near they should be.
            public static fixed int GAP = 1;
            // How far past the closest legal spot a new building may be put, in squared tiles.
            // This is the width of the band chosen from at random -- the difference between a
            // town and a grid.
            public static fixed int SPREAD = 40;
            // How wide the built-up part grows against the square root of what is standing. The
            // claim uses K, which is far larger -- that gap is the fields and woods between the
            // last house and the border.
            public static fixed int SPRAWL = 2;
            // The ground a settlement holds on the day it is founded, before it has built
            // anything. With GAP=2 each building needs a 5x5 of its own, so this is room for
            // roughly a dozen -- a village's worth of street before the claim has to grow.
            // A FLOOR THAT DOES NOT BECOME A CEILING.
            //
            // Three hundred was enough ground for a village on the day it was founded -- and a
            // town of sixty-five buildings earns a hundred and sixty-one, which is LESS. So the
            // floor won forever: the claim jumped to three hundred in the first seconds and never
            // moved again, which read as a border that is born full size and does not grow.
            //
            // Small enough that a couple of buildings pass it: `sustained(2)` is twenty-eight.
            public static fixed int FLOOR = 25;
            // ONE BUILDING PER TILE. Not a tunable -- a rule.
            //
            // This was eight, which was invented and wrong on both counts: the model let eight
            // buildings share a tile, and the renderer drew all eight at that tile's exact centre.
            // A town of two hundred and eighty-one buildings showed forty domes with seven hidden
            // inside each, so the report and the window disagreed and the report was believed.
            //
            // A tile holds one building, or part of one large building. Never two.
            public static fixed int PLOTS = 1;

            // K, AND WHY IT IS EIGHT.
            //
            // A city settles where its entitlement and its density agree: tiles = K*sqrt(houses)
            // and houses = tiles*PLOTS give tiles = K*K*PLOTS. K is therefore a QUADRATIC lever --
            // three gave seventy cells, which João watched and called far too little for a
            // continent, and eight gives five hundred and twelve. Seven times the ground for a
            // number less than three times as large.
            //
            // It stays a ceiling rather than the thing that decides. What a city actually stops at
            // is where the wood, the stone and the ground around it run out, and that is what the
            // next run measures.
            // HOW MUCH GROUND A BUILDING ENTITLES A TOWN TO, in the exponent: tiles = K^2 * PLOTS.
            // Doubling it quadruples the territory, so this is the one lever worth turning rather
            // than a dozen small ones. At eight, a town of a hundred and fifteen buildings held
            // eighty-five cells and its houses sat in one clump.
            public static fixed int K = 340;
            // The hinterland a settlement holds whatever it has built: the fields and woods it
            // works, not the ground under its houses. Added to the earned figure, never max'd
            // with it -- see sustained.
            // A camp, not a county. Twelve founders own the ground they can see and no more; the
            // earned part below is what turns that into a country, and it does so quickly because
            // K is large and the claim advances many tiles a tick.
            public static fixed int BASE = 30;

            // GROUND A TOWN IS ENTITLED TO, from what it has built -- WITH A FLOOR.
            //
            // The floor is not generosity, it is what breaks a deadlock: territory follows
            // buildings, a building needs a tile two clear of every other, and a founding owns
            // twenty tiles in a disc barely two wide. The gap rule refuses all twenty, so nothing
            // is ordered, so the territory never grows, so nothing is ever ordered. The run froze
            // at one hall and twenty-four people and stayed there.
            //
            // A settlement is founded with room for its first street.
            private method sustained(int houses) returns int {
                // BASE PLUS EARNED, not the larger of the two.
                //
                // A floor that competes with the earned figure becomes a ceiling the moment it is
                // the bigger of the two, which is what froze the border at a fixed size. Adding
                // them instead means the base is the hinterland every settlement holds -- fields,
                // woods, the ground it walks -- and the earned part is what its buildings add on
                // top. The claim always grows and never stalls.
                //
                // The scale is from the window: a town of twenty buildings held a disc a fifth of
                // the width of what it should, which is a thirtieth of the area.
                return Realm.BASE + cast<int>(cast<float>(Realm.K)
                                              * cast<float>(Math.sqrt(cast<double>(houses))));
            }

            // ONE STEP OF EVERY CITY: people are born, houses go up for them, and the ground
            // follows the houses. Three links, each one a plain relation, so that when the shape
            // of a city comes out wrong it is possible to say which link did it.
            public method useClock(Meter* m) returns void {
                this.clock = m;
                return;
            }

            public method grow(Grid* g, Folk* folk, int tick) returns void {
                mutable int c = 0;
                while (c < this.cities.size()) {
                    mutable City* one = this.cities.get(c);
                    // BIRTHS, AND THERE HAS TO BE A ROOF.
                    //
                    // The first version was a bare rate and it produced three hundred and ninety
                    // seven thousand people in a town of seven cells -- exponential growth with
                    // nothing on the other side of it. Housing is what a town's population is
                    // actually against, so a child is born when there is somewhere to put it and
                    // not otherwise, and the two links pull on each other instead of one running
                    // away.
                    //
                    // Still crude, and still the piece most obviously standing in for something
                    // real: people should be born to parents who met. That is agent depth, not
                    // territory, and it comes when the agents do.
                    // WHAT IS ACTUALLY STANDING SHELTERS WHAT IT SHELTERS.
                    //
                    // Four per building regardless of what the building was is how a town gained
                    // room to grow by putting up a kiln. The catalogue says what each kind houses
                    // -- a hut six, the hall twenty-four, a workshop none -- and reading it is
                    // what makes the housing chain a chain instead of a multiplier.
                    mutable int roof = 0;
                    mutable int rb = 0;
                    while (rb < one.kinds.size()) {
                        roof = roof + Builds.roof(one.kinds.get(rb));
                        rb = rb + 1;
                    }
                    if (one.residents.size() < roof && (tick + one.id) % 12 == 0) {
                        int who = folk.spawn(cast<float>(one.cx) + 0.5,
                                             cast<float>(one.cy) + 0.5, one.id % 4);
                        one.residents.add(who);
                        mutable Agent* born = folk.at(who);
                        born.homeX = one.cx;
                        born.homeY = one.cy;
                        born.home = one.id;
                    }
                    // HOUSES ARE NO LONGER CONJURED. A hut used to appear here as an integer the
                    // moment the town was full, which is exactly the thing João objected to: four
                    // hundred "buildings" and an empty field. Housing is ordered like everything
                    // else now -- see `order` -- and it costs wood and stone and takes hashes.
                    // GROUND, following the houses.
                    // GROUND, FOLLOWING THE HOUSES -- and catching up rather than trickling.
                    //
                    // One cell a tick meant a town entitled to two hundred cells took two hundred
                    // ticks to claim them, so the border was always far behind what the buildings
                    // had earned and the houses had nowhere to spread to. It takes as many as it
                    // is owed, up to a bound per tick so a founding does not claim a province in
                    // one frame.
                    mutable int owed = this.sustained(one.buildings.size()) - one.tiles.size();
                    if (owed > Realm.EXPAND_RATE) {
                        owed = Realm.EXPAND_RATE;
                    }
                    if (owed <= 0) {
                        this.atCeiling = this.atCeiling + 1;
                    }
                    while (owed > 0) {
                        if (!this.expand(g, one)) {
                            break;                    // boxed in, past the radius, or in the sea
                        }
                        owed = owed - 1;
                    }
                    // AND THE WORK. In the order the work actually happens in: somebody learns a
                    // trade, the city decides what to raise next, a gatherer is sent for what his
                    // own trade consumes, a builder goes to a site, and everybody already walking
                    // is asked whether they have arrived.
                    // Several a pass: a town that teaches one trade per pass leaves most of its
                    // people trade-less forever, and the trade-less are never sent anywhere.
                    mutable int lessons = 1 + one.residents.size() / 24;
                    if (lessons > 32) {
                        lessons = 32;
                    }
                    this.teachMany(folk, one, tick, lessons);
                    this.clock.lap(cast<int>(Phase.Teaching));
                    this.order(g, one, tick);
                    this.clock.lap(cast<int>(Phase.Ordering));
                    this.sendOut(g, folk, one, tick);
                    this.clock.lap(cast<int>(Phase.Sending));
                    this.raise(folk, one);
                    this.clock.lap(cast<int>(Phase.Building));
                    this.settle(g, folk, one, tick);
                    this.clock.lap(cast<int>(Phase.Settling));
                    this.herd(folk, one);
                    c = c + 1;
                }
                return;
            }

            // IDLE DRIFT STAYS ON THE CITY'S OWN GROUND.
            //
            // A man with nothing to do walks about his town. Which ground that is, is the ground
            // the town HOLDS -- so the test is whose tile he is standing on, and the answer lives
            // here because the Realm is the only thing that knows. It used to be a circle of
            // fourteen tiles round the hall, drawn inside the walker, and a city that grew to six
            // thousand tiles still had its people crowded round the middle of it.
            //
            // Only the idle. A gatherer walking to a wood is supposed to leave, and does.
            private method herd(Folk* folk, City* one) returns void {
                mutable int t = 0;
                while (t < one.residents.size()) {
                    mutable Agent* who = folk.at(one.residents.get(t));
                    t = t + 1;
                    if (who.errand != 0) {
                        continue;
                    }
                    if (this.ownerOf(cast<int>(who.x), cast<int>(who.y)) == one.id) {
                        continue;                          // at home, in the wide sense
                    }
                    float dx = cast<float>(one.cx) + 0.5 - who.x;
                    float dy = cast<float>(one.cy) + 0.5 - who.y;
                    float far2 = dx * dx + dy * dy;
                    if (far2 <= 0.0001) {
                        continue;
                    }
                    float inv = 1.0 / cast<float>(Math.sqrt(cast<double>(far2)));
                    who.hx = dx * inv;
                    who.hy = dy * inv;
                    who.rest = 0;
                    who.hold = 24;                         // hold the way home rather than re-pick
                    this.strayed = this.strayed + 1;
                }
                return;
            }

            // GOING AND GETTING IT.
            //
            // Nothing in the chain works without this. A city's buildings cost wood and stone, its
            // workshops eat what the map holds, and until somebody walks out and brings it back
            // every recipe in the catalogue is stalled at its first ingredient. That was the whole
            // of João's objection to the last run: houses were integers, nothing stood in the
            // world, and the agents did nothing but drift.
            //
            // A resident with no errand is given one for whatever the city is shortest of. He
            // walks there, takes what the node will give, walks back, and puts it in the store.
            // Producing includes delivering: that is his work from end to end and nothing takes
            // him off it.
            private method sendOut(Grid* g, Folk* folk, City* one, int tick) returns void {
                // HOW MANY FRUITLESS SEARCHES ONE TICK MAY PAY FOR.
                //
                // `nearestNode` walks rings out to forty tiles: six thousand tiles for one answer,
                // and a miss costs the whole six thousand. This loop used to give up on a miss and
                // move to the next resident, so a town whose diggers had no ore near them paid
                // that search once per digger per tick -- four million misses in one arc, and the
                // frame meter put ninety-eight per cent of the frame right here.
                //
                // A few tries a tick is enough: somebody gets sent, and the ones who found nothing
                // will be asked again next tick from wherever they have wandered to.
                mutable int tries = 0;
                mutable int sent = 0;
                mutable int wide = 0;
                mutable int t = 0;
                while (t < one.residents.size()) {
                    mutable Agent* who = folk.at(one.residents.get(t));
                    // A FRUITLESS SEARCH NO LONGER ENDS THE WHOLE PASS.
                    //
                    // Three misses used to `return`, so a town whose diggers had no ore near them
                    // never reached the wrights standing behind them in the list -- 1299 of 1308
                    // idle. The bound is on how many searches are PAID FOR, not on where the walk
                    // over the residents stops.
                    if (tries >= Realm.SEARCH_TRIES) {
                        return;
                    }
                    if (who.errand == 0 && Gathers.isGatherer(who.trade)) {
                        // WHAT HIS OWN TRADE CONSUMES, not what the city happens to be shortest of.
                        //
                        // This is the other half of the queue João saw. Fixing the search origin
                        // spread them over the field; it did not stop every single person in the
                        // town being eligible for every single errand, because nobody had a trade
                        // and so nothing distinguished one resident from the next. A wright fetches
                        // timber. A mason fetches stone. The rule in section 8 is not a policy the
                        // scheduler applies -- it is that there is no line of code here that could
                        // send him for anything else.
                        // WHICH OF HIS TRADE'S GOODS, drawn against what the town wants. His class
                        // is fixed -- a wright fetches timber and there is no line here that could
                        // send him for anything else -- but a class covers several goods and which
                        // of them he goes for follows the appetite. See `wanted`.
                        int want = this.wanted(one, Gathers.takes(who.trade), who.id + tick * 7);
                        if (want == cast<int>(Good.Nothing)) {
                            t = t + 1;
                            continue;
                        }
                        // SEARCHED FROM WHERE HE IS STANDING, not from the town centre.
                        //
                        // Searching from the centre gives every single person the same answer, so
                        // the whole population walked to one tree in single file, came back, and
                        // walked to the next one together. João watched it happen and asked
                        // whether that was intended. It was not: it is one shared starting point
                        // pretending to be a decision each of them made.
                        //
                        // From their own feet they get different answers, because they are
                        // standing in different places -- and the crowd spreads over the wood
                        // without anybody scheduling it.
                        // THE SEARCH STARTS AT THE TOWN AND REACHES WELL PAST ITS BORDER.
                        //
                        // It used to start from where the man was standing, and that made
                        // gathering depend on WANDERING: a resource was found only if somebody
                        // had happened to drift near it, so idling -- the state of doing nothing
                        // -- was secretly what fed the town. Leash the drift and the economy
                        // stops, which is how it became visible.
                        //
                        // Nor is it the territory: a settlement is not guaranteed to have clay or
                        // rock inside its own border, and most of the time a gatherer must leave
                        // it. The town looks out from its centre as far as a person will walk.
                        // FROM WHERE THE TOWN LAST FOUND THIS WORK, with a short reach, before
                        // sweeping the whole country. A hit costs a few hundred tiles instead of
                        // fifty thousand, and resources come in patches, so the hit is the case.
                        mutable int found = 0 - 1;
                        int seen = one.lastFound[want];
                        if (seen >= 0) {
                            found = this.nodeNear(g, seen % this.w, seen / this.w, want,
                                                  who.id + tick, Realm.NEAR_REACH);
                        }
                        // THE WIDE SWEEP IS RATIONED, WIN OR LOSE.
                        //
                        // `tries` counted only the searches that FAILED, and a hundred-tile sweep
                        // costs fifty thousand tiles whether it finds anything or not. Sixty-four
                        // errands a pass, eight passes a frame: twenty-four million tiles read per
                        // frame, and the meter -- once the town's five passes were timed apart --
                        // put 966 of 1000 right here and 1.4% in the other four combined.
                        //
                        // The short look around the remembered patch stays free: it is fourteen
                        // rings and it answers most of the time.
                        if (found < 0 && wide < Realm.WIDE_SWEEPS) {
                            wide = wide + 1;
                            found = this.nodeNear(g, one.cx, one.cy, want, who.id + tick,
                                                  Realm.WORK_REACH);
                        }
                        if (found >= 0) {
                            one.lastFound[want] = found;
                        }
                        if (found < 0) {
                            this.noNode = this.noNode + 1;
                            who.lastAct = 10;
                            who.lastTick = tick;
                            tries = tries + 1;
                            t = t + 1;
                            continue;
                        }
                        who.goX = found % this.w;
                        who.goY = found / this.w;
                        who.errand = 1;
                        who.wants = want;
                        who.lastAct = 1;
                        who.lastTick = tick;
                        this.sentOut = this.sentOut + 1;
                        // AS MANY AS THE TOWN HAS IDLE HANDS FOR.
                        //
                        // This sent ONE and returned, and with the town thinking every eighth
                        // tick that is one errand per eight ticks for sixteen hundred people:
                        // 1605 of 1620 standing about doing nothing, which is the crowd in the
                        // window. A settlement does not queue its workforce single file.
                        sent = sent + 1;
                        if (sent >= Realm.SEND_RATE) {
                            return;
                        }
                        t = t + 1;
                        continue;
                    }
                    t = t + 1;
                }
                return;
            }

            // A BUILDER, WHEREVER HE IS IN HIS OWN LOOP.
            //
            //   3  walking to the store, owed `-held` of `holds`
            //   4  walking to the site with it on his shoulder
            //   5  standing at the site, swinging
            //
            // Three legs and not one, because that is what it looks like from outside: a man
            // crossing town empty-handed, a man crossing it carrying something, and a man working.
            // Collapsing them into "he is building" is what made the last version a number.
            private method atSite(Folk* folk, City* one, Agent* who, int atX, int atY) returns void {
                mutable nullable Site* mine = this.siteById(one, who.site);
                if (mine == null) {
                    who.errand = 0;                          // his site finished without him
                    who.site = 0 - 1;
                    who.held = 0;
                    return;
                }
                if (atX != who.goX || atY != who.goY) {
                    return;                                  // still walking
                }
                if (who.errand == 3) {
                    int many = 0 - who.held;
                    if (!one.draw(who.holds, many)) {
                        // The store did not have it after all -- somebody else's site drew it
                        // first. The promise is released so the shortfall is real again.
                        mine.forget(who.holds, many);
                        who.errand = 0;
                        who.held = 0;
                        who.site = 0 - 1;
                        return;
                    }
                    who.held = many;                         // now actually in hand
                    who.goX = mine.x;
                    who.goY = mine.y;
                    who.errand = 4;
                    return;
                }
                if (who.errand == 4) {
                    mine.deliver(who.holds, who.held);
                    this.hauled = this.hauled + cast<long>(who.held);
                    who.held = 0;
                    who.holds = cast<int>(Good.Nothing);
                    who.errand = 5;
                    // NOT a rebake. A load landing on a site changes nothing anybody can see --
                    // the frame's height comes from the hashes, not the pile. Raising the flag
                    // here made `bakeTowns` run every frame, which reallocated the town buffer
                    // every frame and ran the machine out of memory at seventy-two megabytes.
                    return;
                }
                // errand 5 -- at the site, making hashes. Only once the material is all here: a
                // wall does not rise faster because somebody is swinging at bare ground.
                if (!mine.stocked()) {
                    who.errand = 0;
                    who.site = 0 - 1;
                    return;                                  // go back and fetch the rest
                }
                mine.done = mine.done + 1;
                this.hashes = this.hashes + 1;
                if (!mine.finished()) {
                    return;
                }
                // IT STANDS. The frame becomes a building, the builders are let go, and a
                // temporary builder goes back to being what he was.
                one.buildings.add(mine.y * this.w + mine.x);
                one.kinds.add(mine.kind);
                one.facing.add(mine.facing);       // the way the frame stood is the way it stands
                this.raised = this.raised + 1;
                this.townsCut = true;
                this.closeSite(folk, one, mine);
                return;
            }

            // Everybody working this site is let go and the frame comes off the ground.
            //
            // A temporary builder goes back to what he was, which for him is trade-less -- the
            // town does not quietly gain a permanent builder every time it puts up a hut. A real
            // builder stays a builder: he did not borrow the job, it is his life.
            private method closeSite(Folk* folk, City* one, Site* done) returns void {
                mutable int r = 0;
                while (r < one.residents.size()) {
                    mutable Agent* hand = folk.at(one.residents.get(r));
                    r = r + 1;
                    if (hand.site != done.id) {
                        continue;
                    }
                    hand.site = 0 - 1;
                    hand.errand = 0;
                    hand.held = 0;
                    hand.holds = cast<int>(Good.Nothing);
                    if (hand.wasCraft != cast<int>(Craft.NoCraft)) {
                        hand.trade = hand.wasCraft;
                        hand.wasCraft = cast<int>(Craft.NoCraft);
                        this.gaveBack = this.gaveBack + 1;
                    }
                }
                mutable int s = 0;
                while (s < one.sites.size()) {
                    if (one.sites.get(s).id == done.id) {
                        one.sites.removeAt(s);
                        break;
                    }
                    s = s + 1;
                }
                delete done;
                return;
            }

            // LEARNING A TRADE FROM SOMEBODY WHO HAS ONE.
            //
            // Not assigned. The city does not hand out jobs -- an agent without a trade picks one
            // up from a neighbour who has it, which is how trades actually spread and also why a
            // shortage fills itself: the city pulls harder for what it is short of by making that
            // the trade a learner is most likely to be standing next to somebody practising.
            //
            // The seed is the founders. An expedition carries its crafts (section 4), so the first
            // twelve arrive knowing things, and everybody after them learns from those twelve.
            // Without a seed nobody could ever learn anything and the city would stay a crowd.
            // THE TALLY IS TAKEN ONCE FOR THE WHOLE PASS.
            //
            // `teach` counted every trade in the town from scratch, and the pass ran it fifty-nine
            // times over fourteen hundred people -- eighty thousand reads to hand out fifty-nine
            // trades. The frame meter, once the walk and the thinking were measured apart, put
            // ninety-six per cent of the frame here and seven per cent in the walking.
            //
            // One sweep, then the lessons are given against it and the count kept up by hand.
            private method teachMany(Folk* folk, City* one, int tick, int lessons) returns void {
                if (one.residents.size() < 1) {
                    return;
                }
                mutable int[] tally = new int[Gathers.crafts()]();
                mutable int q = 0;
                while (q < one.residents.size()) {
                    tally[folk.at(one.residents.get(q)).trade] =
                        tally[folk.at(one.residents.get(q)).trade] + 1;
                    q = q + 1;
                }
                mutable int ls = 0;
                while (ls < lessons) {
                    this.teachOne(folk, one, tick + ls * 977, tally);
                    ls = ls + 1;
                }
                delete tally;
                return;
            }

            private method teachOne(Folk* folk, City* one, int tick, int[] tally) returns void {
                // SEVERAL LEARN PER PASS, not one. One a pass over a town of sixteen hundred
                // left most of them trade-less for the whole run, and a man with no trade is
                // never sent anywhere -- which is the crowd standing about doing nothing.
                mutable nullable Agent* learner = null;
                mutable int look = 0;
                while (look < 32 && learner == null) {
                    int pick = (tick * 7 + one.id * 13 + look * 131) % one.residents.size();
                    mutable Agent* cand = folk.at(one.residents.get(pick));
                    if (cand.trade == cast<int>(Craft.NoCraft)) {
                        learner = cand;
                    }
                    look = look + 1;
                }
                if (learner == null) {
                    return;
                }
                // WHAT THE CITY IS SHORTEST OF, among the trades that matter in era one. A learner
                // takes up the scarcest, which is the pull the design doc describes -- nobody is
                // posted anywhere, but a town short of masons makes masons.
                mutable int want = cast<int>(Craft.NoCraft);
                mutable int fewest = 0x7FFFFFFF;
                mutable int c = 1;
                while (c < Gathers.crafts()) {
                    if (this.needed(one, c)) {
                        int have = tally[c];
                        // ENOUGH BUILDERS IS ENOUGH. A hut takes three hands; a town that taught
                        // the trade to a hundred and seventy-six people turned nine hundred
                        // thousand of them away at the site in one arc, and every one of those
                        // was somebody not gathering. A trade nobody can practise is the lower
                        // engine of section 4 pointed at the town's own feet.
                        // BUILDERS FOLLOW PLACES, NOT POPULATION. A town of sixteen hundred was
                        // making a hundred and thirty of them for twelve places at the sites,
                        // and the surplus stood still for the whole run -- a trade nobody can
                        // practise, which is worse than no trade at all.
                        if (c == cast<int>(Craft.Builder)
                            && have >= 2 + (2 + one.residents.size() / 40) * 3) {
                            c = c + 1;
                            continue;
                        }
                        if (have < fewest) {
                            fewest = have;
                            want = c;
                        }
                    }
                    c = c + 1;
                }
                if (want == cast<int>(Craft.NoCraft)) {
                    return;
                }
                // AND SOMEBODY NEAR HIM HAS TO HAVE IT -- unless nobody in the city does, in which
                // case the founders' generation is what he learns from and the check would deadlock
                // a town that lost its last mason. Counted either way, so the two roads are visible
                // rather than one of them quietly carrying everything.
                if (fewest > 0) {
                    this.learned = this.learned + 1;
                } else {
                    this.selfTaught = this.selfTaught + 1;
                }
                learner.trade = want;
                // The shared tally is kept honest by hand, so the next lesson in this pass sees
                // the trade that was just handed out rather than the count from before it.
                tally[cast<int>(Craft.NoCraft)] = tally[cast<int>(Craft.NoCraft)] - 1;
                tally[want] = tally[want] + 1;
                return;
            }

            // Whether a trade is worth having here yet. Era one has no chemists, and a city that
            // taught chemistry to a third of its people would starve while they waited for a plant
            // that cannot be built for two ages.
            private method needed(City* one, int craft) returns boolean {
                if (Gathers.isGatherer(craft)) {
                    return true;                            // somebody must bring things in
                }
                if (craft == cast<int>(Craft.Builder)) {
                    // Somebody must put them up -- but a town does not need one builder per
                    // person. A site takes three hands for a hut and sixteen for a cathedral;
                    // teaching the trade to everybody just fills the ceiling queue.
                    return true;
                }
                // Otherwise: only if the city has, or is raising, a building of that craft.
                mutable int b = 0;
                while (b < one.kinds.size()) {
                    if (Builds.craft(one.kinds.get(b)) == craft) {
                        return true;
                    }
                    b = b + 1;
                }
                mutable int s = 0;
                while (s < one.sites.size()) {
                    if (Builds.craft(one.sites.get(s).kind) == craft) {
                        return true;
                    }
                    s = s + 1;
                }
                return false;
            }

            // WHAT TO RAISE NEXT, AND PAYING FOR IT BEFORE BREAKING GROUND.
            //
            // The order does two things and they happen together on purpose: a frame appears on
            // the map, and the material comes OUT of the store into that site's name. A site with
            // nothing reserved does not start -- so an order the city cannot afford is simply not
            // given, rather than opening a hole for material to fall into for the rest of the run.
            private method order(Grid* g, City* one, int tick) returns void {
                // ORDERS ARE GIVEN IN PARALLEL, and this is the fix for a town that raised its
                // buildings strictly one after another.
                //
                // A city holds up to MAX_SITES frames at once and builders spread across all of
                // them -- but only if the orders are actually GIVEN. This gate let one order
                // through every eight ticks, and `nextWanted` returns the same kind until that
                // kind is standing, so in practice the town opened one frame, waited for it, and
                // opened the next. Four slots and one ever used.
                //
                // Now it fills every free slot it can pay for on the tick it can pay for them,
                // and `nextWanted` skips what is already being built. A village puts up its store
                // and two huts at the same time, as a village would.
                // Frames open at once scales with the town. Four was a hamlet's number and it
                // left a hundred and thirty builders standing idle for twenty thousand ticks
                // with twelve places between them -- the crowd standing about doing nothing.
                mutable int slots = 2 + one.residents.size() / 40;
                if (slots > Realm.MAX_SITES) {
                    slots = Realm.MAX_SITES;
                }
                while (one.sites.size() < slots) {
                    if (!this.orderOne(g, one)) {
                        return;                              // cannot pay, or nowhere to put it
                    }
                }
                this.sitesFull = this.sitesFull + 1;
                return;
            }

            // WHETHER THE STORE HOLDS THE WHOLE BILL. Asked before a kind is chosen, so an
            // unaffordable one is skipped rather than blocking every kind behind it.
            private method canAfford(City* one, int what) returns boolean {
                if (one.have(cast<int>(Good.Wood)) < Builds.woodCost(what)) {
                    return false;
                }
                if (one.have(cast<int>(Good.Stone)) < Builds.stoneCost(what)) {
                    return false;
                }
                int third = Builds.matCost(what);
                if (third != cast<int>(Good.Nothing)
                    && one.have(third) < Builds.matCostN(what)) {
                    return false;
                }
                return true;
            }

            // ONE ORDER. Returns whether a frame went down, so the caller can keep filling slots.
            private method orderOne(Grid* g, City* one) returns boolean {
                int what = this.nextWanted(one);
                if (what == cast<int>(BuildingKind.NoBuilding)) {
                    return false;
                }
                int plot = this.freePlot(g, one);
                if (plot < 0) {
                    this.noPlot = this.noPlot + 1;
                    return false;
                }
                // CAN THE CITY PAY? Asked over the whole bill before a single unit moves, because
                // paying for half of a building is how a store empties into three frames that
                // never finish.
                int wood = Builds.woodCost(what);
                int stone = Builds.stoneCost(what);
                int third = Builds.matCost(what);
                mutable int thirdN = 0;
                if (third != cast<int>(Good.Nothing)) {
                    thirdN = Builds.matCostN(what);
                }
                if (one.have(cast<int>(Good.Wood)) < wood
                    || one.have(cast<int>(Good.Stone)) < stone
                    || (thirdN > 0 && one.have(third) < thirdN)) {
                    this.cannotAfford = this.cannotAfford + 1;
                    return false;
                }
                one.draw(cast<int>(Good.Wood), wood);
                one.draw(cast<int>(Good.Stone), stone);
                if (thirdN > 0) {
                    one.draw(third, thirdN);
                }
                mutable Site* frame = new Site(this.nextSite, what, one.id,
                                               plot % this.w, plot / this.w) on heap;
                this.nextSite = this.nextSite + 1;
                one.sites.add(frame);
                this.ordered = this.ordered + 1;
                // The picture has to be rebuilt: a frame is a thing standing in the world from
                // this instant, and a site nobody can see is a pending flag with extra steps.
                this.townsCut = true;
                return true;
            }

            // The next kind this city wants. Era one only, in the order a real settlement would
            // want them: somewhere to sleep, somewhere to keep food, somewhere to saw what the
            // wrights fell, somewhere to fire what they dig, and somewhere to believe.
            //
            // Housing first and by a wide margin, because a roof is what a birth is against.
            private method nextWanted(City* one) returns int {
                int roof = one.residents.size() + 4;
                mutable int housed = 0;
                mutable int b = 0;
                while (b < one.kinds.size()) {
                    housed = housed + Builds.roof(one.kinds.get(b));
                    b = b + 1;
                }
                // THERE IS NO PRIORITY BETWEEN KINDS.
                //
                // Both earlier versions had one and both were wrong. Housing first starved the
                // store, because people are born continuously so "somebody lacks a roof" never
                // goes false. Store first walled off the whole era behind a material the ground
                // did not have. An ordering makes ONE unaffordable thing block everything after
                // it, whichever thing it is.
                //
                // A settlement builds what it has the ground and the material for. A store may go
                // up before a hut or after it; nothing waits in a queue for a kind that cannot be
                // paid for today. What limits the town is what it can gather, which is the honest
                // limit and the one that makes gathering matter.
                //
                // Wanted at all means: not standing, not already being built, and -- for housing
                // only -- that there is somebody without a roof. That last is a NEED, not a
                // priority: a town does not raise its ninth hut for nobody.
                mutable int[] could = new int[Realm.ERA1_N + 2]();
                mutable int many = 0;
                if (housed < roof && one.building(cast<int>(BuildingKind.Hut)) < 3) {
                    could[many] = cast<int>(BuildingKind.Hut);
                    many = many + 1;
                }
                // A store per PER_PIT people. One pit for a town of hundreds was the model saying
                // a settlement has exactly one shed however large it grows.
                int pits = one.howMany(cast<int>(BuildingKind.StoragePit))
                         + one.building(cast<int>(BuildingKind.StoragePit));
                if (pits < 1 + one.residents.size() / Realm.PER_PIT) {
                    could[many] = cast<int>(BuildingKind.StoragePit);
                    many = many + 1;
                }
                mutable int k = 0;
                while (k < Realm.ERA1_N) {
                    int want = this.era1[k];
                    if (!one.has(want) && one.building(want) == 0) {
                        could[many] = want;
                        many = many + 1;
                    }
                    k = k + 1;
                }
                // The first of them the town can actually pay for -- walked from a rotating
                // start so no kind sits permanently behind another in the scan order either.
                mutable int found = cast<int>(BuildingKind.NoBuilding);
                if (many > 0) {
                    int from = ((this.nextSite * 2654435761 + one.id * 40503) & 0x7FFFFFFF) % many;
                    mutable int j = 0;
                    while (j < many) {
                        int what = could[(from + j) % many];
                        j = j + 1;
                        if (this.canAfford(one, what)) {
                            found = what;
                            j = many;
                        }
                    }
                }
                delete could;
                return found;
            }

            // THE BUILDERS.
            //
            // Two jobs, both his own, and the split is the model João chose: fetching from the
            // store to the site IS the builder's work, so there is no carrier role for anybody
            // idle to be pulled into -- because there is no being pulled into a job here at all.
            //
            //   short of material -> walk to the store, draw it, walk to the site, drop it
            //   material all there -> stand at the site and make hashes
            private method raise(Folk* folk, City* one) returns void {
                if (one.sites.size() < 1) {
                    return;
                }
                mutable int s = 0;
                while (s < one.sites.size()) {
                    one.sites.get(s).hands = 0;
                    s = s + 1;
                }
                mutable int t = 0;
                while (t < one.residents.size()) {
                    mutable Agent* who = folk.at(one.residents.get(t));
                    t = t + 1;
                    if (who.trade != cast<int>(Craft.Builder)) {
                        continue;                            // and nothing here can change that
                    }
                    if (who.errand != 0 && who.site >= 0) {
                        mutable nullable Site* mine = this.siteById(one, who.site);
                        if (mine != null) {
                            mine.hands = mine.hands + 1;
                        }
                        continue;                            // already on it
                    }
                    if (who.errand != 0) {
                        continue;
                    }
                    mutable nullable Site* pick = this.siteNeeding(one);
                    if (pick == null) {
                        continue;
                    }
                    who.site = pick.id;
                    pick.hands = pick.hands + 1;
                    int lack = pick.wants();
                    if (lack != cast<int>(Good.Nothing)) {
                        // Fetch. He goes to the store first, which is the town centre until there
                        // is a StoragePit and the pit once there is.
                        mutable int many = pick.short(lack);
                        if (many > 8) {
                            many = 8;                        // what a person can carry
                        }
                        pick.promise(lack, many);
                        who.holds = lack;
                        who.held = 0 - many;                 // negative: owed, not yet in hand
                        who.errand = 3;
                        this.storeWalk(one, who);
                    } else {
                        who.goX = pick.x;
                        who.goY = pick.y;
                        who.errand = 4;                      // nothing to fetch; go and work
                        who.holds = cast<int>(Good.Nothing);
                        who.held = 0;
                    }
                }
                return;
            }

            // WHERE THE STORE IS. The town centre until a StoragePit stands, and the pit after
            // that. The design doc asked for this to be FELT rather than declared: with a pit the
            // fetch is a walk across town, without one it is the whole width of the territory.
            private method storeWalk(City* one, Agent* who) returns void {
                mutable int b = 0;
                while (b < one.kinds.size()) {
                    if (one.kinds.get(b) == cast<int>(BuildingKind.StoragePit)) {
                        int cell = one.buildings.get(b);
                        who.goX = cell % this.w;
                        who.goY = cell / this.w;
                        return;
                    }
                    b = b + 1;
                }
                who.goX = one.cx;
                who.goY = one.cy;
                return;
            }

            private method siteById(City* one, int id) returns nullable Site* {
                mutable int s = 0;
                while (s < one.sites.size()) {
                    if (one.sites.get(s).id == id) {
                        return one.sites.get(s);
                    }
                    s = s + 1;
                }
                return null;
            }

            // THE OLDEST SITE THAT STILL HAS ROOM FOR A PAIR OF HANDS.
            //
            // Oldest first, because a town that spreads its builders evenly over four frames
            // finishes none of them and half a granary keeps nothing dry. But WITH ROOM, which is
            // the half that was missing: this returned the oldest unfinished site whether or not
            // it was already full, and the caller then turned the builder away -- so every builder
            // past the first site's ceiling stood idle while three other frames had nobody on
            // them, and the town raised its buildings strictly one at a time.
            //
            // Full means full at the CEILING THE CATALOGUE SETS, which comes from the building's
            // own complexity: three hands on a hut, up to sixteen on the largest thing there is.
            private method siteNeeding(City* one) returns nullable Site* {
                mutable int s = 0;
                while (s < one.sites.size()) {
                    mutable Site* it = one.sites.get(s);
                    if (!it.finished() && it.hands < it.ceiling) {
                        return it;
                    }
                    s = s + 1;
                }
                this.siteFull = this.siteFull + 1;
                return null;                       // every frame in town is fully manned
            }

            private method countTrade(Folk* folk, City* one, int craft) returns int {
                mutable int n = 0;
                mutable int t = 0;
                while (t < one.residents.size()) {
                    if (folk.at(one.residents.get(t)).trade == craft) {
                        n = n + 1;
                    }
                    t = t + 1;
                }
                return n;
            }

            // HOW BADLY THE TOWN WANTS ONE MORE OF A GOOD.
            //
            // Appetite, not a shortage list. Everything is wanted at the founding, and what the
            // store already holds is what damps the wanting: at nothing in hand the appetite is
            // full, at SOFT in hand it is halved, at ten times SOFT it is a tenth. It never falls
            // to nothing, so no good is ever written off -- a store that empties simply becomes
            // interesting again on its own.
            //
            // The alternative, taking whatever the town is shortest of, was tried and it failed
            // for a reason worth keeping written down: the scarcest good is an ABSORBING state.
            // Something the ground will not give stays at nought, so it stays the scarcest, so
            // every single gatherer of that class is sent after it forever and the four other
            // goods his trade could have brought home never come. One number for "most wanted"
            // cannot express a town that wants five things at once, and a town always does.
            private method appetite(City* one, int good) returns int {
                int have = one.have(good);
                mutable int w = Realm.FULL_WANT * Realm.SOFT / (Realm.SOFT + have);
                if (w < 1) {
                    w = 1;
                }
                return w;
            }

            // One of his own trade's goods, drawn with a weight equal to the appetite for it.
            //
            // Drawn, not chosen: two masons asking in the same tick get different answers, so the
            // town works stone and clay and sand at once in whatever proportion it is short of
            // them. That is the whole of the demand system -- there is no list of priorities and
            // nothing decides who fetches what.
            private method wanted(City* one, int hclass, int stir) returns int {
                int many = Nodes.goodsIn(hclass);
                if (many < 1) {
                    return cast<int>(Good.Nothing);
                }
                mutable int total = 0;
                mutable int i = 0;
                while (i < many) {
                    int gd = Nodes.goodAt(hclass, i);
                    i = i + 1;
                    if (gd == cast<int>(Good.Nothing)) {
                        continue;
                    }
                    total = total + this.appetite(one, gd);
                }
                if (total < 1) {
                    return cast<int>(Good.Nothing);
                }
                mutable int roll = ((stir * 2654435761) & 0x7FFFFFFF) % total;
                i = 0;
                while (i < many) {
                    int gd = Nodes.goodAt(hclass, i);
                    i = i + 1;
                    if (gd == cast<int>(Good.Nothing)) {
                        continue;
                    }
                    roll = roll - this.appetite(one, gd);
                    if (roll < 0) {
                        return gd;
                    }
                }
                return cast<int>(Good.Nothing);
            }

            // The nearest node of a given trade, searched outward from the city in rings of cells.
            // Bounded, and the refusal is counted: a city with no forest within reach has to be
            // able to say so rather than quietly gathering nothing.
            // A NODE OF THIS HARVEST, NEAR THE TOWN BUT NOT NECESSARILY THE NEAREST ONE.
            //
            // `stir` scatters the choice: rings are searched outward as before, but once a ring
            // holds anything the pick within it depends on the asker. Everybody gets a node about
            // as close as the closest, and not the SAME one -- which is the queue gone without
            // needing anybody to have wandered anywhere first.
            //
            // The reach is far past the border on purpose. A settlement is not guaranteed clay or
            // rock inside its own ground, and a gatherer leaving the territory is the normal case.
            private method nodeNear(Grid* g, int fromX, int fromY, int good,
                                    int stir, int reach) returns int {
                // Everything found in a ring is kept, and one of them is taken. Two people asking
                // in the same tick get different nodes at the same distance.
                mutable int best = 0 - 1;
                mutable int seen = 0;
                mutable int ring = 0;
                while (ring < reach) {
                    seen = 0;
                    best = 0 - 1;
                    mutable int dx = 0 - ring;
                    while (dx <= ring) {
                        mutable int side = 0;
                        while (side < 2) {
                            int gx = fromX + dx;
                            mutable int gy = fromY - ring;
                            if (side == 1) {
                                gy = fromY + ring;
                            }
                            side = side + 1;
                            if (gx < 0 || gy < 0 || gx >= this.w || gy >= this.h) {
                                continue;
                            }
                            if (g.surface().goodAt(gx, gy, good) >= 0) {
                                seen = seen + 1;
                                if (((stir * 2654435761 + seen * 40503) & 0x7FFFFFFF) % seen == 0) {
                                    best = gy * this.w + gx;
                                }
                            }
                        }
                        dx = dx + 1;
                    }
                    mutable int dy = 0 - ring + 1;
                    while (dy < ring) {
                        mutable int side = 0;
                        while (side < 2) {
                            mutable int gx = fromX - ring;
                            if (side == 1) {
                                gx = fromX + ring;
                            }
                            int gy = fromY + dy;
                            side = side + 1;
                            if (gx < 0 || gy < 0 || gx >= this.w || gy >= this.h) {
                                continue;
                            }
                            if (g.surface().goodAt(gx, gy, good) >= 0) {
                                seen = seen + 1;
                                if (((stir * 2654435761 + seen * 40503) & 0x7FFFFFFF) % seen == 0) {
                                    best = gy * this.w + gx;
                                }
                            }
                        }
                        dy = dy + 1;
                    }
                    if (best >= 0) {
                        return best;
                    }
                    ring = ring + 1;
                }
                return 0 - 1;
            }

            // ARRIVING, AND WHAT HAPPENS THERE. Walked once a tick over the people on errands,
            // which is what turns a heading into a job done.
            private method settle(Grid* g, Folk* folk, City* one, int tick) returns void {
                mutable int t = 0;
                while (t < one.residents.size()) {
                    mutable Agent* who = folk.at(one.residents.get(t));
                    t = t + 1;
                    if (who.errand == 0) {
                        continue;
                    }
                    int atX = cast<int>(who.x);
                    int atY = cast<int>(who.y);
                    // ---- the builder's three legs ----
                    if (who.errand >= 3) {
                        this.atSite(folk, one, who, atX, atY);
                        continue;
                    }
                    if (who.errand == 1) {
                        if (atX != who.goX || atY != who.goY) {
                            continue;                        // still walking
                        }
                        // THE HARVEST HIS OWN TRADE TAKES, which is the one he was sent for.
                        //
                        // This asked for a tree, and failing that a rock, whoever was standing
                        // there. Once trades existed and a digger was sent to an ore vein, the
                        // arrival looked for timber on it, found none, and turned round -- which
                        // the run reported as twenty-three thousand empty nodes against two and a
                        // half thousand loads. The going and the arriving have to agree on what
                        // he went for, and now that is the GOOD and not merely the class.
                        int use = g.surface().goodAt(who.goX, who.goY, who.wants);
                        if (use < 0) {
                            who.errand = 0;                  // somebody else took it first
                            this.tooLate = this.tooLate + 1;
                            continue;
                        }
                        int got = g.surface().harvest(use, 6);
                        if (got <= 0) {
                            who.errand = 0;
                            this.tooLate = this.tooLate + 1;
                            continue;
                        }
                        int gives = Nodes.gives(g.surface().kindAt(use));
                        if (gives == cast<int>(Good.Nothing)) {
                            // A node that yields nothing is not a mistake in the catalogue -- some
                            // kinds are scenery -- but carrying six units of it home and putting
                            // them in the store is. The first run did exactly that.
                            who.errand = 0;
                            this.yieldsNothing = this.yieldsNothing + 1;
                            continue;
                        }
                        who.holds = gives;
                        who.held = got;
                        // The node has less in it than it did, and may now be gone. The picture is
                        // told so it can stop drawing a tree that has been felled.
                        this.mapCut = true;
                        who.errand = 2;
                        who.goX = one.cx;
                        who.goY = one.cy;
                        who.lastAct = 2;
                        who.lastTick = tick;
                        this.gathered = this.gathered + cast<long>(got);
                    } else {
                        if (atX != one.cx || atY != one.cy) {
                            continue;                        // still walking home
                        }
                        one.take(who.holds, who.held);
                        this.delivered = this.delivered + cast<long>(who.held);
                        who.held = 0;
                        who.errand = 0;
                        who.lastAct = 3;
                        who.lastTick = tick;
                    }
                }
                return;
            }

            // AN EMPTY TILE THE CITY OWNS. Empty means empty: one building per tile.
            //
            // Walked rather than remembered. A city's tile list is hundreds long at most and this
            // runs once a tick per city; the day that is not true it becomes a flag per tile.
            // TWO TILES OF DAYLIGHT BETWEEN ANY TWO BUILDINGS.
            //
            // Without it a town packs its whole territory solid and comes out as a lattice of
            // roofs with no ground between them. With it there are lanes, yards and gaps, and a
            // town that owns three hundred tiles has buildings on a third of them -- which is
            // what a settlement looks like, because not all of a city's ground is built on.
            // WHETHER A BUILDING MAY GO ON THIS TILE OF THE CITY'S GROUND.
            //
            // Two separate refusals and they are not the same. The ground itself has to be the
            // kind a settlement stands on -- not water, not high rock, and territory now covers
            // both -- and it has to be clear of what is already standing. Being NEXT to a lake or
            // NEXT to a mountain refuses nothing: the shore is where towns are.
            private method plotOk(Grid* g, City* one, int at) returns boolean {
                if (!Biomes.buildable(g.biomeAt(at % this.w, at / this.w))) {
                    this.refusedWet = this.refusedWet + 1;
                    return false;
                }
                return !this.tooClose(one, at);
            }

            private method tooClose(City* one, int at) returns boolean {
                int ax = at % this.w;
                int ay = at / this.w;
                mutable int b = 0;
                while (b < one.buildings.size()) {
                    int o = one.buildings.get(b);
                    mutable int dx = o % this.w - ax;
                    mutable int dy = o / this.w - ay;
                    if (dx < 0) { dx = 0 - dx; }
                    if (dy < 0) { dy = 0 - dy; }
                    if (dx <= Realm.GAP && dy <= Realm.GAP) {
                        return true;
                    }
                    b = b + 1;
                }
                // And the frames, which are buildings that have not finished yet.
                mutable int s = 0;
                while (s < one.sites.size()) {
                    mutable Site* it = one.sites.get(s);
                    mutable int dx = it.x - ax;
                    mutable int dy = it.y - ay;
                    if (dx < 0) { dx = 0 - dx; }
                    if (dy < 0) { dy = 0 - dy; }
                    if (dx <= Realm.GAP && dy <= Realm.GAP) {
                        return true;
                    }
                    s = s + 1;
                }
                return false;
            }

            // THE TILE NEAREST THE CENTRE THAT IS FAR ENOUGH FROM EVERYTHING ELSE.
            //
            // Two rules, and they are what makes a settlement read as one. NEAREST THE CENTRE,
            // because a town grows out from its hall and does not sprinkle huts over its whole
            // province. And TWO TILES CLEAR of any other building or frame, because a town packed
            // solid is a lattice of roofs with no ground between them.
            //
            // It follows that a city has far more ground than buildings, which is correct: not
            // all of a settlement's territory is built on.
            private method freePlot(Grid* g, City* one) returns int {
                // THE MINIMUM IS A FLOOR, NOT A LATTICE.
                //
                // Taking the nearest tile that satisfies the gap is an optimal packing, and an
                // optimal packing is a grid: every house exactly as far from its neighbours as
                // the rule allows and not one tile further. That is a warehouse yard, not a town.
                //
                // So: find how close a house COULD go, then choose at random among everything
                // within a band beyond that. Near the hall still wins -- the band is narrow and
                // measured from the closest legal spot -- but which of the legal spots gets built
                // on is not decided by an ordering. Houses end up at one, two and four tiles
                // apart, which is what a place people built looks like.
                // THE BUILT-UP PART IS NOT THE WHOLE TERRITORY.
                //
                // A town's ground is its fields, woods and roads as well as its houses, and the
                // houses sit in the middle of it. Without a bound they spread to the border and
                // the settlement becomes a solid disc of roofs out to the frontier -- which is
                // what a megalopolis looks like, not a village. Empty ground inside a claim is
                // normal and it is most of it.
                //
                // The built radius grows with what is standing, but far more slowly than the
                // claim does: doubling the buildings widens the town by root two and the country
                // by a great deal more.
                int reach = 6 + cast<int>(cast<float>(Realm.SPRAWL)
                                          * cast<float>(Math.sqrt(cast<double>(
                                              1 + one.buildings.size()))));
                int reach2 = reach * reach;
                mutable int nearest = 0x7FFFFFFF;
                mutable int t = 0;
                while (t < one.tiles.size()) {
                    int at = one.tiles.get(t);
                    t = t + 1;
                    int ax = at % this.w;
                    int ay = at / this.w;
                    int dx = ax - one.cx;
                    int dy = ay - one.cy;
                    int d = dx * dx + dy * dy;
                    if (d > reach2) {
                        continue;                     // outside the town, inside the country
                    }
                    if (d < nearest && this.plotOk(g, one, at)) {
                        nearest = d;
                    }
                }
                if (nearest == 0x7FFFFFFF) {
                    return 0 - 1;                     // nowhere in town is far enough from a wall
                }
                // Everything from the closest legal spot out to a band beyond it is a candidate.
                // Counted first, then one of them taken -- two passes rather than a list, because
                // a city's tile list is walked twice cheaply and held once expensively.
                int band = nearest + Realm.SPREAD;
                mutable int many = 0;
                t = 0;
                while (t < one.tiles.size()) {
                    int at = one.tiles.get(t);
                    t = t + 1;
                    int ax = at % this.w;
                    int ay = at / this.w;
                    int dx = ax - one.cx;
                    int dy = ay - one.cy;
                    int d = dx * dx + dy * dy;
                    if (d > band || d > reach2) {
                        continue;
                    }
                    if (!this.plotOk(g, one, at)) {
                        continue;
                    }
                    many = many + 1;
                }
                if (many < 1) {
                    return 0 - 1;
                }
                // Which one. Stirred by the order number and the city, so two towns founded in
                // the same tick do not lay themselves out identically.
                int pick = ((this.nextSite * 2654435761 + one.id * 40503 + this.seed * 97)
                            & 0x7FFFFFFF) % many;
                mutable int seen = 0;
                t = 0;
                while (t < one.tiles.size()) {
                    int at = one.tiles.get(t);
                    t = t + 1;
                    int ax = at % this.w;
                    int ay = at / this.w;
                    int dx = ax - one.cx;
                    int dy = ay - one.cy;
                    int d = dx * dx + dy * dy;
                    if (d > band || d > reach2) {
                        continue;
                    }
                    if (!this.plotOk(g, one, at)) {
                        continue;
                    }
                    if (seen == pick) {
                        return at;
                    }
                    seen = seen + 1;
                }
                return 0 - 1;
            }

            // ONE CELL, AND THE NEAREST ONE TO THE CENTRE.
            //
            // Taking the first candidate found would grow the city in whatever direction its tile
            // list happens to be ordered, which is a stripe rather than a town. Taking the nearest
            // to the centre grows it outward roughly round, without anybody deciding what round is.
            //
            // Every refusal is counted. A city that stops growing has to be able to say WHY -- no
            // free ground beside it, the hard radius, or the ceiling its buildings set -- because
            // "it just stopped" is how this project lost days twice before.
            private method expand(Grid* g, City* one) returns boolean {
                mutable int bestAt = 0 - 1;
                mutable int bestD = 0x7FFFFFFF;
                mutable int t = 0;
                while (t < one.tiles.size()) {
                    int at = one.tiles.get(t);
                    int gx = at % this.w;
                    int gy = at / this.w;
                    // ALL EIGHT NEIGHBOURS, NOT FOUR.
                    //
                    // Four neighbours is why the claim came out as a diamond: spreading only
                    // north/south/east/west, the set of tiles within N steps IS a diamond, and
                    // no amount of wobble on top of it makes that shape anything else. Eight
                    // gives a circle at the founding, which is what it should be, and lets the
                    // wobble bend it from there.
                    mutable int d = 0;
                    while (d < 8) {
                        int nx = gx + Realm.RX[d];
                        int ny = gy + Realm.RY[d];
                        d = d + 1;
                        if (nx < 0 || ny < 0 || nx >= this.w || ny >= this.h) {
                            continue;
                        }
                        if (this.cityOf[ny * this.w + nx] >= 0) {
                            continue;                        // somebody's already
                        }
                        if (!Biomes.walkable(g.biomeAt(nx, ny))) {
                            this.refusedWet = this.refusedWet + 1;
                            continue;
                        }
                        int ddx = nx - one.cx;
                        int ddy = ny - one.cy;
                        mutable int far = ddx * ddx + ddy * ddy;
                        if (far > Realm.MAX_RADIUS * Realm.MAX_RADIUS) {
                            this.refusedFar = this.refusedFar + 1;
                            continue;
                        }
                        // A COUNTRY IS NOT A DISC -- AND IT HAS NO HOLES IN IT.
                        //
                        // Always taking the nearest free tile grows a perfect circle, because
                        // that IS the definition of a circle. So the distance is warped by a
                        // value fixed to the tile, and the frontier advances in tongues.
                        //
                        // But warping alone punched holes: a tile the wobble pushed back was
                        // passed over, the claim closed around it, and it stayed unpicked forever
                        // because the same fixed value pushed it back every time it was
                        // considered. A country with gaps in the middle of it.
                        //
                        // So ENCLOSURE OUTRANKS EVERYTHING. The more of a tile's neighbours the
                        // city already owns, the more it is pulled forward -- and a tile with
                        // most of its neighbours owned is a hole, taken before any frontier tile
                        // whatever the wobble says. The edge stays ragged; the inside stays
                        // solid.
                        mutable int held = 0;
                        mutable int k = 0;
                        while (k < 8) {
                            int sx = nx + Realm.RX[k];
                            int sy = ny + Realm.RY[k];
                            k = k + 1;
                            if (sx < 0 || sy < 0 || sx >= this.w || sy >= this.h) {
                                continue;
                            }
                            if (this.cityOf[sy * this.w + sx] == one.id) {
                                held = held + 1;
                            }
                        }
                        // Two scales. The per-tile value roughens the edge; the per-BLOCK value
                        // moves whole stretches of frontier in or out together, which is what
                        // makes tongues and bays instead of a fuzzy circle.
                        int n = ((nx * 374761393) ^ (ny * 668265263)) & 0x7FFFFFFF;
                        int bx = nx >> 3;
                        int by = ny >> 3;
                        int nb = ((bx * 2654435761) ^ (by * 40503)) & 0x7FFFFFFF;
                        // The bend is PROPORTIONAL to how far out the tile already is. A fixed
                        // offset near the middle drags the whole settlement off its hall -- the
                        // centroid came out fifteen tiles south of the seat. Scaled, the core
                        // stays a circle centred on the town and only the far edge wanders.
                        int bend = far / 24;
                        far = far + ((n % Realm.WOBBLE) - (Realm.WOBBLE / 2)) * bend / 1000;
                        far = far + ((nb % Realm.SWELL) - (Realm.SWELL / 2)) * bend / 1000;
                        far = far - held * Realm.ENCLOSED;
                        if (far < bestD) {
                            bestD = far;
                            bestAt = ny * this.w + nx;
                        }
                    }
                    t = t + 1;
                }
                if (bestAt < 0) {
                    this.refusedBoxed = this.refusedBoxed + 1;
                    return false;
                }
                this.claim(one.id, bestAt % this.w, bestAt / this.w);
                this.changed = true;
                return true;
            }

            private static method stepX(int d) returns int {
                if (d == 0) { return 1; }
                if (d == 2) { return 0 - 1; }
                return 0;
            }

            private static method stepY(int d) returns int {
                if (d == 1) { return 1; }
                if (d == 3) { return 0 - 1; }
                return 0;
            }

            // Has the ground changed hands since the last time anybody asked? The renderer bakes
            // its borders off this rather than every frame.
            public method takeChanged() returns boolean {
                boolean was = this.changed;
                this.changed = false;
                return was;
            }

            // Has anything been taken off the map since anybody last asked? The picture rebakes
            // off this, so a felled tree stops being drawn.
            public method takeMapCut() returns boolean {
                boolean was = this.mapCut;
                this.mapCut = false;
                return was;
            }

            public method growthReport(Grid* g, Folk* folk) returns void {
                // A TARGET NOBODY CAN STAND ON.
                //
                // Arriving is `his tile equals the target tile`, and a node standing on water is a
                // tile no walker may enter: he reaches the shore, the next step is refused, his
                // heading is reversed, and he shuttles there for the rest of the run. He is not
                // motionless, so the wedge rule -- which watches for a man who has not moved --
                // never sees him. This counts how many are walking at ground they cannot reach.
                mutable int wet = 0;
                mutable int onErrand = 0;
                mutable int ci = 0;
                while (ci < this.cities.size()) {
                    mutable City* one = this.cities.get(ci);
                    ci = ci + 1;
                    mutable int t = 0;
                    while (t < one.residents.size()) {
                        mutable Agent* who = folk.at(one.residents.get(t));
                        t = t + 1;
                        if (who.errand != 1) {
                            continue;
                        }
                        onErrand = onErrand + 1;
                        if (!Biomes.walkable(g.biomeAt(who.goX, who.goY))) {
                            wet = wet + 1;
                        }
                    }
                }
                System.IO.Console.println($"reach: {wet} of {onErrand} walking to a node standing on ground they cannot enter");
                // AND WHETHER THOSE NODES SHOULD BE THERE AT ALL.
                //
                // Two readings of the same crowd on the shore: the town accepts an unreachable
                // tile as a destination, or the node is not where it is drawn. They call for
                // opposite fixes, and this tells them apart -- a fishing spot on water is the
                // catalogue working, and a stone or a reed bed on water is not.
                // Water and highland told apart: unwalkable covers both, and they are different
                // facts. A boulder in a lake is a placement mistake; a boulder on a mountain is
                // the world being right and the ARRIVAL RULE being wrong, because stone lives on
                // rock and rock is not ground a man strolls over.
                mutable int[] inWater = new int[Nodes.count()]();
                mutable int[] onRock = new int[Nodes.count()]();
                mutable int anyDrowned = 0;
                NodeField* nf = g.surface();
                mutable int ni = 0;
                while (ni < nf.size()) {
                    int nk = nf.kindAt(ni);
                    ni = ni + 1;
                    if (nk == 0) {
                        continue;
                    }
                    int bi = g.biomeAt(nf.cellXAt(ni - 1), nf.cellYAt(ni - 1));
                    if (Biomes.walkable(bi)) {
                        continue;
                    }
                    anyDrowned = anyDrowned + 1;
                    if (bi < 8) {
                        inWater[nk] = inWater[nk] + 1;
                    } else {
                        onRock[nk] = onRock[nk] + 1;
                    }
                }
                System.IO.Console.println($"nodes on unwalkable ground: {anyDrowned} of {nf.size()}");
                mutable int nkk = 1;
                while (nkk < Nodes.count()) {
                    if (inWater[nkk] > 0 || onRock[nkk] > 0) {
                        System.IO.Console.println($"  {Nodes.name(nkk)}: {inWater[nkk]} in water, {onRock[nkk]} on highland rock");
                    }
                    nkk = nkk + 1;
                }
                delete inWater;
                delete onRock;

                System.IO.Console.println($"growth: {this.atCeiling} ticks at the building ceiling, {this.refusedBoxed} boxed in, {this.refusedFar} refused for distance, {this.refusedWet} refused as unwalkable, {this.noPlot} with nowhere to build");
                System.IO.Console.println($"gather: {this.sentOut} sent out, {this.gathered} taken off the map, {this.delivered} delivered to a store, {this.noNode} found nothing in reach, {this.tooLate} arrived at an empty node, {this.yieldsNothing} at a node that yields nothing");
                mutable int c = 0;
                while (c < this.cities.size()) {
                    mutable City* one = this.cities.get(c);
                    // EVERY GOOD THAT HAS ANY, not the two I expected to see. The first run
                    // reported "0 wood, 0 stone" after delivering two thousand eight hundred
                    // units, because a quarry trade brings back marble and clay and salt as
                    // readily as stone -- the goods were in the store and the readout was looking
                    // past them. A report that only prints what it went looking for will always
                    // agree with whoever wrote it.
                    mutable int gd = 0;
                    while (gd < Goods.count()) {
                        if (one.have(gd) > 0) {
                            System.IO.Console.println($"  city {one.id} store: {one.have(gd)} {Goods.name(gd)}");
                        }
                        gd = gd + 1;
                    }
                    // WHERE THE GROUND IS AND WHERE THE PEOPLE ARE, in the same four quarters.
                    //
                    // A crowd gathered on one side of a town has two possible readings -- the
                    // ground is lopsided that way, or the walk is biased that way -- and one
                    // number cannot tell them apart. Two can: if the people lean the way the
                    // tiles lean, they are following the country; if the tiles are even and the
                    // people are not, the bias is in the walking.
                    mutable int[] gq = new int[4]();
                    mutable int qi = 0;
                    while (qi < one.tiles.size()) {
                        int cell = one.tiles.get(qi);
                        qi = qi + 1;
                        int qx = cell % this.w;
                        int qy = cell / this.w;
                        mutable int q = 0;
                        if (qy < one.cy) {
                            q = 0;
                        } else {
                            q = 2;
                        }
                        if (qx >= one.cx) {
                            q = q + 1;
                        }
                        gq[q] = gq[q] + 1;
                    }
                    mutable int[] pq = new int[4]();
                    mutable int pi = 0;
                    while (pi < one.residents.size()) {
                        mutable Agent* who = folk.at(one.residents.get(pi));
                        pi = pi + 1;
                        if (who.errand != 0) {
                            continue;
                        }
                        mutable int q = 0;
                        if (cast<int>(who.y) < one.cy) {
                            q = 0;
                        } else {
                            q = 2;
                        }
                        if (cast<int>(who.x) >= one.cx) {
                            q = q + 1;
                        }
                        pq[q] = pq[q] + 1;
                    }
                    System.IO.Console.println($"  city {one.id} ground NW/NE/SW/SE: {gq[0]}/{gq[1]}/{gq[2]}/{gq[3]}");
                    System.IO.Console.println($"  city {one.id} idle   NW/NE/SW/SE: {pq[0]}/{pq[1]}/{pq[2]}/{pq[3]}");
                    delete gq;
                    delete pq;
                    // WHAT IS ACTUALLY STANDING, by kind. Four hundred integers in a list said
                    // nothing; this says whether the town has a sawmill.
                    mutable int k = 0;
                    while (k < BuildingKind.count()) {
                        int n = one.howMany(k);
                        if (n > 0) {
                            System.IO.Console.println($"  city {one.id} has {n} {Builds.name(k)}");
                        }
                        k = k + 1;
                    }
                    mutable int s = 0;
                    while (s < one.sites.size()) {
                        mutable Site* it = one.sites.get(s);
                        System.IO.Console.println($"  city {one.id} site: {Builds.name(it.kind)} at {it.x},{it.y} -- {it.done}/{it.work} hashes, {it.hands} builders, stocked {it.stocked()}");
                        // WHAT IT IS STILL WAITING FOR, AND WHO IS SUPPOSED TO BE BRINGING IT.
                        //
                        // A site that never finishes has a shortfall that nobody is acting on, and
                        // `coming` is where that hides: a load promised by a builder who was then
                        // taken off the errand leaves the promise behind, so `short` reads nought,
                        // nobody fetches, and the frame waits forever with hands on it. Printing
                        // the three numbers beside the number of men actually carrying for this
                        // site is what tells a real load from a ghost.
                        mutable int carrying = 0;
                        mutable int r = 0;
                        while (r < one.residents.size()) {
                            mutable Agent* hand = folk.at(one.residents.get(r));
                            r = r + 1;
                            if (hand.site == it.id && (hand.errand == 3 || hand.errand == 4)) {
                                carrying = carrying + 1;
                            }
                        }
                        mutable int gg = 0;
                        while (gg < Goods.count()) {
                            if (it.needs[gg] > 0) {
                                System.IO.Console.println($"    needs {it.needs[gg]} {Goods.name(gg)}, on site {it.onSite[gg]}, promised {it.coming[gg]}, men carrying for it {carrying}");
                            }
                            gg = gg + 1;
                        }
                        s = s + 1;
                    }
                    c = c + 1;
                }
                return;
            }

            // EVERY AGENT, EVERY FIELD THAT DECIDES WHAT HE DOES.
            //
            // Written because a handful of them behave in ways nothing in the counters explains --
            // standing still, walking back and forth, circling a node -- and guessing at it from
            // the outside has been wrong twice. This is the state itself: where he is, where he
            // was, where he is going, what he holds, what he is, and what he is on.
            //
            // A census of a sample rather than of everybody: a thousand lines is readable and a
            // hundred thousand is not, and the ones behaving strangely are not rare.
            // WHERE THEY ARE, EVERY TICK.
            //
            // The end-of-run dump is a photograph, and a photograph cannot show a man walking
            // back and forth or standing still -- for that you need the same agent's position at
            // tick after tick, side by side. This is that: a fixed handful of agents, traced
            // every tick, so their path can be read straight down the column.
            //
            // A handful and not everybody, because two hundred lines a tick at sixty-four ticks a
            // frame is not a log anybody can read. The SAME handful every time, by index, so the
            // rows line up.
            public method trace(Folk* folk, int tick, int many) returns void {
                if (this.cities.size() < 1) {
                    return;
                }
                // EVERY AGENT IN THE WORLD, EVERY TICK. `many` is ignored; it was a sample and a
                // sample is exactly what could not answer the question -- a crowd standing about
                // doing nothing does not show up in the first eight rows of a list.
                mutable City* one = this.cities.get(0);
                mutable int t = 0;
                while (t < one.residents.size()) {
                    int who = one.residents.get(t);
                    mutable Agent* a = folk.at(who);
                    mutable int hx = cast<int>(a.x) - one.cx;
                    mutable int hy = cast<int>(a.y) - one.cy;
                    if (hx < 0) { hx = 0 - hx; }
                    if (hy < 0) { hy = 0 - hy; }
                    mutable int dx = a.goX - cast<int>(a.x);
                    mutable int dy = a.goY - cast<int>(a.y);
                    if (dx < 0) { dx = 0 - dx; }
                    if (dy < 0) { dy = 0 - dy; }
                    // WHAT HE WILL DO WHEN HE GETS THERE. Read off the errand, so the trace says
                    // intention and not only position.
                    mutable String next = "drift";
                    if (a.errand == 1) { next = "take from node"; }
                    if (a.errand == 2) { next = "put in store"; }
                    if (a.errand == 3) { next = "draw from store"; }
                    if (a.errand == 4) { next = "drop at site"; }
                    if (a.errand == 5) { next = "swing"; }
                    System.IO.Console.println($"t{tick} a{who} pos={a.x},{a.y} was={a.px},{a.py} face={a.hx},{a.hy} errand={a.errand} goto={a.goX},{a.goY} togo={dx + dy} next={next} home={a.homeX},{a.homeY} d2home={hx + hy} trade={a.trade} holds={a.holds} held={a.held} site={a.site} did={a.lastAct}@{a.lastTick} idle={tick - a.lastTick}");
                    t = t + 1;
                }
                return;
            }

            public method agentDump(Folk* folk, int many) returns void {
                // WHERE EVERY TOWN IS, first, because every position below is only meaningful
                // against it -- the last dump printed people at 1121,755 and it took reading the
                // city line separately to see that was a hundred and ninety tiles from home.
                mutable int q = 0;
                while (q < this.cities.size()) {
                    mutable City* it = this.cities.get(q);
                    // Where the ground actually sits against where the hall stands. If the two
                    // drift apart the claim is growing lopsided and the seat is not its centre.
                    mutable long sx = 0;
                    mutable long sy = 0;
                    mutable int z = 0;
                    while (z < it.tiles.size()) {
                        int at = it.tiles.get(z);
                        sx = sx + cast<long>(at % this.w);
                        sy = sy + cast<long>(at / this.w);
                        z = z + 1;
                    }
                    mutable int mx = it.cx;
                    mutable int my = it.cy;
                    if (it.tiles.size() > 0) {
                        mx = cast<int>(sx / cast<long>(it.tiles.size()));
                        my = cast<int>(sy / cast<long>(it.tiles.size()));
                    }
                    System.IO.Console.println($"city {it.id} centre {it.cx},{it.cy}, ground centroid {mx},{my} (off by {mx - it.cx},{my - it.cy}), {it.tiles.size()} tiles, {it.residents.size()} people, {it.buildings.size()} buildings");
                    q = q + 1;
                }
                System.IO.Console.println("agent dump: id trade errand at was goto d home holds held site");
                mutable int printed = 0;
                mutable int c = 0;
                while (c < this.cities.size() && printed < many) {
                    mutable City* one = this.cities.get(c);
                    mutable int t = 0;
                    while (t < one.residents.size() && printed < many) {
                        int who = one.residents.get(t);
                        mutable Agent* a = folk.at(who);
                        // Distance from where he is to where he says he is going. A man on an
                        // errand who is not getting closer over successive dumps is the whole
                        // question, and it cannot be read off a counter.
                        int dx = a.goX - cast<int>(a.x);
                        int dy = a.goY - cast<int>(a.y);
                        // AND HOW FAR HE IS FROM HIS OWN TOWN, which is the number that told us
                        // the strange ones are simply lost.
                        mutable int hx = cast<int>(a.x) - one.cx;
                        mutable int hy = cast<int>(a.y) - one.cy;
                        if (hx < 0) { hx = 0 - hx; }
                        if (hy < 0) { hy = 0 - hy; }
                        System.IO.Console.println($"  {who} trade={a.trade} errand={a.errand} at={cast<int>(a.x)},{cast<int>(a.y)} was={cast<int>(a.px)},{cast<int>(a.py)} goto={a.goX},{a.goY} d={dx},{dy} home={hx + hy} holds={a.holds} held={a.held} site={a.site}");
                        printed = printed + 1;
                        t = t + 1;
                    }
                    c = c + 1;
                }
                System.IO.Console.println($"agent dump: {printed} of {folk.count()} alive");
                return;
            }

            // WHAT THE WHOLE POPULATION IS DOING, by errand. The shape of the answer to "why is
            // nobody doing anything": if most of them sit at errand 0 the sending is the problem,
            // and if most sit at 1 they are walking to somewhere they never reach.
            public method errands(Folk* folk) returns void {
                mutable int[] byErrand = new int[8]();
                mutable int atTarget = 0;
                mutable int farOff = 0;
                mutable int onErrand = 0;
                mutable long reach = 0;
                mutable int c = 0;
                while (c < this.cities.size()) {
                    mutable City* one = this.cities.get(c);
                    mutable int t = 0;
                    while (t < one.residents.size()) {
                        mutable Agent* a = folk.at(one.residents.get(t));
                        mutable int e = a.errand;
                        if (e < 0 || e > 7) {
                            e = 7;
                        }
                        byErrand[e] = byErrand[e] + 1;
                        // HOW FAR HE IS FROM WHERE HE IS GOING -- not whether he moved since the
                        // last slice.
                        //
                        // The first version of this compared x against px and called it stuck.
                        // That measures nothing: an agent is moved once every SLICES ticks, so in
                        // fifteen ticks out of sixteen x IS px and everybody looks frozen. It
                        // reported a hundred and nineteen of two hundred and forty stuck and the
                        // number meant only that the dump landed between moves.
                        //
                        // Distance to the destination is the honest question, and it splits the
                        // two real failures apart: a man far from a target he will never reach,
                        // and a man standing ON his target with the arrival never firing.
                        if (a.errand != 0) {
                            int dx = a.goX - cast<int>(a.x);
                            int dy = a.goY - cast<int>(a.y);
                            mutable int ad = dx;
                            if (ad < 0) { ad = 0 - ad; }
                            mutable int bd = dy;
                            if (bd < 0) { bd = 0 - bd; }
                            if (ad + bd == 0) {
                                atTarget = atTarget + 1;     // arrived, and nothing happened
                            }
                            if (ad + bd > 40) {
                                farOff = farOff + 1;         // further than the search ever looks
                            }
                            reach = reach + cast<long>(ad + bd);
                            onErrand = onErrand + 1;
                        }
                        t = t + 1;
                    }
                    c = c + 1;
                }
                mutable long avg = 0;
                if (onErrand > 0) {
                    avg = reach / cast<long>(onErrand);
                }
                System.IO.Console.println($"errands: {byErrand[0]} idle, {byErrand[1]} out to a node, {byErrand[2]} carrying home, {byErrand[3]} to the store, {byErrand[4]} to a site, {byErrand[5]} working a site");
                System.IO.Console.println($"  of {onErrand} on an errand: {atTarget} standing ON their target with nothing happening, {farOff} further away than the search ever looks, {avg} tiles to go on average, {this.strayed} sent home for straying, {folk.stuckGaveUp()} gave up wedged against terrain");
                delete byErrand;
                return;
            }

            // WHO DOES WHAT, over the whole realm. The census that says whether the trades took.
            public method trades(Folk* folk) returns void {
                System.IO.Console.println($"trades: {this.learned} learned from a neighbour, {this.selfTaught} with nobody to learn from, {this.gaveBack} temporary builders released");
                System.IO.Console.println($"sites: {this.ordered} ordered, {this.raised} raised, {this.hashes} hashes, {this.hauled} carried store to site; refused {this.cannotAfford} could not pay, {this.sitesFull} too many open, {this.siteFull} site at its ceiling");
                mutable int[] tally = new int[Gathers.crafts()]();
                mutable int c = 0;
                while (c < this.cities.size()) {
                    mutable City* one = this.cities.get(c);
                    mutable int t = 0;
                    while (t < one.residents.size()) {
                        int cr = folk.at(one.residents.get(t)).trade;
                        tally[cr] = tally[cr] + 1;
                        t = t + 1;
                    }
                    c = c + 1;
                }
                mutable int k = 0;
                while (k < Gathers.crafts()) {
                    if (tally[k] > 0) {
                        System.IO.Console.println($"  trade {k}: {tally[k]} people");
                    }
                    k = k + 1;
                }
                delete tally;
                return;
            }

            // Whether a building or a frame changed since anybody last asked, so the renderer
            // knows to rebuild the town layer. Same shape as `changed` and `mapCut`: asking
            // clears it, because two readers of one flag is a bug waiting to be written.
            public method takeTownsCut() returns boolean {
                boolean was = this.townsCut;
                this.townsCut = false;
                return was;
            }


            // ---- the check that keeps the two views honest ----

            // THE CITY LISTS AND THE CELL LAYER MUST SAY THE SAME THING.
            //
            // A bug in claiming does not crash: it makes ground quietly belong to nobody, or to two
            // cities at once, which reads as a rendering problem and is not. So the two are counted
            // against each other rather than trusted, exactly as Folk.auditIndex counts the block
            // chains against the roll.
            public method audit() returns boolean {
                mutable long onLayer = 0;
                mutable int i = 0;
                int n = this.w * this.h;
                while (i < n) {
                    if (this.cityOf[i] >= 0) {
                        onLayer = onLayer + 1;
                    }
                    i = i + 1;
                }
                mutable long onLists = 0;
                mutable int wrong = 0;
                mutable int c = 0;
                while (c < this.cities.size()) {
                    mutable City* one = this.cities.get(c);
                    onLists = onLists + cast<long>(one.tiles.size());
                    mutable int t = 0;
                    while (t < one.tiles.size()) {
                        if (this.cityOf[one.tiles.get(t)] != one.id) {
                            wrong = wrong + 1;
                        }
                        t = t + 1;
                    }
                    c = c + 1;
                }
                boolean ok = onLayer == onLists && wrong == 0;
                System.IO.Console.println($"territory: {onLayer} cells owned on the layer, {onLists} on the city lists, {wrong} disagree");
                if (!ok) {
                    System.IO.Console.println("territory: THE LAYER AND THE LISTS DISAGREE -- a cell is owned twice or by nobody");
                }
                return ok;
            }

            public method report() returns void {
                System.IO.Console.println($"realm: {this.nations.size()} nations, {this.subs.size()} subdivisions, {this.cities.size()} cities");
                mutable int i = 0;
                while (i < this.nations.size()) {
                    mutable Nation* n = this.nations.get(i);
                    System.IO.Console.println($"  nation {n.id}: {n.title()}, {n.subdivisions.size()} subdivisions, capital is city {n.capital}");
                    i = i + 1;
                }
                mutable int c = 0;
                while (c < this.cities.size()) {
                    mutable City* one = this.cities.get(c);
                    System.IO.Console.println($"  city {one.id} at {one.cx},{one.cy}: {one.area()} cells, {one.population()} residents, {one.houses()} buildings");
                    c = c + 1;
                }
                System.IO.Console.println($"realm: {this.claims} cells claimed and {this.releases} given back over the run");
                return;
            }
        }
    }
}
