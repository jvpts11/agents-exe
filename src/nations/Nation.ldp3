import System.Collections.ArrayList;

// THE STATE, WHICH ALSO OWNS NOTHING.
//
// Its territory is the sum of its subdivisions', which is the sum of their cities'. What a nation
// has of its own is who rules it, what it believes, what it knows of the world, and how far its
// ships go.
program AgentsExe;

public bundle Agents {
    public namespace Nations {

        // How a nation is ruled. This decides what its RANKS ARE CALLED and nothing else yet --
        // rank itself is the same integer for everybody, so comparing two nations is comparing two
        // numbers rather than two vocabularies.
        public enum Government {
            Chiefdom,
            Monarchy,
            Republic,
            Theocracy,
            Dictatorship
        }

        // WHAT A NATION BELIEVES, which changes WHO LEAVES and WHERE THEY LOOK -- never deciding
        // for anybody. It is a modifier on a person's own decision, not a second decision made
        // over their head.
        //
        // The test this has to pass is visual: four nations with four ideologies must produce four
        // recognisably different maps. If they come out alike, ideology is wired to nothing and the
        // model is lying about having it.
        //
        // Four of these have nothing to act through yet -- Mercantilism, Capitalism, Technocracy
        // and Fundamentalism all need trade, war or an economy. They are declared and inert, which
        // is honest; giving them invented effects would not be.
        public enum Ideology {
            Absolutism,       // glory and territory: many colonies, scattered, far
            Feudalism,        // land granted to vassals: one continuous spread, many subdivisions
            Mercantilism,     // routes and trading posts: points on the coast          (inert)
            Capitalism,       // profit: few and chosen, sitting on resources           (inert)
            Socialism,        // plan and collective support: rare, large, seldom fail
            Communalism,      // local autonomy: many small cities, a weak capital
            Anarchism,        // nothing directed: the individual engine only
            Nationalism,      // land of its own people: expands where its culture is
            Fundamentalism,   // conversion: goes after peoples, not empty land         (inert)
            Technocracy,      // knowledge and rare resource: few cities, very dense    (inert)
            Isolationism      // does not expand: thickens instead of growing
        }

        public class Nation {
            public mutable int id;
            public mutable int name;          // catalogue number, not the text
            // THE RULER'S, not the nation's own. When the ruler changes, these change with him --
            // which is a decision with consequences, and it is João's.
            public mutable int culture;
            public mutable int religion;
            public mutable int government;    // Government ordinal
            public mutable int ideology;      // Ideology ordinal
            public mutable int ruler;         // agent id
            public mutable int capital;       // CITY id
            public mutable int rank;          // 0..2; the name depends on the government
            public mutable ArrayList<int>* laws;          // stored, inert this slice
            public mutable ArrayList<int>* subdivisions;
            // WHAT THIS NATION KNOWS OF THE WORLD, one bit per 32-cell block.
            //
            // Never drawn. The player sees everything, always -- the fog exists so that a NATION
            // decides on what that nation has seen, and for no other reason.
            //
            // Per block rather than per cell on purpose: 3,600 bits is about 450 bytes a nation,
            // where per-cell would be 345 KB each and seventeen megabytes across fifty of them. The
            // question it answers is "do I know that coast", and a block answers that as well as a
            // cell does.
            public mutable boolean[] known;
            // How far its ships cross open water, in cells. This is what makes overseas
            // colonisation a thing of STATE: an unhappy farmer does not cross an ocean, an
            // expedition of the crown does.
            public mutable int seaReach;

            public constructor Nation(int who, int blocks) {
                this.id = who;
                this.name = 0 - 1;
                this.culture = 0 - 1;
                this.religion = 0 - 1;
                this.government = cast<int>(Government.Chiefdom);
                this.ideology = cast<int>(Ideology.Anarchism);
                this.ruler = 0 - 1;
                this.capital = 0 - 1;
                this.rank = 0;
                this.seaReach = 0;
                this.laws = new ArrayList<int>() on heap;
                this.subdivisions = new ArrayList<int>() on heap;
                this.known = new boolean[blocks]();
            }

            public destructor ~Nation() returns void {
                delete this.laws;
                delete this.subdivisions;
                delete this.known;
                return;
            }

            // What this rank is CALLED, which is the only thing the government decides so far.
            public method title() returns String {
                if (this.government == cast<int>(Government.Monarchy)) {
                    if (this.rank == 0) { return "Duchy"; }
                    if (this.rank == 1) { return "Kingdom"; }
                    return "Empire";
                }
                if (this.government == cast<int>(Government.Republic)) {
                    if (this.rank == 0) { return "City-state"; }
                    if (this.rank == 1) { return "Republic"; }
                    return "Federation";
                }
                if (this.government == cast<int>(Government.Theocracy)) {
                    if (this.rank == 0) { return "Congregation"; }
                    if (this.rank == 1) { return "Theocracy"; }
                    return "Caliphate";
                }
                if (this.government == cast<int>(Government.Dictatorship)) {
                    if (this.rank == 0) { return "Junta"; }
                    if (this.rank == 1) { return "Regime"; }
                    return "Dominion";
                }
                if (this.rank == 0) { return "Clan"; }
                if (this.rank == 1) { return "Tribe"; }
                return "Confederation";
            }
        }
    }
}
