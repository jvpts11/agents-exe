import System.IO.Console;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.Biomes;
import Agents.Gfx.SoftPainter;

// Entry point. Slice 2 (headless verification): generate a world and dump it top-down to a PPM through
// the software painter -- the exact colours the on-screen renderer will later draw. The GL window and
// the isometric renderer come in the next slices.
program AgentsExe;

public bundle Agents {
    public namespace App {

        public class Main {
            public static method main(string[] args) returns void {
                int w = 512;
                int h = 512;
                WorldGen gen = new WorldGen(42) on stack;
                Grid* g = gen.generate(w, h);
                SoftPainter sp = new SoftPainter(w, h) on stack;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int b = g.biomeAt(x, y);
                        sp.fillRect(x, y, 1, 1, Biomes.red(b), Biomes.green(b), Biomes.blue(b));
                        x = x + 1;
                    }
                    y = y + 1;
                }
                sp.save("world.ppm");
                System.IO.Console.println("wrote world.ppm");
                delete g;
                return;
            }
        }
    }
}
