import System.IO.Console;
import System.IO.File;
import System.Text.StringBuilder;
import opengl.glfw.GlWindow;
import opengl.glfw.InputEvent;
import opengl.gl.Wgl;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.Biomes;
import Agents.Gfx.SoftPainter;
import Agents.Gfx.GlPainter;
import Agents.Gfx.Batch2D;
import Agents.Gfx.Camera;
import Agents.Gfx.WorldRenderer;
import Agents.Gfx.MeshAtlas;
import Agents.Gfx.Raster3D;
import Agents.Gfx.World3D;
import Agents.Gfx.GlWorld3D;

// Entry point. Slice 4: generate a world and show it ISOMETRICALLY in a GL window -- pan with
// WASD/arrows, zoom with the scroll wheel or +/-, ESC to quit. Running with any argument (or when no
// GL window is available) instead writes a software snapshot PPM, the same scene the window draws --
// used for headless verification.
program AgentsExe;

public bundle Agents {
    public namespace App {

        public class Main {
            public static method main(string[] args) returns void {
                if (args.length() > 0) {
                    if (args[0].equals("gen3d")) {
                        Main.render3dSnapshot();
                        return;
                    }
                    if (args[0].equals("glworld")) {
                        Main.captureGlWorld();
                        return;
                    }
                    if (args[0].equals("worldmaps")) {
                        Main.worldMaps();
                        return;
                    }
                    if (args[0].equals("iso2d")) {
                        Main.runIso2d();
                        return;
                    }
                }
                // Default: the interactive true-3D world (free orbit camera).
                Main.renderGlWorld();
                return;
            }

            // The legacy 2D isometric view (kept behind `iso2d`).
            private static method runIso2d() returns void {
                int w = 2560;
                int h = 1080;
                System.IO.Console.println("iso2d: generating a world...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                System.IO.Console.println("world ready.");
                if (Main.runWindow(g, w, h)) {
                    delete g;
                    return;
                }
                System.IO.Console.println("no GL window; writing a snapshot instead.");
                Main.writeSnapshot(g, w, h);
                delete g;
                return;
            }

            // The interactive isometric window. Returns false if no GL window could be opened.
            private static method runWindow(Grid* g, int w, int h) returns boolean {
                int sw = 1280;
                int sh = 720;
                GlWindow* win = new GlWindow() on heap;
                if (win.open("agents.exe -- world", sw, sh, 3, 3) == 0) {
                    delete win;
                    return false;
                }
                win.setVSync(1);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GlPainter* gp = new GlPainter(batch) on heap;
                Camera cam = new Camera(sw, sh) on heap;
                cam.focusCell(w / 2, h / 2);
                cam.setZoom(0.42);
                int pan = 18;
                while (win.isOpen()) {
                    win.pump();
                    if (win.keyDown(0x1B)) {           // ESC
                        break;
                    }
                    if (win.keyDown(0x57) || win.keyDown(0x26)) { cam.panPixels(0, pan); }        // W / Up
                    if (win.keyDown(0x53) || win.keyDown(0x28)) { cam.panPixels(0, 0 - pan); }    // S / Down
                    if (win.keyDown(0x41) || win.keyDown(0x25)) { cam.panPixels(pan, 0); }        // A / Left
                    if (win.keyDown(0x44) || win.keyDown(0x27)) { cam.panPixels(0 - pan, 0); }    // D / Right
                    int sc = win.takeScroll();
                    if (sc > 0) { cam.zoomBy(1.12); }
                    if (sc < 0) { cam.zoomBy(0.89); }
                    if (win.keyDown(0xBB) || win.keyDown(0x6B)) { cam.zoomBy(1.03); }             // +
                    if (win.keyDown(0xBD) || win.keyDown(0x6D)) { cam.zoomBy(0.97); }             // -
                    int cw = win.width();
                    int ch = win.height();
                    cam.resize(cw, ch);
                    Wgl.glViewport(0, 0, cw, ch);
                    Wgl.glClearColor(0.07, 0.16, 0.26, 1.0);
                    Wgl.glClear(0x4000);
                    batch.begin(cw, ch, 0);
                    WorldRenderer.draw(gp, g, cam, cw, ch);
                    batch.flush();
                    win.swap();
                }
                delete cam;
                delete gp;
                delete batch;
                delete win;
                return true;
            }

            // Headless verification of the TRUE-3D path: generate a small real world and render it with
            // the baked biome models (elevation -> height), writing world3d.ppm.
            private static method render3dSnapshot() returns void {
                int w = 64;
                int h = 40;
                System.IO.Console.println("gen3d: generating a small world...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.worldStats(g, w, h);
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("gen3d: assets/models not found.");
                    delete g;
                    return;
                }
                System.IO.Console.println("gen3d: loading models...");
                MeshAtlas* atlas = MeshAtlas.loadTerrain(root);
                System.IO.Console.println("gen3d: rendering in 3D...");
                Raster3D* r = new Raster3D(960, 600, 2) on heap;
                World3D.render(r, g, atlas, 0, 0, w, h, 9.0);
                r.savePPM("world3d.ppm", 20, 26, 36);
                System.IO.Console.println("gen3d: wrote world3d.ppm");
                delete r;
                delete atlas;
                delete g;
                return;
            }

            // GL true-3D path: generate a world, bake it into a VBO, render one frame with the orbit
            // camera + cel shading, and read it back to gl_world.ppm (headless-verifiable). The free
            // camera loop runs when a real window is present.
            // Find assets/models regardless of the working directory (double-click runs from the exe's
            // folder, the terminal from the repo root). Returns "" if none of the candidates has it.
            private static method assetRoot() returns String {
                if (File.readAll("assets/models/terrain.index").length() > 0) {
                    return "assets/models";
                }
                if (File.readAll("../assets/models/terrain.index").length() > 0) {
                    return "../assets/models";
                }
                if (File.readAll("../../assets/models/terrain.index").length() > 0) {
                    return "../../assets/models";
                }
                return "";
            }

            // The interactive true-3D world: generate, bake into a VBO (LOD stride so the whole
            // 2560x1080 fits), then an inspection camera loop -- left-drag or arrows rotate/tilt (tilt
            // gimbal-locked between horizontal and top-down), wheel or +/- zoom, WASD pan, ESC quits.
            private static method renderGlWorld() returns void {
                int w = 2560;
                int h = 1080;
                System.IO.Console.println("agents.exe: generating the world...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("assets/models not found next to the executable.");
                    delete g;
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("agents.exe -- world  [drag/arrows rotate | wheel zoom | WASD pan (Shift fast) | P pixel filter | ESC]", 1280, 720, 3, 3) == 0) {
                    System.IO.Console.println("no GL window available.");
                    delete win;
                    delete g;
                    return;
                }
                win.setVSync(1);
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, 8, 26.0);
                Batch2D* hud = new Batch2D(win.gl) on heap;
                mutable int lastX = win.cursorX();
                mutable int lastY = win.cursorY();
                while (win.isOpen()) {
                    win.pump();
                    if (win.keyDown(0x1B)) {
                        break;
                    }
                    int mx = win.cursorX();
                    int my = win.cursorY();
                    if (win.keyDown(0x01) && win.isForeground()) {
                        r.orbit(cast<float>(mx - lastX) * 0.35, 0.0 - cast<float>(my - lastY) * 0.30);
                    }
                    lastX = mx;
                    lastY = my;
                    if (win.keyDown(0x25)) { r.orbit(0.0 - 1.6, 0.0); }
                    if (win.keyDown(0x27)) { r.orbit(1.6, 0.0); }
                    if (win.keyDown(0x26)) { r.orbit(0.0, 1.2); }
                    if (win.keyDown(0x28)) { r.orbit(0.0, 0.0 - 1.2); }
                    int sc = win.takeScroll();
                    if (sc > 0) { r.zoomBy(0.88); }
                    if (sc < 0) { r.zoomBy(1.0 / 0.88); }
                    if (win.keyDown(0xBB) || win.keyDown(0x6B)) { r.zoomBy(0.97); }
                    if (win.keyDown(0xBD) || win.keyDown(0x6D)) { r.zoomBy(1.0 / 0.97); }
                    while (win.hasEvent()) {
                        InputEvent* ev = win.nextEvent();
                        if (ev.isKey() && ev.vk == 0x50 && !ev.repeat) {   // P: toggle the pixel filter
                            r.pixelate = !r.pixelate;
                        }
                        delete ev;
                    }
                    mutable float pan = r.curDist() * 0.007;
                    if (win.modShift()) {
                        pan = pan * 3.5;
                    }
                    if (win.keyDown(0x57)) { r.pan(0.0 - pan, 0.0); }
                    if (win.keyDown(0x53)) { r.pan(pan, 0.0); }
                    if (win.keyDown(0x41)) { r.pan(0.0, pan); }
                    if (win.keyDown(0x44)) { r.pan(0.0, 0.0 - pan); }
                    int cw = win.width();
                    int ch = win.height();
                    r.render(cw, ch);
                    hud.begin(cw, ch, 0);
                    r.drawCompass(hud, cw, ch);
                    hud.flush();
                    win.swap();
                }
                delete hud;
                delete r;
                delete props;
                delete terr;
                delete g;
                delete win;
                return;
            }

            // Nearest forest-ish cell to the map centre (for the close-up verification frame).
            private static method findForest(Grid* g, int w, int h) returns int {
                mutable int bestX = w / 2;
                mutable int bestY = h / 2;
                mutable int bestD = 2000000000;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int ord = g.biomeAt(x, y);
                        if (ord == 14 || ord == 22 || ord == 23 || ord == 27) {
                            mutable int dx = x - w / 2;
                            if (dx < 0) { dx = 0 - dx; }
                            mutable int dy = y - h / 2;
                            if (dy < 0) { dy = 0 - dy; }
                            int d = dx + dy;
                            if (d < bestD) {
                                bestD = d;
                                bestX = x;
                                bestY = y;
                            }
                        }
                        x = x + 4;
                    }
                    y = y + 4;
                }
                return bestY * w + bestX;
            }

            // Headless verification of the GL path: render one frame of the full world and read it back
            // to gl_world.ppm (+ a top-down biome map), no interactive loop.
            private static method captureGlWorld() returns void {
                int w = 2560;
                int h = 1080;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.writeBiomeMap(g, w, h, 720, 304, "glworld_map.ppm");
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("captureGlWorld: assets/models not found.");
                    delete g;
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("capture", 960, 600, 3, 3) == 0) {
                    System.IO.Console.println("captureGlWorld: no GL window.");
                    delete win;
                    delete g;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, 8, 26.0);
                Batch2D* hud = new Batch2D(win.gl) on heap;
                int cw = win.width();
                int ch = win.height();
                // far frame (whole world, coarse LOD) + compass
                r.render(cw, ch);
                hud.begin(cw, ch, 0);
                r.drawCompass(hud, cw, ch);
                hud.flush();
                byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px, cw, ch, "gl_world.ppm");
                delete px;
                // near frame: aim at the closest forest and zoom under the detail threshold
                int packed = Main.findForest(g, w, h);
                r.aimAt(packed % w, packed / w);
                r.setView(42.0, 35.0, 130.0);
                r.render(cw, ch);
                hud.begin(cw, ch, 0);
                r.drawCompass(hud, cw, ch);
                hud.flush();
                byte[] px2 = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px2, cw, ch, "gl_world_near.ppm");
                delete px2;
                delete hud;
                delete r;
                delete props;
                delete terr;
                delete g;
                delete win;
                System.IO.Console.println("captureGlWorld: wrote gl_world.ppm + gl_world_near.ppm");
                return;
            }

            private static method writePpmFlipped(byte[] px, int w, int h, String path) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(w);
                sb.append(" ");
                sb.appendInt(h);
                sb.append("\n255\n");
                mutable int y = 0;
                while (y < h) {
                    int srcRow = h - 1 - y;
                    mutable int x = 0;
                    while (x < w) {
                        int i = (srcRow * w + x) * 3;
                        sb.appendInt(cast<int>(px[i]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 1]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 2]) & 255);
                        sb.append(" ");
                        x = x + 1;
                    }
                    sb.append("\n");
                    y = y + 1;
                }
                File.writeAll(path, sb.toString());
                delete sb;
            }

            // Generate all four world modes and write a top-down biome-colour overview PNG of each --
            // the fast way to verify continent shapes per mode.
            private static method worldMaps() returns void {
                int w = 1280;
                int h = 540;
                mutable int mode = 0;
                while (mode < 4) {
                    System.IO.Console.println("worldmaps: generating mode...");
                    WorldGen gen = new WorldGen(42) on stack;
                    gen.setWorld(mode, 0.0 - 1.0);
                    Grid* g = gen.generate(w, h);
                    Main.worldStats(g, w, h);
                    Main.writeBiomeMap(g, w, h, 640, 270, Main.mapName(mode));
                    delete g;
                    mode = mode + 1;
                }
                System.IO.Console.println("worldmaps: done");
            }

            private static method mapName(int mode) returns String {
                if (mode == 0) { return "worldmap_continental.ppm"; }
                if (mode == 1) { return "worldmap_pangaea.ppm"; }
                if (mode == 2) { return "worldmap_archipelago.ppm"; }
                return "worldmap_inlandseas.ppm";
            }

            // Downsample the biome grid to outW x outH and write it top-down as a PPM (biome palette).
            private static method writeBiomeMap(Grid* g, int w, int h, int outW, int outH, String path) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(outW);
                sb.append(" ");
                sb.appendInt(outH);
                sb.append("\n255\n");
                mutable int oy = 0;
                while (oy < outH) {
                    int sy = oy * h / outH;
                    mutable int ox = 0;
                    while (ox < outW) {
                        int sx = ox * w / outW;
                        int ord = g.biomeAt(sx, sy);
                        sb.appendInt(Biomes.red(ord));
                        sb.append(" ");
                        sb.appendInt(Biomes.green(ord));
                        sb.append(" ");
                        sb.appendInt(Biomes.blue(ord));
                        sb.append(" ");
                        ox = ox + 1;
                    }
                    sb.append("\n");
                    oy = oy + 1;
                }
                File.writeAll(path, sb.toString());
                delete sb;
            }

            private static method worldStats(Grid* g, int w, int h) returns void {
                mutable int water = 0;
                mutable int land = 0;
                mutable int emin = 100000;
                mutable int emax = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int e = g.elevAt(x, y);
                        if (e < emin) { emin = e; }
                        if (e > emax) { emax = e; }
                        if (g.biomeAt(x, y) <= 6) {
                            water = water + 1;
                        } else {
                            land = land + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("gen3d: water=");
                sb.appendInt(water);
                sb.append(" land=");
                sb.appendInt(land);
                sb.append(" elev[");
                sb.appendInt(emin);
                sb.append("..");
                sb.appendInt(emax);
                sb.append("]");
                System.IO.Console.println(sb.toString());
                delete sb;
            }

            private static method writeSnapshot(Grid* g, int w, int h) returns void {
                int sw = 1280;
                int sh = 720;
                SoftPainter sp = new SoftPainter(sw, sh) on stack;
                sp.fillRect(0, 0, sw, sh, 18, 41, 66);
                Camera cam = new Camera(sw, sh) on stack;
                cam.focusCell(w / 2, h / 2);
                cam.setZoom(0.42);
                WorldRenderer.draw(sp, g, cam, sw, sh);
                sp.save("world_iso.ppm");
                System.IO.Console.println("wrote world_iso.ppm");
            }
        }
    }
}
