import System.IO.Console;
import System.IO.File;
import System.Text.StringBuilder;
import System.Text.Strings;
import System.Time.Time;
import opengl.glfw.GlWindow;
import opengl.glfw.InputEvent;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.Biomes;
import Agents.World.LandMath;
import Agents.World.Nodes;
import Agents.Sim.Meter;
import Agents.Sim.Phase;
import Agents.World.WorldAudit;
import Agents.World.Landmass;
import Agents.Gfx.Batch2D;
import Agents.Gfx.Hud;
import Agents.Gfx.MeshAtlas;
import Agents.Gfx.GlWorld3D;
import Agents.App.Options;
import Agents.App.Gear;
import Agents.App.Ppm;
import Agents.App.CellSearch;
import Agents.App.CellHit;
import System.Errors.Option;
import Agents.World.Contour;
import Agents.App.ShotRig;
import Agents.App.Key;

// Entry point. `AgentsExe game` opens the world in a GL window and is what the project is for;
// everything else here is an instrument that measures or captures some part of it without a person
// at the keyboard. Run with no argument, it plays -- a double-clicked executable must start the
// game, not a diagnostic.
program AgentsExe;

public bundle Agents {
    public namespace App {

        public class Main {
            public static method main(string[] args) returns void {
                // THE GAME IS THE DEFAULT, and it is also a word. No argument at all has to play,
                // because that is what a double-clicked executable does; `game` exists so the
                // launch can be written down, so it can carry options, and so a run of the real
                // thing looks like every other command rather than like the absence of one.
                if (args.length() == 0 || args[0].equals("game")) {
                    Main.game(args);
                    return;
                }
                if (args.length() > 0) {
                    if (args[0].equals("glworld")) {
                        Main.captureGlWorld();
                        return;
                    }
                    if (args[0].equals("worldmaps")) {
                        Main.worldMaps();
                        return;
                    }
                    if (args[0].equals("audit")) {
                        Main.audit();
                        return;
                    }
                    if (args[0].equals("gensize")) {
                        Main.genSize(args);
                        return;
                    }
                    if (args[0].equals("highshot")) {
                        Main.highShot();
                        return;
                    }
                    if (args[0].equals("cliffshot")) {
                        Main.cliffShot();
                        return;
                    }
                    if (args[0].equals("nodeshot")) {
                        Main.nodeShot();
                        return;
                    }
                    if (args[0].equals("forestshot")) {
                        Main.forestShot();
                        return;
                    }
                    // `folkshot`, `simrun` and `weigh` lived here. All three drove a population
                    // that no longer exists; whatever the new model needs in order to be watched
                    // without a window gets written against the new model, rather than kept as the
                    // shape the old one happened to leave behind.
                    if (args[0].equals("probe")) {
                        Main.probeSeam();
                        return;
                    }
                    if (args[0].equals("preview")) {
                        Main.preview();
                        return;
                    }
                    if (args[0].equals("plates")) {
                        Landmass* lm = new Landmass(42) on heap;
                        lm.dumpPlates(1280, 720, 6);
                        delete lm;
                        return;
                    }
                    // A WORD THAT IS NOT A COMMAND IS A MISTAKE, and must say so.
                    //
                    // This used to be unreachable for numbers: an unrecognised argument was read as
                    // a SEED, so `gensiz` silently became seed 42 and opened the interactive
                    // window. Under `check.ps1`, which runs commands by name and waits for the
                    // process to exit, that meant waiting for a window nobody was going to close --
                    // 73 seconds of CPU on the machine where it happened. Nothing is a seed on this
                    // line now, so every word here is either a command or a mistake.
                    System.IO.Console.println($"agents.exe: '{args[0]}' is not a command.");
                    System.IO.Console.println("commands: game glworld worldmaps audit gensize");
                    System.IO.Console.println("          highshot cliffshot nodeshot forestshot");
                    System.IO.Console.println("          probe preview plates");
                    System.IO.Console.println("`game`, or no argument at all, plays; it takes gear= and for=.");
                    return;
                }
                return;
            }

            // The world every game is played on. One number, written once.
            public static fixed int SEED = 42;

            // THE GAME. Everything else in this file exists to measure it.
            //
            // THE WORLD IS NOT CONFIGURED FROM OUT HERE. Seed 42, always, because that is what
            // makes one run comparable to the last; a seed on the command line was a way of running
            // this without a person in the room, and that is not a question the game should be
            // shaped by.
            //
            // NEITHER OPTION TAKES ANYTHING AWAY FROM THE PLAYER, and that is the line the two of
            // them sit on. `gear=` sets the speed the window OPENS at; the 1-6 keys and the space
            // bar keep working exactly as they did, so it moves where a session starts and not what
            // the player may do. `for=` closes the window when the time is up, so a session ends by
            // itself -- the implementation is developed against the real game rather than a probe,
            // and this is what lets the real game be started by something that is not a hand.
            //
            // Both are absent by default, and absent means THE ORDINARY START rather than a value.
            // `game gear=1` and `game` do the same thing today and are still not the same
            // statement: if the ordinary start ever changes -- a remembered speed, opening paused
            // -- the first keeps meaning gear one and the second keeps meaning whatever the game
            // does. That is why `asked` exists instead of a default of -1.
            //
            // What the trace path measured is kept because it was real -- a mature world traced
            // per-agent writes about a gigabyte a minute -- but nothing is simulated yet, so it
            // comes back with whatever asks for it, on the simulation's terms rather than as a word
            // on a command line.
            private static method game(string[] args) returns void {
                Options cmd = new Options(args) on stack;
                int seconds = cmd.number("for", 0);
                mutable Gear start = Gear.One;
                if (cmd.asked("gear")) {
                    start = Gear.onKey(cmd.number("gear", 1));
                }
                String odd = cmd.stray();
                if (odd.length() > 0) {
                    System.IO.Console.println($"agents.exe game: '{odd}' is not an option.");
                    System.IO.Console.println("options: gear=1..6 (the speed it OPENS at; the keys still work)");
                    System.IO.Console.println("         for=SECONDS (close the window by itself)");
                    return;
                }
                Main.renderGlWorld(Main.SEED, seconds, start);
                return;
            }

            // Generate one world at a given size and say how long each stage took.
            //
            // WHAT THIS IS FOR: "a world costs about four seconds" is not a number anybody can act
            // on. It answers two questions that are, and neither can be got from the other commands
            // because they all generate at one fixed size: does the cost scale with the CELL COUNT
            // -- twice the width and twice the height should be four times the work, and anything
            // steeper is an algorithm in the wrong complexity class rather than an honest price --
            // and which stage owns the time.
            private static method genSize(string[] args) returns void {
                Options cmd = new Options(args) on stack;
                int w = cmd.number("w", 2560);
                int h = cmd.number("h", 1440);
                String odd = cmd.stray();
                if (odd.length() > 0) {
                    System.IO.Console.println($"agents.exe gensize: '{odd}' is not an option.");
                    System.IO.Console.println("options: w=N  h=N");
                    return;
                }
                long t0 = Time.millis();
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                long t1 = Time.millis();
                long cells = cast<long>(w) * cast<long>(h);
                // Nanoseconds per cell: the figure that is comparable across sizes, and the one a
                // superlinear stage moves while the raw seconds only ever go up.
                mutable long perCell = 0;
                if (cells > 0) {
                    perCell = (t1 - t0) * 1000000 / cells;
                }
                System.IO.Console.println($"gensize {w}x{h}: {t1 - t0} ms for {cells} cells, {perCell} ns per cell");
                mutable int s = 0;
                while (s < WorldGen.STAGES) {
                    long ms = WorldGen.stageMs[s];
                    mutable long share = 0;
                    if (t1 - t0 > 0) {
                        share = ms * 1000 / (t1 - t0);
                    }
                    System.IO.Console.println($"  {WorldGen.stageName(s)}: {ms} ms ({share} per mille)");
                    s = s + 1;
                }
                delete g;
                return;
            }

            // A walkable cell, uniformly drawn. Returns the packed cell, or -1 if the world has no
            // walkable ground at all -- which is a worldgen failure and says so.
            private static method somewhereWalkable(Grid* g, int seed) returns int {
                int w = g.width();
                int h = g.height();
                mutable int tries = 0;
                while (tries < 20000) {
                    tries = tries + 1;
                    int gx = cast<int>(LandMath.hash01(seed ^ 0x7A11, tries, 3)
                                       * cast<float>(w - 1));
                    int gy = cast<int>(LandMath.hash01(seed ^ 0x3C5D, tries, 5)
                                       * cast<float>(h - 1));
                    // GROUND A TOWN MAY STAND ON, not merely ground a body may cross. Mountains
                    // and shallow water are both passable now; neither is a place to found a
                    // country.
                    if (Biomes.buildable(g.biomeAt(gx, gy))) {
                        return gy * w + gx;
                    }
                }
                System.IO.Console.println("realm: found nowhere to found a nation in 20000 draws");
                return 0 - 1;
            }

            // Find assets/models regardless of the working directory (double-click runs from the
            // exe's folder, the terminal from the repo root). Returns "" if no candidate has it.
            private static method assetRoot() returns String {
                if (File.readAll("assets/models/terrain.index").length() > 0) {
                    return "assets/models";
                }
                if (File.readAll("../assets/models/terrain.index").length() > 0) {
                    return "../assets/models";
                }
                if (File.readAll("../../assets/models/terrain.index").length() > 0) {
                    return "../../assets/models";
                }
                return "";
            }

            // At most this many world ticks in one frame. Without it, gear 6 on a slow machine
            // spends the whole frame simulating and the window stops answering the keyboard --
            // including the key that would slow it back down.
            public static fixed int TICK_CAP = 64;

            // The interactive true-3D world: generate, bake into a VBO (LOD stride so the whole
            // 2560x1440 fits), then the camera loop -- left-drag or arrows rotate/tilt (tilt
            // gimbal-locked between horizontal and top-down), wheel or +/- zoom, WASD pan, 1-6
            // gears, space pauses, ESC quits.
            //
            // `seconds` closes the window when it runs out, and 0 means never. IT IS NOT A TEST
            // MODE and it is not a setting of the game: the same world, the same loop, the same
            // report on the way out, with the ESC on a clock. It exists because the implementation
            // is developed against the real game rather than a probe, and a check that needs a
            // person to close a window is a check nobody runs twice.
            //
            // `opensAt` is where the speed STARTS. The gear is still the player's -- the 1-6 keys
            // write the same variable this initializes -- so this moves the beginning of a session
            // and takes nothing away from it.
            private static method renderGlWorld(int seed, int seconds, Gear opensAt) returns void {
                int w = 2560;
                int h = 1440;
                System.IO.Console.println("agents.exe: generating the world...");
                // The world a player gets is SEARCHED for, not merely rolled. WorldAudit's criteria
                // are what makes a world worth playing, and three seeds in twelve produce one they
                // reject -- one continent and five scraps, or fourteen islands. Six tries is ample:
                // nine in twelve pass on the first roll.
                Grid* g = WorldGen.acceptable(seed, 0, 0.0 - 1.0, 0, w, h, 6, true);
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("assets/models not found next to the executable.");
                    delete g;
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("agents.exe -- world  [drag/arrows rotate | wheel zoom | WASD pan (Shift fast) | P pixel filter | ESC]", 1280, 720, 3, 3) == 0) {
                    System.IO.Console.println("no GL window available.");
                    delete win;
                    delete g;
                    return;
                }
                win.setVSync(1);
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                // THE WORLD, AND NOTHING LIVING IN IT.
                //
                // The people, the towns and the borders were taken out on purpose. The agent they
                // all stood on was not the one that was specified -- it was one class per agent,
                // which the design rules out in as many words -- and everything raised on top of
                // it was tuned against a walker that bounces off a shoreline instead of going
                // round it. Code that survives a wrong foundation is code whose every constant was
                // fitted to the wrong world.
                //
                // What is left is what was never in question: the world, how it is drawn, and the
                // catalogues of what can be built and gathered. The agent is written next, on its
                // own, against the design -- and behaviour comes back after it, one verb at a
                // time, each one measured against a world that works.
                //
                // THE CAMERA STILL OPENS ON THE GROUND, though there is nobody standing on it.
                // `setup` frames the entire map, and from there a continent is a smudge and the
                // detail layer never even starts -- so the one thing the window still has to show,
                // the world close up, is the one thing it does not. It opens on a walkable cell
                // instead, the same draw a founding used to use.
                int where = Main.somewhereWalkable(g, seed);
                if (where >= 0) {
                    r.aimAt(where % g.width(), where / g.width());
                    r.setView(35.0, 40.0, 55.0);
                }
                Batch2D* hud = new Batch2D(win.gl) on heap;
                Hud* text = new Hud(win.gl, 14) on heap;
                mutable int lastX = win.cursorX();
                mutable int lastY = win.cursorY();
                mutable int wanderTick = 0;
                // The gear the world is running at, the fraction of a tick carried over from the
                // last frame, and how many ticks the machine could not keep up with.
                mutable Gear gear = opensAt;
                // SAY WHAT SPEED IT OPENED AT. The gear is on the HUD and in the title, which is
                // no use to a run nobody is watching -- and a run whose speed is not written down
                // is how three minutes of this project's world once got recorded as gear 6 while
                // it advanced one tick a frame.
                System.IO.Console.println($"agents.exe: opening at gear {gear.number()}.");
                mutable boolean paused = false;
                mutable float owed = 0.0;
                // THE WHOLE FRAME IS MEASURED, not the part the renderer happens to own. The meter
                // used to be opened and closed inside `render`, which left the input, the moving of
                // half a million people, the HUD and the buffer swap outside it -- and those turned
                // out to be most of the frame. The clock now opens here and every stretch between
                // one `lap` and the next belongs to a named phase.
                Meter* gauge = r.frameMeter();
                // Started AFTER the world is built and the atlases are loaded, so `for=60` is sixty
                // seconds of the GAME rather than sixty seconds minus however long generation took
                // that day.
                long stopAt = Time.millis() + cast<long>(seconds) * 1000;
                while (win.isOpen()) {
                    gauge.begin();
                    win.pump();
                    if (win.keyDown(Key.ESCAPE)) {
                        break;
                    }
                    if (seconds > 0 && Time.millis() >= stopAt) {
                        System.IO.Console.println($"agents.exe: {seconds} seconds are up.");
                        break;
                    }
                    int mx = win.cursorX();
                    int my = win.cursorY();
                    if (win.keyDown(Key.LEFT_MOUSE) && win.isForeground()) {
                        r.orbit(cast<float>(mx - lastX) * 0.35, 0.0 - cast<float>(my - lastY) * 0.30);
                    }
                    lastX = mx;
                    lastY = my;
                    if (win.keyDown(Key.ARROW_LEFT)) { r.orbit(0.0 - 1.6, 0.0); }
                    if (win.keyDown(Key.ARROW_RIGHT)) { r.orbit(1.6, 0.0); }
                    if (win.keyDown(Key.ARROW_UP)) { r.orbit(0.0, 1.2); }
                    if (win.keyDown(Key.ARROW_DOWN)) { r.orbit(0.0, 0.0 - 1.2); }
                    int sc = win.takeScroll();
                    if (sc > 0) { r.zoomBy(0.88); }
                    if (sc < 0) { r.zoomBy(1.0 / 0.88); }
                    if (win.keyDown(0xBB) || win.keyDown(0x6B)) { r.zoomBy(0.97); }
                    if (win.keyDown(0xBD) || win.keyDown(0x6D)) { r.zoomBy(1.0 / 0.97); }
                    while (win.hasEvent()) {
                        InputEvent* ev = win.nextEvent();
                        if (ev.isKey() && !ev.repeat) {
                            if (ev.vk == Key.P) {                          // the pixel filter
                                r.togglePixelate();
                            }
                            // THE GEARS AND THE PAUSE, BACK NOW THAT THERE IS A WORLD TO RUN.
                            //
                            // They were taken out when nothing happened in the world -- three keys
                            // that do nothing are worse than three keys that are not there. The
                            // world builds and gathers now, so they belong here again.
                            //
                            // And the pace they set was DEAD until this: `paceOf` computed a
                            // number, `renderGlWorld` took it as a parameter, and no line of code
                            // read it. Every run this project has done, at every gear, ran at one
                            // tick a frame. A speed control nothing is wired to is worse than no
                            // speed control, because the runs get labelled with a speed they
                            // never ran at.
                            if (ev.vk >= Key.DIGIT_1 && ev.vk <= Key.DIGIT_6) {
                                gear = Gear.onKey(ev.vk - Key.DIGIT_1 + 1);
                                paused = false;
                            }
                            if (ev.vk == Key.SPACE) {                      // pause
                                paused = !paused;
                            }
                        }
                        delete ev;
                    }
                    mutable float pan = r.curDist() * 0.007;
                    if (win.modShift()) {
                        pan = pan * 3.5;
                    }
                    if (win.keyDown(Key.W)) { r.pan(0.0 - pan, 0.0); }
                    if (win.keyDown(Key.S)) { r.pan(pan, 0.0); }
                    if (win.keyDown(Key.A)) { r.pan(0.0, 0.0 - pan); }
                    if (win.keyDown(Key.D)) { r.pan(0.0, pan); }
                    int cw = win.width();
                    int ch = win.height();
                    // Everybody moves, every frame. Nothing decides anything yet -- this is the
                    // cost of a world full of people, paid honestly, before any of them is asked
                    // to think.
                    gauge.lap(cast<int>(Phase.Input));
                    // THE GEAR, PAID IN WHOLE TICKS.
                    //
                    // Owed rather than rounded: at gear 1 with a frame to spare the world must
                    // still advance exactly once, and at gear 3 it must advance five times in the
                    // same second whatever the frame rate happens to be. An accumulator is the
                    // only version of that which does not silently change speed when the frame
                    // rate does.
                    //
                    // Capped per frame, and the shortfall is counted. A gear the machine cannot
                    // keep up with has to say so, rather than quietly running slower than the
                    // number on the screen -- which is the same defect as the pace nobody read.
                    if (!paused) {
                        owed = owed + gear.pace();
                    }
                    // THE CLOCK STILL RUNS, AND IT DRIVES NOTHING YET.
                    //
                    // The gear, the accumulator and the shortfall count are kept because they are
                    // about TIME, not about the model that was taken out: whatever the world is
                    // asked to do next is asked to do it a whole number of times a second, and
                    // that machinery took three attempts to get right. The tick advances; nothing
                    // is subscribed to it. The first verb of the new agent subscribes here.
                    mutable int ran = 0;
                    while (owed >= 1.0 && ran < Main.TICK_CAP) {
                        wanderTick = wanderTick + 1;
                        owed = owed - 1.0;
                        ran = ran + 1;
                    }
                    if (owed >= 1.0) {
                        owed = 0.0;                      // do not let a backlog build up forever
                    }
                    gauge.lap(cast<int>(Phase.Moving));
                    r.render(cw, ch);
                    // The frame rate, in the title and on the HUD. There is one clock now instead
                    // of two: with nothing being simulated there is no tick rate to fall out of
                    // step with the frame rate, and a second number that always agreed with the
                    // first would be a number nobody reads.
                    if (gauge.roll()) {
                        // THE GEAR IS ON THE SCREEN. A speed you cannot read off the window is a
                        // speed you cannot report a run at -- which is how three minutes of world
                        // got written down as "gear 6" when it ran at one tick a frame.
                        mutable String at = $"x{gear.number()}";
                        if (paused) {
                            at = "PAUSED";
                        }
                        win.setTitle($"agents.exe -- world  |  {gauge.fps()} fps  |  {at}  |  tick {wanderTick}  [1-6 speed | space pause | drag/arrows rotate | wheel zoom | WASD pan | P pixels | ESC]");
                    }
                    hud.begin(cw, ch, 0);
                    r.drawCompass(hud, cw, ch);
                    text.rates(hud, gauge, ch);
                    hud.flush();
                    gauge.lap(cast<int>(Phase.Hud));
                    // The swap is its own phase because with vertical sync on it is where the frame
                    // WAITS. Time spent here is not work: it is the monitor holding the frame back,
                    // and reading it as cost would send the next optimisation at the wrong target.
                    win.swap();
                    gauge.lap(cast<int>(Phase.Swap));
                    gauge.frame();
                }
                // What the run cost, by part, printed on the way out: the live window is where the
                // real load is, and a profile you have to remember to ask for is a profile nobody
                // reads.
                r.frameMeter().report("frame");
                if (r.overruns() > 0) {
                    System.IO.Console.println($"renderer: {r.overruns()} vertex writes refused past the end of a buffer -- a counting pass and its emitting pass disagreed");
                }
                delete text;
                delete hud;
                delete r;
                delete rivers;
                delete nodeMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                return;
            }

            // Nearest land river cell to the map centre (for the close-up river verification frame).
            private static method findRiver(Grid* g, int w, int h) returns int {
                mutable CellSearch* look = new CellSearch(w, h) on heap;
                look.sampling(2);
                function<boolean, int, int> isRiverBank =
                    lambda[captures: byvalue g](int x, int y) returns boolean {
                        return g.biomeAt(x, y) > 7 && g.hasRiver(x, y);
                    };
                mutable Option<CellHit>* hit = look.nearestToCentre(isRiverBank);
                mutable int packed = 0 - 1;
                match (hit) {
                    case Some(CellHit at) { packed = at.y * w + at.x; }
                    case None() { }
                }
                delete hit;
                delete look;
                return packed;
            }

            // Nearest forest-ish cell to the map centre (for the close-up verification frame).
            //
            // The map centre is the FALLBACK, and it now says so out loud. It used to be the
            // initial value of the running best, so "no forest anywhere" and "a forest exactly in
            // the middle" came back as the same answer and no caller could tell them apart.
            private static method findForest(Grid* g, int w, int h) returns int {
                mutable CellSearch* look = new CellSearch(w, h) on heap;
                look.sampling(4);
                function<boolean, int, int> isForest =
                    lambda[captures: byvalue g](int x, int y) returns boolean {
                        int ord = g.biomeAt(x, y);
                        return ord == 14 || ord == 22 || ord == 23 || ord == 27;
                    };
                mutable Option<CellHit>* hit = look.nearestToCentre(isForest);
                mutable int packed = (h / 2) * w + w / 2;
                match (hit) {
                    case Some(CellHit at) { packed = at.y * w + at.x; }
                    case None() { }
                }
                delete hit;
                delete look;
                return packed;
            }

            // Headless verification of the GL path: render one frame of the full world and read it back
            // to gl_world.ppm (+ a top-down biome map), no interactive loop.
            private static method captureGlWorld() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.writeBiomeMap(g, w, h, 720, 304, "glworld_map.ppm");
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("captureGlWorld: assets/models not found.");
                    delete g;
                    return;
                }
                mutable ShotRig* rig = new ShotRig("capture", 960, 600, root) on heap;
                if (!rig.standing()) {
                    System.IO.Console.println("captureGlWorld: no GL window.");
                    delete rig;
                    delete g;
                    return;
                }
                rig.show(g, 1.1);
                // THIS ONE DRIVES ITS OWN FRAMES rather than calling `shoot`, because two of the
                // three carry the compass: an overlay drawn between the render and the read, which
                // is a frame `shoot` has no way to describe. It still hands over the window, the
                // four atlases, the renderer and the whole teardown.
                GlWorld3D* r = rig.renderer();
                Batch2D* hud = new Batch2D(rig.gl()) on heap;
                int cw = rig.width();
                int ch = rig.height();
                // far frame (whole world, coarse LOD) + compass
                r.render(cw, ch);
                hud.begin(cw, ch, 0);
                r.drawCompass(hud, cw, ch);
                hud.flush();
                rig.capture("gl_world.ppm");
                // near frame: aim at the closest river (falls back to a forest), under the detail threshold
                mutable int packed = Main.findRiver(g, w, h);
                if (packed < 0) {
                    packed = Main.findForest(g, w, h);
                }
                r.aimAt(packed % w, packed / w);
                r.setView(42.0, 35.0, 110.0);
                r.render(cw, ch);
                hud.begin(cw, ch, 0);
                r.drawCompass(hud, cw, ch);
                hud.flush();
                rig.capture("gl_world_near.ppm");
                // grazing frame: far target but LOW camera -- the detail LOD must key off the height
                // above the ground, and the window must cover the foreground in front of the camera
                rig.shoot("gl_world_low.ppm", 120.0, 10.0, 500.0);
                delete hud;
                delete rig;
                delete g;
                System.IO.Console.println("captureGlWorld: wrote gl_world.ppm + gl_world_near.ppm");
                return;
            }

            // Twelve seeds, each judged and then captured AS THE GAME DRAWS IT. Judging a world on a
            // top-down biome map was how a visible grid of rectangular seams survived four rounds of
            // review: the proxy hid exactly the artefact the render showed. One seed proves nothing
            // either -- what matters is the pass rate over a spread of them.
            // Cut the world open across its straightest stretch of coast and read the raw numbers.
            // The whole question is whether the ELEVATION field has a cliff there or is smooth: a
            // cliff means some generator wrote a step, while a smooth field crossing a threshold
            // means the coast is exactly where the water level says and nothing is wrong with the
            // generation at all. Arguing about it from a screenshot got this wrong twice.
            // Aim the camera at a volcanic plateau's edge, where the LOD complaint lives, instead of
            // at whatever the river finder happens to hit.
            private static method cliffShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                // Volcanic ground with a long way down within six cells to the east: the lava
                // fields end in a drop, and that drop is what this shot is for.
                mutable CellSearch* look = new CellSearch(w, h) on heap;
                look.inset(8);
                function<boolean, int, int> isVolcanicEdge =
                    lambda[captures: byvalue g](int x, int y) returns boolean {
                        if (g.biomeAt(x, y) != 36) {
                            return false;
                        }
                        int e0 = g.elevAt(x, y);
                        mutable int dx = 1;
                        while (dx <= 6) {
                            int o = g.biomeAt(x + dx, y);
                            if (o >= 8 && o != 36 && e0 - g.elevAt(x + dx, y) > 900) {
                                return true;
                            }
                            dx = dx + 1;
                        }
                        return false;
                    };
                mutable Option<CellHit>* hit = look.first(isVolcanicEdge);
                mutable int fx = 0;
                mutable int fy = 0;
                mutable boolean anywhere = false;
                match (hit) {
                    case Some(CellHit at) { fx = at.x; fy = at.y; anywhere = true; }
                    case None() { }
                }
                delete hit;
                delete look;
                if (!anywhere) {
                    System.IO.Console.println("cliffshot: no volcanic edge found.");
                    delete g;
                    return;
                }
                System.IO.Console.println($"cliffshot: volcanic edge at {fx},{fy}");
                mutable ShotRig* rig = new ShotRig("cliff", 1100, 700, Main.assetRoot()) on heap;
                if (!rig.standing()) {
                    System.IO.Console.println("cliffshot: no GL window.");
                    delete rig;
                    delete g;
                    return;
                }
                rig.show(g, 1.1);
                rig.aimAt(fx, fy);
                rig.shoot("cliff.ppm", 35.0, 28.0, 90.0);
                // and again from far and low, which is the only place the COARSE layer is on screen
                rig.shoot("cliff_far.ppm", 35.0, 11.0, 520.0);
                delete rig;
                delete g;
                System.IO.Console.println("cliffshot: wrote cliff.ppm");
                return;
            }

            // Every resource node in one shot: one cell per NodeKind, in declaration order, on a run
            // of flat ground. Nothing generates nodes yet, so this is how the art set gets checked --
            // that each kind resolves to a mesh at all, at a sane scale, with its shadow on the
            // ground -- before a generator starts placing thousands of them.
            private static method nodeShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                // A grid rather than a line: 35 kinds strung out east-west end up a smear on the
                // horizon, where nothing can be told apart.
                int cols = 6;
                int pitch = 5;
                int rows = (Nodes.count() + cols - 1) / cols;
                int spanX = cols * pitch;
                int spanY = rows * pitch;
                mutable int fx = 0 - 1;
                mutable int fy = 0;
                mutable int sy = 80;
                while (sy < h - 80 - spanY && fx < 0) {
                    mutable int sx = 80;
                    while (sx < w - 80 - spanX && fx < 0) {
                        mutable boolean ok = true;
                        mutable int cy = 0;
                        while (cy < spanY && ok) {
                            mutable int cx = 0;
                            while (cx < spanX && ok) {
                                int ord = g.biomeAt(sx + cx, sy + cy);
                                if (ord < 14 || ord > 27) {
                                    ok = false;             // vegetated lowland, no coast, no ice
                                } else if (g.elevAt(sx + cx, sy + cy) >= 6300) {
                                    ok = false;
                                } else if (g.hasRiver(sx + cx, sy + cy)) {
                                    ok = false;
                                }
                                cx = cx + 2;
                            }
                            cy = cy + 2;
                        }
                        if (ok) {
                            fx = sx;
                            fy = sy;
                        }
                        sx = sx + 9;
                    }
                    sy = sy + 9;
                }
                if (fx < 0) {
                    System.IO.Console.println("nodeshot: no flat patch of land found.");
                    delete g;
                    return;
                }
                StringBuilder order = new StringBuilder() on heap;
                order.append("nodeshot: ");
                order.appendInt(cols);
                order.append(" per row at ");
                order.appendInt(fx);
                order.append(",");
                order.appendInt(fy);
                order.append(", reading left to right then down:");
                mutable int kk = 1;
                while (kk < Nodes.count()) {
                    int px2 = fx + (kk % cols) * pitch;
                    int py2 = fy + (kk / cols) * pitch;
                    g.surface().add(cast<float>(px2) + 0.5, cast<float>(py2) + 0.5, kk,
                                    Nodes.baseQty(kk));
                    order.append(" ");
                    order.append(Nodes.name(kk));
                    kk = kk + 1;
                }
                System.IO.Console.println(order.toString());
                delete order;
                g.surface().finish();
                mutable ShotRig* rig = new ShotRig("nodes", 1400, 900, Main.assetRoot()) on heap;
                if (!rig.standing()) {
                    System.IO.Console.println("nodeshot: no GL window.");
                    delete rig;
                    delete g;
                    return;
                }
                rig.show(g, 1.1);
                rig.aimAt(fx + spanX / 2, fy + spanY / 2);
                rig.shoot("nodes_a.ppm", 0.0, 62.0, 74.0);
                delete rig;
                delete g;
                System.IO.Console.println("nodeshot: wrote nodes_a.ppm");
                return;
            }

            // The thickest wood in the world, from three heights. Judging a forest generator off a
            // capture aimed at wherever the default camera happens to point is how you conclude the
            // trees are sparse when the shot simply landed on a prairie -- so this finds the densest
            // 32-cell window first and looks at THAT.
            private static method forestShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                int win2 = 32;
                mutable int best = 0;
                mutable int fx = w / 2;
                mutable int fy = h / 2;
                // NOT a CellSearch, and the reason is that this does not search cells.
                //
                // It walks 32x32 WINDOWS, scores each by the trees inside it, and answers the
                // window's CENTRE -- which is not the position it scored. It also stops a whole
                // window short of each far edge rather than insetting both ends equally. Pushing
                // it through the cell search would mean two new options, each used exactly once,
                // to describe a walk that is a different shape. `nodeShot`'s scan for a clear
                // patch is the same story.
                byte[] tc = new byte[w * h]();
                g.surface().cellCounts(tc, true);
                mutable int sy = 0;
                while (sy < h - win2) {
                    mutable int sx = 0;
                    while (sx < w - win2) {
                        mutable int cnt = 0;
                        mutable int cy = 0;
                        while (cy < win2) {
                            mutable int cx = 0;
                            while (cx < win2) {
                                cnt = cnt + (cast<int>(tc[(sy + cy) * w + sx + cx]) & 255);
                                cx = cx + 2;
                            }
                            cy = cy + 2;
                        }
                        if (cnt > best) {
                            best = cnt;
                            fx = sx + win2 / 2;
                            fy = sy + win2 / 2;
                        }
                        sx = sx + win2;
                    }
                    sy = sy + win2;
                }
                delete tc;
                int biome = g.biomeAt(fx, fy);
                System.IO.Console.println($"forestshot: densest wood at {fx},{fy} in {Biomes.name(biome)}, {best} trees per 256 sampled cells");
                mutable ShotRig* rig = new ShotRig("forest", 1200, 750, Main.assetRoot()) on heap;
                if (!rig.standing()) {
                    System.IO.Console.println("forestshot: no GL window.");
                    delete rig;
                    delete g;
                    return;
                }
                rig.show(g, 1.1);
                rig.aimAt(fx, fy);
                rig.shoot("forest_a.ppm", 20.0, 26.0, 55.0);    // in among the trees
                rig.shoot("forest_b.ppm", 20.0, 45.0, 150.0);   // the wood and its clearings
                rig.shoot("forest_c.ppm", 20.0, 60.0, 420.0);   // where the wood ends
                delete rig;
                delete g;
                System.IO.Console.println("forestshot: wrote forest_a.ppm, forest_b.ppm, forest_c.ppm");
                return;
            }

            // Three shots of HIGH GROUND, which is the only place the LOD was reported failing:
            // ground level looking across a plateau, a mid-height orbit, and a pull-back. If the
            // coarse layer ever covers the detail, a raised slab of giant blocks shows up here.
            private static method highShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                // the highest cell that has much lower ground within a few cells: a plateau rim.
                // Scored rather than tested: "how far does the ground fall away from here" is the
                // question, and the answer is the cell where it falls furthest.
                mutable CellSearch* look = new CellSearch(w, h) on heap;
                look.sampling(3);
                look.inset(12);
                function<int, int, int> howFarItFalls =
                    lambda[captures: byvalue g](int x, int y) returns int {
                        int e0 = g.elevAt(x, y);
                        if (e0 < Contour.HIGHLAND_STORED) {
                            return 0;                       // not high ground: not a candidate
                        }
                        return e0 - g.elevAt(x + 10, y);
                    };
                mutable Option<CellHit>* hit = look.highestScoring(howFarItFalls);
                mutable int fx = 0;
                mutable int fy = 0;
                mutable boolean anywhere = false;
                match (hit) {
                    case Some(CellHit at) { fx = at.x; fy = at.y; anywhere = true; }
                    case None() { }
                }
                delete hit;
                delete look;
                if (!anywhere) {
                    System.IO.Console.println("highshot: no high ground found.");
                    delete g;
                    return;
                }
                System.IO.Console.println($"highshot: plateau rim at {fx},{fy}");
                mutable ShotRig* rig = new ShotRig("high", 1100, 700, Main.assetRoot()) on heap;
                if (!rig.standing()) {
                    System.IO.Console.println("highshot: no GL window.");
                    delete rig;
                    delete g;
                    return;
                }
                rig.show(g, 1.1);
                rig.aimAt(fx, fy);
                // ONE flush per shot, not two -- a second call stood in this loop and it was a
                // no-op: the three pictures come out byte for byte identical without it, which is
                // what the golden hashes are for. `flushDetail` runs `ensureDetail` and drains the
                // bake, and a second `ensureDetail` finds the window in the same place with a mesh
                // already on it, so it starts nothing. Measured, not reasoned about.
                rig.shoot("high0.ppm", 40.0, 16.0, 70.0);    // on the ground, looking across
                rig.shoot("high1.ppm", 40.0, 32.0, 170.0);   // mid orbit
                rig.shoot("high2.ppm", 40.0, 30.0, 420.0);   // pulled back
                delete rig;
                delete g;
                System.IO.Console.println("highshot: wrote high0.ppm high1.ppm high2.ppm");
                return;
            }

            private static method probeSeam() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                WorldAudit* wa = new WorldAudit(g) on heap;
                wa.analyse();
                int run = wa.straightestV();
                int sx = wa.vSeamX();
                int sy = wa.vSeamY();
                System.IO.Console.println($"straightest vertical coast: {run} cells at x={sx}, y={sy}..{sy + run}");
                delete wa;
                // three horizontal cuts through the run: top, middle, bottom
                mutable int k = 0;
                while (k < 3) {
                    int cy = sy + run * k / 2;
                    System.IO.Console.println("");
                    System.IO.Console.println($"---- cut across y={cy} (x from {sx - 8} to {sx + 8}) ----");
                    System.IO.Console.println("   x   elev  biome              temp moist");
                    mutable int dx = 0 - 8;
                    while (dx <= 8) {
                        int px = sx + dx;
                        if (px >= 0 && px < w && cy >= 0 && cy < h) {
                            StringBuilder sb = new StringBuilder() on heap;
                            sb.append(Main.padNum(px, 5));
                            sb.append(Main.padNum(g.elevAt(px, cy), 7));
                            sb.append("  ");
                            sb.append(Main.pad(Biomes.name(g.biomeAt(px, cy)), 18));
                            sb.append(Main.padNum(g.tempAt(px, cy), 4));
                            sb.append(Main.padNum(g.moistAt(px, cy), 6));
                            if (dx == 0) {
                                sb.append("   <-- seam");
                            }
                            System.IO.Console.println(sb.toString());
                            delete sb;
                        }
                        dx = dx + 1;
                    }
                    k = k + 1;
                }
                delete g;
                return;
            }

            private static method preview() returns void {
                int w = 2560;
                int h = 1440;
                int cols = 4;
                int rows = 3;
                int tw = 560;
                int th = 350;
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("preview: assets/models not found.");
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("preview", tw, th, 3, 3) == 0) {
                    System.IO.Console.println("preview: no GL window.");
                    delete win;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                int sw = cols * tw;
                int sh = rows * th;
                byte[] sheet = new byte[sw * sh * 3]();
                mutable int passed = 0;
                mutable int k = 0;
                while (k < cols * rows) {
                    int seed = 42 + k * 7717;
                    WorldGen gen = new WorldGen(seed) on stack;
                    gen.setWorld(0, 0.0 - 1.0);
                    Grid* g = gen.generate(w, h);
                    WorldAudit* wa = new WorldAudit(g) on heap;
                    wa.analyse();
                    int v = wa.verdict(6);
                    System.IO.Console.println($"---- seed {seed} ----");
                    wa.report(6);
                    delete wa;
                    GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                    r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                    int cw = win.width();
                    int ch = win.height();
                    // THE SECOND ONE STAYS HERE, and only here. It is the same no-op it was in
                    // `highShot`, where removing it left three golden images unchanged -- but this
                    // command is the one with a flake history: it has failed twice under a full GL
                    // sequence, which is why the gate carries a loud retry-once guard around it. A
                    // single green run cannot tell "this line never mattered" from "this line was
                    // hiding the flake", and a flake is exactly the thing one run does not see.
                    // It goes when there is something that can answer that, not before.
                    r.flushDetail();
                    r.flushDetail();
                    r.render(cw, ch);
                    byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                    Main.blitTile(sheet, sw, sh, px, cw, ch,
                                  (k % cols) * tw, (k / cols) * th, tw, th, v == 0);
                    delete px;
                    delete r;
                        delete g;
                    if (v == 0) {
                        passed = passed + 1;
                    }
                    k = k + 1;
                }
                Main.writePpm(sheet, sw, sh, "preview_sheet.ppm");
                delete sheet;
                delete rivers;
                delete nodeMesh;
                delete props;
                delete terr;
                delete win;
                int total = cols * rows;
                System.IO.Console.println($"preview: {passed}/{total} seeds PASS -- wrote preview_sheet.ppm");
                return;
            }

            // Copy one capture into the contact sheet, flipping it (GL reads bottom-up) and framing
            // it in the colour of its verdict: green passed, red rejected.
            private static method blitTile(byte[] sheet, int sw, int sh, byte[] px, int cw, int ch,
                                           int ox, int oy, int tw, int th, boolean ok) returns void {
                mutable int y = 0;
                while (y < th) {
                    mutable int x = 0;
                    while (x < tw) {
                        int dx = ox + x;
                        int dy = oy + y;
                        if (dx < sw && dy < sh) {
                            int di = (dy * sw + dx) * 3;
                            mutable int rr = 20;
                            mutable int gg = 22;
                            mutable int bb = 28;
                            if (x < 5 || y < 5 || x >= tw - 5 || y >= th - 5) {
                                if (ok) {
                                    rr = 60;
                                    gg = 200;
                                    bb = 90;
                                } else {
                                    rr = 220;
                                    gg = 70;
                                    bb = 60;
                                }
                            } else if (x < cw && y < ch) {
                                int si = ((ch - 1 - y) * cw + x) * 3;
                                rr = cast<int>(px[si]) & 255;
                                gg = cast<int>(px[si + 1]) & 255;
                                bb = cast<int>(px[si + 2]) & 255;
                            }
                            sheet[di] = cast<byte>(rr);
                            sheet[di + 1] = cast<byte>(gg);
                            sheet[di + 2] = cast<byte>(bb);
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                return;
            }

            private static method writePpm(byte[] px, int w, int h, String path) returns void {
                mutable Ppm* file = new Ppm(w, h) on heap;
                mutable int i = 0;
                int n = w * h;
                while (i < n) {
                    file.pixel(cast<int>(px[i * 3]) & 255, cast<int>(px[i * 3 + 1]) & 255,
                               cast<int>(px[i * 3 + 2]) & 255);
                    i = i + 1;
                }
                file.save(path);
                delete file;
                return;
            }

            // Generate all four world modes and write a top-down biome-colour overview PNG of each --
            // the fast way to verify continent shapes per mode.
            private static method worldMaps() returns void {
                int w = 1280;
                int h = 540;
                mutable int mode = 0;
                while (mode < 4) {
                    System.IO.Console.println("worldmaps: generating mode...");
                    WorldGen gen = new WorldGen(42) on stack;
                    gen.setWorld(mode, 0.0 - 1.0);
                    Grid* g = gen.generate(w, h);
                    Main.worldStats(g, w, h);
                    Main.writeBiomeMap(g, w, h, 640, 270, Main.mapName(mode));
                    delete g;
                    mode = mode + 1;
                }
                System.IO.Console.println("worldmaps: done");
            }

            private static method mapName(int mode) returns String {
                if (mode == 0) { return "worldmap_continental.ppm"; }
                if (mode == 1) { return "worldmap_pangaea.ppm"; }
                if (mode == 2) { return "worldmap_archipelago.ppm"; }
                return "worldmap_inlandseas.ppm";
            }

            // Downsample the biome grid to outW x outH and write it top-down as a PPM (biome palette).
            private static method writeBiomeMap(Grid* g, int w, int h, int outW, int outH, String path) returns void {
                mutable Ppm* file = new Ppm(outW, outH) on heap;
                mutable int oy = 0;
                while (oy < outH) {
                    int sy = oy * h / outH;
                    mutable int ox = 0;
                    while (ox < outW) {
                        int sx = ox * w / outW;
                        int ord = g.biomeAt(sx, sy);
                        file.pixel(Biomes.red(ord), Biomes.green(ord), Biomes.blue(ord));
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                file.save(path);
                delete file;
            }

            private static method worldStats(Grid* g, int w, int h) returns void {
                mutable int water = 0;
                mutable int land = 0;
                mutable int emin = 100000;
                mutable int emax = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int e = g.elevAt(x, y);
                        if (e < emin) { emin = e; }
                        if (e > emax) { emax = e; }
                        if (g.biomeAt(x, y) <= 6) {
                            water = water + 1;
                        } else {
                            land = land + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("gen3d: water=");
                sb.appendInt(water);
                sb.append(" land=");
                sb.appendInt(land);
                sb.append(" elev[");
                sb.appendInt(emin);
                sb.append("..");
                sb.appendInt(emax);
                sb.append("]");
                System.IO.Console.println(sb.toString());
                delete sb;
            }

            // ---- worldgen audit: SEE what the generator produced, in numbers ----------------------
            // `AgentsExe.exe audit` generates the default world (same seed/mode as the game) and
            // prints a per-biome census, a land elevation histogram, river-network health metrics
            // (mouths / broken ends / sources) and placement checks (border trench, lowland volcanic),
            // plus a full-size top-down biome map (audit_map.ppm).
            // Padding is `Strings`' job and always was -- three of these were the standard
            // library written out again, with their own StringBuilder each. They are kept as
            // one-line names because the audit reads better saying `pad` than saying which
            // character it pads with eighteen times.
            private static method pad(String s, int width) returns String {
                return Strings.padRight(s, width, " ");
            }

            private static method padLeft(String s, int width) returns String {
                return Strings.padLeft(s, width, " ");
            }

            private static method padNum(int v, int width) returns String {
                return Strings.padLeft($"{v}", width, " ");
            }

            // One-decimal percentage of count/total, right-aligned in 7 chars ("  12.3%").
            //
            // This one is NOT `Strings`: the tenths come from integer arithmetic on purpose --
            // count * 1000 / total in 64 bits -- because the counts run to millions of cells and
            // the report has to add up to 100.0 rather than to whatever a float rounds to.
            private static method pct(int count, int total) returns String {
                mutable int p10 = 0;
                if (total > 0) {
                    p10 = cast<int>(cast<long>(count) * 1000 / cast<long>(total));
                }
                // BUILT, NOT INTERPOLATED. `$"{p10 / 10}.{p10 % 10}%"` loses the percent sign --
                // captured against the audit's own output, which the pixel gate does not read.
                StringBuilder sb = new StringBuilder() on heap;
                sb.appendInt(p10 / 10);
                sb.append(".");
                sb.appendInt(p10 % 10);
                sb.append("%");
                String out = sb.toString();
                delete sb;
                return Main.padLeft(out, 7);
            }

            private static method audit() returns void {
                int w = 2560;
                int h = 1440;
                System.IO.Console.println("audit: generating the default world (Continental, 2560x1440, seed 42)...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.auditBiomes(g, w, h);
                Main.auditElevation(g, w, h);
                Main.auditPlacement(g, w, h);
                Main.auditRivers(g, w, h);
                System.IO.Console.println("");
                System.IO.Console.println("---- shape criteria ------------------------------------------");
                WorldAudit* wa = new WorldAudit(g) on heap;
                wa.analyse();
                wa.report(6);
                delete wa;
                Main.writeBiomeMap(g, w, h, 1280, 720, "audit_map.ppm");
                System.IO.Console.println("");
                System.IO.Console.println("audit: wrote audit_map.ppm (top-down biome map, full world).");
                delete g;
                return;
            }

            private static method auditBiomes(Grid* g, int w, int h) returns void {
                int[] cnt = new int[40]();
                mutable int land = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int o = g.biomeAt(x, y);
                        cnt[o] = cnt[o] + 1;
                        if (o >= 8) {
                            land = land + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                int total = w * h;
                System.IO.Console.println("");
                System.IO.Console.println("---- biome census -------------------------------------------");
                // NOTE: a leading string LITERAL in println is a printf format -- '%' must be escaped
                System.IO.Console.println(" ord biome                     cells  %%world  %%land");
                mutable int o = 0;
                mutable int missing = 0;
                while (o < 40) {
                    StringBuilder sb = new StringBuilder() on heap;
                    sb.append(Main.padNum(o, 4));
                    sb.append(" ");
                    String nm = Biomes.name(o);
                    sb.append(Main.pad(nm, 20));
                    sb.append(Main.padNum(cnt[o], 9));
                    sb.append(" ");
                    sb.append(Main.pct(cnt[o], total));
                    if (o >= 8) {
                        sb.append(" ");
                        sb.append(Main.pct(cnt[o], land));
                    }
                    if (cnt[o] == 0) {
                        if (o == 7) {
                            // rivers are a FLAG over terrain cells (the renderer draws the channel);
                            // ordinal 7 never appears as a cell biome by design
                            sb.append("   (flag-based, expected 0)");
                        } else {
                            sb.append("   <-- MISSING");
                            missing = missing + 1;
                        }
                    }
                    System.IO.Console.println(sb.toString());
                    delete sb;
                    o = o + 1;
                }
                mutable int mountainFam = cnt[32] + cnt[33] + cnt[34] + cnt[35] + cnt[36];
                StringBuilder s2 = new StringBuilder() on heap;
                s2.append("land ");
                s2.append(Main.pct(land, total));
                s2.append(" of world | mountain family (Hills..Volcanic) ");
                s2.append(Main.pct(mountainFam, land));
                s2.append(" of land | missing biomes: ");
                s2.appendInt(missing);
                System.IO.Console.println(s2.toString());
                delete s2;
                delete cnt;
                return;
            }

            private static method auditElevation(Grid* g, int w, int h) returns void {
                // land-only elevation histogram, 20 bins over 0..1 -- shows where the mountain cut
                // (0.62) falls and how much land piles above it
                int[] bins = new int[20]();
                mutable int land = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.biomeAt(x, y) >= 8) {
                            land = land + 1;
                            mutable int b = g.elevAt(x, y) / 500;
                            if (b > 19) {
                                b = 19;
                            }
                            bins[b] = bins[b] + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                System.IO.Console.println("");
                System.IO.Console.println("---- land elevation histogram (bin = 0.05) ------------------");
                mutable int b = 0;
                while (b < 20) {
                    if (bins[b] > 0) {
                        StringBuilder sb = new StringBuilder() on heap;
                        sb.append("  0.");
                        sb.appendInt(b * 5 / 10);
                        sb.appendInt(b * 5 % 10);
                        sb.append("0 ");
                        sb.append(Main.padNum(bins[b], 9));
                        sb.append(" ");
                        sb.append(Main.pct(bins[b], land));
                        mutable int bar = bins[b] * 50 / land;
                        sb.append("  ");
                        mutable int k = 0;
                        while (k < bar) {
                            sb.append("#");
                            k = k + 1;
                        }
                        System.IO.Console.println(sb.toString());
                        delete sb;
                    }
                    b = b + 1;
                }
                delete bins;
                return;
            }

            private static method auditPlacement(Grid* g, int w, int h) returns void {
                // MarineTrench should live in deep interior basins, not hug the map border; Volcanic
                // should sit on high ground (ridges), not lowland grass.
                mutable int trench = 0;
                mutable int trenchBorder = 0;
                mutable int volc = 0;
                mutable int volcLow = 0;
                int bx = w / 10;
                int by = h / 10;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int o = g.biomeAt(x, y);
                        if (o == 0) {
                            trench = trench + 1;
                            if (x < bx || x >= w - bx || y < by || y >= h - by) {
                                trenchBorder = trenchBorder + 1;
                            }
                        }
                        if (o == 36) {
                            volc = volc + 1;
                            if (g.elevAt(x, y) < 5500) {
                                volcLow = volcLow + 1;
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                System.IO.Console.println("");
                System.IO.Console.println("---- placement checks ---------------------------------------");
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("MarineTrench cells ");
                sb.appendInt(trench);
                sb.append(", in the outer 10% border ring: ");
                sb.appendInt(trenchBorder);
                sb.append(" (");
                sb.append(Main.pct(trenchBorder, trench));
                sb.append(")  [border trench = artificial]");
                System.IO.Console.println(sb.toString());
                delete sb;
                StringBuilder s2 = new StringBuilder() on heap;
                s2.append("Volcanic cells ");
                s2.appendInt(volc);
                s2.append(", below elevation 0.55 (lowland): ");
                s2.appendInt(volcLow);
                s2.append(" (");
                s2.append(Main.pct(volcLow, volc));
                s2.append(")  [lowland volcanic = misplaced]");
                System.IO.Console.println(s2.toString());
                delete s2;
                return;
            }

            private static method auditRivers(Grid* g, int w, int h) returns void {
                byte[] inflow = new byte[w * h]();
                mutable int cells = 0;
                mutable int mouths = 0;
                mutable int broken = 0;
                mutable int noflow = 0;
                mutable int onCoast = 0;
                mutable int shown = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.hasRiver(x, y)) {
                            cells = cells + 1;
                            int o = g.biomeAt(x, y);
                            if (o == 8 || o == 9) {
                                onCoast = onCoast + 1;
                            }
                            if (!g.hasFlow(x, y)) {
                                noflow = noflow + 1;
                            } else {
                                int tx = x + g.flowDx(x, y);
                                int ty = y + g.flowDy(x, y);
                                if (tx < 0 || ty < 0 || tx >= w || ty >= h) {
                                    broken = broken + 1;
                                } else {
                                    inflow[ty * w + tx] = cast<byte>(1);
                                    int tb = g.biomeAt(tx, ty);
                                    // water (<=7) or a salt flat (38): a river dying into a dry
                                    // basin is a legitimate endorheic terminus, not a defect
                                    if (tb <= 7 || tb == 38) {
                                        mouths = mouths + 1;
                                    } else {
                                        if (!g.hasRiver(tx, ty)) {
                                            broken = broken + 1;
                                            if (shown < 6) {
                                                StringBuilder sb = new StringBuilder() on heap;
                                                sb.append("  broken river end at (");
                                                sb.appendInt(x);
                                                sb.append(",");
                                                sb.appendInt(y);
                                                sb.append(") -> lands on ");
                                                String tn = Biomes.name(tb);
                                                sb.append(tn);
                                                System.IO.Console.println(sb.toString());
                                                delete sb;
                                                shown = shown + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                mutable int sources = 0;
                y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.hasRiver(x, y) && cast<int>(inflow[y * w + x]) == 0) {
                            sources = sources + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                System.IO.Console.println("");
                System.IO.Console.println("---- river network ------------------------------------------");
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("river cells ");
                sb.appendInt(cells);
                sb.append(" | sources ");
                sb.appendInt(sources);
                sb.append(" | mouths (reach water) ");
                sb.appendInt(mouths);
                sb.append(" | BROKEN ends (die on land) ");
                sb.appendInt(broken);
                sb.append(" | no-flow ");
                sb.appendInt(noflow);
                sb.append(" | on beach/rocky shore ");
                sb.appendInt(onCoast);
                System.IO.Console.println(sb.toString());
                delete sb;
                delete inflow;
                return;
            }

        }
    }
}
