import System.IO.Console;
import System.IO.File;
import System.Text.StringBuilder;
import System.Text.Scanner;
import opengl.glfw.GlWindow;
import opengl.glfw.InputEvent;
import opengl.gl.Wgl;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.Biomes;
import Agents.World.LandMath;
import Agents.Nations.Realm;
import Agents.Nations.Nation;
import Agents.Nations.Government;
import Agents.Nations.Ideology;
import Agents.Nations.City;
import Agents.World.Nodes;
import Agents.People.Folk;
import Agents.People.Agent;
import Agents.Sim.Meter;
import Agents.Sim.Phase;
import System.Time.Stopwatch;
import System.Time.Time;
import Agents.World.WorldAudit;
import Agents.World.Landmass;
import Agents.Gfx.SoftPainter;
import Agents.Gfx.GlPainter;
import Agents.Gfx.Batch2D;
import Agents.Gfx.Hud;
import Agents.Gfx.Camera;
import Agents.Gfx.WorldRenderer;
import Agents.Gfx.MeshAtlas;
import Agents.Gfx.Raster3D;
import Agents.Gfx.World3D;
import Agents.Gfx.GlWorld3D;

// Entry point. Slice 4: generate a world and show it ISOMETRICALLY in a GL window -- pan with
// WASD/arrows, zoom with the scroll wheel or +/-, ESC to quit. Running with any argument (or when no
// GL window is available) instead writes a software snapshot PPM, the same scene the window draws --
// used for headless verification.
program AgentsExe;

public bundle Agents {
    public namespace App {

        public class Main {
            public static method main(string[] args) returns void {
                if (args.length() > 0) {
                    if (args[0].equals("gen3d")) {
                        Main.render3dSnapshot();
                        return;
                    }
                    if (args[0].equals("glworld")) {
                        Main.captureGlWorld();
                        return;
                    }
                    if (args[0].equals("worldmaps")) {
                        Main.worldMaps();
                        return;
                    }
                    if (args[0].equals("audit")) {
                        Main.audit();
                        return;
                    }
                    if (args[0].equals("highshot")) {
                        Main.highShot();
                        return;
                    }
                    if (args[0].equals("cliffshot")) {
                        Main.cliffShot();
                        return;
                    }
                    if (args[0].equals("nodeshot")) {
                        Main.nodeShot();
                        return;
                    }
                    if (args[0].equals("forestshot")) {
                        Main.forestShot();
                        return;
                    }
                    // `folkshot` and `simrun` lived here. Both drove the simulation headlessly and
                    // both went with it; whatever the new model needs in order to be watched
                    // without a window gets written against the new model, rather than kept as the
                    // shape the old one happened to leave behind.
                    if (args[0].equals("probe")) {
                        Main.probeSeam();
                        return;
                    }
                    if (args[0].equals("preview")) {
                        Main.preview();
                        return;
                    }
                    if (args[0].equals("plates")) {
                        Landmass* lm = new Landmass(42) on heap;
                        lm.dumpPlates(1280, 720, 6);
                        delete lm;
                        return;
                    }
                    if (args[0].equals("iso2d")) {
                        Main.runIso2d();
                        return;
                    }
                    // THE WEIGH-IN. Half a million agents as real objects, scattered over the
                    // world, each carrying a life's worth of memory, all of them wandering. It
                    // exists to answer one question with a number instead of an argument: what
                    // does the object model cost.
                    if (args[0].equals("weigh")) {
                        mutable int howMany = 500000;
                        if (args.length() > 1) {
                            mutable Scanner hs = new Scanner(args[1]) on heap;
                            if (hs.hasNext()) {
                                int got = hs.nextInt();
                                if (got > 0) {
                                    howMany = got;
                                }
                            }
                            delete hs;
                        }
                        mutable int deep = 12;
                        if (args.length() > 2) {
                            mutable Scanner ds = new Scanner(args[2]) on heap;
                            if (ds.hasNext()) {
                                int got = ds.nextInt();
                                if (got > 0) {
                                    deep = got;
                                }
                            }
                            delete ds;
                        }
                        Main.weigh(howMany, deep);
                        return;
                    }
                }
                // Default: the interactive true-3D world (free orbit camera).
                //
                // A SEED, so the real game can be run six times on six maps at once. Until now the
                // world a player sees was hardwired to 42, which is fine for one window and useless
                // for the only test that matters -- the whole thing, renderer included, on ground
                // it has never seen. Any argument that is not a known command is read as a seed.
                mutable int seed = 42;
                if (args.length() > 0) {
                    mutable Scanner sc = new Scanner(args[0]) on heap;
                    if (sc.hasNext()) {
                        int got = sc.nextInt();
                        if (got != 0) {
                            seed = got;
                        }
                    }
                    delete sc;
                }
                // AND THE SPEED IT STARTS AT. The 1-6 keys already exist, but a window launched to
                // be watched and audited for an hour cannot be asked to have somebody press a key
                // in it -- and pressing that key in one of six windows only ever meant walking
                // round to the other five.
                mutable float pace = 1.0;
                if (args.length() > 1) {
                    mutable Scanner ps = new Scanner(args[1]) on heap;
                    if (ps.hasNext()) {
                        int got = ps.nextInt();
                        if (got > 0) {
                            pace = Main.paceOf(got);
                        }
                    }
                    delete ps;
                }
                // AND A THIRD ARGUMENT TURNS ON THE TRACE: every agent, every column, every tick,
                // written to the path given. Empty without it, which is how the simulation knows
                // to stay silent -- a mature world writes about a gigabyte a minute this way and no
                // ordinary run should pay that. What it buys is the one question the counters
                // cannot answer: not "how often does this happen" but "what is that ring of people
                // actually doing", which only an instrument that keeps the individual can answer.
                mutable String tracePath = "";
                if (args.length() > 2) {
                    tracePath = args[2];
                }
                Main.renderGlWorld(seed, pace, tracePath);
                return;
            }

            // The legacy 2D isometric view (kept behind `iso2d`).
            private static method runIso2d() returns void {
                int w = 2560;
                int h = 1440;
                System.IO.Console.println("iso2d: generating a world...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                System.IO.Console.println("world ready.");
                if (Main.runWindow(g, w, h)) {
                    delete g;
                    return;
                }
                System.IO.Console.println("no GL window; writing a snapshot instead.");
                Main.writeSnapshot(g, w, h);
                delete g;
                return;
            }

            // The interactive isometric window. Returns false if no GL window could be opened.
            private static method runWindow(Grid* g, int w, int h) returns boolean {
                int sw = 1280;
                int sh = 720;
                GlWindow* win = new GlWindow() on heap;
                if (win.open("agents.exe -- world", sw, sh, 3, 3) == 0) {
                    delete win;
                    return false;
                }
                win.setVSync(1);
                Batch2D* batch = new Batch2D(win.gl) on heap;
                GlPainter* gp = new GlPainter(batch) on heap;
                Camera cam = new Camera(sw, sh) on heap;
                cam.focusCell(w / 2, h / 2);
                cam.setZoom(0.42);
                int pan = 18;
                while (win.isOpen()) {
                    win.pump();
                    if (win.keyDown(0x1B)) {           // ESC
                        break;
                    }
                    if (win.keyDown(0x57) || win.keyDown(0x26)) { cam.panPixels(0, pan); }        // W / Up
                    if (win.keyDown(0x53) || win.keyDown(0x28)) { cam.panPixels(0, 0 - pan); }    // S / Down
                    if (win.keyDown(0x41) || win.keyDown(0x25)) { cam.panPixels(pan, 0); }        // A / Left
                    if (win.keyDown(0x44) || win.keyDown(0x27)) { cam.panPixels(0 - pan, 0); }    // D / Right
                    int sc = win.takeScroll();
                    if (sc > 0) { cam.zoomBy(1.12); }
                    if (sc < 0) { cam.zoomBy(0.89); }
                    if (win.keyDown(0xBB) || win.keyDown(0x6B)) { cam.zoomBy(1.03); }             // +
                    if (win.keyDown(0xBD) || win.keyDown(0x6D)) { cam.zoomBy(0.97); }             // -
                    int cw = win.width();
                    int ch = win.height();
                    cam.resize(cw, ch);
                    Wgl.glViewport(0, 0, cw, ch);
                    Wgl.glClearColor(0.07, 0.16, 0.26, 1.0);
                    Wgl.glClear(0x4000);
                    batch.begin(cw, ch, 0);
                    WorldRenderer.draw(gp, g, cam, cw, ch);
                    batch.flush();
                    win.swap();
                }
                delete cam;
                delete gp;
                delete batch;
                delete win;
                return true;
            }

            // Headless verification of the TRUE-3D path: generate a small real world and render it with
            // the baked biome models (elevation -> height), writing world3d.ppm.
            private static method render3dSnapshot() returns void {
                int w = 64;
                int h = 40;
                System.IO.Console.println("gen3d: generating a small world...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.worldStats(g, w, h);
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("gen3d: assets/models not found.");
                    delete g;
                    return;
                }
                System.IO.Console.println("gen3d: loading models...");
                MeshAtlas* atlas = MeshAtlas.loadTerrain(root);
                System.IO.Console.println("gen3d: rendering in 3D...");
                Raster3D* r = new Raster3D(960, 600, 2) on heap;
                World3D.render(r, g, atlas, 0, 0, w, h, 9.0);
                r.savePPM("world3d.ppm", 20, 26, 36);
                System.IO.Console.println("gen3d: wrote world3d.ppm");
                delete r;
                delete atlas;
                delete g;
                return;
            }

            // GL true-3D path: generate a world, bake it into a VBO, render one frame with the orbit
            // camera + cel shading, and read it back to gl_world.ppm (headless-verifiable). The free
            // camera loop runs when a real window is present.
            // Find assets/models regardless of the working directory (double-click runs from the exe's
            // folder, the terminal from the repo root). Returns "" if none of the candidates has it.
            // Five by five of ground for one city, through the one method allowed to claim. Part
            // of the scaffolding above and goes with it.
            private static method blockOut(Realm* realm, int city, int atX, int atY) returns void {
                for (int dy in 0 - 2..3) {
                    for (int dx in 0 - 2..3) {
                        realm.claim(city, atX + dx, atY + dy);
                    }
                }
                return;
            }

            // A walkable cell, drawn the same way `Folk.scatter` draws them, so that "where does
            // the first nation stand" needs no new idea. Returns the packed cell, or -1 if the
            // world has no walkable ground at all -- which is a worldgen failure and says so.
            private static method somewhereWalkable(Grid* g, int seed) returns int {
                int w = g.width();
                int h = g.height();
                mutable int tries = 0;
                while (tries < 20000) {
                    tries = tries + 1;
                    int gx = cast<int>(LandMath.hash01(seed ^ 0x7A11, tries, 3)
                                       * cast<float>(w - 1));
                    int gy = cast<int>(LandMath.hash01(seed ^ 0x3C5D, tries, 5)
                                       * cast<float>(h - 1));
                    if (Biomes.walkable(g.biomeAt(gx, gy))) {
                        return gy * w + gx;
                    }
                }
                System.IO.Console.println("realm: found nowhere walkable to found a nation in 20000 draws");
                return 0 - 1;
            }

            private static method assetRoot() returns String {
                if (File.readAll("assets/models/terrain.index").length() > 0) {
                    return "assets/models";
                }
                if (File.readAll("../assets/models/terrain.index").length() > 0) {
                    return "../assets/models";
                }
                if (File.readAll("../../assets/models/terrain.index").length() > 0) {
                    return "../../assets/models";
                }
                return "";
            }

            // The interactive true-3D world: generate, bake into a VBO (LOD stride so the whole
            // 2560x1080 fits), then an inspection camera loop -- left-drag or arrows rotate/tilt (tilt
            // gimbal-locked between horizontal and top-down), wheel or +/- zoom, WASD pan, ESC quits.
            // The six gears, by the number printed on the key that selects them. One argument that
            // means the same thing as the key you would have pressed beats a second scale nobody
            // can hold in their head next to the first.
            private static method paceOf(int gear) returns float {
                if (gear <= 1) {
                    return 1.0;
                }
                if (gear == 2) {
                    return 2.0;
                }
                if (gear == 3) {
                    return 5.0;
                }
                if (gear == 4) {
                    return 20.0;
                }
                if (gear == 5) {
                    return 60.0;
                }
                return 300.0;
            }

            // The number on the key, back from the pace it selects. The argument and the key have
            // to name the same thing, so the HUD can say which gear a run started in.
            private static method gearOf(float pace) returns int {
                if (pace >= 300.0) { return 6; }
                if (pace >= 60.0) { return 5; }
                if (pace >= 20.0) { return 4; }
                if (pace >= 5.0) { return 3; }
                if (pace >= 2.0) { return 2; }
                return 1;
            }

            // At most this many world ticks in one frame. Without it, gear 6 on a slow machine
            // spends the whole frame simulating and the window stops answering the keyboard --
            // including the key that would slow it back down.
            public static fixed int TICK_CAP = 64;

            private static method renderGlWorld(int seed, float startPace, String tracePath) returns void {
                int w = 2560;
                int h = 1440;
                System.IO.Console.println("agents.exe: generating the world...");
                // The world a player gets is SEARCHED for, not merely rolled. WorldAudit's criteria
                // are what makes a world worth playing, and three seeds in twelve produce one they
                // reject -- one continent and five scraps, or fourteen islands. Six tries is ample:
                // nine in twelve pass on the first roll.
                Grid* g = WorldGen.acceptable(seed, 0, 0.0 - 1.0, 0, w, h, 6, true);
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("assets/models not found next to the executable.");
                    delete g;
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("agents.exe -- world  [drag/arrows rotate | wheel zoom | WASD pan (Shift fast) | P pixel filter | ESC]", 1280, 720, 3, 3) == 0) {
                    System.IO.Console.println("no GL window available.");
                    delete win;
                    delete g;
                    return;
                }
                win.setVSync(1);
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                // THE WORLD, AND NOTHING LIVING IN IT YET.
                //
                // The half a million agents that stood here were an EXPERIMENT, not the game: they
                // existed to settle whether an agent should be an object or a row in a column, and
                // to find out what a world full of people costs to draw and to move. They settled
                // both -- 2.4 GB, and a frame that went from eleven to a hundred and forty-four
                // frames a second once the drawing was instanced and the movement sliced -- and a
                // measurement that has given its answer should not be left running as scenery.
                //
                // What stays is everything that experiment built and the real game needs: `Agent`
                // and `Folk`, the block index, the instanced draw, the interpolation between one
                // move and the next, and the counters that proved each of them honest. The
                // population that fills them next is a nation, not a number.
                r.setPeopleArt(peopleMesh);
                // ONE NATION, FOUNDED BY HAND, OWNING A HANDFUL OF CELLS.
                //
                // Nothing expands, nobody lives in it, and that is the point of this slice: the
                // question it answers is whether ground can have an owner at all and whether the
                // two views of that fact -- the city's own list and the realm's per-cell layer --
                // say the same thing. Growth, colonists and death come after, one at a time,
                // against a foundation that has been checked rather than assumed.
                Folk* folk = new Folk(4096, seed) on heap;
                folk.sizeIndex(g);
                r.setPeople(folk);
                Realm* realm = new Realm(g, seed) on heap;
                int where = Main.somewhereWalkable(g, seed);
                if (where >= 0) {
                    int nid = realm.foundNation(g, where % g.width(), where / g.width(),
                                                cast<int>(Government.Monarchy),
                                                cast<int>(Ideology.Feudalism));
                    // SCAFFOLDING, AND IT SAYS SO. Three cities in two subdivisions, laid out by
                    // hand in a row, for one reason: it is the only arrangement that puts all
                    // three kinds of border on screen at once, and a border nobody has looked at
                    // is a border nobody has checked. It goes when NAT-3 makes cities grow on
                    // their own.
                    //
                    //   city 0 | city 1   same subdivision  -> thin, dashed
                    //   city 1 | city 2   same nation       -> medium, solid
                    //   the outside                         -> thick, solid
                    // THE FOUNDERS. Twelve people, real agents on the roll, standing in the
                    // capital. Everything after this is theirs: houses go up for them, the ground
                    // follows the houses, and the children they have are what makes the town grow.
                    mutable City* seat = realm.cityAt(realm.nationAt(nid).capital);
                    for (int k in 0..12) {
                        seat.residents.add(folk.spawn(cast<float>(seat.cx) + 0.5,
                                                      cast<float>(seat.cy) + 0.5, k % 4));
                    }
                }
                realm.report();
                realm.audit();
                MeshAtlas* buildMesh = MeshAtlas.loadNamed(root, "buildings.index");
                MeshAtlas* itemMesh = MeshAtlas.loadNamed(root, "items.index");
                r.setRealm(realm, buildMesh, itemMesh);
                // THE CAMERA OPENS ON THE CAPITAL WHEN THERE IS ONE, and on the whole world when
                // there is not. `setup` frames the entire map, which is the right opening shot for
                // a world with nothing in it -- but a duchy of twenty-five cells in a world 2560
                // across is one pixel of that shot, and a window that cannot show you the thing it
                // just built is not much of a window.
                if (realm.nationCount() > 0) {
                    mutable City* seat = realm.cityAt(realm.nationAt(0).capital);
                    r.aimAt(seat.cx, seat.cy);
                    // DEGREES. `camEl` is converted with pi/180 at render time, so the 0.55 that
                    // was here read as half a degree of elevation -- a camera lying on the floor,
                    // which is what every screenshot taken today was showing. Forty degrees is a
                    // view of a place; half a degree is a view of the horizon.
                    r.setView(35.0, 40.0, 55.0);
                }
                Batch2D* hud = new Batch2D(win.gl) on heap;
                Hud* text = new Hud(win.gl, 14) on heap;
                mutable int lastX = win.cursorX();
                mutable int lastY = win.cursorY();
                mutable int wanderTick = 0;
                // The gear the world is running at, the fraction of a tick carried over from the
                // last frame, and how many ticks the machine could not keep up with.
                mutable float pace = startPace;
                mutable int gear = Main.gearOf(pace);
                mutable boolean paused = false;
                mutable float owed = 0.0;
                mutable long behind = 0;
                mutable boolean cutPending = false;
                mutable int cutFrames = 0;
                // The third argument turns the per-tick agent trace on. Off by default because
                // it is thousands of lines a second; on when somebody is diagnosing.
                boolean traceOn = tracePath.length() > 0;
                // THE WHOLE FRAME IS MEASURED, not the part the renderer happens to own. The meter
                // used to be opened and closed inside `render`, which left the input, the moving of
                // half a million people, the HUD and the buffer swap outside it -- and those turned
                // out to be most of the frame. The clock now opens here and every stretch between
                // one `lap` and the next belongs to a named phase.
                Meter* gauge = r.frameMeter();
                while (win.isOpen()) {
                    gauge.begin();
                    win.pump();
                    if (win.keyDown(0x1B)) {
                        break;
                    }
                    int mx = win.cursorX();
                    int my = win.cursorY();
                    if (win.keyDown(0x01) && win.isForeground()) {
                        r.orbit(cast<float>(mx - lastX) * 0.35, 0.0 - cast<float>(my - lastY) * 0.30);
                    }
                    lastX = mx;
                    lastY = my;
                    if (win.keyDown(0x25)) { r.orbit(0.0 - 1.6, 0.0); }
                    if (win.keyDown(0x27)) { r.orbit(1.6, 0.0); }
                    if (win.keyDown(0x26)) { r.orbit(0.0, 1.2); }
                    if (win.keyDown(0x28)) { r.orbit(0.0, 0.0 - 1.2); }
                    int sc = win.takeScroll();
                    if (sc > 0) { r.zoomBy(0.88); }
                    if (sc < 0) { r.zoomBy(1.0 / 0.88); }
                    if (win.keyDown(0xBB) || win.keyDown(0x6B)) { r.zoomBy(0.97); }
                    if (win.keyDown(0xBD) || win.keyDown(0x6D)) { r.zoomBy(1.0 / 0.97); }
                    while (win.hasEvent()) {
                        InputEvent* ev = win.nextEvent();
                        if (ev.isKey() && !ev.repeat) {
                            if (ev.vk == 0x50) {                           // P: the pixel filter
                                r.pixelate = !r.pixelate;
                            }
                            // THE GEARS AND THE PAUSE, BACK NOW THAT THERE IS A WORLD TO RUN.
                            //
                            // They were taken out when nothing happened in the world -- three keys
                            // that do nothing are worse than three keys that are not there. The
                            // world builds and gathers now, so they belong here again.
                            //
                            // And the pace they set was DEAD until this: `paceOf` computed a
                            // number, `renderGlWorld` took it as a parameter, and no line of code
                            // read it. Every run this project has done, at every gear, ran at one
                            // tick a frame. A speed control nothing is wired to is worse than no
                            // speed control, because the runs get labelled with a speed they
                            // never ran at.
                            if (ev.vk >= 0x31 && ev.vk <= 0x36) {          // 1..6: the gears
                                gear = ev.vk - 0x30;
                                pace = Main.paceOf(gear);
                                paused = false;
                            }
                            if (ev.vk == 0x20) {                           // space: pause
                                paused = !paused;
                            }
                        }
                        delete ev;
                    }
                    mutable float pan = r.curDist() * 0.007;
                    if (win.modShift()) {
                        pan = pan * 3.5;
                    }
                    if (win.keyDown(0x57)) { r.pan(0.0 - pan, 0.0); }
                    if (win.keyDown(0x53)) { r.pan(pan, 0.0); }
                    if (win.keyDown(0x41)) { r.pan(0.0, 0.0 - pan); }
                    if (win.keyDown(0x44)) { r.pan(0.0, pan); }
                    int cw = win.width();
                    int ch = win.height();
                    // Everybody moves, every frame. Nothing decides anything yet -- this is the
                    // cost of a world full of people, paid honestly, before any of them is asked
                    // to think.
                    gauge.lap(cast<int>(Phase.Input));
                    // THE GEAR, PAID IN WHOLE TICKS.
                    //
                    // Owed rather than rounded: at gear 1 with a frame to spare the world must
                    // still advance exactly once, and at gear 3 it must advance five times in the
                    // same second whatever the frame rate happens to be. An accumulator is the
                    // only version of that which does not silently change speed when the frame
                    // rate does.
                    //
                    // Capped per frame, and the shortfall is counted. A gear the machine cannot
                    // keep up with has to say so, rather than quietly running slower than the
                    // number on the screen -- which is the same defect as the pace nobody read.
                    if (!paused) {
                        owed = owed + pace;
                    }
                    mutable int ran = 0;
                    while (owed >= 1.0 && ran < Main.TICK_CAP) {
                        // Everybody moves every tick -- that is what makes a walk a walk. The
                        // town's DECISIONS do not need the same rate: births, orders, errands and
                        // hashes are events, and running them sixty-four times a frame was eighty
                        // five per cent of the frame for no visible gain.
                        if ((wanderTick & 7) == 0) {
                            realm.grow(g, folk, wanderTick);
                        }
                        gauge.lap(cast<int>(Phase.Deciding));
                        folk.wander(g, 0.05, wanderTick);
                        gauge.lap(cast<int>(Phase.Moving));
                        // EVERY TICK, not once at the end. A photograph cannot show a man walking
                        // back and forth; only the same agent's position tick after tick can.
                        // Off by default -- `agents.exe <seed> <gear> trace` turns it on -- since
                        // it is thousands of lines a second and belongs to a diagnosis, not a run.
                        if (traceOn) {
                            realm.trace(folk, wanderTick, 0);
                        }
                        wanderTick = wanderTick + 1;
                        owed = owed - 1.0;
                        ran = ran + 1;
                    }
                    if (owed >= 1.0) {
                        behind = behind + cast<long>(owed);
                        owed = 0.0;                      // do not let a backlog build up forever
                    }
                    r.setFolkTick(wanderTick);
                    // INTERPOLATION IS FOR ONE TICK A FRAME, AND NOTHING ELSE.
                    //
                    // An agent is moved once every SLICES ticks and the renderer draws it between
                    // where it was and where it is. That is honest at gear 1. Run sixty-four ticks
                    // in a frame and the position it is interpolating FROM is four whole passes
                    // old, so a walker is drawn as a smear with a ghost trailing behind it -- and
                    // the faster the world runs, the further back the ghost sits. Above a tick a
                    // frame there is nothing to interpolate between: draw people where they are.
                    // WHEN NO TICK RAN THIS FRAME, THERE IS NOTHING TO INTERPOLATE TOWARDS.
                    //
                    // `ran <= 1` was true for BOTH one tick and zero ticks, and zero is the case
                    // that produces the ghost: no tick ran, so `px,py` still holds where the agent
                    // was a whole slice ago, the fraction is recomputed against a tick that did
                    // not advance, and the man is drawn back at his old position for one frame
                    // before carrying on. That is the flick -- walking, snapping back, walking.
                    //
                    // Smoothing belongs to gear 1 and nowhere else: it is the only gear where a
                    // frame reliably advances the world exactly once.
                    r.setSmooth(pace <= 1.0 && !paused && ran == 1);
                    gauge.lap(cast<int>(Phase.Moving));
                    // The borders are rebuilt when the ground has changed hands and not otherwise.
                    // Territory changes a few times a second at most; rebuilding it every frame
                    // would be the sweep this project has already paid for twice.
                    if (realm.takeChanged()) {
                        r.bakeBorders();
                        r.bakeTowns();
                    } else if (realm.takeTownsCut()) {
                        // A frame went up, a building finished, or material landed on a site. The
                        // ground did not change hands, so the borders are still right -- but the
                        // town layer is not, and a building that appears only when a border moves
                        // is a building nobody sees go up.
                        r.bakeTowns();
                    }
                    // A felled tree stops being drawn. The detail bake is sliced across frames, so
                    // this costs a slice rather than a hitch -- the same machinery that draws the
                    // terrain draws the world it has left.
                    // A felled node stops being drawn -- but NOT on every frame that something
                    // comes off the map, which in a busy town is most of them. The bake is sliced
                    // across frames and starting one every frame leaves the camera's own bake no
                    // turn, which is what stopped the level of detail changing on zoom.
                    if (realm.takeMapCut()) {
                        cutPending = true;
                    }
                    // Spaced by FRAMES, not by ticks. At gear 6 sixty-four ticks pass in one
                    // frame, so a tick-based gap of sixty-four fired every single frame and the
                    // detail rebake alone was seventeen per cent of the frame.
                    cutFrames = cutFrames + 1;
                    if (cutPending && cutFrames >= 90) {
                        cutPending = false;
                        cutFrames = 0;
                        r.refreshDetail();
                    }
                    r.render(cw, ch);
                    // The frame rate, in the title and on the HUD. There is one clock now instead
                    // of two: with nothing being simulated there is no tick rate to fall out of
                    // step with the frame rate, and a second number that always agreed with the
                    // first would be a number nobody reads.
                    if (gauge.roll()) {
                        // THE GEAR IS ON THE SCREEN. A speed you cannot read off the window is a
                        // speed you cannot report a run at -- which is how three minutes of world
                        // got written down as "gear 6" when it ran at one tick a frame.
                        mutable String at = $"x{gear}";
                        if (paused) {
                            at = "PAUSED";
                        }
                        win.setTitle($"agents.exe -- world  |  {gauge.fps()} fps  |  {at}  |  tick {wanderTick}  [1-6 speed | space pause | drag/arrows rotate | wheel zoom | WASD pan | P pixels | ESC]");
                    }
                    hud.begin(cw, ch, 0);
                    r.drawCompass(hud, cw, ch);
                    text.rates(hud, gauge, ch);
                    hud.flush();
                    gauge.lap(cast<int>(Phase.Hud));
                    // The swap is its own phase because with vertical sync on it is where the frame
                    // WAITS. Time spent here is not work: it is the monitor holding the frame back,
                    // and reading it as cost would send the next optimisation at the wrong target.
                    win.swap();
                    gauge.lap(cast<int>(Phase.Swap));
                    gauge.frame();
                }
                // What the run cost, by part, printed on the way out: the live window is where the
                // real load is, and a profile you have to remember to ask for is a profile nobody
                // reads.
                r.frameMeter().report("frame");
                if (r.overruns() > 0) {
                    System.IO.Console.println($"renderer: {r.overruns()} vertex writes refused past the end of a buffer -- a counting pass and its emitting pass disagreed");
                }
                // Checked again on the way out, not only at startup: the two views of who owns
                // what have to still agree after the world has been running, which is the only
                // version of that question worth asking once anything starts changing it.
                realm.audit();
                realm.report();
                realm.growthReport();
                realm.trades(folk);
                realm.errands(folk);
                realm.agentDump(folk, 60);
                delete text;
                delete hud;
                delete realm;
                delete folk;
                delete r;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                return;
            }

            // WHAT THE OBJECT MODEL WEIGHS, measured rather than argued.
            //
            // Half a million agents, each a real object with its own memory object and eleven
            // growable lists, spread evenly over the walkable world and then all wandering. The
            // build time, the tick time and the memory are printed; the caller reads the process's
            // working set from outside, because a program measuring its own footprint is a program
            // that can be wrong about it in the flattering direction.
            //
            // The number to compare against: Worldbox, in C++, at 2.5 GB with two thousand sapient
            // agents.
            private static method weigh(int howMany, int deep) returns void {
                int w = 2560;
                int h = 1440;
                System.IO.Console.println($"weigh: {howMany} agents as objects, {deep} deep in memory each");
                long t0 = Time.nanos();
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                long t1 = Time.nanos();
                System.IO.Console.println($"world: {(t1 - t0) / 1000000} ms");
                Folk* folk = new Folk(howMany, 42) on heap;
                folk.scatter(g, howMany, deep);
                long t2 = Time.nanos();
                System.IO.Console.println($"spawn: {(t2 - t1) / 1000000} ms");
                folk.report();
                // Twenty ticks of everybody wandering. Enough to time the pass without the run
                // becoming about the wandering.
                mutable int tick = 0;
                while (tick < 20) {
                    folk.wander(g, 0.05, tick);
                    tick = tick + 1;
                }
                long t3 = Time.nanos();
                System.IO.Console.println($"wander: {(t3 - t2) / 1000000} ms for 20 ticks of {folk.count()} agents");
                System.IO.Console.println($"wander: {(t3 - t2) / 20000000} ms a tick");
                System.IO.Console.println("HOLDING -- read the working set now");
                // Held alive on purpose while the caller reads the process's memory from outside.
                // Freeing first would measure a program that had already given the answer back.
                long until = Time.nanos() + 8000000000;
                mutable long spins = 0;
                while (Time.nanos() < until) {
                    spins = spins + 1;
                }
                System.IO.Console.println($"still holding {folk.count()} agents");
                delete folk;
                delete g;
                return;
            }

            // Nearest land river cell to the map centre (for the close-up river verification frame).
            private static method findRiver(Grid* g, int w, int h) returns int {
                mutable int bestX = 0 - 1;
                mutable int bestY = 0;
                mutable int bestD = 2000000000;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.biomeAt(x, y) > 7 && g.hasFlag(x, y, Grid.FLAG_RIVER)) {
                            mutable int dx = x - w / 2;
                            if (dx < 0) { dx = 0 - dx; }
                            mutable int dy = y - h / 2;
                            if (dy < 0) { dy = 0 - dy; }
                            int d = dx + dy;
                            if (d < bestD) {
                                bestD = d;
                                bestX = x;
                                bestY = y;
                            }
                        }
                        x = x + 2;
                    }
                    y = y + 2;
                }
                if (bestX < 0) {
                    return 0 - 1;
                }
                return bestY * w + bestX;
            }

            // Nearest forest-ish cell to the map centre (for the close-up verification frame).
            private static method findForest(Grid* g, int w, int h) returns int {
                mutable int bestX = w / 2;
                mutable int bestY = h / 2;
                mutable int bestD = 2000000000;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int ord = g.biomeAt(x, y);
                        if (ord == 14 || ord == 22 || ord == 23 || ord == 27) {
                            mutable int dx = x - w / 2;
                            if (dx < 0) { dx = 0 - dx; }
                            mutable int dy = y - h / 2;
                            if (dy < 0) { dy = 0 - dy; }
                            int d = dx + dy;
                            if (d < bestD) {
                                bestD = d;
                                bestX = x;
                                bestY = y;
                            }
                        }
                        x = x + 4;
                    }
                    y = y + 4;
                }
                return bestY * w + bestX;
            }

            // Headless verification of the GL path: render one frame of the full world and read it back
            // to gl_world.ppm (+ a top-down biome map), no interactive loop.
            private static method captureGlWorld() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.writeBiomeMap(g, w, h, 720, 304, "glworld_map.ppm");
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("captureGlWorld: assets/models not found.");
                    delete g;
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("capture", 960, 600, 3, 3) == 0) {
                    System.IO.Console.println("captureGlWorld: no GL window.");
                    delete win;
                    delete g;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                Batch2D* hud = new Batch2D(win.gl) on heap;
                int cw = win.width();
                int ch = win.height();
                // far frame (whole world, coarse LOD) + compass
                r.render(cw, ch);
                hud.begin(cw, ch, 0);
                r.drawCompass(hud, cw, ch);
                hud.flush();
                byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px, cw, ch, "gl_world.ppm");
                delete px;
                // near frame: aim at the closest river (falls back to a forest), under the detail threshold
                mutable int packed = Main.findRiver(g, w, h);
                if (packed < 0) {
                    packed = Main.findForest(g, w, h);
                }
                r.aimAt(packed % w, packed / w);
                r.setView(42.0, 35.0, 110.0);
                r.render(cw, ch);
                hud.begin(cw, ch, 0);
                r.drawCompass(hud, cw, ch);
                hud.flush();
                byte[] px2 = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px2, cw, ch, "gl_world_near.ppm");
                delete px2;
                // grazing frame: far target but LOW camera -- the detail LOD must key off the height
                // above the ground, and the window must cover the foreground in front of the camera
                r.setView(120.0, 10.0, 500.0);
                r.flushDetail();
                r.render(cw, ch);
                byte[] px3 = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px3, cw, ch, "gl_world_low.ppm");
                delete px3;
                delete hud;
                delete r;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                System.IO.Console.println("captureGlWorld: wrote gl_world.ppm + gl_world_near.ppm");
                return;
            }

            // Twelve seeds, each judged and then captured AS THE GAME DRAWS IT. Judging a world on a
            // top-down biome map was how a visible grid of rectangular seams survived four rounds of
            // review: the proxy hid exactly the artefact the render showed. One seed proves nothing
            // either -- what matters is the pass rate over a spread of them.
            // Cut the world open across its straightest stretch of coast and read the raw numbers.
            // The whole question is whether the ELEVATION field has a cliff there or is smooth: a
            // cliff means some generator wrote a step, while a smooth field crossing a threshold
            // means the coast is exactly where the water level says and nothing is wrong with the
            // generation at all. Arguing about it from a screenshot got this wrong twice.
            // Aim the camera at a volcanic plateau's edge, where the LOD complaint lives, instead of
            // at whatever the river finder happens to hit.
            private static method cliffShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                mutable int found = 0 - 1;
                mutable int y = 8;
                while (y < h - 8 && found < 0) {
                    mutable int x = 8;
                    while (x < w - 8 && found < 0) {
                        if (g.biomeAt(x, y) == 36) {
                            int e0 = g.elevAt(x, y);
                            mutable int dx = 1;
                            while (dx <= 6 && found < 0) {
                                int o = g.biomeAt(x + dx, y);
                                if (o >= 8 && o != 36 && e0 - g.elevAt(x + dx, y) > 900) {
                                    found = y * w + x;
                                }
                                dx = dx + 1;
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                if (found < 0) {
                    System.IO.Console.println("cliffshot: no volcanic edge found.");
                    delete g;
                    return;
                }
                int fx = found % w;
                int fy = found / w;
                System.IO.Console.println($"cliffshot: volcanic edge at {fx},{fy}");
                String root = Main.assetRoot();
                GlWindow* win = new GlWindow() on heap;
                if (root.length() == 0 || win.open("cliff", 1100, 700, 3, 3) == 0) {
                    System.IO.Console.println("cliffshot: no GL window.");
                    delete win;
                    delete g;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                r.aimAt(fx, fy);
                r.setView(35.0, 28.0, 90.0);
                int cw = win.width();
                int ch = win.height();
                r.flushDetail();
                r.render(cw, ch);
                byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px, cw, ch, "cliff.ppm");
                delete px;
                // and again from far and low, which is the only place the COARSE layer is on screen
                r.setView(35.0, 11.0, 520.0);
                r.flushDetail();
                r.render(cw, ch);
                byte[] px2 = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px2, cw, ch, "cliff_far.ppm");
                delete px2;
                delete r;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                System.IO.Console.println("cliffshot: wrote cliff.ppm");
                return;
            }

            // Every resource node in one shot: one cell per NodeKind, in declaration order, on a run
            // of flat ground. Nothing generates nodes yet, so this is how the art set gets checked --
            // that each kind resolves to a mesh at all, at a sane scale, with its shadow on the
            // ground -- before a generator starts placing thousands of them.
            private static method nodeShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                // A grid rather than a line: 35 kinds strung out east-west end up a smear on the
                // horizon, where nothing can be told apart.
                int cols = 6;
                int pitch = 5;
                int rows = (Nodes.count() + cols - 1) / cols;
                int spanX = cols * pitch;
                int spanY = rows * pitch;
                mutable int fx = 0 - 1;
                mutable int fy = 0;
                mutable int sy = 80;
                while (sy < h - 80 - spanY && fx < 0) {
                    mutable int sx = 80;
                    while (sx < w - 80 - spanX && fx < 0) {
                        mutable boolean ok = true;
                        mutable int cy = 0;
                        while (cy < spanY && ok) {
                            mutable int cx = 0;
                            while (cx < spanX && ok) {
                                int ord = g.biomeAt(sx + cx, sy + cy);
                                if (ord < 14 || ord > 27) {
                                    ok = false;             // vegetated lowland, no coast, no ice
                                } else if (g.elevAt(sx + cx, sy + cy) >= 6300) {
                                    ok = false;
                                } else if (g.hasFlag(sx + cx, sy + cy, Grid.FLAG_RIVER)) {
                                    ok = false;
                                }
                                cx = cx + 2;
                            }
                            cy = cy + 2;
                        }
                        if (ok) {
                            fx = sx;
                            fy = sy;
                        }
                        sx = sx + 9;
                    }
                    sy = sy + 9;
                }
                if (fx < 0) {
                    System.IO.Console.println("nodeshot: no flat patch of land found.");
                    delete g;
                    return;
                }
                StringBuilder order = new StringBuilder() on heap;
                order.append("nodeshot: ");
                order.appendInt(cols);
                order.append(" per row at ");
                order.appendInt(fx);
                order.append(",");
                order.appendInt(fy);
                order.append(", reading left to right then down:");
                mutable int kk = 1;
                while (kk < Nodes.count()) {
                    int px2 = fx + (kk % cols) * pitch;
                    int py2 = fy + (kk / cols) * pitch;
                    g.surface().add(cast<float>(px2) + 0.5, cast<float>(py2) + 0.5, kk,
                                    Nodes.baseQty(kk));
                    order.append(" ");
                    order.append(Nodes.name(kk));
                    kk = kk + 1;
                }
                System.IO.Console.println(order.toString());
                delete order;
                g.surface().finish();
                String root = Main.assetRoot();
                GlWindow* win = new GlWindow() on heap;
                if (root.length() == 0 || win.open("nodes", 1400, 900, 3, 3) == 0) {
                    System.IO.Console.println("nodeshot: no GL window.");
                    delete win;
                    delete g;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                int cw = win.width();
                int ch = win.height();
                r.aimAt(fx + spanX / 2, fy + spanY / 2);
                r.setView(0.0, 62.0, 74.0);
                r.flushDetail();
                r.render(cw, ch);
                byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                Main.writePpmFlipped(px, cw, ch, "nodes_a.ppm");
                delete px;
                delete r;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                System.IO.Console.println("nodeshot: wrote nodes_a.ppm");
                return;
            }

            // The thickest wood in the world, from three heights. Judging a forest generator off a
            // capture aimed at wherever the default camera happens to point is how you conclude the
            // trees are sparse when the shot simply landed on a prairie -- so this finds the densest
            // 32-cell window first and looks at THAT.
            private static method forestShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                int win2 = 32;
                mutable int best = 0;
                mutable int fx = w / 2;
                mutable int fy = h / 2;
                byte[] tc = new byte[w * h]();
                g.surface().cellCounts(tc, true);
                mutable int sy = 0;
                while (sy < h - win2) {
                    mutable int sx = 0;
                    while (sx < w - win2) {
                        mutable int cnt = 0;
                        mutable int cy = 0;
                        while (cy < win2) {
                            mutable int cx = 0;
                            while (cx < win2) {
                                cnt = cnt + (cast<int>(tc[(sy + cy) * w + sx + cx]) & 255);
                                cx = cx + 2;
                            }
                            cy = cy + 2;
                        }
                        if (cnt > best) {
                            best = cnt;
                            fx = sx + win2 / 2;
                            fy = sy + win2 / 2;
                        }
                        sx = sx + win2;
                    }
                    sy = sy + win2;
                }
                delete tc;
                int biome = g.biomeAt(fx, fy);
                System.IO.Console.println($"forestshot: densest wood at {fx},{fy} in {Biomes.name(biome)}, {best} trees per 256 sampled cells");
                String root = Main.assetRoot();
                GlWindow* win = new GlWindow() on heap;
                if (root.length() == 0 || win.open("forest", 1200, 750, 3, 3) == 0) {
                    System.IO.Console.println("forestshot: no GL window.");
                    delete win;
                    delete g;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                r.aimAt(fx, fy);
                int cw = win.width();
                int ch = win.height();
                mutable int k = 0;
                while (k < 3) {
                    if (k == 0) {
                        r.setView(20.0, 26.0, 55.0);        // in among the trees
                    } else if (k == 1) {
                        r.setView(20.0, 45.0, 150.0);       // the wood and its clearings
                    } else {
                        r.setView(20.0, 60.0, 420.0);       // where the wood ends
                    }
                    r.flushDetail();
                    r.render(cw, ch);
                    byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                    if (k == 0) {
                        Main.writePpmFlipped(px, cw, ch, "forest_a.ppm");
                    } else if (k == 1) {
                        Main.writePpmFlipped(px, cw, ch, "forest_b.ppm");
                    } else {
                        Main.writePpmFlipped(px, cw, ch, "forest_c.ppm");
                    }
                    delete px;
                    k = k + 1;
                }
                delete r;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                System.IO.Console.println("forestshot: wrote forest_a.ppm, forest_b.ppm, forest_c.ppm");
                return;
            }

            // Three shots of HIGH GROUND, which is the only place the LOD was reported failing:
            // ground level looking across a plateau, a mid-height orbit, and a pull-back. If the
            // coarse layer ever covers the detail, a raised slab of giant blocks shows up here.
            private static method highShot() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                // the highest cell that has much lower ground within a few cells: a plateau rim
                mutable int found = 0 - 1;
                mutable int bestDrop = 0;
                mutable int y = 12;
                while (y < h - 12) {
                    mutable int x = 12;
                    while (x < w - 12) {
                        int e0 = g.elevAt(x, y);
                        if (e0 >= 6300) {
                            int drop = e0 - g.elevAt(x + 10, y);
                            if (drop > bestDrop) {
                                bestDrop = drop;
                                found = y * w + x;
                            }
                        }
                        x = x + 3;
                    }
                    y = y + 3;
                }
                if (found < 0) {
                    System.IO.Console.println("highshot: no high ground found.");
                    delete g;
                    return;
                }
                int fx = found % w;
                int fy = found / w;
                System.IO.Console.println($"highshot: plateau rim at {fx},{fy}, drop {bestDrop}");
                String root = Main.assetRoot();
                GlWindow* win = new GlWindow() on heap;
                if (root.length() == 0 || win.open("high", 1100, 700, 3, 3) == 0) {
                    System.IO.Console.println("highshot: no GL window.");
                    delete win;
                    delete g;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                r.aimAt(fx, fy);
                int cw = win.width();
                int ch = win.height();
                mutable int k = 0;
                while (k < 3) {
                    if (k == 0) {
                        r.setView(40.0, 16.0, 70.0);        // on the ground, looking across
                    } else if (k == 1) {
                        r.setView(40.0, 32.0, 170.0);       // mid orbit
                    } else {
                        r.setView(40.0, 30.0, 420.0);       // pulled back
                    }
                    r.flushDetail();
                    r.flushDetail();
                    r.render(cw, ch);
                    byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                    StringBuilder nm = new StringBuilder() on heap;
                    nm.append("high");
                    nm.appendInt(k);
                    nm.append(".ppm");
                    Main.writePpmFlipped(px, cw, ch, nm.toString());
                    delete nm;
                    delete px;
                    k = k + 1;
                }
                delete r;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete g;
                delete win;
                System.IO.Console.println("highshot: wrote high0.ppm high1.ppm high2.ppm");
                return;
            }

            private static method probeSeam() returns void {
                int w = 2560;
                int h = 1440;
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                WorldAudit* wa = new WorldAudit(g) on heap;
                wa.analyse();
                int run = wa.straightestV();
                int sx = wa.vSeamX();
                int sy = wa.vSeamY();
                System.IO.Console.println($"straightest vertical coast: {run} cells at x={sx}, y={sy}..{sy + run}");
                delete wa;
                // three horizontal cuts through the run: top, middle, bottom
                mutable int k = 0;
                while (k < 3) {
                    int cy = sy + run * k / 2;
                    System.IO.Console.println("");
                    System.IO.Console.println($"---- cut across y={cy} (x from {sx - 8} to {sx + 8}) ----");
                    System.IO.Console.println("   x   elev  biome              temp moist");
                    mutable int dx = 0 - 8;
                    while (dx <= 8) {
                        int px = sx + dx;
                        if (px >= 0 && px < w && cy >= 0 && cy < h) {
                            StringBuilder sb = new StringBuilder() on heap;
                            sb.append(Main.padNum(px, 5));
                            sb.append(Main.padNum(g.elevAt(px, cy), 7));
                            sb.append("  ");
                            sb.append(Main.pad(Biomes.name(g.biomeAt(px, cy)), 18));
                            sb.append(Main.padNum(g.tempAt(px, cy), 4));
                            sb.append(Main.padNum(g.moistAt(px, cy), 6));
                            if (dx == 0) {
                                sb.append("   <-- seam");
                            }
                            System.IO.Console.println(sb.toString());
                            delete sb;
                        }
                        dx = dx + 1;
                    }
                    k = k + 1;
                }
                delete g;
                return;
            }

            private static method preview() returns void {
                int w = 2560;
                int h = 1440;
                int cols = 4;
                int rows = 3;
                int tw = 560;
                int th = 350;
                String root = Main.assetRoot();
                if (root.length() == 0) {
                    System.IO.Console.println("preview: assets/models not found.");
                    return;
                }
                GlWindow* win = new GlWindow() on heap;
                if (win.open("preview", tw, th, 3, 3) == 0) {
                    System.IO.Console.println("preview: no GL window.");
                    delete win;
                    return;
                }
                MeshAtlas* terr = MeshAtlas.loadTerrain(root);
                MeshAtlas* props = MeshAtlas.loadNamed(root, "props.index");
                MeshAtlas* nodeMesh = MeshAtlas.loadNamed(root, "nodes.index");
                MeshAtlas* peopleMesh = MeshAtlas.loadNamed(root, "agents.index");
                MeshAtlas* rivers = MeshAtlas.loadNamed(root, "rivers.index");
                int sw = cols * tw;
                int sh = rows * th;
                byte[] sheet = new byte[sw * sh * 3]();
                mutable int passed = 0;
                mutable int k = 0;
                while (k < cols * rows) {
                    int seed = 42 + k * 7717;
                    WorldGen gen = new WorldGen(seed) on stack;
                    gen.setWorld(0, 0.0 - 1.0);
                    Grid* g = gen.generate(w, h);
                    WorldAudit* wa = new WorldAudit(g) on heap;
                    wa.analyse();
                    int v = wa.verdict(6);
                    System.IO.Console.println($"---- seed {seed} ----");
                    wa.report(6);
                    delete wa;
                    GlWorld3D* r = new GlWorld3D(win.gl) on heap;
                    r.setup(g, terr, props, nodeMesh, rivers, 8, 1.1);
                    int cw = win.width();
                    int ch = win.height();
                    r.flushDetail();
                    r.flushDetail();
                    r.render(cw, ch);
                    byte[] px = win.gl.readPixelsRgb(0, 0, cw, ch);
                    Main.blitTile(sheet, sw, sh, px, cw, ch,
                                  (k % cols) * tw, (k / cols) * th, tw, th, v == 0);
                    delete px;
                    delete r;
                        delete g;
                    if (v == 0) {
                        passed = passed + 1;
                    }
                    k = k + 1;
                }
                Main.writePpm(sheet, sw, sh, "preview_sheet.ppm");
                delete sheet;
                delete rivers;
                delete nodeMesh;
                delete peopleMesh;
                delete props;
                delete terr;
                delete win;
                int total = cols * rows;
                System.IO.Console.println($"preview: {passed}/{total} seeds PASS -- wrote preview_sheet.ppm");
                return;
            }

            // Copy one capture into the contact sheet, flipping it (GL reads bottom-up) and framing
            // it in the colour of its verdict: green passed, red rejected.
            private static method blitTile(byte[] sheet, int sw, int sh, byte[] px, int cw, int ch,
                                           int ox, int oy, int tw, int th, boolean ok) returns void {
                mutable int y = 0;
                while (y < th) {
                    mutable int x = 0;
                    while (x < tw) {
                        int dx = ox + x;
                        int dy = oy + y;
                        if (dx < sw && dy < sh) {
                            int di = (dy * sw + dx) * 3;
                            mutable int rr = 20;
                            mutable int gg = 22;
                            mutable int bb = 28;
                            if (x < 5 || y < 5 || x >= tw - 5 || y >= th - 5) {
                                if (ok) {
                                    rr = 60;
                                    gg = 200;
                                    bb = 90;
                                } else {
                                    rr = 220;
                                    gg = 70;
                                    bb = 60;
                                }
                            } else if (x < cw && y < ch) {
                                int si = ((ch - 1 - y) * cw + x) * 3;
                                rr = cast<int>(px[si]) & 255;
                                gg = cast<int>(px[si + 1]) & 255;
                                bb = cast<int>(px[si + 2]) & 255;
                            }
                            sheet[di] = cast<byte>(rr);
                            sheet[di + 1] = cast<byte>(gg);
                            sheet[di + 2] = cast<byte>(bb);
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                return;
            }

            private static method writePpm(byte[] px, int w, int h, String path) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(w);
                sb.append(" ");
                sb.appendInt(h);
                sb.append("\n255\n");
                mutable int i = 0;
                int n = w * h;
                while (i < n) {
                    sb.appendInt(cast<int>(px[i * 3]) & 255);
                    sb.append(" ");
                    sb.appendInt(cast<int>(px[i * 3 + 1]) & 255);
                    sb.append(" ");
                    sb.appendInt(cast<int>(px[i * 3 + 2]) & 255);
                    sb.append(" ");
                    if ((i + 1) % w == 0) {
                        sb.append("\n");
                    }
                    i = i + 1;
                }
                File.writeAll(path, sb.toString());
                delete sb;
                return;
            }

            private static method writePpmFlipped(byte[] px, int w, int h, String path) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(w);
                sb.append(" ");
                sb.appendInt(h);
                sb.append("\n255\n");
                mutable int y = 0;
                while (y < h) {
                    int srcRow = h - 1 - y;
                    mutable int x = 0;
                    while (x < w) {
                        int i = (srcRow * w + x) * 3;
                        sb.appendInt(cast<int>(px[i]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 1]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(px[i + 2]) & 255);
                        sb.append(" ");
                        x = x + 1;
                    }
                    sb.append("\n");
                    y = y + 1;
                }
                File.writeAll(path, sb.toString());
                delete sb;
            }

            // Generate all four world modes and write a top-down biome-colour overview PNG of each --
            // the fast way to verify continent shapes per mode.
            private static method worldMaps() returns void {
                int w = 1280;
                int h = 540;
                mutable int mode = 0;
                while (mode < 4) {
                    System.IO.Console.println("worldmaps: generating mode...");
                    WorldGen gen = new WorldGen(42) on stack;
                    gen.setWorld(mode, 0.0 - 1.0);
                    Grid* g = gen.generate(w, h);
                    Main.worldStats(g, w, h);
                    Main.writeBiomeMap(g, w, h, 640, 270, Main.mapName(mode));
                    delete g;
                    mode = mode + 1;
                }
                System.IO.Console.println("worldmaps: done");
            }

            private static method mapName(int mode) returns String {
                if (mode == 0) { return "worldmap_continental.ppm"; }
                if (mode == 1) { return "worldmap_pangaea.ppm"; }
                if (mode == 2) { return "worldmap_archipelago.ppm"; }
                return "worldmap_inlandseas.ppm";
            }

            // Downsample the biome grid to outW x outH and write it top-down as a PPM (biome palette).
            private static method writeBiomeMap(Grid* g, int w, int h, int outW, int outH, String path) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(outW);
                sb.append(" ");
                sb.appendInt(outH);
                sb.append("\n255\n");
                mutable int oy = 0;
                while (oy < outH) {
                    int sy = oy * h / outH;
                    mutable int ox = 0;
                    while (ox < outW) {
                        int sx = ox * w / outW;
                        int ord = g.biomeAt(sx, sy);
                        sb.appendInt(Biomes.red(ord));
                        sb.append(" ");
                        sb.appendInt(Biomes.green(ord));
                        sb.append(" ");
                        sb.appendInt(Biomes.blue(ord));
                        sb.append(" ");
                        ox = ox + 1;
                    }
                    sb.append("\n");
                    oy = oy + 1;
                }
                File.writeAll(path, sb.toString());
                delete sb;
            }

            private static method worldStats(Grid* g, int w, int h) returns void {
                mutable int water = 0;
                mutable int land = 0;
                mutable int emin = 100000;
                mutable int emax = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int e = g.elevAt(x, y);
                        if (e < emin) { emin = e; }
                        if (e > emax) { emax = e; }
                        if (g.biomeAt(x, y) <= 6) {
                            water = water + 1;
                        } else {
                            land = land + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("gen3d: water=");
                sb.appendInt(water);
                sb.append(" land=");
                sb.appendInt(land);
                sb.append(" elev[");
                sb.appendInt(emin);
                sb.append("..");
                sb.appendInt(emax);
                sb.append("]");
                System.IO.Console.println(sb.toString());
                delete sb;
            }

            // ---- worldgen audit: SEE what the generator produced, in numbers ----------------------
            // `AgentsExe.exe audit` generates the default world (same seed/mode as the game) and
            // prints a per-biome census, a land elevation histogram, river-network health metrics
            // (mouths / broken ends / sources) and placement checks (border trench, lowland volcanic),
            // plus a full-size top-down biome map (audit_map.ppm).
            private static method pad(String s, int width) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append(s);
                mutable int k = s.length();
                while (k < width) {
                    sb.append(" ");
                    k = k + 1;
                }
                String out = sb.toString();
                delete sb;
                return out;
            }

            private static method padLeft(String s, int width) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                mutable int k = s.length();
                while (k < width) {
                    sb.append(" ");
                    k = k + 1;
                }
                sb.append(s);
                String out = sb.toString();
                delete sb;
                return out;
            }

            private static method padNum(int v, int width) returns String {
                StringBuilder sb = new StringBuilder() on heap;
                sb.appendInt(v);
                String num = sb.toString();
                delete sb;
                return Main.padLeft(num, width);
            }

            // one-decimal percentage of count/total, right-aligned in 7 chars ("  12.3%")
            private static method pct(int count, int total) returns String {
                mutable int p10 = 0;
                if (total > 0) {
                    p10 = cast<int>(cast<long>(count) * 1000 / cast<long>(total));
                }
                StringBuilder sb = new StringBuilder() on heap;
                sb.appendInt(p10 / 10);
                sb.append(".");
                sb.appendInt(p10 % 10);
                sb.append("%");
                String out = sb.toString();
                delete sb;
                return Main.padLeft(out, 7);
            }

            private static method audit() returns void {
                int w = 2560;
                int h = 1440;
                System.IO.Console.println("audit: generating the default world (Continental, 2560x1440, seed 42)...");
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Grid* g = gen.generate(w, h);
                Main.auditBiomes(g, w, h);
                Main.auditElevation(g, w, h);
                Main.auditPlacement(g, w, h);
                Main.auditRivers(g, w, h);
                System.IO.Console.println("");
                System.IO.Console.println("---- shape criteria ------------------------------------------");
                WorldAudit* wa = new WorldAudit(g) on heap;
                wa.analyse();
                wa.report(6);
                delete wa;
                Main.writeBiomeMap(g, w, h, 1280, 720, "audit_map.ppm");
                System.IO.Console.println("");
                System.IO.Console.println("audit: wrote audit_map.ppm (top-down biome map, full world).");
                delete g;
                return;
            }

            private static method auditBiomes(Grid* g, int w, int h) returns void {
                int[] cnt = new int[40]();
                mutable int land = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int o = g.biomeAt(x, y);
                        cnt[o] = cnt[o] + 1;
                        if (o >= 8) {
                            land = land + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                int total = w * h;
                System.IO.Console.println("");
                System.IO.Console.println("---- biome census -------------------------------------------");
                // NOTE: a leading string LITERAL in println is a printf format -- '%' must be escaped
                System.IO.Console.println(" ord biome                     cells  %%world  %%land");
                mutable int o = 0;
                mutable int missing = 0;
                while (o < 40) {
                    StringBuilder sb = new StringBuilder() on heap;
                    sb.append(Main.padNum(o, 4));
                    sb.append(" ");
                    String nm = Biomes.name(o);
                    sb.append(Main.pad(nm, 20));
                    sb.append(Main.padNum(cnt[o], 9));
                    sb.append(" ");
                    sb.append(Main.pct(cnt[o], total));
                    if (o >= 8) {
                        sb.append(" ");
                        sb.append(Main.pct(cnt[o], land));
                    }
                    if (cnt[o] == 0) {
                        if (o == 7) {
                            // rivers are a FLAG over terrain cells (the renderer draws the channel);
                            // ordinal 7 never appears as a cell biome by design
                            sb.append("   (flag-based, expected 0)");
                        } else {
                            sb.append("   <-- MISSING");
                            missing = missing + 1;
                        }
                    }
                    System.IO.Console.println(sb.toString());
                    delete sb;
                    o = o + 1;
                }
                mutable int mountainFam = cnt[32] + cnt[33] + cnt[34] + cnt[35] + cnt[36];
                StringBuilder s2 = new StringBuilder() on heap;
                s2.append("land ");
                s2.append(Main.pct(land, total));
                s2.append(" of world | mountain family (Hills..Volcanic) ");
                s2.append(Main.pct(mountainFam, land));
                s2.append(" of land | missing biomes: ");
                s2.appendInt(missing);
                System.IO.Console.println(s2.toString());
                delete s2;
                delete cnt;
                return;
            }

            private static method auditElevation(Grid* g, int w, int h) returns void {
                // land-only elevation histogram, 20 bins over 0..1 -- shows where the mountain cut
                // (0.62) falls and how much land piles above it
                int[] bins = new int[20]();
                mutable int land = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.biomeAt(x, y) >= 8) {
                            land = land + 1;
                            mutable int b = g.elevAt(x, y) / 500;
                            if (b > 19) {
                                b = 19;
                            }
                            bins[b] = bins[b] + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                System.IO.Console.println("");
                System.IO.Console.println("---- land elevation histogram (bin = 0.05) ------------------");
                mutable int b = 0;
                while (b < 20) {
                    if (bins[b] > 0) {
                        StringBuilder sb = new StringBuilder() on heap;
                        sb.append("  0.");
                        sb.appendInt(b * 5 / 10);
                        sb.appendInt(b * 5 % 10);
                        sb.append("0 ");
                        sb.append(Main.padNum(bins[b], 9));
                        sb.append(" ");
                        sb.append(Main.pct(bins[b], land));
                        mutable int bar = bins[b] * 50 / land;
                        sb.append("  ");
                        mutable int k = 0;
                        while (k < bar) {
                            sb.append("#");
                            k = k + 1;
                        }
                        System.IO.Console.println(sb.toString());
                        delete sb;
                    }
                    b = b + 1;
                }
                delete bins;
                return;
            }

            private static method auditPlacement(Grid* g, int w, int h) returns void {
                // MarineTrench should live in deep interior basins, not hug the map border; Volcanic
                // should sit on high ground (ridges), not lowland grass.
                mutable int trench = 0;
                mutable int trenchBorder = 0;
                mutable int volc = 0;
                mutable int volcLow = 0;
                int bx = w / 10;
                int by = h / 10;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int o = g.biomeAt(x, y);
                        if (o == 0) {
                            trench = trench + 1;
                            if (x < bx || x >= w - bx || y < by || y >= h - by) {
                                trenchBorder = trenchBorder + 1;
                            }
                        }
                        if (o == 36) {
                            volc = volc + 1;
                            if (g.elevAt(x, y) < 5500) {
                                volcLow = volcLow + 1;
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                System.IO.Console.println("");
                System.IO.Console.println("---- placement checks ---------------------------------------");
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("MarineTrench cells ");
                sb.appendInt(trench);
                sb.append(", in the outer 10% border ring: ");
                sb.appendInt(trenchBorder);
                sb.append(" (");
                sb.append(Main.pct(trenchBorder, trench));
                sb.append(")  [border trench = artificial]");
                System.IO.Console.println(sb.toString());
                delete sb;
                StringBuilder s2 = new StringBuilder() on heap;
                s2.append("Volcanic cells ");
                s2.appendInt(volc);
                s2.append(", below elevation 0.55 (lowland): ");
                s2.appendInt(volcLow);
                s2.append(" (");
                s2.append(Main.pct(volcLow, volc));
                s2.append(")  [lowland volcanic = misplaced]");
                System.IO.Console.println(s2.toString());
                delete s2;
                return;
            }

            private static method auditRivers(Grid* g, int w, int h) returns void {
                byte[] inflow = new byte[w * h]();
                mutable int cells = 0;
                mutable int mouths = 0;
                mutable int broken = 0;
                mutable int noflow = 0;
                mutable int onCoast = 0;
                mutable int shown = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.hasFlag(x, y, Grid.FLAG_RIVER)) {
                            cells = cells + 1;
                            int o = g.biomeAt(x, y);
                            if (o == 8 || o == 9) {
                                onCoast = onCoast + 1;
                            }
                            if (!g.hasFlow(x, y)) {
                                noflow = noflow + 1;
                            } else {
                                int tx = x + g.flowDx(x, y);
                                int ty = y + g.flowDy(x, y);
                                if (tx < 0 || ty < 0 || tx >= w || ty >= h) {
                                    broken = broken + 1;
                                } else {
                                    inflow[ty * w + tx] = cast<byte>(1);
                                    int tb = g.biomeAt(tx, ty);
                                    // water (<=7) or a salt flat (38): a river dying into a dry
                                    // basin is a legitimate endorheic terminus, not a defect
                                    if (tb <= 7 || tb == 38) {
                                        mouths = mouths + 1;
                                    } else {
                                        if (!g.hasFlag(tx, ty, Grid.FLAG_RIVER)) {
                                            broken = broken + 1;
                                            if (shown < 6) {
                                                StringBuilder sb = new StringBuilder() on heap;
                                                sb.append("  broken river end at (");
                                                sb.appendInt(x);
                                                sb.append(",");
                                                sb.appendInt(y);
                                                sb.append(") -> lands on ");
                                                String tn = Biomes.name(tb);
                                                sb.append(tn);
                                                System.IO.Console.println(sb.toString());
                                                delete sb;
                                                shown = shown + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                mutable int sources = 0;
                y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.hasFlag(x, y, Grid.FLAG_RIVER) && cast<int>(inflow[y * w + x]) == 0) {
                            sources = sources + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                System.IO.Console.println("");
                System.IO.Console.println("---- river network ------------------------------------------");
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("river cells ");
                sb.appendInt(cells);
                sb.append(" | sources ");
                sb.appendInt(sources);
                sb.append(" | mouths (reach water) ");
                sb.appendInt(mouths);
                sb.append(" | BROKEN ends (die on land) ");
                sb.appendInt(broken);
                sb.append(" | no-flow ");
                sb.appendInt(noflow);
                sb.append(" | on beach/rocky shore ");
                sb.appendInt(onCoast);
                System.IO.Console.println(sb.toString());
                delete sb;
                delete inflow;
                return;
            }

            private static method writeSnapshot(Grid* g, int w, int h) returns void {
                int sw = 1280;
                int sh = 720;
                SoftPainter sp = new SoftPainter(sw, sh) on stack;
                sp.fillRect(0, 0, sw, sh, 18, 41, 66);
                Camera cam = new Camera(sw, sh) on stack;
                cam.focusCell(w / 2, h / 2);
                cam.setZoom(0.42);
                WorldRenderer.draw(sp, g, cam, sw, sh);
                sp.save("world_iso.ppm");
                System.IO.Console.println("wrote world_iso.ppm");
            }
        }
    }
}
