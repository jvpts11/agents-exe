import System.IO.Console;
program AgentsExe;

// WHAT AN AGENT WEARS: five slots, one of each, and nothing about it varies in length.
//
// Fixed slots rather than a list, for the same reason the hands are three fields: an agent has a
// head, a torso, legs, feet and one arm free for a shield, and none of that is a number that
// changes. A list would cost an allocation per agent and a pointer chase to read a slot, to model a
// set that cannot grow.
//
// Each is an index into the world's item table, or NOTHING.
public bundle Agents {
    public namespace People {

        public struct Armour {
            public static fixed int NOTHING = 0 - 1;

            public mutable int head;
            public mutable int torso;
            public mutable int legs;
            public mutable int feet;
            public mutable int shield;
        }
    }
}
