import System.IO.Console;
program AgentsExe;

// WHICH BUILDING, as a type of its own. See `CityId` for why every id here is a `newtype` and not
// an int: they are all integers, they are all in scope together, and nothing but the type stops one
// being handed where another belongs.
public bundle Agents {
    public namespace People {

        public newtype BuildingId = int;
    }
}
