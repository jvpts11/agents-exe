program AgentsExe;

// ONE TIE, AS ONE VALUE: who, how, and how strongly.
//
// PACKED INTO AN INT, because a tie is a link in a chain and a chain's pool holds one array of
// whatever a link is. A struct of three fields would be three arrays or a wider one; an int is the
// pool the `Chain` already has. The slot number is twenty-four bits (sixteen million people, which
// is more than a world will hold), the relation four (ten of them), and the affinity four -- a
// sixteenth of the way from nothing to everything, which is finer than anything reads it.
//
// AND IT IS A TYPE RATHER THAN A BARE INT so that a slot cannot be handed where a tie was meant.
// Both are ints; both would compile.
public bundle Agents {
    public namespace People {

        public newtype Tie = int;
    }
}
