import System.IO.Console;
import Agents.World.Grid;
import Agents.World.Biomes;
import Agents.World.NodeField;
import Agents.World.Harvest;
import Agents.World.LandMath;

// Everybody alive, as one table. An agent is an INDEX, not a pointer -- the same Structure-of-Arrays
// shape as Grid and NodeField, and for the same reason: the ceiling is fifty thousand of them, and a
// loop over `float[]` vectorises where fifty thousand scattered objects never could.
//
// The budget that matters is NOT memory. The whole table is about 65 bytes a head, so all fifty
// thousand fit in 3.3 MB and nothing in this design is shaped by storage. What binds is thinking
// time per frame and triangles per frame, and both are spent elsewhere -- so this file spends memory
// freely to keep those two cheap.
//
// A dead agent's row is recycled by the next birth through a free list. That is not an optimisation:
// with a six-minute life and fifty thousand people, the world buries and delivers about a hundred
// and forty each per SECOND, and replaces its entire population every six minutes.
program AgentsExe;

public bundle Agents {
    public namespace People {

        // What an agent does for a living. The set follows docs/ECONOMY.md -- node classes and the
        // buildings that transform them -- not the original's twelve professions over five
        // resources, which cannot describe a world with ten distinct metal veins.
        public enum Job {
            Idle,
            Forager, Woodcutter, Hunter, Fisher, Farmer,
            Quarrier, Miner, Prospector,
            Sawyer, Smith, Baker, Weaver,
            Builder, Trader,
            Raider, General,
            Scholar,         // the trades that make knowledge instead of goods
            // The industrial trades. Until these existed, one smith worked the anvil, the refinery,
            // the chemical plant, the chip fabricator, the reactor and the motor works -- a single
            // profession carrying a third of the whole catalogue, which is the same as saying the
            // third and fourth ages had no trades in them at all.
            Mason,           // stone, dressed and fired
            Digger,          // what is under the ground, at a scale a pick cannot
            Chemist,         // coal and sulfur cooked into things that did not exist before
            Machinist,       // steel to a tolerance no hand holds
            Engineer,        // the mains, and everything that runs off it
            Healer           // the only trade in this world whose work is somebody NOT dying
        }

        // The verb running right now. Named Act and not Task: Task<T> is the stdlib's async handle, and
        // a type-name collision across namespaces corrupts symbol resolution and is then reported
        // against an unrelated file. Closed on purpose: a new verb is a design decision, never
        // something that appears inside an `if`.
        public enum Act {
            Idle, Wander, WalkTo,
            Gather, Hunt, Carry, Deposit, Refine, Till, Build, Prospect,
            Eat, Rest, Flee,
            Court, Raise,
            Follow, Lead, Discover, Teach,
            March, Fight
        }

        // Nobody is appointed. A role comes into being when a community crosses a threshold, and it
        // outlives whoever fills it -- which it must, because nobody lives longer than six minutes.
        public enum Role {
            None, Elder, Chief, Priest, General, TradeChief
        }

        // Which of the four approved bodies draws this agent. Order matches assets/models/agents.index.
        public enum Body {
            Civil, Protagonist, Scout, Soldier
        }

        public class AgentTable {
            // flag bits
            public static fixed int F_ALIVE = 1;
            public static fixed int F_FEMALE = 2;
            public static fixed int F_ADULT = 4;
            public static fixed int F_MARRIED = 8;
            public static fixed int F_PREGNANT = 16;

            private mutable int cap;
            private mutable int live;          // how many rows are in use
            private mutable int high;          // highest row ever handed out
            private mutable int[] freeSlot;    // recycled rows, a stack
            private mutable int freeTop;
            private mutable int widenings;   // times the table has had to grow

            // where and who
            private mutable float[] px;
            private mutable float[] py;
            private mutable short[] home;      // community id
            private mutable byte[] job;
            private mutable byte[] role;
            private mutable byte[] flags;
            // WHICH WAY THIS PERSON IS FACING, as a unit vector rather than a compass point.
            //
            // This was one byte holding a quadrant, and in that shape it was written by the walk
            // step and read by nobody at all -- the renderer never asked, so for the whole life of
            // this project fifty thousand people crossed a continent all facing the same way. Two
            // floats instead of one byte is four hundred kilobytes at full population, and it buys
            // a heading the renderer can turn a mesh by without a trig call per person per frame,
            // and a smooth one: a quadrant snaps through ninety degrees, a vector does not.
            private mutable float[] hx;
            private mutable float[] hy;
            // what it is doing
            private mutable byte[] task;
            private mutable float[] taskTimer;
            // How far this walk was when it began. Two hundred kilobytes for fifty thousand people,
            // and it buys the only honest test for "gave up": the patience for a journey has to be
            // measured against the journey's OWN length, or the same stopwatch calls a long walk a
            // failure and lets somebody grinding against a cliff face carry on forever.
            private mutable float[] journey;
            private mutable int[] targetNode;  // index into NodeField, -1 = none
            // Where a craftsman works, as an index into the Buildings table, or -1. Its own field and
            // not a second meaning for targetNode: a gatherer's node and a smith's forge are answers
            // to different questions, and one slot holding either is how a bug gets written.
            private mutable int[] workplace;
            // Where a carter is taking their load, as an index into the COMMUNITIES, or -1. Its own
            // field for the reason directly above: a settlement index and a building index are
            // answers to different questions, and a craftsman who later inherited a stale one would
            // adopt whichever building happened to sit at that number.
            private mutable int[] bound;
            // One counter per verb: how many times anybody has ever begun doing it.
            private mutable long[] tally;
            private mutable short[] targetX;
            private mutable short[] targetY;
            private mutable byte[] carryKind;
            private mutable short[] carryAmt;
            // What this person owns rather than what they are carrying home. A bitset because the
            // three are independent and a byte holds them: a soldier may have a weapon and no
            // armour, a woodcutter a tool and neither.
            //
            // Armour is HERE and never in the renderer. It changes what a blow costs and that is
            // all it does -- Joao's call, and the right one: on a two-unit cube at eight pixels a
            // breastplate is three pixels of grey, and the twelve authored models earn their keep
            // in an inventory panel rather than on a body nobody can see it on.
            private mutable byte[] kit;
            // Uses left in the tool. A tool that never wore out would be a one-off gift, and the
            // whole reason the iron chain exists is that a village has to keep making them.
            private mutable short[] toolLife;
            // life
            private mutable float[] age;
            private mutable float[] lifespan;
            private mutable byte[] hp;
            // what it feels: needs rise on their own
            private mutable byte[] hunger;
            private mutable byte[] tired;
            private mutable byte[] fear;
            private mutable byte[] lonely;
            // AND ONE THING THAT DOES NOT RISE ON ITS OWN.
            //
            // Hunger, tiredness, fear and loneliness are all the body's own clocks. Sickness is not:
            // it comes from OUTSIDE -- from too many people in too few rooms and from water nobody
            // has cleaned -- and that is why it sits beside them rather than among them. It is also
            // the only one of the five that kills somebody who is doing everything right.
            private mutable byte[] ill;
            // what it is: weights it was born with, inherited with drift
            private mutable byte[] bold;
            private mutable byte[] social;
            private mutable byte[] greed;
            private mutable byte[] curious;
            private mutable byte[] ambition;
            private mutable byte[] influence;
            // WHAT THIS PERSON HAS LEARNED ABOUT THE WORLD, which is the whole of individual
            // memory in one byte: how many times they have taken something and walked away with
            // it. Nothing else in this table is a thing that happened TO somebody -- temperament is
            // inherited, hunger and tiredness are states, influence is what others think. This is
            // the first field that makes two people in identical circumstances act differently
            // because of their own past.
            private mutable byte[] nerve;
            // CENSUSES LEFT AS SOMEBODY ELSE'S PRISONER.
            //
            // A captive was a population transfer and nothing else: marched off one tick, a full
            // citizen of the town that took them the next. That is not what being taken is. This is
            // the years it takes to stop being a prisoner -- during which somebody works, because
            // that is what they were taken FOR, but does not start a family and cannot be listened
            // to. One byte, counted down at the census like every other clock in this world.
            private mutable byte[] held;
            // kin
            //
            // A ROW IS NOT A PERSON. Rows are recycled -- that free list is the whole reason this
            // table can run fifty thousand people through a million births -- so an index kept from
            // one lifetime into another names whoever was born into the slot afterwards. `mother`
            // and `father` were exactly that, and nothing in the world read them, which is the only
            // reason nobody had noticed a child inheriting a stranger for a parent.
            //
            // So every person gets a SERIAL, handed out once and never reused, and a kin link
            // carries the serial it meant. The link is live only while the row still holds that
            // person. Two ints per row and the world can finally say who anybody's mother was.
            private mutable int[] serial;
            private mutable int nextSerial;
            // Who somebody is with. The row AND the serial, because a partner who dies has their row
            // handed to the next child born and a marriage must not survive into a stranger.
            private mutable int[] spouse;
            private mutable int[] spouseSer;
            // ONE FRIEND AND ONE ENEMY, and no more than that on purpose.
            //
            // Fifty thousand people is two and a half billion pairs, so a general web of who likes
            // whom is not a thing this world can hold. What it CAN hold is the person somebody would
            // name if you asked -- the one they owe and the one they blame -- which is one slot each
            // and the same row-and-serial guard the marriage needs.
            //
            // A slot is only ever written by an event that already names two people, because those
            // are the only moments this simulation has where a relationship could honestly form: a
            // birth names a mother and a sire, a marriage names a couple, a theft names a thief and
            // the town that lost, and a battle names a general and the seat he broke.
            private mutable int[] friend;
            private mutable int[] friendSer;
            private mutable int[] foe;
            private mutable int[] foeSer;
            private mutable int[] mother;
            private mutable int[] motherSer;
            private mutable int[] father;
            private mutable int[] fatherSer;
            // Who a pregnancy is by, remembered from the moment it starts until the child is born.
            private mutable int[] sire;
            private mutable int[] sireSer;
            private mutable float[] gest;      // seconds of pregnancy left, 0 = not
            // scheduling
            private mutable int[] nextThink;

            public constructor AgentTable(int cap) {
                this.cap = cap;
                this.live = 0;
                this.high = 0;
                this.freeTop = 0;
                this.widenings = 0;
                this.freeSlot = new int[cap]();
                this.px = new float[cap]();
                this.py = new float[cap]();
                this.home = new short[cap]();
                this.job = new byte[cap]();
                this.role = new byte[cap]();
                this.flags = new byte[cap]();
                this.hx = new float[cap]();
                this.hy = new float[cap]();
                this.task = new byte[cap]();
                this.taskTimer = new float[cap]();
                this.journey = new float[cap]();
                this.targetNode = new int[cap]();
                this.workplace = new int[cap]();
                this.bound = new int[cap]();
                this.tally = new long[Act.count()]();
                this.targetX = new short[cap]();
                this.targetY = new short[cap]();
                this.carryKind = new byte[cap]();
                this.kit = new byte[cap]();
                this.toolLife = new short[cap]();
                this.carryAmt = new short[cap]();
                this.age = new float[cap]();
                this.lifespan = new float[cap]();
                this.hp = new byte[cap]();
                this.hunger = new byte[cap]();
                this.tired = new byte[cap]();
                this.fear = new byte[cap]();
                this.lonely = new byte[cap]();
                this.ill = new byte[cap]();
                this.bold = new byte[cap]();
                this.social = new byte[cap]();
                this.greed = new byte[cap]();
                this.curious = new byte[cap]();
                this.ambition = new byte[cap]();
                this.influence = new byte[cap]();
                this.nerve = new byte[cap]();
                this.held = new byte[cap]();
                this.spouse = new int[cap]();
                this.spouseSer = new int[cap]();
                this.friend = new int[cap]();
                this.friendSer = new int[cap]();
                this.foe = new int[cap]();
                this.foeSer = new int[cap]();
                this.mother = new int[cap]();
                this.motherSer = new int[cap]();
                this.father = new int[cap]();
                this.fatherSer = new int[cap]();
                this.sire = new int[cap]();
                this.sireSer = new int[cap]();
                this.serial = new int[cap]();
                this.nextSerial = 1;
                this.gest = new float[cap]();
                this.nextThink = new int[cap]();
            }

            public destructor ~AgentTable() returns void {
                delete this.freeSlot;
                delete this.px;
                delete this.py;
                delete this.home;
                delete this.job;
                delete this.role;
                delete this.flags;
                delete this.hx;
                delete this.hy;
                delete this.task;
                delete this.taskTimer;
                delete this.journey;
                delete this.targetNode;
                delete this.workplace;
                delete this.bound;
                delete this.tally;
                delete this.targetX;
                delete this.targetY;
                delete this.carryKind;
                delete this.kit;
                delete this.toolLife;
                delete this.carryAmt;
                delete this.age;
                delete this.lifespan;
                delete this.hp;
                delete this.hunger;
                delete this.tired;
                delete this.fear;
                delete this.lonely;
                delete this.ill;
                delete this.bold;
                delete this.social;
                delete this.greed;
                delete this.curious;
                delete this.ambition;
                delete this.influence;
                delete this.nerve;
                delete this.held;
                delete this.spouse;
                delete this.spouseSer;
                delete this.friend;
                delete this.friendSer;
                delete this.foe;
                delete this.foeSer;
                delete this.mother;
                delete this.motherSer;
                delete this.father;
                delete this.fatherSer;
                delete this.sire;
                delete this.sireSer;
                delete this.serial;
                delete this.gest;
                delete this.nextThink;
            }

            public method capacity() returns int {
                return this.cap;
            }

            public method count() returns int {
                return this.live;
            }

            // Rows 0..limit() are the ones ever handed out; a sweep over the table walks these and
            // skips the dead. It never shrinks, because a hole is a recycled row and not a gap.
            public method limit() returns int {
                return this.high;
            }

            public method alive(int i) returns boolean {
                return (cast<int>(this.flags[i]) & AgentTable.F_ALIVE) != 0;
            }

            // Take a row: a recycled one if anybody has died, otherwise the next fresh one. Returns
            // -1 when the table is full, which the caller must handle rather than ignore -- a silent
            // failure here is a population that quietly stops growing.
            // Fifty-three columns, one length. Written out per type rather than per column because
            // a helper taking `T[]` and handing back a wider one is the same five lines each time,
            // and the four of them below are the whole of it.
            private static method widerI(int[] old, int cap) returns int[] {
                mutable int[] w = new int[cap]();
                for (int i in 0..old.length()) {
                    w[i] = old[i];
                }
                delete old;
                return w;
            }

            private static method widerF(float[] old, int cap) returns float[] {
                mutable float[] w = new float[cap]();
                for (int i in 0..old.length()) {
                    w[i] = old[i];
                }
                delete old;
                return w;
            }

            private static method widerS(short[] old, int cap) returns short[] {
                mutable short[] w = new short[cap]();
                for (int i in 0..old.length()) {
                    w[i] = old[i];
                }
                delete old;
                return w;
            }

            private static method widerB(byte[] old, int cap) returns byte[] {
                mutable byte[] w = new byte[cap]();
                for (int i in 0..old.length()) {
                    w[i] = old[i];
                }
                delete old;
                return w;
            }

            // ROOM FOR MORE PEOPLE. Doubling, so a world that grows steadily pays this a handful of
            // times over its whole life rather than on every birth. Seventy-two bytes a head means
            // the doubling from fifty thousand costs three and a half megabytes, and the one after
            // that seven -- against a world whose ONLY alternative was to stop having children.
            private method widen() returns void {
                int cap = this.cap * 2;
                this.freeSlot = AgentTable.widerI(this.freeSlot, cap);
                this.px = AgentTable.widerF(this.px, cap);
                this.py = AgentTable.widerF(this.py, cap);
                this.home = AgentTable.widerS(this.home, cap);
                this.job = AgentTable.widerB(this.job, cap);
                this.role = AgentTable.widerB(this.role, cap);
                this.flags = AgentTable.widerB(this.flags, cap);
                this.hx = AgentTable.widerF(this.hx, cap);
                this.hy = AgentTable.widerF(this.hy, cap);
                this.task = AgentTable.widerB(this.task, cap);
                this.taskTimer = AgentTable.widerF(this.taskTimer, cap);
                this.journey = AgentTable.widerF(this.journey, cap);
                this.targetNode = AgentTable.widerI(this.targetNode, cap);
                this.workplace = AgentTable.widerI(this.workplace, cap);
                this.bound = AgentTable.widerI(this.bound, cap);
                this.targetX = AgentTable.widerS(this.targetX, cap);
                this.targetY = AgentTable.widerS(this.targetY, cap);
                this.carryKind = AgentTable.widerB(this.carryKind, cap);
                this.carryAmt = AgentTable.widerS(this.carryAmt, cap);
                this.kit = AgentTable.widerB(this.kit, cap);
                this.toolLife = AgentTable.widerS(this.toolLife, cap);
                this.age = AgentTable.widerF(this.age, cap);
                this.lifespan = AgentTable.widerF(this.lifespan, cap);
                this.hp = AgentTable.widerB(this.hp, cap);
                this.hunger = AgentTable.widerB(this.hunger, cap);
                this.tired = AgentTable.widerB(this.tired, cap);
                this.fear = AgentTable.widerB(this.fear, cap);
                this.lonely = AgentTable.widerB(this.lonely, cap);
                this.ill = AgentTable.widerB(this.ill, cap);
                this.bold = AgentTable.widerB(this.bold, cap);
                this.social = AgentTable.widerB(this.social, cap);
                this.greed = AgentTable.widerB(this.greed, cap);
                this.curious = AgentTable.widerB(this.curious, cap);
                this.ambition = AgentTable.widerB(this.ambition, cap);
                this.influence = AgentTable.widerB(this.influence, cap);
                this.nerve = AgentTable.widerB(this.nerve, cap);
                this.held = AgentTable.widerB(this.held, cap);
                this.serial = AgentTable.widerI(this.serial, cap);
                this.spouse = AgentTable.widerI(this.spouse, cap);
                this.spouseSer = AgentTable.widerI(this.spouseSer, cap);
                this.friend = AgentTable.widerI(this.friend, cap);
                this.friendSer = AgentTable.widerI(this.friendSer, cap);
                this.foe = AgentTable.widerI(this.foe, cap);
                this.foeSer = AgentTable.widerI(this.foeSer, cap);
                this.mother = AgentTable.widerI(this.mother, cap);
                this.motherSer = AgentTable.widerI(this.motherSer, cap);
                this.father = AgentTable.widerI(this.father, cap);
                this.fatherSer = AgentTable.widerI(this.fatherSer, cap);
                this.sire = AgentTable.widerI(this.sire, cap);
                this.sireSer = AgentTable.widerI(this.sireSer, cap);
                this.gest = AgentTable.widerF(this.gest, cap);
                this.nextThink = AgentTable.widerI(this.nextThink, cap);
                this.cap = cap;
                this.widenings = this.widenings + 1;
                return;
            }

            // How many times the table has had to grow. Zero for the whole life of the project,
            // because it could not.
            public method widenings() returns int {
                return this.widenings;
            }

            public method spawn(float x, float y, int community) returns int {
                mutable int i = 0 - 1;
                if (this.freeTop > 0) {
                    this.freeTop = this.freeTop - 1;
                    i = this.freeSlot[this.freeTop];
                } else {
                    if (this.high >= this.cap) {
                        // THE TABLE IS NOT A POPULATION CAP. It was being used as one, and nobody
                        // meant it to be: the world is built with `new AgentTable(50000)` and then
                        // seeded with exactly fifty thousand people, so it is a hundred per cent
                        // full on the first tick and stays there. From that moment every birth
                        // needed a death first, silently -- `spawn` returned -1 and the child was
                        // simply never born. A world that cannot grow cannot found anything: a
                        // village never has people to spare, so it never hives off, while joining
                        // up carries on regardless. Twelve runs out of twelve consolidated down to
                        // a handful of huge settlements and then died. This was the reason.
                        this.widen();
                    }
                    i = this.high;
                    this.high = this.high + 1;
                }
                this.px[i] = x;
                this.py[i] = y;
                this.home[i] = cast<short>(community);
                this.job[i] = cast<byte>(cast<int>(Job.Idle));
                this.role[i] = cast<byte>(cast<int>(Role.None));
                this.flags[i] = cast<byte>(AgentTable.F_ALIVE);
                this.hx[i] = 0.0;
                this.hy[i] = 1.0;
                this.task[i] = cast<byte>(cast<int>(Act.Idle));
                this.taskTimer[i] = 0.0;
                this.targetNode[i] = 0 - 1;
                this.workplace[i] = 0 - 1;
                this.bound[i] = 0 - 1;
                this.targetX[i] = cast<short>(0);
                this.targetY[i] = cast<short>(0);
                this.carryKind[i] = cast<byte>(0);
                this.carryAmt[i] = cast<short>(0);
                // Nobody is born with anything. A recycled row must not hand a newborn the axe the
                // last occupant of it died holding -- the same reason a community slot is cleared.
                this.kit[i] = cast<byte>(0);
                this.toolLife[i] = cast<short>(0);
                this.age[i] = 0.0;
                this.lifespan[i] = 360.0;
                this.hp[i] = cast<byte>(100);
                this.hunger[i] = cast<byte>(0);
                this.tired[i] = cast<byte>(0);
                this.fear[i] = cast<byte>(0);
                this.lonely[i] = cast<byte>(0);
                this.ill[i] = cast<byte>(0);
                this.influence[i] = cast<byte>(0);
                // Nobody is born knowing they can get away with it. A recycled row must not hand a
                // newborn the last occupant's history any more than it hands them their axe.
                this.nerve[i] = cast<byte>(0);
                this.held[i] = cast<byte>(0);
                // A NAME OF ONE'S OWN, handed out once and never reused. Every kin link in this
                // world is checked against it, so a recycled row cannot inherit somebody else's
                // children.
                this.serial[i] = this.nextSerial;
                this.nextSerial = this.nextSerial + 1;
                this.sire[i] = 0 - 1;
                this.sireSer[i] = 0;
                this.motherSer[i] = 0;
                this.fatherSer[i] = 0;
                this.spouse[i] = 0 - 1;
                this.spouseSer[i] = 0;
                this.friend[i] = 0 - 1;
                this.friendSer[i] = 0;
                this.foe[i] = 0 - 1;
                this.foeSer[i] = 0;
                this.mother[i] = 0 - 1;
                this.father[i] = 0 - 1;
                this.gest[i] = 0.0;
                this.nextThink[i] = 0;
                this.live = this.live + 1;
                return i;
            }

            // Give the row back. The slot is reused by the next birth, which at a hundred and forty
            // deaths a second is the whole reason there is a free list at all.
            public method kill(int i) returns void {
                if (!this.alive(i)) {
                    return;
                }
                this.flags[i] = cast<byte>(0);
                this.freeSlot[this.freeTop] = i;
                this.freeTop = this.freeTop + 1;
                this.live = this.live - 1;
                return;
            }

            // ---- what it is ----

            public method setTemperament(int i, int boldness, int sociability, int greediness,
                                         int curiosity, int drive) returns void
                requires boldness >= 0
                requires boldness <= 100
                requires sociability >= 0
                requires sociability <= 100
                requires greediness >= 0
                requires greediness <= 100
                requires curiosity >= 0
                requires curiosity <= 100
                requires drive >= 0
                requires drive <= 100
            {
                this.bold[i] = cast<byte>(boldness);
                this.social[i] = cast<byte>(sociability);
                this.greed[i] = cast<byte>(greediness);
                this.curious[i] = cast<byte>(curiosity);
                this.ambition[i] = cast<byte>(drive);
                return;
            }

            public method boldnessOf(int i) returns int {
                return cast<int>(this.bold[i]) & 255;
            }

            public method sociabilityOf(int i) returns int {
                return cast<int>(this.social[i]) & 255;
            }

            public method greedOf(int i) returns int {
                return cast<int>(this.greed[i]) & 255;
            }

            public method curiosityOf(int i) returns int {
                return cast<int>(this.curious[i]) & 255;
            }

            public method ambitionOf(int i) returns int {
                return cast<int>(this.ambition[i]) & 255;
            }

            public method setLife(int i, float years, boolean female, boolean adult) returns void {
                this.lifespan[i] = years;
                mutable int f = AgentTable.F_ALIVE;
                if (female) {
                    f = f | AgentTable.F_FEMALE;
                }
                if (adult) {
                    f = f | AgentTable.F_ADULT;
                }
                this.flags[i] = cast<byte>(f);
                return;
            }

            public method setJob(int i, int j) returns void
                requires j >= 0
                requires j < Job.count()
            {
                this.job[i] = cast<byte>(j);
                return;
            }

            public method jobOf(int i) returns int {
                return cast<int>(this.job[i]) & 255;
            }

            // What this person is worth listening to. Nobody is born with any: everyone starts at
            // zero and earns it by what they DO, which is the whole difference between a leader who
            // emerges and one who was assigned. It saturates at 255 on purpose -- there is a ceiling
            // on renown, past which the difference between two great figures stops mattering to
            // anybody deciding whom to follow.
            // How many times this person has taken something and walked away with it, capped so a
            // lifelong thief is bold rather than unstoppable.
            // BEING TAKEN IS A STATE, NOT AN INSTANT.
            //
            // A captive used to be a population transfer and nothing else: marched off one census, a
            // full citizen of the town that took them the next. That is not what being taken is. A
            // prisoner works, because that is what they were taken FOR, and is nobody's neighbour
            // until enough time has passed -- so while this counts down they do not start a family
            // and nobody listens to them. It reaches nought on its own and then they are simply
            // somebody who lives there, which is also what happened.
            public method captive(int i, int censuses) returns void {
                if (i < 0 || i >= this.cap) {
                    return;
                }
                mutable int n = censuses;
                if (n < 0) {
                    n = 0;
                }
                if (n > 255) {
                    n = 255;
                }
                this.held[i] = cast<byte>(n);
                return;
            }

            public method heldOf(int i) returns int {
                if (i < 0 || i >= this.cap) {
                    return 0;
                }
                return cast<int>(this.held[i]) & 255;
            }

            public method isCaptive(int i) returns boolean {
                return this.heldOf(i) > 0;
            }

            // One census of it served. Returns true on the census they stop being a prisoner, so a
            // caller can count the moment rather than the state.
            public method serve(int i) returns boolean {
                int was = this.heldOf(i);
                if (was <= 0) {
                    return false;
                }
                this.held[i] = cast<byte>(was - 1);
                return was == 1;
            }

            // Let them go, whatever is left of it -- what happens when their own people take the
            // town back off whoever holds them.
            public method release(int i) returns void {
                if (i < 0 || i >= this.cap) {
                    return;
                }
                this.held[i] = cast<byte>(0);
                return;
            }

            public method nerveOf(int i) returns int {
                return cast<int>(this.nerve[i]) & 255;
            }

            public method emboldened(int i) returns void {
                int was = this.nerveOf(i);
                if (was < 5) {
                    this.nerve[i] = cast<byte>(was + 1);
                }
                return;
            }

            // A fright undoes it all at once. Being caught is not a small correction to a habit;
            // it is the reason people stop.
            public method frightened(int i) returns void {
                this.nerve[i] = cast<byte>(0);
                this.held[i] = cast<byte>(0);
                return;
            }

            public method influenceOf(int i) returns int {
                return cast<int>(this.influence[i]) & 255;
            }

            public method earn(int i, int n) returns void {
                mutable int v = this.influenceOf(i) + n;
                if (v > 255) {
                    v = 255;
                }
                if (v < 0) {
                    v = 0;
                }
                this.influence[i] = cast<byte>(v);
                return;
            }

            public method roleOf(int i) returns int {
                return cast<int>(this.role[i]) & 255;
            }

            public method setRole(int i, int r) returns void
                requires r >= 0
                requires r < Role.count()
            {
                this.role[i] = cast<byte>(r);
                return;
            }

            public method workplaceOf(int i) returns int {
                return this.workplace[i];
            }

            // Which settlement this person's load is bound for, or -1.
            public method boundFor(int i) returns int {
                return this.bound[i];
            }

            public method setBound(int i, int c) returns void {
                this.bound[i] = c;
                return;
            }

            public method setWorkplace(int i, int b) returns void {
                this.workplace[i] = b;
                return;
            }

            public method targetNodeOf(int i) returns int {
                return this.targetNode[i];
            }

            public method setTargetNode(int i, int node) returns void {
                this.targetNode[i] = node;
                return;
            }

            // ---- what a person owns ----

            public static fixed int K_TOOL = 1;
            public static fixed int K_WEAPON = 2;
            public static fixed int K_ARMOUR = 4;

            public method hasKit(int i, int what) returns boolean {
                return (cast<int>(this.kit[i]) & what) != 0;
            }

            public method kitOf(int i) returns int {
                return cast<int>(this.kit[i]) & 255;
            }

            // Take up a tool, a weapon or a coat of mail. A tool arrives with a working life in it;
            // the other two do not wear out, they are lost with the person.
            public method equip(int i, int what, int life) returns void
                requires life >= 0
            {
                this.kit[i] = cast<byte>((cast<int>(this.kit[i]) & 255) | what);
                if (what == AgentTable.K_TOOL) {
                    this.toolLife[i] = cast<short>(life);
                }
                return;
            }

            public method toolLifeOf(int i) returns int {
                return cast<int>(this.toolLife[i]);
            }

            // One more piece of work done with it. Returns true on the stroke that finishes it, so
            // the caller can count what the world wore out exactly once.
            public method wearTool(int i) returns boolean {
                if ((cast<int>(this.kit[i]) & AgentTable.K_TOOL) == 0) {
                    return false;
                }
                int left = cast<int>(this.toolLife[i]) - 1;
                if (left > 0) {
                    this.toolLife[i] = cast<short>(left);
                    return false;
                }
                this.toolLife[i] = cast<short>(0);
                this.kit[i] = cast<byte>(cast<int>(this.kit[i]) & 255 & ~AgentTable.K_TOOL);
                return true;
            }

            public method carryAmtOf(int i) returns int {
                return cast<int>(this.carryAmt[i]);
            }

            public method carryKindOf(int i) returns int {
                return cast<int>(this.carryKind[i]) & 255;
            }

            // One load at a time, and `kind` is a GOOD -- what a person carries is Wood or Salt, not
            // the oak or the deposit it came off. Somebody hauling wood cannot also be hauling stone,
            // which is the whole reason a trip home exists and therefore the whole reason distance
            // costs anything.
            public method setCarry(int i, int kind, int amount) returns void
                requires amount >= 0
                requires amount <= 32767
            {
                this.carryKind[i] = cast<byte>(kind);
                this.carryAmt[i] = cast<short>(amount);
                return;
            }

            public method xAt(int i) returns float {
                return this.px[i];
            }

            public method yAt(int i) returns float {
                return this.py[i];
            }

            public method homeOf(int i) returns int {
                return cast<int>(this.home[i]) & 65535;
            }

            // Change where somebody belongs. Everything they were doing belonged to the old place --
            // the workshop bench, the tree they were walking to, the trade they were counted in --
            // so all of it is dropped here rather than left to be noticed later as a craftsman of
            // one village standing in the forge of another.
            public method setHome(int i, int community) returns void {
                this.home[i] = cast<short>(community);
                this.job[i] = cast<byte>(cast<int>(Job.Idle));
                this.task[i] = cast<byte>(cast<int>(Act.Idle));
                this.taskTimer[i] = 0.0;
                this.targetNode[i] = 0 - 1;
                this.workplace[i] = 0 - 1;
                this.role[i] = cast<byte>(cast<int>(Role.None));
                return;
            }

            public method ageOf(int i) returns float {
                return this.age[i];
            }

            public method addAge(int i, float dt) returns void {
                this.age[i] = this.age[i] + dt;
                return;
            }

            public method lifespanOf(int i) returns float {
                return this.lifespan[i];
            }

            // Which body draws this agent. Only four exist and they are deliberately generic: a
            // woodcutter and a miner are both a Civil, exactly as the original had one worker body
            // for every economic trade. A role outranks a job, because a chief reads as a chief.
            public method bodyOf(int i) returns int {
                if (this.roleOf(i) != cast<int>(Role.None)) {
                    return cast<int>(Body.Protagonist);
                }
                int j = this.jobOf(i);
                if (j == cast<int>(Job.Raider) || j == cast<int>(Job.General)) {
                    return cast<int>(Body.Soldier);
                }
                if (j == cast<int>(Job.Prospector)) {
                    return cast<int>(Body.Scout);   // the one trade that goes out looking
                }
                return cast<int>(Body.Civil);
            }

            // ---- what it is doing ----

            public method actOf(int i) returns int {
                return cast<int>(this.task[i]) & 255;
            }

            public method setAct(int i, int a) returns void
                requires a >= 0
                requires a < Act.count()
            {
                // Tallied HERE, where every act in the world passes through, and only when the verb
                // actually changes -- somebody re-told to keep walking has not started walking
                // again. It exists because twelve of the twenty-two verbs in the enum turned out to
                // be ones nothing anywhere ever set, for a whole wave, with every test green: the
                // simulation did the thing and the world could never show it. A counter per verb is
                // the cheapest way for that to be a question anybody can ask.
                if (cast<int>(this.task[i]) != a) {
                    this.tally[a] = this.tally[a] + cast<long>(1);
                }
                this.task[i] = cast<byte>(a);
                this.taskTimer[i] = 0.0;
                return;
            }

            // How many times anybody has ever begun this act since the world was made.
            public method timesDone(int a) returns long {
                if (a < 0 || a >= Act.count()) {
                    return cast<long>(0);
                }
                return this.tally[a];
            }

            public method timerOf(int i) returns float {
                return this.taskTimer[i];
            }

            public method addTimer(int i, float dt) returns void {
                this.taskTimer[i] = this.taskTimer[i] + dt;
                return;
            }

            public method setJourney(int i, float d) returns void {
                this.journey[i] = d;
                return;
            }

            public method journeyOf(int i) returns float {
                return this.journey[i];
            }

            public method setTarget(int i, int tx, int ty) returns void {
                this.targetX[i] = cast<short>(tx);
                this.targetY[i] = cast<short>(ty);
                return;
            }

            public method targetXOf(int i) returns int {
                return cast<int>(this.targetX[i]);
            }

            public method targetYOf(int i) returns int {
                return cast<int>(this.targetY[i]);
            }

            public method setPos(int i, float x, float y) returns void {
                this.px[i] = x;
                this.py[i] = y;
                return;
            }

            // Face this way. The vector must already be of unit length -- the walk step has one in
            // hand for free, since it divided by the distance to move at all, and asking for it
            // normalised here would put a square root in the hottest loop in the simulation to
            // recompute a number the caller just threw away. A zero vector -- somebody who did not
            // move this tick -- leaves the old heading alone, which is what keeps a person who
            // stops to work from snapping round to face north.
            public method setFacing(int i, float ux, float uy) returns void {
                if (ux == 0.0 && uy == 0.0) {
                    return;
                }
                this.hx[i] = ux;
                this.hy[i] = uy;
                return;
            }

            public method headXOf(int i) returns float {
                return this.hx[i];
            }

            public method headYOf(int i) returns float {
                return this.hy[i];
            }

            public method thinkAtOf(int i) returns int {
                return this.nextThink[i];
            }

            public method setThinkAt(int i, int t) returns void {
                this.nextThink[i] = t;
                return;
            }

            // ---- needs, which rise on their own ----

            public method hungerOf(int i) returns int {
                return cast<int>(this.hunger[i]) & 255;
            }

            // How ill somebody is, on the same scale hunger uses: nought is well, and it climbs.
            public method illOf(int i) returns int {
                return cast<int>(this.ill[i]) & 255;
            }

            public method setIll(int i, int v) returns void {
                mutable int c = v;
                if (c < 0) {
                    c = 0;
                }
                if (c > 255) {
                    c = 255;
                }
                this.ill[i] = cast<byte>(c);
                return;
            }

            public method setHunger(int i, int v) returns void {
                mutable int c = v;
                if (c < 0) {
                    c = 0;
                }
                if (c > 100) {
                    c = 100;
                }
                this.hunger[i] = cast<byte>(c);
                return;
            }

            public method tiredOf(int i) returns int {
                return cast<int>(this.tired[i]) & 255;
            }

            public method setTired(int i, int v) returns void {
                mutable int c = v;
                if (c < 0) {
                    c = 0;
                }
                if (c > 100) {
                    c = 100;
                }
                this.tired[i] = cast<byte>(c);
                return;
            }

            public method hpOf(int i) returns int {
                return cast<int>(this.hp[i]) & 255;
            }

            // Take a blow. Returns true if it was the last one, so the caller can count the death
            // as its own kind -- of old age, of hunger, and now of somebody else. The three are
            // reported apart because a world where the third is zero has no history in it.
            public method wound(int i, int n) returns boolean {
                int left = this.hpOf(i) - n;
                if (left <= 0) {
                    this.hp[i] = cast<byte>(0);
                    this.kill(i);
                    return true;
                }
                this.hp[i] = cast<byte>(left);
                return false;
            }

            // ---- life ----

            public method isFemale(int i) returns boolean {
                return (cast<int>(this.flags[i]) & AgentTable.F_FEMALE) != 0;
            }

            public method isAdult(int i) returns boolean {
                return (cast<int>(this.flags[i]) & AgentTable.F_ADULT) != 0;
            }

            public method makeAdult(int i) returns void {
                this.flags[i] = cast<byte>(cast<int>(this.flags[i]) | AgentTable.F_ADULT);
                return;
            }

            public method isPregnant(int i) returns boolean {
                return this.gest[i] > 0.0;
            }

            public method conceive(int i, float term) returns void
                requires term > 0.0
            {
                this.gest[i] = term;
                this.flags[i] = cast<byte>(cast<int>(this.flags[i]) | AgentTable.F_PREGNANT);
                return;
            }

            // Count the pregnancy down; true on the tick the child is due.
            public method gestate(int i, float dt) returns boolean {
                if (this.gest[i] <= 0.0) {
                    return false;
                }
                this.gest[i] = this.gest[i] - dt;
                if (this.gest[i] > 0.0) {
                    return false;
                }
                this.gest[i] = 0.0;
                this.flags[i] = cast<byte>(cast<int>(this.flags[i]) & ~AgentTable.F_PREGNANT);
                return true;
            }

            public method motherOf(int i) returns int {
                return this.mother[i];
            }

            // The name nobody else will ever have.
            public method serialOf(int i) returns int {
                return this.serial[i];
            }

            // A KIN LINK THAT IS STILL TRUE, or -1.
            //
            // The row and the serial have to agree: an index on its own says "somebody is standing
            // where my mother stood", which after a death and a birth is a different person
            // entirely. Every consumer of kinship in this world goes through these two.
            // TWO PEOPLE, AND NOT A TOWN.
            //
            // `spouse` has been in this table since the first slice: allocated, cleared at every
            // birth, and never once written or read. Nothing in the world was ever between two named
            // people -- every social fact was a fact about a village -- and the cost of that showed
            // up in the one place it could not hide: fatherhood. The census picked the single
            // most-regarded man in a town and made him the father of every child conceived there, so
            // everybody born in a village was everybody else's half-sibling, and "brother" -- which
            // the succession now leans on -- meant nothing more than "born here, about the same
            // time". A dynasty cannot descend through a world where everyone is kin.
            public method wed(int i, int j) returns void {
                if (i < 0 || j < 0 || i >= this.cap || j >= this.cap || i == j) {
                    return;
                }
                this.spouse[i] = j;
                this.spouseSer[i] = this.serial[j];
                this.spouse[j] = i;
                this.spouseSer[j] = this.serial[i];
                return;
            }

            // The partner, if they are still alive and still the same person. Same guard as a
            // parent: a row is not an identity, a row and a serial together are.
            public method spouseLive(int i) returns int {
                if (i < 0 || i >= this.cap) {
                    return 0 - 1;
                }
                int s = this.spouse[i];
                if (s < 0 || s >= this.cap || !this.alive(s)) {
                    return 0 - 1;
                }
                if (this.serial[s] != this.spouseSer[i]) {
                    return 0 - 1;
                }
                return s;
            }

            // A DEBT AND A GRUDGE, each pointing at one person.
            //
            // Written only by events that already name two people, and read the same way a parent
            // is: a row plus a serial, so a slot cannot quietly transfer to whoever inherits the
            // row. Setting one overwrites the last -- somebody has one person they owe and one
            // they blame, and the newest wins, which is roughly how a memory that size works.
            public method befriend(int i, int j) returns void {
                if (i < 0 || j < 0 || i >= this.cap || j >= this.cap || i == j) {
                    return;
                }
                this.friend[i] = j;
                this.friendSer[i] = this.serial[j];
                return;
            }

            public method antagonise(int i, int j) returns void {
                if (i < 0 || j < 0 || i >= this.cap || j >= this.cap || i == j) {
                    return;
                }
                this.foe[i] = j;
                this.foeSer[i] = this.serial[j];
                return;
            }

            public method friendLive(int i) returns int {
                if (i < 0 || i >= this.cap) {
                    return 0 - 1;
                }
                int f = this.friend[i];
                if (f < 0 || f >= this.cap || !this.alive(f)) {
                    return 0 - 1;
                }
                if (this.serial[f] != this.friendSer[i]) {
                    return 0 - 1;
                }
                return f;
            }

            public method foeLive(int i) returns int {
                if (i < 0 || i >= this.cap) {
                    return 0 - 1;
                }
                int f = this.foe[i];
                if (f < 0 || f >= this.cap || !this.alive(f)) {
                    return 0 - 1;
                }
                if (this.serial[f] != this.foeSer[i]) {
                    return 0 - 1;
                }
                return f;
            }

            public method motherLive(int i) returns int {
                int m = this.mother[i];
                if (m < 0 || m >= this.cap || !this.alive(m)) {
                    return 0 - 1;
                }
                if (this.serial[m] != this.motherSer[i]) {
                    return 0 - 1;
                }
                return m;
            }

            public method fatherLive(int i) returns int {
                int f = this.father[i];
                if (f < 0 || f >= this.cap || !this.alive(f)) {
                    return 0 - 1;
                }
                if (this.serial[f] != this.fatherSer[i]) {
                    return 0 - 1;
                }
                return f;
            }

            // Is `who` a living parent of `i`? The one question the world actually asks.
            public method isChildOf(int i, int who) returns boolean {
                if (who < 0) {
                    return false;
                }
                return this.motherLive(i) == who || this.fatherLive(i) == who;
            }

            // SIBLINGS, which cost nothing to know once parents are real.
            //
            // Two people are of one blood if they share a living parent -- and the SERIALS are what
            // make that safe, because two children of two long-dead mothers whose rows have both
            // been handed to the same newborn would otherwise read as brother and sister.
            //
            // Asked of a dead parent too: a crown descends from a man precisely when he is no
            // longer there, so the link is checked on the stored serial rather than on whether the
            // row still holds him.
            public method isSiblingOf(int a, int b) returns boolean {
                if (a == b || a < 0 || b < 0 || a >= this.cap || b >= this.cap) {
                    return false;
                }
                if (this.motherSer[a] != 0 && this.motherSer[a] == this.motherSer[b]) {
                    return true;
                }
                return this.fatherSer[a] != 0 && this.fatherSer[a] == this.fatherSer[b];
            }

            // Whose child a pregnancy is, set where it starts and read where it ends. A woman
            // carries this for the whole term, so a father who dies before the birth is still the
            // father -- the serial says so and the row does not have to.
            public method setSire(int i, int who) returns void {
                this.sire[i] = who;
                if (who >= 0 && who < this.cap) {
                    this.sireSer[i] = this.serial[who];
                } else {
                    this.sireSer[i] = 0;
                }
                return;
            }

            // A child of this mother: born where she stands, into her community, carrying her
            // temperament with a little drift -- which is the only way culture has of getting from
            // one generation to the next when nobody lives longer than six minutes.
            public method bear(int mum, int worldSeed, int n) returns int {
                int i = this.spawn(this.px[mum], this.py[mum], this.homeOf(mum));
                if (i < 0) {
                    return 0 - 1;
                }
                int s = worldSeed ^ 0x4B1E;
                this.setTemperament(i,
                                    this.drift(this.boldnessOf(mum), s, n, 1),
                                    this.drift(this.sociabilityOf(mum), s, n, 2),
                                    this.drift(this.greedOf(mum), s, n, 3),
                                    this.drift(this.curiosityOf(mum), s, n, 4),
                                    this.drift(this.ambitionOf(mum), s, n, 5));
                float lv = LandMath.hash01(s, n * 7 + 6, 17);
                boolean female = LandMath.hash01(s, n * 7 + 7, 19) < 0.5;
                this.setLife(i, 300.0 + lv * 120.0, female, false);
                this.age[i] = 0.0;
                this.mother[i] = mum;
                this.motherSer[i] = this.serial[mum];
                // And a father, which this world has never recorded. Half of everybody's kin was
                // missing: the field existed, was set to -1 at birth, and nothing ever wrote it.
                this.father[i] = this.sire[mum];
                this.fatherSer[i] = this.sireSer[mum];
                this.sire[mum] = 0 - 1;
                this.sireSer[mum] = 0;
                return i;
            }

            // A child is its mother, drifted, and then STEEPED in the place it was born. That last
            // step is the whole feedback loop: a village that hunts raises children a little bolder
            // than their mothers were, who hunt a little more, and hand it on again. The pull is a
            // fraction, not a replacement -- a person is mostly their parent, and the place shows
            // over generations rather than in any one child.
            public method steepIn(int i, int bold, int social, int greed, int curious, int ambition,
                                  int pull) returns void {
                this.bold[i] = cast<byte>(this.blend(this.boldnessOf(i), bold, pull));
                this.social[i] = cast<byte>(this.blend(this.sociabilityOf(i), social, pull));
                this.greed[i] = cast<byte>(this.blend(this.greedOf(i), greed, pull));
                this.curious[i] = cast<byte>(this.blend(this.curiosityOf(i), curious, pull));
                this.ambition[i] = cast<byte>(this.blend(this.ambitionOf(i), ambition, pull));
                return;
            }

            private method blend(int own, int place, int pull) returns int {
                mutable int v = own + (place - own) * pull / 100;
                if (v < 0) {
                    v = 0;
                }
                if (v > 100) {
                    v = 100;
                }
                return v;
            }

            // Inherit, but not exactly: without the drift every community converges on one person
            // repeated, and there is nothing left for selection or culture to act on.
            private method drift(int base, int s, int n, int k) returns int {
                mutable int v = base + cast<int>((LandMath.hash01(s, n * 11 + k, 31) - 0.5) * 30.0);
                if (v < 0) {
                    v = 0;
                }
                if (v > 100) {
                    v = 100;
                }
                return v;
            }

            // ---- seeding a starting world ----

            // Scatter `total` people over `communities` sites.
            //
            // Sites used to be the first walkable points on a lattice that were far enough apart, and
            // that turned out to be the single most expensive decision in the simulation: people were
            // founded on any ground at all, so a village could sit on a steppe with no tree within a
            // third of a lifetime's walk, and the woodcutter measurement came out saying the WORLD was
            // too big when what was too big was the distance I had put between people and their work.
            //
            // Nobody founds a village where there is nothing. Candidates are scored by how much
            // woodland lies within reach, and the richest ones win -- which is a founding rule, not a
            // convenience: it is the first thing the community layer will need anyway.
            public method seedWorld(Grid* g, int total, int communities, int worldSeed) returns int {
                int w = g.width();
                int h = g.height();
                int[] cx = new int[communities]();
                int[] cy = new int[communities]();
                mutable int found = 0;
                int minGap = 90;
                NodeField* nf = g.surface();
                // Every walkable lattice point, with the wood within three blocks of it.
                int maxCand = ((w / 20) + 1) * ((h / 24) + 1);
                int[] candX = new int[maxCand]();
                int[] candY = new int[maxCand]();
                int[] candScore = new int[maxCand]();
                mutable int nc = 0;
                mutable int y = 40;
                while (y < h - 40) {
                    mutable int x = 40;
                    while (x < w - 40) {
                        int b = g.biomeAt(x, y);
                        if (Biomes.walkable(b) && g.elevAt(x, y) < 6300) {
                            int bx = x / 16;
                            int by = y / 16;
                            // Weighted by what a village needs in the order it needs it. Food comes
                            // first because it is the only need that kills, and a fishing spot is
                            // worth a dozen berry bushes because it holds nine hundred units against
                            // their forty. Wood next, because everything is built out of it; stone
                            // last, because a place can live a long time without it.
                            mutable int score = 0;
                            mutable int oy = 0 - 3;
                            while (oy <= 3) {
                                mutable int ox = 0 - 3;
                                while (ox <= 3) {
                                    score = score
                                          + 4 * nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Forage))
                                          + 12 * nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Fishing))
                                          + 2 * nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Timber))
                                          + nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Quarry));
                                    ox = ox + 1;
                                }
                                oy = oy + 1;
                            }
                            candX[nc] = x;
                            candY[nc] = y;
                            candScore[nc] = score;
                            nc = nc + 1;
                        }
                        x = x + 20;
                    }
                    y = y + 24;
                }
                // Take the richest site that is far enough from the ones already taken, and repeat.
                // Greedy and not optimal, but a founding is greedy: people settle the best place they
                // can see, they do not solve a packing problem across a continent.
                while (found < communities) {
                    mutable int best = 0 - 1;
                    mutable int bestScore = 0 - 1;
                    mutable int j = 0;
                    while (j < nc) {
                        if (candScore[j] > bestScore) {
                            mutable boolean ok = true;
                            mutable int k = 0;
                            while (k < found) {
                                int dx = cx[k] - candX[j];
                                int dy = cy[k] - candY[j];
                                if (dx * dx + dy * dy < minGap * minGap) {
                                    ok = false;
                                    k = found;
                                }
                                k = k + 1;
                            }
                            if (ok) {
                                best = j;
                                bestScore = candScore[j];
                            }
                        }
                        j = j + 1;
                    }
                    if (best < 0) {
                        break;                       // no room left on this world for another village
                    }
                    cx[found] = candX[best];
                    cy[found] = candY[best];
                    candScore[best] = 0 - 1;         // taken
                    found = found + 1;
                }
                delete candX;
                delete candY;
                delete candScore;
                if (found == 0) {
                    delete cx;
                    delete cy;
                    return 0;
                }
                int per = total / found;
                mutable int made = 0;
                mutable int c = 0;
                while (c < found) {
                    mutable int n = 0;
                    mutable int tries = 0;
                    // A community is a disk: people live and work within a short walk of home, which
                    // is what keeps travel affordable on a map thirty-two times the original's.
                    int radius = 26;
                    while (n < per && tries < per * 12) {
                        tries = tries + 1;
                        float a = LandMath.hash01(worldSeed ^ 0x5A1D, c * 977 + tries, 7) * 6.2831853;
                        float rr = LandMath.hash01(worldSeed ^ 0x2B77, c * 613 + tries, 11);
                        float dist = LandMath.sqrt(rr) * cast<float>(radius);
                        int ax = cx[c] + cast<int>(LandMath.cos(a) * dist);
                        int ay = cy[c] + cast<int>(LandMath.sin(a) * dist);
                        if (ax < 1 || ay < 1 || ax >= w - 1 || ay >= h - 1) {
                            continue;
                        }
                        if (!Biomes.walkable(g.biomeAt(ax, ay))) {
                            continue;
                        }
                        int i = this.spawn(cast<float>(ax) + 0.5, cast<float>(ay) + 0.5, c);
                        if (i < 0) {
                            n = per;
                            c = found;
                            continue;
                        }
                        this.seedOne(i, worldSeed, made);
                        n = n + 1;
                        made = made + 1;
                    }
                    c = c + 1;
                }
                delete cx;
                delete cy;
                return made;
            }

            // One person: a temperament of their own, a life of their own length, and a trade.
            // Everything here is a draw from the world seed, so the same seed makes the same people.
            private method seedOne(int i, int worldSeed, int n) returns void {
                int s = worldSeed ^ 0x1A2B;
                this.setTemperament(i,
                                    cast<int>(LandMath.hash01(s, n * 7 + 1, 3) * 100.0),
                                    cast<int>(LandMath.hash01(s, n * 7 + 2, 5) * 100.0),
                                    cast<int>(LandMath.hash01(s, n * 7 + 3, 7) * 100.0),
                                    cast<int>(LandMath.hash01(s, n * 7 + 4, 11) * 100.0),
                                    cast<int>(LandMath.hash01(s, n * 7 + 5, 13) * 100.0));
                float lv = LandMath.hash01(s, n * 7 + 6, 17);
                boolean female = LandMath.hash01(s, n * 7 + 7, 19) < 0.5;
                this.setLife(i, 300.0 + lv * 120.0, female, true);
                // Ages are spread across a whole lifetime at world start, so the first generation
                // does not die all at once -- a founding population that was born on the same tick
                // would empty the map in one breath six minutes in.
                this.age[i] = LandMath.hash01(s, n * 7 + 8, 23) * this.lifespan[i];
                float turn = LandMath.hash01(s, n * 7 + 9, 29) * 6.2831853;
                this.hx[i] = LandMath.sin(turn);
                this.hy[i] = LandMath.cos(turn);
                return;
            }

            public method report() returns void {
                int bytes = 72;
                System.IO.Console.println($"agents: {this.live} alive of {this.cap} rows, {this.live * bytes / 1048576} MB of table");
                return;
            }
        }
    }
}
