import System.IO.Console;
import Agents.People.Population;
import Agents.People.AgentId;
import Agents.World.Grid;
import Agents.World.Biome;
import Agents.World.Biomes;
import Agents.World.Rng;
import Agents.Sim.Chronicle;
program AgentsExe;

// THE FIRST PEOPLE, PUT SOMEWHERE THEY COULD ACTUALLY STAND.
//
// ONE BAND AND NOT A SCATTER, and that is the model rather than a convenience. A person alone on a
// continent is not a beginning -- the band is the unit that feeds itself, and everything S2 goes on
// to build (kinship, the hunt, the share-out of what is gathered) is between people who are near
// each other. So they arrive together, in one place, standing where a person can stand.
//
// GROUND A PERSON CAN STAND ON, asked of the ground rather than assumed. A band sown into the sea
// or onto the ice cap is a band that dies before its first tick for a reason that has nothing to do
// with the model -- which is exactly the class of defect the fauna's own seeding met and fixed by
// asking the biome instead of trusting a coordinate.
//
// FOUND BY A STRIDED SWEEP AND NOT BY DARTS. Throwing random points at the map until one lands
// somewhere good is what the fauna did first, and on a world where the right ground is rare it
// throws four thousand darts and finds five places. A sweep that visits one cell per block covers
// the map once, in order, and cannot miss a region for being unlucky.
public bundle Agents {
    public namespace People {

        public class Banding {
            // How many people a first band is. Small enough to read as a band on screen, big enough
            // to have both sexes, a spread of ages and somebody to lose.
            public static fixed int A_BAND = 24;
            // How far apart they stand when they are sown, in cells.
            public static fixed float SPREAD = 3.0;
            // One sample per this many cells when sweeping for ground. A block is sixteen cells, so
            // this looks at each block about once.
            public static fixed int SWEEP = 16;
            // How far out the neighbours are checked, in cells: far enough that a spit or a one-cell
            // island fails, near enough that the band is still on the ground it was tested for.
            public static fixed int ELBOW = 6;
            // How far apart bands are sown when the whole world is seeded, in cells. Sixty-four is
            // four blocks: near enough that a continent gets several bands and they may meet, far
            // enough that each begins as its own band rather than as part of one long smear.
            public static fixed int APART = 64;
            // How much of a shortest life the sown ages are spread over. Not the whole of it: a band
            // founded with somebody already at their last year is a band that starts by burying.
            public static fixed float SPREAD_OF_AGES = 0.8;

            // A BAND EVERYWHERE THE GROUND WILL HOLD ONE, and not one band in the first place the
            // sweep happens to find.
            //
            // WHY THE WHOLE WORLD. One band is one experiment, and where it lands decides the
            // answer: the first sweep put it on TUNDRA, at the top edge of the map, because that is
            // where a scan from the north-west corner first meets firm ground -- and a band on
            // tundra tells you about tundra. Sown everywhere, the world runs every start at once:
            // the ones on good ground, the ones on ice, the ones on an island with nothing on it.
            // What happens to each is then a fact about the model rather than about my sweep.
            //
            // THEY WILL NOT ALL LIVE, and that is the experiment rather than a flaw in it.
            //
            // SPACED, so a band is a band and not a smear. One every APART cells, which on this map
            // is a few hundred bands rather than a hundred thousand people.
            public static method sowEverywhere(Population* folk, Grid* g, int seed, Chronicle* log)
                    returns int {
                mutable Rng* rng = new Rng(seed ^ 0x0BA9D) on heap;
                mutable int bands = 0;
                mutable int made = 0;
                mutable int y = Banding.APART;
                while (y < g.height() - Banding.APART) {
                    mutable int x = Banding.APART;
                    while (x < g.width() - Banding.APART) {
                        if (Banding.roomToSettle(g, x, y)) {
                            made = made + Banding.put(folk, g, rng, x, y);
                            bands = bands + 1;
                        }
                        x = x + Banding.APART;
                    }
                    y = y + Banding.APART;
                }
                log.note(cast<long>(0), "people", $"{made} people in {bands} bands, sown over the whole world");
                delete rng;
                return made;
            }

            // Sow one band. Answers how many people were put into the world -- nought if the map
            // held nowhere a person could stand, which a caller may want to say out loud rather
            // than discover later as an empty world.
            public static method sow(Population* folk, Grid* g, int seed, Chronicle* log)
                    returns int {
                mutable Rng* rng = new Rng(seed ^ 0x0BA9D) on heap;
                int w = g.width();
                int h = g.height();
                mutable int homeX = 0 - 1;
                mutable int homeY = 0 - 1;
                // The sweep starts a little way in from the corner so a band never lands with half
                // of itself off the edge of the world.
                mutable int y = Banding.SWEEP;
                while (y < h - Banding.SWEEP && homeX < 0) {
                    mutable int x = Banding.SWEEP;
                    while (x < w - Banding.SWEEP) {
                        if (Banding.roomToSettle(g, x, y)) {
                            homeX = x;
                            homeY = y;
                            x = w;
                        }
                        x = x + Banding.SWEEP;
                    }
                    y = y + Banding.SWEEP;
                }
                if (homeX < 0) {
                    delete rng;
                    return 0;
                }
                int made = Banding.put(folk, g, rng, homeX, homeY);
                // WHERE, AND ON WHAT. The coordinates alone cannot be read: 608,48 is a number, and
                // "on Tundra, at 608,48" is a place. The ground a band begins on decides what it
                // eats and what it can survive, so it is the first thing anybody asks.
                log.note(cast<long>(0), "people",
                         $"a band of {made} on {Biomes.name(g.biomeAt(homeX, homeY))} at {homeX},{homeY}");
                delete rng;
                return made;
            }

            // The people of one band, standing about a spot. Answers how many were made.
            private static method put(Population* folk, Grid* g, Rng* rng, int homeX, int homeY)
                    returns int {
                mutable int made = 0;
                for (int i in 0..Banding.A_BAND) {
                    mutable float px = cast<float>(homeX) + 0.5
                                       + (rng.unit() - 0.5) * 2.0 * Banding.SPREAD;
                    mutable float py = cast<float>(homeY) + 0.5
                                       + (rng.unit() - 0.5) * 2.0 * Banding.SPREAD;
                    // A person who would land on ground they cannot settle on stands where the band
                    // does instead. The alternative is a band with a hole in it where a pond is.
                    if (!g.mayBuildAt(cast<int>(px), cast<int>(py))) {
                        px = cast<float>(homeX) + 0.5;
                        py = cast<float>(homeY) + 0.5;
                    }
                    AgentId who = folk.bear(px, py);
                    // A BAND IS NOT A NURSERY. Everybody sown at nought grows old on the same
                    // afternoon and the whole world empties at once -- which the fauna met exactly
                    // (S1: cohorts sown at age nought, all dead at the same tick) and fixed the same
                    // way. Ages run from children to elders, up to most of a life.
                    folk.at(who).body.age = cast<int>(rng.unit()
                                                      * cast<float>(Population.SHORTEST_LIFE)
                                                      * Banding.SPREAD_OF_AGES);
                    made = made + 1;
                }
                return made;
            }

            // WHERE A BAND SETTLES: ground a town may stand on, which is `Grid.mayBuildAt` and not
            // a list written here. Mountains and shallow water are both passable and neither is a
            // place to begin -- and that judgement already exists, in one place, where the camera's
            // opening shot and every future founding read it. A second list would be a second answer
            // to the same question, and the two would disagree the day one is edited.
            //
            // IT ASKS THE CELL AND NOT THE BIOME, and that is the difference between a band that
            // settles beside a river and one that settles IN it: a river is a flag laid over a land
            // biome, so the biome alone says yes (João, 2026-08-14, and ledger S2-27).
            //
            // AND ITS NEIGHBOURS TOO, so a band does not begin on a one-cell island or on the tip of
            // a spit. Eight cells at arm's length is enough to tell a coastline from a continent.
            private static method roomToSettle(Grid* g, int x, int y) returns boolean {
                if (!g.mayBuildAt(x, y)) {
                    return false;
                }
                for (int dy in 0 - 1..2) {
                    for (int dx in 0 - 1..2) {
                        int nx = x + dx * Banding.ELBOW;
                        int ny = y + dy * Banding.ELBOW;
                        if (nx < 0 || ny < 0 || nx >= g.width() || ny >= g.height()) {
                            return false;
                        }
                        if (!g.mayBuildAt(nx, ny)) {
                            return false;
                        }
                    }
                }
                return true;
            }
        }
    }
}
