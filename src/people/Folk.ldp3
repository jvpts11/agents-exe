import System.IO.Console;
import System.Time.Time;
import System.Math.Math;
import Agents.World.Grid;
import Agents.World.Biomes;
import Agents.World.LandMath;
import Agents.World.Gathers;
import Agents.People.Agent;
import Agents.People.Recall;
import Agents.People.AgentClass;

// THE POPULATION, AND THE EXPERIMENT IT EXISTS TO SETTLE.
//
// Half a million agents as real objects, spread evenly over the walkable world, each carrying a
// life's worth of memory, each wandering. No nation, no economy, nothing else -- the question is
// only what this weighs and what it costs to move, and anything else in the loop would muddy it.
//
// The comparison it is against: Worldbox, written in C++, sits at 2.5 GB with two thousand sapient
// agents. That is the number to hold in mind while reading whatever this prints.
program AgentsExe;

public bundle Agents {
    public namespace People {

        public class Folk {
            private mutable Agent*[] roll;
            private mutable int n;
            private mutable int seed;

            // WHERE EVERYBODY IS, BY BLOCK.
            //
            // Measured on the real game before this existed: drawing half a million agents spent
            // 95.6 per cent of the frame, and almost all of it was walking the whole roll twice to
            // find the few thousand actually on screen. Eleven frames a second, and not one of
            // those milliseconds went on anybody who could be seen.
            //
            // So the world is divided into blocks and each block keeps a chain of who is standing
            // in it. The renderer then visits only the blocks its window covers. The chain is two
            // int arrays and no allocation: `head` per block, `nextIn` per agent -- the same shape
            // the crowd index used, for the same reason.
            //
            // Kept up to date INCREMENTALLY rather than rebuilt. An agent moves 0.06 cells a tick
            // and a block is thirty-two across, so somebody changes block roughly once every five
            // hundred ticks: rebuilding the whole index every frame would be paying for half a
            // million moves to record a few hundred.
            private mutable int[] head;      // per block: first agent, or -1
            private mutable int[] nextIn;    // per agent: next in the same block, or -1
            private mutable int[] prevIn;    // per agent: previous in the same block, or -1
            private mutable int[] blockOf;   // per agent: which block it is linked into
            private mutable int bw;
            private mutable int bh;
            private mutable long rebinnings; // how often somebody actually changed block
            private mutable long groundLooks; // how often the world was actually asked about a cell
            private mutable long movedEver;   // how many agent-moves have actually been done
            private mutable int cap;          // room on the roll, which grows as people are born

            public static fixed int BLOCK = 32;

            // NOBODY IS MOVED EVERY FRAME, AND NOTHING EVER SHOULD BE.
            //
            // Measured on the real game: moving half a million agents cost 34 ms of a 38 ms frame
            // -- ninety per cent of it -- and that was with each agent doing nothing but drifting.
            // The moment any of them has to DECIDE something the per-agent cost multiplies, so a
            // loop that touches everybody at frame rate is a wall this game would hit again with a
            // bigger number.
            //
            // So the population is cut into slices and one slice moves per frame. Each agent is
            // therefore moved once every SLICES frames and takes SLICES steps when it does, which
            // leaves the speed it crosses the world at exactly unchanged -- the work is spread,
            // not reduced, and no agent is ever skipped.
            //
            // The slices are CONTIGUOUS RANGES rather than every-eighth-agent. A strided walk
            // touches one object per cache line and throws the other seven away; a contiguous one
            // reads what it is given. Same agents, same count, different order, and the order is
            // most of the cost at this size.
            //
            // This is the third time this frame is fixed by the same idea. The terrain bake is
            // sliced across frames; the block index is maintained incrementally instead of rebuilt;
            // and now the movement. In each case the mistake was doing all of something every frame
            // when only a part of it had changed.
            // EVERYBODY MOVES, EVERY TICK. This is one, and it stays one.
            //
            // The slicing was mine and it was never asked for. It was introduced when the world
            // held half a million agents as a way of cutting the movement bill, and then the
            // interpolation was introduced to hide what the slicing did to the picture, and the
            // interpolation turned out to be the ghost. Two problems invented to solve a third
            // that a town of a few thousand does not have.
            //
            // A body that moves once every N ticks walks at one step every N frames, which is
            // slow motion in a window running smoothly -- and no amount of drawing cleverness
            // fixes an agent that genuinely has not moved. When the crowd experiment ran, they
            // moved every tick and were drawn every tick, and it looked right because it WAS
            // right.
            public static fixed int SLICES = 1;

            public constructor Folk(int howMany, int withSeed) {
                mutable int room = howMany;
                if (room < 16) {
                    room = 16;
                }
                this.cap = room;
                this.roll = new Agent*[room]();
                this.nextIn = new int[room]();
                this.prevIn = new int[room]();
                this.blockOf = new int[room]();
                this.head = new int[1]();
                this.bw = 0;
                this.bh = 0;
                this.n = 0;
                this.seed = withSeed;
                this.rebinnings = 0;
                this.groundLooks = 0;
                this.movedEver = 0;
            }

            // ROOM FOR MORE PEOPLE, because a population that a game is running is not a number
            // decided at the start.
            //
            // The experiment that built this class knew how many agents it wanted before it made
            // any -- half a million, fixed. A world where people are born does not, and a fixed
            // roll would mean either wasting memory for a population that never comes or a silent
            // ceiling that stops births without saying so. Doubling costs one copy per doubling,
            // which is nothing next to what the agents themselves carry.
            private method reserve(int want) returns void {
                if (want <= this.cap) {
                    return;
                }
                mutable int room = this.cap;
                while (room < want) {
                    room = room * 2;
                }
                mutable Agent*[] biggerRoll = new Agent*[room]();
                mutable int[] biggerNext = new int[room]();
                mutable int[] biggerPrev = new int[room]();
                mutable int[] biggerBlock = new int[room]();
                mutable int i = 0;
                while (i < this.n) {
                    biggerRoll[i] = this.roll[i];
                    biggerNext[i] = this.nextIn[i];
                    biggerPrev[i] = this.prevIn[i];
                    biggerBlock[i] = this.blockOf[i];
                    i = i + 1;
                }
                delete this.roll;
                delete this.nextIn;
                delete this.prevIn;
                delete this.blockOf;
                this.roll = biggerRoll;
                this.nextIn = biggerNext;
                this.prevIn = biggerPrev;
                this.blockOf = biggerBlock;
                this.cap = room;
                return;
            }

            // THE INDEX IS SIZED TO THE WORLD, which the constructor cannot do because it has not
            // seen the world yet. Called by `scatter`, and separately by anyone who is going to
            // spawn people one at a time instead of all at once -- a nation being founded, for
            // instance, rather than an experiment being set up.
            public method sizeIndex(Grid* g) returns void {
                delete this.head;
                this.bw = (g.width() + Folk.BLOCK - 1) / Folk.BLOCK;
                this.bh = (g.height() + Folk.BLOCK - 1) / Folk.BLOCK;
                this.head = new int[this.bw * this.bh]();
                for (int b in 0..this.bw * this.bh) {
                    this.head[b] = 0 - 1;
                }
                return;
            }

            // ONE PERSON, BORN WHERE THEY ARE BORN. Returns their place on the roll, which is how
            // a city holds a resident and how the renderer finds them.
            public method spawn(float atX, float atY, int kind) returns int {
                this.reserve(this.n + 1);
                int i = this.n;
                mutable Agent* one = new Agent(i + 1, atX, atY, kind) on heap;
                this.roll[i] = one;
                this.n = i + 1;
                this.link(i, this.blockIndexOf(atX, atY));
                return i;
            }

            // EVERYBODY IS STILL IN THE INDEX, counted by walking it rather than assumed.
            //
            // The chains are what the renderer sees, and a bug in linking them does not crash: it
            // makes people quietly stop being drawn, or drawn twice, which looks like a rendering
            // problem and is not. So the index is counted against the roll, and both the total and
            // the longest chain are reported -- the second because the chain length is what made
            // the old unlink expensive, and a number nobody prints is a number nobody notices
            // growing.
            public method auditIndex() returns void {
                mutable long seen = 0;
                mutable int longest = 0;
                mutable int b = 0;
                int blocks = this.bw * this.bh;
                while (b < blocks) {
                    mutable int at = this.head[b];
                    mutable int len = 0;
                    while (at >= 0 && len <= this.n) {
                        len = len + 1;
                        at = this.nextIn[at];
                    }
                    if (len > longest) {
                        longest = len;
                    }
                    seen = seen + cast<long>(len);
                    b = b + 1;
                }
                System.IO.Console.println($"index: {seen} agents on the chains of {this.n} on the roll, longest chain {longest}");
                if (seen != cast<long>(this.n)) {
                    System.IO.Console.println("index: THE INDEX AND THE ROLL DISAGREE -- somebody is linked twice or not at all");
                }
                return;
            }

            // HOW MUCH WORK THE MOVE ACTUALLY DID, over the whole run. Divided by the frame count
            // it must come to n/SLICES; if it comes to n, the slicing is not slicing and every
            // number measured about the movement is measuring something else.
            public method moveWork(long frames) returns void {
                if (frames <= 0) {
                    return;
                }
                System.IO.Console.println($"move: {this.movedEver / frames} agents a frame (expected {this.n / Folk.SLICES}), {this.groundLooks / frames} ground looks, {this.rebinnings / frames} rebins");
                return;
            }

            public destructor ~Folk() returns void {
                mutable int i = 0;
                while (i < this.n) {
                    delete this.roll[i];
                    i = i + 1;
                }
                delete this.roll;
                delete this.nextIn;
                delete this.prevIn;
                delete this.blockOf;
                delete this.head;
                return;
            }

            // ---- the index the renderer walks ----

            public method blocksWide() returns int {
                return this.bw;
            }

            public method blocksHigh() returns int {
                return this.bh;
            }

            public method headAt(int bx, int by) returns int {
                if (bx < 0 || by < 0 || bx >= this.bw || by >= this.bh) {
                    return 0 - 1;
                }
                return this.head[by * this.bw + bx];
            }

            public method nextOf(int i) returns int {
                return this.nextIn[i];
            }

            public method rebinCount() returns long {
                return this.rebinnings;
            }

            // Which block a whole cell falls in, with anybody outside the index going in the one
            // spare bucket at the end rather than being dropped.
            private method blockOfCell(int gx, int gy, int spare) returns int {
                int bx = gx / Folk.BLOCK;
                int by = gy / Folk.BLOCK;
                if (bx < 0 || by < 0 || bx >= this.bw || by >= this.bh) {
                    return spare;
                }
                return by * this.bw + bx;
            }

            private method blockIndexOf(float x, float y) returns int {
                int bx = cast<int>(x) / Folk.BLOCK;
                int by = cast<int>(y) / Folk.BLOCK;
                if (bx < 0 || by < 0 || bx >= this.bw || by >= this.bh) {
                    return 0 - 1;
                }
                return by * this.bw + bx;
            }

            private method link(int i, int b) returns void {
                this.blockOf[i] = b;
                if (b < 0) {
                    this.nextIn[i] = 0 - 1;
                    this.prevIn[i] = 0 - 1;
                    return;
                }
                int was = this.head[b];
                this.nextIn[i] = was;
                this.prevIn[i] = 0 - 1;
                if (was >= 0) {
                    this.prevIn[was] = i;
                }
                this.head[b] = i;
                return;
            }

            // Take somebody out of the chain they are in, WITHOUT LOOKING FOR THEM.
            //
            // This used to walk the block's chain from the head, on the reasoning that a block is
            // a thousand cells and a chain would be short. Measured on the real game with half a
            // million agents: 80x45 blocks, so a chain averages a hundred and thirty-nine, and
            // 1,219 agents cross a block boundary every frame. That is a hundred and seventy
            // thousand random hops through a 2 MB array per frame to remove 1,219 entries -- the
            // search cost more than everything it was searching for.
            //
            // The chain is doubly linked now, so removal is four assignments and no search. Two
            // more megabytes for `prevIn`, against a population that already carries two gigabytes
            // of memories: the trade was never close.
            private method unlink(int i) returns void {
                int b = this.blockOf[i];
                if (b < 0) {
                    return;
                }
                int p = this.prevIn[i];
                int nx = this.nextIn[i];
                if (p >= 0) {
                    this.nextIn[p] = nx;
                } else {
                    this.head[b] = nx;
                }
                if (nx >= 0) {
                    this.prevIn[nx] = p;
                }
                return;
            }

            public method count() returns int {
                return this.n;
            }

            public method at(int i) returns Agent* {
                return this.roll[i];
            }

            // EVENLY OVER THE WALKABLE WORLD, and evenly is the point: a clump would measure
            // clumping rather than population. Candidate cells are drawn from the whole map and
            // kept if they are ground somebody could stand on, so the spread follows the shape of
            // the continents without anybody having to decide where the continents are.
            //
            // The refusals are counted. A world whose land is so scarce that most draws are sea
            // would quietly produce far fewer agents than asked for, and a silent shortfall would
            // make every number after it wrong in the same direction.
            public method scatter(Grid* g, int howMany, int memoryEach) returns void {
                int w = g.width();
                int h = g.height();
                // The index is sized to the world here rather than in the constructor, because the
                // world is what decides how many blocks there are and the constructor has not seen
                // it yet.
                this.sizeIndex(g);
                // WHERE EVERYBODY STANDS IS DECIDED BEFORE ANYBODY IS BUILT, so that the objects
                // can be built in the order the move loop will walk them.
                //
                // Sorting the roll AFTER the fact was tried and made it worse: it reorders the
                // pointers, and the objects stay where they were allocated. The walk then jumps at
                // random through 2.4 GB of heap instead of climbing it in order -- 3.2 ms became
                // 6.2. Locality of the 2.7 MB grid is worth having; not at the price of locality
                // of the 2.4 GB the agents themselves occupy.
                //
                // Deciding the positions first costs two int arrays and buys both: neighbours in
                // the world are neighbours in the roll AND neighbours in memory.
                this.reserve(howMany);
                mutable int[] atX = new int[howMany]();
                mutable int[] atY = new int[howMany]();
                mutable int made = 0;
                mutable int tries = 0;
                mutable int wet = 0;
                int ceiling = howMany * 40;
                while (made < howMany && tries < ceiling) {
                    tries = tries + 1;
                    int gx = cast<int>(LandMath.hash01(this.seed ^ 0x51ED, tries, 7)
                                       * cast<float>(w - 1));
                    int gy = cast<int>(LandMath.hash01(this.seed ^ 0x2C9F, tries, 11)
                                       * cast<float>(h - 1));
                    if (!Biomes.walkable(g.biomeAt(gx, gy))) {
                        wet = wet + 1;
                        continue;
                    }
                    atX[made] = gx;
                    atY[made] = gy;
                    made = made + 1;
                }
                this.n = made;
                // A counting sort of those positions by block: one pass to count, one over the
                // blocks to turn the counts into starting offsets, one to place.
                int blocks = this.bw * this.bh;
                mutable int[] start = new int[blocks + 2]();
                mutable int i = 0;
                while (i < made) {
                    start[this.blockOfCell(atX[i], atY[i], blocks)] =
                        start[this.blockOfCell(atX[i], atY[i], blocks)] + 1;
                    i = i + 1;
                }
                mutable int running = 0;
                mutable int b2 = 0;
                while (b2 <= blocks) {
                    int here = start[b2];
                    start[b2] = running;
                    running = running + here;
                    b2 = b2 + 1;
                }
                mutable int[] orderX = new int[made + 1]();
                mutable int[] orderY = new int[made + 1]();
                i = 0;
                while (i < made) {
                    int b = this.blockOfCell(atX[i], atY[i], blocks);
                    orderX[start[b]] = atX[i];
                    orderY[start[b]] = atY[i];
                    start[b] = start[b] + 1;
                    i = i + 1;
                }
                delete atX;
                delete atY;
                delete start;
                // AND ONLY NOW ARE THEY BUILT, in block order, so consecutive agents are both
                // neighbours in the world and climbing addresses in the heap.
                i = 0;
                while (i < made) {
                    mutable Agent* one = new Agent(i + 1, cast<float>(orderX[i]) + 0.5,
                                                  cast<float>(orderY[i]) + 0.5,
                                                  i % AgentClass.count()) on heap;
                    this.fill(one, i, memoryEach);
                    this.roll[i] = one;
                    i = i + 1;
                    if (i % 50000 == 0) {
                        System.IO.Console.println($"  built {i} of {made}...");
                    }
                }
                delete orderX;
                delete orderY;
                // Linked BACKWARDS, because `link` pushes onto the head of a chain: going down the
                // roll leaves every chain in ascending roll order, so walking a chain forwards
                // walks memory forwards -- which is what the renderer does to it every frame.
                mutable int k = made - 1;
                while (k >= 0) {
                    this.link(k, this.blockIndexOf(this.roll[k].x, this.roll[k].y));
                    k = k - 1;
                }
                System.IO.Console.println($"scatter: {made} agents placed in block order, {tries} draws, {wet} fell in the sea");
                return;
            }

            // A LIFE'S WORTH OF MEMORY, so the measurement is of an agent that has lived rather
            // than of an empty one. The proportions are a person's: more places seen and people met
            // than trades mastered, more ordinary days remembered than skills learned.
            private method fill(Agent* one, int idx, int scale) returns void {
                one.given = idx % 512;
                one.family = (idx / 512) % 256;
                one.trait = idx % 12;
                one.culture = idx % 6;
                one.religion = idx % 5;
                // A Craft ordinal, not a number in a lexicon of names. This used to be `idx % 20`
                // against a list of sixteen -- it indexed off the end AND meant nothing, which is
                // how a field called `trade` sat in the agent for months with no part of the game
                // able to act on it.
                one.trade = idx % Gathers.crafts();
                one.feeling = idx % 8;
                if (idx % 17 == 0) {
                    one.afflict(idx % 8);
                }
                one.languages.add(new Recall(idx % 6, 100));
                if (idx % 3 == 0) {
                    one.languages.add(new Recall((idx + 1) % 6, 40));
                }
                one.nationalities.add(new Recall(idx % 4, 1));
                if (idx % 9 == 0) {
                    one.nationalities.add(new Recall((idx + 2) % 4, 2));
                }
                mutable int k = 0;
                while (k < scale) {
                    one.relations.add(new Recall((idx + k * 7) % 100000, 50 + k));
                    one.memory.people.add(new Recall((idx + k * 13) % 100000, 40 + k));
                    one.memory.places.add(new Recall((idx + k * 3) % 4096, 20 + k));
                    one.memory.events.add(new Recall((idx + k * 5) % 2048, 10 + k));
                    one.memory.common.add(new Recall((idx + k) % 512, 80));
                    if (k < scale / 2) {
                        one.memory.skills.add(new Recall((idx + k) % 64, 30 + k));
                        one.memory.likes.add(new Recall((idx + k * 2) % 128, 60));
                        one.memory.dislikes.add(new Recall((idx + k * 3) % 128, 70));
                        one.memory.academical.add(new Recall((idx + k) % 256, 45));
                    }
                    k = k + 1;
                }
                return;
            }

            // WANDERING, which is the cheapest thing that still touches every agent every tick.
            // Each one drifts along its heading, turns a little, and turns away from ground it
            // cannot cross. That is enough to make the cost of "a world full of agents" real
            // without pretending any of them is deciding anything.
            public method wander(Grid* g, float dt, int tick) returns void {
                float w = cast<float>(g.width());
                float h = cast<float>(g.height());
                // ONE AGENT'S WHOLE INTERVAL AT A TIME: SLICES small steps, not one big one.
                //
                // Taking a single step SLICES times the length would let somebody cross a river
                // one cell wide without ever testing the water -- the ground is only asked about
                // where the step LANDS. Half a second of frame rate is not worth agents walking
                // through rivers, and the small steps turn out not to cost it: they run out of a
                // handful of registers, and the cell shortcut below means the eight of them
                // together still ask the world about a cell at most once or twice.
                float advance = dt * 1.25;
                int slice = tick % Folk.SLICES;
                mutable int i = this.sliceStart(slice);
                int stop = this.sliceStart(slice + 1);
                // Counted in a register and banked once. Bumping a field of `this` inside the hot
                // loop puts a store to the same address between every iteration and every one
                // after it -- a counter that exists to prove the loop is cheap should not be one
                // of the reasons it is not.
                mutable long looks = 0;
                int steps = Folk.SLICES;
                this.movedEver = this.movedEver + cast<long>(stop - i);
                while (i < stop) {
                    mutable Agent* one = this.roll[i];
                    // THE WHOLE INTERVAL IS WALKED IN REGISTERS and written back once. The old loop
                    // read and wrote four fields of a scattered object on every step; this reads
                    // them once, turns eight times, and stores once.
                    float wasX = one.x;
                    float wasY = one.y;
                    mutable float px = wasX;
                    mutable float py = wasY;
                    mutable float hx = one.hx;
                    mutable float hy = one.hy;
                    mutable int cx = cast<int>(px);
                    mutable int cy = cast<int>(py);
                    // The edges of the cell it is standing in, as floats, so the inner loop can
                    // ask "still inside?" without converting anything.
                    mutable float lox = cast<float>(cx);
                    mutable float hix = lox + 1.0;
                    mutable float loy = cast<float>(cy);
                    mutable float hiy = loy + 1.0;
                    // SOMEBODY ON AN ERRAND WALKS AT IT. Everybody else drifts.
                    //
                    // This is the whole difference between a crowd and a workforce, and it is one
                    // branch: an agent with an errand points itself at where it is going and keeps
                    // pointing, rather than turning at random. The steps below are the same steps
                    // -- the same size, the same test against the ground -- so an errand does not
                    // buy the right to walk through a river.
                    mutable float turn = (LandMath.hash01(this.seed ^ 0x77A3, i, tick) - 0.5) * 0.6;
                    if (one.errand != 0) {
                        float wantX = cast<float>(one.goX) + 0.5;
                        float wantY = cast<float>(one.goY) + 0.5;
                        float dxTo = wantX - px;
                        float dyTo = wantY - py;
                        float far2 = dxTo * dxTo + dyTo * dyTo;
                        if (far2 > 0.05) {
                            float inv = 1.0 / cast<float>(Math.sqrt(cast<double>(far2)));
                            hx = dxTo * inv;
                            hy = dyTo * inv;
                            turn = 0.0;
                        }
                    }
                    float nx = hx - hy * turn;
                    float ny = hy + hx * turn;
                    // NORMALISED WITHOUT A SQUARE ROOT, because of what is known about the number
                    // going into it. The turn above is a first-order rotation, so it lengthens a
                    // unit heading by sqrt(1+turn*turn) -- at most four and a half per cent.
                    // `len2` therefore always sits in [1, 1.09], and over that range one Newton
                    // step from 1 is good to better than two parts in a thousand. It is also
                    // SELF-CORRECTING: whatever residue is left is the input to the next
                    // interval's correction, so the error cannot accumulate.
                    //
                    // Measured: the square root was 6.6 ns of the 87 ns an agent cost, most of it
                    // the float->double->float trip around a double-precision routine to refine a
                    // number already known to three decimals.
                    float len2 = nx * nx + ny * ny;
                    if (len2 > 0.00000001) {
                        float inv = 1.5 - 0.5 * len2;
                        hx = nx * inv;
                        hy = ny * inv;
                    }
                    // The step itself, once. Between one sub-step and the next the heading only
                    // changes if the agent turned back off a shore, so the multiply belongs where
                    // that happens rather than on every one of the sixteen.
                    mutable float dx = hx * advance;
                    mutable float dy = hy * advance;
                    mutable int k = 0;
                    while (k < steps) {
                        float sx = px + dx;
                        float sy = py + dy;
                        // THE GROUND IS ONLY ASKED WHEN THE CELL CHANGES.
                        //
                        // Measured: `biomeAt` plus `walkable` was 40.8 ns of the 87 ns an agent
                        // cost -- just under half of the most expensive phase in the frame -- and
                        // nearly all of it was cache: half a million agents each jumping to an
                        // arbitrary byte of a 2.7 MB map.
                        //
                        // But a step is 0.06 of a cell, so an agent spends about sixteen of them
                        // inside the same square. If the step lands in the cell it is ALREADY
                        // standing in, that cell is walkable by construction -- it is standing
                        // there -- and no question needs asking. Not an approximation: the same
                        // answer, not fetched.
                        //
                        // Same idea as the block index in the other half of the frame: stop asking
                        // the world every frame about something that changes every few hundred.
                        // "STILL IN THE SAME CELL" IS ASKED IN FLOATING POINT, not by converting
                        // to integers and comparing those.
                        //
                        // Measured: the step itself is two multiplies and an add, and it was
                        // costing 26 ns. LDP3 has no exploitable undefined behaviour, so a
                        // float-to-int cast is not one instruction -- it is a saturating
                        // conversion with the range checks that makes it safe, and there were two
                        // of them on the innermost line of the hottest loop in the game.
                        //
                        // The cell an agent stands in has known edges, so the same question
                        // answers in four compares against numbers already in registers. The cast
                        // still happens on the rare step that leaves the cell, where its cost is
                        // paid once instead of sixteen times -- the safety is not given up
                        // anywhere, it is just no longer bought when nothing is being converted.
                        if (sx >= lox && sx < hix && sy >= loy && sy < hiy) {
                            px = sx;
                            py = sy;
                        } else {
                            looks = looks + 1;
                            if (sx >= 0.0 && sy >= 0.0 && sx < w && sy < h
                                && Biomes.walkable(g.biomeAt(cast<int>(sx), cast<int>(sy)))) {
                                px = sx;
                                py = sy;
                                cx = cast<int>(sx);
                                cy = cast<int>(sy);
                                lox = cast<float>(cx);
                                hix = lox + 1.0;
                                loy = cast<float>(cy);
                                hiy = loy + 1.0;
                            } else {
                                dx = 0.0 - dx;
                                dy = 0.0 - dy;
                                // Turned back rather than stopped: an agent pressed against a
                                // shore that keeps trying the same step is the defect this project
                                // spent a day measuring, and it starts exactly here.
                                hx = 0.0 - hx;
                                hy = 0.0 - hy;
                            }
                        }
                        k = k + 1;
                    }
                    one.px = wasX;
                    one.py = wasY;
                    one.x = px;
                    one.y = py;
                    one.hx = hx;
                    one.hy = hy;
                    // The index is touched once per interval rather than once per step, and only
                    // when the block actually changed.
                    int nowIn = this.blockIndexOf(px, py);
                    if (nowIn != this.blockOf[i]) {
                        this.unlink(i);
                        this.link(i, nowIn);
                        this.rebinnings = this.rebinnings + 1;
                    }
                    // What `spend` does, without the call: this runs half a million times a second
                    // and the method is four lines. The rule it enforces -- energy never goes
                    // below zero -- is the same one, written where it is paid for.
                    mutable int e = one.energy - Folk.SLICES;
                    if (e < 0) {
                        e = 0;
                    }
                    one.energy = e;
                    i = i + 1;
                }
                this.groundLooks = this.groundLooks + looks;
                return;
            }

            // How often the world was actually asked. If this ever approaches one per agent per
            // tick the shortcut above has stopped working, and the frame will say so long before
            // anybody thinks to look -- so the number is kept rather than assumed.
            public method groundLookCount() returns long {
                return this.groundLooks;
            }

            // Where slice `s` begins. Written so that `sliceStart(SLICES)` is the whole roll, which
            // is what makes the loop above need no special case for the last slice -- integer
            // division would otherwise leave the final few agents unmoved forever, and an agent
            // nobody moves is the kind of defect that hides for weeks behind "they look fine".
            public method sliceStart(int s) returns int {
                if (s >= Folk.SLICES) {
                    return this.n;
                }
                return cast<int>(cast<long>(this.n) * cast<long>(s) / cast<long>(Folk.SLICES));
            }

            // HOW FAR THROUGH ITS OWN INTERVAL AGENT `i` IS, for the renderer to draw it between
            // where it was and where it now is. Zero the frame it moved, approaching one the frame
            // before it moves again.
            public method moveFraction(int i, int tick) returns float {
                if (this.n <= 0) {
                    return 0.0;
                }
                int s = cast<int>(cast<long>(i) * cast<long>(Folk.SLICES) / cast<long>(this.n));
                mutable int since = (tick - s) % Folk.SLICES;
                if (since < 0) {
                    since = since + Folk.SLICES;
                }
                return cast<float>(since) / cast<float>(Folk.SLICES);
            }

            // What the population is carrying, counted rather than assumed.
            public method facts() returns long {
                mutable long total = 0;
                mutable int i = 0;
                while (i < this.n) {
                    total = total + cast<long>(this.roll[i].carried());
                    i = i + 1;
                }
                return total;
            }

            public method report() returns void {
                System.IO.Console.println($"folk: {this.n} agents carrying {this.facts()} remembered facts");
                System.IO.Console.println($"folk: indexed over {this.bw}x{this.bh} blocks of {Folk.BLOCK} cells");
                return;
            }
        }
    }
}
