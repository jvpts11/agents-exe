import System.IO.Console;
import Agents.People.Population;
import Agents.People.Agent;
import Agents.People.AgentId;
import Agents.People.Walking;
import Agents.People.Body;
import Agents.People.Activity;
import Agents.People.Journey;
import Agents.People.Kinship;
import Agents.World.Grid;
import Agents.World.Biomes;
import Agents.World.Waymap;
import Agents.World.Rng;
import Agents.World.LandMath;
program AgentsExe;

// A BAND THAT DOES NOT STAND STILL, which is what makes the walking visible and the route search
// real rather than written-and-never-run.
//
// WHY THIS IS HERE AND NOT LATER. A person walks because they are hungry, or because there is work
// somewhere -- and hunger is the next slice and work is the one after that. Written in that order,
// the walking would sit unused for two slices, and code nobody runs is code nobody knows is wrong:
// the previous build's pathing was written that way and its defects surfaced a month later, in a
// crowd, as agents spinning against walls.
//
// So the band wanders. Somebody picks a spot within reach, walks there around whatever is in the
// way, and stands a while before picking another. It is not the reason people will walk -- when
// hunger arrives, THAT is why they set out -- but it exercises every line of the walk on the real
// map, in the window, from this slice on.
public bundle Agents {
    public namespace People {

        // How far a wander goes, in cells. Far enough to cross a few blocks -- so the route search
        // is genuinely searching -- and near enough that the band stays a band.
        public class Roaming {
            // HOW FAR A STROLL GOES, in cells. TWELVE AND NOT FORTY, and the two constants below
            // are one decision: a stroll is a stroll and not an expedition.
            //
            // WHEN EVERYBODY'S FEET WERE FREED (see the tick), the old numbers turned every person
            // in the world into a navigator: fifteen thousand of them asking for a forty-cell route
            // twice a second took the walk from 8,600 picoseconds a person-tick to 110,000, with
            // sixty-four per cent of it inside the route search. The world moved and nothing else
            // fitted in the frame.
            //
            // A short walk is also a cheap one -- the coarse block search barely runs over twelve
            // cells -- and it is what milling about actually looks like. Somebody with a REASON to
            // cross a continent gets a real route from `Foraging`; this is the walk of a person with
            // nowhere in particular to be.
            public static fixed float WANDER = 12.0;
            // And each person decides about once a quarter-year rather than twice a second. Spread
            // by slot, so the world sets off a steady trickle instead of a tide.
            public static fixed int DECIDE_EVERY = 300;
            // How many places to try before giving up this tick. Bounded: the ground may be a
            // peninsula, and a loop that searches until it succeeds is the defect this whole slice
            // is written against.
            public static fixed int TRIES = 6;

            // How far away somebody still counts as the person you are keeping near. Wider than a
            // stroll, so a walker who has drifted off comes back rather than settling where they
            // landed; narrower than the world, so a family that really has split stays split.
            public static fixed float KEEPING_NEAR = 48.0;

            // WHO THIS PERSON IS ORBITING, or themselves if they know nobody in reach. Two methods
            // and not one returning a pair, because a `vec2` out of a method that also has to say
            // "nobody" would need a sentinel position, and there is no position that cannot be a
            // real one.
            private static method nearKinX(Population* folk, Agent* one, AgentId mine) returns float {
                AgentId who = Roaming.nearestKin(folk, one, mine);
                if (who == Kinship.NOBODY) {
                    return one.x();
                }
                return folk.at(who).x();
            }

            private static method nearKinY(Population* folk, Agent* one, AgentId mine) returns float {
                AgentId who = Roaming.nearestKin(folk, one, mine);
                if (who == Kinship.NOBODY) {
                    return one.y();
                }
                return folk.at(who).y();
            }

            // Walks the kinship chain, which is tens of links and not the population.
            //
            // NOBODY IS `Kinship.NOBODY` HERE, not a bare -1: the two callers above tested `< 0`,
            // which is the same answer written a third way. One spelling, and it is the one the
            // kinship itself uses.
            private static method nearestKin(Population* folk, Agent* one, AgentId mine)
                    returns AgentId {
                mutable int link = one.kin.first();
                mutable AgentId found = Kinship.NOBODY;
                mutable float best = Roaming.KEEPING_NEAR * Roaming.KEEPING_NEAR;
                while (link >= 0) {
                    AgentId slot = Kinship.whoOf(one.kin.at(link));
                    link = one.kin.after(link);
                    int at = cast<int>(slot);
                    if (at < 0 || at >= folk.count() || slot == mine) {
                        continue;
                    }
                    Agent* them = folk.at(slot);
                    float dx = them.x() - one.x();
                    float dy = them.y() - one.y();
                    float gap = dx * dx + dy * dy;
                    if (gap < best) {
                        best = gap;
                        found = slot;
                    }
                }
                return found;
            }

            public static method tick(Population* folk, Grid* g, Waymap* ways, long at, Rng* rng)
                    returns void {
                if (folk.count() < 1) {
                    return;
                }
                // A SHARE OF THE POPULATION DECIDES EACH TICK, and not one person in the world.
                //
                // It WAS one person: `at % DECIDE_EVERY` picked a single slot, which is a decision
                // every half second for everybody together. With one band that reads as a band
                // making up its mind; with the whole world sown -- five thousand people -- it is one
                // decision per person every forty-four HOURS of world time, and the people stand
                // still while every number about them says the walk works. A rate has to be per
                // person, or it silently becomes a rate per world divided by however many there are.
                //
                // Sliced by slot, the same way the fauna's stir is: everybody comes up once every
                // DECIDE_EVERY ticks, and a different share of them comes up on each of those ticks.
                int n = folk.count();
                int phase = cast<int>(at % cast<long>(Roaming.DECIDE_EVERY));
                mutable int slot = phase;
                while (slot < n) {
                    AgentId who = cast<AgentId>(slot);
                    Agent* one = folk.at(who);
                    slot = slot + Roaming.DECIDE_EVERY;
                    if (one.journey.going) {
                        continue;
                    }
                    // AND NOBODY WHO IS AFTER SOMETHING. A hunter walks himself, straight at a
                    // moving animal, and keeps the place the chase BEGAN in `journey.to` so his
                    // give-up distance measures from there. A stroll handed to him overwrites it --
                    // and then his chase reads as having covered a cell before it ends. Three
                    // thousand chases, an average distance of ONE cell, and the reason was that
                    // this loop and the hunt were both writing the same field.
                    if (one.journey.chase != Journey.NOTHING) {
                        continue;
                    }
                    // ANYBODY WHOSE FEET ARE FREE, and not only the idle.
                    //
                    // WRITTEN AS "ONLY THE IDLE" FOR ONE SLICE, and it made a world of statues. Of
                    // fifteen thousand people, FOUR were idling: everybody else was talking,
                    // courting, eating or mating, all of which outscore idling and none of which
                    // ever gave anybody a destination. So nobody moved -- a person watching the
                    // window saw them standing for whole minutes and heaping up along the rivers,
                    // because wherever the last walk left them was where they stayed, and a walk
                    // that meets water slides along the bank (ledger S2-22).
                    //
                    // Talking while walking is what people do. What an activity says is what
                    // somebody is DOING; only a few of them say anything about whether their feet
                    // work, and `Activity.rooted` is where that is said -- for this and for
                    // `Doings.act`, one question with two readers.
                    if (one.activity.rooted()) {
                        continue;
                    }
                    // AROUND SOMEBODY THEY KNOW, IF THERE IS ANYBODY. A stroll centred on where the
                    // walker already stands is a random walk, and a random walk of twelve cells
                    // every quarter-year dissolves a band: over fifty years it spreads a family a
                    // hundred and sixty cells apart, and then nobody is in anybody's block, nobody
                    // marries and nobody meets their own spouse again. The births fell from thirteen
                    // thousand children to two thousand the moment everybody's feet were freed, and
                    // this is why -- not the walking, the AIMLESSNESS of it.
                    //
                    // Nobody needs a rule about bands holding together. A person wanders near the
                    // people they know; the people they know wander near them; that is a band, and
                    // it is also what makes the world look like it has villages in it rather than a
                    // fog of people.
                    float aboutX = Roaming.nearKinX(folk, one, who);
                    float aboutY = Roaming.nearKinY(folk, one, who);
                    mutable int tries = 0;
                    while (tries < Roaming.TRIES) {
                        tries = tries + 1;
                        float ang = rng.unit() * 6.2831853;
                        float far = rng.unit() * Roaming.WANDER;
                        float tx = aboutX + LandMath.cos(ang) * far;
                        float ty = aboutY + LandMath.sin(ang) * far;
                        if (tx < 1.0 || ty < 1.0 || tx >= cast<float>(g.width()) - 1.0
                            || ty >= cast<float>(g.height()) - 1.0) {
                            continue;
                        }
                        if (Walking.setOut(folk, g, ways, who, tx, ty)) {
                            tries = Roaming.TRIES;
                        }
                    }
                }
                return;
            }
        }
    }
}
