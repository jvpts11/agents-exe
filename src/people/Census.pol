import Agents.Sim.Clock;
import Agents.Sim.Layer;
import Agents.Sim.World;
import Agents.People.Doings;

program AgentsExe;

// THE WORLD SAYING WHAT IT IS DOING, WHILE IT IS STILL DOING IT.
//
// End-of-run totals cannot tell a world that fed itself for two centuries and then died from one
// that was dying the whole time -- and four guesses at why a run emptied were wrong before this
// existed. It is `Doings.census` and nothing else; what is here is WHEN.
//
// A PASS OF ITS OWN AND NOT A LINE INSIDE `Doings`, because its cadence is its own: `Doings` runs
// every tick and this runs twenty years apart. Two things that happen at different rates are two
// passes, and one of them holding an `if` about the other is how a tick order stops being readable.
//
// TWENTY YEARS IS A FIFTH OF A LIFE: often enough to see a generation turn over, rare enough that a
// three-hundred-year run is fifteen lines.
//
// AND IT IS CHARGED TO THE PEOPLE, which is deliberate. It walks the crowd, so its cost is part of
// what a person costs -- and it sits between `Doings` and `Courting` inside the one bracket the
// account is measured with, exactly where it always ran.
public bundle Agents {
    public namespace People {

        public class Census implements Layer {
            public static fixed int EVERY_YEARS = 20;

            public override method name() returns String {
                return "census";
            }
            public override method runsAt(World* now) returns boolean {
                return Clock.turnsYear(now.age())
                       && Clock.yearsIn(now.age()) % cast<long>(Census.EVERY_YEARS)
                          == cast<long>(0);
            }
            public override method chargedToPeople() returns boolean {
                return true;
            }
            public override method pass(World* now) returns void {
                Doings.census(now.people(), now.ground());
                return;
            }
        }
    }
}
