import System.IO.Console;
import Agents.People.Armour;
program AgentsExe;

// WHAT AN AGENT CARRIES AND WEARS, and it is NOT A LIST -- said here because the reflex is to make
// everything one.
//
// The hands hold one carried item, one tool and one weapon, one of each at a time; the equipment has
// a bounded set of slots. Nothing here varies in length, so all of it stays inside the agent: no
// allocation per agent, and no pointer chase to ask what somebody is holding.
//
// `carrying` and `howMany` are a pair because a load is a KIND and an AMOUNT -- eight logs is one
// carried thing, not eight of them, and the hauling in S4 moves goods by the load.
public bundle Agents {
    public namespace People {

        public struct Inventory {
            public static fixed int EMPTY_HANDED = 0 - 1;

            public mutable int carrying;    // the good in its hands, or EMPTY_HANDED
            public mutable int howMany;     // how much of it
            public mutable int tool;        // one tool
            public mutable int weapon;      // one weapon
            public mutable Armour armour;   // head, torso, legs, feet, shield

            public method emptyHanded() returns boolean {
                return carrying == Inventory.EMPTY_HANDED || howMany <= 0;
            }

            // Putting a load down leaves BOTH halves saying the same thing. Written once here
            // because "the kind is cleared and the count is not" is the shape of bug that survives
            // for weeks: every reader that checks one and not the other still works.
            public method dropAll() returns void {
                carrying = Inventory.EMPTY_HANDED;
                howMany = 0;
                return;
            }
        }
    }
}
