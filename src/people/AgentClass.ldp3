program AgentsExe;

// WHAT A PERSON IS, which in this world is four things and not a spectrum.
//
// It is a `sealed enum` and not a field on the agent, and the difference is the whole reason the
// hierarchy exists: the rules about which jobs a person may hold, which activities they may enter,
// what class their children are born into and who they marry toward ARE the differences between
// these four. A label would leave those rules in if-ladders spread across the code; a standing puts
// each one in the class it belongs to, where a `match` over this enum must cover all four or say
// which it missed.
//
// SEALED, so the fifth standing -- if the model ever grows one -- is reported at every place written
// before it rather than swallowed by a `default`.
//
// IT IS ALSO A MESH. The renderer draws one body per standing (`agents.index` holds Civil,
// Soldier, Scout and Protagonist), so a worker recruited into the army LOOKS different the moment
// the recruitment happens, and that costs nothing extra: the model changed because the class did.
public bundle Agents {
    public namespace People {

        public sealed enum AgentClass permits
            Worker,        // any Craft job. The standing everybody is born into
            Soldier,       // Commission jobs only: recruited out of the workers, never born one
            Scout,         // Survey jobs only. A child of two scouts is a scout
            Protagonist;   // Office jobs only: the nobility, and a city without one raises one
    }
}
