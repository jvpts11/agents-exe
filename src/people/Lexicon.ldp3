import System.IO.Console;

// A NAME STORED ONCE, AND A NUMBER EVERYWHERE ELSE.
//
// A culture, a religion, a language, a personality, a trade, a given name: each of them is a thing
// the world has a handful of and the agents have millions of references to. Storing the text on the
// agent would mean the same forty characters written down once per agent who holds it, comparing
// two agents' religion would be a string compare, and a religion could never grow behaviour of its
// own because it would not exist anywhere as a thing.
//
// So it is stored once, here, and an agent holds the number. Comparison becomes an integer test.
// Memory becomes a number per agent instead of a string per agent. And when a religion needs taboos
// or a language needs a parent tongue, they get added HERE, to a thing that already exists, without
// the agent changing at all.
//
// Lookup by name is linear. That is deliberate and it is not a placeholder: a catalogue has tens of
// entries, `add` is called while the world is being built and almost never after, and a hash map
// would cost more in allocation and indirection than the scan saves. If a catalogue ever grows into
// the thousands this is the line to revisit -- and it will say so, because `misses` counts the
// scans that found nothing.
program AgentsExe;

public bundle Agents {
    public namespace People {

        public class Lexicon {
            private mutable String title;      // what this catalogue is, for reports
            private mutable String[] names;
            private mutable int n;
            private mutable int cap;
            private mutable long misses;       // scans that ended in a new entry

            public constructor Lexicon(String what, int capacity) {
                this.title = what;
                this.cap = capacity;
                if (this.cap < 4) {
                    this.cap = 4;
                }
                this.names = new String[this.cap]();
                this.n = 0;
                this.misses = 0;
            }

            public destructor ~Lexicon() returns void {
                delete this.names;
                return;
            }

            public method count() returns int {
                return this.n;
            }

            public method nameOf(int id) returns String {
                if (id < 0 || id >= this.n) {
                    return "";
                }
                return this.names[id];
            }

            // The number for this name, adding it if the world has not seen it before.
            //
            // Idempotent on purpose: every caller can simply ask, and two callers asking for the
            // same thing get the same number without either of them having to know whether the
            // other went first.
            public method idOf(String name) returns int {
                mutable int i = 0;
                while (i < this.n) {
                    if (this.names[i].equals(name)) {
                        return i;
                    }
                    i = i + 1;
                }
                this.misses = this.misses + 1;
                if (this.n >= this.cap) {
                    this.grow();
                }
                this.names[this.n] = name;
                this.n = this.n + 1;
                return this.n - 1;
            }

            // The number for this name, or -1. For callers who want to know whether the world has
            // heard of something rather than to teach it.
            public method find(String name) returns int {
                mutable int i = 0;
                while (i < this.n) {
                    if (this.names[i].equals(name)) {
                        return i;
                    }
                    i = i + 1;
                }
                return 0 - 1;
            }

            private method grow() returns void {
                int want = this.cap * 2;
                mutable String[] wider = new String[want]();
                mutable int i = 0;
                while (i < this.n) {
                    wider[i] = this.names[i];
                    i = i + 1;
                }
                delete this.names;
                this.names = wider;
                this.cap = want;
                return;
            }

            public method report() returns void {
                System.IO.Console.println($"{this.title}: {this.n} entries");
                return;
            }
        }
    }
}
