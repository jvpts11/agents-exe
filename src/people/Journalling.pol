import Agents.Sim.Layer;
import Agents.Sim.World;

program AgentsExe;

// EVERY AGENT'S EVERY FIELD, WRITTEN DOWN, if a run asked for that.
//
// LAST, AND THAT IS THE WHOLE OF WHAT THIS CLASS DECIDES. A row is the world as the tick LEFT it
// rather than half way through being decided -- so this pass is the one that has to be at the end,
// and being a `Layer` is how "at the end" became something a reader can see in the order rather than
// a line at the bottom of a method.
//
// NOT CHARGED TO THE PEOPLE, and the reason is in `Sim.report`: a run's own instrumentation is not
// what a person costs. A cost that only exists when somebody asked for a log would otherwise be
// averaged into the number this project measures its crowd against.
//
// SILENT UNLESS A RUN NAMED A FILE. The journal itself answers that -- `World.keepJournal` is what
// gives it one -- so there is no cadence here and no condition: it runs every tick and writes
// nothing most of the time.
public bundle Agents {
    public namespace People {

        public class Journalling implements Layer {
            public override method name() returns String {
                return "journal";
            }
            public override method runsAt(World* now) returns boolean {
                return true;
            }
            public override method chargedToPeople() returns boolean {
                return false;
            }
            public override method pass(World* now) returns void {
                now.journal().note(now.people(), now.ground(), now.age());
                return;
            }
        }
    }
}
