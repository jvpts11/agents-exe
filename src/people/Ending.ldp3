program AgentsExe;

// WHAT KILLED SOMEBODY.
//
// A COUNT OF THE DEAD CANNOT BE ASKED THE ONLY QUESTION THAT MATTERS. Two hundred people died: of
// age, in a world that is working, or of hunger, in a world that cannot feed itself? Those are
// opposite readings of the same number, and the fauna learned it one slice ago -- its extinction
// sentence names a cause for exactly this reason, and it grew two causes past what the spec listed
// because a real world produced deaths the list could not describe.
//
// SEALED, so a `match` over an ending must cover every one of them: the next way to die is reported
// at every place written before it, rather than being swallowed by a `default` and silently counted
// as old age.
public bundle Agents {
    public namespace People {

        public sealed enum Ending permits
            OldAge,     // it reached the age it was born to reach
            Hunger;     // its food ran out, and then its health did
        {
            // WHAT TO SAY WHEN IT HAPPENS, in words rather than in the constant's name -- a world
            // that says "somebody died -- Hunger" is talking to its own source, and one that says
            // "starved" is talking to whoever is watching, which is the point of saying it at all.
            public method said() returns String {
                return match (this) {
                    case OldAge -> "grew old";
                    case Hunger -> "starved";
                };
            }
        }
    }
}
