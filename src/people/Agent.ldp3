import Agents.People.AgentClass;
import Agents.People.Identity;
import Agents.People.Belonging;
import Agents.People.Body;
import Agents.People.Mind;
import Agents.People.Inventory;
import Agents.People.Armour;
import Agents.People.Whereabouts;
program AgentsExe;

// A PERSON.
//
// COMPOSITION FOR WHAT AN AGENT HAS, INHERITANCE FOR WHAT AN AGENT IS. Both halves are load-bearing
// and the layout design turns on the distinction:
//
//   * the parts below are VALUE STRUCTS, so they live inside this object. One allocation for a
//     person, not eleven -- and reading a person's health is a field of a field, with no pointer
//     chased anywhere. The thing the previous build could not afford was never the object; it was
//     giving every agent its own allocators for the parts whose length nobody can predict.
//   * the four standings are SUBCLASSES, because the model's rules about which jobs a person may
//     hold, what their children are born as and who they marry toward ARE the differences between
//     them. As a field, each of those rules becomes an if-ladder in a different file; as a class,
//     each one is an override, and the compiler asks for it.
//
// ABSTRACT, so nobody is ever merely a person: everybody alive is a Worker, a Soldier, a Scout or a
// Protagonist, and the array they are in says which without asking.
//
// WHAT IS NOT HERE YET, and where it arrives: `Memory` and `Kinship` (S2.6), `Employment` (S4) and
// the `Activity` a person is doing (S2.7). Each is a slice of its own with its own checks, and each
// lands as a field here. This is not a hole -- it is the order the plan was written in, and a field
// for a type that does not exist yet cannot be written.
public bundle Agents {
    public namespace People {

        public abstract class Agent {
            // Fixed at birth and never written again: name, people, gods, nature, sex, orientation.
            public mutable Identity identity;
            // The nations and languages it holds. A person can hold more than one of each.
            public mutable Belonging belonging;
            // Health, energy, hunger, age, the age it dies at, and a pregnancy if there is one.
            public mutable Body body;
            // What it is feeling, and how much it knows.
            public mutable Mind mind;
            // What it carries.
            public mutable Inventory inventory;
            // What it wears.
            public mutable Armour armour;
            // Where it is, which way it faces, and the city and building it belongs to.
            public mutable Whereabouts whereabouts;

            // EVERY PART IS GIVEN ITS ZERO HERE, and the compiler is the reason: a field of a new
            // heap object holds whatever the last object at that address left behind, so an unwritten
            // part does not start empty, it starts WRONG -- with somebody else's nationality, or a
            // pregnancy that belonged to a woman who died. The language refuses to compile a
            // constructor that leaves one out, which is how that class of defect stops existing.
            public constructor Agent() {
                identity = new Identity();
                belonging = new Belonging();
                body = new Body();
                mind = new Mind();
                inventory = new Inventory();
                armour = new Armour();
                whereabouts = new Whereabouts();
            }

            // WHAT THIS PERSON IS. The one thing every standing must answer, and the reason this
            // class is abstract: there is no sensible default, and a default here would be a person
            // of no standing walking around the world.
            public abstract method standing() returns AgentClass;

            // Where it is standing, in cells. Read often enough -- by the index, by the bake, by
            // everything that asks who is near -- to be worth naming rather than reaching through
            // two fields for.
            public method x() returns float {
                return whereabouts.position.x;
            }

            public method y() returns float {
                return whereabouts.position.y;
            }
        }
    }
}
