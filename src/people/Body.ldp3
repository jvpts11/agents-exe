import System.IO.Console;
import Agents.People.Gauge;
program AgentsExe;

// THE PHYSICAL STATE, and a pregnancy if there is one.
//
// The three gauges are the whole of what keeps an agent alive, and they are gauges rather than ints
// for one reason: every site that changes one would otherwise have to remember the clamp, and a
// clamp written at every site is a clamp missing from one of them. See `Gauge`.
//
// PREGNANCY LIVES HERE, and it is neither a state nor a bit. Not a state, because a state would stop
// the agent working, eating and sleeping and a pregnant agent does all three -- that was already
// settled. Not a bit, because a bit says WHETHER and a pregnancy has a TERM and an OUTCOME: the tick
// it began on and how many are coming. Two numbers a flag cannot hold, in the wrong catalogue --
// the condition bitmask is autism, ADHD, psychosis, sociopathy, and a pregnancy is not one of those.
// (Audit finding A7.)
public bundle Agents {
    public namespace People {

        public struct Body {
            // Nothing is expected. `carrying` holds this when there is no pregnancy.
            public static fixed int NOT_CARRYING = 0 - 1;

            public mutable Gauge health;    // 0..100, lowered by trauma, disease, injury
            public mutable Gauge energy;    // 0..1000; empty means it must sleep
            public mutable Gauge fed;       // 0..100; at 20 it goes looking, at 0 it takes damage
            public mutable int age;         // starts at nothing and rises
            public mutable int diesAt;      // rolled at birth, 80..120. It dies when age reaches it
            public mutable int carrying;    // the tick a pregnancy began, or NOT_CARRYING
            public mutable byte expecting;  // how many are coming, 1..5; zero when not pregnant
        }
    }
}
