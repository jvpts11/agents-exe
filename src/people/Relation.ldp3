program AgentsExe;

// HOW ONE PERSON IS TIED TO ANOTHER. Ten of them, and the model names all ten.
//
// SEALED, so a `match` over a tie must cover every one: the eleventh kind of tie -- and there will
// be one, this world is going to grow in-laws and godparents -- is reported at every place written
// before it rather than being swallowed as a friendship.
//
// EVERY TIE IS HELD FROM BOTH SIDES, and each side has its own name for it: A holds `Parent: B` and
// B holds `Child: A`. That is why `mirror` is on the enum rather than in whoever binds them -- a
// tie whose two halves are written at two call sites is a tie that will be half-written somewhere,
// and a half-written tie is a parent whose child does not know them.
public bundle Agents {
    public namespace People {

        public sealed enum Relation permits
            Parent,       // A's parent is B
            Child,        // A's child is B
            Sibling,
            Spouse,
            Sweetheart,   // courting, not yet married
            Friend,
            Enemy,
            Rival,
            Uncle,        // and aunt: the tie, not the word for the person
            Grandparent;
        {
            // WHAT THE OTHER SIDE HOLDS. Most ties are their own mirror -- a sibling's sibling is a
            // sibling, an enemy's enemy is an enemy of theirs -- and the three that are not are the
            // ones that carry a generation with them.
            //
            // (`Uncle` mirrors to `Child`: a niece is not a special tie in this model, she is the
            // child of the sibling, and the uncle knows her as one. `Grandparent` the same. If the
            // world ever needs `Niece` and `Grandchild` as their own names, they arrive here and
            // every `match` in the program says where it has to change.)
            public method mirror() returns Relation {
                return match (this) {
                    case Parent -> Relation.Child;
                    case Child -> Relation.Parent;
                    case Sibling -> Relation.Sibling;
                    case Spouse -> Relation.Spouse;
                    case Sweetheart -> Relation.Sweetheart;
                    case Friend -> Relation.Friend;
                    case Enemy -> Relation.Enemy;
                    case Rival -> Relation.Rival;
                    case Uncle -> Relation.Child;
                    case Grandparent -> Relation.Child;
                };
            }

            // Whether this tie is one of blood, which is the question marriage asks.
            public method isBlood() returns boolean {
                return match (this) {
                    case Parent -> true;
                    case Child -> true;
                    case Sibling -> true;
                    case Uncle -> true;
                    case Grandparent -> true;
                    case Spouse -> false;
                    case Sweetheart -> false;
                    case Friend -> false;
                    case Enemy -> false;
                    case Rival -> false;
                };
            }
        }
    }
}
