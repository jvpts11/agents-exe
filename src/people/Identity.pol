import System.IO.Console;
import Agents.People.Temperament;
import Agents.People.Sex;
import Agents.People.Orientation;
program AgentsExe;

// WHO AN AGENT IS: the part that is fixed at birth and never changes again.
//
// That is the line this struct is drawn on. What an agent HAS goes in the other parts and moves --
// its body wears down, its mind turns, its inventory empties. None of this does. An agent's name,
// people, gods and nature are the same on the day it dies as on the day it was born, and keeping
// them together means the tick never writes here at all.
//
// EVERY NAMED THING IS A NUMBER INTO A TABLE THE WORLD OWNS, never text. Two agents share a religion
// when they hold the same number -- an integer test rather than a string compare, and one copy of
// the name in the world instead of one per agent.
public bundle Agents {
    public namespace People {

        public struct Identity {
            public mutable int givenName;    // into the world's name table
            public mutable int familyName;   // 50/50 from either parent
            public mutable int culture;
            public mutable int religion;
            // Five axes rather than a label -- see `Temperament` for why that matters to a whole
            // population deciding things on the same tick.
            public mutable Temperament nature;
            public mutable Sex sex;
            // Named `orientation` and NOT `genre`: the old name was a false friend of the Portuguese
            // *género* and the field never held gender at all. There is no gender-identity field --
            // see `Orientation` for the decision and its reason.
            public mutable Orientation orientation;
        }
    }
}
