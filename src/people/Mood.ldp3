import System.IO.Console;
program AgentsExe;

// HOW AN AGENT IS FEELING, which is not what it is doing. The activity is what it is doing.
//
// Four, and each one has to change something the world can see or it does not belong here: grief
// stops work, fear sends it home, and a depressed agent works and eats and takes no pleasure in
// either. `Content` is the resting value and the only one that costs nothing.
//
// SEALED, so a fifth mood cannot be added without every match over it being told -- which matters
// more here than for most, because a mood is exactly the kind of field that grows a constant a
// slice and finds a `default` waiting for it.
public bundle Agents {
    public namespace People {

        public sealed enum Mood permits
            Content,     // the resting value: nothing is wrong
            Grieving,    // somebody it was bound to died. It does not work while it lasts
            Afraid,      // something happened near it. It goes home
            Depressed;   // it works, it eats, and neither helps
    }
}
