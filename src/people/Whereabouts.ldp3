import System.IO.Console;
import Agents.People.CityId;
import Agents.People.BuildingId;
program AgentsExe;

// WHERE AN AGENT IS, AND WHAT IT BELONGS TO. Two questions that sound like one and are not: the
// position moves every tick, the city it belongs to changes a handful of times in a life.
//
// `position` and `facing` are `vec2` -- the language's own two-float vector. The fauna used bare
// floats and had reason to: a `Beast` is twenty bytes and every one of them was argued for. An
// agent is not on that budget, the facing is a direction and directions are what a vector type is
// for, and the pose the renderer draws reads it.
//
// The two ids are `newtype`s and not ints. See `CityId`.
public bundle Agents {
    public namespace People {

        public struct Whereabouts {
            // Belonging to nobody: born outside a nation, or its city is gone.
            public static fixed int NOWHERE = 0 - 1;

            public mutable vec2 position;
            public mutable vec2 facing;
            public mutable CityId homeCity;
            public mutable BuildingId workplace;

            // BELONGING TO NOBODY, WHICH IS WHAT A NEW PERSON BELONGS TO -- and which a zeroed
            // struct does NOT say. `NOWHERE` is minus one and a fresh field is nought, so an agent
            // straight out of the constructor claimed city nought and building nought: it had a
            // home and a job, both of them the first ones the world will ever build.
            //
            // IT COST A WHOLE WORLD. `Activity.Working` asks whether this person has a post, so
            // every one of five thousand people scored working at 0.45, beat idling, gathering and
            // courting, and stood in a field working at a building that does not exist until S4 --
            // for three hundred and eight years, until the last of them starved. Same shape as
            // `Body.born`, and the fifth time in this slice that an unwritten field has read as a
            // plausible default (ledger S2-14).
            public static method born() returns Whereabouts {
                mutable Whereabouts fresh = new Whereabouts();
                fresh.homeCity = cast<CityId>(Whereabouts.NOWHERE);
                fresh.workplace = cast<BuildingId>(Whereabouts.NOWHERE);
                return fresh;
            }

            public method homeless() returns boolean {
                return cast<int>(homeCity) == Whereabouts.NOWHERE;
            }

            public method jobless() returns boolean {
                return cast<int>(workplace) == Whereabouts.NOWHERE;
            }
        }
    }
}
