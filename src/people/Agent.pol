import Agents.People.AgentClass;
import Agents.People.AgentId;
import Agents.People.Identity;
import Agents.People.Belonging;
import Agents.People.Body;
import Agents.People.Mind;
import Agents.People.Inventory;
import Agents.People.Armour;
import Agents.People.Whereabouts;
import Agents.People.Journey;
import Agents.People.Kinship;
import Agents.People.Activity;
program AgentsExe;

// A PERSON.
//
// COMPOSITION FOR WHAT AN AGENT HAS, INHERITANCE FOR WHAT AN AGENT IS. Both halves are load-bearing
// and the layout design turns on the distinction:
//
//   * the parts below are VALUE STRUCTS, so they live inside this object. One allocation for a
//     person, not eleven -- and reading a person's health is a field of a field, with no pointer
//     chased anywhere. The thing the previous build could not afford was never the object; it was
//     giving every agent its own allocators for the parts whose length nobody can predict.
//   * the four standings are SUBCLASSES, because the model's rules about which jobs a person may
//     hold, what their children are born as and who they marry toward ARE the differences between
//     them. As a field, each of those rules becomes an if-ladder in a different file; as a class,
//     each one is an override, and the compiler asks for it.
//
// ABSTRACT, so nobody is ever merely a person: everybody alive is a Worker, a Soldier, a Scout or a
// Protagonist, and the array they are in says which without asking.
//
// WHAT IS NOT HERE YET, and where it arrives: `Memory` and `Kinship` (S2.6), `Employment` (S4) and
// the `Activity` a person is doing (S2.7). Each is a slice of its own with its own checks, and each
// lands as a field here. This is not a hole -- it is the order the plan was written in, and a field
// for a type that does not exist yet cannot be written.
public bundle Agents {
    public namespace People {

        public abstract class Agent {
            // Fixed at birth and never written again: name, people, gods, nature, sex, orientation.
            public mutable Identity identity;
            // The nations and languages it holds. A person can hold more than one of each.
            public mutable Belonging belonging;
            // Health, energy, hunger, age, the age it dies at, and a pregnancy if there is one.
            public mutable Body body;
            // What it is feeling, and how much it knows.
            public mutable Mind mind;
            // What it carries.
            public mutable Inventory inventory;
            // What it wears.
            public mutable Armour armour;
            // Where it is, which way it faces, and the city and building it belongs to.
            public mutable Whereabouts whereabouts;
            // And where it is going, if anywhere. Separate from `whereabouts` on purpose: one is
            // where a body IS and the other is where it is headed, and they change on different
            // clocks -- the first every tick, the second when a destination is reached or given up.
            public mutable Journey journey;
            // WHO IT KNOWS AND HOW. A pointer and not a value, because a kinship holds the head of
            // a chain in the world's pool and owns it: an agent with nobody costs one integer.
            // Written only through `Kindred`, which writes both ends of every tie.
            public mutable Kinship* kin;
            // AND WHAT IT IS DOING, which is one value and not a part: the pose the renderer draws,
            // the drain the body pays, and the reason the walk it is on exists. Deliberately NOT
            // `Employment.doing`, which is the `Errand` an activity carries -- the payload, not the
            // activity (spec audit B3).
            public mutable Activity activity;

            // EVERY PART IS GIVEN ITS ZERO HERE, and the compiler is the reason: a field of a new
            // heap object holds whatever the last object at that address left behind, so an unwritten
            // part does not start empty, it starts WRONG -- with somebody else's nationality, or a
            // pregnancy that belonged to a woman who died. The language refuses to compile a
            // constructor that leaves one out, which is how that class of defect stops existing.
            // THE SLOT IT IS BORN INTO, which its kinship needs: a tie is written on both sides, so
            // binding has to know which side this is.
            public constructor Agent(AgentId slot) {
                rank = AgentClass.Worker;   // what everybody is born into; the rest are made
                identity = new Identity();
                belonging = new Belonging();
                // ALIVE, rather than merely zeroed: full health, rested, fed. `Body.born` is where
                // that is said, and what a fresh body held before it existed was a corpse nobody
                // had told.
                body = Body.born();
                mind = new Mind();
                inventory = new Inventory();
                armour = new Armour();
                // BELONGING TO NOBODY, rather than to city nought and building nought, which is
                // what the zeroes said. See `Whereabouts.born`.
                whereabouts = Whereabouts.born();
                // Going nowhere and chasing nothing, which the zeroes only half say. See
                // `Journey.born`.
                journey = Journey.born();
                kin = new Kinship(slot) on heap;
                // AND IT IS DOING SOMETHING FROM THE FIRST TICK. `Idle` is the floor of the scoring
                // and the only activity that is always enterable, so it is also the only honest
                // value to be born in -- and writing it here rather than trusting the zero is the
                // rule three defects in this slice bought: an unwritten field reads as the zeroth
                // constant of its type, and the zeroth constant is always plausible.
                activity = Activity.Idle;
            }

            public destructor ~Agent() returns void {
                delete kin;
                return;
            }

            // WHAT THIS PERSON IS -- and it is DATA, because standings change.
            //
            // It used to be the TYPE: `Worker extends Agent` answered with a constant, so the
            // subclass was the standing. That cannot express what the model asks for, and the
            // `Worker` file said so itself without anybody hearing it -- "a soldier is recruited, a
            // scout is recruited, and a protagonist is raised when a city has none". All three are
            // a person CHANGING what they are, a live object does not change type, and the id has to
            // stay exactly where it is because every chain in this game holds ids.
            //
            // The hierarchy stays for the state a standing ADDS when it has any. Sixty-nine places
            // ask `standing()` and not one asks what type the object is, which is the same fact seen
            // from the other side.
            private mutable AgentClass rank;

            public method standing() returns AgentClass {
                return rank;
            }

            // RAISED, RECRUITED, OR PUT BACK. One method, because the three are one event seen from
            // different sides -- and because a standing writable from anywhere is one that will be
            // written from two places that disagree.
            public method becomes(AgentClass what) returns void {
                rank = what;
                return;
            }

            // Where it is standing, in cells. Read often enough -- by the index, by the bake, by
            // everything that asks who is near -- to be worth naming rather than reaching through
            // two fields for.
            public method x() returns float {
                return whereabouts.position.x;
            }

            public method y() returns float {
                return whereabouts.position.y;
            }
        }
    }
}
