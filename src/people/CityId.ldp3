import System.IO.Console;
program AgentsExe;

// WHICH CITY, as a type of its own rather than an int.
//
// It is a `newtype` for the reason every id here is: a city index and a building index and an agent
// index are all integers, they are all in scope in the same methods, and nothing but the type stops
// one being passed where another belongs. The work layout asks for exactly this, and for a sample
// that proves the compiler refuses the swap.
public bundle Agents {
    public namespace People {

        public newtype CityId = int;
    }
}
