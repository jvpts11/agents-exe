import Agents.People.Agent;
import Agents.People.AgentClass;
import Agents.People.AgentId;
program AgentsExe;

// THE STANDING EVERYBODY IS BORN INTO, and the one the whole world rests on.
//
// A worker holds any Craft job -- gathering, farming, smithing, hauling -- which is every job that
// makes something. The other three standings are all made OUT of workers: a soldier is recruited, a
// scout is recruited, and a protagonist is raised when a city has none and needs one. Nobody is
// born a soldier; a child of two scouts is born a scout; everybody else's child is a worker.
//
// IT HAS NO FIELDS OF ITS OWN, and that is the correct shape rather than an unfinished one. What a
// worker is, is a person with no further qualification -- the extra state belongs to the standings
// that have something extra to be: a soldier's morale and army, a scout's mission, a protagonist's
// office and bloodline. A class with nothing added is exactly what "the ordinary case" looks like
// when the special cases are honest about being special.
public bundle Agents {
    public namespace People {

        public class Worker extends Agent {
            public constructor Worker(AgentId slot) {
                super(slot);
            }
            // NO `standing()` HERE ANY MORE, and its absence is the point. It used to be this
            // class's whole content -- a constant returned by an override -- which is exactly what
            // made it impossible for anybody to be raised, recruited or put back. `Agent` carries
            // the standing as a field now, born a Worker; this class is what you INSTANTIATE rather
            // than what you ARE.
        }
    }
}
