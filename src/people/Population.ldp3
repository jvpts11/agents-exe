import System.IO.Console;
import Agents.People.Agent;
import Agents.People.AgentId;
import Agents.People.AgentClass;
import Agents.People.Worker;
import Agents.People.Kindred;
import Agents.People.Sex;
import Agents.People.Orientation;
import Agents.People.Identity;
import Agents.People.Body;
import Agents.Sim.BlockChain;
import Agents.Sim.TFiler;
import Agents.World.Rng;
program AgentsExe;

// EVERYBODY ALIVE, and where each of them is standing.
//
// THE SAME SHAPE AS `Wild`, DELIBERATELY, and in one place the same CLASS: the block index is
// `BlockChain`, the one the animals use, which was written slot-shaped and ignorant of what its
// integers mean for exactly this day. Not a shape copied twice -- the same code, asked a second
// question. Everything that wants to know who is near a place asks it, and asking it costs a walk
// of one block's chain instead of a walk of the population.
//
// GROUPED BY STANDING, which is the layout design's storage rule, and today there is one standing
// to group: everybody is a `Worker` until something recruits or raises them, which is S3 and S5. The
// second array arrives with the second standing rather than being written empty now.
//
// A SLOT IS A PERSON AND A DEATH IS A SWAP-REMOVE, which is the same trade the animals make and has
// the same price: the last person alive moves into the dead one's slot, so every id that pointed at
// the last one now points at somebody else. `bury` moves the block index with it. Kinship and
// marriage, when they arrive in S2.6, are relations that have to be maintained through this -- which
// is why they will be relations and not stored numbers.
//
// NO CEILING. The array doubles; the index grows with it; nothing here has a maximum written into
// it. That is the design's own line and the per-tick pass over the whole population is what it is
// judged on -- which is why the block index is here in the first slice that has people at all,
// rather than added once a sweep gets slow.
public bundle Agents {
    public namespace People {

        public class Population applies TFiler {
            // Everybody alive, contiguous, slot-indexed. `Agent*` and not `Worker*`: the array holds
            // one standing today and the tick that walks it will hold four.
            private mutable Agent*[] folk;
            private mutable int alive;
            private mutable int room;

            // (WHO STANDS WHERE is `TFiler`'s applied field and its procedures -- the same index and
            // the same code the animals keep, because a crowd of people and a crowd of animals are
            // the same problem. This class supplies the three lines that differ, at the bottom.)

            // What the world has done to its people, kept as it happens rather than swept for.
            private mutable long born;
            private mutable long died;
            // The stream every birth draws its lifetime from. ITS OWN, and not the world's: a
            // stream shared between the animals and the people would make how long a person lives
            // depend on how many animals happened to be born first -- the same defect the fauna's
            // own note warns about, one layer over.
            private mutable Rng* dice;

            // The ages a person may be born to reach. From the model: eighty to a hundred and
            // twenty. A year is twenty seconds of world (see `Clock`), so that is twenty-seven to
            // forty minutes at gear one -- a life somebody can sit and watch.
            public static fixed int SHORTEST_LIFE = 80;
            public static fixed int LONGEST_LIFE = 120;

            // HOW A HUNDRED PEOPLE ARE ORIENTED. The model names the four and does not give their
            // proportions, so these are a choice and are written where a choice can be found and
            // changed -- the audit's own instruction about the numbers it flagged (A9).
            private static method anOrientation(int roll) returns Orientation {
                if (roll < 88) {
                    return Orientation.Straight;
                }
                if (roll < 94) {
                    return Orientation.Gay;
                }
                if (roll < 99) {
                    return Orientation.Bisexual;
                }
                return Orientation.Asexual;
            }

            public constructor Population(int width, int height) {
                room = 256;
                folk = new Agent*[room]();
                alive = 0;
                blocks = new BlockChain(width, height, room) on heap;
                born = cast<long>(0);
                died = cast<long>(0);
                dice = new Rng(width * 31 + height * 17 + 0x11FE) on heap;
            }

            public destructor ~Population() returns void {
                for (int i in 0..alive) {
                    delete folk[i];
                }
                delete folk;
                delete blocks;
                delete dice;
                return;
            }

            public method count() returns int {
                return alive;
            }

            // THE POPULATION'S OWN CHANCE, lent out. Everything about people that turns on luck --
            // how long they live, who they are, how many come of a pregnancy -- draws from this one
            // stream, for the reason written on the field: a second stream would make one person's
            // luck depend on how many of somebody else's rolls happened first.
            public method roll(int bound) returns int {
                return dice.nextInt(bound);
            }

            public method wasBorn() returns long {
                return born;
            }

            public method hasDied() returns long {
                return died;
            }

            // Somebody, by slot. Borrowed: they die with the population.
            public method at(AgentId who) returns Agent* {
                return folk[cast<int>(who)];
            }

            private method growFolk() returns void {
                int bigger = room * 2;
                mutable Agent*[] next = new Agent*[bigger]();
                for (int i in 0..alive) {
                    next[i] = folk[i];
                }
                delete folk;
                folk = next;
                room = bigger;
                roomForMore(room);
                return;
            }

            // A PERSON ARRIVES. Everybody is born a worker -- the other three standings are made out
            // of workers rather than born, which is the model's own rule and the reason this method
            // does not take a standing.
            //
            // The caller fills in who they are: this places them, files them and counts them, and
            // nothing else. A birth with parents -- names, nature, nations from both -- is S2.6's,
            // and it will call this and then fill the parts in.
            public method bear(float x, float y) returns AgentId {
                if (alive == room) {
                    growFolk();
                }
                int at = alive;
                Worker* one = new Worker(at) on heap;
                one.whereabouts.position = vec2(x, y);
                // THE AGE IT WILL REACH, ROLLED HERE, AT THE BIRTH -- which is where the model says
                // it is rolled, and the only place it can be: drawn later, a person who is already
                // old could draw an age they have passed and die twice over; shared, a whole
                // generation dies on the same afternoon. The fauna paid for that one exactly
                // (S1: every animal sown at age nought, whole cohorts gone at the same tick).
                one.body.diesAt = Population.SHORTEST_LIFE
                                  + dice.nextInt(Population.LONGEST_LIFE
                                                 - Population.SHORTEST_LIFE + 1);
                // AND WHO IT IS, which is rolled here for the same reason and was rolled NOWHERE
                // until this line. Every part of an agent is zeroed at birth, so the whole world
                // was `Sex.Female` and `Orientation.Straight` -- five thousand women, none of whom
                // could court any of the others, and not one marriage in thirty-four years. The
                // fields were right, the enums were right, and nobody was ever asked.
                //
                // It is the third time this exact shape has bitten in this slice: a body born with
                // no health, a person born with no sex. A field that nothing writes reads as the
                // zeroth constant of its type, and the zeroth constant is always plausible.
                one.identity.sex = cast<Sex>(dice.nextInt(2));
                one.identity.orientation = Population.anOrientation(dice.nextInt(100));
                folk[at] = one;
                alive = alive + 1;
                born = born + cast<long>(1);
                fileAt(at, x, y);
                return cast<AgentId>(at);
            }

            // AND ONE LEAVES. The last person moves into the slot, exactly as an animal does, and
            // the index is moved with them before anybody can read it stale.
            public method bury(AgentId who) returns void {
                int at = cast<int>(who);
                if (at < 0 || at >= alive) {
                    return;
                }
                unfile(at);
                // EVERYBODY WHO KNEW THEM IS TOLD, BEFORE THE SLOT IS REUSED. A tie is a slot
                // number written inside somebody else's chain, so a death that is not announced
                // leaves a widow married to whoever moves into the grave -- which is not a crash,
                // and is the worst kind of defect this project has met. See `Kindred.buried`.
                int last = alive - 1;
                Kindred.buried(this, at, last);
                delete folk[at];
                if (at != last) {
                    folk[at] = folk[last];
                    folk[at].kin.renumber(at);
                    refile(last, at, folk[at].x(), folk[at].y());
                }
                folk[last] = 0 as Agent*;
                alive = alive - 1;
                died = died + cast<long>(1);
                return;
            }

            // THE ONLY WAY A PERSON MOVES, so the index cannot be left behind. Cheap when they
            // stayed in their cell, which is nearly every call -- see `BlockChain.put`.
            public method placeAt(AgentId who, float x, float y) returns void {
                int at = cast<int>(who);
                folk[at].whereabouts.position = vec2(x, y);
                fileAt(at, x, y);
                return;
            }

            // ---- what `TFiler` needs to know about people ------------------------------------------
            //
            // The three lines that differ between a crowd of people and a crowd of animals. An animal
            // is twenty bytes of value in an array; a person is an object with parts. Everything else
            // about standing somewhere and being filed for it is the same code.

            protected procedure howManyStand() returns int {
                return alive;
            }

            protected procedure xOfSlot(int slot) returns float {
                return folk[slot].x();
            }

            protected procedure yOfSlot(int slot) returns float {
                return folk[slot].y();
            }
        }
    }
}
