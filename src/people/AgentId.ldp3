program AgentsExe;

// WHICH PERSON, as the slot it stands in.
//
// The same seam as `BeastId`, for the same reason and with the same warning: it is an INDEX AND NOT
// A HANDLE. A person who dies leaves the array by swap-remove, so the last one takes the dead one's
// slot and every id that pointed at the last one now points at somebody else. Anything that holds
// an `AgentId` across a death has to be told -- which is why kinship, marriage and employment are
// relations that get maintained rather than numbers that get stored and hoped over.
//
// A type of its own so that an agent's slot cannot be handed where a building's or an animal's was
// meant. All three are ints, and all three would compile.
public bundle Agents {
    public namespace People {

        public newtype AgentId = int;
    }
}
