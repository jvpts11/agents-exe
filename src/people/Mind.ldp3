import System.IO.Console;
import Agents.People.Gauge;
import Agents.People.Mood;
program AgentsExe;

// THE MENTAL STATE: how well it is holding up, how it feels, and what it was born with or acquired.
//
// The three are different questions and that is why they are three fields. `sanity` is a quantity
// that moves; `mood` is one of four things it is feeling right now; `conditions` is a set of lasting
// facts about it -- autism, ADHD, psychosis, sociopathy -- which are neither a quantity nor
// exclusive.
//
// A BITMASK FOR THE CONDITIONS: a bounded catalogue, an agent may have several at once, sixty-four
// of them fit in eight bytes, and "does this agent have that one" is a single AND.
//
// PREGNANCY IS NOT IN HERE, and the day it was is worth remembering: a bit says WHETHER, and a
// pregnancy has a term and an outcome. It lives in `Body` with the tick it began and how many are
// coming (audit A7).
public bundle Agents {
    public namespace People {

        public struct Mind {
            public mutable Gauge sanity;      // 0..100
            public mutable Mood mood;
            public mutable long conditions;   // one bit per condition in the world's catalogue

            public method has(int condition) returns boolean {
                return ((conditions >> condition) & cast<long>(1)) != 0;
            }

            public method take(int condition) returns void {
                conditions = conditions | (cast<long>(1) << condition);
            }
        }
    }
}
