import System.IO.Console;
import Agents.People.Sex;
program AgentsExe;

// WHO AN AGENT CAN PAIR WITH, and nothing else. It is the field that used to be called `genre` --
// a false friend of the Portuguese *género*, naming a third concept again -- and the audit's A5.
//
// THERE IS NO GENDER-IDENTITY FIELD, decided 2026-08-13. The model holds `sex` and `orientation`
// because each has consequence in the world: sex decides who can gestate, orientation decides which
// pairings are possible. A field with no consequence is a field nobody maintains, and the next
// audit finds it as decoration.
public bundle Agents {
    public namespace People {

        public sealed enum Orientation permits
            Straight,
            Gay,
            Bisexual,
            Asexual;
        {
            // Whether an agent of `mine` could court one of `theirs`. The one question this field
            // exists to answer, asked in the one place, so courtship never spells it out again.
            //
            // A total match over both, and no `default`: a fifth orientation would be reported here
            // rather than falling into whatever the fallback happened to say.
            public method courts(Sex mine, Sex theirs) returns boolean {
                return match (this) {
                    case Straight -> cast<int>(mine) != cast<int>(theirs);
                    case Gay -> cast<int>(mine) == cast<int>(theirs);
                    case Bisexual -> true;
                    case Asexual -> false;
                };
            }
        }
    }
}
