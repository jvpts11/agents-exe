import System.IO.Console;
import Agents.World.BuildingKind;
import Agents.World.Builds;
import Agents.World.Good;

// Every building standing or going up in the world, as one table. A building is an INDEX, the same
// as an agent and a node, and for the same reason: the questions asked of it are "what is at this
// community" and "who works here", both of which are loops.
//
// The state is deliberately three words and not a class hierarchy. A site is a decision somebody has
// made and not yet paid for; a building under construction is a site with hours in it; a working
// building is one whose hours are done. There is no behaviour that differs by state -- only numbers
// -- so a byte says which and the simulation branches on it.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        public enum Standing {
            Site,            // marked out, nothing built
            Raising,         // work going in
            Working,         // finished, in use
            Gone             // pulled down; the row is dead and the ground is free again
        }

        public class Buildings {
            private mutable int n;
            private mutable int cap;
            private mutable short[] bx;
            private mutable short[] by;
            private mutable byte[] kind;
            private mutable short[] owner;      // the community it belongs to
            private mutable byte[] state;
            private mutable float[] effort;     // hours put into raising it
            private mutable short[] hands;      // people working it right now
            private mutable float[] batch;      // seconds into the current batch
            private mutable long[] made;        // batches finished, per building
            private mutable int[] idle;         // censuses running with nobody working it
            // Bumped by anything that changes what the map SHOWS. The renderer used to watch the
            // count, which was true while buildings only ever appeared; now that one can be pulled
            // down or rebuilt as something taller without the count moving, the count is a stale
            // question and this is the honest one.
            private mutable int stamp;

            public constructor Buildings(int capacity) {
                this.n = 0;
                this.cap = capacity;
                this.bx = new short[capacity]();
                this.by = new short[capacity]();
                this.kind = new byte[capacity]();
                this.owner = new short[capacity]();
                this.state = new byte[capacity]();
                this.effort = new float[capacity]();
                this.hands = new short[capacity]();
                this.batch = new float[capacity]();
                this.made = new long[capacity]();
                this.idle = new int[capacity]();
                this.stamp = 0;
            }

            public destructor ~Buildings() returns void {
                delete this.bx;
                delete this.by;
                delete this.kind;
                delete this.owner;
                delete this.state;
                delete this.effort;
                delete this.hands;
                delete this.batch;
                delete this.made;
                delete this.idle;
            }

            public method count() returns int {
                return this.n;
            }

            public method limit() returns int {
                return this.cap;
            }

            public method version() returns int {
                return this.stamp;
            }

            // Mark out a site. Nothing is spent yet: the cost comes out of the store when the
            // builders have actually raised it, so a village cannot lose its wood to a plan.
            public method mark(int x, int y, int k, int comm) returns int {
                if (this.n >= this.cap) {
                    return 0 - 1;
                }
                int i = this.n;
                this.n = this.n + 1;
                this.bx[i] = cast<short>(x);
                this.by[i] = cast<short>(y);
                this.kind[i] = cast<byte>(k);
                this.owner[i] = cast<short>(comm);
                this.state[i] = cast<byte>(cast<int>(Standing.Site));
                this.effort[i] = 0.0;
                this.hands[i] = cast<short>(0);
                this.batch[i] = 0.0;
                this.made[i] = 0;
                this.idle[i] = 0;
                this.stamp = this.stamp + 1;
                return i;
            }

            public method xAt(int i) returns int {
                return cast<int>(this.bx[i]);
            }

            public method yAt(int i) returns int {
                return cast<int>(this.by[i]);
            }

            public method kindOf(int i) returns int {
                return cast<int>(this.kind[i]) & 255;
            }

            public method ownerOf(int i) returns int {
                return cast<int>(this.owner[i]);
            }

            public method stateOf(int i) returns int {
                return cast<int>(this.state[i]) & 255;
            }

            public method isWorking(int i) returns boolean {
                return this.stateOf(i) == cast<int>(Standing.Working);
            }

            public method madeAt(int i) returns long {
                return this.made[i];
            }

            public method isGone(int i) returns boolean {
                return this.stateOf(i) == cast<int>(Standing.Gone);
            }

            // Pull it down. The row stays -- indices are handed out to agents as workplaces and
            // reusing one would silently move a craftsman to another village's forge -- but nothing
            // finds it again and the renderer stops drawing it.
            public method demolish(int i) returns void {
                this.state[i] = cast<byte>(cast<int>(Standing.Gone));
                this.hands[i] = cast<short>(0);
                this.stamp = this.stamp + 1;
                return;
            }

            // Rebuild THIS plot as something bigger. The one in-place upgrade the catalogue allows,
            // and the reason it is in place rather than a fresh site beside it: a village that
            // densifies looks different from a village that sprawls, and the difference is the
            // whole visual read on whether a place is thriving.
            public method recast(int i, int k) returns void {
                this.kind[i] = cast<byte>(k);
                this.state[i] = cast<byte>(cast<int>(Standing.Site));
                this.effort[i] = 0.0;
                this.hands[i] = cast<short>(0);
                this.batch[i] = 0.0;
                this.idle[i] = 0;
                this.stamp = this.stamp + 1;
                return;
            }

            // Every per-community question the census asks, answered in ONE pass over the table.
            //
            // Written the obvious way this was five separate loops -- how much roof, which roof is
            // meanest, is anything half-built, is any workshop dead, is any bench free -- each run
            // once per community, and two of them run once per PERSON per decision. That is the
            // same mistake the woodcutter made and the wolves made: a question asked in the wrong
            // place. A building has exactly one owner, so one read of each row can answer all five
            // for all of them, and the cost stops depending on how many places there are.
            //
            // The answers are a census old by the time anyone acts on them. That is not a
            // compromise: `hands` itself is only counted at census, so a live scan was never any
            // fresher -- it just cost more to be equally stale.
            public method sweep(int[] pop, int[] room, int[] worst, int[] worstRoom, int[] dead,
                                int[] busy, int[] open, int[] made, int[] seat,
                                int ncomm, int ncraft, int seatKind) returns void {
                for (int c in 0..ncomm) {
                    room[c] = 0;
                    worst[c] = 0 - 1;
                    worstRoom[c] = 0;
                    dead[c] = 0 - 1;
                    busy[c] = 0 - 1;
                    seat[c] = 0 - 1;
                }
                for (int s in 0..(ncomm * ncraft)) {
                    open[s] = 0 - 1;
                    made[s] = 0;
                }
                for (int i in 0..this.n) {
                    int c = cast<int>(this.owner[i]);
                    if (c < 0 || c >= ncomm || this.isGone(i)) {
                        continue;
                    }
                    // Nobody lives here any more. The village falls down, and -- the part that
                    // matters -- its NUMBER is handed back, because a community slot held by a
                    // ghost is one a real village somewhere else cannot be founded with. The first
                    // run with splitting ended with all five hundred and twelve town halls standing
                    // and only a hundred and sixty-four places alive in the world.
                    if (pop[c] <= 0) {
                        this.demolish(i);
                        continue;
                    }
                    int k = this.kindOf(i);
                    // The seat counts from the moment it is marked out, standing or not: a place
                    // that has decided where its hall goes does not decide again.
                    if (k == seatKind) {
                        seat[c] = i;
                    }
                    if (!this.isWorking(i)) {
                        if (busy[c] < 0) {
                            busy[c] = i;
                        }
                        continue;
                    }
                    int r = Builds.roof(k);
                    if (r > 0) {
                        room[c] = room[c] + r;
                        if (worst[c] < 0 || r < worstRoom[c]) {
                            worst[c] = i;
                            worstRoom[c] = r;
                        }
                        continue;
                    }
                    if (!Builds.produces(k)) {
                        continue;                // the seat: nobody's trade, so never idle
                    }
                    int cr = Builds.craft(k);
                    made[c * ncraft + cr] = made[c * ncraft + cr] + 1;
                    if (cast<int>(this.hands[i]) < Builds.hands(k) && open[c * ncraft + cr] < 0) {
                        open[c * ncraft + cr] = i;
                    }
                    // A workshop nobody has set foot in for a long time. Not decay by age: a
                    // building that is USED does not fall down, and one nobody needs does.
                    if (cast<int>(this.hands[i]) == 0) {
                        this.idle[i] = this.idle[i] + 1;
                        if (this.idle[i] > Buildings.ABANDON && dead[c] < 0) {
                            dead[c] = i;
                        }
                    } else {
                        this.idle[i] = 0;
                    }
                }
                return;
            }

            // Censuses a workshop may stand empty before it is pulled down. Five minutes: long
            // enough that a bad season does not cost a village its forge, short enough that the
            // map stops showing buildings for trades nobody practises any more.
            public static int ABANDON = 300;

            // Put an hour of work into raising it. Returns true on the hour it is finished, so the
            // caller can pay for it exactly once.
            public method raise(int i, float dt) returns boolean {
                if (this.stateOf(i) == cast<int>(Standing.Working)) {
                    return false;
                }
                this.state[i] = cast<byte>(cast<int>(Standing.Raising));
                this.effort[i] = this.effort[i] + dt;
                if (this.effort[i] >= Buildings.RAISE) {
                    this.state[i] = cast<byte>(cast<int>(Standing.Working));
                    return true;
                }
                return false;
            }

            // Seconds of work to put a building up, whatever it is. Size and materials differ by
            // kind; the LABOUR does not, because what a building costs a village in people is the
            // number that decides whether it can afford one at all, and one dial is enough for that
            // until there is a reason for two.
            public static float RAISE = 90.0;

            public method progressOf(int i) returns float {
                return this.effort[i] / Buildings.RAISE;
            }

            public method handsAt(int i) returns int {
                return cast<int>(this.hands[i]);
            }

            public method clearHands() returns void {
                for (int i in 0..this.n) {
                    this.hands[i] = cast<short>(0);
                }
                return;
            }

            public method addHand(int i) returns void {
                this.hands[i] = cast<short>(cast<int>(this.hands[i]) + 1);
                return;
            }

            // A batch of work. The store is not touched here -- the caller owns it and knows whether
            // the inputs are there -- so this only says when a batch has come round.
            public method work(int i, float dt) returns boolean {
                this.batch[i] = this.batch[i] + dt;
                if (this.batch[i] >= Builds.secs(this.kindOf(i))) {
                    this.batch[i] = 0.0;
                    this.made[i] = this.made[i] + 1;
                    return true;
                }
                return false;
            }

            // The first building of a kind belonging to a community, standing or going up, or -1.
            public method find(int comm, int k) returns int {
                for (int i in 0..this.n) {
                    if (cast<int>(this.owner[i]) == comm && this.kindOf(i) == k && !this.isGone(i)) {
                        return i;
                    }
                }
                return 0 - 1;
            }

            // Hand everything one community owns to another. What a merged town keeps is what the
            // two of them built -- losing a forge because two villages grew into each other would
            // make joining up a punishment, and the whole reason a town exists is that it has more
            // in it than either half did. The seat is the exception: a town has one hall, and the
            // second one comes down.
            public method reown(int from, int to, int seatKind) returns void {
                for (int i in 0..this.n) {
                    if (cast<int>(this.owner[i]) != from || this.isGone(i)) {
                        continue;
                    }
                    if (this.kindOf(i) == seatKind) {
                        this.demolish(i);
                        continue;
                    }
                    this.owner[i] = cast<short>(to);
                }
                this.stamp = this.stamp + 1;
                return;
            }

            public method countOfKind(int k) returns int {
                mutable int c = 0;
                for (int i in 0..this.n) {
                    if (this.kindOf(i) == k && this.isWorking(i)) {
                        c = c + 1;
                    }
                }
                return c;
            }

            public method working() returns int {
                mutable int c = 0;
                for (int i in 0..this.n) {
                    if (this.isWorking(i)) {
                        c = c + 1;
                    }
                }
                return c;
            }
        }
    }
}
