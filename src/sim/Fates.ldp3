import System.IO.Console;
import Agents.World.LandMath;

// WHAT THE WORLD DOES TO PEOPLE WITHOUT BEING ASKED.
//
// Everything that has ever happened to a settlement in this simulation was something somebody
// decided. People built, traded, marched and starved; the ground they stood on did nothing at all.
// The generator puts volcanic arcs on the map and marks every vent, rivers run past half the towns
// in the world and the sea reaches a third of them -- and not one of those facts could ever cost
// anybody anything. A volcano was a colour.
//
// So a place is EXPOSED to what it is standing on, and now and then the exposure collects. The five
// here are not a list of effects looking for causes: each one reads a fact the world already has,
// and each one falls on a different thing.
//
//   an eruption   near a vent          kills, levels what stands, and does not care what it was
//   a quake       in broken ground     knocks buildings back to their foundations
//   a fire        in a crowded town    eats the stores and the sheds, and WATER PUTS IT OUT
//   a flood       beside a river       spoils what is in the granary
//   a storm       on the coast         takes the boats
//
// The fire is the one that ties the knot. Wells, fountains and aqueducts were built because people
// were thirsty; a town that has them also does not burn down. Nobody has to be told that -- the
// same building answers two different questions, which is what it is for.
//
// The odds are per exposed place per census, in a hundred thousand, and a place that has just been
// struck gets a rest. Nothing here rolls per person: a calamity is a fact about a PLACE, and asking
// it once a census per town is the same budget every other decision in this world is held to.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        public enum Calamity {
            Nothing,
            Eruption,
            Quake,
            Fire,
            Flood,
            Storm
        }

        public class Fates {
            private static mutable String[] NAME;
            private static mutable int[] ODDS;      // in a hundred thousand, per census, if exposed
            private static mutable int[] REST;      // censuses before this place can be struck again

            onClassLoad {
                int n = Calamity.count();
                Fates.NAME = new String[n]();
                Fates.ODDS = new int[n]();
                Fates.REST = new int[n]();
                mutable int i = 0;
                while (i < n) {
                    Fates.NAME[i] = "nothing";
                    Fates.ODDS[i] = 0;
                    Fates.REST[i] = 0;
                    i = i + 1;
                }
                // A vent that has stood quiet for a lifetime is not a safe vent. Rare, and the one
                // that leaves nothing behind, so the rest is long -- a town does not get two.
                Fates.put(cast<int>(Calamity.Eruption), "eruption", 6, 2400);
                Fates.put(cast<int>(Calamity.Quake), "quake", 14, 1200);
                Fates.put(cast<int>(Calamity.Fire), "fire", 30, 600);
                Fates.put(cast<int>(Calamity.Flood), "flood", 18, 900);
                Fates.put(cast<int>(Calamity.Storm), "storm", 22, 700);
            }

            private static method put(int ord, String name, int odds, int rest) returns void {
                Fates.NAME[ord] = name;
                Fates.ODDS[ord] = odds;
                Fates.REST[ord] = rest;
                return;
            }

            public static method name(int ord) returns String {
                return Fates.NAME[ord];
            }

            public static method odds(int ord) returns int {
                return Fates.ODDS[ord];
            }

            private mutable int n;
            private mutable int[] rest;      // censuses of quiet still owed to each place
            private mutable int[] tally;     // how many of each kind the world has seen
            private mutable int[] toll;      // and what each kind has killed
            private mutable int[] wrecked;   // and pulled down

            public constructor Fates(int ncomm) {
                this.n = ncomm;
                this.rest = new int[ncomm]();
                this.tally = new int[Calamity.count()]();
                this.toll = new int[Calamity.count()]();
                this.wrecked = new int[Calamity.count()]();
            }

            public destructor ~Fates() returns void {
                delete this.rest;
                delete this.tally;
                delete this.toll;
                delete this.wrecked;
                return;
            }

            public method clear() returns void {
                for (int c in 0..this.n) {
                    this.rest[c] = 0;
                }
                for (int k in 0..Calamity.count()) {
                    this.tally[k] = 0;
                    this.toll[k] = 0;
                    this.wrecked[k] = 0;
                }
                return;
            }

            // WHAT FINDS THIS PLACE NOW, or Nothing at all.
            //
            // The exposures are facts the caller already holds: a vent within a walk, ground broken
            // enough to shake, a river at the bottom of the field, salt water and a hull tied up in
            // it. `homes` and `water` are the two that argue with each other -- a town burns in
            // proportion to how much of it there is to burn, and a town with a well and a fountain
            // has people who can put it out.
            //
            // One roll per kind, all of them off the same deterministic hash: the same seed replays
            // the same century, which is what makes any of this measurable.
            public method visit(int c, boolean vent, boolean shaky, boolean river, boolean coast,
                                int homes, int water, int seed, int tick) returns int {
                if (this.rest[c] > 0) {
                    this.rest[c] = this.rest[c] - 1;
                    return cast<int>(Calamity.Nothing);
                }
                if (vent && this.struck(cast<int>(Calamity.Eruption), 100, c, seed, tick, 0x5E11)) {
                    return this.note(c, cast<int>(Calamity.Eruption));
                }
                if (shaky && this.struck(cast<int>(Calamity.Quake), 100, c, seed, tick, 0x21A7)) {
                    return this.note(c, cast<int>(Calamity.Quake));
                }
                // A hamlet of four huts hardly burns; a town of two hundred roofs standing shoulder
                // to shoulder does. And every cistern in it is an argument the other way.
                mutable int heat = 40 + homes * 3;
                if (heat > 400) {
                    heat = 400;
                }
                int damp = 100 + water * 60;
                if (this.struck(cast<int>(Calamity.Fire), heat * 100 / damp, c, seed, tick, 0xF13E)) {
                    return this.note(c, cast<int>(Calamity.Fire));
                }
                if (river && this.struck(cast<int>(Calamity.Flood), 100, c, seed, tick, 0x10D5)) {
                    return this.note(c, cast<int>(Calamity.Flood));
                }
                if (coast && this.struck(cast<int>(Calamity.Storm), 100, c, seed, tick, 0x570E)) {
                    return this.note(c, cast<int>(Calamity.Storm));
                }
                return cast<int>(Calamity.Nothing);
            }

            // `weight` is a hundredth: the base odds scaled by whatever the caller knows makes this
            // place likelier or luckier than the average exposed one.
            private method struck(int kind, int weight, int c, int seed, int tick,
                                  int salt) returns boolean {
                int odds = Fates.ODDS[kind] * weight / 100;
                if (odds <= 0) {
                    return false;
                }
                float roll = LandMath.hash01(seed ^ salt, c, tick);
                return cast<int>(roll * 100000.0) < odds;
            }

            // Written down, and the place given its rest. Public because a calamity can also be
            // AIMED: a player picking a town and a kind goes through the same door the roll does,
            // so the counters and the quiet afterwards are the same either way.
            public method note(int c, int kind) returns int {
                this.rest[c] = Fates.REST[kind];
                this.tally[kind] = this.tally[kind] + 1;
                return kind;
            }

            // What it cost, told by whoever applied it -- this table decides WHAT happens and the
            // simulation decides who it happens to, so the counting has to come back the other way.
            public method cost(int kind, int dead, int down) returns void {
                this.toll[kind] = this.toll[kind] + dead;
                this.wrecked[kind] = this.wrecked[kind] + down;
                return;
            }

            public method timesOf(int kind) returns int {
                return this.tally[kind];
            }

            public method tollOf(int kind) returns int {
                return this.toll[kind];
            }

            public method wreckedOf(int kind) returns int {
                return this.wrecked[kind];
            }

            public method everStruck() returns int {
                mutable int t = 0;
                for (int k in 1..Calamity.count()) {
                    t = t + this.tally[k];
                }
                return t;
            }

            public method everKilled() returns int {
                mutable int t = 0;
                for (int k in 1..Calamity.count()) {
                    t = t + this.toll[k];
                }
                return t;
            }

            public method everWrecked() returns int {
                mutable int t = 0;
                for (int k in 1..Calamity.count()) {
                    t = t + this.wrecked[k];
                }
                return t;
            }
        }
    }
}
