import Agents.Sim.ThreeToALine;
import Agents.Sim.HerdId;
program AgentsExe;

// ONE ANIMAL. A value struct in one array -- no allocation per animal, ever.
//
// That is the constraint the whole fauna layout is built on, and it is the one thing carried over
// from the measurement that killed the previous build: half a million object-agents weighed 2,383 MB,
// of which the scalar fields were forty. The rest was a header and an allocator per part. A beast has
// no parts.
//
// `x` and `y` ARE NOT A `vec2`, deliberately. The tick reads them as columns and writes them back;
// a SIMD pair would buy one add and cost the struct its packing, because a vec2 aligns to eight.
//
// THE BIT FIELDS ARE UNSIGNED, and the first draft of the layout said `int` -- which holds -4..3 in
// three bits, so four of the eight states could never be stored, and -16..15 in five, against
// eighteen species. Six values corrupted in silence, in a section whose every other number had been
// measured. The compiler now warns when a literal will not fit; this declaration is what it was
// warning about.
public bundle Agents {
    public namespace Sim {

        public struct Beast implements ThreeToALine {
            public mutable float  x;
            public mutable float  y;
            public mutable HerdId herd;
            public mutable short  stamina;   // the burst it has left, and the whole of the hunt
            public mutable short  age;
            public mutable uint   species : 5;   // eighteen of them: 0..17 needs five unsigned bits
            public mutable uint   state   : 3;   // eight states: 0..7 needs three unsigned bits
        }
    }
}
