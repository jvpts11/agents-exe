import System.IO.Console;
import System.Time.Time;
import System.OS.Machine;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.Rng;
import Agents.Sim.Chronicle;
import Agents.Sim.Wild;
import Agents.Sim.World;
import Agents.Sim.Layer;
import Agents.Sim.Grazing;
import Agents.Sim.Seeding;
import Agents.People.Census;
import Agents.People.Journalling;
import Agents.People.Population;
import Agents.People.Banding;
import Agents.People.Walking;
import Agents.People.Roaming;
import Agents.People.Journal;
import Agents.People.Living;
import Agents.People.Foraging;
import Agents.People.Courting;
import Agents.People.Doings;
import Agents.People.Hunting;
import Agents.World.Waymap;
import Agents.Nations.Atlas;
import Agents.Nations.City;
import Agents.Nations.Larder;
import Agents.Nations.Succession;
import Agents.Nations.Refusal;
import Agents.Nations.Settling;
import Agents.Nations.Claiming;
import System.Errors.Result;
program AgentsExe;

// THE WORLD, AND THE THING THAT MAKES IT ADVANCE. It owns the layers and it owns the tick.
//
// It is small, and it is meant to stay small permanently: it holds the layers, it calls their
// passes in order, and it contains no rule of the game. What belongs here is the ORDER the world
// advances in and nothing else -- whether the animals move before the people, whether a city
// decides before or after the person walking to it. That order is a fact about the whole world, so
// it lives in one file where it can be read in ten seconds.
//
// WHY IT EXISTS AT ALL, which the name does not say. Until now the tick loop lived inside
// `renderGlWorld`, in the middle of the window code, and nothing owned it. The first layer written
// would have put its pass in the RENDER loop, the second would have followed it there, and within
// a few slices the order the world advances in would be spread across a drawing method. That is
// not a hypothetical: it is one of the causes of the fourteen-thousand-line class this project
// deleted and is now rebuilding.
//
// THERE ARE NO LAYERS YET. `Wild`, `Population` and `Atlas` arrive one per slice, and each one
// adds a line to `tick`. Being empty is the point: the empty tick is what the first real cost gets
// measured against.
public bundle Agents {
    public namespace Sim {

        public class Sim {
            // THE WORLD ITSELF, which this class used to BE as well as advance. Everything that
            // simply IS -- the ground, the crowd, the animals, the country, the routes, the draw,
            // the record, and how old it all is -- moved into one object, and what is left here is
            // the loop: the gear, the frame budget, the stopwatch and the ORDER.
            //
            // The split is along "what would still be true if nothing ticked". It pays rather than
            // merely tidies because every system takes a subset of exactly those handles:
            // `Grazing.tick(beasts, folk, ground, at, dice, log)` and
            // `Doings.tick(folk, realm, ground, ways, at)` are one call with different holes.
            private mutable World* state;
            // THE ORDER THE WORLD ADVANCES IN, as a list. It was a method body, and every line of it
            // carried the reason it was where it was -- those reasons are now beside the entries in
            // `layOut`, which is the one place a reader has to look to know what happens when.
            //
            // Owned: fourteen objects with no state of their own, made once and freed with the Sim.
            private mutable Layer*[] order;
            private mutable int layers;
            // The fraction of a tick carried over from the last call. THE WORLD ADVANCES A WHOLE
            // NUMBER OF TIMES OR NOT AT ALL, so anything left over waits rather than being rounded
            // away -- rounded down, a pace below one never advances anything; rounded up, every
            // slow pace becomes one tick a call and the slow gears all run at the same speed.
            private mutable float owed;
            // Ticks that were owed and refused by the ceiling. See `missed`.
            private mutable long behind;
            // Nanoseconds spent advancing, ever. THE FLOOR EVERY LATER COST IS READ AGAINST: an
            // empty tick has a price, and knowing it is what makes "the fauna costs 40 ns a beast"
            // a number instead of an impression.
            //
            // Free to collect, which is why it is here rather than approximated later: `advance`
            // already reads the clock twice a frame for the budget, and this reads it twice more.
            // Reading it per TICK would cost more than the tick does.
            private mutable long spent;
            // How many times `advance` was called -- the divisor that makes `spent` readable. See
            // `report`: without it, the same empty tick reads 178 ns at gear 1 and 2 ns at gear 6.
            private mutable long advances;
            // WHAT THE PEOPLE COST, whole: nanoseconds across all seven of their passes, and the
            // person-ticks to divide it by. Static because the fauna's own meter is, and because
            // the pair are read together in `report` -- two counters that could disagree about which
            // run they belong to would be worse than none.
            private static mutable long peopleNs;
            private static mutable long peopleTicks;

            // How long a frame may spend advancing the world, in milliseconds. A frame at sixty a
            // second is about seventeen; half of it to the simulation leaves the other half to draw
            // in, and a world that wants more than that is a world going faster than it can be
            // watched.
            //
            // A BUDGET OF TIME, NOT A COUNT OF TICKS, and the difference is the whole of defect
            // S0-5. A ceiling of 64 ticks against gear 6's 300 meant the top gear could never be
            // run -- not "this machine cannot keep up" but arithmetic, on every machine, forever:
            // 41,920 ticks run and 154,580 refused in a ten-second measurement. A count cannot be
            // right, because it is a quantity of WORK measured in the wrong unit: 64 empty ticks
            // are free and 64 ticks of a full world are a third of a second.
            //
            // This project already learned it once. The old build hit "2 fps is not the renderer:
            // the catch-up was 240 TICKS a frame, a count rather than an amount of work", and the
            // fix was exactly this -- a slice of time -- which took 3 fps to 34 for the same world
            // per second. The rebuild made it a count again.
            public static fixed int BUDGET_MS = 8;

            // How often the world says out loud what its people are doing. Twenty years is a
            // fifth of a life: often enough to see a generation turn over, rare enough that a
            // three-hundred-year run is fifteen lines.
            public static fixed int CENSUS_EVERY_YEARS = 20;
            // How often the world is asked whether anybody has settled, in ticks. Sixty is a second
            // of world at gear 1, which is the pace a founding happens on -- a question asked every
            // tick would be asked three hundred times a frame at the top gear and answer the same
            // thing each time.
            public static fixed int SETTLE_EVERY = 60;

            // The size of the world a game is played on.
            public static fixed int WIDTH = 2560;
            public static fixed int HEIGHT = 1440;

            // A SIM IS A SEED AND AN EXTENT, from the moment it exists. Everything cheap is built
            // here -- the animals, the draw, the record -- and only the TERRAIN waits for
            // `buildWorld`, because generating it takes seconds and a check of the tick's own
            // arithmetic should not have to pay for a coastline.
            //
            // It used to take nothing and be told the seed and the size later, and that was wrong in
            // a way the compiler pointed out: a Wild is cut to the size of the ground it stands on,
            // so a Sim that does not yet know its size cannot have one, and the field had to be
            // absent -- which is a two-step construction, and the second step is the one somebody
            // forgets. Nothing here is optional now except the ground itself.
            public constructor Sim(int seed, int width, int height) {
                owed = 0.0;
                behind = 0;
                spent = 0;
                advances = 0;
                state = new World(seed, width, height) on heap;
                // THE TICK IS SHARED BETWEEN THREE QUARTERS OF THE MACHINE, and the quarter left over
                // is not politeness -- it is the renderer, the graphics driver and the operating
                // system, which are running at the same time and need somewhere to run.
                //
                // MEASURED ON THE REAL GAME (`game gear=6 for=10 hands=N`), sixteen hardware threads,
                // twenty-one thousand animals, in ticks a frame at gear 6 against the 300 asked for:
                //
                //     hands   1     2     4     6     8    12    16
                //     ticks  59.3  75.0  76.3  70.4  74.4  92.9  82.3
                //
                // Twelve is the top of that curve and sixteen is over it: with a hand on every
                // hardware thread the renderer is fighting the tick for the machine, and at gear 1
                // the same run drew 595 frames where twelve hands drew 1,411.
                //
                // Three quarters rather than "minus four", so it degrades the right way: a four-core
                // machine shares between three, a two-core machine keeps its single hand.
                //
                // A world built by a check keeps the one hand it is born with -- checks do not open
                // windows and must not open threads.
                state.wild().shareBetween(Machine.threads() * 3 / 4);
                layOut();
            }

            // THE ORDER THE WORLD ADVANCES IN. Every reason below was a comment inside the tick, and
            // every one of them is a constraint rather than a preference: this list is the file to
            // read to know what happens when.
            private method layOut() returns void {
                layers = 14;
                order = new Layer*[layers]();
                mutable int n = 0;
                // THE ANIMALS FIRST, and before anything reads either crowd.
                order[n] = new Grazing() on heap;                   n = n + 1;

                // --- and here the people's account opens: everything from here to `Walking` is
                // what a person costs, measured as one bracket. See `tick`.

                // A YEAR OF BEING ALIVE, on the tick a year turns. Before the walking, so somebody
                // who dies this year does not take a step first.
                order[n] = new Living() on heap;                    n = n + 1;
                // AND THEN EVERYBODY WHOSE TURN IT IS DECIDES WHAT THEY ARE DOING. Before all four
                // doers below, because every one of them ACTS on the activity rather than deciding
                // for itself -- and after the ageing, so a body that crossed eighteen this year may
                // want what an eighteen-year-old wants in the same tick.
                order[n] = new Doings() on heap;                    n = n + 1;
                // AND EVERY SO OFTEN THE WORLD SAYS WHAT IT IS DOING, while it is still doing it.
                order[n] = new Census() on heap;                    n = n + 1;
                // Marrying, carrying and being born. After the ageing, so somebody who came of age
                // this year may be courted in it.
                order[n] = new Courting() on heap;                  n = n + 1;
                // AND THEN THEY GO AND EAT, before the wandering gets a say: a hungry person has
                // somewhere to be, and a wander that overwrote that would send them off to look at
                // the scenery with a bush in front of them.
                order[n] = new Foraging() on heap;                  n = n + 1;
                // AND THE SHELF BETWEEN GATHERING AND EATING. After foraging, because what a person
                // is carrying at this moment is what foraging just decided; before it, the store
                // would be serving last tick's hands.
                order[n] = new Larder() on heap;                    n = n + 1;
                // AND WHOEVER IS AFTER SOMETHING KEEPS COMING. After the foraging, because a hunter
                // who found a bush on the way has found food and the chase can end; and before the
                // walking, because a chase moves a body itself rather than through a journey -- its
                // destination changes every tick and a route search per tick per hunter is ledger
                // S2-7 with a moving end.
                order[n] = new Hunting() on heap;                   n = n + 1;
                order[n] = new Roaming() on heap;                   n = n + 1;
                order[n] = new Walking() on heap;                   n = n + 1;

                // --- and it closes here. What follows is the country, deliberately outside it: a
                // pass that runs once a year over BLOCKS would flatter the crowd's number by being
                // averaged into it.

                // IS THERE A COUNTRY YET, and if not, which of the six reasons.
                order[n] = new Settling() on heap;                  n = n + 1;
                // AND THE BORDERS MOVE.
                order[n] = new Claiming() on heap;                  n = n + 1;
                // AND WHOEVER IS MISSING FROM A POST IS REPLACED. With the ageing and the claim,
                // because a ruler dies a handful of times a century.
                order[n] = new Succession() on heap;                n = n + 1;
                // AND EVERY AGENT'S EVERY FIELD IS WRITTEN DOWN, if a run asked for that. LAST, so a
                // row is the world as the tick LEFT it rather than half way through being decided.
                order[n] = new Journalling() on heap;               n = n + 1;
                return;
            }

            // WRITE EVERY AGENT'S EVERY FIELD, EVERY TICK, TO THIS FILE. Off by default, because a
            // few thousand agents over a few hundred ticks is hundreds of megabytes -- and on when a
            // run wants to be analysed afterwards rather than summarised on the way out.
            public method keepJournal(String path) returns void {
                state.keepJournal(path);
                return;
            }

            // THE WORLD ITSELF, for whoever wants it whole rather than a handle at a time. The
            // seven forwarders below are what the callers already say, kept so that moving the
            // state out of this class was not also a rename at nineteen call sites.
            public method now() returns World* {
                return state;
            }

            // What the journal wrote, for the line the run prints on its way out.
            public method journal() returns Journal* {
                return state.journal();
            }

            // Share the tick between this many hands, overriding what the machine suggested. For
            // measuring the number the line above chose, on a machine that is not this one.
            public method shareBetween(int many) returns void {
                state.wild().shareBetween(many);
                return;
            }

            // The animals. Borrowed: they die with the Sim.
            public method wild() returns Wild* {
                return state.wild();
            }

            // And the people. Borrowed, the same way.
            public method people() returns Population* {
                return state.people();
            }

            // And the countries. Borrowed, the same way -- the renderer reads it to draw what stands.
            public method nations() returns Atlas* {
                return state.nations();
            }

            // What every block costs to cross, and the search that reads it. Borrowed; it exists
            // only once the ground does.
            public method routes() returns Waymap* {
                return state.routes();
            }

            public destructor ~Sim() returns void {
                for (int i in 0..layers) {
                    delete order[i];
                }
                delete order;
                delete state;
                return;
            }

            // Where every layer says what it did. Borrowed: it dies with the Sim.
            public method chronicle() returns Chronicle* {
                return state.chronicle();
            }

            // Generate the ground and take it over.
            //
            // THE SEARCH IS PART OF IT, not something each caller remembers. A world is SEARCHED
            // for rather than merely rolled -- three seeds in twelve produce one the criteria
            // reject, one continent and five scraps or fourteen islands -- and while that lived at
            // the call site, every caller carried the same eight arguments and could quietly get
            // one wrong. There is one way to make the world now.
            //
            // `loud` because the search prints a line per rejected roll, which a player waiting on
            // a window wants and a test run does not.
            //
            // AND IT SOWS THE WORLD IT MADE. Making the ground and putting the animals on it were
            // two calls at the call site, in that order, and the order mattered -- which is a thing
            // to get wrong for no gain. A world arrives with what lives in it.
            //
            // IT IS THE WORLD'S OWN, and this is one line because of it: making the ground, labelling
            // its continents, measuring its routes and sowing what lives on it are all things the
            // world does to itself, and none of them is about the tick.
            public method buildWorld(boolean loud) returns void {
                state.build(loud);
                return;
            }

            // The ground, for whoever draws it or reads it. Borrowed, never owned by the caller:
            // it dies with the Sim.
            public method world() returns Grid* {
                return state.ground();
            }

            // Advance the world by however many whole ticks `pace` has earned, spending at most
            // `budgetMillis` doing it, and answer how many actually ran.
            //
            // `pace` is a NUMBER OF TICKS, not a gear and not a speed. The Sim does not know what a
            // gear is and must not: which gear the player chose, and whether the game is paused,
            // are things the window knows. A paused world is a window that does not call this.
            //
            // THE BUDGET IS THE CALLER'S, and that is not indecision. A frame has one to give and a
            // headless run has none to spend, and neither is a fact about the world. It is also
            // what makes the ceiling testable at all: an empty tick is free, so the only way to see
            // the cut happen is to ask for no time.
            // THE DEADLINE IS IN NANOSECONDS, AND IT USED TO BE IN MILLISECONDS, WHICH DID NOT WORK.
            // `Time.millis()` is wall-clock, off `GetSystemTimeAsFileTime`, and on Windows that
            // advances in steps of about fifteen milliseconds. An eight-millisecond ceiling read
            // with a fifteen-millisecond ruler is not a ceiling: the first measured world spent
            // 14.1 ms a frame under an 8 ms budget -- 76% over, invisibly, because every reading
            // inside one system tick says the same number. `Time.nanos()` is
            // QueryPerformanceCounter, it was ALREADY being read here for the cost, and using it
            // for both means one clock read instead of two.
            //
            // This is the same shape as the defect the budget itself was made to fix (ledger S0-5):
            // a limit that cannot be enforced by the instrument that reads it, reporting compliance
            // it never had.
            public method advance(float pace, int budgetMillis) returns int {
                long began = Time.nanos();
                owed = owed + pace;
                long until = began + cast<long>(budgetMillis) * 1000000;
                mutable int ran = 0;
                while (owed >= 1.0) {
                    tick();
                    owed = owed - 1.0;
                    ran = ran + 1;
                    // Checked AFTER the tick, so a budget of zero still advances the world once.
                    // A frame that advances it not at all is a frozen world, and a machine too slow
                    // for one tick should crawl rather than stop.
                    if (Time.nanos() >= until) {
                        break;
                    }
                }
                // WHAT THE BUDGET REFUSED IS COUNTED, and the backlog is dropped rather than
                // carried -- a queue of ticks nobody can work off only ever grows, and a world
                // running an hour behind is not the world anybody is watching.
                //
                // The counting is the part that was promised and missing. The comment on the old
                // loop said "the shortfall is counted. A gear the machine cannot keep up with has
                // to say so, rather than quietly running slower than the number on the screen" --
                // and then dropped the backlog and counted nothing, which is the very defect that
                // sentence names. A gear the machine cannot sustain looked exactly like one it
                // could: the window says x6, the world goes at x1.3, and every number measured off
                // that run carries a speed it never had.
                if (owed >= 1.0) {
                    long lost = cast<long>(owed);
                    behind = behind + lost;
                    // SAID WHEN IT HAPPENS, which is the whole difference. As a total at the end,
                    // "154,580 ticks refused" cannot tell a world that fell behind once from one
                    // that fell behind on EVERY frame of the run -- and those are different worlds
                    // with the same number. A line per occurrence can be counted afterwards; a
                    // count can never be un-summed.
                    state.chronicle().note(state.age(), "world",
                             $"ran out of frame with {lost} ticks still owed");
                    owed = 0.0;
                }
                spent = spent + (Time.nanos() - began);
                advances = advances + 1;
                return ran;
            }

            // The totals, at the end, BESIDE the chronicle and never instead of it.
            //
            // A summary earns a place only as an index to what was already said: "the machine
            // refused ticks 900 times" is worth knowing after the 900 lines exist, and worthless
            // in their place -- it cannot distinguish a world that fell behind once from one that
            // fell behind on every frame, and those are different worlds with the same number.
            //
            // That is the rule this pair encodes, and it is why the counts stayed rather than
            // being deleted along with the claim they used to make: **counts may sit beside the
            // record; they may not stand in for it.**
            public method report() returns void {
                // WHAT A TICK COSTS, which is the floor every later layer is read against. Measured
                // INSIDE the real frame, with the renderer competing for the same machine -- the
                // only place the number is the one that will actually be met.
                //
                // TICKS PER CALL IS PRINTED BESIDE IT BECAUSE THE FIRST NUMBER LIES WITHOUT IT.
                // What is timed is a whole `advance`, and an advance reads the clock three times
                // whatever it does. At gear 1 that overhead is charged to ONE tick and the empty
                // tick appears to cost 178 ns; at gear 6 it is spread over three hundred and the
                // same empty tick reads 2 ns. Neither number is wrong and only the second is about
                // the tick -- so the reader is given the divisor rather than a footnote.
                long ticked = state.age();
                mutable long each = 0;
                if (ticked > 0) {
                    each = spent / ticked;
                }
                mutable long perCall = 0;
                if (advances > 0) {
                    perCall = ticked / advances;
                }
                System.IO.Console.println($"world: {ticked} ticks, {each} ns each over {advances} advances ({perCall} a call)");
                if (behind > 0) {
                    System.IO.Console.println($"world: {behind} ticks owed and refused in total -- see the [tick] lines above for when");
                }
                // WHAT A PERSON COSTS, AND WHAT AN ANIMAL COSTS, SIDE BY SIDE.
                //
                // THE RATIO IS THE POINT, and it is the fauna layout's own bar: **2.5× is the
                // number to beat** -- an animal may cost up to two and a half times a person and no
                // more, because the world holds several times as many animals as people and a beast
                // that costs the same as a person is a beast the world cannot afford in the numbers
                // it needs. Printed rather than remembered, and printed as a RATIO rather than as
                // two numbers a reader has to divide, because a bar nobody computes is a bar nobody
                // notices moving.
                //
                // Both halves are whole accounts: every pass of the fauna against every pass of the
                // people, measured inside the real frame with the window open.
                if (Sim.peopleTicks > 0 && Grazing.beastTicksSoFar() > 0) {
                    long person = Sim.peopleNs * 1000 / Sim.peopleTicks;
                    long animal = Grazing.nanosPerBeastTick() * 1000;
                    System.IO.Console.println($"the ratio: {person} ps a person a tick, {animal} ps an animal a tick");
                    if (person > 0) {
                        System.IO.Console.println($"the ratio: an animal costs {animal * 100 / person} per cent of a person, and the bar is 250");
                    }
                }
                return;
            }

            // The two halves of the ratio, for a check that wants the numbers rather than the line.
            public method picosPerPersonTick() returns long {
                if (Sim.peopleTicks == 0) {
                    return 0;
                }
                return Sim.peopleNs * 1000 / Sim.peopleTicks;
            }

            // Nanoseconds a tick has cost on average, for whoever wants the number rather than the
            // sentence. Zero before the world has ticked at all.
            public method nanosPerTick() returns long {
                if (state.age() == cast<long>(0)) {
                    return 0;
                }
                return spent / state.age();
            }

            // One tick of the world: every layer's pass, in this order.
            //
            // A WORLD THAT IS NOT STANDING STILL TICKS. That is not a guard bolted on: a Sim with no
            // ground is a legal state, it is what the tick's own arithmetic is checked in, and its
            // ticks have to keep counting for that check to mean anything.
            //
            // THE ORDER IS `order`, and this method is what it costs to walk it. Everything that was
            // an `if` here -- the census on the twentieth year, the settling every sixty ticks while
            // there is no country, the claim and the crowning on the year -- moved to the pass it
            // was about, which is where its constant already lived.
            //
            // THE ONE THING THIS METHOD STILL DECIDES is the people's account, and it is here
            // because it is not a fact about any single pass: what a person costs is the passes over
            // the crowd, WHOLE. A partial meter does not merely understate a cost, it points at the
            // WRONG one -- this project has paid for that twice -- so the stopwatch opens at the
            // first pass charged to the people and closes after the last, one bracket and two clock
            // reads, exactly as it was when the seven were written out by hand.
            private method tick() returns void {
                state.aged();
                if (!state.stands()) {
                    return;
                }
                mutable boolean metering = false;
                mutable long folkBegan = 0;
                for (int i in 0..layers) {
                    Layer* one = order[i];
                    boolean mine = one.chargedToPeople();
                    if (mine && !metering) {
                        metering = true;
                        folkBegan = Time.nanos();
                        peopleTicks = peopleTicks + cast<long>(state.people().count());
                    } else if (!mine && metering) {
                        metering = false;
                        peopleNs = peopleNs + (Time.nanos() - folkBegan);
                    }
                    // ASKED BEFORE THE ACCOUNT AND NOT AFTER: the census is charged to the people
                    // and runs one year in twenty, so a pass that declines this tick must not close
                    // a bracket the passes around it are still inside.
                    if (one.runsAt(state)) {
                        one.pass(state);
                    }
                }
                if (metering) {
                    peopleNs = peopleNs + (Time.nanos() - folkBegan);
                }
                return;
            }

            // How old the world is, in ticks.
            public method age() returns long {
                return state.age();
            }

            // How many ticks the budget has refused over the whole run. Anything above zero means
            // the world ran slower than the speed it was asked for, and any measurement taken from
            // that run is about a world that went at a different rate than its label says.
            public method missed() returns long {
                return behind;
            }
        }
    }
}
