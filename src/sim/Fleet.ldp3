import System.IO.Console;
import Agents.World.Good;
import Agents.World.Goods;
import Agents.World.LandMath;

// THE FIRST THING IN THIS WORLD THAT MOVES WITHOUT A PERSON IN IT.
//
// Every load that has ever crossed this map was on somebody's back. A carter walks to the next town
// with a basket and a cart drawn beside him; a gatherer walks home with an armful. That is the whole
// of transport, and it is why the road was the only lane that ever worked.
//
// The sea lane, the railway and the airport were all built and none of them carried anything. The
// note in `workTrade` explains why and is right as far as it goes: a carter does not walk on water,
// so his leg ends at the quay and the goods "appear" at the far port because a vessel took them.
// But no vessel existed. Eight meshes -- barge, sailship, steamship, locomotive, railcar, airliner,
// cart, wagon -- were cut for this game and six had never been on screen, because six of them are
// not things a person pulls. They are things that GO.
//
// So this is the missing half of transport: a vessel is an object with a lane, two ends, a hold and
// a position, and it crosses on its own. It is the same shape as an army -- a thing a place owns,
// with somewhere it is going -- and it is deliberately NOT a person, because the alternative is
// animating a crew walking over the sea, which this world already decided against.

program AgentsExe;

public bundle Agents {
    public namespace Sim {

        // Which lane a vessel is on. The lane decides what it looks like, how fast it goes, and --
        // the part that matters -- what it is allowed to cross.
        public enum Lane {
            NoLane,
            Water,           // quay to quay, over anything
            Rail,            // seat to the far end of a line somebody laid
            Air              // airport to airport, over everything, and fastest
        }

        public class Fleet {
            private mutable int cap;
            private mutable byte[] lane;      // Lane, or NoLane for a free slot
            private mutable int[] from;
            private mutable int[] to;
            private mutable float[] px;
            private mutable float[] py;
            private mutable float[] tx;       // where it is headed, in world units
            private mutable float[] ty;
            private mutable int[] hold;       // the good aboard
            private mutable int[] amount;
            private mutable int[] era;        // what the sending town knew, so the hull matches it
            private mutable int live;
            private mutable long launched;
            private mutable long landed;
            private mutable long carried;

            public constructor Fleet(int slots) {
                this.cap = slots;
                if (this.cap < 1) {
                    this.cap = 1;
                }
                this.lane = new byte[this.cap]();
                this.from = new int[this.cap]();
                this.to = new int[this.cap]();
                this.px = new float[this.cap]();
                this.py = new float[this.cap]();
                this.tx = new float[this.cap]();
                this.ty = new float[this.cap]();
                this.hold = new int[this.cap]();
                this.amount = new int[this.cap]();
                this.era = new int[this.cap]();
                this.live = 0;
                this.launched = 0;
                this.landed = 0;
                this.carried = 0;
                for (int v in 0..this.cap) {
                    this.lane[v] = cast<byte>(cast<int>(Lane.NoLane));
                    this.from[v] = 0 - 1;
                    this.to[v] = 0 - 1;
                }
            }

            public destructor ~Fleet() returns void {
                delete this.lane;
                delete this.from;
                delete this.to;
                delete this.px;
                delete this.py;
                delete this.tx;
                delete this.ty;
                delete this.hold;
                delete this.amount;
                delete this.era;
                return;
            }

            public method limit() returns int {
                return this.cap;
            }

            public method afloat() returns int {
                return this.live;
            }

            public method sailings() returns long {
                return this.launched;
            }

            public method arrivals() returns long {
                return this.landed;
            }

            public method tonnage() returns long {
                return this.carried;
            }

            public method laneOf(int v) returns int {
                if (v < 0 || v >= this.cap) {
                    return cast<int>(Lane.NoLane);
                }
                return cast<int>(this.lane[v]) & 255;
            }

            public method running(int v) returns boolean {
                return this.laneOf(v) != cast<int>(Lane.NoLane);
            }

            public method xAt(int v) returns float {
                return this.px[v];
            }

            public method yAt(int v) returns float {
                return this.py[v];
            }

            public method eraOf(int v) returns int {
                return this.era[v];
            }

            public method bound(int v) returns int {
                return this.to[v];
            }

            public method cargoOf(int v) returns int {
                return this.hold[v];
            }

            public method loadOf(int v) returns int {
                return this.amount[v];
            }

            // Is a lane between these two already being worked? One vessel to a pair, because a
            // town that launched a second before the first arrived would stack them nose to tail
            // and the lane would read as a queue rather than a route.
            public method busy(int a, int b) returns boolean {
                for (int v in 0..this.cap) {
                    if (!this.running(v)) {
                        continue;
                    }
                    if (this.from[v] == a && this.to[v] == b) {
                        return true;
                    }
                }
                return false;
            }

            // Send one. Returns the slot, or -1 when the fleet is full -- which is not an error: a
            // world with every hull at sea simply waits, the same way a town with every bench full
            // does not raise another workshop.
            public method launch(int which, int a, int b, float ax, float ay,
                                 float bx, float by, int good, int n, int age) returns int
                requires n > 0
            {
                if (which == cast<int>(Lane.NoLane) || a < 0 || b < 0 || a == b) {
                    return 0 - 1;
                }
                for (int v in 0..this.cap) {
                    if (this.running(v)) {
                        continue;
                    }
                    this.lane[v] = cast<byte>(which);
                    this.from[v] = a;
                    this.to[v] = b;
                    this.px[v] = ax;
                    this.py[v] = ay;
                    this.tx[v] = bx;
                    this.ty[v] = by;
                    this.hold[v] = good;
                    this.amount[v] = n;
                    this.era[v] = age;
                    this.live = this.live + 1;
                    this.launched = this.launched + 1;
                    return v;
                }
                return 0 - 1;
            }

            // Newton, because this codebase has not got a square root anywhere but the renderer and
            // borrowing one across a namespace for four lines would be worse than eight.
            private static method root(float v) returns float {
                if (v <= 0.0) {
                    return 0.0;
                }
                mutable float g = v;
                mutable int i = 0;
                while (i < 20) {
                    g = 0.5 * (g + v / g);
                    i = i + 1;
                }
                return g;
            }

            // How fast a lane is. A barge is slower than a train and a train is slower than an
            // aeroplane, which is the entire reason anybody ever built the next one.
            public static method speedOf(int which) returns float {
                if (which == cast<int>(Lane.Water)) {
                    return 26.0;
                }
                if (which == cast<int>(Lane.Rail)) {
                    return 70.0;
                }
                if (which == cast<int>(Lane.Air)) {
                    return 180.0;
                }
                return 0.0;
            }

            // Everything afloat advances. Returns how many arrived this tick, and fills `done` with
            // their slots so the caller can put the cargo on the far shelf -- the fleet moves things
            // and does not touch a store, because a table that both carries and pays is a table two
            // things can go wrong in.
            public method advance(float dt, int[] done) returns int {
                mutable int n = 0;
                for (int v in 0..this.cap) {
                    if (!this.running(v)) {
                        continue;
                    }
                    float speed = Fleet.speedOf(this.laneOf(v));
                    float dx = this.tx[v] - this.px[v];
                    float dy = this.ty[v] - this.py[v];
                    float far = dx * dx + dy * dy;
                    float leg = speed * dt;
                    if (far <= leg * leg) {
                        this.px[v] = this.tx[v];
                        this.py[v] = this.ty[v];
                        if (n < done.length()) {
                            done[n] = v;
                            n = n + 1;
                        }
                        continue;
                    }
                    float d = Fleet.root(far);
                    if (d > 0.0) {
                        this.px[v] = this.px[v] + dx / d * leg;
                        this.py[v] = this.py[v] + dy / d * leg;
                    }
                }
                return n;
            }

            // Tie it up and free the slot. Called once the caller has taken the cargo off it.
            public method moor(int v) returns void {
                if (v < 0 || v >= this.cap || !this.running(v)) {
                    return;
                }
                this.carried = this.carried + cast<long>(this.amount[v]);
                this.landed = this.landed + 1;
                this.lane[v] = cast<byte>(cast<int>(Lane.NoLane));
                this.from[v] = 0 - 1;
                this.to[v] = 0 - 1;
                this.amount[v] = 0;
                this.hold[v] = 0;
                this.live = this.live - 1;
                return;
            }

            // A town that is gone takes its shipping with it: a vessel bound for a place nobody
            // lives in any more would cross for ever and unload onto nothing.
            public method strand(int comm) returns void {
                for (int v in 0..this.cap) {
                    if (!this.running(v)) {
                        continue;
                    }
                    if (this.from[v] == comm || this.to[v] == comm) {
                        this.lane[v] = cast<byte>(cast<int>(Lane.NoLane));
                        this.from[v] = 0 - 1;
                        this.to[v] = 0 - 1;
                        this.amount[v] = 0;
                        this.live = this.live - 1;
                    }
                }
                return;
            }

            public method report() returns void {
                System.IO.Console.println($"  lanes: {this.launched} sailings, {this.landed} arrivals, {this.carried} carried by something that is not a person | {this.live} under way now");
                return;
            }
        }
    }
}
