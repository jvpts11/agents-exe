import System.IO.Console;
import System.Time.Time;
import System.Math.Math;
import Agents.Sim.Wild;
import Agents.Sim.Herd;
import Agents.Sim.HerdMood;
import Agents.Sim.BeastState;
import Agents.Sim.BeastId;
import Agents.Sim.BlockChain;
import Agents.Sim.Nearby;
import Agents.Sim.Prowl;
import Agents.Sim.Chronicle;
import Agents.Sim.Crew;
import Agents.Sim.Stir;
import Agents.World.Grid;
import Agents.World.BlockGrid;
import Agents.World.Species;
import Agents.World.Beasts;
import Agents.World.LandMath;
import Agents.World.Rng;
program AgentsExe;

// THE FAUNA'S TICK: what every herd decides, and what its animals do about it.
//
// THE HERD THINKS AND THE BEAST FOLLOWS. Fifteen hundred decisions and ten thousand moves, instead
// of ten thousand decisions -- the same trade as the block index and the sliced bake, and the reason
// `Herd` is a class while `Beast` is twenty bytes of value.
//
// A HERD THAT MOVES ON CROSSES GROUND IT DOES NOT LIVE ON, which is the whole reason `Migrating` has
// a name: the habitat rule holds in every state but that one, and that one is bounded by the journey.
// A rule with a quiet exception is worse than no rule.
//
// NOTHING HERE IS CHRONICLED, AND THAT IS A DECISION RATHER THAN AN OVERSIGHT. The chronicle is what
// the world has to TELL you because you cannot see it; a herd drifting and a herd crossing a ridge
// are things you WATCH, and they are drawn in this same task. Fifteen hundred herds writing a line
// each time they change pasture is a hundred lines a second at gear one -- a record nobody reads,
// costing frame time, drowning the lines that do matter. What gets a line is what the window cannot
// show: a species gone (S1.9), a herd wiped out, a world that fell behind. A split gets one because
// it is rare and because a new herd is a new thing in the world, not a movement of an old one.
public bundle Agents {
    public namespace Sim {

        public class Grazing {
            // The chance, per DECISION, of a herd deciding to move on: one in this many. A herd
            // decides once a second (see DECIDE_EVERY), so at gear one this is a change of pasture
            // about every four minutes -- a herd that moved every few seconds would read as panic
            // rather than as grazing.
            public static fixed int MOVE_ON_IN = 250;
            // HOW OFTEN A HERD DECIDES ANYTHING, in ticks: once a second at gear one.
            //
            // It was every fifteenth tick until fright was written, and fright is what made the
            // difference matter: looking around costs a search of nine blocks, and four of those a
            // second per herd put ten microseconds on a seventeen-microsecond tick. A wolf walks 2.7
            // cells a second and a deer notices one at fourteen, so a look every second sees it at
            // eleven instead of fourteen -- which is a difference no player can see, for four times
            // the price.
            //
            // Stepping stayed at a fifteenth, because a step every second reads as a stutter and a
            // decision every second reads as nothing at all.
            public static fixed int DECIDE_EVERY = 60;
            // How far it goes when it does, in cells.
            public static fixed float JOURNEY = 24.0;
            // How many ticks make a second of world time -- gear one is real time, one tick a frame,
            // sixty frames a second. Age is counted in SECONDS and not in ticks, because `age` is a
            // short: a mammoth lives six hundred seconds, and six hundred fits where thirty-six
            // thousand does not.
            public static fixed int TICKS_A_SECOND = 60;
            // HOW OFTEN A GRAZING ANIMAL TAKES A STEP, in ticks. Four times a second at gear one.
            //
            // THIS IS THE SHAPE OF THE WHOLE TICK, and it was measured into existence. Moving every
            // animal every tick cost 17 ns each -- 181 microseconds a tick with ten thousand of them
            // -- which the top two gears cannot pay for: gear six asks three hundred ticks a frame,
            // so the frame's whole budget bought forty-four of them and two hundred and fifty-six
            // were refused, every frame.
            //
            // A grazing animal does not glide. It stands, crops, takes a step, stands again -- so a
            // step every fifteenth tick is not an approximation of grazing, it IS grazing, and it is
            // what the animal looks like in the game. Each animal steps on the tick its own slot
            // number comes up, so a fifteenth of them move on any given tick and the herd as a whole
            // never stops moving. This is the same trade the previous build made with its crowd and
            // for the same reason.
            //
            // A herd ON THE MOVE is not sliced: its animals follow the centre every tick, because
            // that motion is the one a player watches cross the ground.
            //
            // WHAT A BEAST COSTS, measured on the real game at gear 6 (`game gear=6 for=8`), four
            // populations, 12600K, window open and drawing throughout -- there is no other way to
            // measure it, because a tick with no renderer competing for the machine is a tick nobody
            // will ever meet:
            //
            //     animals   herds    a tick    per animal   ticks a frame at gear 6 (300 asked)
            //       5,089     748    8.3 us      1.62 ns      300
            //      10,452   1,497   17.1 us      1.63 ns      300     <- the world a game is played in
            //      30,193   4,341   56.6 us      1.87 ns      142
            //      50,316   7,203  109.4 us      2.17 ns       73
            //
            // Linear in the population, with a third added by the time fifty thousand animals are a
            // megabyte of `Beast` and seven thousand herd objects no longer fit beside them. The
            // empty tick is 2 ns (S0.2), so the floor is not what any of this is measured against.
            //
            // The world a game is played in runs the full three hundred ticks a frame it asks for,
            // and the two rows below it are where the budget starts refusing -- SAYING SO each time,
            // which is what makes those two rows a measurement rather than a surprise.
            public static fixed int STIR_EVERY = 1;
            // HOW LONG AN AMBLING ANIMAL KEEPS ITS DIRECTION, in ticks. Three quarters of a second.
            //
            // It has to be more than one tick. The direction is hashed from the slot and the time,
            // so with the time changing every tick a moving animal would pick a new direction sixty
            // times a second and vibrate on the spot instead of wandering. Held for a while, it
            // ambles: a direction, a little way in it, then another.
            public static fixed int HOLD_COURSE = 45;
            // How much faster than bare replacement a herd breeds when the ground has room for it.
            // Two: a population that has been cut into recovers, and one at its ceiling is stopped by
            // the ceiling rather than by the rate.
            public static fixed int BREED_OVER_REPLACEMENT = 2;
            // How far the daughter of a split looks for ground of her own, in blocks. BOUNDED IN THE
            // LINE THAT WRITES IT: the previous build's agents span against walls because a search
            // with no bound was written once and then trusted everywhere.
            public static fixed int LOOK_OUT_BLOCKS = 6;
            // How much faster than its walk an animal runs when it is frightened.
            public static fixed float FLEE_BURST = 2.5;
            // Stamina spent per tick of running, out of the thousand an animal starts with -- about
            // three seconds of flat-out flight at gear one, and then it is blown.
            public static fixed int SPEND = 6;
            // And regained per step of grazing. A step is every fifteenth tick, so this is one a
            // tick: seventeen seconds of quiet grazing to get its wind back.
            public static fixed int RECOVER = 15;
            // HOW MUCH FASTER AN ANIMAL MOVES WHEN IT IS CATCHING UP than the herd it is catching.
            // It has to be more than one, and that is not a tuning knob: a follower moving at
            // exactly the centre's pace can never close a gap, only hold it, so an animal that falls
            // behind for any reason -- a step refused by the ground, a moment spent grazing while
            // the herd set off -- trails at that distance for the whole journey and rejoins only
            // when the herd stops. Found by a test that asked whether the animals arrived with their
            // herd and got three that had not.
            public static fixed float FOLLOW_HURRY = 1.3;
            // What a blown animal can still manage, as a fraction of the burst it can no longer
            // manage -- a fifth of two and a half is half its ordinary walk. IT HAS TO BE SLOWER
            // THAN A WALKING PREDATOR or the hunt has no ending: a wolf walks 2.7 cells a second and
            // a blown reindeer manages 1.05, so the wolf closes at 1.65 and a chase resolves in
            // seconds rather than never.
            public static fixed float WINDED_PACE = 0.2;

            // One tick of the world's animals.
            //
            // THREE PASSES, AND EACH ONE TOUCHES ONLY WHAT IT HAS TO. Walking every animal for
            // everything is what made the tick cost thirty times what it needed to.
            // WHAT EACH PASS COSTS, in nanoseconds over the whole run. Four clock reads a tick
            // against a tick of sixty thousand is a quarter of one per thousand, and it is the
            // difference between knowing which pass is expensive and guessing.
            //
            // IT WAS ADDED BECAUSE FOUR GUESSES IN A ROW WERE WRONG. The herd walk, the neighbourhood
            // count, the order of the breeding test and the biome read were each argued for from
            // first principles, each fixed, and each worth between nothing and five per cent. A
            // meter that covers the loop is the only thing that can say where the time goes -- which
            // is the same lesson the frame meter learned one level up, written on its own file.
            private static mutable long walkNs;
            private static mutable long thinkNs;
            private static mutable long stirNs;
            private static mutable long ageNs;
            // HOW MANY ANIMALS WERE ALIVE, SUMMED OVER EVERY TICK -- the divisor that makes the total
            // comparable between two runs, and without it nothing here is.
            //
            // A run is bounded by SECONDS, so a faster build simulates more world and ends with a
            // different population: two builds measured at 47 and 43 microseconds a tick had 12,170
            // and 13,022 animals in them, and per animal they were the same number. Four
            // optimizations were judged against that before the divisor existed, and the two that
            // "worked" and the two that did not were all inside the noise.
            private static mutable long beastTicks;

            public static method report() returns void {
                long all = Grazing.walkNs + Grazing.thinkNs + Grazing.stirNs + Grazing.ageNs;
                if (all == 0) {
                    return;
                }
                System.IO.Console.println($"fauna tick: {all / 1000000} ms total -- walking {Grazing.walkNs * 100 / all}%, deciding {Grazing.thinkNs * 100 / all}%, stirring {Grazing.stirNs * 100 / all}%, ageing {Grazing.ageNs * 100 / all}%");
                if (Grazing.beastTicks > 0) {
                    // Picoseconds, because the number is a couple of nanoseconds and integer
                    // division would throw away everything that distinguishes one build from
                    // another.
                    System.IO.Console.println($"fauna tick: {all * 1000 / Grazing.beastTicks} ps per animal per tick over {Grazing.beastTicks / 1000000} million animal-ticks");
                }
                return;
            }

            public static method tick(Wild* wild, Grid* g, long at, Rng* rng, Chronicle* log)
                    returns void {
                Grazing.beastTicks = Grazing.beastTicks + cast<long>(wild.count());
                mutable long mark = Time.nanos();

                // ONE: the herds that are travelling walk, every tick, and their animals with them.
                // Crossing to another pasture, running from a wolf and closing on a quarry are the
                // same motion at three speeds -- and all three are motion a player watches, which is
                // why none of them is sliced.
                //
                // ONLY THE ONES THAT ARE GOING SOMEWHERE, through the world's list of them. Asking
                // every herd its mood was fifteen nanoseconds a herd for the answer "no", which at
                // nine thousand herds was most of the tick.
                //
                // THE INDEX IS NOT ADVANCED WHEN A HERD ARRIVES, for the same reason the ageing walk
                // does not: settling takes it out of the list, and the last mover has just been
                // swapped into the slot being looked at.
                mutable int i = 0;
                while (i < wild.travellers()) {
                    Herd* h = wild.travellerAt(i);
                    int doing = cast<int>(h.mood());
                    if (doing == cast<int>(HerdMood.MovingOn)) {
                        Grazing.carryOn(h, wild, 1.0);
                        Grazing.walkWith(h, wild, g, 1.0, false);
                    } else if (doing == cast<int>(HerdMood.Fleeing)) {
                        // A HERD RUNS AS FAST AS THE ANIMALS IN IT CAN, and once half of them are
                        // blown that is not fast at all -- which is the moment a walking pack starts
                        // gaining. Read from the walk of the tick before, which counted them anyway.
                        mutable float burst = Grazing.FLEE_BURST;
                        if (h.isBlown()) {
                            burst = Grazing.FLEE_BURST * Grazing.WINDED_PACE;
                        }
                        Grazing.carryOn(h, wild, burst);
                        Grazing.walkWith(h, wild, g, burst, true);
                    } else if (doing == cast<int>(HerdMood.Hunting)) {
                        // THE PACK WALKS AND DOES NOT TIRE, which is the whole of the contest: the
                        // quarry outruns it in bursts and blows, and then it is simply still coming.
                        // It does not settle when it reaches where the quarry WAS -- its decision
                        // re-aims it once a second, and arriving at an empty patch of grass is not a
                        // reason to start grazing.
                        Grazing.stepCentre(h, wild, 1.0);
                        Grazing.walkWith(h, wild, g, 1.0, false);
                    }
                    if (h.spot() == i) {
                        i = i + 1;
                    }
                }
                mutable long now = Time.nanos();
                Grazing.walkNs = Grazing.walkNs + (now - mark);
                mark = now;

                // TWO: a sixtieth of the herds decide something -- so every herd decides once a
                // second. A herd reconsidering sixty times a second is sixty times the thinking for
                // a decision it takes twice a minute.
                //
                // THE COUNT IS RE-READ EVERY TIME, because a decision can END a herd: a pack kills
                // the last animal of a herd, that herd is disbanded, and the last herd in the array
                // moves into its slot. `n` from the top of the tick would be one past the end, and
                // the slot it points at holds a pointer that has been deleted.
                mutable int k = cast<int>(at % cast<long>(Grazing.DECIDE_EVERY));
                while (k < wild.herdsAlive()) {
                    Grazing.thinkFor(wild.herdAt(k), wild, g, at, rng, log);
                    k = k + Grazing.DECIDE_EVERY;
                }
                now = Time.nanos();
                Grazing.thinkNs = Grazing.thinkNs + (now - mark);
                mark = now;

                // THREE: every grazing animal takes its step, and the crew takes them together.
                //
                // THE ONLY PASS THAT IS SHARED OUT, and it is the one worth sharing: it touches every
                // animal on every tick and is two thirds of the tick. The other three are a walk of
                // the herds that are moving, a sixtieth of the herds thinking, and a sixtieth of the
                // animals ageing -- all of which write herds, rosters, births and deaths, which is
                // shared state everywhere rather than in one place. See `Stir` for what makes this
                // one different and `Crew` for why the hands are not made here.
                // Started on the first tick that wants them rather than when the world was made: a
                // check that builds a world and never ticks it should never have started a thread.
                Crew* crew = wild.crew();
                Stir* pass = wild.stir();
                crew.start();
                pass.ready(wild, g, cast<int>(at / cast<long>(Grazing.HOLD_COURSE)) * 668265263,
                           cast<float>(Grazing.STIR_EVERY));
                crew.work(pass);
                pass.settle();
                now = Time.nanos();
                Grazing.stirNs = Grazing.stirNs + (now - mark);
                mark = now;

                // And once a second, everything alive gets a second older. A full walk, but one tick
                // in sixty -- and it is two reads and an add per animal, with the array in order.
                if (at % cast<long>(Grazing.TICKS_A_SECOND) == 0) {
                    Grazing.ageEveryone(wild, at, log);
                    Grazing.ageNs = Grazing.ageNs + (Time.nanos() - mark);
                }
                return;
            }

            // WHAT THE HERD DECIDES. One decision, and the mood carries it until it is done.
            //
            // MOVING ON IS NOT HERE, because a herd on the move is not deciding anything -- it is
            // walking, which the first pass of the tick does every tick rather than every fifteenth.
            private static method thinkFor(Herd* h, Wild* wild, Grid* g, long at, Rng* rng,
                                           Chronicle* log) returns void {
                // OUTGROWING ITSELF IS ABOUT SIZE AND NOT ABOUT DIET, so it is asked of every herd
                // before anything else is. A pack of wolves that has bred past the number wolves run
                // in splits by the same rule and for the same reason a herd of deer does.
                if (Grazing.maySplit(h, wild, g, at, log)) {
                    return;
                }
                // A PACK THINKS ABOUT SOMETHING ELSE ENTIRELY, and it thinks about it in its own
                // file. What is below is what a grazer's day is made of; hunger, hunting and
                // starving are not variations on it, and a predator's breeding is limited by what it
                // can CATCH rather than by the ground -- so that lives there too.
                if (Beasts.isPredator(cast<int>(h.species()))) {
                    Prowl.decide(h, wild, g, at, rng, log);
                    return;
                }
                match (h.mood()) {
                    case Drifting {
                        // THE STRAGGLERS COME BACK. The step every grazing animal takes is its own
                        // and knows nothing of the herd -- which is what makes that pass cheap --
                        // so the only thing holding a herd together is this, once a second, where
                        // the centre is in hand and the roster is being walked anyway.
                        Grazing.gatherStrays(h, wild, g);
                        // FRIGHT COMES NEXT, because a herd deciding to change pasture while a
                        // wolf is walking into it is a herd that has not noticed the wolf.
                        if (Grazing.takeFright(h, wild)) {
                            return;
                        }
                        // Then breeding, if the ground it stands on has room, and then the draw for
                        // moving on.
                        Grazing.mayBreed(h, wild, g, rng);
                        if (rng.nextInt(Grazing.MOVE_ON_IN) == 0) {
                            Grazing.setOut(h, wild, g, rng);
                        }
                    }
                    case MovingOn {
                        // Walking, and the walking is pass one's.
                    }
                    case Fleeing {
                        // Running, and the running is pass one's -- but whether there is still
                        // anything to run FROM is asked here, four times a second rather than
                        // sixty, because a wolf does not appear and vanish between two ticks.
                        if (Grazing.calmAgain(h, wild)) {
                            Grazing.settle(h, wild);
                        }
                    }
                    case Hunting {
                        // A grazer in a predator's mood is a state nothing can produce -- packs are
                        // sent to `Prowl` above and never reach this match. It settles rather than
                        // being left alone, because an unreachable state that does nothing is a
                        // herd standing still forever the day something DOES produce it.
                        h.setMood(HerdMood.Drifting);
                    }
                    case Starving {
                        // The same, and for the same reason: a grazer's food is the ground, and the
                        // block's carrying capacity stands in for it.
                        h.setMood(HerdMood.Drifting);
                    }
                }
                return;
            }

            // PICK SOMEWHERE AND GO. The target has to be ground the species lives on, or the herd
            // stays where it is: a herd that sets out for the sea is a herd that walks into it.
            // EIGHT TRIES AND THEN IT STAYS -- a loop that searches until it succeeds is a loop that
            // hangs on a species boxed in by water.
            private static method setOut(Herd* h, Wild* wild, Grid* g, Rng* rng) returns void {
                int sp = cast<int>(h.species());
                mutable int tries = 0;
                while (tries < 8) {
                    tries = tries + 1;
                    float ang = rng.unit() * 6.2831853;
                    float tx = h.x() + LandMath.cos(ang) * Grazing.JOURNEY;
                    float ty = h.y() + LandMath.sin(ang) * Grazing.JOURNEY;
                    int gx = cast<int>(tx);
                    int gy = cast<int>(ty);
                    if (gx < 1 || gy < 1 || gx >= g.width() - 1 || gy >= g.height() - 1) {
                        continue;
                    }
                    if (!Beasts.livesIn(sp, g.biomeAt(gx, gy))) {
                        continue;
                    }
                    Grazing.leaveFor(h, wild, tx, ty);
                    return;
                }
                return;
            }

            // Set a herd walking toward a place, and tell its animals they are on the move -- which
            // is what lifts the habitat rule for the crossing.
            private static method leaveFor(Herd* h, Wild* wild, float tx, float ty) returns void {
                h.aimAt(tx, ty);
                h.setMood(HerdMood.MovingOn);
                Grazing.markAll(h, wild, BeastState.Migrating);
                return;
            }

            // ---- fright ----------------------------------------------------------------------------
            //
            // A PERSON WALKING TOWARD DEER SEES THEM GO, and the fauna spec says that single
            // behaviour is what makes a world feel inhabited rather than decorated. There are no
            // people yet, so what a deer runs from today is a predator -- the same comparison against
            // the same `SHY`, and the hunter in S2 walks into a rule that is already here rather than
            // one written for him.
            //
            // ONE COMPARISON, through the block index: nine blocks around the herd, and the nearest
            // predator in them. Asked on the herd's decision tick and not on every tick, because a
            // wolf does not appear and vanish between two sixtieths of a second.
            //
            // Answers whether the herd took fright, so a frightened herd does not also decide to
            // change pasture on the same tick.
            private static method takeFright(Herd* h, Wild* wild) returns boolean {
                int sp = cast<int>(h.species());
                if (!Beasts.isPrey(sp)) {
                    return false;
                }
                float shy = Beasts.shy(sp);
                int wolf = Nearby.predator(wild, h.x(), h.y(), shy);
                if (wolf == Nearby.NONE) {
                    return false;
                }
                // AWAY FROM IT, three times the distance it was noticed at. Straight away and not
                // cleverly: an animal that plots a route around its own herd while a wolf closes is
                // an animal that has been given a thought it does not have.
                BeastId from = cast<BeastId>(wolf);
                mutable float dx = h.x() - wild.xOf(from);
                mutable float dy = h.y() - wild.yOf(from);
                mutable float span = LandMath.sqrt(dx * dx + dy * dy);
                if (span < 0.001) {
                    // Standing on it. Any direction will do, and this one is free.
                    dx = 1.0;
                    dy = 0.0;
                    span = 1.0;
                }
                h.aimAt(h.x() + dx / span * shy * 3.0, h.y() + dy / span * shy * 3.0);
                h.setMood(HerdMood.Fleeing);
                Grazing.markAll(h, wild, BeastState.Fleeing);
                wild.noteFright();
                return true;
            }

            // Whether there is no longer anything within twice this herd's `SHY`. TWICE, and not the
            // same distance, so a herd on the edge of noticing does not flicker between running and
            // grazing on every decision.
            private static method calmAgain(Herd* h, Wild* wild) returns boolean {
                float shy = Beasts.shy(cast<int>(h.species()));
                return Nearby.predator(wild, h.x(), h.y(), shy * 2.0) == Nearby.NONE;
            }

            // Back to grazing: the mood, and every animal's state with it -- which is also what
            // clears `Winded` off the ones that ran themselves out.
            private static method settle(Herd* h, Wild* wild) returns void {
                h.setMood(HerdMood.Drifting);
                h.aimAt(h.x(), h.y());
                h.setBlown(false);
                Grazing.markAll(h, wild, BeastState.Grazing);
                return;
            }

            // WALKING. The centre moves and the animals follow it, which is what makes a herd read
            // as a herd rather than as a scatter that happens to drift the same way. `times` is what
            // separates crossing ground at a walk from running from a wolf.
            private static method carryOn(Herd* h, Wild* wild, float times) returns void {
                if (Grazing.stepCentre(h, wild, times)) {
                    Grazing.settle(h, wild);
                }
                return;
            }

            // One step of the herd's centre toward what it is aimed at. Answers whether it arrived,
            // because what arriving MEANS differs: a herd that reaches its new pasture settles, and
            // a pack that reaches where its quarry was a second ago has arrived at nothing.
            private static method stepCentre(Herd* h, Wild* wild, float times) returns boolean {
                float dx = h.towardsX() - h.x();
                float dy = h.towardsY() - h.y();
                float span = LandMath.sqrt(dx * dx + dy * dy);
                float pace = Grazing.paceOf(h) * times;
                if (span <= pace) {
                    h.moveCentre(h.towardsX(), h.towardsY());
                    return true;
                }
                h.moveCentre(h.x() + dx / span * pace, h.y() + dy / span * pace);
                wild.noteTravel(pace);
                return false;
            }

            // Cells a tick, baked into the table rather than divided out of cells-a-second on every
            // animal the tick moves.
            private static method paceOf(Herd* h) returns float {
                return Beasts.paceATick(cast<int>(h.species()));
            }

            // THE ANIMALS OF A HERD THAT IS CROSSING GROUND, every tick, through the herd's own
            // roster.
            //
            // THE ROSTER IS THE RIGHT TOOL HERE AND THE WRONG ONE EVERYWHERE ELSE. It is a linked
            // list through a shared pool, so walking it touches the beast array out of order and
            // throws away the reason `Beast` was squeezed to three animals per cache line. That is a
            // price worth paying for the one herd in eight that is actually on the move, and a price
            // not worth paying for the seven that are standing still -- which is why the grazers are
            // reached by walking the array instead.
            private static method walkWith(Herd* h, Wild* wild, Grid* g, float times,
                                           boolean running) returns void {
                float reach = h.reach();
                float tooFar = reach * reach;
                // Faster than the centre, or a gap once opened is a gap for the whole journey.
                float pace = Grazing.paceOf(h) * times * Grazing.FOLLOW_HURRY;
                float hx = h.x();
                float hy = h.y();
                mutable int mob = 0;
                mutable int spent = 0;
                mutable int link = h.firstMember();
                while (link >= 0) {
                    BeastId b = h.memberAt(link);
                    link = h.afterMember(link);
                    mob = mob + 1;
                    // RUNNING COSTS, AND THAT IS THE WHOLE OF THE HUNT. A beast flees in bursts and
                    // tires; a hunter keeps walking. The animal that runs out first falls behind its
                    // herd -- and the one that falls behind is the one that gets caught, which is a
                    // chase resolving itself out of two rules rather than out of a chase routine.
                    mutable float mine = pace;
                    if (running) {
                        int left = wild.staminaOf(b);
                        if (left <= 0) {
                            wild.setStateOf(b, BeastState.Winded);
                            mine = pace * Grazing.WINDED_PACE;
                            spent = spent + 1;
                        } else {
                            wild.setStaminaOf(b, left - Grazing.SPEND);
                        }
                    }
                    float bx = wild.xOf(b);
                    float by = wild.yOf(b);
                    float dx = hx - bx;
                    float dy = hy - by;
                    // SQUARED, so an animal that is already with its herd costs two multiplies and
                    // no square root. The root is taken only by the ones that have fallen behind.
                    float gap = dx * dx + dy * dy;
                    if (gap <= tooFar) {
                        continue;
                    }
                    float span = LandMath.sqrt(gap);
                    Grazing.tryStep(wild, g, b, bx, by, bx + dx / span * mine, by + dy / span * mine);
                }
                if (running) {
                    // Half of them, because a herd is not held up by one straggler and is held up by
                    // most of itself.
                    h.setBlown(spent * 2 >= mob);
                }
                return;
            }

            // WHATEVER HAS WANDERED OUT OF THE HERD IS TOLD TO WALK BACK IN. Once a second, on the
            // herd's own decision, because it is the only place that has both the centre and the
            // roster -- and because the alternative is asking every animal for its herd on every
            // step, which is what made the step cost twenty-four nanoseconds.
            //
            // IT SETS A STATE; IT DOES NOT MOVE ANYTHING, and that is the fix to a defect a person
            // found by watching the window. This used to walk the straggler back itself, a whole
            // SECOND of its pace in ONE tick -- 2.7 cells for a deer, in a single frame at gear 1,
            // where a walking step is a sixtieth of that and the renderer refuses to interpolate a
            // jump beyond two cells at all. So an animal grazing peacefully was yanked across the
            // ground once a second, which is exactly what "it still teleports a bit" meant.
            //
            // Marked `Following`, the animal walks home at its own pace on every tick of the next
            // second, in the pass that is already touching it. `Following` has been in `BeastState`
            // since the state was written, named for this and unused until now.
            private static method gatherStrays(Herd* h, Wild* wild, Grid* g) returns void {
                float hx = h.x();
                float hy = h.y();
                float tooFar = h.reach() * h.reach();
                mutable int link = h.firstMember();
                while (link >= 0) {
                    BeastId b = h.memberAt(link);
                    link = h.afterMember(link);
                    // Only the ones grazing: an animal running, crossing, stalking or on a kill is
                    // owned by whatever put it in that state.
                    if (cast<int>(wild.stateOf(b)) != cast<int>(BeastState.Grazing)) {
                        continue;
                    }
                    float dx = hx - wild.xOf(b);
                    float dy = hy - wild.yOf(b);
                    if (dx * dx + dy * dy <= tooFar) {
                        continue;
                    }
                    wild.setStateOf(b, BeastState.Following);
                }
                return;
            }

            // (The pass that steps every grazing animal lives in `Stir`, because it is the one pass
            // the crew shares out and it needs a place to keep each hand's deferred crossings. What
            // it does and why it is shaped that way is written there.)

            // MOVE IT THERE IF IT MAY STAND THERE. It may not walk off the map or onto ground it
            // cannot live on -- except while migrating, which is the named exception and the reason
            // that state exists. An animal refused simply does not move this step.
            private static method tryStep(Wild* wild, Grid* g, BeastId b,
                                          float wasX, float wasY, float nx, float ny)
                    returns void {
                // GROUND IT HAS NOT LEFT CANNOT HAVE CHANGED, and the question is asked WITHOUT
                // CONVERTING ANYTHING. A step is a sixtieth of a cell, so an animal ends the tick in
                // the cell it started in on nineteen ticks out of twenty -- and this is the one line
                // every animal runs every tick, so what it costs is what the tick costs.
                //
                // IN FLOATING POINT, because `cast<int>(float)` in this language is a SATURATING
                // conversion with range checks (the no-UB principle, and rightly) -- measured once
                // before in this same project at about 26 ns an iteration in a hot loop. `floor` is
                // one instruction and no branch. Two floors and a compare replace two of those, per
                // animal, per tick.
                //
                // AND IT ASKS THE ANIMAL'S OWN OLD POSITION, not a copy of its cell kept alongside.
                // The cheap version of this stores the cell corner per slot in the index; that is the
                // animal's position written down twice, which is the thing this build does not do.
                if (Math.floor(nx) == Math.floor(wasX) && Math.floor(ny) == Math.floor(wasY)) {
                    wild.slide(b, nx, ny);
                    return;
                }
                // IT CROSSED INTO ANOTHER CELL, which is where the rest of this method has always
                // belonged: the ground is looked up, the index is moved, and the integers are finally
                // worth their price -- on the one tick in twenty that earns them.
                //
                // THE EDGE IS TESTED IN FLOATS TOO, and that is a fix rather than a saving. Truncation
                // sends everything in (-1, 0) to cell 0, so an animal that stepped a hundredth of a
                // cell off the west edge was filed as standing on it.
                if (nx < 0.0 || ny < 0.0 ||
                    nx >= cast<float>(g.width()) || ny >= cast<float>(g.height())) {
                    return;
                }
                int gx = cast<int>(nx);
                int gy = cast<int>(ny);
                if (cast<int>(wild.stateOf(b)) != cast<int>(BeastState.Migrating)) {
                    if (!Beasts.livesIn(cast<int>(wild.speciesOf(b)), g.biomeAt(gx, gy))) {
                        return;
                    }
                }
                wild.placeAt(b, nx, ny);
                return;
            }

            // EVERYTHING ALIVE GETS A SECOND OLDER, AND WHAT HAS RUN OUT OF THEM DIES. One walk of
            // the array in order, one tick in sixty: age is counted in seconds, because `age` is a
            // short and a mammoth's six hundred seconds fit in one where thirty-six thousand ticks
            // do not.
            //
            // THE SLOT IS NOT ADVANCED WHEN ONE DIES, and that is not an optimization -- a death is
            // a swap-remove, so the LAST animal has just been moved into the slot being looked at,
            // and stepping past it would skip an animal for every one that died. The count is
            // re-read for the same reason.
            private static method ageEveryone(Wild* wild, long at, Chronicle* log) returns void {
                mutable int i = 0;
                while (i < wild.count()) {
                    BeastId b = cast<BeastId>(i);
                    wild.growOlder(b);
                    int span = cast<int>(Beasts.life(cast<int>(wild.speciesOf(b))));
                    if (wild.ageOf(b) >= span) {
                        wild.diedOfAge(b, at, log);
                        continue;
                    }
                    i = i + 1;
                }
                return;
            }

            private static method markAll(Herd* h, Wild* wild, BeastState s) returns void {
                mutable int link = h.firstMember();
                while (link >= 0) {
                    wild.setStateOf(h.memberAt(link), s);
                    link = h.afterMember(link);
                }
                return;
            }

            // ---- breeding -------------------------------------------------------------------------
            //
            // A HERD BELOW THE CARRYING CAPACITY OF THE GROUND IT STANDS ON BREEDS. Not below its own
            // number -- below the BLOCK's, which is the first of the three steps of the full-block
            // rule: *breeding asks the block, not the herd*. A herd asking only itself would let
            // every deer in the world stand in one meadow and each herd call itself small.
            //
            // THE RATE IS THE SPECIES' OWN LIFESPAN, and nothing is tuned by hand. An animal that
            // lives `LIFE` seconds must be replaced once in `LIFE` seconds for the population to
            // stand still, so a herd of `count` needs `count / LIFE` births a second to hold. Twice
            // that is the rate here: a population under pressure recovers, one at its ceiling is
            // stopped by the ceiling and not by the rate. A number derived from the table cannot
            // drift out of step with the table.
            private static method mayBreed(Herd* h, Wild* wild, Grid* g, Rng* rng) returns void {
                int sp = cast<int>(h.species());
                int gx = cast<int>(h.x());
                int gy = cast<int>(h.y());
                if (gx < 0 || gy < 0 || gx >= g.width() || gy >= g.height()) {
                    return;
                }
                // THE DRAW COMES BEFORE THE COUNT, and the order is worth thirty times the cost of
                // this method. Both have to hold, so either order gives the same births -- but
                // counting the neighbourhood means walking nine chains and reading a species off
                // every animal in them, while the draw is one multiply. A birth comes up about once
                // in thirty decisions, so asking the ground first meant paying the expensive
                // question twenty-nine times to be told about a birth that was not going to happen.
                int span = cast<int>(Beasts.life(sp));
                if (span < 1) {
                    return;
                }
                if (rng.nextInt(span) >= h.count() * Grazing.BREED_OVER_REPLACEMENT) {
                    return;
                }
                int block = wild.blockAt(h.x(), h.y());
                if (wild.headAround(block, h.species()) >= Beasts.roomFor(sp, g.biomeAt(gx, gy))) {
                    // FULL. No birth, no line in the record, and nothing wrong: a full continent is
                    // a full continent.
                    return;
                }
                // Born beside its herd, on ground its herd is standing on -- so a calf is never born
                // into the sea by a herd grazing along a shoreline.
                BeastId calf = wild.bear(h.species(), h.x(), h.y());
                h.admit(calf);
                wild.noteBirth();
                return;
            }

            // ---- splitting ------------------------------------------------------------------------
            //
            // A HERD OVER ITS SPECIES' NUMBER SPLITS, AND THE DAUGHTER MUST GO. The table says how
            // many run together; a herd that grows past it by breeding is a herd that cannot feed
            // itself off one place, so half of it walks away to ground of its own.
            //
            // Answers whether the herd split, because a herd that has just halved should not also
            // decide to wander this tick.
            private static method maySplit(Herd* h, Wild* wild, Grid* g, long at, Chronicle* log)
                    returns boolean {
                int sp = cast<int>(h.species());
                int most = Beasts.herd(sp);
                int have = h.count();
                if (have <= most || have < 2) {
                    return false;
                }
                // Somewhere to go, first: a split with nowhere to put the daughter is a split that
                // must not happen. The herd stays over its number and breeding is what stops --
                // spec 2026-08-08-fauna-design, the third step of the full-block rule.
                int home = wild.blockAt(h.x(), h.y());
                int room = Grazing.roomNearby(wild, g, h.species(), home);
                if (room < 0) {
                    return false;
                }
                BlockGrid* lat = wild.standing().grid();
                float tx = cast<float>(lat.originX(room)) + 8.0;
                float ty = cast<float>(lat.originY(room)) + 8.0;

                // Half of them leave, taken off the roster into a list first: a chain cannot be
                // walked and unlinked at the same time without losing the place.
                int leaving = have / 2;
                mutable int[] party = new int[leaving]();
                mutable int took = 0;
                mutable int link = h.firstMember();
                while (link >= 0 && took < leaving) {
                    party[took] = cast<int>(h.memberAt(link));
                    took = took + 1;
                    link = h.afterMember(link);
                }
                Herd* daughter = wild.gather(h.species(), h.x(), h.y(), h.reach());
                for (int i in 0..took) {
                    BeastId who = cast<BeastId>(party[i]);
                    h.release(who);
                    daughter.admit(who);
                }
                delete party;
                Grazing.leaveFor(daughter, wild, tx, ty);
                log.note(at, "fauna",
                         $"a herd of {Beasts.name(sp)} outgrew its ground: {took} leave for {cast<int>(tx)},{cast<int>(ty)}");
                return true;
            }

            // The nearest block, other than this one, whose ground the species can live on AND which
            // is under its carrying capacity -- the second step of the full-block rule. Searched in
            // rings outward and STOPPED AT A FIXED DISTANCE: a daughter that cannot find ground
            // within six blocks does not walk to the other side of the world looking for it.
            //
            // If there is none, the split does not happen (step three), the herd stays at its size,
            // and the population sits at the ceiling. That is not an error and nothing is logged: a
            // full continent is a full continent.
            private static method roomNearby(Wild* wild, Grid* g, Species s, int home) returns int {
                int sp = cast<int>(s);
                BlockChain* chain = wild.standing();
                BlockGrid* lat = chain.grid();
                int bx = lat.colOf(home);
                int by = lat.rowOf(home);
                mutable int ring = 1;
                while (ring <= Grazing.LOOK_OUT_BLOCKS) {
                    mutable int dy = 0 - ring;
                    while (dy <= ring) {
                        mutable int dx = 0 - ring;
                        while (dx <= ring) {
                            // Only the edge of the ring: the inside was searched by the ring before.
                            boolean edge = dx == 0 - ring || dx == ring || dy == 0 - ring || dy == ring;
                            if (edge && lat.holds(bx + dx, by + dy)) {
                                int b = lat.at(bx + dx, by + dy);
                                if (Grazing.livableBlock(lat, g, sp, b) &&
                                    wild.headAround(b, s) < Grazing.roomOf(lat, g, sp, b)) {
                                    return b;
                                }
                            }
                            dx = dx + 1;
                        }
                        dy = dy + 1;
                    }
                    ring = ring + 1;
                }
                return 0 - 1;
            }

            // Whether the middle of a block is ground this species lives on. THE MIDDLE, not a
            // sweep of all two hundred and fifty-six cells: this is asked up to a hundred and
            // sixty-eight times per split, and a block whose centre suits is a block worth walking
            // to -- the animals sort themselves out within it once they arrive.
            private static method livableBlock(BlockGrid* lat, Grid* g, int sp, int b)
                    returns boolean {
                int cx = lat.originX(b) + 8;
                int cy = lat.originY(b) + 8;
                if (cx >= g.width() || cy >= g.height()) {
                    return false;
                }
                return Beasts.livesIn(sp, g.biomeAt(cx, cy));
            }

            // And how many head of this species that block will keep, read off its middle by the
            // same rule.
            private static method roomOf(BlockGrid* lat, Grid* g, int sp, int b) returns int {
                int cx = lat.originX(b) + 8;
                int cy = lat.originY(b) + 8;
                if (cx >= g.width() || cy >= g.height()) {
                    return 0;
                }
                return Beasts.roomFor(sp, g.biomeAt(cx, cy));
            }
        }
    }
}
