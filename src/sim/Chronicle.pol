import System.IO.Console;
program AgentsExe;

// WHAT THE WORLD DID, SAID AS IT DOES IT.
//
// This exists because the thing it replaces was a lie. The world used to answer "what happened in
// you" with a total when it ended -- so many ticks, so many refused -- and A TOTAL IS PERFECTLY
// COMPATIBLE WITH THE WHOLE WORLD HAVING DONE THE WRONG THING CONSISTENTLY. That is not a figure of
// speech in this project: the northward tide and the wall-following agent both survived review with
// their counters reading correctly the entire time, and both were found by watching, late.
//
// The difference is not detail. It is that a summary cannot be caught being wrong, and a line
// saying what occurred at tick 4,120 can -- by a person reading it, and by a test.
//
// WRITTEN, NOT COLLECTED. A happening is said at the moment it happens, so what comes out is in the
// order the world did things, and a run that dies half way still has everything up to that point.
// A buffer flushed at the end would lose exactly the run worth reading.
//
// THE LINE IS FOR BOTH READERS, which is why it looks like this:
//
//     [4120] fauna: herd 12 split, 4 head left
//
// A person scanning a run sees a sentence. A behaviour test reads the tick, the layer and the text,
// and asserts on what the world DID rather than on a number it accumulated -- which is the whole
// point, and the thing whose absence is named as one of the largest causes of the last rewrite.
//
// WHAT IT COSTS, measured in the build before this one: a mature world traced per agent writes
// about a gigabyte a minute. That is a real ceiling and it decides nothing yet, because nothing is
// simulated -- the first layer to raise events in a hot loop is the one that has to answer it, with
// its own numbers rather than a guess made here.
public bundle Agents {
    public namespace Sim {

        public class Chronicle {
            // Whether anything is being written. A world nobody is reading about should pay
            // nothing, and the caller decides -- the same judgement the frame budget follows.
            private mutable boolean listening;

            public constructor Chronicle() {
                listening = true;
            }

            // Say that something happened, now.
            //
            // `layer` is who raised it -- fauna, folk, nations -- because a line's reader has to
            // know which part of the world is speaking, and because a test that cares about herds
            // should not have to read about weather.
            public method note(long tick, String layer, String said) returns void {
                if (!listening) {
                    return;
                }
                System.IO.Console.println($"[{tick}] {layer}: {said}");
                return;
            }

            // Stop or start writing. A long arc at high speed can outrun anybody's ability to read
            // it, and the answer to that is a decision by whoever started the run, not a silent
            // truncation in here.
            //
            // The parameter is not called `on`: that is a hard keyword here (`new T on heap`), and
            // the compiler says so at the declaration rather than at the call.
            public method listen(boolean writing) returns void {
                listening = writing;
                return;
            }

            public method writing() returns boolean {
                return listening;
            }
        }
    }
}
