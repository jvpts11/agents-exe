program AgentsExe;

// WHICH HERD, and not merely which integer.
//
// The seam rule: an id that is a bare `int` can be handed to anything that takes an int, so a herd
// index reaching a function that wanted a beast index is a bug the compiler has no way to see. A
// `newtype` is the same machine word with a name the type checker knows -- it costs nothing at run
// time and refuses the mix-up at the only moment it is cheap to refuse.
//
// `NONE` is -1 rather than 0, because 0 is a real herd.
public bundle Agents {
    public namespace Sim {

        public newtype HerdId = int;
    }
}
