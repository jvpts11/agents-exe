program AgentsExe;

// A MOVE THAT ONE HAND WORKED OUT AND ONLY ONE HAND MAY MAKE.
//
// An animal that stays inside its cell writes nothing but its own two coordinates, so six hands may
// do six of those at once and never meet. An animal that LEAVES its cell has to be unfiled from one
// block chain and filed into another, and those chains are shared -- two hands relinking the same
// chain at the same time is exactly the data race the language refuses to let a thread near.
//
// So the decision is made in parallel, where the expensive part is, and the relinking is written
// down here and done afterwards by the thread that handed the work out. That is about one animal in
// twenty, so nineteen twentieths of the pass shares and the rest is a short list applied in order.
//
// IN ORDER, which is what makes a world run by six hands the same world one hand would have made:
// each hand fills its own stretch of the list, and the stretches are applied lowest slot first --
// the order they happen in when nothing is shared at all.
public bundle Agents {
    public namespace Sim {

        public struct Crossing {
            public mutable int slot;
            public mutable float x;
            public mutable float y;
        }
    }
}
