import System.IO.Console;
import System.Time.Time;

// Where the time actually goes.
//
// Up to now the only performance number was "the sweep took 357 seconds", which says a slice got
// slower and nothing about WHICH part -- and every time something got slow the answer was found by
// reasoning rather than measuring. Twice that reasoning was wrong: the eighteen million failed
// searches looked like a world-size problem and were a where-the-question-lives problem, and the
// wolves looked like a fauna problem and were a missing-index problem.
//
// So the clock is stamped at each phase boundary and the shares are printed. One nanosecond read
// per boundary, seven boundaries a tick: a million reads across a full sweep, about thirty
// milliseconds of the three hundred and fifty seconds it measures.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        public class Meter {
            private mutable long[] ns;
            private mutable long[] hits;
            private mutable long mark;
            private mutable long ticks;
            private mutable long frames;
            private mutable long since;      // when the last per-second window opened
            private mutable int winTicks;
            private mutable int winFrames;
            private mutable int lastTps;
            private mutable int lastFps;

            public constructor Meter() {
                ns = new long[Phase.count()]();
                hits = new long[Phase.count()]();
                mark = Time.nanos();
                ticks = 0;
                frames = 0;
                since = Time.nanos();
                winTicks = 0;
                winFrames = 0;
                lastTps = 0;
                lastFps = 0;
            }

            public destructor ~Meter() returns void {
                delete ns;
                delete hits;
            }

            // Start a stretch. Call once before the first `lap` of a group.
            public method begin() returns void {
                mark = Time.nanos();
                return;
            }

            // Close the stretch that just ran and open the next one.
            public method lap(int phase) returns void {
                long now = Time.nanos();
                ns[phase] = ns[phase] + (now - mark);
                hits[phase] = hits[phase] + 1;
                mark = now;
                return;
            }

            public method tick() returns void {
                ticks = ticks + 1;
                winTicks = winTicks + 1;
                return;
            }

            public method frame() returns void {
                frames = frames + 1;
                winFrames = winFrames + 1;
                return;
            }

            // Roll the one-second window over if it is due. Returns true on the tick it rolled, so
            // a caller can refresh a title or a HUD exactly when the numbers changed.
            public method roll() returns boolean {
                long now = Time.nanos();
                long span = now - since;
                if (span < 1000000000) {
                    return false;
                }
                // Against the REAL elapsed span rather than assuming it was a second: a frame that
                // took four hundred milliseconds would otherwise be reported as a rate it never had.
                lastFps = cast<int>(cast<long>(winFrames) * 1000000000 / span);
                lastTps = cast<int>(cast<long>(winTicks) * 1000000000 / span);
                winFrames = 0;
                winTicks = 0;
                since = now;
                return true;
            }

            public method fps() returns int {
                return lastFps;
            }

            public method tps() returns int {
                return lastTps;
            }

            public method tickCount() returns long {
                return ticks;
            }

            public method frameCount() returns long {
                return frames;
            }

            public method millisOf(int phase) returns long {
                return ns[phase] / 1000000;
            }

            private method worst() returns int {
                mutable int best = 0 - 1;
                mutable long bestNs = 0;
                for (int p in 0..Phase.count()) {
                    if (ns[p] > bestNs) {
                        bestNs = ns[p];
                        best = p;
                    }
                }
                return best;
            }

            // The single most expensive phase and its share, for a readout that has one line to say
            // something with. Over the whole run rather than the last second: what is being asked is
            // "what should I look at", and a one-second window would have the answer flickering
            // between two phases that are close.
            public method worstName() returns String {
                int p = worst();
                if (p < 0) {
                    return "-";
                }
                // `this.` is load-bearing here: `label` is a reserved word (it names a loop label),
                // so the bare call is read as the keyword and fails to parse.
                return this.label(p);
            }

            public method worstShare() returns int {
                int p = worst();
                if (p < 0) {
                    return 0;
                }
                mutable long total = 0;
                for (int q in 0..Phase.count()) {
                    total = total + ns[q];
                }
                if (total == 0) {
                    return 0;
                }
                return cast<int>(ns[p] * 1000 / total);
            }

            private method label(int p) returns String {
                if (p == cast<int>(Phase.Terrain)) {
                    return "terrain";
                }
                if (p == cast<int>(Phase.People)) {
                    return "people";
                }
                if (p == cast<int>(Phase.Fauna)) {
                    return "fauna";
                }
                if (p == cast<int>(Phase.Town)) {
                    return "town";
                }
                if (p == cast<int>(Phase.Borders)) {
                    return "borders";
                }
                if (p == cast<int>(Phase.Draw)) {
                    return "draw";
                }
                if (p == cast<int>(Phase.Input)) {
                    return "input";
                }
                if (p == cast<int>(Phase.Moving)) {
                    return "moving";
                }
                if (p == cast<int>(Phase.Post)) {
                    return "post";
                }
                if (p == cast<int>(Phase.Hud)) {
                    return "hud";
                }
                if (p == cast<int>(Phase.Swap)) {
                    return "swap";
                }
                if (p == cast<int>(Phase.Teaching)) {
                    return "teaching";
                }
                if (p == cast<int>(Phase.Ordering)) {
                    return "ordering";
                }
                if (p == cast<int>(Phase.Sending)) {
                    return "sending";
                }
                if (p == cast<int>(Phase.Building)) {
                    return "building";
                }
                return "settling";
            }

            // Everything measured, worst first, with each phase's share of the measured total. The
            // ORDER is the point: a list sorted by cost is a list of what to look at next, and a
            // list in declaration order is a list nobody reads.
            public method report(String what) returns void {
                mutable long total = 0;
                for (int p in 0..Phase.count()) {
                    total = total + ns[p];
                }
                if (total == 0) {
                    return;
                }
                mutable int shown = 0;
                mutable long floor = 0 - 1;
                System.IO.Console.println($"{what}: {total / 1000000} ms measured over {ticks} ticks, {frames} frames");
                while (shown < Phase.count()) {
                    mutable int best = 0 - 1;
                    mutable long bestNs = 0 - 1;
                    for (int p in 0..Phase.count()) {
                        if (ns[p] <= 0) {
                            continue;
                        }
                        if (floor >= 0 && ns[p] >= floor) {
                            continue;
                        }
                        if (ns[p] > bestNs) {
                            bestNs = ns[p];
                            best = p;
                        }
                    }
                    if (best < 0) {
                        return;
                    }
                    floor = bestNs;
                    shown = shown + 1;
                    int share = cast<int>(bestNs * 1000 / total);
                    mutable long per = 0;
                    if (hits[best] > 0) {
                        per = bestNs / hits[best] / 1000;      // microseconds a call
                    }
                    System.IO.Console.println($"  {this.label(best)}:{bestNs / 1000000} ms ({share}/1000) | {per} us a call over {hits[best]} calls");
                }
                return;
            }
        }
    }
}
