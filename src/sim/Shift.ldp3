program AgentsExe;

// A JOB THAT CAN BE DONE IN PARTS, by several hands at once.
//
// The whole contract is in one sentence: `part(i, n)` does the i-th of n equal shares of the same
// job, and doing all n of them in any order, at the same time, must leave the world exactly as
// doing the job once would have. What that costs the implementer is the honest part -- it means no
// two parts may write the same thing -- and it is a promise the type cannot check, so the fauna's
// implementation is tested by running the world twice, with one hand and with many, and comparing
// what happened. See `Stir` and the check that carries its name.
//
// WHY AN INTERFACE AND NOT A LAMBDA. `Crew` hands the same job to six threads sixty to three
// hundred times a frame, and a lambda would be a closure built for each of them on each round --
// an allocation in the hottest loop of the game, for a job whose shape never changes. An object
// that lives as long as the pass carries its own working room instead: `Stir` keeps the crossings
// each hand was not allowed to make itself, and reuses that room every tick.
public bundle Agents {
    public namespace Sim {

        public interface Shift {
            // Do the `mine`-th of `parts` shares. Called on a worker thread for every share but the
            // zeroth, which the calling thread does itself.
            //
            // (`mine` and not `index`, which is a word of the language.)
            method part(int mine, int parts) returns void;
        }
    }
}
