import System.IO.Console;

// Every polity in the world, as one table.
//
// A SETTLEMENT is a place: it has a store, workshops, houses, a centre that drifts with its people.
// A NATION is who those places answer to, and it is the layer that was missing -- without it a
// village that outgrows its ground becomes a STRANGER to the village it came from, so the world
// could only ever fragment into more and more small independent places, and nothing anywhere ever
// got bigger than one day's walk across. A daughter that stays under its mother's seat is the whole
// difference between a world of hamlets and a world with countries in it.
//
// Nothing here is declared. A nation's rank, its capital, its ruler and its borders are all READ
// off the settlements it holds, the same way a community's centre is read off where its people
// stand and its culture is read off what they do for a living. Nobody proclaims a kingdom; a seat
// with three towns under it IS one.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        // What a polity has become. The ladder is read from state that already exists, so a nation
        // cannot be at a rank its people have not actually built.
        public enum Rank {
            Band,            // people who live together and answer to nobody
            Chiefdom,        // one seat, one voice
            Kingdom,         // that seat holds towns it did not start as
            Empire           // and some of them were somebody else's
        }

        public class Nations {
            private mutable int cap;
            private mutable int[] seat;      // capital settlement, or -1 if nobody is left
            private mutable int[] holds;     // settlements under it
            private mutable int[] folk;      // people in all of them
            private mutable int[] land;      // 16-cell blocks its settlements claim
            private mutable int[] lore;      // what it is working out, pooled across every town
            private mutable int[] era;
            private mutable int[] ruler;     // the agent sitting in the capital, or -1
            private mutable byte[] rank;
            private mutable int[] taken;     // settlements that used to answer to somebody else
            private mutable int[] lost;
            private mutable int[] born;      // the second it came into being
            private mutable int[] parent;    // the nation it broke from, or -1
            // Speech. A root and a distance from it: two nations with the same root and a small gap
            // between their drifts are speaking dialects of one language, and two with different
            // roots are not related at all. Kept here from the start even though nothing reads it
            // yet, because a tongue that begins the day a feature needs it has no history in it --
            // and a language family is nothing BUT history.
            private mutable int[] tongue;
            private mutable int[] drift;
            // And the ROOT of the root. A tongue is what a people speaks today; a trunk is the
            // language it descends from, and it never changes for anybody -- a nation that breaks
            // away, a nation whose speech has drifted so far it is a different language, and a nation
            // that has done both still carry the trunk they started with.
            //
            // That is the whole of a CIVILIZATION: not a thing anybody joins or declares, just the
            // set of nations that turn out to share one. It is the same trick as rank -- read off
            // state that already exists rather than proclaimed -- and it means the map's cultural
            // groupings cannot disagree with its history, because they ARE its history.
            private mutable int[] trunk;
            private mutable int[] hue;       // banner, so two neighbours never read as one country
            // The biggest town seen so far this count, so the capital falls out of ONE pass over
            // the settlements instead of the caller sorting anything.
            private mutable int[] best;

            public constructor Nations(int capacity) {
                this.cap = capacity;
                this.seat = new int[capacity]();
                this.holds = new int[capacity]();
                this.folk = new int[capacity]();
                this.land = new int[capacity]();
                this.lore = new int[capacity]();
                this.era = new int[capacity]();
                this.ruler = new int[capacity]();
                this.rank = new byte[capacity]();
                this.taken = new int[capacity]();
                this.lost = new int[capacity]();
                this.born = new int[capacity]();
                this.parent = new int[capacity]();
                this.tongue = new int[capacity]();
                this.drift = new int[capacity]();
                this.trunk = new int[capacity]();
                this.hue = new int[capacity]();
                this.best = new int[capacity]();
                for (int i in 0..capacity) {
                    this.seat[i] = 0 - 1;
                    this.ruler[i] = 0 - 1;
                    this.parent[i] = 0 - 1;
                    this.era[i] = 0;
                    this.tongue[i] = 0 - 1;
                }
            }

            public destructor ~Nations() returns void {
                delete this.seat;
                delete this.holds;
                delete this.folk;
                delete this.land;
                delete this.lore;
                delete this.era;
                delete this.ruler;
                delete this.rank;
                delete this.taken;
                delete this.lost;
                delete this.born;
                delete this.parent;
                delete this.tongue;
                delete this.drift;
                delete this.trunk;
                delete this.hue;
                delete this.best;
            }

            public method limit() returns int {
                return this.cap;
            }

            // A nation exists while somebody lives under it. There is no dissolution ceremony: a
            // polity whose last town was absorbed simply stops being counted, and its number goes
            // back in the pot for a people who break away later.
            public method alive(int nat) returns boolean {
                if (nat < 0 || nat >= this.cap) {
                    return false;
                }
                return this.folk[nat] > 0;
            }

            // Bring one into being. `root` is the tongue it speaks: a nation that breaks away keeps
            // its mother's, which is what makes a language family rather than a list of languages.
            public method raise(int nat, int root, int broke, int tick, int era0) returns void {
                this.seat[nat] = 0 - 1;
                this.holds[nat] = 0;
                this.folk[nat] = 0;
                this.land[nat] = 0;
                this.lore[nat] = 0;
                this.era[nat] = era0;
                this.ruler[nat] = 0 - 1;
                this.rank[nat] = cast<byte>(cast<int>(Rank.Band));
                this.taken[nat] = 0;
                this.lost[nat] = 0;
                this.born[nat] = tick;
                this.parent[nat] = broke;
                this.tongue[nat] = root;
                this.drift[nat] = 0;
                // A people that breaks away is still of the same stock. Only a nation with no
                // parent -- and there are none of those after the first second of the world --
                // begins a trunk of its own.
                if (broke >= 0 && broke < this.cap) {
                    this.trunk[nat] = this.trunk[broke];
                } else {
                    this.trunk[nat] = nat;
                }
                this.hue[nat] = Nations.banner(this.trunk[nat], nat);
                return;
            }

            // Which stock a people came from, fixed at the founding of the world. Only the seeding
            // pass calls this: after that a trunk is inherited and never assigned.
            //
            // The TONGUE is seeded with it, and that turned out to matter more than the trunk. Every
            // band beginning with a language of its own meant a hundred and thirty languages at the
            // first second, seventy-three still at the last, and "two peoples who speak the same
            // language" was a thing that never once happened in a whole arc -- so the learning bonus
            // that hangs off it never fired. One people, one language, and then it drifts.
            public method settleTrunk(int nat, int stock) returns void {
                this.trunk[nat] = stock;
                this.tongue[nat] = stock;
                this.drift[nat] = 0;
                this.hue[nat] = Nations.banner(stock, nat);
                return;
            }

            // The banner. Same stock, same family of colour; each nation within it a shade of its
            // own, so a glance at the map reads the civilizations without a legend and a second
            // glance still tells the countries apart.
            public static method banner(int stock, int nat) returns int {
                int h = (stock * 2654435761) ^ 0x5F3A;
                mutable int r = (h >> 16) & 255;
                mutable int g = (h >> 8) & 255;
                mutable int b = h & 255;
                // Lift the family clear of mud: whichever channel is weakest gets a floor, so no
                // civilization ends up as a set of indistinguishable browns.
                if (r < 60) {
                    r = 60;
                }
                if (g < 60) {
                    g = 60;
                }
                if (b < 60) {
                    b = 60;
                }
                // And then the nation's own shade of it, between roughly two thirds and full.
                int shade = 170 + (((nat * 2246822519) >> 9) & 85);
                r = r * shade / 255;
                g = g * shade / 255;
                b = b * shade / 255;
                return (r << 16) | (g << 8) | b;
            }

            // A number nobody is using.
            public method open() returns int {
                for (int i in 0..this.cap) {
                    if (this.folk[i] <= 0 && this.seat[i] < 0) {
                        return i;
                    }
                }
                return 0 - 1;
            }

            // ---- what the census writes ----

            public method beginCount() returns void {
                for (int i in 0..this.cap) {
                    this.holds[i] = 0;
                    this.folk[i] = 0;
                    this.land[i] = 0;
                    this.seat[i] = 0 - 1;
                    this.best[i] = 0;
                }
                return;
            }

            // One settlement reporting in. The capital is simply the biggest town a nation holds --
            // nobody chooses it, and a seat that is overtaken by one of its own colonies MOVES,
            // which is how a country's centre of gravity travels over an arc.
            public method countTown(int nat, int town, int pop) returns void {
                if (nat < 0 || nat >= this.cap || pop <= 0) {
                    return;
                }
                this.holds[nat] = this.holds[nat] + 1;
                this.folk[nat] = this.folk[nat] + pop;
                if (this.seat[nat] < 0 || pop > this.best[nat]) {
                    this.seat[nat] = town;
                    this.best[nat] = pop;
                }
                return;
            }

            public method countLand(int nat) returns void {
                if (nat < 0 || nat >= this.cap) {
                    return;
                }
                this.land[nat] = this.land[nat] + 1;
                return;
            }

            // Settle the rank once every town has reported. Read, never set: a seat with three towns
            // under it is a kingdom whether or not anybody in it uses the word.
            public method settleRank(int nat, int lord) returns void {
                this.ruler[nat] = lord;
                mutable int r = cast<int>(Rank.Band);
                if (lord >= 0) {
                    r = cast<int>(Rank.Chiefdom);
                    if (this.holds[nat] >= Nations.KINGDOM_TOWNS) {
                        r = cast<int>(Rank.Kingdom);
                        if (this.taken[nat] >= Nations.EMPIRE_TAKEN) {
                            r = cast<int>(Rank.Empire);
                        }
                    }
                }
                this.rank[nat] = cast<byte>(r);
                return;
            }

            // Towns under one seat before it is a kingdom rather than a chief and his neighbours.
            // Three: the smallest number that cannot be one place and its overflow.
            public static int KINGDOM_TOWNS = 3;

            // And how many of them have to have been somebody else's. One is enough -- a polity that
            // rules a people it did not raise is an empire however small, and holding two peoples
            // together is the thing that is actually hard.
            public static int EMPIRE_TAKEN = 1;

            // Speech moves on its own, a step a census, and it moves DIFFERENTLY in every nation --
            // which is the point. Two peoples who parted at the same hour drift apart from that hour
            // on, so the gap between their tongues measures the time since they were one people.
            public method wag(int nat, int seed, int tick) returns void {
                if (this.folk[nat] <= 0) {
                    return;
                }
                int nudge = ((nat * 40503 + tick * 2654435761 + seed) >> 7) & 3;
                this.drift[nat] = this.drift[nat] + nudge;
                // Far enough and it is no longer the same language, only a related one. The TRUNK is
                // untouched -- that is the entire difference between a language splitting and a
                // people leaving. A civilization is what survives its languages diverging, and if
                // this reset the trunk there would be no such thing.
                if (this.drift[nat] >= Nations.SPLIT_DRIFT) {
                    this.tongue[nat] = nat;
                    this.drift[nat] = 0;
                }
                return;
            }

            // How far speech travels before it is a different language.
            //
            // MEASURED TWICE, and the second measurement is the interesting one.
            //
            // `wag` adds nought to three a census and an arc is about seven thousand censuses. At
            // eight hundred every lineage split thirteen times over one arc; at twenty-four hundred
            // it still split three or four times -- and BOTH ended with seventy-three nations
            // speaking seventy-three languages, because a split names the new tongue after the
            // nation that split, so one split is enough to leave a people speaking something nobody
            // else does. The question was never "how many times", it was "does a lineage split at
            // all within the time anybody is watching".
            //
            // Nine thousand is about one split per lineage per arc. Peoples who parted recently
            // still understand each other, peoples who parted long ago do not, and the learning
            // bonus that hangs off sharing a language finally has somebody to give it to.
            public static int SPLIT_DRIFT = 9000;

            // ---- names ----
            //
            // A civilization with a number for a name is a spreadsheet row. These are built out of
            // the trunk itself, so the name is as fixed as the thing it names and two runs of the
            // same seed produce the same world with the same peoples in it.
            private static mutable String[] ONSET;
            private static mutable String[] VOWEL;
            private static mutable String[] CODA;
            private static mutable String[] SUFFIX;

            onClassLoad {
                Nations.ONSET = new String[16]();
                Nations.ONSET[0] = "k";   Nations.ONSET[1] = "t";   Nations.ONSET[2] = "v";
                Nations.ONSET[3] = "m";   Nations.ONSET[4] = "s";   Nations.ONSET[5] = "n";
                Nations.ONSET[6] = "dr";  Nations.ONSET[7] = "h";   Nations.ONSET[8] = "l";
                Nations.ONSET[9] = "br";  Nations.ONSET[10] = "z";  Nations.ONSET[11] = "g";
                Nations.ONSET[12] = "th"; Nations.ONSET[13] = "p";  Nations.ONSET[14] = "sk";
                Nations.ONSET[15] = "r";
                Nations.VOWEL = new String[8]();
                Nations.VOWEL[0] = "a";  Nations.VOWEL[1] = "e";  Nations.VOWEL[2] = "i";
                Nations.VOWEL[3] = "o";  Nations.VOWEL[4] = "u";  Nations.VOWEL[5] = "ae";
                Nations.VOWEL[6] = "ou"; Nations.VOWEL[7] = "y";
                Nations.CODA = new String[8]();
                Nations.CODA[0] = "n";  Nations.CODA[1] = "r";  Nations.CODA[2] = "l";
                Nations.CODA[3] = "s";  Nations.CODA[4] = "th"; Nations.CODA[5] = "m";
                Nations.CODA[6] = "";   Nations.CODA[7] = "k";
                // What a country of that stock is called: the family name with an ending on it, the
                // way half the countries on a real map are named after the people in them.
                Nations.SUFFIX = new String[8]();
                Nations.SUFFIX[0] = "ia";   Nations.SUFFIX[1] = "mark"; Nations.SUFFIX[2] = "land";
                Nations.SUFFIX[3] = "or";   Nations.SUFFIX[4] = "esh";  Nations.SUFFIX[5] = "vale";
                Nations.SUFFIX[6] = "gard"; Nations.SUFFIX[7] = "un";
            }

            // The name of a stock. Two or three syllables built out of the trunk's own number.
            public static method stockName(int stock) returns String {
                int h = (stock * 2654435761) ^ 0x9E37;
                mutable string s = "";
                s = s + Nations.ONSET[(h >> 3) & 15];
                s = s + Nations.VOWEL[(h >> 7) & 7];
                s = s + Nations.CODA[(h >> 11) & 7];
                s = s + Nations.ONSET[(h >> 14) & 15];
                s = s + Nations.VOWEL[(h >> 19) & 7];
                if (((h >> 22) & 1) == 1) {
                    s = s + Nations.CODA[(h >> 23) & 7];
                }
                String word = s.toString();
                return word.substring(0, 1).toUpper() + word.substring(1, word.length());
            }

            // What this civilization is called.
            public method civilizationName(int nat) returns String {
                return Nations.stockName(this.trunk[nat]);
            }

            // And what this country is called: its stock's name with an ending of its own, so a
            // civilization reads as a family on the map as well as in the numbers.
            public method nameOf(int nat) returns String {
                String stem = Nations.stockName(this.trunk[nat]);
                if (this.trunk[nat] == nat) {
                    return stem;             // the eldest of the line keeps the plain name
                }
                return stem + Nations.SUFFIX[((nat * 2246822519) >> 5) & 7];
            }

            // ---- what everybody else reads ----

            public method seatOf(int nat) returns int {
                return this.seat[nat];
            }

            public method townsOf(int nat) returns int {
                return this.holds[nat];
            }

            public method peopleOf(int nat) returns int {
                return this.folk[nat];
            }

            public method landOf(int nat) returns int {
                return this.land[nat];
            }

            public method rankOf(int nat) returns int {
                return cast<int>(this.rank[nat]) & 255;
            }

            public method rulerOf(int nat) returns int {
                return this.ruler[nat];
            }

            public method eraOf(int nat) returns int {
                if (nat < 0 || nat >= this.cap) {
                    return 1;
                }
                return this.era[nat];
            }

            public method loreOf(int nat) returns int {
                return this.lore[nat];
            }

            public method tongueOf(int nat) returns int {
                return this.tongue[nat];
            }

            public method trunkOf(int nat) returns int {
                if (nat < 0 || nat >= this.cap) {
                    return 0 - 1;
                }
                return this.trunk[nat];
            }

            // Two peoples of one stock. Not a treaty and not an alliance -- a fact about where they
            // both came from, which is why it survives them going to war with each other.
            public method sameStock(int a, int b) returns boolean {
                if (a < 0 || b < 0 || a >= this.cap || b >= this.cap) {
                    return false;
                }
                return this.trunk[a] == this.trunk[b];
            }

            // How many stocks still have anybody speaking for them, and how many countries the
            // largest of them holds.
            public method civilizations() returns int {
                mutable int c = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0 && this.trunk[i] == i) {
                        c = c + 1;
                    }
                }
                // A stock whose eldest line died out is still a stock: count the ones held only by
                // younger branches too, by looking for trunks nobody above has claimed.
                for (int i in 0..this.cap) {
                    if (this.folk[i] <= 0 || this.trunk[i] == i) {
                        continue;
                    }
                    int t = this.trunk[i];
                    if (t >= 0 && t < this.cap && this.folk[t] > 0) {
                        continue;            // its eldest is alive and was already counted
                    }
                    mutable boolean first = true;
                    for (int j in 0..i) {
                        if (this.folk[j] > 0 && this.trunk[j] == t) {
                            first = false;
                        }
                    }
                    if (first) {
                        c = c + 1;
                    }
                }
                return c;
            }

            public method nationsOfStock(int stock) returns int {
                mutable int c = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0 && this.trunk[i] == stock) {
                        c = c + 1;
                    }
                }
                return c;
            }

            // The stock with the most countries under it, or -1.
            public method widestStock() returns int {
                mutable int best = 0 - 1;
                mutable int most = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] <= 0) {
                        continue;
                    }
                    int n = this.nationsOfStock(this.trunk[i]);
                    if (n > most) {
                        most = n;
                        best = this.trunk[i];
                    }
                }
                return best;
            }

            // Living languages: a tongue anybody still speaks. Always at least as many as there are
            // stocks and usually more, which is the shape a language family has.
            public method livingTongues() returns int {
                mutable int c = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] <= 0) {
                        continue;
                    }
                    mutable boolean first = true;
                    for (int j in 0..i) {
                        if (this.folk[j] > 0 && this.tongue[j] == this.tongue[i]) {
                            first = false;
                        }
                    }
                    if (first) {
                        c = c + 1;
                    }
                }
                return c;
            }

            public method driftOf(int nat) returns int {
                return this.drift[nat];
            }

            public method parentOf(int nat) returns int {
                return this.parent[nat];
            }

            public method takenBy(int nat) returns int {
                return this.taken[nat];
            }

            public method lostBy(int nat) returns int {
                return this.lost[nat];
            }

            public method bannerOf(int nat) returns int {
                return this.hue[nat];
            }

            public method bornAt(int nat) returns int {
                return this.born[nat];
            }

            // ---- what the simulation writes ----

            // Knowledge is pooled and spent by the WHOLE nation. A kingdom of eight towns works
            // things out faster than one village does, which is the plainest thing in the world and
            // was exactly what the old per-community, per-HEAD rule denied: dividing surplus by
            // population made a city of eight hundred learn at the same rate as a hamlet of forty,
            // so nothing anybody built ever made the world cleverer and the fourth era was
            // unreachable by construction.
            public method study(int nat, int gain, int cost, int last) returns boolean {
                if (nat < 0 || nat >= this.cap || this.era[nat] >= last || gain <= 0) {
                    return false;
                }
                this.lore[nat] = this.lore[nat] + gain;
                if (this.lore[nat] < cost) {
                    return false;
                }
                this.lore[nat] = this.lore[nat] - cost;
                this.era[nat] = this.era[nat] + 1;
                return true;
            }

            // One nation swallows another's town, by absorption or by force. What it gains is a town
            // and a claim to have ruled somebody; what the other loses is the same town, and when it
            // loses the last one it is gone.
            public method annex(int winner, int loser) returns void {
                if (winner < 0 || winner >= this.cap || loser < 0 || loser >= this.cap) {
                    return;
                }
                if (winner == loser) {
                    return;
                }
                this.taken[winner] = this.taken[winner] + 1;
                this.lost[loser] = this.lost[loser] + 1;
                // Everything the smaller people knew, the bigger one now has somebody who knows it.
                // Knowledge is not averaged away by being conquered.
                if (this.era[loser] > this.era[winner]) {
                    this.era[winner] = this.era[loser];
                }
                if (this.lore[loser] > this.lore[winner]) {
                    this.lore[winner] = this.lore[loser];
                }
                return;
            }

            // Nations with anybody in them.
            public method living() returns int {
                mutable int c = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0) {
                        c = c + 1;
                    }
                }
                return c;
            }

            public method countOfRank(int r) returns int {
                mutable int c = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0 && this.rankOf(i) == r) {
                        c = c + 1;
                    }
                }
                return c;
            }

            public method countOfEra(int e) returns int {
                mutable int c = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0 && this.era[i] == e) {
                        c = c + 1;
                    }
                }
                return c;
            }

            public method mostTowns() returns int {
                mutable int m = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0 && this.holds[i] > m) {
                        m = this.holds[i];
                    }
                }
                return m;
            }

            public method bestEra() returns int {
                mutable int e = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > 0 && this.era[i] > e) {
                        e = this.era[i];
                    }
                }
                return e;
            }

            public method biggest() returns int {
                mutable int at = 0 - 1;
                mutable int most = 0;
                for (int i in 0..this.cap) {
                    if (this.folk[i] > most) {
                        most = this.folk[i];
                        at = i;
                    }
                }
                return at;
            }
        }
    }
}
