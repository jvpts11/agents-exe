program AgentsExe;

// WHAT A HERD IS DOING, which is a different question from what its animals are doing.
//
// The herd thinks; the beast follows. One to two thousand decisions a tick instead of fifteen
// thousand -- the same trade as the block index and the sliced bake. A mood is the herd's decision;
// a `BeastState` is what one animal is doing about it.
//
// Sealed: five moods and no sixth without every `match` over them being told.
public bundle Agents {
    public namespace Sim {

        public sealed enum HerdMood permits
            Drifting,    // grazing its range, going nowhere
            MovingOn,    // crossing to new ground; its animals are Migrating
            Fleeing,     // something drove it, and the whole herd is running
            Hunting,     // predators: it has picked a herd and is closing
            Starving;    // predators: it has not eaten, and is losing animals to it
    }
}
