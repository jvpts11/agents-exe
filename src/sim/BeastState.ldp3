program AgentsExe;

// WHAT AN ANIMAL IS DOING. Eight, and the tick needs exactly eight.
//
// They are named because a three-bit field with unnamed contents is how a bug becomes
// unattributable: an animal in state 5 that should not be there is only visible if 5 has a name.
//
// SEALED, so a `match` over a state must cover every one of them. That is not decoration -- the
// ninth state, whenever it comes, is reported at every place written before it instead of being
// swallowed by a `default`.
//
// `Migrating` earns its bit twice. It is an `invariant` that a beast stands in a biome its species
// can live in, and a herd that moves on has to CROSS ground where it cannot. Without a name for that
// crossing the invariant is either wrong or switched off somewhere, and a contract with a quiet
// exception is worse than none: the habitat invariant holds in every state but this one, and this
// one is bounded by the move.
//
// DEATH IS NOT A STATE. A dead beast leaves the array by swap-remove and decrements the census there
// and then. Keeping the dead behind a flag makes every sweep pay for them and stops the census being
// the count of what is alive -- which is the number extinction is read from.
public bundle Agents {
    public namespace Sim {

        public sealed enum BeastState permits
            Grazing,     // still, feeding, inside the herd's range. The resting state
            Following,   // walking toward the herd centre with its own jitter
            Migrating,   // the herd is moving on: crossing ground it does NOT live in
            Fleeing,     // something came inside SHY. A burst, and it spends stamina
            Winded,      // stamina gone: it walks, it cannot burst, and this is where it is caught
            Stalking,    // a predator closing on prey its herd picked
            Feeding,     // a predator on a kill: fixed in place for a few seconds
            Starving;    // a predator that has not eaten: losing condition, and dying of it
    }
}
