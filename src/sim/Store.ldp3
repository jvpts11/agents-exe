import System.IO.Console;
import Agents.World.Good;
import Agents.World.Goods;

// What every community owns, as one flat table: `ncomm` rows of `Good.count()` amounts.
//
// This replaces a single `int cwood` on the simulation, which was honest for exactly one trade and
// stopped being honest the moment there were six. A community's whole economic state is what it has
// in hand, so it belongs in one place that the trades put into, the buildings take out of, and the
// hungry eat from -- and it has to be indexable by an ordinal, because every one of those is a hot
// loop that cannot afford a map lookup.
//
// A hundred communities across fifty-seven goods is twenty-three kilobytes. The cost of this
// structure is not its size, it is that it is the ONLY place a good exists: nothing is created by
// being harvested and destroyed by being eaten anywhere else.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        public class Stores {
            private mutable int ncomm;
            private mutable int ngood;
            private mutable int[] amount;
            // What came in and what went out over the whole run, per good, so a chain that never
            // starts and a chain that runs dry look different in the report.
            private mutable long[] produced;
            private mutable long[] consumed;

            public constructor Stores(int communities) {
                this.ncomm = communities;
                this.ngood = Goods.count();
                this.amount = new int[this.ncomm * this.ngood]();
                this.produced = new long[this.ngood]();
                this.consumed = new long[this.ngood]();
            }

            public destructor ~Stores() returns void {
                delete this.amount;
                delete this.produced;
                delete this.consumed;
            }

            public method communities() returns int {
                return this.ncomm;
            }

            public method goods() returns int {
                return this.ngood;
            }

            public method amountOf(int comm, int good) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0;
                }
                return this.amount[comm * this.ngood + good];
            }

            // Put something in. Production is counted here and nowhere else, so the ledger cannot
            // disagree with the shelves.
            public method add(int comm, int good, int n) returns void
                requires n >= 0
            {
                if (comm < 0 || comm >= this.ncomm || good <= 0 || n == 0) {
                    return;
                }
                int at = comm * this.ngood + good;
                this.amount[at] = this.amount[at] + n;
                this.produced[good] = this.produced[good] + cast<long>(n);
                return;
            }

            // Take what is there, up to `n`, and say how much that was. A caller that needs all of
            // it or none must ask first -- half a loaf is the right answer for eating and the wrong
            // answer for a building's recipe.
            public method take(int comm, int good, int n) returns int
                requires n >= 0
            {
                if (comm < 0 || comm >= this.ncomm || good <= 0 || n == 0) {
                    return 0;
                }
                int at = comm * this.ngood + good;
                mutable int got = this.amount[at];
                if (got > n) {
                    got = n;
                }
                this.amount[at] = this.amount[at] - got;
                this.consumed[good] = this.consumed[good] + cast<long>(got);
                return got;
            }

            public method has(int comm, int good, int n) returns boolean {
                return this.amountOf(comm, good) >= n;
            }

            // Everything edible a community holds, which is the number that decides whether it can
            // feed itself and therefore how big it grows.
            public method foodOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0;
                }
                mutable int t = 0;
                int base = comm * this.ngood;
                for (int g in 0..this.ngood) {
                    if (Goods.edible(g)) {
                        t = t + this.amount[base + g];
                    }
                }
                return t;
            }

            // Eat `n` units of whatever there is, cheapest-to-reach first, and say how much was
            // actually eaten. Which food it was does not matter to hunger; that it ran out does.
            public method eat(int comm, int n) returns int {
                mutable int left = n;
                for (int g in 0..this.ngood) {
                    if (left <= 0) {
                        continue;
                    }
                    if (Goods.edible(g)) {
                        left = left - this.take(comm, g, left);
                    }
                }
                return n - left;
            }

            public method producedOf(int good) returns long {
                return this.produced[good];
            }

            public method consumedOf(int good) returns long {
                return this.consumed[good];
            }

            // Communities holding any of this good at all -- the difference between a chain that
            // works somewhere and a chain that works everywhere.
            public method holders(int good) returns int {
                mutable int c = 0;
                for (int i in 0..this.ncomm) {
                    if (this.amount[i * this.ngood + good] > 0) {
                        c = c + 1;
                    }
                }
                return c;
            }
        }
    }
}
