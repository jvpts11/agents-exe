import System.IO.Console;
program AgentsExe;

// HOW A CHASE ENDED. Three ways, all named, all counted.
//
// A CHASE MUST END, and this type is the fauna layout's answer to why. The build this one replaces
// had a hunt (#402) that searched until it found something, which on a continent with no deer left
// is a search that does not end -- and the run where that was discovered was spent watching agents
// spin against nothing. A bound written after the fact is a bound nobody trusts; this one is the
// type of the result, so a chase cannot be written without saying how it stopped.
//
// AND ALL THREE ARE OUTCOMES, not one outcome and two errors. A hunter who gives out has hunted; a
// herd that outran him has escaped. Counting only the kills would make a world where nobody eats
// look exactly like a world where nobody hunts, and those need different repairs.
public bundle Agents {
    public namespace Sim {

        public sealed enum Quarry permits
            Caught,          // the beast tired first: meat and hide, carried home
            HunterGaveOut,   // the hunter tired first, and how far he ran is worth knowing
            Escaped;         // the herd outran his reach: neither of them is tired, and it is over
        {
            // What the world says when a chase ends this way.
            public method said() returns String {
                return match (this) {
                    case Caught -> "ran it down";
                    case HunterGaveOut -> "gave out";
                    case Escaped -> "lost it";
                };
            }

            // Whether anything came of it. The one question the economy asks, and asking it here
            // rather than comparing against `Caught` at each call site is what stops a fourth
            // ending arriving and being silently counted as a failure.
            public method fed() returns boolean {
                return match (this) {
                    case Caught -> true;
                    case HunterGaveOut -> false;
                    case Escaped -> false;
                };
            }
        }
    }
}
