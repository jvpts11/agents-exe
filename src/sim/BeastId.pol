program AgentsExe;

// WHICH ANIMAL. An index into `Wild`'s one array, named so it cannot be passed where a `HerdId`
// belongs -- see that file for why the seam is worth a type.
//
// It is an INDEX AND NOT A HANDLE, and the difference matters here: a dead beast leaves the array by
// swap-remove, so the last animal takes the dead one's slot and every id that pointed at the last
// animal now points at a different one. Anything holding a `BeastId` across a death must be told, or
// hold a herd instead. The roster is maintained for exactly this reason.
public bundle Agents {
    public namespace Sim {

        public newtype BeastId = int;
    }
}
