import System.IO.Console;
import Agents.Sim.Beast;
import Agents.Sim.Herd;
import Agents.Sim.BeastId;
import Agents.Sim.HerdId;
import Agents.Sim.BeastState;
import Agents.Sim.HerdMood;
import Agents.Sim.BlockChain;
import Agents.Sim.Vanished;
import Agents.Sim.Chronicle;
import Agents.World.Species;
import Agents.World.Beasts;
program AgentsExe;

// EVERY ANIMAL IN THE WORLD, and the herds that think for them.
//
// The beasts are ONE ARRAY of value structs -- no allocation per animal, ever, which is the
// constraint the whole layout is built on. The herds are objects, because a herd has a lifecycle.
//
// DEATH IS A SWAP-REMOVE, and that is the one thing a reader has to hold in their head: the last
// animal takes the dead one's slot, so its `BeastId` CHANGES. Anything holding an id across a death
// is wrong unless it is told, which is why the roster is maintained through the transformer rather
// than by hand, and why the census is kept as they are born and die rather than swept.
public bundle Agents {
    public namespace Sim {

        public class Wild {
            public static fixed int NO_HERD = 0 - 1;

            private mutable Beast[] beasts;
            private mutable int alive;
            private mutable int room;

            private mutable Herd*[] herds;
            private mutable int herdCount;
            private mutable int herdRoom;

            // How many of each species are alive. NEVER SWEPT: sweeping fifteen thousand animals to
            // count eighteen numbers is the pattern this project has paid for twice. It is kept as
            // they are born and die, which also makes it the number extinction is read from.
            private mutable int[] census;

            // WHO STANDS WHERE. Maintained by the three methods that move an animal -- `bear`,
            // `bury` and `placeAt` -- and by nothing else, which is the only way an index stays
            // true: a fourth place that moves an animal without telling it produces a chain
            // pointing at ground the animal left.
            private mutable BlockChain* blocks;

            // The ground is this big, and the index is cut to fit it. A Wild belongs to a world.
            public constructor Wild(int width, int height) {
                room = 1024;
                beasts = new Beast[room]();
                alive = 0;
                herdRoom = 64;
                herds = new Herd*[herdRoom]();
                herdCount = 0;
                movers = new int[herdRoom]();
                moving = 0;
                census = new int[Species.count()]();
                blocks = new BlockChain(width, height, room) on heap;
                walked = 0.0;
                bolted = 0;
                causes = new int[Species.count()]();
                gone = new boolean[Species.count()]();
                killed = 0;
                famished = 0;
                aged = 0;
                born = 0;
                chasesLost = 0;
                lost = 0;
            }

            public destructor ~Wild() returns void {
                for (int i in 0..herdCount) {
                    delete herds[i];
                }
                delete herds;
                delete movers;
                delete beasts;
                delete census;
                delete blocks;
                delete causes;
                delete gone;
                return;
            }

            public method count() returns int {
                return alive;
            }

            // The block index, for whoever asks who is near -- the bake, and from S1.6 the fauna
            // itself. Borrowed: it dies with the Wild.
            public method standing() returns BlockChain* {
                return blocks;
            }

            // HOW MANY OF ONE SPECIES STAND IN ONE BLOCK -- what breeding asks before it allows a
            // birth, and what a splitting herd's daughter asks of the ground she is thinking of
            // walking to.
            //
            // WALKED, NOT KEPT. A kept table would be one number per block per species: fourteen
            // thousand blocks by eighteen species is a quarter of a million counters to maintain on
            // every birth, death and border crossing, for a question asked a few hundred times a
            // second. The chain in a block holds a handful of animals, and walking it is cheaper
            // than the writes the table would cost.
            public method headIn(int block, Species s) returns int {
                int want = cast<int>(s);
                mutable int n = 0;
                mutable int slot = blocks.firstIn(block);
                while (slot != BlockChain.NONE) {
                    if (cast<int>(beasts[slot].species) == want) {
                        n = n + 1;
                    }
                    slot = blocks.after(slot);
                }
                return n;
            }

            // The block a place falls in, so a caller can ask the two questions above without
            // reaching through to the lattice itself.
            public method blockAt(float x, float y) returns int {
                return blocks.grid().ofCellClamped(cast<int>(x), cast<int>(y));
            }

            // THE SAME COUNT OVER THE BLOCK AND THE EIGHT AROUND IT, which is the one breeding
            // actually asks -- and the difference is the density of the whole world.
            //
            // A block is sixteen cells and a herd's range is four to twelve, so a herd grazes over
            // more ground than the block its centre happens to sit in. Counting one block lets every
            // block on the continent hold a full herd, and the continent fills: measured, that is
            // forty-eight thousand animals, a tick of 168 microseconds, and a top gear running at a
            // sixth of the speed printed on it. Counting the neighbourhood is the same rule at the
            // scale the animals actually use, and it is what makes the world sparse enough to run.
            public method headAround(int block, Species s) returns int {
                BlockGrid* lat = blocks.grid();
                int bx = lat.colOf(block);
                int by = lat.rowOf(block);
                mutable int n = 0;
                mutable int dy = 0 - 1;
                while (dy <= 1) {
                    mutable int dx = 0 - 1;
                    while (dx <= 1) {
                        if (lat.holds(bx + dx, by + dy)) {
                            n = n + headIn(lat.at(bx + dx, by + dy), s);
                        }
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                return n;
            }

            public method herdsAlive() returns int {
                return herdCount;
            }

            public method howMany(Species s) returns int {
                return census[cast<int>(s)];
            }

            // ---- beasts -------------------------------------------------------------------------

            private method growBeasts() returns void {
                int bigger = room * 2;
                mutable Beast[] next = new Beast[bigger]();
                for (int i in 0..alive) {
                    next[i] = beasts[i];
                }
                delete beasts;
                beasts = next;
                room = bigger;
                blocks.roomFor(room);
                return;
            }

            // Put one animal into the world, unattached to any herd, and answer where it went.
            public method bear(Species s, float x, float y) returns BeastId {
                if (alive >= room) {
                    growBeasts();
                }
                int at = alive;
                beasts[at].x = x;
                beasts[at].y = y;
                beasts[at].herd = cast<HerdId>(Wild.NO_HERD);
                beasts[at].stamina = cast<short>(1000);
                beasts[at].age = cast<short>(0);
                // Born at nought. A world being SOWN ages its animals afterwards -- see
                // `Seeding.sow` and `growTo` for why that is not the same thing as a birth.
                beasts[at].species = cast<uint>(cast<int>(s));
                beasts[at].state = cast<uint>(cast<int>(BeastState.Grazing));
                alive = alive + 1;
                census[cast<int>(s)] = census[cast<int>(s)] + 1;
                blocks.put(at, cast<int>(x), cast<int>(y));
                return cast<BeastId>(at);
            }

            // Take one out. THE LAST ANIMAL MOVES INTO ITS SLOT, so whatever herd holds the last
            // animal has to be told its id changed -- done here rather than left to callers, because
            // a caller that forgets produces a roster pointing at a stranger.
            public method bury(BeastId who) returns void {
                int at = cast<int>(who);
                if (at < 0 || at >= alive) {
                    return;
                }
                census[cast<int>(beasts[at].species)] = census[cast<int>(beasts[at].species)] - 1;
                // ITS HERD LETS GO OF IT HERE, rather than at whatever line did the killing. A
                // caller that forgets leaves a roster holding a slot that a moment later holds a
                // different animal, and nothing says so until a herd behaves oddly three arcs on.
                int own = cast<int>(beasts[at].herd);
                if (own >= 0 && own < herdCount) {
                    herds[own].release(who);
                }
                int last = alive - 1;
                // The dead animal leaves the ground it stood on. Done before the swap, while `at`
                // still means the animal that died.
                blocks.take(at);
                if (at != last) {
                    // The mover's herd keeps the same animal under a new id -- and so does its
                    // block, which is the same fact told to the other index.
                    int movedHerd = cast<int>(beasts[last].herd);
                    beasts[at] = beasts[last];
                    blocks.take(last);
                    blocks.put(at, cast<int>(beasts[at].x), cast<int>(beasts[at].y));
                    if (movedHerd >= 0 && movedHerd < herdCount) {
                        herds[movedHerd].release(cast<BeastId>(last));
                        herds[movedHerd].admit(cast<BeastId>(at));
                    }
                }
                alive = alive - 1;
                // AND A HERD THAT HAS LOST ITS LAST ANIMAL IS NOT A HERD. Left standing it would be
                // walked, thought for and counted every tick forever -- and with predators in the
                // world, herds empty. Done last, so nothing above is reading an index this moves.
                if (own >= 0 && own < herdCount && herds[own].count() == 0) {
                    disbandHerd(own);
                }
                return;
            }

            public method xOf(BeastId who) returns float {
                return beasts[cast<int>(who)].x;
            }

            public method yOf(BeastId who) returns float {
                return beasts[cast<int>(who)].y;
            }

            // Whether an animal is already standing in this cell -- asked before the ground under it
            // is looked up, because ground it has not left cannot have changed.
            public method inCell(BeastId who, int cx, int cy) returns boolean {
                return blocks.atCell(cast<int>(who), cx, cy);
            }

            // THE ONLY WAY AN ANIMAL MOVES, so the index cannot be left behind. Cheap when the
            // animal stayed in its cell, which is nearly every call.
            public method placeAt(BeastId who, float x, float y) returns void {
                int at = cast<int>(who);
                beasts[at].x = x;
                beasts[at].y = y;
                blocks.put(at, cast<int>(x), cast<int>(y));
                return;
            }

            public method speciesOf(BeastId who) returns Species {
                return cast<Species>(cast<int>(beasts[cast<int>(who)].species));
            }

            public method stateOf(BeastId who) returns BeastState {
                return cast<BeastState>(cast<int>(beasts[cast<int>(who)].state));
            }

            public method setStateOf(BeastId who, BeastState s) returns void {
                beasts[cast<int>(who)].state = cast<uint>(cast<int>(s));
                return;
            }

            public method staminaOf(BeastId who) returns int {
                return cast<int>(beasts[cast<int>(who)].stamina);
            }

            public method setStaminaOf(BeastId who, int s) returns void {
                mutable int keep = s;
                if (keep < 0) {
                    keep = 0;
                }
                if (keep > 1000) {
                    keep = 1000;
                }
                beasts[cast<int>(who)].stamina = cast<short>(keep);
                return;
            }

            public method ageOf(BeastId who) returns int {
                return cast<int>(beasts[cast<int>(who)].age);
            }

            // START AN ANIMAL PART-WAY THROUGH ITS LIFE. Only the sowing uses this, and it is the
            // difference between a world and a cohort: every animal born at nought dies at exactly
            // `LIFE`, all of them, on the same tick. Measured before it was fixed — the crocodiles
            // went at world-minute 7.7, which is 460 seconds, which is a crocodile's lifespan to the
            // second, and the sheep went at 240 for the same reason. A species that had not bred
            // enough by then was wiped by the calendar rather than by anything in the world.
            public method growTo(BeastId who, int years) returns void {
                beasts[cast<int>(who)].age = cast<short>(years);
                return;
            }

            public method growOlder(BeastId who) returns void {
                beasts[cast<int>(who)].age = cast<short>(cast<int>(beasts[cast<int>(who)].age) + 1);
                return;
            }

            public method herdOf(BeastId who) returns int {
                return cast<int>(beasts[cast<int>(who)].herd);
            }

            // Written ONLY by the roster transformer's sockets, so the two ends of the relation
            // cannot drift apart in some third place.
            public method setHerdOf(BeastId who, HerdId h) returns void {
                beasts[cast<int>(who)].herd = h;
                return;
            }

            // ---- herds --------------------------------------------------------------------------

            private method growHerds() returns void {
                int bigger = herdRoom * 2;
                mutable Herd*[] next = new Herd*[bigger]();
                for (int i in 0..herdCount) {
                    next[i] = herds[i];
                }
                delete herds;
                herds = next;
                herdRoom = bigger;
                return;
            }

            public method gather(Species s, float x, float y, float range) returns Herd* {
                if (herdCount >= herdRoom) {
                    growHerds();
                }
                Herd* h = new Herd(this, s, x, y, range) on heap;
                h.beMine(herdCount);
                herds[herdCount] = h;
                herdCount = herdCount + 1;
                return h;
            }

            public method herdAt(int at) returns Herd* {
                return herds[at];
            }

            // ---- the herds that are going somewhere ------------------------------------------------
            //
            // THE FOUR HUNDRED OUT OF NINE THOUSAND. A herd that is crossing ground, running, or
            // hunting has to have its animals walked every tick; one that is standing about does
            // not. Finding them by asking every herd its mood costs fifteen nanoseconds a herd --
            // nine thousand scattered objects dereferenced for the answer "no" -- which measured as
            // most of a hundred-and-nineteen-microsecond tick.
            //
            // So the list is kept, and it can only stay true because `Herd.setMood` is the one place
            // a mood changes. Same shape as the block index one level up: do not walk everything to
            // find the few.
            private mutable int[] movers;
            private mutable int moving;

            public method travellers() returns int {
                return moving;
            }

            public method travellerAt(int i) returns Herd* {
                return herds[movers[i]];
            }

            public method nowTravelling(Herd* h) returns void {
                if (h.spot() >= 0) {
                    return;
                }
                if (moving >= movers.length()) {
                    mutable int[] next = new int[movers.length() * 2]();
                    for (int i in 0..moving) {
                        next[i] = movers[i];
                    }
                    delete movers;
                    movers = next;
                }
                movers[moving] = cast<int>(h.id());
                h.setSpot(moving);
                moving = moving + 1;
                return;
            }

            public method nowStill(Herd* h) returns void {
                int s = h.spot();
                if (s < 0) {
                    return;
                }
                int last = moving - 1;
                if (s != last) {
                    movers[s] = movers[last];
                    herds[movers[s]].setSpot(s);
                }
                moving = moving - 1;
                h.setSpot(0 - 1);
                return;
            }

            // A HERD WITH NOBODY IN IT GOES, and the last herd moves into its slot -- the same
            // swap-remove the animals get, with the same obligation: every animal of the herd that
            // MOVED is pointing at the index it used to be at, and has to be told. Forgetting that
            // is a roster full of animals that believe they belong to somebody else.
            private method disbandHerd(int at) returns void {
                // Out of the movers list first, while it still knows where it is in it.
                nowStill(herds[at]);
                delete herds[at];
                int last = herdCount - 1;
                if (at != last) {
                    herds[at] = herds[last];
                    herds[at].beMine(at);
                    // The list of movers holds HERD INDICES, and this herd's just changed.
                    if (herds[at].spot() >= 0) {
                        movers[herds[at].spot()] = at;
                    }
                    mutable int link = herds[at].firstMember();
                    while (link >= 0) {
                        beasts[cast<int>(herds[at].memberAt(link))].herd = cast<HerdId>(at);
                        link = herds[at].afterMember(link);
                    }
                }
                herdCount = herdCount - 1;
                return;
            }

            // ---- dying -----------------------------------------------------------------------------
            //
            // TWO WAYS TO DIE AND ONE PLACE THAT RECORDS THEM. The burial itself is `bury`, which is
            // about slots and rosters; these are about what it MEANT, which is what the world says
            // out loud and what extinction is read from.
            private mutable int[] causes;     // per species: the Vanished ordinal of its last death
            private mutable boolean[] gone;   // per species: already announced, so it is said once
            private mutable long killed;
            private mutable long famished;
            private mutable long aged;
            private mutable long born;
            private mutable long chasesLost;
            private mutable int lost;         // species gone from the world

            public method eaten(BeastId who, long at, Chronicle* log) returns void {
                killed = killed + 1;
                takeAway(who, Vanished.EatenOut, at, log);
                return;
            }

            public method starved(BeastId who, long at, Chronicle* log) returns void {
                famished = famished + 1;
                takeAway(who, Vanished.Starved, at, log);
                return;
            }

            // OF AGE, which is the death that needs nothing to have gone wrong. A species that ends
            // this way ended because nothing was born, not because anything took it -- which is why
            // it has a cause of its own and does not borrow one of the others.
            public method diedOfAge(BeastId who, long at, Chronicle* log) returns void {
                aged = aged + 1;
                takeAway(who, Vanished.DiedOut, at, log);
                return;
            }

            public method births() returns long {
                return born;
            }

            public method deathsOfAge() returns long {
                return aged;
            }

            public method noteBirth() returns void {
                born = born + 1;
                return;
            }

            public method noteChaseLost() returns void {
                chasesLost = chasesLost + 1;
                return;
            }

            public method kills() returns long {
                return killed;
            }

            public method starvations() returns long {
                return famished;
            }

            public method chasesGivenUp() returns long {
                return chasesLost;
            }

            public method speciesLost() returns int {
                return lost;
            }

            // WHAT LIVES IN THE WORLD AT THE END, species by species. A total says a world has
            // seventeen thousand animals in it; it cannot say that one of them is down to nine and
            // going. An arc that ends with a species at single figures and an arc that ends with
            // every species healthy are different worlds with the same number, and the difference is
            // the whole of what this slice is for.
            //
            // Said as a list rather than kept as one: it is asked once, at the end of a run.
            public method census(Chronicle* log, long at) returns void {
                mutable int k = 1;
                while (k < Species.count()) {
                    int n = census[k];
                    if (n > 0) {
                        log.note(at, "fauna", $"  {Beasts.name(k)}: {n}");
                    } else if (gone[k]) {
                        log.note(at, "fauna",
                                 $"  {Beasts.name(k)}: gone -- {Vanished.values()[causes[k]].said()}");
                    }
                    k = k + 1;
                }
                return;
            }

            // The death, and then the question that only a death can raise.
            private method takeAway(BeastId who, Vanished how, long at, Chronicle* log)
                    returns void {
                int sp = cast<int>(beasts[cast<int>(who)].species);
                causes[sp] = cast<int>(how);
                bury(who);
                // WHEN THE LAST ONE IS GONE IT IS GONE FOR GOOD -- no respawn, no hidden reserve, no
                // quiet re-seed. This is the one line in the fauna that is permanent, and it is said
                // where it happens rather than counted up at the end: a species ending is exactly
                // the kind of thing a chronicle is for.
                if (census[sp] == 0 && !gone[sp]) {
                    gone[sp] = true;
                    lost = lost + 1;
                    log.note(at, "fauna",
                             $"{Beasts.name(sp)} is gone from the world -- {Vanished.values()[causes[sp]].said()}");
                }
                return;
            }

            // ---- what the fauna has been doing ---------------------------------------------------
            //
            // HOW FAR THE HERDS HAVE WALKED, in cells, added up over every herd and every tick. Kept
            // because it is the one number that cannot be produced by a world where the tick is not
            // wired up at all: a world can have animals, draw them, and count them, and still be
            // frozen -- which is a state this project has shipped before and not noticed, because
            // everything else about it looked right.
            //
            // It sits BESIDE the record and never in place of it: it says the world moved, and the
            // chronicle says what happened.
            private mutable float walked;

            public method noteTravel(float far) returns void {
                walked = walked + far;
                return;
            }

            public method travelled() returns float {
                return walked;
            }

            // How many herds are in a given mood right now. Walked when asked, which is at the end
            // of a run and nowhere else -- a count kept up to date would be a third place that can
            // disagree with the moods themselves.
            public method inMood(HerdMood m) returns int {
                mutable int n = 0;
                for (int i in 0..herdCount) {
                    if (cast<int>(herds[i].mood()) == cast<int>(m)) {
                        n = n + 1;
                    }
                }
                return n;
            }

            // HOW OFTEN ANYTHING RAN, ever. Counted where the fright is taken rather than sampled at
            // the end: a snapshot of who is running right now says nothing about a world where
            // something bolts every few seconds, and those are the worlds this number exists to tell
            // apart.
            private mutable long bolted;

            public method noteFright() returns void {
                bolted = bolted + 1;
                return;
            }

            public method frights() returns long {
                return bolted;
            }
        }
    }
}
