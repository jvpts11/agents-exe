program AgentsExe;

// THE BUDGET, HELD BY THE BUILD RATHER THAN REMEMBERED BY A COMMENT.
//
// A `layout` is an interface for MEMORY. An interface says what a type does; a layout says how a
// type arranges itself. Being a separate question it crosses struct/record/union instead of
// competing with them, and it is consumed entirely by the compiler -- a layout leaves nothing at all
// in the executable.
//
// Twenty bytes, so three animals fit in a sixty-four byte cache line. That is the whole reason the
// number is what it is: the fauna tick walks the array in order, and what it costs is decided by how
// many animals arrive per line fetched.
//
// IMPLEMENTING IT HANDS THE FIELD ORDER TO THE COMPILER, and that is the point of it rather than a
// side effect. A check that only refuses is a guard against a problem that could have been solved;
// here it can be solved, because the compiler knows every size and alignment and LDP3 exposes no
// offsets. The budget is a promise the build keeps, not a convention the next person has to know.
public bundle Agents {
    public namespace Sim {

        public layout ThreeToALine {
            onArrange {
                itself.fitWithin(20 bytes);
                itself.refuse("a beast must stay three to a cache line: the tick walks the array in order, and what it costs is how many animals arrive per line fetched");
            }
        }
    }
}
