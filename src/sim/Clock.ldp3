program AgentsExe;

// HOW THIS WORLD TELLS TIME, in one place, because it was in none.
//
// THE YEAR IS THE ONLY UNIT. There are no days and no hours here, and that is the model rather than
// a simplification: nothing in this world has to know how long a morning is, so nothing has to
// agree about it. An age is in years, a lifetime is in years, and how long a body can go without
// eating is in years. A player speeds the whole world up and the year is what goes faster.
//
// WHY IT MATTERS THAT THERE ARE NO HOURS. The model's own text says an agent sleeps "eight hours at
// home, sixteen in the open" and starves in "about two minutes" -- one of those is a world duration,
// the other is a REAL one, and neither can be written down without a day. Every one of them becomes
// a fraction of a year here, and the two scales stop being able to disagree.
//
// TWENTY SECONDS TO THE YEAR, AND THE NUMBER WAS FOUND RATHER THAN CHOSEN. `Beasts` has held a
// lifetime for every species since S1.1, written in seconds: deer 300, wolf 280, bear 360, bison
// 380, crocodile 460, mammoth 600. Divided by twenty, those are 15, 14, 18, 19, 23 and 30 -- which
// is what those animals live. The clock was decided when that table was written and never said out
// loud, so anything else here would have put the people on a different one from the animals.
//
// WHAT IT COMES TO: a person lives eighty to a hundred and twenty years, which is twenty-seven to
// forty minutes at gear one, and seconds at the top gear. A generation turns over while somebody is
// watching, which is the whole point of the model this follows.
public bundle Agents {
    public namespace Sim {

        public class Clock {
            // Sixty ticks to the second at gear one -- the renderer's frame is the world's tick, and
            // the fauna has counted in these since it was written.
            public static fixed int TICKS_A_SECOND = 60;
            // And twenty seconds to the year. See above for where the twenty comes from.
            public static fixed int SECONDS_A_YEAR = 20;
            public static fixed int TICKS_A_YEAR = 1200;

            // How many whole years a span of ticks is.
            public static method yearsIn(long ticks) returns int {
                return cast<int>(ticks / cast<long>(Clock.TICKS_A_YEAR));
            }

            // And the other way, for anything written as an age.
            public static method ticksFor(int years) returns long {
                return cast<long>(years) * cast<long>(Clock.TICKS_A_YEAR);
            }

            // Whether this tick begins a new year. What ages, and what gets hungrier, asks this --
            // so a world where a year is longer or shorter has nothing else to change.
            public static method turnsYear(long at) returns boolean {
                return at % cast<long>(Clock.TICKS_A_YEAR) == cast<long>(0);
            }
        }
    }
}
