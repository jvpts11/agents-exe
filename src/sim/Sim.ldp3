import System.IO.Console;
import Agents.World.Grid;
import Agents.World.Biome;
import Agents.World.Biomes;
import Agents.World.LandMath;
import Agents.World.NodeField;
import Agents.World.Nodes;
import Agents.World.Harvest;
import Agents.World.Good;
import Agents.World.Goods;
import Agents.World.BuildingKind;
import Agents.World.Craft;
import Agents.World.Builds;
import Agents.World.Species;
import Agents.World.Beasts;
import Agents.World.Ways;
import Agents.World.Surface;
import System.Math.Math;
import Agents.People.AgentTable;
import Agents.People.Act;
import Agents.People.Job;

// The clock. Named Simulation and not World or Sim: `World` is a NAMESPACE here and `Sim`
// is this one, and a type sharing either name corrupts symbol resolution -- which the compiler
// then reports against some unrelated file.
//
// Everything that changes over time is advanced from here, and it is split in two on
// purpose, because the two halves scale completely differently.
//
// THINKING is budgeted. A fixed number of agents decide per frame and no more, exactly as the
// terrain bake slices by cells rather than by rows -- the fix that killed the render stutter. An
// agent carries the tick it is next due, the queue is walked in order, and a bigger population means
// each person decides LESS OFTEN, never that more deciding happens in one frame. Constant cost per
// frame; more frames when there is more to do.
//
// MOVING is not budgeted, because it is a multiply-add: fifty thousand of them is nothing, and
// slicing it would only make positions stale for no gain. What the levels of detail actually save is
// the EXPENSIVE part of moving -- testing the ground and turning to face -- which only matters where
// somebody can see it. The rule from the design holds: you may fake what does not change an
// outcome, and travel TIME is an outcome while the trajectory is not, so everyone advances at the
// same speed and only those on screen walk around things.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        public class Simulation {
            private mutable Grid* g;
            private mutable AgentTable* folk;
            private mutable int seed;
            private mutable float clock;        // seconds since the world began
            private mutable int tick;           // whole seconds
            private mutable int cursor;         // where the think queue resumes
            private mutable int budget;         // agents allowed to decide in one frame
            // the near window, handed over by the renderer so a person on screen walks properly
            private mutable int nearX0;
            private mutable int nearY0;
            private mutable int nearX1;
            private mutable int nearY1;
            // instruments
            private mutable int thoughtThisFrame;
            private mutable int worstThink;
            private mutable int stuckTotal;
            private mutable int arrivals;
            private mutable long thoughtTotal;
            // Per community: how many live there, and how many are grown men and women. Rebuilt on
            // a slow clock -- one sweep of the table a second is nothing -- so every question about
            // whether a place can father or support anybody is a lookup.
            private mutable int[] cpop;
            private mutable int[] cadults;
            private mutable int[] cmales;
            private mutable float[] ccx;       // where the community actually is, as its mean
            private mutable float[] ccy;
            // Everything every community owns. It was a single `int cwood`, which was honest for one
            // trade and stopped being honest the moment there were six.
            private mutable Stores* stores;
            // Where this community knows there is work of each kind, or -1: one site per Harvest
            // class per community. A community is swept once a second anyway, so it can afford the
            // wide search that an individual cannot -- asking it costs one search per PLACE per
            // second instead of one per PERSON per decision.
            private mutable int[] cworkX;
            private mutable int[] cworkY;
            // AND WHICH GOOD IT WENT THERE FOR.
            //
            // A Harvest class is a way of working, not a thing: a quarrier fetches stone, marble,
            // clay, sand or salt, and a miner ten different metals. Both halves of the decision --
            // how badly the place wants a quarrier, and which face he walks to -- used to be settled
            // by ONE good standing in for the whole class, so a village needing clay measured its
            // hunger for stone and then walked to a stone quarry. This is the good the site was
            // actually chosen for, so the wanting and the walking agree.
            private mutable int[] cworkG;
            // What every place's workshops are hungry for, per good, read once a census off the
            // building table. The other half of "worth is want" -- the half a store cannot answer,
            // because a shelf knows what is on it and not what anybody is waiting for.
            private mutable int[] cwant;
            // And what its food buildings between them put on the table in a shift. Apart from
            // `cwant` because hunger is ONE want however many different things answer it.
            private mutable int[] cfed;
            // And what its places of learning are already working out, so that want is bounded
            // the way every other one is.
            private mutable int[] clesson;
            // Ground worth opening: a block of bare rock inside this community's reach that nobody
            // has looked under. Found once per PLACE per second like every other work site, never
            // once per prospector -- the same rule the woodcutter and the wolves both had to learn.
            private mutable int[] cdigX;
            private mutable int[] cdigY;
            private mutable long dug;          // discs prospected
            private mutable long struck;       // working faces opened by it
            private mutable long tooled;       // tools taken up
            private mutable long wornOut;      // and worn through
            private mutable long armed;        // weapons taken up
            private mutable long mailed;
            // How many of its grown people are already in each trade, so a place cannot become a
            // thousand woodcutters and no fishermen. Indexed by JOB and not by Harvest class,
            // because building and crafting are trades too and neither goes out to a resource.
            private mutable int[] ctrade;
            // Everything standing or going up anywhere in the world.
            private mutable Buildings* town;
            // And what the last census read out of it, per community: how much roof there is, which
            // roof is the meanest, whether anything is half-built, whether a workshop has gone dead,
            // and which bench of each craft is free. Same reason as `cworkX` above -- these are
            // questions about a PLACE, and asking the table once per place per second costs one pass
            // where asking it per person per decision cost five.
            private mutable int[] croom;
            private mutable int[] cworst;
            private mutable int[] cworstRoom;
            private mutable int[] cdead;
            private mutable int[] cbusy;
            private mutable int[] copen;
            // The same, by what the bench MAKES rather than by which trade it belongs to. A village
            // does not need a second pasture while the first has nobody in it; what it needs from
            // the smith is a different question from what it needs from the toolmaker.
            private mutable int[] cmade;
            private mutable int[] cowns;   // benches making each good here, staffed or not
            private mutable int[] cseat;
            // Splitting and leaving. `cfar` is the person a community's far end has gathered around,
            // `cparty` how many would go with them, `cchild` the number the daughter got; `cflee` is
            // where a starving person goes, decided once for the whole place and not once per empty
            // stomach.
            private mutable int[] cfar;
            private mutable float[] cfarD;
            private mutable int[] cparty;
            private mutable int[] cfarAge;     // censuses that cluster has held together
            private mutable int[] cchild;
            private mutable int[] cjoin;       // and which bigger place this one has grown into
            private mutable int[] cflee;
            private mutable int[] cleave;      // how many more may go before the next census
            private mutable int[] cfood;       // food a head, so the pair loop is arithmetic
            // The quarrel. `cfoe` is who this place raids, `craided` how many more censuses it
            // remembers being hit -- a feud is a memory with a length, and when it runs out the war
            // ends without anybody deciding to end it.
            private mutable int[] cfoe;
            private mutable int[] craided;
            private mutable int[] craider;     // and who it was, so the answer has an address
            private mutable long feuds;        // censuses spent with somebody to fight
            private mutable long raids;        // warriors who reached an enemy village
            private mutable long plunder;      // goods carried home off somebody else's shelves
            private mutable long deathsWar;
            // Killed by the ground, the weather or the fire -- deaths nobody chose, which is a
            // different fact about a world from deaths somebody did.
            private mutable long deathsWorld;
            private mutable long hived;        // villages founded by a place outgrowing its ground
            private mutable long hivedFolk;    // and how many walked out in those parties
            private mutable long fled;         // people who left a place that could not feed them
            private mutable long joined;       // villages that grew into a bigger neighbour
            private mutable long joinedFolk;
            // And everything alive that is not a person.
            private mutable Wildlife* wild;
            private mutable long hunted;
            private mutable Meter* meter;
            // Who each community listens to, or -1, and what that person leans toward. A ROLE, not a
            // person: it outlives whoever fills it, because nobody lives longer than six minutes and
            // a leadership that died with its leader would never be seen at all.
            private mutable int[] chief;
            private mutable int[] lean;        // the Job the chief's temperament pushes toward
            private mutable long risen;        // roles that came into being
            private mutable long passed;       // and were handed on when the holder died
            private mutable long followed;     // decisions swayed by a chief
            private mutable long resisted;
            // What a community IS, as five weights, and it is not a table of anybody's opinions --
            // it is an aggregate of what its people actually DID. A village that hunts becomes a
            // hunting village, because its children are born a little bolder than their mothers
            // were, choose to hunt a little more often, and hand that on again.
            //
            // Two arrays: the deeds done since the last census, and the slow weight they move. The
            // window is what makes it CULTURE rather than history -- a place that stopped mining
            // fifty generations ago should not still be a mining people.
            private mutable int[] culture;
            private mutable int[] deeds;
            // Who each settlement answers to, and everything that is true of a POLITY rather than
            // of a place: its capital, its ruler, its rank, its borders, and what it knows.
            //
            // Knowledge lives up here and not on the settlement, and that is the fix for a defect
            // that made the whole era ladder decoration. Surplus bought slack, slack bought
            // discovery -- but the surplus was divided by HEAD, so a city of eight hundred learned
            // at exactly the rate of a hamlet of forty and nothing anybody ever built made the world
            // cleverer. Measured over twenty generations the world ended tribal 23, medieval 18,
            // industrial 4, modern 0: the fourth era was unreachable by construction. A nation pools
            // what all of its towns can spare, so growing is finally worth something.
            // The ground people move over, and how it changes because they moved over it. Not a
            // map anybody draws: a road here is a record of where the traffic already was.
            private mutable Ways* paths;
            // War above the raid. An army is a thing a NATION owns: it musters, it marches, it
            // sits down in front of a wall, and it is the only way ground changes hands.
            private mutable Armies* host;
            // What the ground does to the people standing on it. See Fates.ldp3.
            private mutable Fates* fates;
            private mutable int[] cwall;       // how much wall each town has standing
            private mutable int[] carmy;       // the army besieging it, or -1
            private mutable int[] cbarr;       // barracks working in it
            private mutable int[] cport;       // how far over water this town can reach, or 0
            private mutable int[] cportb;      // the harbour building itself, or -1: the quay a
                                               // carter walks to, read once a census like the rest
            private mutable int[] cdrink;      // heads this place can keep in water
            private mutable boolean[] cfresh;  // is there a river or a lake at hand at all
            // Waterworks STANDING, which is a different question from heads watered and is asked by
            // the fire: a well is a hole people draw from, and a bucket chain is what it becomes the
            // night the thatch goes up. The same building answering a second question it was never
            // built for is the whole reason the water layer earns its place twice.
            private mutable int[] cwells;
            private mutable int[] ccare;       // heads it can nurse
            private mutable int[] cfilth;      // and how hard it is to stay well here, per thousand
            // The two authorities a place has besides the one in charge. An elder is whoever has
            // lived longest and is believed about what this place is; a priest is whoever spends
            // their days at the shrine. Neither is elected and neither can be appointed -- both are
            // read off the world every census, exactly like the chief and the capital.
            private mutable int[] celder;
            private mutable int[] cpriest;
            private mutable long eldersSeated;
            private mutable long priestsSeated;
            private mutable long tradeChiefs;
            // And the third: whoever organises the carrying. Only ever seated in a capital, because
            // a route between two towns is a thing only somebody who answers for both can arrange.
            private mutable int[] ctchief;
            // Where each town is sending a load, and what is in it. Decided ONCE a census per
            // place -- "who needs what I have spare" is the expensive question in this file and it
            // is asked per town per second, never per carter per decision.
            private mutable int[] ccaravan;
            private mutable int[] ccargo;
            private mutable long caravans;
            private mutable long trafficked;
            private mutable long shipped;      // of that, what crossed water rather than country
            // The one thing in this world nobody decides for themselves. A railway is not worn by
            // feet and it is not laid by whoever happens to be standing there with spare stone: it
            // is a LINE between two towns, and only something that answers for both ends can want
            // one. Per nation: where the line is going, and how far along it has got.
            private mutable int[] nrailTo;
            private mutable int[] nrailAt;
            private mutable long railed;
            // Which army each nation has in the field, or -1. A lookup, not a search.
            //
            // `armyOf` walks sixty-four slots, and it was being called from `quotaFor` -- which runs
            // for several trades for every person who thinks, eleven and a half million times in a
            // two-generation arc. Nearly a billion iterations to answer a question with one answer
            // per nation per census. Filled in `readWalls`, beside the other things read off the
            // world once and then only looked up.
            private mutable int[] nhost;
            // A conquered town keeps the language its people speak, which is the whole reason
            // conquest is worth doing carefully. Held per SETTLEMENT and not per nation, because
            // after a conquest the two disagree -- and that disagreement is the thing a ruler has
            // to spend something to fix.
            private mutable int[] ctongue;
            private mutable int[] cheld;       // censuses since it was taken, or 0
            private mutable long conquests;
            private mutable long revolts;
            private mutable long converted;
            private mutable boolean stocked;   // the peoples of the world have been founded
            private mutable Nations* realm;
            private mutable int[] cnat;        // settlement -> nation
            // A colony that has been decided on but not yet walked to. Until its people are
            // standing on the ground it was sent to, the SITE is where the place is -- otherwise
            // the centre is the mean of everybody who set out, which is still back at the capital,
            // so they would search for work at home and never leave.
            private mutable float[] csiteX;
            private mutable float[] csiteY;
            private mutable int[] csettle;     // censuses left to get there
            private mutable int[] cmother;     // who sent them, so a failed expedition can go home
            private mutable int settler;       // whose turn it is to think about it
            private mutable int warlord;       // and whose turn it is to think about a war
            private mutable long colonies;
            private mutable long colonists;
            private mutable long planted;      // expeditions that reached their ground
            private mutable long strayed;      // and that did not
            private mutable long invented;     // eras reached by a nation's own work
            private mutable long learned;      // and by looking over the fence at a neighbour
            private mutable long borrowed;     // of which, from a neighbour of the same stock
            private mutable long annexed;      // towns that changed hands
            private mutable long extinct;      // nations that lost their last town
            // Who claims each 16-cell block, or -1. A community's land is the ground its people
            // stand on, spread outward by how far they go to work -- so the shape of a country is
            // read off fifty thousand positions rather than drawn as a disk of a size somebody
            // chose. `claimHold` is the running majority vote that settles a contested block and
            // `claimEdge` is the previous ring, so the spread cannot race across the map in one pass.
            private mutable int[] claim;
            private mutable int[] claimHold;
            private mutable int[] claimEdge;
            private mutable int claimW;
            private mutable int claimH;
            private mutable int claimAge;      // bumped on every rebuild, so the renderer can notice
            private mutable long crafted;      // batches finished
            private mutable long stalled;      // batches that could not start for want of an input
            private mutable long housed;       // housing plots marked out
            private mutable long watered;      // waterworks marked out
            private mutable long tended;       // and places raised against sickness
            private mutable long dealt;        // loads that crossed a border and warmed one
            private mutable int leanest;       // the worst the land ever got, in the hundred
            private mutable long rebuilt;      // plots torn up and raised again bigger
            private mutable long pulled;       // workshops nobody needed any more, pulled down
            private mutable long raised;       // buildings finished
            private mutable int ncomm;
            private mutable float censusDue;
            private mutable long births;
            private mutable long deathsOld;
            private mutable long deathsHunger;
            private mutable long deathsIll;    // and the ones the place itself killed
            private mutable long fellIll;
            // The number this slice exists to produce: seconds spent walking against seconds spent
            // working. On a map thirty-two times the original's it is the one that says whether a
            // person can make a living within a walk of home, or whether the whole economy has to
            // become regional.
            // Only journeys WITH A PURPOSE count here. Wandering is counted apart, because folding it
            // in flatters nothing and lies about everything: an idle child ambling in circles would
            // read as a woodcutter with a long commute, and the ratio would say the world is too big
            // when what it really said is that most people had nothing to do.
            private mutable long walkTicks;
            private mutable long wanderTicks;
            private mutable long workTicks;
            private mutable long felled;       // nodes worked out entirely
            private mutable long carried;      // units that reached a store
            private mutable long noWork;       // decisions that found nothing to do
            private mutable long meals;        // units eaten
            private mutable long hungryTicks;  // seconds lived by somebody with nothing to eat
            private mutable int frames;

            public static float SPEED = 1.25;       // cells a second

            // ---- the clock ----
            //
            // The step is FIXED and the RATE is what moves. Everything in this file is written
            // against dt -- hunger accrues per second, a walk covers SPEED cells a second, a batch
            // takes so many seconds -- and all of it stays true only while the step stays small.
            // Running the world faster by handing `step` a bigger dt would let a walker cross a
            // river in one frame and a woodcutter finish a tree he never reached; running it faster
            // by taking MORE steps changes nothing at all except how long the wall clock waits.
            //
            // So `advance` takes real seconds, multiplies by the rate, and spends the result in
            // whole ticks -- carrying the remainder, so no time is lost to rounding at any rate.
            public static float TICK = 0.05;
            public static int CATCHUP = 240;        // ticks one call may spend before it gives up

            private mutable float rate;
            private mutable float owed;
            private mutable boolean halted;

            public method setRate(float r) returns void {
                if (r < 0.0) {
                    return;
                }
                this.rate = r;
                this.owed = 0.0;
                return;
            }

            public method rateOf() returns float {
                return this.rate;
            }

            public method setHalted(boolean h) returns void {
                this.halted = h;
                this.owed = 0.0;
                return;
            }

            public method isHalted() returns boolean {
                return this.halted;
            }

            // Advance by `real` seconds of wall clock. Returns the ticks actually spent, which is
            // what a caller wants for a frame counter and also what tells it the machine could not
            // keep up: at a high rate the answer stops rising, and the world simply runs at whatever
            // the hardware can do instead of falling further behind on every frame.
            public method advance(float real) returns int {
                if (this.halted || this.rate <= 0.0) {
                    return 0;
                }
                this.owed = this.owed + real * this.rate;
                mutable int n = 0;
                while (this.owed >= Simulation.TICK && n < Simulation.CATCHUP) {
                    this.step(Simulation.TICK);
                    this.owed = this.owed - Simulation.TICK;
                    n = n + 1;
                }
                if (n >= Simulation.CATCHUP) {
                    // Whatever is still owed is time the machine never had. Dropping it is the only
                    // way out: carrying it forward means every frame owes more than the last, which
                    // is how a simulation stops responding altogether.
                    this.owed = 0.0;
                }
                return n;
            }

            public constructor Simulation(Grid* grid, AgentTable* people, int worldSeed) {
                this.g = grid;
                this.folk = people;
                this.seed = worldSeed;
                this.clock = 0.0;
                this.tick = 0;
                this.cursor = 0;
                this.budget = 2000;
                this.nearX0 = 0;
                this.nearY0 = 0;
                this.nearX1 = 0;
                this.nearY1 = 0;
                this.thoughtThisFrame = 0;
                this.worstThink = 0;
                this.stuckTotal = 0;
                this.arrivals = 0;
                this.thoughtTotal = 0;
                // Room for the world to fill up. Two hundred and fifty-six was the number of places
                // SEEDED, which was also the number available while nothing new could ever be
                // founded; the first run with splitting used every one of them inside two minutes
                // and then the world could only get bigger, never wider. Fifty thousand people at a
                // hundred and twenty to a village is four hundred places if they all held together,
                // and they do not.
                this.ncomm = 512;
                this.cpop = new int[this.ncomm]();
                this.cadults = new int[this.ncomm]();
                this.cmales = new int[this.ncomm]();
                this.ccx = new float[this.ncomm]();
                this.ccy = new float[this.ncomm]();
                this.stores = new Stores(this.ncomm) on heap;
                int nh = Harvest.count();
                this.cworkX = new int[this.ncomm * nh]();
                this.cworkY = new int[this.ncomm * nh]();
                this.cworkG = new int[this.ncomm * nh]();
                this.cwant = new int[this.ncomm * Goods.count()]();
                this.cfed = new int[this.ncomm]();
                this.clesson = new int[this.ncomm]();
                this.cdigX = new int[this.ncomm]();
                this.cdigY = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.cdigX[c] = 0 - 1;
                }
                this.dug = 0;
                this.struck = 0;
                this.tooled = 0;
                this.wornOut = 0;
                this.armed = 0;
                this.mailed = 0;
                this.ctrade = new int[this.ncomm * Job.count()]();
                // Sixteen rows a community was enough while a village only ever built workshops.
                // Housing changed the arithmetic: at six to a hut, a place of six hundred needs a
                // hundred plots on its own, and the first run with shelter filled all four thousand
                // rows in the world -- after which nothing could be built anywhere, which read in
                // the report as a hundred workshops for eighty-one thriving places. A row is thirty
                // bytes; a hundred and twenty-eight of them per community is four megabytes and no
                // longer the thing that decides what a village can become.
                this.town = new Buildings(this.ncomm * 128) on heap;
                this.croom = new int[this.ncomm]();
                this.cworst = new int[this.ncomm]();
                this.cworstRoom = new int[this.ncomm]();
                this.cdead = new int[this.ncomm]();
                this.cbusy = new int[this.ncomm]();
                this.copen = new int[this.ncomm * Craft.count()]();
                this.cmade = new int[this.ncomm * Goods.count()]();
                this.cowns = new int[this.ncomm * Goods.count()]();
                this.cseat = new int[this.ncomm]();
                this.cfar = new int[this.ncomm]();
                this.cfarD = new float[this.ncomm]();
                this.cparty = new int[this.ncomm]();
                this.cfarAge = new int[this.ncomm]();
                this.cchild = new int[this.ncomm]();
                this.cjoin = new int[this.ncomm]();
                this.cflee = new int[this.ncomm]();
                this.cleave = new int[this.ncomm]();
                this.cfood = new int[this.ncomm]();
                this.cfoe = new int[this.ncomm]();
                this.craided = new int[this.ncomm]();
                this.craider = new int[this.ncomm]();
                this.feuds = 0;
                this.raids = 0;
                this.plunder = 0;
                this.deathsWar = 0;
                this.deathsWorld = 0;
                for (int c in 0..this.ncomm) {
                    this.cfoe[c] = 0 - 1;
                    this.craider[c] = 0 - 1;
                }
                for (int c in 0..this.ncomm) {
                    this.cworst[c] = 0 - 1;
                    this.cdead[c] = 0 - 1;
                    this.cbusy[c] = 0 - 1;
                    this.cseat[c] = 0 - 1;
                    this.cfar[c] = 0 - 1;
                    this.cchild[c] = 0 - 1;
                    this.cflee[c] = 0 - 1;
                }
                this.hived = 0;
                this.hivedFolk = 0;
                this.fled = 0;
                this.joined = 0;
                this.joinedFolk = 0;
                for (int s in 0..this.ncomm * Craft.count()) {
                    this.copen[s] = 0 - 1;
                }
                this.claimW = (grid.width() + 15) / 16;
                this.claimH = (grid.height() + 15) / 16;
                this.claim = new int[this.claimW * this.claimH]();
                this.claimHold = new int[this.claimW * this.claimH]();
                this.claimEdge = new int[this.claimW * this.claimH]();
                for (int b in 0..this.claimW * this.claimH) {
                    this.claim[b] = 0 - 1;
                }
                this.claimAge = 0;
                this.rate = 1.0;
                this.owed = 0.0;
                this.halted = false;
                this.wild = new Wildlife(grid, 60000, worldSeed) on heap;
                this.wild.seed(6);
                this.hunted = 0;
                this.meter = new Meter() on heap;
                this.chief = new int[this.ncomm]();
                this.lean = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.chief[c] = 0 - 1;
                    this.lean[c] = cast<int>(Job.Idle);
                }
                this.risen = 0;
                this.passed = 0;
                this.followed = 0;
                this.resisted = 0;
                this.culture = new int[this.ncomm * 5]();
                this.deeds = new int[this.ncomm * 5]();
                for (int s in 0..this.ncomm * 5) {
                    this.culture[s] = 50 * Simulation.CFIX;   // every place starts with no character
                }
                // Every settlement begins as its own nation, of the lowest rank there is: a band of
                // people who live together and answer to nobody. That is not a hundred countries at
                // world generation -- it is the honest starting state, and the world gets its
                // countries the only way it can, by some of those bands growing seats that others
                // come to answer to. The count of living nations FALLS over an arc while each of
                // them gets bigger, which is the shape history actually has.
                this.paths = new Ways(grid.width(), grid.height()) on heap;
                this.host = new Armies(64) on heap;
                this.cwall = new int[this.ncomm]();
                this.carmy = new int[this.ncomm]();
                this.cbarr = new int[this.ncomm]();
                this.cport = new int[this.ncomm]();
                this.cportb = new int[this.ncomm]();
                this.cdrink = new int[this.ncomm]();
                this.cfresh = new boolean[this.ncomm]();
                this.cwells = new int[this.ncomm]();
                this.ccare = new int[this.ncomm]();
                // Built here rather than beside the other counters above: a fresh table is already
                // empty, and reaching for `clear()` before this line ran was a null dereference that
                // took an arc down with an access violation and no message at all.
                this.fates = new Fates(this.ncomm) on heap;
                this.cfilth = new int[this.ncomm]();
                this.celder = new int[this.ncomm]();
                this.cpriest = new int[this.ncomm]();
                this.ctchief = new int[this.ncomm]();
                this.ccaravan = new int[this.ncomm]();
                this.ccargo = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.celder[c] = 0 - 1;
                    this.cpriest[c] = 0 - 1;
                    this.ctchief[c] = 0 - 1;
                    this.ccaravan[c] = 0 - 1;
                }
                this.eldersSeated = 0;
                this.priestsSeated = 0;
                this.tradeChiefs = 0;
                this.caravans = 0;
                this.trafficked = 0;
                this.shipped = 0;
                this.nrailTo = new int[this.ncomm]();
                this.nrailAt = new int[this.ncomm]();
                this.nhost = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.nrailTo[c] = 0 - 1;
                    this.nhost[c] = 0 - 1;
                }
                this.railed = 0;
                this.ctongue = new int[this.ncomm]();
                this.cheld = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.carmy[c] = 0 - 1;
                    this.ctongue[c] = c;         // every band begins speaking its own
                }
                this.conquests = 0;
                this.revolts = 0;
                this.converted = 0;
                this.stocked = false;
                this.realm = new Nations(this.ncomm) on heap;
                this.cnat = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.cnat[c] = c;
                    this.realm.raise(c, c, 0 - 1, 0, 1);      // its own tongue, the tribal age
                }
                this.csiteX = new float[this.ncomm]();
                this.csiteY = new float[this.ncomm]();
                this.csettle = new int[this.ncomm]();
                this.cmother = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.cmother[c] = 0 - 1;
                }
                this.settler = 0;
                this.warlord = 0;
                this.colonies = 0;
                this.colonists = 0;
                this.planted = 0;
                this.strayed = 0;
                this.invented = 0;
                this.learned = 0;
                this.borrowed = 0;
                this.annexed = 0;
                this.extinct = 0;
                this.crafted = 0;
                this.stalled = 0;
                this.housed = 0;
                this.watered = 0;
                this.tended = 0;
                this.dealt = 0;
                this.leanest = 1000;
                this.rebuilt = 0;
                this.pulled = 0;
                this.raised = 0;
                for (int s in 0..this.ncomm * nh) {
                    this.cworkX[s] = 0 - 1;                 // nowhere known yet, and (0,0) is not it
                    this.cworkG[s] = cast<int>(Good.Nothing);
                }
                this.censusDue = 0.0;
                this.births = 0;
                this.deathsOld = 0;
                this.deathsHunger = 0;
                this.deathsIll = 0;
                this.fellIll = 0;
                this.walkTicks = 0;
                this.wanderTicks = 0;
                this.workTicks = 0;
                this.felled = 0;
                this.carried = 0;
                this.noWork = 0;
                this.meals = 0;
                this.hungryTicks = 0;
                this.frames = 0;
            }

            public destructor ~Simulation() returns void {
                delete this.cpop;
                delete this.cadults;
                delete this.cmales;
                delete this.ccx;
                delete this.ccy;
                delete this.stores;
                delete this.cworkX;
                delete this.cworkY;
                delete this.cworkG;
                delete this.cwant;
                delete this.cfed;
                delete this.clesson;
                delete this.cdigX;
                delete this.cdigY;
                delete this.ctrade;
                delete this.town;
                delete this.croom;
                delete this.cworst;
                delete this.cworstRoom;
                delete this.cdead;
                delete this.cbusy;
                delete this.copen;
                delete this.cmade;
                delete this.cowns;
                delete this.cseat;
                delete this.cfar;
                delete this.cfarD;
                delete this.cparty;
                delete this.cfarAge;
                delete this.cchild;
                delete this.cjoin;
                delete this.cflee;
                delete this.cleave;
                delete this.cfood;
                delete this.cfoe;
                delete this.craided;
                delete this.craider;
                delete this.claim;
                delete this.claimHold;
                delete this.claimEdge;
                delete this.wild;
                delete this.meter;
                delete this.chief;
                delete this.lean;
                delete this.culture;
                delete this.deeds;
                delete this.paths;
                delete this.host;
                delete this.cwall;
                delete this.carmy;
                delete this.cbarr;
                delete this.cport;
                delete this.cportb;
                delete this.cdrink;
                delete this.cfresh;
                delete this.cwells;
                delete this.ccare;
                delete this.fates;
                delete this.cfilth;
                delete this.celder;
                delete this.cpriest;
                delete this.ctchief;
                delete this.ccaravan;
                delete this.ccargo;
                delete this.nrailTo;
                delete this.nrailAt;
                delete this.nhost;
                delete this.ctongue;
                delete this.cheld;
                delete this.realm;
                delete this.cnat;
                delete this.csiteX;
                delete this.csiteY;
                delete this.csettle;
                delete this.cmother;
            }

            // What an era costs to reach.
            //
            // Guessed at ten thousand on the reasoning that a village accrues "about forty a
            // second". It accrues about a hundred, and the ladder was climbed in five minutes:
            // seventy-six of eighty-one places ended in the MODERN era, which leaves no asymmetry
            // for contact to act on and makes the whole era system decoration. Read off that run,
            // an era at two hundred and fifty thousand is about forty minutes of prosperity -- so a
            // world arc carries a village two rungs, three if it is rich and curious, and the
            // fourth is genuinely rare.
            // Re-read once knowledge became a NATION's rather than a village's, because the old
            // number was calibrated against the old rule and both failure modes are the same
            // failure: a ladder nobody can climb and a ladder everybody climbs are equally
            // decorative, since the whole point of eras is that neighbours differ.
            //
            // Measured, twenty generations, seed 42. At 250000 with per-head slack: tribal 23,
            // medieval 18, industrial 4, modern 0 -- the fourth rung unreachable at any population.
            // At the same 250000 with nation-pooled slack: tribal 11, medieval 2, industrial 2,
            // modern 43, with the leader modern by the sixth generation. Four times the cost puts
            // the climb back across a whole arc.
            // Re-read a third time once knowledge became something a people BUILDS. Same seed, same
            // twenty generations, one variable each time:
            //
            //   per-head slack, 250k          tribal 23, medieval 18, industrial  4, modern  0
            //   nation-pooled slack, 250k     tribal 11, medieval  2, industrial  2, modern 43 (gen 6)
            //   nation-pooled slack, 1M       tribal 13, medieval 16, industrial  7, modern 21 (gen 15)
            //   ...plus places of learning    tribal 16, medieval  7, industrial  2, modern 42 (gen 10)
            //
            // Shrines, temples, scriptoria, libraries, schools and universities roughly DOUBLED the
            // rate, so the cost doubles with them and the composition is the better one: surplus
            // still gets a people off the bottom rung, and institutions are what compound it.
            public static int ERA_COST = 2500000;
            public static int LAST_ERA = 4;

            // What being next to somebody cleverer is worth. Copying beats inventing, but at four
            // times it was not copying, it was a CASCADE: the first nation to reach a rung dragged
            // every neighbour up behind it within a generation, which is how forty-three of
            // fifty-eight ended modern while thirty-eight eras were invented and a hundred and
            // seventeen were merely caught. Doubled instead of quadrupled, a leader stays a leader
            // long enough for the difference to be worth something.
            public static int TAUGHT = 2;

            // And what being next to a COUSIN is worth. Half again as much, because the thing that
            // makes copying slow is not distance, it is having to work out what the other lot are
            // doing across a language you do not speak -- and inside a civilization you do. It is
            // deliberately a nudge and not a multiple: a civilization should be an advantage its
            // members can waste, not a rail they ride to the last era.
            public static int TAUGHT_KIN = 3;

            // What a settlement knows how to build is what its NATION has worked out. A colony of
            // forty people fires bricks on the day it is founded because the kingdom that sent it
            // knows how -- which is the whole practical difference between a country and a scatter
            // of villages that each had to invent everything for itself.
            public method eraOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 1;
                }
                return this.realm.eraOf(this.cnat[comm]);
            }

            public method communityCount() returns int {
                return this.ncomm;
            }

            // How many people are doing each thing, right now. Read by the detail window, and by
            // the test that makes sure no verb in the enum is one nobody in the world ever performs.
            public method doingCount(int act) returns int {
                mutable int c = 0;
                mutable int i = 0;
                int n = this.folk.limit();
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.actOf(i) == act) {
                        c = c + 1;
                    }
                    i = i + 1;
                }
                return c;
            }

            // And how many have EVER been seen doing it since the world began, which is the honest
            // question: a two-second act is rarely caught by a snapshot however common it is.
            public method everDid(int act) returns long {
                return this.folk.timesDone(act);
            }

            // The grain territory is actually decided at. Nobody owns a CELL: the claim is stored
            // per block, so this is the honest resolution to draw a border at from a distance.
            public method claimWide() returns int {
                return this.claimW;
            }

            public method claimHigh() returns int {
                return this.claimH;
            }

            public method claimBlock() returns int {
                return 16;
            }

            // Where a settlement is, as the average of everybody standing in it. Nobody planted a
            // flag: the centre drifts with the people, and when a place empties out it stops
            // existing rather than leaving a marker behind.
            public method centreXOf(int comm) returns float {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0.0;
                }
                return this.ccx[comm];
            }

            public method centreYOf(int comm) returns float {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0.0;
                }
                return this.ccy[comm];
            }

            public method populationOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0;
                }
                return this.cpop[comm];
            }

            public method nationOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.cnat[comm];
            }

            public method nations() returns Nations* {
                return this.realm;
            }

            public method ways() returns Ways* {
                return this.paths;
            }

            public method armies() returns Armies* {
                return this.host;
            }

            // What a town speaks, which after a conquest is not what its nation speaks. Held per
            // settlement precisely so the two can disagree.
            public method tongueOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.ctongue[comm];
            }

            // Censuses since it was taken by force, or 0 if it was never taken or has been won over.
            public method heldOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0;
                }
                return this.cheld[comm];
            }

            // The three people a place has besides the one in charge, or -1.
            public method elderOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.celder[comm];
            }

            public method priestOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.cpriest[comm];
            }

            public method tradeChiefOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.ctchief[comm];
            }

            // Where this town is sending a load, and what is in it.
            public method caravanFrom(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.ccaravan[comm];
            }

            public method cargoFrom(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0;
                }
                return this.ccargo[comm];
            }

            public method chiefOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0 - 1;
                }
                return this.chief[comm];
            }

            public method wallOf(int comm) returns int {
                if (comm < 0 || comm >= this.ncomm) {
                    return 0;
                }
                return this.cwall[comm];
            }

            public method conquestCount() returns long {
                return this.conquests;
            }

            public method revoltCount() returns long {
                return this.revolts;
            }

            public method convertCount() returns long {
                return this.converted;
            }

            // Which nation holds this ground, or -1. The border is not drawn anywhere: it is the
            // union of what a nation's settlements hold, and it moves when they do.
            public method realmAt(int x, int y) returns int {
                int s = this.ownerAt(x, y);
                if (s < 0) {
                    return 0 - 1;
                }
                return this.cnat[s];
            }

            // Surplus buys slack time; slack time and curiosity buy discovery. A village living hand
            // to mouth learns nothing, however clever its people -- which is the whole reason the
            // economy had to exist before this slice could.
            //
            // And a neighbour is worth more than a genius. Being next to somebody who already knows
            // multiplies what an hour of thinking is worth, because copying is easier than
            // inventing; isolation is not a penalty here, it is simply the absence of that.
            private method discover() returns void {
                int nn = this.realm.limit();
                // Who touches whom, in ONE sweep of the claim map rather than one sweep per nation.
                // The first version asked "who are MY neighbours" a hundred times over a
                // fourteen-thousand block map; this asks "who is next to whom" once. It is the same
                // correction the woodcutter needed and the wolves needed, and it is cheaper to make
                // it while writing the loop than after measuring it.
                //
                // Read at the border of NATIONS and not of villages: two towns of one kingdom
                // touching each other teaches nobody anything, and a kingdom whose far province
                // touches a cleverer neighbour learns from it in its capital.
                mutable int[] ahead = new int[nn]();
                mutable int[] kin = new int[nn]();
                for (int by in 0..this.claimH) {
                    for (int bx in 0..this.claimW) {
                        int ms = this.claim[by * this.claimW + bx];
                        if (ms < 0) {
                            continue;
                        }
                        int me = this.cnat[ms];
                        if (bx + 1 < this.claimW) {
                            int os = this.claim[by * this.claimW + bx + 1];
                            if (os >= 0 && this.cnat[os] != me) {
                                int o = this.cnat[os];
                                // A neighbour you can TALK TO is a different kind of neighbour, and
                                // it is the tongue that decides it rather than the trunk. What
                                // makes copying slow is not distance, it is having to work out what
                                // the other lot are doing without being able to ask; two peoples of
                                // one stock whose speech parted five generations ago are back to
                                // guessing, and two who still share a language are being told.
                                //
                                // Measured, and the difference matters: on the trunk, nearly every
                                // border in the world qualified -- twelve stocks over a hundred and
                                // thirty places -- so the bonus was not a bonus, it was a raise for
                                // everybody, and thirty of seventy-three nations ended modern
                                // against ten before it. On the tongue it is what it was meant to
                                // be: an advantage held by peoples who have not yet drifted apart.
                                if (this.realm.tongueOf(me) == this.realm.tongueOf(o)) {
                                    kin[me] = this.higher(kin[me], this.realm.eraOf(o));
                                    kin[o] = this.higher(kin[o], this.realm.eraOf(me));
                                } else {
                                    ahead[me] = this.higher(ahead[me], this.realm.eraOf(o));
                                    ahead[o] = this.higher(ahead[o], this.realm.eraOf(me));
                                }
                            }
                        }
                        if (by + 1 < this.claimH) {
                            int os = this.claim[(by + 1) * this.claimW + bx];
                            if (os >= 0 && this.cnat[os] != me) {
                                int o = this.cnat[os];
                                if (this.realm.tongueOf(me) == this.realm.tongueOf(o)) {
                                    kin[me] = this.higher(kin[me], this.realm.eraOf(o));
                                    kin[o] = this.higher(kin[o], this.realm.eraOf(me));
                                } else {
                                    ahead[me] = this.higher(ahead[me], this.realm.eraOf(o));
                                    ahead[o] = this.higher(ahead[o], this.realm.eraOf(me));
                                }
                            }
                        }
                    }
                }
                // What every nation can spare, pooled over all of its towns, and how curious the
                // people spending it are.
                //
                // The measure is FED MINDS and not surplus per head. A village of a hundred and
                // twenty with full bellies frees about one person to spend the day thinking; a
                // kingdom of eight such towns frees eight of them, and that is the entire reason
                // countries out-invent villages. Dividing by head -- which is what this did before
                // -- said the opposite: a city of eight hundred learned at exactly the rate of a
                // hamlet of forty, so nothing anybody built ever made the world cleverer and the
                // fourth era could not be reached at any population by any route.
                //
                // The per-head ceiling stays. A people can only think so hard however rich they get,
                // so the surplus that counts is capped before it is multiplied by how many of them
                // there are -- otherwise one absurdly fat harvest would buy an era.
                mutable int[] slack = new int[nn]();
                mutable int[] mind = new int[nn]();
                mutable int[] souls = new int[nn]();
                mutable int[] scholars = new int[nn]();
                // And what its shrines, scriptoria, libraries and schools are working out. This is
                // the half of discovery a people BUILDS rather than merely eats its way into: the
                // same surplus, spent deliberately and visible on the map, instead of a number that
                // rose because the harvest was good.
                mutable int[] lessons = new int[this.ncomm]();
                this.town.learning(lessons, this.ncomm);
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    int nat = this.cnat[c];
                    int need = this.cpop[c] * Simulation.LARDER;
                    int have = this.stores.foodOf(c);
                    if (have > need) {
                        mutable int perHead = (have - need) / (this.cpop[c] + 1);
                        if (perHead > 40) {
                            perHead = 40;
                        }
                        slack[nat] = slack[nat] + perHead * this.cpop[c] / Simulation.VILLAGE;
                    }
                    mind[nat] = mind[nat]
                              + this.cultureOf(c, Simulation.C_CURIOUS) * this.cpop[c];
                    souls[nat] = souls[nat] + this.cpop[c];
                    scholars[nat] = scholars[nat] + lessons[c];
                }
                for (int nat in 0..nn) {
                    if (souls[nat] <= 0 || slack[nat] + scholars[nat] <= 0) {
                        continue;
                    }
                    int curious = mind[nat] / souls[nat];
                    mutable int gain = slack[nat] * (curious + 10) / 20 + scholars[nat];
                    mutable boolean taught = false;
                    mutable boolean fromKin = false;
                    int era = this.realm.eraOf(nat);
                    if (kin[nat] > era) {
                        gain = gain * Simulation.TAUGHT_KIN;
                        taught = true;
                        fromKin = true;
                    } else if (ahead[nat] > era) {
                        gain = gain * Simulation.TAUGHT;  // copying is easier than working it out
                        taught = true;
                    }
                    // Counted where the ERA IS ACTUALLY GAINED, not wherever a cleverer neighbour
                    // happened to be standing. The first version incremented on every census a
                    // cousin was ahead and reported "a hundred and fifteen learned from a
                    // neighbour, a hundred and thirty-seven thousand of them from a cousin" -- a
                    // subset larger than the set it belongs to, which is how you know a counter is
                    // measuring something other than what its name says.
                    if (this.realm.study(nat, gain, Simulation.ERA_COST, Simulation.LAST_ERA)) {
                        if (taught) {
                            this.learned = this.learned + 1;
                            if (fromKin) {
                                this.borrowed = this.borrowed + 1;
                            }
                        } else {
                            this.invented = this.invented + 1;
                        }
                    }
                }
                delete ahead;
                delete kin;
                delete slack;
                delete mind;
                delete souls;
                delete scholars;
                delete lessons;
                return;
            }

            // ---- war ----
            //
            // A nation that wants a town, an army that walks to it, a wall that makes it take time,
            // and a border that finally moves. All of it once a census, in one pass over the
            // armies -- there are sixty-four slots in the world, so this is a rounding error beside
            // the sweep over fifty thousand people that precedes it.
            private method campaign() returns void {
                this.readWalls();
                for (int a in 0..this.host.limit()) {
                    if (this.host.alive(a)) {
                        this.marchOn(a);
                    }
                }
                this.declareWar();
                this.unrest();
                return;
            }

            // What every town has standing between itself and an army, and which army is sitting
            // in front of it. One pass over the building table.
            private method readWalls() returns void {
                for (int c in 0..this.ncomm) {
                    this.cwall[c] = 0;
                    this.carmy[c] = 0 - 1;
                    this.cbarr[c] = 0;
                    this.cport[c] = 0;
                    this.cportb[c] = 0 - 1;
                    // WHAT THE GROUND GIVES FOR NOTHING.
                    //
                    // A village beside a river drinks and never thinks about it; that is why the
                    // natural supply is unbounded rather than a number. What a dry site costs is
                    // everything below -- the well, then the catcher, then the aqueduct it cannot
                    // have because there is no river to reach. Geography stops being scenery at
                    // exactly this line.
                    this.cfresh[c] = this.freshAt(c);
                    if (this.cfresh[c]) {
                        this.cdrink[c] = this.cpop[c];
                    } else {
                        this.cdrink[c] = 0;
                    }
                    this.ccare[c] = 0;
                    this.cwells[c] = 0;
                    this.nhost[c] = 0 - 1;
                }
                // Whose armies are out, read once. Sixty-four slots, not sixty-four slots per
                // person per decision.
                for (int a in 0..this.host.limit()) {
                    if (this.host.alive(a)) {
                        int an = this.host.nationOf(a);
                        if (an >= 0 && an < this.ncomm) {
                            this.nhost[an] = a;
                        }
                    }
                }
                for (int b in 0..this.town.count()) {
                    if (this.town.isGone(b) || !this.town.isWorking(b)) {
                        continue;
                    }
                    int k = this.town.kindOf(b);
                    int hold = Builds.wall(k);
                    int reach = Builds.port(k);
                    int drink = Builds.water(k);
                    int care = Builds.care(k);
                    if (hold <= 0 && reach <= 0 && drink <= 0 && care <= 0) {
                        continue;
                    }
                    int c = this.town.ownerOf(b);
                    if (c >= 0 && c < this.ncomm) {
                        this.cwall[c] = this.cwall[c] + hold;
                        // Two wells water twice as many people, unlike two harbours.
                        this.cdrink[c] = this.cdrink[c] + drink;
                        if (drink > 0) {
                            this.cwells[c] = this.cwells[c] + 1;
                        }
                        this.ccare[c] = this.ccare[c] + care;
                        // A second harbour does not double how far a boat sails, so the town keeps
                        // the longest reach it has rather than the sum of them. Whether anything is
                        // tied up at it is a separate question, asked by `sails` where the routes
                        // are drawn -- the quay is what the town HAS, and the boat is what makes it
                        // reach. Conflating the two would have a town with a harbour and no hull
                        // deciding it needed a second harbour.
                        if (reach > this.cport[c]) {
                            this.cport[c] = reach;
                            this.cportb[c] = b;
                        }
                        if (k == cast<int>(BuildingKind.Barracks)) {
                            this.cbarr[c] = this.cbarr[c] + 1;
                        }
                    }
                }
                // HOW HARD IT IS TO STAY WELL HERE, once a census per town.
                //
                // Two things, and both are things the town did to itself. People sleeping on top of
                // one another pass everything around, so crowding is the first term; and water
                // nobody has cleaned is the second, which is what a treatment works is FOR and the
                // only reason the fourth era of the water line is worth its cement.
                //
                // A place with room to spare and clean water is a place where sickness is a private
                // misfortune. A place with neither is where a plague comes from.
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        this.cfilth[c] = 0;
                        continue;
                    }
                    mutable int f = 0;
                    if (this.croom[c] < this.cpop[c]) {
                        f = (this.cpop[c] - this.croom[c]) * 1000 / this.cpop[c];
                    }
                    if (this.cdrink[c] < this.cpop[c]) {
                        f = f + (this.cpop[c] - this.cdrink[c]) * 1000 / this.cpop[c];
                    }
                    this.cfilth[c] = f;
                }
                for (int a in 0..this.host.limit()) {
                    if (this.host.stateOf(a) == cast<int>(Muster.Besieging)
                        || this.host.stateOf(a) == cast<int>(Muster.Storming)) {
                        int t = this.host.targetOf(a);
                        if (t >= 0 && t < this.ncomm) {
                            this.carmy[t] = a;
                        }
                    }
                }
                return;
            }

            // Somebody decides. This is the difference between a war and a raid: a raid needs
            // nobody's permission, and a war needs a seat, a grievance and a man to lead it.
            //
            // One nation a census, taken in turn, exactly like colonising -- and for the same
            // reason. "Who should I go to war with" is an expensive question and it is asked once
            // per WORLD per second.
            private method declareWar() returns void {
                int nn = this.realm.limit();
                mutable int tries = 0;
                while (tries < nn) {
                    this.warlord = this.warlord + 1;
                    if (this.warlord >= nn) {
                        this.warlord = 0;
                    }
                    tries = tries + 1;
                    int nat = this.warlord;
                    if (!this.realm.alive(nat)
                        || this.realm.rankOf(nat) < cast<int>(Rank.Kingdom)) {
                        continue;                // a chiefdom raids; it does not campaign
                    }
                    int seat = this.realm.seatOf(nat);
                    if (seat < 0 || this.cpop[seat] < Simulation.VILLAGE) {
                        continue;
                    }
                    // An army eats. A nation that cannot feed its own capital does not send five
                    // hundred people to sit in a field.
                    if (this.stores.foodOf(seat) < this.cpop[seat] * Simulation.LARDER) {
                        continue;
                    }
                    if (this.armyOf(nat) >= 0) {
                        continue;                // one in the field at a time
                    }
                    // What it wants: the nearest town of somebody it has a grudge against. The
                    // grudge is the raid's own memory -- so a war is what a feud becomes once one
                    // side is big enough to finish it, which is exactly the escalation the raid
                    // could never provide on its own.
                    int want = this.warAim(nat, seat);
                    if (want < 0) {
                        continue;
                    }
                    int lead = this.raiseGeneral(seat);
                    if (lead < 0) {
                        continue;
                    }
                    int a = this.host.open();
                    if (a < 0) {
                        return;
                    }
                    this.host.call(a, nat, seat, want, lead);
                    // Called out with its heart full. Everything after this spends it.
                    this.host.hearten(a, Simulation.HEART_FULL);
                    this.folk.setRole(lead, cast<int>(Role.General));
                    this.folk.setJob(lead, cast<int>(Job.General));
                    return;
                }
                return;
            }

            // The town this nation is going for, or -1. Somewhere it has a feud with, near enough
            // to reach, and not already somebody's siege.
            private method warAim(int nat, int seat) returns int {
                mutable int best = 0 - 1;
                mutable float bestD = 0.0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0 || this.cnat[c] == nat) {
                        continue;
                    }
                    if (this.carmy[c] >= 0) {
                        continue;
                    }
                    // A grievance, in either direction. Somebody raided us, or we have been raiding
                    // them and it is time to stop carrying the grain home one load at a time.
                    boolean quarrel = this.craider[seat] == c || this.cfoe[seat] == c
                                   || this.craider[c] == seat || this.cfoe[c] == seat;
                    if (!quarrel) {
                        continue;
                    }
                    // NOBODY MARCHES ON A FRIEND.
                    //
                    // A grudge used to be the whole of foreign policy: it sent an army, the army
                    // went home, the grudge stayed and another army came. Nothing anybody did could
                    // make it better. Now a border that has carried enough trade is worth more than
                    // the quarrel across it, and the country stays home -- which is the first time
                    // two peoples here have ever settled anything without one of them losing.
                    if (this.realm.bondOf(nat, this.cnat[c]) >= Nations.BOND_PEACE) {
                        continue;
                    }
                    // Cousins fight, but not over an old grudge. Somebody who speaks a dialect of
                    // your language, whose grandparents came over the same ground as yours, has to
                    // be raiding you NOW to be worth marching on -- while a stranger is worth it on
                    // a memory. That is what "wars less among themselves" comes to: not a ban, a
                    // higher bar, and one that a bad enough neighbour still clears.
                    if (this.realm.sameStock(nat, this.cnat[c])
                        && this.craided[seat] < Simulation.GRUDGE / 2) {
                        continue;
                    }
                    float dx = this.ccx[c] - this.ccx[seat];
                    float dy = this.ccy[c] - this.ccy[seat];
                    float d = dx * dx + dy * dy;
                    if (d > cast<float>(Simulation.WAR_REACH * Simulation.WAR_REACH)) {
                        continue;
                    }
                    if (best < 0 || d < bestD) {
                        best = c;
                        bestD = d;
                    }
                }
                return best;
            }

            // Whoever this town would follow. The most established grown person in it who is not
            // already its chief -- a nation does not send the man who holds it together.
            private method raiseGeneral(int seat) returns int {
                int n = this.folk.limit();
                mutable int best = 0 - 1;
                mutable int bestV = 0;
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.isAdult(i)
                        && this.folk.homeOf(i) == seat && i != this.chief[seat]) {
                        int v = this.folk.influenceOf(i) + this.folk.boldnessOf(i) / 4;
                        if (v > bestV) {
                            bestV = v;
                            best = i;
                        }
                    }
                    i = i + 1;
                }
                return best;
            }

            // The army a nation has out, as a LOOKUP. Everything that asks per person per decision
            // asks this; `armyOf` below is the search that fills it, and only the census may call
            // it -- once, in `readWalls`, beside the walls and the barracks.
            private method mustering(int nat) returns int {
                if (nat < 0 || nat >= this.ncomm) {
                    return 0 - 1;
                }
                return this.nhost[nat];
            }

            private method armyOf(int nat) returns int {
                for (int a in 0..this.host.limit()) {
                    if (this.host.alive(a) && this.host.nationOf(a) == nat) {
                        return a;
                    }
                }
                return 0 - 1;
            }

            // One army, one census.
            private method marchOn(int a) returns void {
                this.host.tick(a);
                int nat = this.host.nationOf(a);
                int t = this.host.targetOf(a);
                int lead = this.host.generalOf(a);
                // An army without a general is a crowd. Without a target it is a crowd in a field.
                if (t < 0 || t >= this.ncomm || this.cpop[t] <= 0 || !this.realm.alive(nat)) {
                    this.standDown(a);
                    return;
                }
                if (lead < 0 || !this.folk.alive(lead)) {
                    // The general is dead. Somebody else steps up if there is anybody, and if there
                    // is not, the army goes home -- which is what an army without a head does.
                    int heir = this.raiseGeneral(this.host.musterOf(a));
                    if (heir < 0) {
                        this.standDown(a);
                        return;
                    }
                    this.host.setGeneral(a, heir);
                    this.folk.setRole(heir, cast<int>(Role.General));
                    this.folk.setJob(heir, cast<int>(Job.General));
                    return;
                }
                int under = this.countUnder(a, lead);
                this.host.setStrength(a, under);
                int s = this.host.stateOf(a);
                if (s == cast<int>(Muster.Gathering)) {
                    if (under >= Simulation.HOST) {
                        this.host.setState(a, cast<int>(Muster.Marching));
                    } else if (this.host.heldFor(a) > Simulation.MUSTER_WAIT) {
                        this.standDown(a);       // nobody came
                    }
                    return;
                }
                float dx = this.ccx[t] - this.folk.xAt(lead);
                float dy = this.ccy[t] - this.folk.yAt(lead);
                boolean there = dx * dx + dy * dy
                              < cast<float>(Simulation.SIEGE_LINE * Simulation.SIEGE_LINE);
                if (s == cast<int>(Muster.Marching)) {
                    if (there) {
                        this.host.setState(a, cast<int>(Muster.Besieging));
                    } else if (this.host.heldFor(a) > Simulation.MARCH_WAIT) {
                        this.standDown(a);
                    }
                    return;
                }
                if (s == cast<int>(Muster.Besieging)) {
                    if (!there || under < Simulation.HOST / 3) {
                        this.standDown(a);       // starved out, or bled out
                        return;
                    }
                    // Sitting in front of it does two things: it breaks the wall down, and it eats
                    // the fields. A town with no wall falls at once; a town with a keep outlasts
                    // the army in front of it, which is what a keep is FOR.
                    this.host.press(a, under);
                    this.stores.seize(t, this.stores.richest(t), under / 4 + 1);
                    // AND IT COSTS THEM THE WILL TO BE THERE.
                    //
                    // A siege used to end after SIEGE_WAIT censuses whatever had happened, and a
                    // number of turns is not a reason. Standing in a field a long way from home
                    // spends something every day; the keep that outlasts what is in front of it has
                    // won by doing nothing, and now the world says so in the same units as the
                    // fighting does.
                    this.host.dishearten(a, Simulation.HEART_VIGIL);
                    if (this.host.heartOf(a) <= 0) {
                        this.host.noteRout(a);
                        this.standDown(a);
                        return;
                    }
                    if (this.host.siegeOf(a) >= this.cwall[t]) {
                        this.host.setState(a, cast<int>(Muster.Storming));
                    }
                    return;
                }
                if (s == cast<int>(Muster.Storming)) {
                    // THE ASSAULT IS A FIGHT AND NOT A FORMALITY.
                    //
                    // Storming used to be a state that always ended in the town changing hands: the
                    // wall came down and the place was taken, so a garrison was worth nothing and
                    // every siege that got this far won. Now the men inside get a say. A town's
                    // defence is everybody grown in it at whatever they are carrying, so a big
                    // place is hard to take even undefended by walls, and a small one with an
                    // armoury is harder than its size.
                    //
                    // Both sides lose men in proportion to what they faced, which is what makes
                    // conquest expensive and why a country cannot simply roll over its neighbours
                    // one after another without ever stopping.
                    int hold = this.garrison(t);
                    int loss = this.storm(a, nat, t, under, hold);
                    if (loss > 0) {
                        this.host.dishearten(a, loss * Simulation.HEART_PER_LOSS);
                    }
                    if (this.host.heartOf(a) <= 0 && this.host.alive(a)) {
                        this.host.noteRout(a);
                        this.standDown(a);
                    }
                    return;
                }
                this.standDown(a);
                return;
            }

            // WHAT A SOLDIER IS, READ OFF WHAT THEY ARE CARRYING.
            //
            // There is no troop-type field and there should not be one. A man with nothing is a
            // levy dragged off a field; a man with a spear is a soldier; a man with a spear and mail
            // is worth several of either, and everybody knows which he is by looking at him. Every
            // other standing in this world is read off the world the same way -- a chief is whoever
            // is listened to, an elder is whoever has lived longest -- and a stored rank would be
            // wrong within the minute at six minutes a life.
            //
            // It is also what armour is FOR. Three hundred suits of mail were made in an arc and
            // changed nothing, because a headcount cannot tell one man from another. Now a small
            // army of armoured men beats a big one of farmers, which is the entire reason a country
            // bothers with an armoury.
            private method mettle(int i) returns int {
                if (this.folk.hasKit(i, AgentTable.K_ARMOUR)) {
                    return Simulation.WEIGHT_MAILED;
                }
                if (this.folk.hasKit(i, AgentTable.K_WEAPON)) {
                    return Simulation.WEIGHT_ARMED;
                }
                return Simulation.WEIGHT_LEVY;
            }

            public static int WEIGHT_LEVY = 1;
            public static int WEIGHT_ARMED = 3;
            public static int WEIGHT_MAILED = 7;
            // What a town can put up in its own defence: everybody grown, at whatever they carry,
            // because a townsman with a hoe still gets in the way.
            public static int HEART_FULL = 100;
            public static int HEART_VIGIL = 3;     // the cost of one census stood in a field
            public static int HEART_PER_LOSS = 6;  // and of one man not coming back
            // What a border does to a friendship. A load across it warms by a little, so it takes
            // scores of them to reach peace and one conquest to undo it -- which is the right ratio:
            // trust is slow and a burnt town is not.
            public static int BOND_PER_LOAD = 4;
            public static int BOND_PER_RAID = 0 - 6;
            public static int BOND_PER_TOWN = 0 - 150;

            // Soldiers within a general's reach. This is the FORMATION: an army is the people who
            // are actually standing around the man leading it, so one that has strung itself across
            // the country is weak wherever it is, exactly as it should be.
            private method countUnder(int a, int lead) returns int {
                int n = this.folk.limit();
                float gx = this.folk.xAt(lead);
                float gy = this.folk.yAt(lead);
                float span = cast<float>(Simulation.RANKS * Simulation.RANKS);
                int nat = this.host.nationOf(a);
                mutable int c = 0;
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.jobOf(i) == cast<int>(Job.Raider)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm && this.cnat[h] == nat) {
                            float dx = this.folk.xAt(i) - gx;
                            float dy = this.folk.yAt(i) - gy;
                            if (dx * dx + dy * dy < span) {
                                // Weighed rather than counted. Same loop, same cost, and the
                                // difference between a mob and an army.
                                c = c + this.mettle(i);
                            }
                        }
                    }
                    i = i + 1;
                }
                return c;
            }

            // What a town can put in the way of an army. Everybody grown who lives there, at
            // whatever they carry -- a farmer with a hoe is not a soldier but he is not nothing
            // either, and a town that armed itself is a different proposition entirely.
            private method garrison(int t) returns int {
                int n = this.folk.limit();
                mutable int hold = 0;
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.homeOf(i) == t && this.folk.isAdult(i)) {
                        hold = hold + this.mettle(i);
                    }
                    i = i + 1;
                }
                return hold;
            }

            // The assault itself. Returns what the attacker lost.
            //
            // Weight against weight, with the storming side paying for every point the defence had:
            // an army that walks into a town twice its strength is destroyed, one that walks into a
            // village a tenth its size barely notices. Nobody rolls dice for this -- the world is
            // deterministic on a seed and a battle is not the place to break that.
            private method storm(int a, int nat, int t, int power, int hold) returns int {
                mutable int fell = 0;
                if (power > hold) {
                    // Taken. The cost is proportional to what stood in the way, and it is paid in
                    // the people who did the standing on both sides.
                    fell = this.bleed(t, nat, hold / 3 + 1, power / 6 + 1);
                    this.takeTown(a, nat, t);
                    return fell;
                }
                // Thrown back. The wall they broke stays broken -- the siege work is not undone --
                // but the men are gone and the will with them.
                fell = this.bleed(t, nat, power / 4 + 1, hold / 8 + 1);
                return fell;
            }

            // Men die on both sides. `attackers` and `defenders` are how many are struck down;
            // returns how many of the ATTACKING side fell, because that is what morale is spent on.
            private method bleed(int t, int nat, int attackers, int defenders) returns int {
                int n = this.folk.limit();
                mutable int killedIn = 0;
                mutable int killedOut = 0;
                mutable int i = 0;
                while (i < n) {
                    if (killedIn >= defenders && killedOut >= attackers) {
                        i = n;
                    } else {
                        if (this.folk.alive(i) && this.folk.isAdult(i)) {
                            int h = this.folk.homeOf(i);
                            if (h == t && killedIn < defenders) {
                                this.vacate(i, h);
                                this.folk.kill(i);
                                this.deathsWar = this.deathsWar + 1;
                                killedIn = killedIn + 1;
                            } else if (h >= 0 && h < this.ncomm && this.cnat[h] == nat
                                       && this.folk.jobOf(i) == cast<int>(Job.Raider)
                                       && killedOut < attackers) {
                                this.vacate(i, h);
                                this.folk.kill(i);
                                this.deathsWar = this.deathsWar + 1;
                                killedOut = killedOut + 1;
                            }
                        }
                        i = i + 1;
                    }
                }
                return killedOut;
            }

            // The border moves.
            //
            // Everything the town is stays: its people, its buildings, its culture and -- the part
            // that matters -- its LANGUAGE. Nobody is displaced and nobody forgets who they are,
            // which is why a conquest is the beginning of a problem rather than the end of one.
            private method takeTown(int a, int nat, int t) returns void {
                int was = this.cnat[t];
                if (was == nat) {
                    this.standDown(a);
                    return;
                }
                this.cnat[t] = nat;
                this.realm.annex(nat, was);
                // And it is remembered. One town taken undoes what scores of caravans built, which
                // is the ratio that makes trade a slow way to a friend and conquest a fast way to an
                // enemy -- and it is why a country that keeps taking towns finds nobody will deal
                // with it, which is a consequence it never had before.
                this.realm.warm(nat, was, Simulation.BOND_PER_TOWN);
                // Nothing is torn down. The town keeps its buildings, its fields and its town hall,
                // because a conquest is a change of flag and not a demolition -- the ONLY thing that
                // changed is the line on the map. That is also why it is a problem afterwards.
                this.cheld[t] = 1;               // and the clock on holding it starts
                int had = this.chief[t];         // whoever they listened to is not in charge now
                if (had >= 0 && this.folk.alive(had)) {
                    this.folk.setRole(had, cast<int>(Role.None));
                }
                this.chief[t] = 0 - 1;
                this.conquests = this.conquests + 1;
                this.annexed = this.annexed + 1;
                int lead = this.host.generalOf(a);
                if (lead >= 0 && this.folk.alive(lead)) {
                    this.folk.earn(lead, 40);    // taking a city is the largest thing anybody does
                }
                this.standDown(a);
                return;
            }

            private method standDown(int a) returns void {
                int lead = this.host.generalOf(a);
                if (lead >= 0 && this.folk.alive(lead)) {
                    this.folk.setRole(lead, cast<int>(Role.None));
                    this.folk.setJob(lead, cast<int>(Job.Idle));
                }
                this.host.disband(a);
                return;
            }

            // What a conquered town does about it.
            //
            // A people that still speaks its own language under somebody else's flag is a problem
            // that does not go away by being ignored, and that is the incentive: a ruler can leave
            // them alone and live with the risk, or spend on making them his. Neither is free, and
            // that choice is the whole reason conquest is interesting rather than a counter going
            // up.
            private method unrest() returns void {
                for (int c in 0..this.ncomm) {
                    if (this.cheld[c] <= 0) {
                        continue;
                    }
                    // A place with nobody left in it is not held by anybody. A siege eats the fields
                    // and the storming kills people, so a town CAN empty out shortly after being
                    // taken -- and when it does, the flag on it means nothing and has to come down,
                    // or the world carries a subject population of nought for the rest of the run.
                    if (this.cpop[c] <= 0) {
                        this.cheld[c] = 0;
                        continue;
                    }
                    this.cheld[c] = this.cheld[c] + 1;
                    int nat = this.cnat[c];
                    if (this.ctongue[c] == this.realm.tongueOf(nat)) {
                        this.cheld[c] = 0;       // they are his people now; nothing left to hold
                        continue;
                    }
                    // Conversion is bought, not decreed. A ruler pays in the one thing a subject
                    // town cannot argue with -- grain -- and it takes as long as it takes.
                    int seat = this.realm.seatOf(nat);
                    if (seat >= 0 && seat != c
                        && this.stores.foodOf(seat) > this.cpop[seat] * Simulation.LARDER * 2) {
                        this.stores.take(seat, this.stores.richest(seat), Simulation.CONVERT_COST);
                        this.stores.add(c, cast<int>(Good.Grain), Simulation.CONVERT_COST / 2);
                        // A priest in the town halves it. Grain buys quiet; somebody standing in
                        // the shrine every day, teaching in the new tongue, is what actually
                        // changes what a people calls itself -- and it is why a ruler who wants a
                        // conquest to stick raises a shrine in it rather than a garrison.
                        mutable int patience = Simulation.CONVERT_TIME;
                        if (this.cpriest[c] >= 0) {
                            patience = patience / 2;
                        }
                        if (this.cheld[c] > patience) {
                            this.ctongue[c] = this.realm.tongueOf(nat);
                            this.converted = this.converted + 1;
                            this.cheld[c] = 0;
                        }
                        continue;
                    }
                    // Nobody is spending anything on them, and they remember. The longer it goes
                    // on the likelier it is that one morning they simply stop answering -- unless
                    // somebody is at least talking to them, which is the other half of what the
                    // shrine buys.
                    mutable int odds = this.cheld[c] / 8;
                    if (this.cpriest[c] >= 0) {
                        odds = odds / 2;
                    }
                    if (cast<int>(LandMath.hash01(this.seed ^ 0x51B3, c, this.tick) * 1000.0)
                        < odds) {
                        this.breakAway(c);
                    }
                }
                return;
            }

            // A town that has had enough. It becomes its own nation again, speaking what it always
            // spoke -- which is why the language was worth keeping per settlement.
            private method breakAway(int c) returns void {
                int free = this.realm.open();
                if (free < 0) {
                    return;
                }
                int was = this.cnat[c];
                this.realm.raise(free, this.ctongue[c], was, this.tick, this.realm.eraOf(was));
                this.cnat[c] = free;
                this.cheld[c] = 0;
                this.craided[c] = Simulation.GRUDGE;
                this.craider[c] = this.realm.seatOf(was);
                this.revolts = this.revolts + 1;
                return;
            }

            // How far a nation will campaign, how many make an army, and how long each phase gets
            // before the thing falls apart. Every one of these is a patience: an army is people
            // standing in a field eating, and the only reason a siege ever ends is that somebody
            // runs out of it first.
            public static int WAR_REACH = 400;
            public static int HOST = 24;
            public static int RANKS = 40;
            // How close the line sits. Twelve cells is INSIDE the town's own claim, and that is
            // deliberate: sitting there is what makes `foeNear` fire on both sides, so a siege costs
            // lives through exactly the machinery a village brawl already used. There is no separate
            // battle code anywhere in this file, and there should not be.
            public static int SIEGE_LINE = 12;
            // How many a single barracks keeps standing. Small on purpose: a standing soldier eats
            // without producing, so a town that lines them up instead of feeding itself starves,
            // and the catalogue should let it make that mistake without forcing it.
            public static int KEPT = 6;
            public static int MUSTER_WAIT = 90;
            public static int MARCH_WAIT = 400;
            public static int SIEGE_WAIT = 300;

            // What it costs to make a conquered people yours, and how long it takes. Paid every
            // census out of the capital's own stores, so an empire that overreaches finds it
            // cannot hold what it took.
            public static int CONVERT_COST = 12;
            public static int CONVERT_TIME = 600;

            // Everything that is true of a POLITY, read off the settlements that answer to it.
            //
            // Nobody is appointed and nothing is proclaimed. The capital is whichever of a nation's
            // towns is biggest, so a seat overtaken by one of its own colonies MOVES; the ruler is
            // whoever that town already listens to; the rank is what the holdings add up to. Each of
            // those was already being decided somewhere for its own reasons, and this only reads
            // them -- which is why a nation cannot be at a rank its people have not actually built.
            private method realmCensus() returns void {
                this.realm.beginCount();
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] > 0) {
                        this.realm.countTown(this.cnat[c], c, this.cpop[c]);
                    }
                }
                for (int b in 0..this.claimW * this.claimH) {
                    int s = this.claim[b];
                    if (s >= 0 && s < this.ncomm && this.cpop[s] > 0) {
                        this.realm.countLand(this.cnat[s]);
                    }
                }
                for (int nat in 0..this.realm.limit()) {
                    int cap = this.realm.seatOf(nat);
                    mutable int lord = 0 - 1;
                    if (cap >= 0) {
                        lord = this.chief[cap];
                    }
                    this.realm.settleRank(nat, lord);
                    this.realm.wag(nat, this.seed, this.tick);
                }
                if (!this.stocked) {
                    this.seedStocks();
                    this.stocked = true;
                }
                return;
            }

            // Where the peoples of the world came from, decided once, on the first census -- the
            // first moment community centres are real rather than zero.
            //
            // Everybody having their own stock would be a world of a hundred and thirty
            // civilizations, which is a list and not a history. What is actually true of a scattered
            // people is that neighbours are already cousins: they came over the same ground within a
            // few generations of one another, and the ones on the far side of the world did not.
            // So a handful of HEARTHS are picked as far apart as the map allows, and every band
            // belongs to the nearest -- which yields big cultural regions on day one that then drift
            // apart into separate languages and separate countries over an arc, keeping the trunk.
            //
            // Once. A hundred and thirty communities against twelve hearths is sixteen hundred
            // comparisons, paid one time at the start of the world.
            private method seedStocks() returns void {
                mutable int[] hearth = new int[Simulation.STOCKS]();
                mutable int found = 0;
                // Farthest-point sampling: the first band that exists, then repeatedly whichever
                // band is furthest from every hearth already chosen. Deterministic, and it spreads
                // the hearths over the continents instead of clumping them on the biggest one.
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] > 0 && found == 0) {
                        hearth[0] = c;
                        found = 1;
                    }
                }
                if (found == 0) {
                    delete hearth;
                    return;                          // nobody is alive; nothing to found
                }
                while (found < Simulation.STOCKS) {
                    mutable int far = 0 - 1;
                    mutable float farD = 0.0 - 1.0;
                    for (int c in 0..this.ncomm) {
                        if (this.cpop[c] <= 0) {
                            continue;
                        }
                        mutable float near = 0.0;
                        mutable boolean first = true;
                        for (int k in 0..found) {
                            int h = hearth[k];
                            float dx = this.ccx[c] - this.ccx[h];
                            float dy = this.ccy[c] - this.ccy[h];
                            float d = dx * dx + dy * dy;
                            if (first || d < near) {
                                near = d;
                                first = false;
                            }
                        }
                        if (near > farD) {
                            farD = near;
                            far = c;
                        }
                    }
                    if (far < 0) {
                        break;                       // fewer living bands than hearths wanted
                    }
                    hearth[found] = far;
                    found = found + 1;
                }
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    mutable int mine = hearth[0];
                    mutable float best = 0.0;
                    mutable boolean first = true;
                    for (int k in 0..found) {
                        int h = hearth[k];
                        float dx = this.ccx[c] - this.ccx[h];
                        float dy = this.ccy[c] - this.ccy[h];
                        float d = dx * dx + dy * dy;
                        if (first || d < best) {
                            best = d;
                            mine = h;
                            first = false;
                        }
                    }
                    this.realm.settleTrunk(this.cnat[c], mine);
                    // And the settlement speaks what its people speak. Held per settlement so that
                    // after a conquest the town and the flag over it can disagree -- which they
                    // cannot do if every town starts out speaking something nobody else does.
                    this.ctongue[c] = mine;
                }
                delete hearth;
                return;
            }

            // How many peoples the world begins with. Twelve: enough that the map has distinct
            // cultural regions rather than one grey mass, few enough that each of them is big enough
            // to have a history worth watching.
            public static int STOCKS = 12;

            private method higher(int a, int b) returns int {
                if (b > a) {
                    return b;
                }
                return a;
            }

            // The five things a community can be, in the same order as an agent's temperament, so a
            // culture weight and the trait it shapes are the same index.
            public static fixed int C_BOLD = 0;
            public static fixed int C_SOCIAL = 1;
            public static fixed int C_GREED = 2;
            public static fixed int C_CURIOUS = 3;
            public static fixed int C_AMBITION = 4;

            // How far toward its birthplace a child is pulled, out of a hundred. A fifth: enough
            // that a village becomes recognisable over a handful of generations, little enough that
            // a person is still mostly their mother -- which is what keeps temperament worth
            // inheriting at all.
            public static int STEEP = 20;

            // Which of the five a trade speaks for. Culture is read off WHAT PEOPLE SPEND THEIR
            // LIVES DOING, and not off how many acts each kind of work happens to produce -- the
            // first attempt counted deeds, and since a forager fills a basket a thousand times for
            // every workshop anybody raises, it read "bold 0..2, ambition 0..0" across every village
            // in the world. A village with a third of its people out hunting is a hunting village
            // however few kills that comes to.
            private method axisOf(int job) returns int {
                if (job == cast<int>(Job.Hunter)) {
                    return Simulation.C_BOLD;
                }
                if (job == cast<int>(Job.Miner) || job == cast<int>(Job.Quarrier)) {
                    return Simulation.C_GREED;
                }
                if (job == cast<int>(Job.Forager) || job == cast<int>(Job.Fisher)
                    || job == cast<int>(Job.Prospector) || job == cast<int>(Job.Scholar)) {
                    return Simulation.C_CURIOUS;
                }
                if (job == cast<int>(Job.Builder) || job == cast<int>(Job.Raider)) {
                    // Ambition is wanting more than you have and doing something about it. Raising
                    // a hall is one way; taking somebody else's is the other. This axis read
                    // 0..14 mean 0 across every measured arc until there was a second way.
                    return Simulation.C_AMBITION;
                }
                if (job == cast<int>(Job.Idle)) {
                    return 0 - 1;                        // idleness says nothing about a place
                }
                return Simulation.C_SOCIAL;              // wood and every trade worked alongside others
            }

            // Culture is held in fixed point, and that is not tidiness -- it is a bug fix. Stored as
            // whole numbers and stepped a thirty-second of the way, the step TRUNCATED to zero the
            // moment the gap fell under thirty-two, so every axis nobody fed froze at exactly 31 and
            // the first measurement read "bold 31..31, greed 31..31" across all eighty villages.
            // That is not a world where nothing happened; it is integer division quantising the
            // whole scale into one value. A thousand and twenty-four to the unit leaves the residual
            // error at three hundredths of a point.
            public static fixed int CFIX = 1024;

            public method cultureOf(int comm, int axis) returns int {
                return this.culture[comm * 5 + axis] / Simulation.CFIX;
            }

            // Fold this second's mix of trades into what the place IS. A thirty-second of the way
            // each time, so a village turns over across about half a lifetime -- fast enough to see
            // inside an arc, slow enough that one bad season is not a change of national character.
            //
            // The census has just counted everybody by trade, so this costs a loop over a hundred
            // communities and nothing else.
            private method steep() returns void {
                int nj = Job.count();
                for (int c in 0..this.ncomm) {
                    for (int a in 0..5) {
                        this.deeds[c * 5 + a] = 0;
                    }
                    mutable int total = 0;
                    for (int jb in 0..nj) {
                        int a = this.axisOf(jb);
                        if (a < 0) {
                            continue;
                        }
                        int held = this.ctrade[c * nj + jb];
                        this.deeds[c * 5 + a] = this.deeds[c * 5 + a] + held;
                        total = total + held;
                    }
                    if (total < 4) {
                        continue;                        // too few at work to read anything from
                    }
                    // A place with somebody old in it becomes itself faster. That is what an elder
                    // IS: the person who remembers how this village does things and is believed
                    // about it, so what the village does today is pulled harder toward what it has
                    // always done. A place that loses its old people drifts.
                    mutable int slow = 32;
                    if (this.celder[c] >= 0) {
                        slow = 24;
                    }
                    for (int a in 0..5) {
                        int at = c * 5 + a;
                        int want = this.deeds[at] * 100 * Simulation.CFIX / total;
                        this.culture[at] = this.culture[at] + (want - this.culture[at]) / slow;
                    }
                }
                return;
            }

            // A village is where somebody starts being listened to. Below it a band simply defers to
            // whoever is oldest and nothing is decided; above it there is a role, and the role stays
            // when its holder dies.
            public static int VILLAGE = 120;

            // The standing at which somebody counts as properly established.
            //
            // Guessed twice and wrong both times, which is worth writing down. First against the
            // byte's range, 255: two people in a hundred went along. Then against "a few dozen
            // deeds", 45: five in a hundred. Then the run was asked instead of estimated -- a
            // village chief carries about eight, because an adult life is roughly two hundred and
            // fifty seconds and a load comes home every thirty. So this is fifteen: reachable by a
            // long and busy life, and a chief who has it sways two villagers in five.
            //
            // The lesson is the one this project keeps relearning: a constant that is supposed to
            // mean "what a life reaches" must be READ OFF a life, never reasoned toward.
            public static int NOTABLE = 15;

            public method fauna() returns Wildlife* {
                return this.wild;
            }

            // How far a community can be spread out and still be ONE community, in cells. It is
            // WORK_BLOCKS of sixteen -- the distance the place searches for work -- because a
            // hamlet whose people are further out than that is not an edge of the village any
            // more, it is somewhere else that has not admitted it yet.
            public static int REIGN = 48;

            // What a community holds is the ground its people are standing on, widened by how far
            // they go to work.
            //
            // It used to be a disk of REIGN cells around the mean position, which made every place
            // in the world exactly the same size and shape no matter whether fifty people or eight
            // hundred lived there. That is a dial wearing a rule's clothes. Territory is now READ
            // OFF the population the same way the centre already was: whoever has the most people
            // standing in a block holds it, and the claim then spreads outward by the distance a
            // worker covers. A village strung along a river holds the river; a city holds a wide
            // irregular country; a hamlet holds a blob. Nothing had to be tuned for that -- it falls
            // out of where fifty thousand people actually are.
            private method restake() returns void {
                int nb = this.claimW * this.claimH;
                for (int b in 0..nb) {
                    this.claim[b] = 0 - 1;
                    this.claimHold[b] = 0;
                }
                // Who is standing where, settled by majority. A running vote rather than a count per
                // community per block: a tally would be a quarter of a million cells wide and this
                // is one int, because the only question asked of it is who has the most.
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm) {
                            int bx = cast<int>(this.folk.xAt(i)) / 16;
                            int by = cast<int>(this.folk.yAt(i)) / 16;
                            if (bx >= 0 && by >= 0 && bx < this.claimW && by < this.claimH) {
                                int at = by * this.claimW + bx;
                                if (this.claim[at] == h) {
                                    this.claimHold[at] = this.claimHold[at] + 1;
                                } else if (this.claimHold[at] == 0) {
                                    this.claim[at] = h;
                                    this.claimHold[at] = 1;
                                } else {
                                    this.claimHold[at] = this.claimHold[at] - 1;
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
                // And then it spreads to the ground they work but do not sleep on. One ring a pass,
                // read from the last pass so a claim cannot race across the map in a single census.
                for (int pass in 0..Simulation.WORK_BLOCKS) {
                    for (int b in 0..nb) {
                        this.claimEdge[b] = this.claim[b];
                    }
                    for (int by in 0..this.claimH) {
                        for (int bx in 0..this.claimW) {
                            int at = by * this.claimW + bx;
                            if (this.claimEdge[at] >= 0) {
                                continue;
                            }
                            mutable int take = 0 - 1;
                            if (bx > 0 && this.claimEdge[at - 1] >= 0) {
                                take = this.claimEdge[at - 1];
                            } else if (bx + 1 < this.claimW && this.claimEdge[at + 1] >= 0) {
                                take = this.claimEdge[at + 1];
                            } else if (by > 0 && this.claimEdge[at - this.claimW] >= 0) {
                                take = this.claimEdge[at - this.claimW];
                            } else if (by + 1 < this.claimH && this.claimEdge[at + this.claimW] >= 0) {
                                take = this.claimEdge[at + this.claimW];
                            }
                            this.claim[at] = take;
                        }
                    }
                }
                this.claimAge = this.claimAge + 1;
                // Wildlife is told the same thing, once, and treats settled ground as no longer
                // habitat. Fourteen thousand writes a second against a billion and a half distance
                // tests a frame is the whole reason it is done this way round.
                for (int by in 0..this.claimH) {
                    for (int bx in 0..this.claimW) {
                        this.wild.setSettled(bx, by, this.claim[by * this.claimW + bx] >= 0);
                    }
                }
                this.wild.reindex();
                return;
            }

            // Who holds this cell, or -1.
            public method ownerAt(int x, int y) returns int {
                if (x < 0 || y < 0) {
                    return 0 - 1;
                }
                int bx = x / 16;
                int by = y / 16;
                if (bx >= this.claimW || by >= this.claimH) {
                    return 0 - 1;
                }
                int c = this.claim[by * this.claimW + bx];
                if (c < 0) {
                    return 0 - 1;
                }
                // Nobody holds the sea, and nobody holds a cliff face. A claim is over ground its
                // people can walk on and work -- which is also what stops a coastal village looking
                // like a naval power on the map.
                if (!this.walkable(x, y)) {
                    return 0 - 1;
                }
                return c;
            }

            public method claimVersion() returns int {
                return this.claimAge;
            }

            public method store() returns Stores* {
                return this.stores;
            }

            public method buildings() returns Buildings* {
                return this.town;
            }

            public method setBudget(int b) returns void
                requires b > 0
            {
                this.budget = b;
                return;
            }

            // The renderer knows which cells are on screen at full detail; the simulation needs the
            // same rectangle to know who is worth walking properly.
            public method setNearWindow(int x0, int y0, int x1, int y1) returns void {
                this.nearX0 = x0;
                this.nearY0 = y0;
                this.nearX1 = x1;
                this.nearY1 = y1;
                return;
            }

            public method seconds() returns float {
                return this.clock;
            }

            public method thoughtLastFrame() returns int {
                return this.thoughtThisFrame;
            }

            public method worstFrame() returns int {
                return this.worstThink;
            }

            public method stuck() returns int {
                return this.stuckTotal;
            }

            public method arrived() returns int {
                return this.arrivals;
            }

            private method walkable(int x, int y) returns boolean {
                if (x < 0 || y < 0 || x >= this.g.width() || y >= this.g.height()) {
                    return false;
                }
                return Biomes.walkable(this.g.biomeAt(x, y));
            }

            // Can this be walked to in a straight line? Six samples along the way, which is all a
            // person needs to see that the far bank is across water. Without it an agent sets off
            // toward somewhere it can plainly see it cannot reach, slides along the shore for thirty
            // seconds and gives up -- and half the abandoned journeys were exactly that.
            private method clearLine(float x0, float y0, int tx, int ty) returns boolean {
                float dx = cast<float>(tx) + 0.5 - x0;
                float dy = cast<float>(ty) + 0.5 - y0;
                mutable int k = 1;
                while (k <= 6) {
                    float f = cast<float>(k) / 7.0;
                    if (!this.walkable(cast<int>(x0 + dx * f), cast<int>(y0 + dy * f))) {
                        return false;
                    }
                    k = k + 1;
                }
                return true;
            }

            // Pick somewhere to go. For now that is a spot near where the agent already is, which is
            // not a placeholder: a community lives and works within a short walk of home, and that
            // is exactly what keeps travel affordable on a map thirty-two times the original's.
            // Journeys BETWEEN communities are a different verb and get the region graph with them.
            private method chooseTarget(int i) returns void {
                float here_x = this.folk.xAt(i);
                float here_y = this.folk.yAt(i);
                mutable int k = 0;
                while (k < 8) {
                    float a = LandMath.hash01(this.seed ^ 0x77E1, i * 31 + k, this.tick) * 6.2831853;
                    float d = 3.0 + LandMath.hash01(this.seed ^ 0x1C4B, i * 17 + k, this.tick) * 20.0;
                    int tx = cast<int>(here_x + LandMath.cos(a) * d);
                    int ty = cast<int>(here_y + LandMath.sin(a) * d);
                    if (this.walkable(tx, ty) && this.clearLine(here_x, here_y, tx, ty)) {
                        this.folk.setTarget(i, tx, ty);
                        this.folk.setAct(i, cast<int>(Act.Wander));
                        return;
                    }
                    k = k + 1;
                }
                // Nowhere to go from here: stand still rather than walk into the sea.
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // The budgeted half. Walk the queue from where it stopped, decide for those who are due,
            // and stop at the budget -- the queue keeps its place, so nobody is ever skipped, they
            // simply wait their turn.
            private method think() returns void {
                this.thoughtThisFrame = 0;
                int n = this.folk.limit();
                if (n == 0) {
                    return;
                }
                mutable int scanned = 0;
                while (scanned < n && this.thoughtThisFrame < this.budget) {
                    mutable int i = this.cursor;
                    this.cursor = this.cursor + 1;
                    if (this.cursor >= n) {
                        this.cursor = 0;
                    }
                    scanned = scanned + 1;
                    if (!this.folk.alive(i)) {
                        continue;
                    }
                    if (this.folk.thinkAtOf(i) > this.tick) {
                        continue;
                    }
                    // A grown person takes a trade their community has room and work for, and then
                    // goes and does it. Everybody being a woodcutter -- which is what the previous
                    // slice measured -- was the harshest possible test of travel, and it also took
                    // ninety-one per cent of the world's trees in one arc. What stops that is not a
                    // cap on cutting: it is that there are five other things worth doing.
                    if (this.folk.isAdult(i)) {
                        if (this.leaving(i)) {
                            this.folk.setThinkAt(i, this.tick + 5);
                            this.thoughtThisFrame = this.thoughtThisFrame + 1;
                            continue;               // gone; whatever they were is somebody else's
                        }
                        // Somebody sent over the horizon keeps walking until they get there.
                        //
                        // One order at the start was not enough: a colonist who found work on the
                        // way took it, stopped, and the party's centre never reached its ground --
                        // six hundred and eighty-one expeditions in eleven hundred and seventy-one
                        // turned back that way. While a place is still travelling, going there IS
                        // the work, and this re-issues the order every time they think.
                        int trek = this.folk.homeOf(i);
                        if (trek >= 0 && trek < this.ncomm && this.csettle[trek] > 0) {
                            float tx = this.ccx[trek] - this.folk.xAt(i);
                            float ty = this.ccy[trek] - this.folk.yAt(i);
                            if (tx * tx + ty * ty > cast<float>(Simulation.REIGN * Simulation.REIGN)) {
                                this.folk.setJob(i, cast<int>(Job.Idle));
                                this.folk.setTarget(i, cast<int>(this.ccx[trek]),
                                                    cast<int>(this.ccy[trek]));
                                this.folk.setAct(i, cast<int>(Act.WalkTo));
                                this.folk.setThinkAt(i, this.tick + 8);
                                this.thoughtThisFrame = this.thoughtThisFrame + 1;
                                continue;
                            }
                        }
                        // BEING LISTENED TO IS THE WORK. An elder or a priest standing among their
                        // own people is not between jobs, and asking this AFTER the trade has been
                        // picked never fired once -- by then they are always holding something, and
                        // `busy` refuses. It has to come first, and it has to displace the trade
                        // for that moment rather than wait for a gap that never comes.
                        int myRole = this.folk.roleOf(i);
                        boolean speaks = myRole == cast<int>(Role.Elder)
                                      || myRole == cast<int>(Role.Priest);
                        // A chief LEANS, it is the whole design of leadership here -- he works
                        // beside everybody and is heeded because of what he has done, not because
                        // of a title. So he leads a quarter as often as an elder teaches: often
                        // enough to be seen doing it, rarely enough that he is still one of them.
                        boolean leads = myRole == cast<int>(Role.Chief)
                                     || myRole == cast<int>(Role.General);
                        if ((speaks && (i + this.frames) % 24 == 0)
                            || (leads && (i + this.frames) % 96 == 0)) {
                            if (speaks) {
                                this.folk.setAct(i, cast<int>(Act.Teach));
                            } else {
                                this.folk.setAct(i, cast<int>(Act.Lead));
                            }
                            this.folk.setThinkAt(i, this.tick + 3);
                            this.thoughtThisFrame = this.thoughtThisFrame + 1;
                            i = i + 1;
                            continue;
                        }
                        if (this.folk.jobOf(i) == cast<int>(Job.Idle)) {
                            this.chooseJob(i);
                        }
                        int jb = this.folk.jobOf(i);
                        if (jb == cast<int>(Job.Raider)) {
                            this.workRaid(i);
                        } else if (jb == cast<int>(Job.Builder)) {
                            this.workBuild(i);
                        } else if (jb == cast<int>(Job.Hunter)) {
                            this.workHunt(i);
                        } else if (jb == cast<int>(Job.Prospector)) {
                            this.workProspect(i);
                        } else if (jb == cast<int>(Job.General)) {
                            this.workLead(i);
                        } else if (jb == cast<int>(Job.Trader)) {
                            this.workTrade(i);
                        } else if (this.craftOfJob(jb) != cast<int>(Craft.NoCraft)) {
                            this.workCraft(i);
                        } else {
                            this.workGather(i);
                        }
                        // A PERSON WALKING HOME UNDER A LOAD IS NOT A PERSON WALKING.
                        //
                        // Four trades carry things home -- the gatherer, the raider, the carter and
                        // the builder -- and every one of them said WalkTo, so nineteen million
                        // loads crossed this world and not one of them looked like a load. Promoted
                        // here rather than in four places, because it is one fact about anybody who
                        // is holding something, not four decisions.
                        if (this.folk.actOf(i) == cast<int>(Act.WalkTo)
                            && this.folk.carryAmtOf(i) > 0) {
                            this.folk.setAct(i, cast<int>(Act.Carry));
                        }
                        // And whoever a village follows is doing that, visibly, rather than standing
                        // in a field looking like everybody else. A chief still works -- that is
                        // the whole point of a chief in this world -- so this only takes the gaps.
                        if (!this.busy(i) && (i + this.frames) % 96 == 0
                            && (myRole == cast<int>(Role.Chief)
                             || myRole == cast<int>(Role.General))) {
                            this.folk.setAct(i, cast<int>(Act.Lead));
                        }
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Idle)) {
                        this.chooseTarget(i);
                    }
                    // Re-decide in two to four seconds, spread so a cohort born together does not
                    // come due on the same tick for the rest of their lives.
                    //
                    // Only if nothing above asked for longer. This used to be unconditional, which
                    // quietly cancelled every backing-off a decision made: somebody who had just
                    // learned there is no wood for miles and asked not to be woken for half a minute
                    // was woken two seconds later to learn it again.
                    if (this.folk.thinkAtOf(i) <= this.tick) {
                        int jitter = cast<int>(LandMath.hash01(this.seed ^ 0x3F09, i, this.tick) * 3.0);
                        this.folk.setThinkAt(i, this.tick + 2 + jitter);
                    }
                    this.thoughtThisFrame = this.thoughtThisFrame + 1;
                }
                if (this.thoughtThisFrame > this.worstThink) {
                    this.worstThink = this.thoughtThisFrame;
                }
                this.thoughtTotal = this.thoughtTotal + cast<long>(this.thoughtThisFrame);
                return;
            }

            private method nearby(int x, int y) returns boolean {
                return x >= this.nearX0 && y >= this.nearY0 && x < this.nearX1 && y < this.nearY1;
            }

            // A load comes off the tree, and the tree really loses it. `harvest` returns what was
            // actually there, which is how a resource that runs out differs from one that only says
            // it does -- the last cutter at a nearly-empty tree gets whatever is left and no more.
            private method chop(int i) returns void {
                NodeField* nf = this.g.surface();
                int t = this.folk.targetNodeOf(i);
                if (t < 0) {
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    return;
                }
                // What comes off it is decided by the NODE and not by the worker: the table in
                // docs/ECONOMY.md section 1 says an oak gives Wood and a salt deposit gives Salt,
                // and reading it here is what stops the trades and the world drifting apart.
                int hc = this.harvestOf(this.folk.jobOf(i));
                int good = Nodes.gives(nf.kindAt(t));
                int got = nf.harvest(t, this.loadFor(hc));
                if (got <= 0) {
                    this.folk.setTargetNode(i, 0 - 1);
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    return;
                }
                if (nf.qtyAt(t) <= 0) {
                    this.felled = this.felled + 1;               // that one is gone for good
                    this.folk.setTargetNode(i, 0 - 1);
                }
                // The tool takes a load's worth of wear. A tool that never wore out would be a
                // one-off gift, and the whole reason iron is worth smelting is that a village has
                // to keep replacing them.
                if (this.folk.wearTool(i)) {
                    this.wornOut = this.wornOut + 1;
                }
                this.folk.setCarry(i, good, got);
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // The unbudgeted half. Everyone advances at the same speed, so travel time is honest
            // everywhere; only the people on screen pay for testing the ground and turning to face.
            private method move(float dt) returns void {
                float stride = Simulation.SPEED * dt;
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (!this.folk.alive(i)) {
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Gather)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        mutable float takes = this.workTime(this.harvestOf(this.folk.jobOf(i)));
                        if (this.folk.hasKit(i, AgentTable.K_TOOL)) {
                            takes = takes * Simulation.TOOLED;
                        }
                        if (this.folk.timerOf(i) >= takes) {
                            this.chop(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Hunt)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        if (this.folk.timerOf(i) >= Simulation.STALK) {
                            this.killDone(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Fight)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        if (this.folk.timerOf(i) >= Simulation.MELEE) {
                            this.blowLanded(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    // Refining, tilling and copying out a page are ONE piece of arithmetic and three
                    // things to watch. They are listed together here rather than folded into one
                    // act, because the day somebody adds a fourth the compiler should make them
                    // come and look at this line -- and because splitting them without touching
                    // this loop would have quietly left every farmer standing in a field waiting
                    // for a batch that could never finish.
                    int busyAt = this.folk.actOf(i);
                    if (busyAt == cast<int>(Act.Refine) || busyAt == cast<int>(Act.Till)
                        || busyAt == cast<int>(Act.Discover)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        int wp = this.folk.workplaceOf(i);
                        if (wp >= 0 && this.folk.timerOf(i) >= Builds.secs(this.town.kindOf(wp))) {
                            this.batchDone(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Build)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        int wp = this.folk.workplaceOf(i);
                        if (wp < 0 || this.town.isWorking(wp)) {
                            this.folk.setAct(i, cast<int>(Act.Idle));
                            i = i + 1;
                            continue;
                        }
                        if (this.town.raise(wp, dt)) {
                            int k = this.town.kindOf(wp);
                            int own = this.town.ownerOf(wp);
                            this.stores.take(own, cast<int>(Good.Wood), Builds.woodCost(k));
                            this.stores.take(own, cast<int>(Good.Stone), Builds.stoneCost(k));
                            if (Builds.matCost(k) != cast<int>(Good.Nothing)) {
                                this.stores.take(own, Builds.matCost(k), Builds.matCostN(k));
                            }
                            this.raised = this.raised + 1;
                            if (this.cbusy[own] == wp) {
                                // It is finished, so the village is free to decide again -- without
                                // this it stays "busy" until the next census and every builder in
                                // the place spends a second walking to a building that is done.
                                this.cbusy[own] = 0 - 1;
                            }
                            // Raising a building is the biggest single thing anybody does alone.
                            this.folk.earn(i, 12);
                            this.folk.setAct(i, cast<int>(Act.Idle));
                            this.folk.setJob(i, cast<int>(Job.Idle));
                            this.folk.setWorkplace(i, 0 - 1);
                        }
                        i = i + 1;
                        continue;
                    }
                    // THE SHORT ACTS: a mouthful, a sit-down, a word with somebody, a load set on a
                    // shelf. Each is a second or two and then the person is free again.
                    //
                    // They must expire HERE and not by anybody deciding, because `busy` treats
                    // every act but Idle and Wander as work in progress -- somebody who sat down to
                    // eat and had nothing to clear it would sit there for the rest of their life,
                    // and the world would starve to death looking peaceful.
                    int paused = this.folk.actOf(i);
                    if (paused == cast<int>(Act.Eat) || paused == cast<int>(Act.Rest)
                        || paused == cast<int>(Act.Court) || paused == cast<int>(Act.Raise)
                        || paused == cast<int>(Act.Follow) || paused == cast<int>(Act.Lead)
                        || paused == cast<int>(Act.Teach) || paused == cast<int>(Act.Deposit)) {
                        this.folk.addTimer(i, dt);
                        if (this.folk.timerOf(i) >= Simulation.PAUSE) {
                            this.folk.setAct(i, cast<int>(Act.Idle));
                        }
                        i = i + 1;
                        continue;
                    }
                    boolean wandering = this.folk.actOf(i) == cast<int>(Act.Wander);
                    // FOUR WAYS OF WALKING, and the difference between them is the whole of what
                    // the renderer and the detail window have to go on. Marching is an army crossing
                    // the country; carrying is somebody bent under a load on the way home; fleeing
                    // is somebody leaving a place that could not feed them. Underneath they are the
                    // same arithmetic, which is why they share this loop -- but a world where all
                    // four look identical is a world where nothing anybody does can be read.
                    int doing = this.folk.actOf(i);
                    boolean marching = doing == cast<int>(Act.March);
                    boolean hauling = doing == cast<int>(Act.Carry);
                    boolean fleeing = doing == cast<int>(Act.Flee);
                    if (doing != cast<int>(Act.WalkTo) && !wandering && !marching
                        && !hauling && !fleeing) {
                        i = i + 1;
                        continue;
                    }
                    if (wandering) {
                        this.wanderTicks = this.wanderTicks + 1;
                    } else {
                        this.walkTicks = this.walkTicks + 1;
                    }
                    float x = this.folk.xAt(i);
                    float y = this.folk.yAt(i);
                    // The ground decides the pace and the feet wear the ground. Both here, in the
                    // same two lines, because both want the same cell and this is the hottest loop
                    // in the simulation -- a second lookup somewhere tidier would cost more than
                    // everything else this slice adds put together.
                    //
                    // Only a journey WITH A PURPOSE wears a path. Somebody ambling in circles
                    // treads just as hard, but they tread everywhere, so folding wandering in
                    // would raise the whole map's baseline instead of drawing the lines people
                    // actually take -- and lines people actually take is the entire idea.
                    int onX = cast<int>(x);
                    int onY = cast<int>(y);
                    float span = stride * Ways.paceOn(this.paths.surfaceAt(onX, onY));
                    float tx = cast<float>(this.folk.targetXOf(i)) + 0.5;
                    float ty = cast<float>(this.folk.targetYOf(i)) + 0.5;
                    float dx = tx - x;
                    float dy = ty - y;
                    // Squared distance for the arrival test: there is no reason to take a root just
                    // to compare against a constant, and this runs fifty thousand times a frame.
                    float d2 = dx * dx + dy * dy;
                    if (d2 < 0.2025) {
                        this.folk.setAct(i, cast<int>(Act.Idle));
                        this.arrivals = this.arrivals + 1;
                        i = i + 1;
                        continue;
                    }
                    // Math.sqrt is one machine instruction. LandMath.sqrt -- which the worldgen and
                    // the renderer both use -- is a sixteen-iteration Newton loop, sixteen DIVISIONS
                    // per call, and at fifty thousand calls a frame that is the whole cost of moving.
                    float dist = cast<float>(Math.sqrt(cast<double>(d2)));
                    // `setAct` zeroes the timer, so a timer still at zero means this is the first
                    // step of the walk and the distance in hand is the whole journey.
                    if (this.folk.timerOf(i) == 0.0) {
                        this.folk.setJourney(i, dist);
                    }
                    this.folk.addTimer(i, dt);
                    // Patience is measured against the length of THIS journey, three times what it
                    // ought to take plus a few seconds of slack for going round things. A flat
                    // half-minute -- what this was -- called every walk longer than thirty-seven
                    // cells a failure, so the moment people started going to woodland forty-eight
                    // cells off, one journey in six was reported as broken routing when the only
                    // thing broken was the stopwatch.
                    if (this.folk.timerOf(i) > 5.0 + 3.0 * this.folk.journeyOf(i) / Simulation.SPEED) {
                        this.stuckTotal = this.stuckTotal + 1;
                        this.folk.setAct(i, cast<int>(Act.Idle));
                        i = i + 1;
                        continue;
                    }
                    float ux = dx / dist;
                    float uy = dy / dist;
                    mutable float nx = x + ux * span;
                    mutable float ny = y + uy * span;
                    int cx = cast<int>(x);
                    int cy = cast<int>(y);
                    // THE GROUND TEST IS NOT OPTIONAL, at any level of detail. It was, and a sweep
                    // found three hundred and ninety-four people standing in the sea and on bare
                    // cliffs -- while `stuck` read zero, because somebody who walks THROUGH a cliff
                    // never gets stuck and never complains. Ending up somewhere you could never be
                    // is an outcome, and the rule only ever allowed faking what is not one.
                    //
                    // Sliding is not optional either, and that was a second mistake on the same
                    // axis: whether you slide along a rock or stop dead at it decides whether you
                    // ARRIVE, and arriving is an outcome. Restricting it to the near tier left
                    // three thousand journeys a minute abandoned off screen and none on it.
                    //
                    // What a level of detail may actually skip is turning to face the way you walk,
                    // which nobody can see from outside the window and which changes nothing.
                    if (!this.walkable(cast<int>(nx), cast<int>(ny))) {
                        if (this.walkable(cast<int>(nx), cy)) {
                            ny = y;
                        } else if (this.walkable(cx, cast<int>(ny))) {
                            nx = x;
                        } else {
                            nx = x;
                            ny = y;
                        }
                    }
                    if (this.nearby(cx, cy)) {
                        mutable int d = 0;
                        if (ux >= 0.0 && uy >= 0.0) {
                            d = 1;
                        } else if (ux >= 0.0) {
                            d = 2;
                        } else if (uy >= 0.0) {
                            d = 0;
                        } else {
                            d = 3;
                        }
                        this.folk.setDir(i, d);
                    }
                    this.folk.setPos(i, nx, ny);
                    // A CROSSING wears the ground, not a tick of standing on it.
                    //
                    // Counted per tick instead, which is what this did first, a person walking a
                    // cell and a quarter a second deposits about sixteen marks in every cell they
                    // pass through -- so the whole thing outran the fade twelve to one and an arc
                    // ended with six hundred and ninety-one thousand cells of ROAD against a
                    // hundred and seventy-three thousand of trail. More road than path, and a
                    // fifth of the world paved in mud: the brown smear the fade exists to prevent,
                    // arrived by the front door. The thresholds were always meant to count
                    // crossings; now they do.
                    if (!wandering) {
                        int toX = cast<int>(nx);
                        int toY = cast<int>(ny);
                        if (toX != onX || toY != onY) {
                            this.paths.walked(toX, toY);
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            // Everything that happens to a body whether it wants it or not. This runs for EVERYBODY
            // every step and is not on the think budget: ageing and hunger are not decisions, and
            // somebody off screen must age at exactly the rate of somebody on it or it stops being
            // one world. It is a handful of byte updates a head, cheaper than deciding to skip them.
            public static float ADULT_AT = 60.0;
            public static float HUNGER_EVERY = 7.0;      // one point of hunger per this many seconds
            // Both of these were set against a scale that does not exist. Hunger killed at a hundred
            // points and a life is three hundred and sixty seconds, so at a point every seven the
            // most anyone ever reached was fifty-one: NOBODY COULD STARVE, and the starvation counter
            // read zero for the honest reason that the mechanism was unreachable. Eating started at
            // thirty, which is two hundred and ten seconds -- most of a life -- so a person ate about
            // once before dying of old age and the larders filled up with food nobody wanted.
            //
            // Against a six-minute life: peckish after thirty-five seconds, dead after a hundred and
            // seventy-five without anything at all. That is about ten meals in a life, which is what
            // makes food a constraint instead of decoration.
            public static int HUNGRY_AT = 5;
            public static int STARVE_AT = 25;
            // Sickness, read against the same six-minute life -- and CALIBRATED, because the first
            // guess reproduced a defect this file has already fixed once.
            //
            // Hunger used to kill at a hundred points while the most anybody could reach in a life
            // was fifty-one, so NOBODY COULD STARVE and the counter read zero for the honest reason
            // that the mechanism was unreachable. The first version of this made the same mistake in
            // the same shape: a measured arc had FIVE HUNDRED AND FORTY-FIVE THOUSAND people take
            // ill and exactly ONE die of it, because at one chance in ten across forty checks the
            // mean was four points against a threshold of twelve. An illness nobody dies of is a
            // texture, and this world already has enough of those.
            //
            // Checked every nine seconds, so about forty chances in a life. A fully filthy town --
            // nobody under a roof, nobody in reach of clean water -- reads two thousand and now
            // gives one chance in four, which is a mean of ten against a threshold of twelve: the
            // unlucky half of that town dies of where it lives. A merely crowded one reads five
            // hundred, a mean of two and a half, and is a place where illness is bad luck. A town
            // with room and clean water reads nought and nobody in it is ever ill at all.
            public static float ILL_EVERY = 9.0;
            public static float CATCH_IT = 0.000125;  // per point of filth, per check
            public static int SICKEN_AT = 12;
            // How long a short act holds somebody.
            //
            // MEASURED, because the first guess was not free. At two seconds against a six-minute
            // life, ten meals a life is five and a half per cent of everybody's waking time -- and
            // the two-generation arc lost its walls, which had been standing the run before. A
            // visible act is not allowed to quietly cost the world a twentieth of its labour.
            //
            // One second is twenty frames at the arc's step, which is plainly visible at every zoom
            // the renderer offers, and half the bill.
            public static float PAUSE = 1.0;
            // Tiredness rises by one every TIRED_EVERY, so this is a number of MINUTES on your feet
            // and has to be read against a six-minute life. Twenty is about four minutes.
            public static int WEARY_AT = 20;
            public static float TIRED_EVERY = 12.0;
            public static float TERM = 45.0;             // a pregnancy
            public static float FERTILE_TO = 0.85;       // of a lifespan
            // What a full larder means, in units of food per head. Reach it and a community is as
            // fertile as it gets; hold half of it and the birth rate halves with it.
            //
            // This replaces CARRY, a fixed number of people that stood in for how much food there
            // was. The design said from the start that both it and FERTILITY "stand in for the real
            // limit -- how much food there is -- and are replaced by it, not tuned around it, when
            // the economy arrives". It has arrived: a community's ceiling is now something it can
            // raise by working well and lose by stripping the land around it.
            public static int LARDER = 8;
            public static float FERTILITY = 0.045;       // chance per SECOND with a full larder

            private method live(float dt) returns void {
                float t = this.clock;
                boolean hungrier = cast<int>(t / Simulation.HUNGER_EVERY) > cast<int>((t - dt) / Simulation.HUNGER_EVERY);
                boolean wearier = cast<int>(t / Simulation.TIRED_EVERY) > cast<int>((t - dt) / Simulation.TIRED_EVERY);
                boolean sickening = cast<int>(t / Simulation.ILL_EVERY) > cast<int>((t - dt) / Simulation.ILL_EVERY);
                int now = this.season();
                if (now < this.leanest) {
                    this.leanest = now;
                }
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (!this.folk.alive(i)) {
                        i = i + 1;
                        continue;
                    }
                    this.folk.addAge(i, dt);
                    if (this.folk.ageOf(i) >= this.folk.lifespanOf(i)) {
                        this.vacate(i, this.folk.homeOf(i));
                        this.folk.kill(i);
                        this.deathsOld = this.deathsOld + 1;
                        i = i + 1;
                        continue;
                    }
                    if (!this.folk.isAdult(i) && this.folk.ageOf(i) >= Simulation.ADULT_AT) {
                        this.folk.makeAdult(i);
                    }
                    // Needs are whole points in a byte, so they are only touched on the step where a
                    // whole point has actually accrued. Rounding a fraction up every frame would
                    // starve the world in seconds.
                    if (hungrier) {
                        this.folk.setHunger(i, this.folk.hungerOf(i) + 1);
                    }
                    if (wearier) {
                        this.folk.setTired(i, this.folk.tiredOf(i) + 1);
                    }
                    if (this.folk.hungerOf(i) >= Simulation.STARVE_AT) {
                        this.vacate(i, this.folk.homeOf(i));
                        this.folk.kill(i);
                        this.deathsHunger = this.deathsHunger + 1;
                        i = i + 1;
                        continue;
                    }
                    // SICKNESS, WHICH IS THE ONE THING HERE THAT COMES FROM OUTSIDE.
                    //
                    // Hunger and tiredness are the body's own clocks and everybody has them. This
                    // one is a fact about the PLACE: how crowded it is and whether anybody cleaned
                    // the water. So a person doing everything right still falls ill if their town is
                    // a bad town to live in, and that is the whole difference between a need and a
                    // condition.
                    //
                    // On the same whole-point cadence as hunger, and drawn on the frame counter so
                    // all twenty steps inside a second do not get handed the same number.
                    if (sickening) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm) {
                            int filth = this.cfilth[h];
                            if (filth > 0
                                && LandMath.hash01(this.seed ^ 0x51CC, i, this.frames)
                                   < cast<float>(filth) * Simulation.CATCH_IT) {
                                this.folk.setIll(i, this.folk.illOf(i) + 1);
                                this.fellIll = this.fellIll + 1;
                            }
                            // And the town nurses whoever it has room to nurse. A bathhouse is not
                            // medicine, but a place that washes is a place fewer people die in.
                            if (this.folk.illOf(i) > 0 && this.ccare[h] >= this.cpop[h]) {
                                this.folk.setIll(i, this.folk.illOf(i) - 2);
                            }
                        }
                    }
                    if (this.folk.illOf(i) >= Simulation.SICKEN_AT) {
                        this.vacate(i, this.folk.homeOf(i));
                        this.folk.kill(i);
                        this.deathsIll = this.deathsIll + 1;
                        i = i + 1;
                        continue;
                    }
                    // Food was free until this slice, and CARRY stood in for it. It is real now:
                    // eating takes something edible out of the community's store, and if the store
                    // is empty the hunger stays and eventually kills. This is the whole reason the
                    // forager and the fisherman exist, and the reason a place that quarries
                    // beautifully and grows nothing does not last.
                    if (this.folk.hungerOf(i) >= Simulation.HUNGRY_AT) {
                        int hh = this.folk.homeOf(i);
                        int ate = this.stores.eat(hh, 1);
                        if (ate > 0) {
                            this.meals = this.meals + cast<long>(ate);
                            this.folk.setHunger(i, 0);
                            // AND THEY STOP TO DO IT.
                            //
                            // Nine and a half million meals were eaten over an arc and not one of
                            // them was ever a thing anybody could see: hunger went to zero between
                            // two frames and the person carried on walking. An act that nothing ever
                            // sets is an act the renderer can never draw, which is why this world
                            // had people who worked and fought and never once sat down.
                            //
                            // Only if they are not in the middle of something that matters more.
                            // Nobody stops to eat while a spear is coming at them.
                            if (!this.busy(i)) {
                                this.folk.setAct(i, cast<int>(Act.Eat));
                            }
                        } else {
                            this.hungryTicks = this.hungryTicks + 1;
                        }
                    }
                    // WEARINESS DID NOTHING AT ALL, and the arithmetic says so plainly: tiredness
                    // rises by one every twelve seconds and a life is three hundred and sixty, so
                    // the most anybody could ever reach was thirty and the threshold was SEVENTY.
                    // Not one person in the history of this world has ever been tired enough to
                    // rest. The number was never measured against the life it applies to.
                    //
                    // Twenty: about four minutes on your feet, so a person sits down two or three
                    // times in a life. That is a rhythm you can watch rather than a constant that
                    // happens to be unreachable.
                    if (this.folk.tiredOf(i) >= Simulation.WEARY_AT) {
                        this.folk.setTired(i, 0);
                        if (!this.busy(i)) {
                            this.folk.setAct(i, cast<int>(Act.Rest));
                        }
                    }
                    if (this.folk.gestate(i, dt)) {
                        int child = this.folk.bear(i, this.seed, cast<int>(this.births));
                        if (child >= 0) {
                            this.births = this.births + 1;
                            int hb = this.folk.homeOf(child);
                            if (hb >= 0 && hb < this.ncomm) {
                                this.folk.steepIn(child,
                                                  this.cultureOf(hb, Simulation.C_BOLD),
                                                  this.cultureOf(hb, Simulation.C_SOCIAL),
                                                  this.cultureOf(hb, Simulation.C_GREED),
                                                  this.cultureOf(hb, Simulation.C_CURIOUS),
                                                  this.cultureOf(hb, Simulation.C_AMBITION),
                                                  Simulation.STEEP);
                            }
                        }
                    }
                    // Conceiving belongs HERE and not among the decisions. It used to ride on the
                    // think queue, which quietly tied the birth rate to how often somebody happened
                    // to be wondering about firewood: the moment a woodcutter with no wood in reach
                    // learned to stop asking every two seconds, the women of that community stopped
                    // conceiving with them, and the world fell from forty-nine thousand to seven.
                    // A body is not on a budget.
                    // Once a SECOND, not twenty times a second, and spread so the world does not
                    // check everybody on the same tick. The odds are two in a thousand per tick;
                    // rolling that twenty times and rolling it once at twenty times the chance are
                    // the same population and one twentieth of the arithmetic -- and the profile
                    // said this loop was twenty-nine per cent of the whole clock.
                    if ((i + this.frames) % 20 == 0) {
                        if (this.mayConceive(i, dt * 20.0)) {
                            this.folk.conceive(i, Simulation.TERM);
                            if (!this.busy(i)) {
                                this.folk.setAct(i, cast<int>(Act.Court));
                            }
                        }
                    }
                    // And a parent with a small child is doing something, even if what they are
                    // doing is the least visible work in the world. A million children were born
                    // over an arc and nobody was ever seen with one.
                    if (this.folk.isPregnant(i) && !this.busy(i)
                        && (i + this.frames) % 64 == 0) {
                        this.folk.setAct(i, cast<int>(Act.Raise));
                    }
                    i = i + 1;
                }
                return;
            }

            private method census() returns void {
                int nh = Harvest.count();
                int nj = Job.count();
                this.town.clearHands();
                mutable int c = 0;
                while (c < this.ncomm) {
                    this.cpop[c] = 0;
                    this.cadults[c] = 0;
                    this.cmales[c] = 0;
                    this.ccx[c] = 0.0;
                    this.ccy[c] = 0.0;
                    for (int jb in 0..nj) {
                        this.ctrade[c * nj + jb] = 0;
                    }
                    c = c + 1;
                }
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm) {
                            this.cpop[h] = this.cpop[h] + 1;
                            this.ccx[h] = this.ccx[h] + this.folk.xAt(i);
                            this.ccy[h] = this.ccy[h] + this.folk.yAt(i);
                            if (this.folk.isAdult(i)) {
                                this.cadults[h] = this.cadults[h] + 1;
                                if (!this.folk.isFemale(i)) {
                                    this.cmales[h] = this.cmales[h] + 1;
                                }
                                // Who is already doing what, and who is standing in which workshop.
                                // Counted from the people themselves and never incrementally, so a
                                // death or a change of trade can never leave a phantom worker
                                // holding a place in a quota or a bench in a forge.
                                int jb = this.folk.jobOf(i);
                                this.ctrade[h * nj + jb] = this.ctrade[h * nj + jb] + 1;
                                int wp = this.folk.workplaceOf(i);
                                if (wp >= 0) {
                                    this.town.addHand(wp);
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
                // Everything the table has to say about every community, in one read of each row.
                // It has to come after the hands are counted and before anybody decides anything.
                this.town.sweep(this.cpop, this.croom, this.cworst, this.cworstRoom, this.cdead,
                                this.cbusy, this.copen, this.cmade, this.cowns, this.cseat,
                                this.ncomm, Craft.count(), Goods.count(),
                                cast<int>(BuildingKind.TownHall));
                // And what those buildings are waiting for. Read here, before anybody decides what
                // to build next, because what a place should build is what it is short of.
                this.town.wants(this.cwant, this.cfed, this.ncomm, Goods.count());
                this.explode();
                this.town.learning(this.clesson, this.ncomm);
                // Where a community IS, taken as where its people are. Nobody planted a flag: the
                // centre is the average of everybody standing there, so it drifts as they do -- and
                // when a place empties out, it stops existing rather than leaving a marker behind.
                c = 0;
                while (c < this.ncomm) {
                    if (this.cpop[c] > 0) {
                        mutable float mx = this.ccx[c] / cast<float>(this.cpop[c]);
                        mutable float my = this.ccy[c] / cast<float>(this.cpop[c]);
                        // A colony on the road is WHERE IT IS GOING, not where its people have got
                        // to. Without that the centre is the mean of a party that has not left yet,
                        // so the place searches for work back at the capital, everybody stays put,
                        // and a founding expedition is a renaming that never travels.
                        if (this.csettle[c] > 0) {
                            float ax = mx - this.csiteX[c];
                            float ay = my - this.csiteY[c];
                            float span = cast<float>(Simulation.REIGN * Simulation.REIGN);
                            if (ax * ax + ay * ay <= span) {
                                this.csettle[c] = 0;      // arrived: an ordinary place from here on
                                this.planted = this.planted + 1;
                            } else {
                                this.csettle[c] = this.csettle[c] - 1;
                                if (this.csettle[c] <= 0) {
                                    // The expedition failed. They go back to whoever sent them,
                                    // rather than becoming a village standing wherever they gave up
                                    // -- which was always within a walk of the capital, so it merged
                                    // straight back in and the whole thing read as churn: nine
                                    // hundred and ninety-six colonies planted against a thousand
                                    // and forty-one places merged, in one arc.
                                    this.abandon(c);
                                    c = c + 1;
                                    continue;
                                }
                                mx = this.csiteX[c];
                                my = this.csiteY[c];
                            }
                        }
                        this.ccx[c] = mx;
                        this.ccy[c] = my;
                        // And where its work is, of every kind. The wide search happens HERE, once
                        // for the whole place, instead of once per person per decision -- which was
                        // eighteen million failed searches in two hours of world time, each sweeping
                        // six thousand cells, and four fifths of the running time.
                        for (int hc in 1..Harvest.count()) {
                            this.findWork(c, hc);
                        }
                        this.findGround(c);
                        this.considerBuilding(c);
                        this.befall(c);
                    } else {
                        for (int hc in 0..Harvest.count()) {
                            this.cworkX[c * Harvest.count() + hc] = 0 - 1;
                        }
                    }
                    c = c + 1;
                }
                this.restake();
                this.hearWho();
                this.steep();
                this.discover();
                this.hive();
                this.absorb();
                // After the two accidental ways the map changes -- a village smearing itself in two
                // and two villages growing into one -- comes the deliberate one.
                this.colonise();
                // And only THEN are the nations read, because only now is it settled which towns
                // exist and who they answer to.
                //
                // This ran before all three at first, which is a day out of step: hiving adds a
                // town, absorbing takes one and changes whose it is, colonising adds another, and
                // every one of them happens after the count. The result was a nation whose holdings
                // disagreed with the towns actually pointing at it -- caught by the invariant that
                // says the two must be the same number, which is exactly what that test is for.
                //
                // Everything downstream now reads a nation as it stood a second ago. That is not a
                // compromise: the census is a second old by the time anybody acts on it anyway, and
                // being consistently one second old beats being right about some fields and wrong
                // about others.
                this.realmCensus();
                // A route runs between two towns of ONE country, so it cannot be worked out before
                // it is settled which towns exist and who they answer to -- the same reason the
                // nations themselves are read after hiving, absorbing and colonising.
                this.caravanRoutes();
                this.railway();
                // And then the wars, which need the nations settled to know who is whose.
                this.campaign();
                this.wayOut();
                this.quarrel();
                return;
            }

            // Who a community is at war with, or -1.
            //
            // The cause is never a die roll. It is the SAME signal that drives migration -- we are
            // hungry and there is a fatter place within reach -- and what a village does about it is
            // decided by what the village IS. A bold and greedy place takes; anybody else walks.
            // That is the whole point of the culture slice finally paying for itself: two villages
            // on identical ground, one starving beside the other's granary, do different things, and
            // the difference is a hundred and twenty seconds of their own history.
            //
            // The second cause is being raided, and it is the one that makes violence last. A place
            // that was hit hits back, whatever its temperament, and it goes on hitting back while it
            // remembers -- which is how a quarrel over one bad winter becomes a feud that outlives
            // everybody who started it.
            private method quarrel() returns void {
                for (int c in 0..this.ncomm) {
                    if (this.craided[c] > 0) {
                        this.craided[c] = this.craided[c] - 1;
                    }
                    if (this.cpop[c] <= 0) {
                        this.cfoe[c] = 0 - 1;
                        this.craided[c] = 0;
                        this.craider[c] = 0 - 1;
                        continue;
                    }
                    // A feud outranks a want. You do not go looking for somebody else's granary
                    // while somebody is at your own door, and no temperament is consulted -- a
                    // gentle village that has been raided raids back, which is the whole reason
                    // violence in this world outlives the hunger that started it.
                    int back = this.craider[c];
                    if (this.craided[c] > 0 && back >= 0 && this.cpop[back] > 0) {
                        this.cfoe[c] = back;
                        this.feuds = this.feuds + 1;
                        continue;
                    }
                    int want = this.cflee[c];
                    if (want < 0) {
                        this.cfoe[c] = 0 - 1;
                        continue;
                    }
                    int nerve = this.cultureOf(c, Simulation.C_BOLD)
                              + this.cultureOf(c, Simulation.C_GREED);
                    if (nerve < Simulation.WARLIKE) {
                        this.cfoe[c] = 0 - 1;    // they will go hungry, or they will leave
                        continue;
                    }
                    this.cfoe[c] = want;
                    this.feuds = this.feuds + 1;
                }
                return;
            }

            // Boldness plus greed at which a starving village takes instead of leaving. Both axes
            // are a share of the trades in per cent, so this is "more than a fifth of everybody is
            // out hunting or digging" -- a place whose living is already got by force or by tearing
            // it out of the ground. Every place begins at fifty on every axis and drifts from what
            // its people actually do, so nothing here is decided at world generation.
            public static int WARLIKE = 40;

            // How much bigger a neighbour has to be before a people simply becomes part of it.
            //
            // Twice over. Within one nation, two towns that touch are one town and no threshold is
            // asked for -- they already answer to the same seat. Across a border it is a people
            // losing its name, and that does not happen because a neighbour is one head larger; it
            // happens when the neighbour is so much the bigger place that its market, its language
            // and its chief are simply where life is. Anything gentler and the first census would
            // dissolve every small nation into whichever big one it happened to be standing next to.
            public static int ASSIMILATE = 2;

            // Two places that have grown into each other are one place.
            //
            // This is the half that was missing, and its absence was not a detail -- it was the
            // reason the world could only ever get more fragmented. Splitting adds communities and
            // nothing but total extinction ever took one away, so every run ended with every
            // community number in the world used up and an average country of thirteen blocks, no
            // matter how the split rule was tightened. Three attempts were spent tightening it.
            //
            // The test is the split's read the other way -- but at HALF the distance, and that gap
            // is the whole difference between a world and a machine that hums. With both thresholds
            // at REIGN, a daughter would drift back inside its mother's reach, merge, outgrow it and
            // split again: ten thousand foundings and ten thousand joinings in one arc, every one of
            // them wiping the trades of everybody involved. A place has to travel to leave and stay
            // gone, so leaving is measured at a working day and returning at half of one.
            //
            // The smaller joins the larger and brings everything it built, which is how a town comes
            // to have two sawmills and a hundred and forty houses -- and therefore how the upper
            // rungs of the housing catalogue ever get used at all.
            private method absorb() returns void {
                for (int c in 0..this.ncomm) {
                    this.cjoin[c] = 0 - 1;
                }
                for (int a in 0..this.ncomm) {
                    // A party still walking to its ground is not a place yet, and neither end of a
                    // merger may be one: its centre is where it is GOING, so the distance test
                    // would be measuring against somewhere nobody is standing.
                    if (this.cpop[a] <= 0 || this.csettle[a] > 0) {
                        continue;
                    }
                    mutable int into = 0 - 1;
                    mutable int biggest = this.cpop[a];
                    for (int b in 0..this.ncomm) {
                        if (b == a || this.cpop[b] <= biggest || this.csettle[b] > 0) {
                            continue;                // only ever join something bigger, so no cycles
                        }
                        float dx = this.ccx[b] - this.ccx[a];
                        float dy = this.ccy[b] - this.ccy[a];
                        int near = Simulation.REIGN / 2;
                        if (dx * dx + dy * dy > cast<float>(near * near)) {
                            continue;
                        }
                        // Two towns of ONE nation that have grown into each other are one town, and
                        // that is all it takes. Two towns of DIFFERENT nations touching is a border,
                        // and a border is not a merger: a people is only absorbed by a neighbour
                        // that plainly dwarfs it, and never by one it is at war with.
                        //
                        // Before nations existed this test did not exist either, so every place in
                        // the world merged into every bigger place it touched -- which is why the
                        // map had no countries on it, only a hundred and forty villages that had all
                        // forgotten who they were related to.
                        if (this.cnat[b] != this.cnat[a]) {
                            if (this.cpop[b] < this.cpop[a] * Simulation.ASSIMILATE) {
                                continue;
                            }
                            if (this.cfoe[a] == b || this.cfoe[b] == a || this.craided[a] > 0) {
                                continue;
                            }
                        }
                        biggest = this.cpop[b];
                        into = b;
                    }
                    this.cjoin[a] = into;
                }
                // One hop only. A joins B and B joins C in the same census would leave A's people
                // pointing at a number nobody lives in; C is bigger than B is bigger than A, so
                // letting A wait a second and follow B into C next time is both simpler and true.
                for (int a in 0..this.ncomm) {
                    if (this.cjoin[a] >= 0 && this.cjoin[this.cjoin[a]] >= 0) {
                        this.cjoin[a] = 0 - 1;
                    }
                }
                mutable boolean any = false;
                for (int a in 0..this.ncomm) {
                    int into = this.cjoin[a];
                    if (into < 0) {
                        continue;
                    }
                    any = true;
                    for (int g in 1..Goods.count()) {
                        this.stores.add(into, g, this.stores.amountOf(a, g));
                    }
                    this.stores.clear(a);
                    this.town.reown(a, into, cast<int>(BuildingKind.TownHall));
                    // A town crossing a border takes its people's knowledge with it, and the nation
                    // that gains it can now say it rules somebody it did not raise -- which is the
                    // whole of what makes an empire an empire. Knowledge joins up; it is not
                    // averaged and it is not lost.
                    int mine = this.cnat[a];
                    int theirs = this.cnat[into];
                    if (mine != theirs) {
                        this.realm.annex(theirs, mine);
                        this.annexed = this.annexed + 1;
                        if (this.realm.townsOf(mine) <= 1) {
                            this.extinct = this.extinct + 1;
                        }
                    }
                    this.cnat[a] = theirs;
                    this.joined = this.joined + 1;
                    this.joinedFolk = this.joinedFolk + cast<long>(this.cpop[a]);
                    this.cpop[into] = this.cpop[into] + this.cpop[a];
                    this.cpop[a] = 0;
                    this.chief[a] = 0 - 1;
                }
                if (!any) {
                    return;
                }
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm && this.cjoin[h] >= 0) {
                            this.vacate(i, h);
                            this.folk.setHome(i, this.cjoin[h]);
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            // Does any place hold together, and if not, where does the far end of it go?
            //
            // A community is a single number for everybody who belongs to it -- one store, one
            // chief, one set of workshops -- and that is only honest while the people can all get to
            // it. Once a village has smeared itself across more ground than a working day covers,
            // the far end is not the edge of that village any more; it is somewhere else that has
            // not admitted it yet, sharing a granary it cannot walk to.
            //
            // So the far end is given its own number. Nobody marches anywhere: the split is a
            // RENAMING of people who had already drifted out there, which is how an outlying cluster
            // becomes its own place in fact long before it becomes one in name.
            // Three passes over the people for the whole world, not one per community: the same rule
            // this codebase keeps having to relearn, and the reason a split costs a hundred and fifty
            // thousand reads a second instead of twelve million.
            private method hive() returns void {
                int n = this.folk.limit();
                for (int c in 0..this.ncomm) {
                    this.cfar[c] = 0 - 1;
                    this.cfarD[c] = cast<float>(Simulation.REIGN * Simulation.REIGN);
                    this.cparty[c] = 0;
                    this.cchild[c] = 0 - 1;
                    if (this.cpop[c] < Simulation.VILLAGE) {
                        this.cfarAge[c] = 0;
                    }
                }
                // Who is furthest out. The answer is a PERSON and not a direction, because a new
                // village forms around somebody who is already living there.
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        // A founding party is a village whose people are ALL beyond its centre, by
                        // construction -- they are walking to it. Reading that as an outlying
                        // cluster would split every colony in two before it ever arrived.
                        if (h >= 0 && h < this.ncomm && this.csettle[h] <= 0
                            && this.cpop[h] >= Simulation.VILLAGE) {
                            float dx = this.folk.xAt(i) - this.ccx[h];
                            float dy = this.folk.yAt(i) - this.ccy[h];
                            float d = dx * dx + dy * dy;
                            if (d > this.cfarD[h]) {
                                this.cfarD[h] = d;
                                this.cfar[h] = i;
                            }
                        }
                    }
                    i = i + 1;
                }
                // How many are nearer to that person than to the old centre. Counted before anything
                // changes, because both ends have to be left able to stand on their own -- a split
                // that leaves a rump of eight is not a new village, it is two dying ones.
                i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm && this.cfar[h] >= 0 && this.withFar(i, h)) {
                            this.cparty[h] = this.cparty[h] + 1;
                        }
                    }
                    i = i + 1;
                }
                for (int c in 0..this.ncomm) {
                    if (this.cfar[c] < 0) {
                        continue;
                    }
                    if (this.cparty[c] < Simulation.HAMLET
                        || this.cpop[c] - this.cparty[c] < Simulation.HAMLET) {
                        this.cfar[c] = 0 - 1;
                        this.cfarAge[c] = 0;
                        continue;
                    }
                    // How long that cluster has been out there. Without this the split fires on the
                    // first census a group of thirty is beyond the work radius -- and a group of
                    // thirty beyond the work radius is what a village that sends people to a distant
                    // forest LOOKS like every single day. Four and a half thousand villages were
                    // founded in one arc that way, every one of them a work party mistaken for a
                    // town. A settlement is a cluster that is still there tomorrow.
                    this.cfarAge[c] = this.cfarAge[c] + 1;
                    if (this.cfarAge[c] < Simulation.SETTLED) {
                        this.cfar[c] = 0 - 1;
                        continue;
                    }
                    int d = this.freeCommunity();
                    if (d < 0) {
                        this.cfar[c] = 0 - 1;        // the world is out of names
                        continue;
                    }
                    this.found(d, c, this.folk.xAt(this.cfar[c]), this.folk.yAt(this.cfar[c]));
                    this.cchild[c] = d;
                    this.cfarAge[c] = 0;
                    this.cpop[d] = this.cparty[c];   // claims the slot against the next `found`
                    this.cpop[c] = this.cpop[c] - this.cparty[c];
                    this.hived = this.hived + 1;
                    this.hivedFolk = this.hivedFolk + cast<long>(this.cparty[c]);
                }
                i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm && this.cchild[h] >= 0 && this.withFar(i, h)) {
                            this.vacate(i, h);
                            this.folk.setHome(i, this.cchild[h]);
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            // Is this person part of the outlying settlement rather than of the village?
            //
            // Two tests and both are needed. Near the outlier: they are part of that cluster.
            // Beyond the parent's reach: they are not merely on the far side of the village green.
            //
            // The first version asked only the first half -- whoever is nearer to the outlier than
            // to the centre -- which is the perpendicular bisector, and that always takes about HALF
            // the village. So every place that reached a hundred and twenty split on the spot, into
            // two sixties that grew back and split again: fifteen hundred and fifty-eight foundings
            // in one arc, every community slot in the world used, and an average country of thirteen
            // blocks. A split has to mean a satellite that has genuinely become its own place, not a
            // line drawn through a crowd.
            private method withFar(int i, int c) returns boolean {
                int f = this.cfar[c];
                float reach = cast<float>(Simulation.REIGN * Simulation.REIGN);
                float ax = this.folk.xAt(i) - this.folk.xAt(f);
                float ay = this.folk.yAt(i) - this.folk.yAt(f);
                if (ax * ax + ay * ay >= reach) {
                    return false;
                }
                float bx = this.folk.xAt(i) - this.ccx[c];
                float by = this.folk.yAt(i) - this.ccy[c];
                return bx * bx + by * by > reach;
            }

            // The smallest group that is a place rather than a party of wanderers: a quarter of
            // VILLAGE, which is 120.
            //
            // Written out as 30 and NOT as `Simulation.VILLAGE / 4`, which is what it said first and
            // which compiles to zero. A static field initialised from another static field is
            // silently emitted as `i32 0` by ldp3c today -- no diagnostic, no warning -- so every
            // founding party of one person passed the minimum, and thirteen thousand villages were
            // founded in an arc. Four separate rules were tightened chasing that before the IR was
            // read. Toolchain task #334.
            public static int HAMLET = 30;

            // Censuses an outlying cluster must hold together before it counts as a place of its
            // own. A minute is a sixth of a life: somebody who has spent a sixth of their life out
            // there does not commute, they live there.
            //
            // This was added while chasing the HAMLET bug above, so it was checked afterwards
            // rather than trusted. Same seed, same arc, only this number changed: at 1 the world
            // founds 413 villages and absorbs 380; at 60 it founds 67 and absorbs 59. Six times the
            // churn, and the difference is entirely work parties being mistaken for towns.
            public static int SETTLED = 60;

            // A community number nobody is using. Slots are recycled, so everything the last
            // occupant left in one has to be cleared by `found` -- an inherited granary or an
            // inherited chief would be a village remembering a life it never had.
            private method freeCommunity() returns int {
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0 && this.cseat[c] < 0) {
                        return c;
                    }
                }
                return 0 - 1;
            }

            // Set a daughter village up. It carries its mother's TEMPERAMENT and its mother's
            // KNOWLEDGE -- the people who walked out are the same people, and they did not forget how
            // to fire clay on the way -- but nothing else: no chief, no deeds, no grain. A new place
            // starts hungry and unled, which is what makes founding one cost something.
            private method found(int d, int mother, float fx, float fy) returns void {
                this.ccx[d] = fx;
                this.ccy[d] = fy;
                this.cadults[d] = 0;
                this.cmales[d] = 0;
                for (int jb in 0..Job.count()) {
                    this.ctrade[d * Job.count() + jb] = 0;
                }
                for (int hc in 0..Harvest.count()) {
                    this.cworkX[d * Harvest.count() + hc] = 0 - 1;
                }
                this.stores.clear(d);
                this.chief[d] = 0 - 1;
                this.lean[d] = cast<int>(Job.Idle);
                for (int a in 0..5) {
                    this.culture[d * 5 + a] = this.culture[mother * 5 + a];
                    this.deeds[d * 5 + a] = 0;
                }
                // A daughter answers to whoever the mother answered to. This one assignment is the
                // difference between a world of countries and a world of hamlets: before it, a
                // village that outgrew its ground turned the half that walked out into STRANGERS,
                // so nothing could ever get bigger than one day's walk across and the map was a
                // scatter of a hundred and forty places that had all forgotten they were related.
                // Knowledge comes with it and is not copied, because the nation is the thing that
                // knows.
                this.cnat[d] = this.cnat[mother];
                this.croom[d] = 0;
                this.cworst[d] = 0 - 1;
                this.cworstRoom[d] = 0;
                this.cdead[d] = 0 - 1;
                this.cbusy[d] = 0 - 1;
                this.cseat[d] = 0 - 1;
                for (int cr in 0..Craft.count()) {
                    this.copen[d * Craft.count() + cr] = 0 - 1;
                }
                this.cflee[d] = 0 - 1;
                this.cleave[d] = 0;
                this.cfar[d] = 0 - 1;
                this.cchild[d] = 0 - 1;
                this.cjoin[d] = 0 - 1;
                this.cparty[d] = 0;
                this.cfarAge[d] = 0;
                this.csettle[d] = 0;
                this.csiteX[d] = fx;
                this.csiteY[d] = fy;
                this.cmother[d] = mother;
                // The people who walk out take their language with them, which is why a colony and
                // its mother are the same people and a conquered town is not.
                this.ctongue[d] = this.ctongue[mother];
                this.cheld[d] = 0;
                return;
            }

            // An expedition that did not get there.
            //
            // They go back to whoever sent them. The alternative -- letting them become a village
            // standing wherever they gave up -- sounds more generous and is worse: they gave up
            // within a walk of the capital, so the "village" merged straight back in on the next
            // census, and an arc read nine hundred and ninety-six colonies planted against a
            // thousand and forty-one places merged. That is not a world expanding, it is a world
            // shuffling. If the people who sent them are themselves gone, there is nowhere to go
            // back to and they settle for where they stand, which is the one case where a failed
            // founding really is a new place.
            private method abandon(int c) returns void {
                int back = this.cmother[c];
                boolean home = back >= 0 && back < this.ncomm && this.cpop[back] > 0;
                if (!home) {
                    this.csettle[c] = 0;
                    this.cmother[c] = 0 - 1;
                    return;
                }
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.homeOf(i) == c) {
                        this.vacate(i, c);
                        this.folk.setHome(i, back);
                        this.folk.setTarget(i, cast<int>(this.ccx[back]),
                                            cast<int>(this.ccy[back]));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                    }
                    i = i + 1;
                }
                // Whatever they were still carrying goes back on the shelves that paid for it.
                for (int g in 1..Goods.count()) {
                    int had = this.stores.seize(c, g, 1000000);
                    if (had > 0) {
                        this.stores.stow(back, g, had);
                    }
                }
                this.cpop[back] = this.cpop[back] + this.cpop[c];
                this.cpop[c] = 0;
                this.csettle[c] = 0;
                this.cmother[c] = 0 - 1;
                this.chief[c] = 0 - 1;
                this.strayed = this.strayed + 1;
                return;
            }

            // A nation deliberately putting a town somewhere it does not yet hold.
            //
            // This is the OTHER way the map grows, and it is nothing like the first. Hiving is an
            // accident: a village smears itself across too much ground and the far end is given its
            // own name, so a country can only ever spread by one work-radius at a time and only into
            // land its own people were already standing on. Colonising is a decision -- a seat with
            // a full granary picks ground beyond its border and sends people to it -- which is how a
            // nation comes to hold country nobody had walked to yet.
            //
            // One a census for the whole world, taken in turn. That is the budget rule this codebase
            // keeps having to relearn: the question "where should we put a town" is expensive and it
            // is asked once per WORLD per second, never once per nation, and certainly never once
            // per person. The turn-taking is what makes it fair without making it cost more.
            private method colonise() returns void {
                int nn = this.realm.limit();
                mutable int tries = 0;
                while (tries < nn) {
                    this.settler = this.settler + 1;
                    if (this.settler >= nn) {
                        this.settler = 0;
                    }
                    tries = tries + 1;
                    int nat = this.settler;
                    if (!this.realm.alive(nat)) {
                        continue;
                    }
                    // A people with nobody to say so does not mount an expedition. Below a chiefdom
                    // there is no seat, and a colony is by definition somewhere that answers to one.
                    if (this.realm.rankOf(nat) < cast<int>(Rank.Chiefdom)) {
                        continue;
                    }
                    int seat = this.realm.seatOf(nat);
                    if (seat < 0 || this.cpop[seat] < Simulation.VILLAGE) {
                        continue;
                    }
                    if (this.csettle[seat] > 0) {
                        continue;                    // still walking to its own ground
                    }
                    // Paid for out of a full granary, twice over. A people that cannot feed itself
                    // does not send thirty of its own over the horizon with nothing, and the food
                    // they carry comes off the shelves at home -- so an expedition is a real cost
                    // and a hungry year is a year nobody expands.
                    if (this.stores.foodOf(seat) < this.cpop[seat] * Simulation.LARDER * 2) {
                        continue;
                    }
                    int d = this.freeCommunity();
                    if (d < 0) {
                        return;                      // the world is out of names
                    }
                    if (this.plant(nat, seat, d)) {
                        return;                      // one a census, and no more
                    }
                }
                return;
            }

            // Choose the ground, gather the party and send it. False if there was nowhere worth
            // going or nobody facing that way, in which case the nation simply waits its turn again.
            private method plant(int nat, int seat, int d) returns boolean {
                int cbx = cast<int>(this.ccx[seat]) / 16;
                int cby = cast<int>(this.ccy[seat]) / 16;
                mutable int bestWorth = 0;
                mutable int bestX = 0 - 1;
                mutable int bestY = 0 - 1;
                mutable int r = Simulation.COLONY_NEAR;
                while (r <= Simulation.COLONY_FAR) {
                    mutable int dx = 0 - r;
                    while (dx <= r) {
                        int wa = this.siteWorth(cbx + dx, cby - r);
                        if (wa > bestWorth) {
                            bestWorth = wa;
                            bestX = cbx + dx;
                            bestY = cby - r;
                        }
                        int wb = this.siteWorth(cbx + dx, cby + r);
                        if (wb > bestWorth) {
                            bestWorth = wb;
                            bestX = cbx + dx;
                            bestY = cby + r;
                        }
                        dx = dx + 1;
                    }
                    mutable int dy = 1 - r;
                    while (dy <= r - 1) {
                        int wc = this.siteWorth(cbx - r, cby + dy);
                        if (wc > bestWorth) {
                            bestWorth = wc;
                            bestX = cbx - r;
                            bestY = cby + dy;
                        }
                        int wd = this.siteWorth(cbx + r, cby + dy);
                        if (wd > bestWorth) {
                            bestWorth = wd;
                            bestX = cbx + r;
                            bestY = cby + dy;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                if (bestX < 0) {
                    return false;                    // hemmed in: no unheld ground worth a town
                }
                float sx = cast<float>(bestX * 16 + 8);
                float sy = cast<float>(bestY * 16 + 8);
                // Who goes is not chosen either: it is whoever is already on that side of the
                // village. The same reading hiving uses, and for the same reason -- a party picked
                // by number would be thirty people teleported out of the middle of a crowd, and a
                // party picked by where they stand is the edge of the place walking further out.
                float vx = sx - this.ccx[seat];
                float vy = sy - this.ccy[seat];
                int n = this.folk.limit();
                mutable int facing = 0;
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.isAdult(i)
                        && this.folk.homeOf(i) == seat) {
                        float ax = this.folk.xAt(i) - this.ccx[seat];
                        float ay = this.folk.yAt(i) - this.ccy[seat];
                        if (ax * vx + ay * vy > 0.0) {
                            facing = facing + 1;
                        }
                    }
                    i = i + 1;
                }
                if (facing < Simulation.HAMLET) {
                    return false;                    // not enough of them are out that way
                }
                this.found(d, seat, sx, sy);
                this.csettle[d] = Simulation.TREK;
                mutable int took = 0;
                i = 0;
                while (i < n) {
                    if (took < Simulation.HAMLET && this.folk.alive(i) && this.folk.isAdult(i)
                        && this.folk.homeOf(i) == seat) {
                        float ax = this.folk.xAt(i) - this.ccx[seat];
                        float ay = this.folk.yAt(i) - this.ccy[seat];
                        if (ax * vx + ay * vy > 0.0) {
                            this.vacate(i, seat);
                            this.folk.setHome(i, d);
                            // And they are TOLD to go. Changing where somebody belongs is not the
                            // same as sending them: a colonist who can still find work where he is
                            // standing never takes a step, the party never reaches its ground, and
                            // the founding expires next to the capital as a second village close
                            // enough to be absorbed straight back. Migration already had to learn
                            // this -- `leaving` sets a target for exactly the same reason.
                            this.folk.setTarget(i, cast<int>(sx), cast<int>(sy));
                            this.folk.setAct(i, cast<int>(Act.WalkTo));
                            took = took + 1;
                        }
                    }
                    i = i + 1;
                }
                this.cpop[d] = took;
                this.cpop[seat] = this.cpop[seat] - took;
                // Provisions for the road, off the capital's shelves. Not counted as eaten and not
                // counted as grown -- it is the same food, on somebody's back.
                int fare = this.stores.richest(seat);
                if (fare > 0) {
                    int packed = this.stores.seize(seat, fare, took * Simulation.LARDER * 2);
                    this.stores.stow(d, fare, packed);
                }
                this.colonies = this.colonies + 1;
                this.colonists = this.colonists + cast<long>(took);
                return true;
            }

            // What a block is worth as somewhere to live, or 0 if it is not a candidate at all.
            //
            // Three things and no dials: it must be nobody's, it must be walkable, and it must have
            // the two things a place cannot start without -- something to eat and something to build
            // with -- inside the radius a community actually works. The last part is why the count
            // is over the block AND its neighbours: a village reaches three blocks, so asking
            // whether one block happens to hold both would reject most of the habitable world.
            private method siteWorth(int bx, int by) returns int {
                if (bx < 1 || by < 1 || bx >= this.claimW - 1 || by >= this.claimH - 1) {
                    return 0;
                }
                if (this.claim[by * this.claimW + bx] >= 0) {
                    return 0;                        // somebody already lives off this ground
                }
                if (!this.walkable(bx * 16 + 8, by * 16 + 8)) {
                    return 0;
                }
                NodeField* nf = this.g.surface();
                mutable int food = 0;
                mutable int wood = 0;
                mutable int oy = 0 - 1;
                while (oy <= 1) {
                    mutable int ox = 0 - 1;
                    while (ox <= 1) {
                        food = food + nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Forage))
                                    + nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Fishing));
                        wood = wood + nf.inBlock(bx + ox, by + oy, cast<int>(Harvest.Timber));
                        ox = ox + 1;
                    }
                    oy = oy + 1;
                }
                if (food <= 0 || wood <= 0) {
                    return 0;
                }
                // Food counts double. A colony that runs out of timber sends for more; one that
                // runs out of bread is not a colony next month.
                return food * 2 + wood;
            }

            // How far out a colony is planted, in 16-cell blocks.
            //
            // The near edge is beyond WORK_BLOCKS, which is the distance a community searches for
            // work: any nearer and the new town would be competing with its own capital for the
            // same trees, and the split rule would pull the two straight back together. The far edge
            // is a walk of about a hundred and sixty cells, which at a cell and a quarter a second
            // is a third of a life -- far enough to be somewhere else, near enough that the people
            // sent there arrive alive.
            public static int COLONY_NEAR = 4;
            public static int COLONY_FAR = 10;

            // Censuses a founding party has to reach its ground before it gives up and settles for
            // wherever it got to. Four minutes: two thirds of a life, and long enough for the
            // longest walk the far edge allows even for somebody who stops to eat.
            public static int TREK = 240;

            // Does this person walk away from where they were born?
            //
            // Two things have to be true and neither of them is an opinion: they are hungry, and the
            // place has nothing to feed them with. Hunger alone is not enough -- somebody on their
            // way home with a basket is hungry too -- and an empty granary alone is not enough,
            // because a village between harvests is not a village anybody flees.
            //
            // Where they go was decided for the whole community a moment ago. A starving person does
            // not survey the world; they go where word says there is bread, and word travels between
            // villages rather than between individuals.
            private method leaving(int i) returns boolean {
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return false;
                }
                if (this.cleave[h] <= 0) {
                    return false;                    // this place has let go of enough for one day
                }
                // Halfway to dying of it, not merely hungry. The first version asked for HUNGRY_AT,
                // which is the point where somebody starts wanting lunch -- so at the first empty
                // granary anywhere the entire world got up and walked, a hundred and thirty thousand
                // departures out of fifty thousand people, and nothing was ever gathered again
                // because nobody stayed anywhere long enough to gather it. Everyone saw the same
                // signal on the same tick and acted on it at once.
                if (this.folk.hungerOf(i) * 2 < Simulation.STARVE_AT) {
                    return false;
                }
                if (this.stores.foodOf(h) > 0) {
                    return false;
                }
                int to = this.cflee[h];
                if (to < 0) {
                    return false;                    // nowhere better; they stay and take their chances
                }
                this.cleave[h] = this.cleave[h] - 1;
                this.vacate(i, h);
                this.folk.setHome(i, to);
                this.folk.setTarget(i, cast<int>(this.ccx[to]), cast<int>(this.ccy[to]));
                this.folk.setAct(i, cast<int>(Act.Flee));
                this.fled = this.fled + 1;
                return true;
            }

            // Where somebody goes when the place they were born cannot feed them.
            //
            // Asked per COMMUNITY per second, as everything of this shape is: the nearest other
            // place with more food a head than this one. A starving person does not survey the
            // world -- they go where word says there is bread, and word travels between villages,
            // not between individuals.
            private method wayOut() returns void {
                // Food a head, once per community. Read inside the pair loop it was a sweep of every
                // good in the catalogue five hundred times five hundred times a second -- fifteen
                // million reads to answer five hundred questions.
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] > 0) {
                        this.cfood[c] = this.stores.foodOf(c) / (this.cpop[c] + 1);
                    } else {
                        this.cfood[c] = 0;
                    }
                }
                mutable int c = 0;
                while (c < this.ncomm) {
                    this.cflee[c] = 0 - 1;
                    // How many a place may lose before the next census. Departure is a trickle and
                    // never a stampede -- a sixteenth of a village a second empties it in a couple
                    // of minutes if the famine holds, and lets it recover if it does not. The budget
                    // rule again: constant cost per second, more seconds when there is more to do.
                    this.cleave[c] = this.cpop[c] / 16 + 1;
                    if (this.cpop[c] <= 0) {
                        c = c + 1;
                        continue;
                    }
                    int mine = this.cfood[c];
                    mutable int best = 0 - 1;
                    mutable float bestD = 0.0;
                    for (int o in 0..this.ncomm) {
                        if (o == c || this.cpop[o] <= 0) {
                            continue;
                        }
                        if (this.cfood[o] <= mine + Simulation.LARDER) {
                            continue;                // no better off than here, so not worth the road
                        }
                        float dx = this.ccx[o] - this.ccx[c];
                        float dy = this.ccy[o] - this.ccy[c];
                        float d = dx * dx + dy * dy;
                        if (best < 0 || d < bestD) {
                            best = o;
                            bestD = d;
                        }
                    }
                    this.cflee[c] = best;
                    c = c + 1;
                }
                return;
            }

            // Who each community listens to. Nobody is appointed: the census already walks everybody,
            // so it can see who has the most standing and hand the role to them -- and hand it on
            // again when they die, which at six minutes a life is often. That is what makes a
            // succession an event rather than a script.
            private method hearWho() returns void {
                int n = this.folk.limit();
                mutable int[] bestI = new int[this.ncomm]();
                mutable int[] bestV = new int[this.ncomm]();
                // The other two people a place has. Found in the SAME sweep -- one pass over fifty
                // thousand rows answers all three questions, and asking them separately would be
                // three passes for no reason.
                mutable int[] oldI = new int[this.ncomm]();
                mutable float[] oldA = new float[this.ncomm]();
                mutable int[] holyI = new int[this.ncomm]();
                mutable int[] holyV = new int[this.ncomm]();
                mutable int[] cartI = new int[this.ncomm]();
                mutable int[] cartV = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    bestI[c] = 0 - 1;
                    bestV[c] = 0 - 1;
                    oldI[c] = 0 - 1;
                    oldA[c] = 0.0;
                    holyI[c] = 0 - 1;
                    holyV[c] = 0 - 1;
                    cartI[c] = 0 - 1;
                    cartV[c] = 0 - 1;
                }
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.isAdult(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm) {
                            int v = this.folk.influenceOf(i);
                            if (v > bestV[h]) {
                                bestV[h] = v;
                                bestI[h] = i;
                            }
                            float age = this.folk.ageOf(i);
                            if (age > oldA[h]) {
                                oldA[h] = age;
                                oldI[h] = i;
                            }
                            int jb = this.folk.jobOf(i);
                            if (jb == cast<int>(Job.Scholar) && v > holyV[h]) {
                                holyV[h] = v;
                                holyI[h] = i;
                            }
                            if (jb == cast<int>(Job.Trader) && v > cartV[h]) {
                                cartV[h] = v;
                                cartI[h] = i;
                            }
                        }
                    }
                    i = i + 1;
                }
                for (int c in 0..this.ncomm) {
                    int had = this.chief[c];
                    boolean vacant = had < 0 || !this.folk.alive(had)
                                  || this.folk.homeOf(had) != c;
                    if (this.cpop[c] < Simulation.VILLAGE) {
                        // A band is too small to need anybody in charge. If it had a chief and has
                        // shrunk below a village, the role goes away with the reason for it.
                        if (had >= 0 && this.folk.alive(had)) {
                            this.folk.setRole(had, cast<int>(Role.None));
                        }
                        this.chief[c] = 0 - 1;
                        this.lean[c] = cast<int>(Job.Idle);
                        continue;
                    }
                    if (!vacant) {
                        continue;                          // still living, still theirs
                    }
                    int heir = bestI[c];
                    if (heir < 0 || bestV[c] <= 0) {
                        continue;                          // nobody has done anything worth heeding
                    }
                    this.folk.setRole(heir, cast<int>(Role.Chief));
                    this.chief[c] = heir;
                    this.lean[c] = this.leaning(heir);
                    if (had < 0) {
                        this.risen = this.risen + 1;
                    } else {
                        this.passed = this.passed + 1;
                    }
                }
                // The other two. Neither is elected and neither can be appointed -- an elder is
                // whoever has lived longest and a priest is whoever spends their days at the
                // shrine, so both are read off the world exactly like the chief.
                for (int c in 0..this.ncomm) {
                    int wasOld = this.celder[c];
                    if (wasOld >= 0 && this.folk.alive(wasOld)
                        && this.folk.roleOf(wasOld) == cast<int>(Role.Elder)) {
                        this.folk.setRole(wasOld, cast<int>(Role.None));
                    }
                    this.celder[c] = 0 - 1;
                    int wasHoly = this.cpriest[c];
                    if (wasHoly >= 0 && this.folk.alive(wasHoly)
                        && this.folk.roleOf(wasHoly) == cast<int>(Role.Priest)) {
                        this.folk.setRole(wasHoly, cast<int>(Role.None));
                    }
                    this.cpriest[c] = 0 - 1;
                    int wasCart = this.ctchief[c];
                    if (wasCart >= 0 && this.folk.alive(wasCart)
                        && this.folk.roleOf(wasCart) == cast<int>(Role.TradeChief)) {
                        this.folk.setRole(wasCart, cast<int>(Role.None));
                    }
                    this.ctchief[c] = 0 - 1;
                    if (this.cpop[c] < Simulation.VILLAGE) {
                        continue;                          // a band defers to age without naming it
                    }
                    // The eldest, unless the eldest is already the one in charge -- a village has
                    // two authorities or one, never the same person twice.
                    int old = oldI[c];
                    if (old >= 0 && old != this.chief[c] && oldA[c] >= Simulation.ELDERLY) {
                        this.folk.setRole(old, cast<int>(Role.Elder));
                        this.celder[c] = old;
                        // Counted when the person CHANGES, not every census the seat is filled.
                        // The first version counted the seat and reported six hundred and eighty
                        // thousand elders in a world of fifty thousand people -- a total larger than
                        // everybody who ever lived, which is how you know a counter is measuring
                        // ticks rather than events.
                        if (old != wasOld) {
                            this.eldersSeated = this.eldersSeated + 1;
                        }
                    }
                    int holy = holyI[c];
                    if (holy >= 0 && holy != this.chief[c] && holy != this.celder[c]) {
                        this.folk.setRole(holy, cast<int>(Role.Priest));
                        this.cpriest[c] = holy;
                        if (holy != wasHoly) {
                            this.priestsSeated = this.priestsSeated + 1;
                        }
                    }
                    // And in a capital, whoever among the carters has the most standing. The role
                    // is a CONSEQUENCE of the trade and not a precondition for it -- a country of
                    // two towns has people walking loads between them whether or not anybody is
                    // organising it, and the one they end up listening to is the one who has walked
                    // the most. Making it a precondition would have been a circle nothing breaks.
                    int cart = cartI[c];
                    if (cart >= 0 && this.realm.seatOf(this.cnat[c]) == c
                        && cart != this.chief[c] && cart != this.celder[c]
                        && cart != this.cpriest[c]) {
                        this.folk.setRole(cart, cast<int>(Role.TradeChief));
                        this.ctchief[c] = cart;
                        if (cart != wasCart) {
                            this.tradeChiefs = this.tradeChiefs + 1;
                        }
                    }
                }
                delete bestI;
                delete bestV;
                delete oldI;
                delete oldA;
                delete holyI;
                delete holyV;
                delete cartI;
                delete cartV;
                return;
            }

            // How old somebody has to be before anybody calls them old. A life is about six minutes,
            // so two thirds of one: old enough to have seen a village change and be believed about
            // it, young enough that a place usually has somebody who qualifies.
            public static float ELDERLY = 240.0;

            // Somebody who leaves a place -- or leaves the world -- stops being anything in it, and
            // the seat empties the moment they go rather than at the next census.
            //
            // Moving is the obvious half: hiving, absorbing, colonising and famine all reseat
            // somebody's home after `hearWho` has already run.
            //
            // DYING is the half that actually bit, and it is worth writing down because a seat that
            // holds an agent INDEX is only meaningful until that row is recycled. Somebody dies, the
            // pool hands their row to the next child born anywhere in the world, and for the rest of
            // that second the elder of a village of six hundred is a newborn two hundred cells away
            // -- alive, so no aliveness check catches it, and in a different community, so every
            // reader that trusted the seat was reading about the wrong person.
            private method vacate(int i, int from) returns void {
                if (from < 0 || from >= this.ncomm) {
                    return;
                }
                if (this.chief[from] == i) {
                    this.chief[from] = 0 - 1;
                }
                if (this.celder[from] == i) {
                    this.celder[from] = 0 - 1;
                }
                if (this.cpriest[from] == i) {
                    this.cpriest[from] = 0 - 1;
                }
                if (this.ctchief[from] == i) {
                    this.ctchief[from] = 0 - 1;
                }
                if (this.folk.roleOf(i) != cast<int>(Role.None)) {
                    this.folk.setRole(i, cast<int>(Role.None));
                }
                return;
            }

            // What a person pushes their village toward, read off the temperament they were born
            // with and drifted from their mother. It is not a plan and it is not optimal -- a greedy
            // chief wants the village digging whether or not the village needs stone. That is the
            // point: it is why two communities on identical ground come out different.
            private method leaning(int i) returns int {
                int bold = this.folk.boldnessOf(i);
                int greed = this.folk.greedOf(i);
                int social = this.folk.sociabilityOf(i);
                int curious = this.folk.curiosityOf(i);
                mutable int best = greed;
                mutable int pick = cast<int>(Job.Miner);
                if (bold > best) {
                    best = bold;
                    pick = cast<int>(Job.Hunter);
                }
                if (social > best) {
                    best = social;
                    pick = cast<int>(Job.Builder);
                }
                if (curious > best) {
                    best = curious;
                    pick = cast<int>(Job.Quarrier);
                }
                return pick;
            }

            // What this community should put up next, if anything. The rule is docs/ECONOMY.md's own:
            // a building is GROWN FROM NEED, and need is visible as a pile. A village with wood
            // stacking up and no sawmill wants a sawmill; one with iron and no charcoal does not want
            // a smithy, it wants a kiln -- and it finds that out because the smithy it would have
            // built stalls, and a stalled workshop is a want the next census can read.
            //
            // Nothing is spent here. Marking out a site costs nothing but the decision; the timber
            // and stone come out of the store when the builders have actually raised it, so a plan
            // can never eat a village's winter.
            private method considerBuilding(int c) returns void {
                if (this.cseat[c] < 0) {
                    // The seat, free at founding, at the middle of where the people actually are.
                    int b = this.town.mark(cast<int>(this.ccx[c]), cast<int>(this.ccy[c]),
                                           cast<int>(BuildingKind.TownHall), c);
                    if (b >= 0) {
                        this.town.raise(b, Buildings.RAISE);
                        this.cseat[c] = b;
                    }
                    return;
                }
                if (this.cbusy[c] >= 0) {
                    return;                          // one thing at a time; finish it first
                }
                // A workshop nobody has set foot in for five minutes is not a workshop, it is a
                // ruin. Pulling it down before anything else is decided frees the ground AND the
                // decision: the same census that clears a dead sawmill can mark out the kiln the
                // village actually wants.
                if (this.cdead[c] >= 0) {
                    this.town.demolish(this.cdead[c]);
                    this.cdead[c] = 0 - 1;
                    this.pulled = this.pulled + 1;
                    return;
                }
                // A roof comes before a trade. This is not a preference, it is the order the
                // catalogue puts them in: a place with more people than beds has one want, and it
                // is not a brewery.
                if (this.considerHousing(c)) {
                    return;
                }
                if (this.considerWater(c)) {
                    return;
                }
                if (this.considerCare(c)) {
                    return;
                }
                mutable int best = cast<int>(BuildingKind.NoBuilding);
                mutable int bestScore = 0;
                // THE BAR THE WINNER HAS TO CLEAR, AND WHY IT IS NOT ONE NUMBER.
                //
                // Worth is counted in units of a good, and one bar for every good compares things
                // that are not the same. A batch of bread is twelve units and a batch of rope is
                // eight, so "sixty short" is five batches of one and seven and a half of the other
                // -- different amounts of work, weighed on the same scale. Food and tools clear
                // sixty because their wants scale with mouths and hands and run to the hundreds;
                // EVERY MATERIAL WANT IS FLAT AND SMALL BY NATURE and so was never worth anything.
                //
                // A harbour needs twelve rope and a shipwright's batch seeds sixteen more, so the
                // standing want for rope is twenty-eight against a bar of sixty: no ropewalk, no
                // rope, no harbour, no boat. The same arithmetic is why iron sat at twenty units
                // for twenty generations, and it is #335 as well.
                //
                // So a WORKSHOP is worth raising when at least one full batch of work is waiting
                // for it, and the bar is its own batch. What stops that running away is not a
                // number, it is the empty-bench rule above -- the bound three measured arcs proved
                // has to be universal. The other branches keep WANT, because fear and being cut off
                // are not quantities of any good and a batch means nothing to them.
                //
                // AND THE RANKING HAS TO MOVE WITH THE BAR, which the first version of this missed.
                // Letting a kind QUALIFY on its own batch while still ranking every candidate on raw
                // units changes which kinds are eligible and not which one wins -- so rope went from
                // nothing to six hundred and forty-three thousand and IRON COLLAPSED from a thousand
                // and thirty-two to fifty-six, because a want of twenty-four units loses every
                // census to bread wanted in the hundreds however few batches either of them is.
                //
                // So candidates are compared as a RATIO of worth to their own bar -- how far over
                // its own threshold each one is -- by cross-multiplying rather than dividing, which
                // keeps it exact in integers. Iron short by twenty-four at two a batch is twelve
                // batches waiting; bread short by three hundred at twelve a batch is twenty-five.
                // Those are comparable numbers. Twenty-four against three hundred never was.
                //
                // AND A WALL IS NOT IN THIS AUCTION AT ALL, which the first version of this got
                // wrong and a measured arc caught: normalising fear against the same bar put a
                // threatened town's palisade at six-point-seven while the bakery it also wanted sat
                // at twenty-five, and the world ended with NOT ONE WALL STANDING. The mistake was
                // agreeing to weigh them at all. Safety is not traded against bread on any scale,
                // any more than a roof is -- and a roof was already decided before this loop, for
                // exactly that reason. So the order is: a roof, then a threat, then being cut off,
                // and only then the auction between workshops, which really are comparable.
                mutable int bestBar = Simulation.WANT;
                mutable int wallPick = cast<int>(BuildingKind.NoBuilding);
                mutable int wallFear = 0;
                mutable int portPick = cast<int>(BuildingKind.NoBuilding);
                mutable int portCut = 0;
                for (int k in 1..BuildingKind.count()) {
                    // A WALL IS THE ONE BUILDING THAT MAKES NOTHING AND IS STILL WORTH RAISING.
                    //
                    // `staffed` means "has an output or teaches", which is how every other kind
                    // earns its place in this loop -- and it threw every palisade, rampart, keep,
                    // watchtower and barracks out one line before the scoring written for them.
                    // The whole wall block below was dead code: a measured arc had thirty-four towns
                    // stormed and not one wall standing anywhere in the world.
                    //
                    // AND THEN THE HARBOUR WALKED INTO THE SAME LINE. It makes nothing either, so it
                    // was thrown out here, one line before the branch written to score it -- a
                    // measured arc with rope in a hundred and three towns and not one quay anywhere.
                    // Twice now, in the same `if`, for the same reason: this test asks "does it
                    // produce" when what it means is "is it in the catalogue for a reason".
                    if (!Builds.staffed(k) && Builds.wall(k) <= 0 && Builds.port(k) <= 0) {
                        continue;
                    }
                    if (Builds.era(k) > this.eraOf(c)) {
                        continue;                    // nobody here knows how yet
                    }
                    // The cap of one building per kind is GONE, and it could only go once the
                    // scoring below stopped measuring abundance.
                    //
                    // It was carrying diversification in silence. A kiln's input is wood, wood is
                    // the commonest thing in the world, so under the old rule the kiln won every
                    // census for ever and the mill and the bakery were never built; three
                    // replacements for the cap were measured over twenty-generation arcs and all
                    // three were worse, because every one of them left the scoring alone. With
                    // worth read as WANT, a second kiln is only built by a place that is short of
                    // charcoal -- and a town of eight hundred is short of more than a hamlet of
                    // forty is, which is the whole thing that was missing.
                    if (!this.stores.has(c, cast<int>(Good.Wood), Builds.woodCost(k))) {
                        continue;
                    }
                    if (!this.stores.has(c, cast<int>(Good.Stone), Builds.stoneCost(k))) {
                        continue;
                    }
                    if (Builds.matCost(k) != cast<int>(Good.Nothing)
                        && !this.stores.has(c, Builds.matCost(k), Builds.matCostN(k))) {
                        continue;
                    }
                    // ONE rule for every building: it is worth what the place is SHORT of.
                    //
                    // A place of learning is the exception the rule needs rather than an exception
                    // to it -- what it makes is knowledge, which no shelf holds, so what a village
                    // is short of is the spare time to think, and that is the surplus it is sitting
                    // on. Everything else is worth its output's unmet want.
                    //
                    // Gated on being able to run at all: a workshop with no input in the store is a
                    // want the place cannot answer yet, and building it would only add a stall.
                    // NOBODY RAISES A SECOND WORKSHOP OF A TRADE WHILE THE FIRST HAS AN EMPTY SEAT.
                    //
                    // This is the bound that makes "worth is want" terminate, and it took three
                    // measured arcs to find that it has to be universal. Every want in this world
                    // has a term that answers it -- stock for a good, a rate for hunger, a scholar
                    // for a lesson -- and every one of those terms is measured on what is being
                    // WORKED, not on what is standing. So an unstaffed building answers nothing,
                    // the want that built it survives it, and the village builds another: four
                    // thousand shrines, then two thousand once learning was bounded, then a
                    // thousand pastures once it was not.
                    //
                    // An empty bench is the one signal that is true of every kind of building at
                    // once. A village with a pasture nobody stands in does not need a second
                    // pasture; it needs somebody to stand in the first.
                    // Asked by OUTPUT and not by trade, which is the same rule one step finer and
                    // the difference between a world with armouries in it and one without. Per
                    // craft, a toolmaker with an idle bench also blocked the weaponsmith beside it
                    // -- and tools are wanted by every pair of hands in a village while weapons are
                    // wanted only by the few carrying a grudge, so the toolmaker won every census
                    // for ever. Six hundred and fifty-six toolmakers, no weaponsmith anywhere in
                    // the world, and nobody armed in twenty generations.
                    if (Builds.staffed(k) && this.cmade[c * Goods.count() + Builds.out(k)] >= 0) {
                        continue;
                    }
                    // A wall makes nothing, so it has no output to be short of. What a town is
                    // short of here is the confidence to sleep, and it reads that off whether
                    // anybody is currently coming for it: a grudge, or an army already in sight.
                    // A place nobody threatens builds no wall, which is why the map shows you
                    // where the borders that matter are without anybody drawing one.
                    if (Builds.wall(k) > 0) {
                        if (this.cwall[c] >= Builds.wall(k)) {
                            continue;            // it already has as good or better
                        }
                        mutable int fear = 0;
                        if (this.craided[c] > 0) {
                            fear = this.craided[c];
                        }
                        if (this.carmy[c] >= 0) {
                            fear = fear + 400;   // there is an army outside; this is not a drill
                        }
                        if (fear <= 0) {
                            continue;
                        }
                        if (fear > wallFear) {
                            wallFear = fear;
                            wallPick = k;
                        }
                        continue;
                    }
                    // A harbour makes nothing either, so it is scored apart like the wall -- but on
                    // the opposite question. A wall is worth what the town fears; a port is worth
                    // what the town cannot GET.
                    //
                    // The signal is already computed once a census and costs nothing to read: a
                    // town with no caravan destination has nobody within a cart's reach who is
                    // short of what it has spare. That is what being cut off means, and it is
                    // exactly the town for whom the water is the only road. A town in the middle of
                    // a well-connected country reads the same shortfalls and builds nothing,
                    // because the carts already answer them.
                    if (Builds.port(k) > 0) {
                        if (this.cport[c] >= Builds.port(k)) {
                            continue;                // it already reaches as far
                        }
                        if (this.ccaravan[c] >= 0) {
                            continue;                // the roads are answering it
                        }
                        mutable int cutOff = 0;
                        for (int g in 1..Goods.count()) {
                            cutOff = cutOff + this.shortOf(c, g);
                        }
                        if (cutOff > portCut) {
                            portCut = cutOff;
                            portPick = k;
                        }
                        continue;
                    }
                    mutable int worth = 0;
                    mutable int bar = Simulation.WANT;
                    if (Builds.study(k) > 0) {
                        // A place of learning is bounded by the people who can sit in it, and by
                        // nothing else -- what it makes is knowledge, and no shelf fills up.
                        //
                        // Two bounds were tried and measured before this one. Spare food alone is
                        // unbounded and raised four thousand three hundred and fifty-five shrines;
                        // spare food minus the learning already being done is no better, because
                        // learning is only counted where somebody is STANDING, and nobody staffs
                        // four thousand shrines -- so building more never reduced the want that
                        // built them. An empty seat is the honest signal, and it is the one this
                        // codebase already uses for every other workshop.
                        if (this.copen[c * Craft.count() + cast<int>(Craft.Lettering)] < 0) {
                            int spare = this.stores.foodOf(c) - this.cpop[c] * Simulation.LARDER;
                            if (spare > 0) {
                                worth = spare;
                            }
                        }
                    } else {
                        worth = this.shortOf(c, Builds.out(k));
                        // One batch of work waiting is what a workshop is for. Its own batch is the
                        // bar, so a ropewalk making eight at a time and a bakery making twelve are
                        // asked the same question instead of being weighed on a scale calibrated
                        // for how much bread a village eats.
                        if (Builds.nout(k) > 0) {
                            bar = Builds.nout(k);
                        }
                    }
                    if (Builds.in1(k) != cast<int>(Good.Nothing)
                        && !this.stores.has(c, Builds.in1(k), Builds.n1(k))) {
                        worth = 0;
                    }
                    if (Builds.in2(k) != cast<int>(Good.Nothing)
                        && !this.stores.has(c, Builds.in2(k), Builds.n2(k))) {
                        worth = 0;
                    }
                    if (worth * bestBar > bestScore * bar) {
                        bestScore = worth;
                        best = k;
                        bestBar = bar;
                    }
                }
                // A threat first, then no way out, then trade.
                if (wallPick != cast<int>(BuildingKind.NoBuilding) && wallFear >= Simulation.WANT) {
                    this.markNear(c, wallPick);
                    return;
                }
                if (portPick != cast<int>(BuildingKind.NoBuilding) && portCut >= Simulation.WANT) {
                    this.markNear(c, portPick);
                    return;
                }
                if (best == cast<int>(BuildingKind.NoBuilding) || bestScore < bestBar) {
                    return;
                }
                this.markNear(c, best);
                return;
            }

            // Can this place actually put to sea? A quay it built, and a hull tied up at it. Asked
            // where routes are drawn, which is once a census per town.
            private method sails(int c) returns boolean {
                return this.cport[c] > 0
                    && this.stores.amountOf(c, cast<int>(Good.Boat)) > 0;
            }

            // How much of a good this place wants and has not got.
            //
            // Three sources, and every one of them scales with how many people are here, which is
            // the whole reason a city can now out-build a hamlet: mouths to feed, benches to keep
            // fed, and hands to put a tool in. The old rule -- worth is the abundance of the input
            // -- scaled with nothing at all, which is why the number of workshops in the world grew
            // only by the number of VILLAGES in it.
            // Where each town is sending a load, and what is in it.
            //
            // A country is not only a border: it is a set of places that can cover for each other,
            // and this is the only thing in the world that actually makes that true. A town with a
            // seam and no woodland and a town with woodland and no seam were two poor places under
            // one flag; with a road between them they are one rich one.
            //
            // Asked ONCE a census per town, never per carter per decision. "Who needs what I have
            // spare" is the expensive question in this file, and answering it per person would be
            // the woodcutter's mistake for the fourth time.
            private method caravanRoutes() returns void {
                int ng = Goods.count();
                for (int c in 0..this.ncomm) {
                    this.ccaravan[c] = 0 - 1;
                    this.ccargo[c] = 0;
                }
                // WHAT EVERY PLACE IS SHORT OF, ONCE.
                //
                // The pair loop below asked `shortOf` per (town, destination), and `shortOf` walks
                // the whole building catalogue on every call for its prospective term -- a hundred
                // and thirty towns by a hundred and thirty destinations by fifty-three kinds is
                // nine hundred thousand iterations a census, and a two-generation arc runs seven
                // hundred of them. It was six hundred and forty-five million iterations to answer
                // a question that has one answer per place.
                //
                // Measured: the short arc went from sixty-one seconds to the number in the commit
                // message. Identical behaviour -- nothing in `shortOf` changes while this pass runs,
                // so reading it once and reading it seventeen thousand times give the same routes.
                //
                // This is the mistake this file warns about in three separate comments, made in a
                // method whose own header says "asked once a census per town, never per carter".
                // Writing the rule down is not the same as following it.
                mutable int[] gap = new int[this.ncomm * ng]();
                // And the worst anybody is short of each good, in the same pass. This is what makes
                // "carry what is wanted" affordable: the answer is the same for every sender, so it
                // is computed once a census rather than once per town per good.
                mutable int[] worst = new int[ng]();
                for (int d in 0..this.ncomm) {
                    if (this.cpop[d] <= 0) {
                        continue;
                    }
                    for (int g in 1..ng) {
                        int lack = this.shortOf(d, g);
                        gap[d * ng + g] = lack;
                        // SCARCITY IS NOT SHORTFALL, IT IS INABILITY -- and only the second one is
                        // worth a cart.
                        //
                        // Picking the cargo by the biggest shortfall anywhere just picks food every
                        // time: food is eaten continuously by everybody while iron's shortfall is
                        // small and fixed. That was measured -- loads doubled, distribution improved
                        // on every broad axis, and iron did not move a town. A place short of grain
                        // can grow grain and will; a place short of iron with no ore under it can
                        // never make any however long it waits, and it is the only one for whom a
                        // cart is the difference between having the thing and never having it.
                        if (this.cowns[d * ng + g] == 0 && lack > worst[g]) {
                            worst[g] = lack;
                        }
                    }
                }
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    int nat = this.cnat[c];
                    // A port trades with FOREIGNERS, which is the whole difference between a road
                    // and a sea lane. Overland a caravan only ever goes to another town under the
                    // same flag -- a cart crossing a border is a raid waiting to happen -- so a
                    // country of one town has nobody to send to and stops here. A harbour does not
                    // care whose flag flies on the far side, so a single-town island is exactly the
                    // place a port is worth most, and it is the first route in this world that
                    // crosses a border without an army attached to it.
                    if (!this.sails(c) && this.realm.townsOf(nat) < Simulation.TRADE_TOWNS) {
                        continue;
                    }
                    // A CARAVAN CARRIES WHAT IS WANTED, NOT WHAT IS PILED UP.
                    //
                    // It used to take whatever the sending town had MOST spare of, and that is why
                    // the deep end of every chain stayed where it was made. A town with fifteen
                    // hundred iron ingots also has five thousand grain, so grain won the cart every
                    // census for ever, iron sat in two towns out of a hundred and eighty-two, and a
                    // weaponsmith -- which needs iron in the same place as the men who want the
                    // weapons -- could not be built anywhere. Three separate systems were finished
                    // and inert behind this one line: weapons, armour, and every treaty that was
                    // waiting on trade to cross a border.
                    //
                    // Now it is the good whose SHORTFALL SOMEWHERE ELSE is largest, bounded by what
                    // we can actually spare. Cheap, and deliberately so: the world's worst gap per
                    // good is one pass over towns and goods per CENSUS, not per town -- the mistake
                    // this method's own header warns about, made once already and not again.
                    //
                    // ⚠️ This is a re-try of a variant that was measured and REVERTED (see
                    // ECONOMY_MEASUREMENTS row 5), and it is legitimate only because the reason it
                    // failed is gone: smithies died last time because a workshop needed sixty units
                    // of unmet want to be worth building, and it now needs one batch.
                    // Scarce first, and BULK WHEN THERE IS NOTHING SCARCE TO CARRY.
                    //
                    // Both halves were measured and each on its own was half an answer. Sending the
                    // biggest pile moved a million and a half units and left iron in two towns.
                    // Sending only what the far end cannot make woke diplomacy up -- twenty-nine
                    // border crossings became two hundred and seventy-nine, and the world had its
                    // first peace and its first alliance -- but halved the tonnage, because a town
                    // with nothing scarce to offer sent NOTHING, and the neighbour who was merely
                    // hungry went on being hungry.
                    //
                    // A cart with nowhere better to be should still take grain to somebody short of
                    // grain. So: the scarce good if there is one, and the biggest surplus if not.
                    mutable int good = 0;
                    mutable int worth = 0;
                    for (int g in 1..ng) {
                        int over = this.stores.amountOf(c, g) - this.cwant[c * ng + g]
                                 - Simulation.KEEP_BACK;
                        if (over <= 0) {
                            continue;
                        }
                        mutable int useful = worst[g];
                        if (over < useful) {
                            useful = over;      // we cannot send what we have not got
                        }
                        if (useful > worth) {
                            worth = useful;
                            good = g;
                        }
                    }
                    if (good <= 0) {
                        mutable int pile = 0;
                        for (int g in 1..ng) {
                            int over = this.stores.amountOf(c, g) - this.cwant[c * ng + g]
                                     - Simulation.KEEP_BACK;
                            if (over > pile) {
                                pile = over;
                                good = g;
                            }
                        }
                        worth = pile;
                    }
                    int spare = worth;
                    if (good <= 0) {
                        continue;
                    }
                    // And whoever under the same flag is shortest of it, within a day's haul.
                    mutable int to = 0 - 1;
                    mutable int need = 0;
                    for (int d in 0..this.ncomm) {
                        if (d == c || this.cpop[d] <= 0) {
                            continue;
                        }
                        // Two harbours are neighbours however far apart they are and whoever they
                        // answer to; everything else is a cart on a road inside one country.
                        boolean sea = this.sails(c) && this.sails(d);
                        if (!sea && this.cnat[d] != nat) {
                            continue;
                        }
                        mutable int span = Simulation.TRADE_REACH;
                        if (sea && this.cport[c] < this.cport[d]) {
                            span = this.cport[c];      // the shorter of the two boats
                        } else if (sea) {
                            span = this.cport[d];
                        }
                        float dx = this.ccx[d] - this.ccx[c];
                        float dy = this.ccy[d] - this.ccy[c];
                        if (dx * dx + dy * dy > cast<float>(span * span)) {
                            continue;
                        }
                        int want = gap[d * ng + good];
                        if (want > need) {
                            need = want;
                            to = d;
                        }
                    }
                    if (to < 0) {
                        continue;
                    }
                    this.ccaravan[c] = to;
                    this.ccargo[c] = good;
                }
                delete gap;
                delete worst;
                return;
            }

            // The railway.
            //
            // Everything else about the ground in this world is emergent: a trail is where people
            // walked and a road is where enough of them did. A railway is the exception on purpose,
            // and it is the point at which a country stops being the sum of its villages. Nobody
            // wears a rail into the earth; somebody decides a LINE between two towns should exist,
            // and it exists because a state can hold an intention across more ground than any one
            // person can see.
            //
            // One cell a census, straight from the capital toward the biggest town it holds. Paid
            // for out of the capital's own shelves in stone and iron -- so a nation that has not
            // built the industry to make iron cannot have a railway however badly it wants one, and
            // reaching the third era is worth something concrete rather than a number going up.
            private method railway() returns void {
                for (int nat in 0..this.realm.limit()) {
                    if (!this.realm.alive(nat) || this.realm.eraOf(nat) < Simulation.RAIL_ERA) {
                        continue;
                    }
                    int seat = this.realm.seatOf(nat);
                    if (seat < 0) {
                        continue;
                    }
                    // Pick the far end once and keep it. A line that re-aimed itself every census
                    // because one town overtook another would be a spray of disconnected sleepers.
                    mutable int to = this.nrailTo[nat];
                    if (to < 0 || to >= this.ncomm || this.cpop[to] <= 0
                        || this.cnat[to] != nat || to == seat) {
                        to = 0 - 1;
                        mutable int most = 0;
                        for (int d in 0..this.ncomm) {
                            if (d == seat || this.cpop[d] <= 0 || this.cnat[d] != nat) {
                                continue;
                            }
                            if (this.cpop[d] > most) {
                                most = this.cpop[d];
                                to = d;
                            }
                        }
                        if (to < 0) {
                            continue;                // one town: nowhere to run a line to
                        }
                        this.nrailTo[nat] = to;
                        this.nrailAt[nat] = 0;
                    }
                    if (!this.stores.has(seat, cast<int>(Good.Stone), Simulation.RAIL_STONE)
                        || !this.stores.has(seat, cast<int>(Good.IronIngot),
                                            Simulation.RAIL_IRON)) {
                        continue;                    // it cannot afford the next sleeper yet
                    }
                    float ax = this.ccx[seat];
                    float ay = this.ccy[seat];
                    float bx = this.ccx[to];
                    float by = this.ccy[to];
                    float dx = bx - ax;
                    float dy = by - ay;
                    int span = cast<int>(Math.sqrt(cast<double>(dx * dx + dy * dy)));
                    if (span <= 1) {
                        continue;
                    }
                    mutable int at = this.nrailAt[nat];
                    if (at > span) {
                        continue;                    // the line is finished; nothing left to lay
                    }
                    // Walk forward until a cell that is not already rail, so a line whose middle was
                    // laid by an earlier stretch does not stall on it.
                    mutable boolean laid = false;
                    mutable int tries = 0;
                    while (at <= span && tries < Simulation.RAIL_SKIP) {
                        float t = cast<float>(at) / cast<float>(span);
                        int cx = cast<int>(ax + dx * t);
                        int cy = cast<int>(ay + dy * t);
                        at = at + 1;
                        tries = tries + 1;
                        if (this.paths.lay(cx, cy, cast<int>(Surface.Rail))) {
                            this.stores.take(seat, cast<int>(Good.Stone), Simulation.RAIL_STONE);
                            this.stores.take(seat, cast<int>(Good.IronIngot), Simulation.RAIL_IRON);
                            this.railed = this.railed + 1;
                            laid = true;
                            at = at;
                            tries = Simulation.RAIL_SKIP;
                        }
                    }
                    this.nrailAt[nat] = at;
                    if (!laid && at > span) {
                        continue;                    // the whole line already exists
                    }
                }
                return;
            }

            // The era a country can lay track in, what a sleeper costs, and how many already-laid
            // cells it will step over in one census before giving up for this second.
            public static int RAIL_ERA = 3;
            public static int RAIL_STONE = 3;
            public static int RAIL_IRON = 1;
            public static int RAIL_SKIP = 16;

            // Walking a load to the next town under the same flag.
            //
            // The road matters here and nowhere else in the world: everybody else walks to a tree
            // or a seam and comes back, and a carter walks the same line between the same two
            // places over and over. That is what wears a trail into a road, and the road is then
            // what makes the next haul faster -- the one loop in this simulation that pays for
            // itself.
            private method workTrade(int i) returns void {
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return;
                }
                if (this.folk.carryAmtOf(i) > 0) {
                    if (this.busy(i)) {
                        return;
                    }
                    mutable int to = this.folk.boundFor(i);
                    if (to < 0 || to >= this.ncomm || this.cpop[to] <= 0) {
                        to = h;                      // nowhere to take it; carry it back home
                    }
                    // A CARTER DOES NOT WALK ON WATER.
                    //
                    // Where both ends have a harbour the far town may be on another continent, so
                    // the leg a person does is the one they can do: to the quay in their own place.
                    // The load goes on from there, and the crossing is the boat's, not theirs --
                    // this world models the people who carry things, and a ship's crew is not among
                    // them. So the sea lane is honest about what it is: goods appear at the far
                    // port because a vessel took them, and nobody is animated walking over the sea.
                    mutable float tx = this.ccx[to];
                    mutable float ty = this.ccy[to];
                    boolean sailing = to != h && this.sails(h) && this.sails(to)
                                   && this.cportb[h] >= 0;
                    if (sailing) {
                        tx = cast<float>(this.town.xAt(this.cportb[h]));
                        ty = cast<float>(this.town.yAt(this.cportb[h]));
                    }
                    float dx = tx - this.folk.xAt(i);
                    float dy = ty - this.folk.yAt(i);
                    if (dx * dx + dy * dy < 4.0) {
                        int amt = this.folk.carryAmtOf(i);
                        this.stores.stow(to, this.folk.carryKindOf(i), amt);
                        this.trafficked = this.trafficked + cast<long>(amt);
                        this.carried = this.carried + cast<long>(amt);
                        this.folk.earn(i, 4);
                        // A LOAD THAT CROSSED A BORDER IS WORTH MORE THAN THE GOODS ON IT.
                        //
                        // This is the only warming term in the world, and it is deliberately the
                        // one thing that already happens rather than a new act somebody performs.
                        // Two countries that trade stop being worth marching on, so the sea lanes
                        // opened a slice ago turn out to be what ends wars -- and a country with no
                        // coast and no neighbours it can reach stays exactly as belligerent as it
                        // always was, which is the right answer rather than a missing one.
                        if (this.cnat[to] != this.cnat[h]) {
                            this.realm.warm(this.cnat[h], this.cnat[to], Simulation.BOND_PER_LOAD);
                            this.dealt = this.dealt + 1;
                        }
                        this.folk.setCarry(i, 0, 0);
                        this.folk.setBound(i, 0 - 1);
                        // The one moment in the world worth its own act: a caravan that has walked
                        // across a country setting its load down at the far end.
                        this.folk.setAct(i, cast<int>(Act.Deposit));
                        if (sailing) {
                            this.shipped = this.shipped + cast<long>(amt);
                        }
                    } else {
                        this.folk.setTarget(i, cast<int>(tx), cast<int>(ty));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                    }
                    return;
                }
                if (this.busy(i)) {
                    return;
                }
                int to = this.ccaravan[h];
                int good = this.ccargo[h];
                if (to < 0 || good <= 0) {
                    this.folk.setJob(i, cast<int>(Job.Idle));
                    return;                          // nothing spare and nobody wanting
                }
                float dx = this.ccx[h] - this.folk.xAt(i);
                float dy = this.ccy[h] - this.folk.yAt(i);
                if (dx * dx + dy * dy >= 4.0) {
                    this.folk.setTarget(i, cast<int>(this.ccx[h]), cast<int>(this.ccy[h]));
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                int got = this.stores.take(h, good, this.loadOf(h));
                if (got <= 0) {
                    this.folk.setThinkAt(i, this.tick + 40);
                    return;
                }
                this.folk.setCarry(i, good, got);
                this.folk.setBound(i, to);
                this.folk.setTarget(i, cast<int>(this.ccx[to]), cast<int>(this.ccy[to]));
                this.folk.setAct(i, cast<int>(Act.WalkTo));
                this.caravans = this.caravans + 1;
                return;
            }

            // How much one of them carries. A back, then a handcart, then a wagon and a horse: the
            // era is the difference, and it is the plainest thing a people gains by reaching one.
            private method loadOf(int c) returns int {
                int era = this.eraOf(c);
                if (era >= 3) {
                    return Simulation.HAUL * 4;
                }
                if (era >= 2) {
                    return Simulation.HAUL * 2;
                }
                return Simulation.HAUL;
            }

            // Two towns before anybody carries anything between them, how far a haul goes, what a
            // place keeps back before it calls anything spare, and what one carter shifts.
            public static int TRADE_TOWNS = 2;
            public static int TRADE_REACH = 260;
            public static int KEEP_BACK = 40;
            public static int HAUL = 20;

            // What a want IMPLIES, down the chain that answers it.
            //
            // This is the term the whole industrial half of the world was missing. `wants` reads
            // demand off the benches that are standing: a bakery wants grain, a smithy wants ore.
            // Nothing anywhere said that a village which wants a TENEMENT therefore wants bricks,
            // and therefore wants clay -- so brick had no want, clay had no want, and the only
            // things ever built were the ones whose output somebody eats or holds. Twenty-two goods
            // were never produced in a twenty-generation arc, one kiln stood in the entire world,
            // and no weapon was ever made because Weaponsmith needs iron, iron needs a smithy, and
            // a smithy is built out of brick.
            //
            // So a want is exploded: whatever the place wants, it also wants the inputs of whatever
            // would make it, in proportion, and that again, four levels down -- which is deeper than
            // the longest chain in the catalogue. It stops at anything nobody makes, which is
            // exactly the goods that come out of the ground.
            //
            // Once a census over a hundred and thirty places and sixty goods. The alternative --
            // asking it per building kind per place per decision -- is the woodcutter's mistake in
            // a new coat.
            private method explode() returns void {
                int ng = Goods.count();
                // The wants nobody's bench asked for: a roof over the people still under sticks, a
                // tool in every hand that can hold one, and arms for everybody carrying a grudge.
                // They were read at the point of scoring before, which is why they never travelled
                // any further than the good they named.
                // Everybody under each flag who has taken up a spear, counted once.
                mutable int[] natArms = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    int nat = this.cnat[c];
                    if (nat >= 0 && nat < this.ncomm) {
                        natArms[nat] = natArms[nat]
                                     + this.ctrade[c * Job.count() + cast<int>(Job.Raider)];
                    }
                }
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    int era = this.eraOf(c);
                    int roof = Builds.bestRoof(era);
                    if (roof != cast<int>(BuildingKind.NoBuilding) && Builds.roof(roof) > 0) {
                        int mat = Builds.matCost(roof);
                        int unroofed = this.cpop[c] - this.croom[c];
                        if (mat > 0 && unroofed > 0) {
                            int n = Builds.matCostN(roof) * unroofed / Builds.roof(roof);
                            this.cwant[c * ng + mat] = this.cwant[c * ng + mat] + n;
                        }
                    }
                    int tools = cast<int>(Good.Tools);
                    this.cwant[c * ng + tools] = this.cwant[c * ng + tools] + this.handsWanting(c);
                    // WHAT A BUILDING IS MADE OF, and not only what it eats.
                    //
                    // This is the term that was missing and it is the whole of the metal chain. A
                    // smithy costs twelve BRICK to raise; nothing anywhere wanted brick on that
                    // account, so no kiln was ever built, so no brick existed, so no smithy did --
                    // and with no smithy there is no iron, with no iron no weapon and no sleeper.
                    // A measured arc: one kiln in the whole world, nought armed, nought in mail,
                    // twenty-nine railways begun and nought track laid.
                    //
                    // Enough for ONE of each thing the place could raise, which is the same bound
                    // the input seed uses and for the same reason: a village looking at what it
                    // might become rather than only at what it already is. It goes through the
                    // explosion below, so wanting a smithy makes it want the brick, and wanting the
                    // brick makes it want the clay.
                    //
                    // FLAT, and measured that way. Scaling it by the town's size is the obvious next
                    // move and it was tried: kilns went three to thirteen and sawmills sixty-eight
                    // to a hundred and ninety-two, and the SMITHIES WENT TO NONE -- workshops pulled
                    // down nearly tripled, the modern nations halved, and the twenty cells of
                    // railway the world had just managed to lay went back to nought. A place that
                    // wants materials in proportion to its size spends its whole life raising and
                    // demolishing sheds. It is the third time inflating a want deep in a chain has
                    // made everything above it worse, and the third time it has been reverted.
                    for (int k in 1..BuildingKind.count()) {
                        if (Builds.era(k) > era) {
                            continue;
                        }
                        int mat = Builds.matCost(k);
                        if (mat > 0 && Builds.matCostN(k) > 0) {
                            this.cwant[c * ng + mat] = this.cwant[c * ng + mat] + Builds.matCostN(k);
                        }
                    }
                    // ARMING IS A NATION'S BUSINESS, AND THIS IS WHY NOBODY EVER CARRIED A WEAPON.
                    //
                    // Counted per village it comes to about twenty, and twenty is the number that
                    // has been quietly blocking the entire industrial half of this world. Follow it
                    // down: twenty weapons is six weaponsmith batches, which is twenty-four iron,
                    // so a smithy is worth twenty-four to build -- and WANT, the least a village
                    // will get out of bed for, is SIXTY. Every derived want in the deep chain came
                    // out under the bar while food and tools, which scale with mouths and hands,
                    // came out in the hundreds. Four smithies in a world of a hundred and thirty
                    // towns, twenty ingots of iron in twenty generations, and not one armoury.
                    //
                    // A capital does not arm its own street. It arms the ARMY, and the army is
                    // everybody under the flag who has taken up a spear -- which is the shape the
                    // muster already uses to decide who arms in the first place. Same fact, read at
                    // the level it is actually true at.
                    // A quay wants a hull. Nothing else in the world wants a boat, so without this
                    // the shipwright has no output anybody is short of and the yard is never raised
                    // -- the harbour would stand there being a word.
                    if (this.cport[c] > 0) {
                        int bt = cast<int>(Good.Boat);
                        this.cwant[c * ng + bt] = this.cwant[c * ng + bt] + 1;
                    }
                    int arms = this.ctrade[c * Job.count() + cast<int>(Job.Raider)];
                    mutable int wants = arms;
                    if (this.realm.seatOf(this.cnat[c]) == c) {
                        wants = natArms[this.cnat[c]];
                    }
                    if (wants > 0) {
                        int wp = cast<int>(Good.Weapon);
                        int ar = cast<int>(Good.Armour);
                        this.cwant[c * ng + wp] = this.cwant[c * ng + wp] + wants;
                        this.cwant[c * ng + ar] = this.cwant[c * ng + ar] + wants;
                    }
                }
                // And then the explosion itself, one level per round, breadth first.
                //
                // Only what was added LAST round is exploded this round. Exploding the whole running
                // total each time would put the original want through the chain once per level, so
                // four rounds would multiply the bottom of a chain by four -- and a village would
                // want more clay than there is clay because it wants a house.
                mutable int[] front = new int[this.ncomm * ng]();
                mutable int[] added = new int[this.ncomm * ng]();
                for (int s in 0..this.ncomm * ng) {
                    front[s] = this.cwant[s];
                }
                mutable int round = 0;
                while (round < Simulation.CHAIN_DEPTH) {
                    for (int s in 0..this.ncomm * ng) {
                        added[s] = 0;
                    }
                    for (int c in 0..this.ncomm) {
                        if (this.cpop[c] <= 0) {
                            continue;
                        }
                        int era = this.eraOf(c);
                        for (int g in 1..ng) {
                            int want = front[c * ng + g];
                            if (want <= 0) {
                                continue;
                            }
                            int k = Builds.makerOf(g, era);
                            if (k < 0) {
                                continue;        // it comes out of the ground; the chain ends here
                            }
                            int batches = want / Builds.nout(k) + 1;
                            int a = Builds.in1(k);
                            if (a > 0) {
                                added[c * ng + a] = added[c * ng + a] + Builds.n1(k) * batches;
                            }
                            int b = Builds.in2(k);
                            if (b > 0) {
                                added[c * ng + b] = added[c * ng + b] + Builds.n2(k) * batches;
                            }
                        }
                    }
                    for (int s in 0..this.ncomm * ng) {
                        this.cwant[s] = this.cwant[s] + added[s];
                        front[s] = added[s];
                    }
                    round = round + 1;
                }
                delete natArms;
                delete front;
                delete added;
                return;
            }

            // How far down a want travels. Four: one more than the longest chain the catalogue has
            // (ore to ingot to weapon, clay to brick to a wall that holds), so nothing is left
            // unreachable and nothing is exploded twice for no reason.
            public static int CHAIN_DEPTH = 4;

            private method shortOf(int c, int good) returns int {
                if (good <= 0) {
                    return 0;
                }
                int ng = Goods.count();
                mutable int want = this.cwant[c * ng + good];
                if (Goods.edible(good)) {
                    // One hunger, as a rate: what this many mouths eat in ten seconds against what
                    // the food buildings put on the table in ten. Counted per good, every food
                    // building saw the whole shortfall alone; counted as a stock, no amount of
                    // building ever answered it. Both were measured, and both ended with a village
                    // of nothing but pastures.
                    int eats = this.cpop[c] * 10 / cast<int>(Simulation.HUNGER_EVERY + 1.0);
                    // No multiplier on it. Scaling the food gap by the larder made it eight times
                    // any other want in the world, so a village that was one pasture short of fed
                    // still wanted a pasture more than it wanted the sawmill it had no planks for.
                    // Wants are compared against each other, so they have to be in the same units.
                    if (eats > this.cfed[c]) {
                        want = want + eats - this.cfed[c];
                    }
                    return want;                 // a rate answered by a rate: no stock term here
                }
                // A village is always building something, and everything is built out of these two.
                if (good == cast<int>(Good.Wood)) {
                    want = want + this.cpop[c];
                }
                if (good == cast<int>(Good.Stone)) {
                    want = want + this.cpop[c] / 2;
                }
                // The roof material, a tool in every hand and arms for everybody carrying a grudge
                // used to be read HERE, which is precisely why they never travelled: a want that
                // exists only at the moment somebody asks about that one good cannot imply anything
                // about the good below it. They are seeded into `explode` now, along with the whole
                // chain each of them pulls, and arrive in `cwant` already exploded.
                //
                // A CHAIN HAS TO BE ABLE TO START.
                //
                // Want read purely off what is standing deadlocks every chain in the catalogue:
                // nobody wants planks until something that eats planks exists, and nothing that
                // eats planks can be built without planks. A measured arc went from four goods
                // never produced to twenty-seven -- the sawmill, the kiln, the weaver and the
                // smokehouse all died at once, and the world reverted to pasture and shrines.
                //
                // So a place also wants a little of whatever it COULD use: enough of it to run one
                // batch of anything it already knows how to build. That is a village looking at
                // what it might become rather than only at what it is, and it is the smallest term
                // that breaks the circle.
                mutable int seed = 0;
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.era(k) > this.eraOf(c)) {
                        continue;
                    }
                    if (Builds.in1(k) == good) {
                        seed = seed + Builds.n1(k);
                    }
                    if (Builds.in2(k) == good) {
                        seed = seed + Builds.n2(k);
                    }
                }
                want = want + seed;
                int have = this.stores.amountOf(c, good);
                if (want <= have) {
                    return 0;
                }
                return want - have;
            }

            // The good a harvest class mostly brings home. A mine yields ten different metals and a
            // forest a dozen woods, so this is the one the shortage is judged on -- an
            // approximation, and the honest kind: a village that is short of iron is short of
            // MINING, and which vein the pick lands in is not a decision anybody makes.
            public static method staple(int hclass) returns int {
                if (hclass == cast<int>(Harvest.Timber)) {
                    return cast<int>(Good.Wood);
                }
                if (hclass == cast<int>(Harvest.Quarry)) {
                    return cast<int>(Good.Stone);
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return cast<int>(Good.IronOre);
                }
                return cast<int>(Good.Nothing);
            }

            // Grown people here in a trade a tool is any use to.
            private method handsWanting(int c) returns int {
                int nj = Job.count();
                mutable int t = 0;
                for (int jb in 1..nj) {
                    if (Simulation.toolTrade(jb)) {
                        t = t + this.ctrade[c * nj + jb];
                    }
                }
                return t;
            }

            // Somewhere near the middle, on ground you can stand on. Returns true if a site was
            // actually marked out -- a village hemmed in by cliffs and water can want a thing it has
            // nowhere to put, and that has to read as "did not build" rather than as a silent
            // success.
            private method markNear(int c, int k) returns boolean {
                int ground = Builds.site(k);
                // A workshop goes in the village; a field does not. Husbandry reaches out to where
                // the ground is right for it -- which is why the search widens, and why a village
                // beside a river ends up ringed with fields while one on a mountainside never grows
                // any. That asymmetry is the whole reason geography keeps mattering after farming
                // arrives instead of stopping the day it does.
                mutable float near = 4.0;
                mutable float span = 10.0;
                mutable int tries = 10;
                if (ground != cast<int>(Ground.Anywhere)) {
                    near = 6.0;
                    span = 34.0;
                    tries = 24;
                }
                mutable int t = 0;
                while (t < tries) {
                    float a = LandMath.hash01(this.seed ^ 0x7C3B, c * 31 + t, this.tick) * 6.2831853;
                    float d = near + LandMath.hash01(this.seed ^ 0x51A9, c * 17 + t, this.tick) * span;
                    int px = cast<int>(this.ccx[c] + LandMath.cos(a) * d);
                    int py = cast<int>(this.ccy[c] + LandMath.sin(a) * d);
                    if (this.groundOk(px, py, ground)) {
                        // A full table is a refusal like any other. The first version took `mark`
                        // on trust and reported three hundred thousand plots marked out against
                        // four thousand rows -- the counter was measuring how often the world had
                        // run out of room, and calling it building.
                        int b = this.town.mark(px, py, k, c);
                        if (b < 0) {
                            return false;
                        }
                        this.cbusy[c] = b;           // it is the thing being finished now
                        return true;
                    }
                    t = t + 1;
                }
                return false;
            }

            // May this kind of building stand on this cell?
            //
            // Almost everything asks only that you can stand there. Husbandry asks about the ground
            // itself, and that is the point of the Ground enum existing: a farm on a glacier is not
            // a farm, and a world where it could be would make geography stop mattering the moment
            // agriculture arrived. Where the fields can go is where the cities will be.
            public method groundOk(int x, int y, int ground) returns boolean {
                if (!this.walkable(x, y)) {
                    return false;
                }
                if (ground == cast<int>(Ground.Anywhere)) {
                    return true;
                }
                int b = this.g.biomeAt(x, y);
                if (ground == cast<int>(Ground.Waterside)) {
                    return this.g.hasFlag(x, y, Grid.FLAG_COAST)
                        || this.g.hasFlag(x, y, Grid.FLAG_RIVER)
                        || this.g.hasFlag(x, y, Grid.FLAG_LAKE);
                }
                // The sea and nothing else. A jetty on a lake is a jetty to nowhere, and the whole
                // worth of a harbour is the far side of the water having somebody on it.
                if (ground == cast<int>(Ground.Coast)) {
                    return this.g.hasFlag(x, y, Grid.FLAG_COAST);
                }
                if (ground == cast<int>(Ground.Rock)) {
                    return b == cast<int>(Biome.Hills) || b == cast<int>(Biome.Mountain)
                        || b == cast<int>(Biome.Badlands) || b == cast<int>(Biome.RockyShore)
                        || b == cast<int>(Biome.Volcanic);
                }
                boolean open = b == cast<int>(Biome.WarmGrassland) || b == cast<int>(Biome.Prairie)
                            || b == cast<int>(Biome.Steppe) || b == cast<int>(Biome.Savanna)
                            || b == cast<int>(Biome.MedShrubland);
                if (ground == cast<int>(Ground.Grazing)) {
                    // Animals eat what people cannot. Thin cold ground and scrub are pasture and
                    // nothing else, which is what makes the herding half of husbandry worth having
                    // rather than a second, worse farm.
                    return open || b == cast<int>(Biome.Tundra) || b == cast<int>(Biome.ColdDesert)
                        || b == cast<int>(Biome.ThornScrub) || b == cast<int>(Biome.AlpineMeadow);
                }
                // Arable: open ground WITH WATER within reach of it. Every early civilisation grew
                // in a river valley and none grew in the middle of a steppe, and the reason is this
                // line -- a field that cannot be watered is grazing.
                if (!open && b != cast<int>(Biome.Oasis) && b != cast<int>(Biome.Marsh)) {
                    return false;
                }
                return this.waterNear(x, y);
            }

            // Is there water within a field's reach? Sampled on rings rather than swept, because
            // this is asked ten to twenty times per building decision and the answer only has to be
            // right about a neighbourhood, not about a cell.
            private method waterNear(int x, int y) returns boolean {
                mutable int r = 3;
                while (r <= Simulation.WATER_REACH) {
                    mutable int s = 0;
                    while (s < 8) {
                        float a = cast<float>(s) * 0.7853981;
                        int px = x + cast<int>(LandMath.cos(a) * cast<float>(r));
                        int py = y + cast<int>(LandMath.sin(a) * cast<float>(r));
                        if (px >= 0 && py >= 0 && px < this.g.width() && py < this.g.height()) {
                            if (this.g.hasFlag(px, py, Grid.FLAG_RIVER)
                                || this.g.hasFlag(px, py, Grid.FLAG_LAKE)
                                || this.g.hasFlag(px, py, Grid.FLAG_COAST)) {
                                return true;
                            }
                        }
                        s = s + 1;
                    }
                    r = r + 3;
                }
                return false;
            }

            // How far a field may be from water, in cells. Twelve: a walk with a bucket, and near
            // enough that the belt of arable ground round a river reads as a shape on the map.
            public static int WATER_REACH = 12;

            // Shelter, and the one place in the catalogue where a building is REPLACED rather than
            // added to. Two rules and no third:
            //
            //   1. Pressure is people without a roof. No pressure, no building -- a village does not
            //      raise houses on speculation, and one that has emptied out stops.
            //   2. Rebuild before you sprawl. A hut still standing in a place that has learnt to
            //      raise houses is the cheapest roof it can gain: the ground is cleared and the plot
            //      is already where the people are. Only when every plot is the best the era allows
            //      does the village spread outward.
            //
            // That second rule is what makes the map legible from above. A place that is thriving
            // and a place that is merely large look different -- the first is dense and tall, the
            // second is a scatter of huts -- and the difference is visible without a single number.
            private method considerHousing(int c) returns boolean {
                int best = Builds.bestRoof(this.eraOf(c));
                if (best == cast<int>(BuildingKind.NoBuilding)) {
                    return false;
                }
                if (this.croom[c] >= this.cpop[c]) {
                    return false;
                }
                if (!this.stores.has(c, cast<int>(Good.Wood), Builds.woodCost(best))) {
                    return false;
                }
                if (!this.stores.has(c, cast<int>(Good.Stone), Builds.stoneCost(best))) {
                    return false;
                }
                if (Builds.matCost(best) != cast<int>(Good.Nothing)
                    && !this.stores.has(c, Builds.matCost(best), Builds.matCostN(best))) {
                    // A village that has learned to raise houses but has no sawmill goes on living
                    // in huts, and wanting planks. That want is the sawmill's whole reason to be.
                    return false;
                }
                if (this.cworst[c] >= 0 && this.cworstRoom[c] < Builds.roof(best)) {
                    this.town.recast(this.cworst[c], best);
                    this.cbusy[c] = this.cworst[c];  // it is a site again until somebody raises it
                    this.cworst[c] = 0 - 1;
                    this.rebuilt = this.rebuilt + 1;
                    return true;
                }
                if (this.markNear(c, best)) {
                    this.housed = this.housed + 1;
                    return true;
                }
                return false;
            }

            // THE TIME OF YEAR, as a hundredth of a normal harvest.
            //
            // This world had no seasons at all: food was as easy in one second as in any other, so
            // a granary was a place to put a surplus rather than the thing that gets a village
            // through to spring, and the whole reason for storing anything was missing.
            //
            // A year is ninety seconds against a six-minute life, so somebody sees four of them --
            // which is the right feel at this scale: a season is a thing that happens to you several
            // times, not once. The curve runs from forty in deep winter to a hundred and sixty at
            // harvest, so a good year is four times a bad one and a village that did not put
            // anything by is in trouble every fourth minute of its life.
            //
            // Read off the world clock and nothing else, so it is the same number everywhere at
            // once: this is a world with one sun in it, and a famine is something that happens to
            // everybody at the same time. That is what makes trade between countries worth having
            // rather than an arbitrage nobody would notice.
            public method season() returns int {
                float year = this.clock / Simulation.YEAR;
                float phase = year - cast<float>(cast<int>(year));
                // A triangle rather than a sine: cheap, and the shape of a growing season is closer
                // to a ramp than to a wave anyway.
                mutable float up = phase * 2.0;
                if (phase > 0.5) {
                    up = (1.0 - phase) * 2.0;
                }
                return 40 + cast<int>(up * 120.0);
            }

            public static float YEAR = 90.0;

            // The worst the land got over the whole run, for the report and the tests.
            public method leanestSeason() returns int {
                return this.leanest;
            }

            // Is there fresh water within a short walk of this place? The sea does not count and the
            // reason is the oldest one there is: you cannot drink it.
            //
            // Read on a lattice rather than every cell -- a river is many cells wide in the walk
            // that matters, so sampling every fourth one finds it and costs a sixteenth. Once a
            // census per town, never per person.
            private method freshAt(int c) returns boolean {
                int cx = cast<int>(this.ccx[c]);
                int cy = cast<int>(this.ccy[c]);
                mutable int dy = 0 - Simulation.FRESH_REACH;
                while (dy <= Simulation.FRESH_REACH) {
                    mutable int dx = 0 - Simulation.FRESH_REACH;
                    while (dx <= Simulation.FRESH_REACH) {
                        int x = cx + dx;
                        int y = cy + dy;
                        if (x >= 0 && y >= 0 && x < this.g.width() && y < this.g.height()) {
                            if (this.g.hasFlag(x, y, Grid.FLAG_RIVER)
                                || this.g.hasFlag(x, y, Grid.FLAG_LAKE)) {
                                return true;
                            }
                        }
                        dx = dx + 4;
                    }
                    dy = dy + 4;
                }
                return false;
            }

            // How far somebody will walk for a drink before the village decides to bring the water
            // to itself instead.
            public static int FRESH_REACH = 24;

            // Is there a mouth of the earth within a walk of here? A vent the generator marked, or
            // ground the biome map calls volcanic -- the same lattice stride the water search uses,
            // and for the same reason: a village is an area, not a point.
            private method ventAt(int c) returns boolean {
                int cx = cast<int>(this.ccx[c]);
                int cy = cast<int>(this.ccy[c]);
                mutable int dy = 0 - Simulation.VENT_REACH;
                while (dy <= Simulation.VENT_REACH) {
                    mutable int dx = 0 - Simulation.VENT_REACH;
                    while (dx <= Simulation.VENT_REACH) {
                        int x = cx + dx;
                        int y = cy + dy;
                        if (x >= 0 && y >= 0 && x < this.g.width() && y < this.g.height()) {
                            if (this.g.hasFlag(x, y, Grid.FLAG_VENT)
                                || this.g.biomeAt(x, y) == cast<int>(Biome.Volcanic)) {
                                return true;
                            }
                        }
                        dx = dx + 4;
                    }
                    dy = dy + 4;
                }
                return false;
            }

            // Ground that has been folded, and so is ground that can still move. Read at the centre
            // rather than searched: a town in the hills is in the hills.
            private method brokenAt(int c) returns boolean {
                int cx = cast<int>(this.ccx[c]);
                int cy = cast<int>(this.ccy[c]);
                if (cx < 0 || cy < 0 || cx >= this.g.width() || cy >= this.g.height()) {
                    return false;
                }
                int b = this.g.biomeAt(cx, cy);
                return b == cast<int>(Biome.Hills) || b == cast<int>(Biome.Mountain)
                    || b == cast<int>(Biome.AlpineMeadow) || b == cast<int>(Biome.SnowPeak)
                    || b == cast<int>(Biome.Volcanic) || b == cast<int>(Biome.Badlands);
            }

            // How far a village looks for the mountain that might kill it. Wider than the water
            // search: a village does not have to be able to WALK to a volcano to be under it.
            public static int VENT_REACH = 40;

            // THE WORLD'S OWN HAND, once a census per place.
            //
            // Fates decides what happens and this decides who it happens to -- the same split as
            // every catalogue in this codebase, and it is what keeps a calamity from being a
            // hard-coded lump of arithmetic buried in the census.
            private method befall(int c) returns void {
                if (this.cpop[c] <= 0 || this.csettle[c] > 0) {
                    return;                 // an expedition on the road is nobody's town yet
                }
                // How much town there is to burn, read off the roof the census already counted.
                int roofs = this.croom[c] / 4;
                int kind = this.fates.visit(c, this.ventAt(c), this.brokenAt(c), this.cfresh[c],
                                            this.stores.amountOf(c, cast<int>(Good.Boat)) > 0,
                                            roofs, this.cwells[c], this.seed, this.tick);
                if (kind == cast<int>(Calamity.Nothing)) {
                    return;
                }
                mutable int down = 0;
                mutable int dead = 0;
                if (kind == cast<int>(Calamity.Eruption)) {
                    // It does not care what a building was for. Everything within reach of the
                    // mouth, and a quarter of the people who were in it.
                    down = this.level(c, 40, false);
                    dead = this.perish(c, 4);
                    this.spoil(c, 2);
                } else if (kind == cast<int>(Calamity.Quake)) {
                    // A quake takes the walls down and leaves the plot. That is why it is a `recast`
                    // and not a demolition: the village rebuilds what it had, on the ground it had
                    // it on, and the cost is the years of work rather than the place itself.
                    down = this.level(c, 24, true);
                    dead = this.perish(c, 30);
                } else if (kind == cast<int>(Calamity.Fire)) {
                    down = this.level(c, 12, false);
                    dead = this.perish(c, 50);
                    this.spoil(c, 3);
                } else if (kind == cast<int>(Calamity.Flood)) {
                    // Water takes the granary before it takes the roof.
                    down = this.level(c, 5, true);
                    dead = this.perish(c, 60);
                    this.spoil(c, 2);
                } else {
                    // A storm takes what was floating in it.
                    int hulls = this.stores.amountOf(c, cast<int>(Good.Boat));
                    this.stores.take(c, cast<int>(Good.Boat), hulls);
                    dead = this.perish(c, 80);
                }
                this.fates.cost(kind, dead, down);
                return;
            }

            // Pull down up to `most` of a place's buildings, nearest the middle first in the only
            // sense that matters here -- the order the table holds them, which is the order they
            // were raised. `keepPlot` recasts instead of demolishing: the ground stays claimed and
            // the village rebuilds what stood there.
            private method level(int c, int most, boolean keepPlot) returns int {
                mutable int down = 0;
                mutable int b = 0;
                while (b < this.town.count() && down < most) {
                    if (!this.town.isGone(b) && this.town.ownerOf(b) == c
                        && this.town.kindOf(b) != cast<int>(BuildingKind.TownHall)) {
                        if (keepPlot) {
                            this.town.recast(b, this.town.kindOf(b));
                        } else {
                            this.town.demolish(b);
                        }
                        down = down + 1;
                    }
                    b = b + 1;
                }
                return down;
            }

            // One in `oneIn` of the people at home. Walked over the whole table because that is
            // where people are -- and only ever on the census where something actually happened,
            // which over a full arc is a few hundred passes rather than one a second.
            private method perish(int c, int oneIn) returns int {
                mutable int dead = 0;
                mutable int seen = 0;
                mutable int i = 0;
                while (i < this.folk.limit()) {
                    if (this.folk.alive(i) && this.folk.homeOf(i) == c) {
                        if (seen % oneIn == 0) {
                            this.vacate(i, c);
                            this.folk.kill(i);
                            this.deathsWorld = this.deathsWorld + 1;
                            dead = dead + 1;
                        }
                        seen = seen + 1;
                    }
                    i = i + 1;
                }
                return dead;
            }

            // A share of everything on the shelves, gone. Not the whole store: a place that loses
            // everything it has starves to death rather than recovering, and a calamity that ends
            // the town is a calamity nobody ever sees the aftermath of.
            private method spoil(int c, int part) returns void {
                for (int g in 1..Goods.count()) {
                    int had = this.stores.amountOf(c, g);
                    if (had > 0) {
                        this.stores.take(c, g, had / part);
                    }
                }
                return;
            }

            // WATER COMES BEFORE A TRADE, for the same reason a roof does.
            //
            // A place with more mouths than it can keep in water has one want and it is not a
            // brewery. This is shaped like considerHousing and not like a workshop because that is
            // what a well IS: it makes room for people rather than a good, exactly as a hut does.
            //
            // Where it bites is dry ground. A village on a river never enters this method at all;
            // a village on the steppe answers it every census until it has dug enough. That is the
            // asymmetry the whole line exists for -- it puts a price on ground that looked free,
            // and it is why the second era is worth reaching for a people who settled badly.
            private method considerWater(int c) returns boolean {
                if (this.cdrink[c] >= this.cpop[c]) {
                    return false;
                }
                int best = Builds.bestWater(this.eraOf(c), this.cfresh[c]);
                if (best == cast<int>(BuildingKind.NoBuilding)) {
                    return false;
                }
                if (!this.stores.has(c, cast<int>(Good.Wood), Builds.woodCost(best))) {
                    return false;
                }
                if (!this.stores.has(c, cast<int>(Good.Stone), Builds.stoneCost(best))) {
                    return false;
                }
                if (Builds.matCost(best) != cast<int>(Good.Nothing)
                    && !this.stores.has(c, Builds.matCost(best), Builds.matCostN(best))) {
                    return false;
                }
                if (this.markNear(c, best)) {
                    this.watered = this.watered + 1;
                    return true;
                }
                return false;
            }

            // AND THEN SOMETHING AGAINST BEING ILL, once there is a roof and a drink.
            //
            // Third in the order and not first, because that is the order the wants actually come
            // in: a place with nobody under a roof has a crowding problem it will not cure with a
            // bathhouse, and the bathhouse it would have built instead is the roof it did not.
            // Sickness here is downstream of crowding and dirty water by construction, so the two
            // things that answer it come first and this catches what is left.
            //
            // Gated on somebody actually being ill. A healthy town builds nothing, which is why a
            // world with clean water and room to spare never sees an apothecary -- and that is the
            // right answer rather than a missing one.
            private method considerCare(int c) returns boolean {
                if (this.cfilth[c] <= 0) {
                    return false;
                }
                if (this.ccare[c] >= this.cpop[c]) {
                    return false;
                }
                int best = Builds.bestCare(this.eraOf(c));
                if (best == cast<int>(BuildingKind.NoBuilding)) {
                    return false;
                }
                if (!this.stores.has(c, cast<int>(Good.Wood), Builds.woodCost(best))) {
                    return false;
                }
                if (!this.stores.has(c, cast<int>(Good.Stone), Builds.stoneCost(best))) {
                    return false;
                }
                if (Builds.matCost(best) != cast<int>(Good.Nothing)
                    && !this.stores.has(c, Builds.matCost(best), Builds.matCostN(best))) {
                    return false;
                }
                if (this.markNear(c, best)) {
                    this.tended = this.tended + 1;
                    return true;
                }
                return false;
            }

            // Enough of an input piling up to be worth a workshop.
            public static int WANT = 60;

            // How many of a community's grown people should be in one trade. Everybody doing the same
            // thing is not a village, and it is also the fastest way to strip a resource: the first
            // measurement had thirty-two thousand woodcutters take ninety-one per cent of the world's
            // trees in one arc. A share per trade, with a floor, so a small place still fishes.
            private method quotaFor(int c, int job) returns int {
                int adults = this.cadults[c];
                if (adults <= 0) {
                    return 0;
                }
                // Nobody carries a spear in peacetime. A raider is not a standing profession in this
                // world -- it is what a place puts its hands to while it has somebody to fight, and
                // the trade empties again when the quarrel does. Being raided is worth more hands
                // than raiding: an attacker chooses the day, a defender does not.
                if (job == cast<int>(Job.Raider)) {
                    mutable int arms = 0;
                    if (this.craided[c] > 0) {
                        arms = adults / 4;
                    } else if (this.cfoe[c] >= 0) {
                        arms = adults / 8;
                    }
                    // The muster. A town with no quarrel of its own still sends people when its
                    // NATION calls, and that is the whole difference between a country and a
                    // collection of villages -- it is why an army is ever bigger than one village's
                    // grudge, and it is the only reason a place at peace ever arms at all.
                    if (this.mustering(this.cnat[c]) >= 0) {
                        int levy = adults / 5;
                        if (levy > arms) {
                            arms = levy;
                        }
                    }
                    // A barracks keeps some under arms whether or not there is anybody to fight --
                    // the first standing soldiers in the world, and the reason a place that has one
                    // is never caught with nobody holding a spear.
                    if (this.cbarr[c] > 0) {
                        int kept = this.cbarr[c] * Simulation.KEPT;
                        if (kept > arms) {
                            arms = kept;
                        }
                    }
                    return arms;
                }
                // Carters. Nobody walks a load to the next town when there is no next town, and a
                // country that has one organising the routes puts twice as many on the road --
                // which is the whole of what a trade chief is worth and is measured, not asserted.
                if (job == cast<int>(Job.Trader)) {
                    int nat = this.cnat[c];
                    if (this.realm.townsOf(nat) < Simulation.TRADE_TOWNS) {
                        return 0;
                    }
                    if (this.ccaravan[c] < 0) {
                        return 0;                    // nothing spare here and nobody wanting it
                    }
                    int seat = this.realm.seatOf(nat);
                    if (seat >= 0 && this.ctchief[seat] >= 0) {
                        return adults / 6;
                    }
                    return adults / 12;
                }
                mutable int q = adults / 6;
                // Except that a hungry place puts most of its hands on food. A flat share of the
                // adults for every trade is what a spreadsheet does, not what people do: the first
                // measurement had a sixth of each village foraging while the larder was empty seventy
                // million times over, and the world died out in nineteen generations with woodcutters
                // still dutifully cutting wood.
                if (job == cast<int>(Job.Forager) || job == cast<int>(Job.Fisher)
                    || job == cast<int>(Job.Hunter)) {
                    if (this.stores.foodOf(c) < this.cpop[c] * Simulation.LARDER) {
                        q = adults / 2;
                    }
                }
                if (q < 2) {
                    q = 2;
                }
                return q;
            }

            // How long one load takes, and how much of it comes away. Picking berries is not felling
            // an oak and neither is cutting into a seam: giving them all the same eighteen seconds
            // said a forager feeds about as many mouths as a woodcutter fills woodsheds, which is how
            // a world with plenty of berries in it starved to death.
            // Take up whatever the village has that this person's work wants.
            //
            // Asked when somebody picks a trade, which is the moment they would actually walk to
            // the store and pick something up -- not every tick, and not by a sweep over the whole
            // population. A tool comes out of the shelves like any other good, so a place that has
            // not learned to make them simply does without, and the first village to raise a
            // toolsmith is visibly better at everything within a generation.
            private method kitUp(int i, int h) returns void {
                int jb = this.folk.jobOf(i);
                if (!this.folk.hasKit(i, AgentTable.K_TOOL) && Simulation.toolTrade(jb)) {
                    if (this.stores.take(h, cast<int>(Good.Tools), 1) > 0) {
                        this.folk.equip(i, AgentTable.K_TOOL, Simulation.TOOL_LIFE);
                        this.tooled = this.tooled + 1;
                    }
                }
                // Arms and mail are for the people who will be hit. Handing a spear to a baker
                // would empty an armoury into a kitchen.
                if (jb != cast<int>(Job.Raider) && jb != cast<int>(Job.General)) {
                    return;
                }
                if (!this.folk.hasKit(i, AgentTable.K_WEAPON)) {
                    if (this.stores.take(h, cast<int>(Good.Weapon), 1) > 0) {
                        this.folk.equip(i, AgentTable.K_WEAPON, 0);
                        this.armed = this.armed + 1;
                    }
                }
                if (!this.folk.hasKit(i, AgentTable.K_ARMOUR)) {
                    if (this.stores.take(h, cast<int>(Good.Armour), 1) > 0) {
                        this.folk.equip(i, AgentTable.K_ARMOUR, 0);
                        this.mailed = this.mailed + 1;
                    }
                }
                return;
            }

            // Which trades a tool is any use to. Everything that goes out and works on something
            // with its hands; the ones that stand at a bench have the bench.
            public static method toolTrade(int job) returns boolean {
                return job == cast<int>(Job.Woodcutter) || job == cast<int>(Job.Miner)
                    || job == cast<int>(Job.Quarrier) || job == cast<int>(Job.Farmer)
                    || job == cast<int>(Job.Forager) || job == cast<int>(Job.Fisher)
                    || job == cast<int>(Job.Hunter) || job == cast<int>(Job.Builder)
                    || job == cast<int>(Job.Prospector);
            }

            // Loads of work a tool has in it before it is finished, and what having one is worth.
            //
            // Thirty is about a third of a working life, so a village needs a standing trickle of
            // them rather than one gift -- which is the whole point of making them a good. Seven
            // tenths of the time is a big enough difference to see in the ledger within an arc and
            // small enough that a village without a toolsmith is behind rather than dead.
            public static int TOOL_LIFE = 30;
            public static float TOOLED = 0.70;

            private method workTime(int hclass) returns float {
                if (hclass == cast<int>(Harvest.Forage)) {
                    return 8.0;
                }
                if (hclass == cast<int>(Harvest.Fishing)) {
                    return 12.0;
                }
                if (hclass == cast<int>(Harvest.Quarry)) {
                    return 22.0;
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return 28.0;
                }
                return Simulation.CHOP;
            }

            private method loadFor(int hclass) returns int {
                if (hclass == cast<int>(Harvest.Forage)) {
                    return 12;
                }
                if (hclass == cast<int>(Harvest.Fishing)) {
                    return 20;
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return 8;
                }
                return Simulation.LOAD;
            }

            // The nearest BLOCK with work of one kind, in blocks of sixteen cells. Not the nearest
            // node: a community that knows one tree sends everybody to it, the first arrival takes
            // it and the rest walk to a stump. A block is an area, so people spread out inside it by
            // themselves, and it stays true without being re-searched because `harvest` decrements
            // it as things are used up.
            //
            // A place with nothing of that kind within reach records none, and its people stop
            // asking instead of each of them discovering the same emptiness over and over.
            // WHICH GOOD FIRST, AND ONLY THEN WHERE.
            //
            // A Harvest class is a way of working and not a thing. Five different goods come out of
            // the ground under "quarry" and ten under "mine", and this method used to walk to the
            // nearest face of the CLASS -- so a village that needed clay for brick was sent to the
            // stone quarry next door, brought home stone it already had, and never fired a brick in
            // twenty generations. No brick, no kiln, no smithy: a smithy is twelve brick to raise.
            // One smithy in a world of a hundred and thirty towns, iron at three hundred and sixty
            // units, no armoury anywhere, and nobody carrying a weapon in the whole of recorded
            // time. Sand, salt, marble, tin and coal were dead for the same reason and in silence.
            //
            // So: the village picks the good in the class it is shortest of, and looks for THAT.
            // If there is none of it within reach it falls back to the class, which is what this
            // method has always done -- so a place with nothing in particular to want behaves
            // exactly as before, and a place with a real want can finally act on it.
            private method findWork(int c, int hclass) returns void {
                NodeField* nf = this.g.surface();
                int at = c * Harvest.count() + hclass;
                int good = this.wantedIn(c, hclass);
                if (this.cworkX[at] >= 0 && this.cworkG[at] == good) {
                    mutable int still = 0;
                    if (good != cast<int>(Good.Nothing)) {
                        still = nf.inBlockGood(this.cworkX[at], this.cworkY[at], good);
                    } else {
                        still = nf.inBlock(this.cworkX[at], this.cworkY[at], hclass);
                    }
                    if (still > 0) {
                        return;                                  // it is all still there
                    }
                }
                if (good != cast<int>(Good.Nothing) && this.seek(c, at, hclass, good)) {
                    this.cworkG[at] = good;
                    return;
                }
                if (this.seek(c, at, hclass, cast<int>(Good.Nothing))) {
                    this.cworkG[at] = cast<int>(Good.Nothing);
                    return;
                }
                this.cworkX[at] = 0 - 1;
                this.cworkG[at] = cast<int>(Good.Nothing);
                return;
            }

            // The good in this class the place most wants and cannot get, or Nothing if it wants
            // none of them in particular. Six goods at the worst, over five classes, once a census
            // per place -- which is the level this question is true at. Asked per person per
            // decision it would be the woodcutter's mistake for the fifth time.
            private method wantedIn(int c, int hclass) returns int {
                mutable int best = cast<int>(Good.Nothing);
                mutable int most = 0;
                for (int i in 0..Nodes.goodsIn(hclass)) {
                    int g = Nodes.goodAt(hclass, i);
                    int lack = this.shortOf(c, g);
                    if (lack > most) {
                        most = lack;
                        best = g;
                    }
                }
                return best;
            }

            // The nearest BLOCK with the work in it, spiralling out from the village. Not the
            // nearest node: a community that knows one tree sends everybody to it, the first
            // arrival takes it and the rest walk to a stump. A block is an area, so people spread
            // out inside it by themselves, and it stays true without being re-searched because
            // `harvest` decrements it as things are used up.
            //
            // `good` of Nothing means "anything of this class will do". Returns whether a site was
            // found; the caller decides what an empty search means, because it has a second thing
            // to try.
            private method seek(int c, int at, int hclass, int good) returns boolean {
                NodeField* nf = this.g.surface();
                int cbx = cast<int>(this.ccx[c]) / 16;
                int cby = cast<int>(this.ccy[c]) / 16;
                mutable int r = 0;
                while (r <= Simulation.WORK_BLOCKS) {
                    mutable int dx = 0 - r;
                    while (dx <= r) {
                        if (this.hasWork(nf, cbx + dx, cby - r, hclass, good) > 0) {
                            this.cworkX[at] = cbx + dx;
                            this.cworkY[at] = cby - r;
                            return true;
                        }
                        if (this.hasWork(nf, cbx + dx, cby + r, hclass, good) > 0) {
                            this.cworkX[at] = cbx + dx;
                            this.cworkY[at] = cby + r;
                            return true;
                        }
                        dx = dx + 1;
                    }
                    mutable int dy = 1 - r;
                    while (dy <= r - 1) {
                        if (this.hasWork(nf, cbx - r, cby + dy, hclass, good) > 0) {
                            this.cworkX[at] = cbx - r;
                            this.cworkY[at] = cby + dy;
                            return true;
                        }
                        if (this.hasWork(nf, cbx + r, cby + dy, hclass, good) > 0) {
                            this.cworkX[at] = cbx + r;
                            this.cworkY[at] = cby + dy;
                            return true;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                return false;
            }

            private method hasWork(NodeField* nf, int bx, int by, int hclass, int good) returns int {
                if (good == cast<int>(Good.Nothing)) {
                    return nf.inBlock(bx, by, hclass);
                }
                return nf.inBlockGood(bx, by, good);
            }

            // Whether a grown woman conceives now, as a logistic against the LARDER: the chance falls
            // as the food per head falls, so the population finds its own level rather than running
            // away or dying out -- and the level is now something the community's own work decides.
            //
            // The first attempt died out inside fifteen generations, and the arithmetic says exactly
            // why -- worth keeping written down, because it is the same shape of mistake every time.
            // A woman must bear TWO children to replace herself and a man. Her fertile window runs
            // from sixty seconds to FERTILE_TO of a life, about two hundred and fifty seconds. Each
            // child costs TERM in gestation plus 1/(p*room) waiting to conceive, so
            // 2*(TERM + 1/(p*room)) <= 250 -- which at p = 0.045 a second puts the balance at about
            // room = 0.28. The first attempt had an effective chance of 0.0057 a second inside a
            // window of two hundred and fifty: most women never conceived at all.
            //
            // The shape underneath was wrong too. With `p = base * emptiness`, the only point where
            // births balance deaths is emptiness = 1, which is a population of zero: it was drawn
            // toward extinction by construction. With FERTILITY set well ABOVE replacement, the
            // balance lands at a real population instead, and the world finds it rather than me.
            private method mayConceive(int i, float dt) returns boolean {
                if (!this.folk.isFemale(i) || !this.folk.isAdult(i) || this.folk.isPregnant(i)) {
                    return false;
                }
                if (this.folk.ageOf(i) > this.folk.lifespanOf(i) * Simulation.FERTILE_TO) {
                    return false;
                }
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return false;
                }
                if (this.cmales[h] == 0) {
                    return false;                       // nobody to father a child
                }
                // How much room there is, which since this slice means HOW MUCH FOOD THERE IS. CARRY
                // was a stand-in for it and the design said so from the start: "both numbers stand
                // in for the real limit -- how much food there is -- and are replaced by it, not
                // tuned around it, when the economy arrives." It has arrived. A community with a
                // full larder is empty; one living hand to mouth does not conceive.
                float larder = cast<float>(this.stores.foodOf(h))
                             / cast<float>(this.cpop[h] * Simulation.LARDER + 1);
                mutable float room = larder;
                if (room > 1.0) {
                    room = 1.0;
                }
                // AND HOW MUCH WATER THERE IS, by the same argument.
                //
                // Food was made the ceiling because a stand-in for "the real limit" had to become
                // the real limit; water is the other half of that sentence and was simply missing.
                // A town of eight hundred drawing on one well is not a town of eight hundred for
                // long, and the number that says so is the same number that says it is not fed.
                //
                // The two multiply rather than either winning, because they are not alternatives:
                // a place with full granaries and one well is held back by the well, and it is held
                // back exactly as hard as a place with water and no bread.
                float drink = cast<float>(this.cdrink[h]) / cast<float>(this.cpop[h] + 1);
                mutable float wet = drink;
                if (wet > 1.0) {
                    wet = 1.0;
                }
                room = room * wet;
                if (room <= 0.0) {
                    return false;
                }
                // Per SECOND scaled by the step, not per decision -- and drawn on the frame counter,
                // because `tick` is whole seconds and would hand the same number to all twenty steps
                // inside one of them.
                return LandMath.hash01(this.seed ^ 0x6C21, i, this.frames) < Simulation.FERTILITY * dt * room;
            }

            public static int WORK_BLOCKS = 3;           // 16-cell blocks a COMMUNITY looks over: 48 cells
            public static int REACH = 6;                 // cells a person searches where they stand
            // A WORK SESSION, not a grab. At five seconds a load the trade was seventy-one per cent
            // walking -- and the wood was only seven or eight cells away, so the map was never the
            // reason. What decides that ratio is how much work one trip is worth, and five seconds
            // of felling for twelve of carrying is not what cutting firewood is. At eighteen, a man
            // spends his day at the tree and the walk becomes what it should be: the cost of the
            // trip, not the trip itself.
            public static float CHOP = 18.0;             // seconds to take a load off a tree
            public static int LOAD = 10;                 // wood carried in one trip

            // The nearest node this trade can work, searched ring by ring outward so the FIRST one
            // found is the closest and the search stops there. Ring by ring and not square by square:
            // scanning the whole box at each radius would re-test everything inside it and turn a
            // search into a sweep.
            //
            // A PERSON only ever calls this with a small radius, standing where the community said
            // the work was. The wide version belongs to the community and runs once a second.
            private method findNode(int i, int hclass, int reach) returns int {
                NodeField* nf = this.g.surface();
                int cx = cast<int>(this.folk.xAt(i));
                int cy = cast<int>(this.folk.yAt(i));
                mutable int here = nf.nodeAt(cx, cy, hclass);
                if (here >= 0) {
                    return here;
                }
                mutable int r = 1;
                while (r <= reach) {
                    mutable int dx = 0 - r;
                    while (dx <= r) {
                        mutable int t = nf.nodeAt(cx + dx, cy - r, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        t = nf.nodeAt(cx + dx, cy + r, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        dx = dx + 1;
                    }
                    mutable int dy = 1 - r;
                    while (dy <= r - 1) {
                        mutable int t = nf.nodeAt(cx - r, cy + dy, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        t = nf.nodeAt(cx + r, cy + dy, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                return 0 - 1;
            }

            // The trade a Job goes out to do. Not every job is an extraction -- the refiners work in
            // buildings and have no Harvest class at all, which is exactly why they wait for them.
            // Bare rock within reach that nobody has looked under.
            //
            // The prospector's answer to "where do I work", and it is a question about a PLACE, so
            // it is asked once a second for the whole community exactly like every other work site.
            // An outcrop is a promise that the vein carries on; this is where somebody goes to find
            // out. A block is used up once it has been opened, so a village works outward through
            // its own stone rather than everybody digging the same hill for ever.
            private method findGround(int c) returns void {
                if (this.cdigX[c] >= 0) {
                    return;                              // still somewhere to look
                }
                int cbx = cast<int>(this.ccx[c]) / 16;
                int cby = cast<int>(this.ccy[c]) / 16;
                mutable int r = 1;
                while (r <= Simulation.WORK_BLOCKS) {
                    mutable int dy = 0 - r;
                    while (dy <= r) {
                        mutable int dx = 0 - r;
                        while (dx <= r) {
                            if (dx == 0 - r || dx == r || dy == 0 - r || dy == r) {
                                int bx = cbx + dx;
                                int by = cby + dy;
                                int px = bx * 16 + 8;
                                int py = by * 16 + 8;
                                if (bx >= 0 && by >= 0 && bx < this.claimW && by < this.claimH
                                    && !this.g.hasFlag(px, py, Grid.FLAG_PROSPECTED)
                                    && this.groundOk(px, py, cast<int>(Ground.Rock))) {
                                    this.cdigX[c] = px;
                                    this.cdigY[c] = py;
                                    return;
                                }
                            }
                            dx = dx + 1;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                return;
            }

            // Opening ground. The walk out, and then the digging -- and what comes of it is not a
            // die roll: worldgen buried every body where the tectonics put it, scattered working
            // faces through each one, and left them empty. This fills the ones under this disc.
            //
            // Fifty-two of a hundred and ninety-eight ore bodies in a measured world never touch
            // daylight anywhere, which before this made them permanently unreachable by any action
            // anybody could take. A quarter of the world's metal was in the save file and in no
            // other sense in the world.
            private method workProspect(int i) returns void {
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm || this.cdigX[h] < 0) {
                    this.folk.setJob(i, cast<int>(Job.Idle));
                    return;
                }
                if (this.busy(i)) {
                    return;
                }
                int tx = this.cdigX[h];
                int ty = this.cdigY[h];
                float dx = cast<float>(tx) - this.folk.xAt(i);
                float dy = cast<float>(ty) - this.folk.yAt(i);
                if (dx * dx + dy * dy >= 9.0) {
                    this.folk.setTarget(i, tx, ty);
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                this.folk.setAct(i, cast<int>(Act.Prospect));
                this.g.prospect(tx, ty, Simulation.PROSPECT_R);
                this.dug = this.dug + 1;
                NodeField* nf = this.g.surface();
                mutable int y = ty - Simulation.PROSPECT_R;
                while (y <= ty + Simulation.PROSPECT_R) {
                    mutable int x = tx - Simulation.PROSPECT_R;
                    while (x <= tx + Simulation.PROSPECT_R) {
                        if (x >= 0 && y >= 0 && x < this.g.width() && y < this.g.height()) {
                            int ax = x - tx;
                            int ay = y - ty;
                            if (ax * ax + ay * ay <= Simulation.PROSPECT_R * Simulation.PROSPECT_R) {
                                if (nf.openSeam(x, y) != 0) {
                                    this.struck = this.struck + 1;
                                }
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                // Finding a seam is seen, and it is remembered -- which is how a prospector comes to
                // be somebody a village listens to.
                this.folk.earn(i, 5);
                this.cdigX[h] = 0 - 1;                   // this ground is opened; look elsewhere
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // How wide a disc one man opens. Eight cells: a morning's work with a pick, and small
            // enough that a body is opened over several trips rather than in one.
            public static int PROSPECT_R = 8;

            private method harvestOf(int job) returns int {
                if (job == cast<int>(Job.Woodcutter)) {
                    return cast<int>(Harvest.Timber);
                }
                if (job == cast<int>(Job.Forager)) {
                    return cast<int>(Harvest.Forage);
                }
                if (job == cast<int>(Job.Quarrier)) {
                    return cast<int>(Harvest.Quarry);
                }
                if (job == cast<int>(Job.Miner)) {
                    return cast<int>(Harvest.Mine);
                }
                if (job == cast<int>(Job.Fisher)) {
                    return cast<int>(Harvest.Fishing);
                }
                return cast<int>(Harvest.Nothing);
            }

            private method jobOfHarvest(int hclass) returns int {
                if (hclass == cast<int>(Harvest.Timber)) {
                    return cast<int>(Job.Woodcutter);
                }
                if (hclass == cast<int>(Harvest.Forage)) {
                    return cast<int>(Job.Forager);
                }
                if (hclass == cast<int>(Harvest.Quarry)) {
                    return cast<int>(Job.Quarrier);
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return cast<int>(Job.Miner);
                }
                if (hclass == cast<int>(Harvest.Fishing)) {
                    return cast<int>(Job.Fisher);
                }
                return cast<int>(Job.Idle);
            }

            // Choose a trade. Two rules, in order, and both of them are about the community rather
            // than the person: you do not take up a trade there is no work for, and you do not take
            // up one that is already full. What is left is picked by what the place is SHORT of --
            // food first, because a village that quarries beautifully and starves is not a village.
            private method chooseJob(int i) returns void {
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return;
                }
                int nh = Harvest.count();
                int nj = Job.count();
                mutable int best = cast<int>(Job.Idle);
                mutable int bestScore = 0;
                for (int hc in 1..nh) {
                    if (this.cworkX[h * nh + hc] < 0) {
                        continue;                            // nothing of the kind within reach
                    }
                    int jb = this.jobOfHarvest(hc);
                    if (this.ctrade[h * nj + jb] >= this.quotaFor(h, jb)) {
                        continue;                            // that trade is full here
                    }
                    // Hungry places want food. It is not a preference, it is the only need the
                    // simulation can kill you for.
                    //
                    // And a place short of anything else wants that too. This was a flat ten for
                    // every trade but the two that feed, so a village with no stone put no more
                    // people on the quarry than one with a mountain of it -- and since a workshop
                    // cannot be raised without stone, the whole catalogue above the first era
                    // simply never got built. Reading the same shortage the builder reads is what
                    // joins the two halves of the economy up.
                    //
                    // AND IT IS THE SHORTAGE THE SITE WAS CHOSEN FOR, not one good standing in for
                    // a whole trade. `staple` named stone for the quarry and iron for the mine,
                    // which are two of the fifteen things those two trades bring home -- so a
                    // village that needed CLAY asked itself how short of STONE it was, found it was
                    // sitting on a mountain of the stuff, and put nobody on the pit. Three thousand
                    // one hundred and fifty-seven quarriers in one arc brought home a million and a
                    // half units of stone and three thousand of clay; brick, which is fired clay,
                    // stood at three hundred and sixty units in three towns, and a smithy costs
                    // twelve brick to raise. `cworkG` is the good the census already picked when it
                    // decided where these people would walk, so the two halves agree.
                    mutable int want = 10;
                    if (hc == cast<int>(Harvest.Forage) || hc == cast<int>(Harvest.Fishing)) {
                        want = 10 + 40 * (this.cpop[h] + 1) / (this.stores.foodOf(h) + 1);
                    } else {
                        mutable int after = this.cworkG[h * nh + hc];
                        if (after == cast<int>(Good.Nothing)) {
                            after = Simulation.staple(hc);
                        }
                        want = 10 + this.shortOf(h, after) / 4;
                    }
                    if (want > 100) {
                        want = 100;
                    }
                    if (want > bestScore) {
                        bestScore = want;
                        best = jb;
                    }
                }
                // Hunting is not a Harvest class -- its resource walks -- so it is asked for on its
                // own terms: is there game within a hunter's range of where this village is.
                int hb = cast<int>(Job.Hunter);
                if (this.ctrade[h * nj + hb] < this.quotaFor(h, hb)) {
                    int cbx = cast<int>(this.ccx[h]) / 16;
                    int cby = cast<int>(this.ccy[h]) / 16;
                    mutable boolean game = false;
                    mutable int gy = 0 - Simulation.GAME_BLOCKS;
                    while (gy <= Simulation.GAME_BLOCKS) {
                        mutable int gx = 0 - Simulation.GAME_BLOCKS;
                        while (gx <= Simulation.GAME_BLOCKS) {
                            if (this.wild.preyInBlock(cbx + gx, cby + gy) > 0) {
                                game = true;
                                gx = Simulation.GAME_BLOCKS;
                            }
                            gx = gx + 1;
                        }
                        gy = gy + 1;
                    }
                    if (game) {
                        // Meat is food, so a hungry village wants a hunter as badly as a forager.
                        mutable int want = 12;
                        int need = 10 + 40 * (this.cpop[h] + 1) / (this.stores.foodOf(h) + 1);
                        if (need > want) {
                            want = need;
                        }
                        if (want > 100) {
                            want = 100;
                        }
                        if (want > bestScore) {
                            bestScore = want;
                            best = hb;
                        }
                    }
                }
                // Somebody goes and looks under the hill.
                //
                // Wanted in proportion to how little metal the place has: a village with a full
                // ore shed does not send anybody prospecting, and one that has worked its outcrop
                // out does. That is the whole shape of the trade -- an outcrop promises the vein
                // carries on, and this is the trade that goes and collects on the promise.
                int pb = cast<int>(Job.Prospector);
                if (this.cdigX[h] >= 0 && this.ctrade[h * nj + pb] < this.quotaFor(h, pb)) {
                    mutable int want = 30;
                    if (this.stores.amountOf(h, cast<int>(Good.IronOre))
                        + this.stores.amountOf(h, cast<int>(Good.CopperOre))
                        + this.stores.amountOf(h, cast<int>(Good.Coal)) > Simulation.WANT) {
                        want = 8;
                    }
                    if (want > bestScore) {
                        bestScore = want;
                        best = pb;
                    }
                }
                // Somebody walks a load to the next town.
                //
                // Asked here for the same reason the raider and the prospector are: a carter has no
                // craft and no harvest class, so the two loops below -- one over crafts with an
                // empty bench, one over things to go and dig up -- can never reach it. A trade that
                // exists in the enum and in nobody's decision is a trade nobody ever takes, which
                // is exactly what a measured arc showed: fifty-eight routes standing open and not
                // one load ever set out on any of them.
                int tb = cast<int>(Job.Trader);
                if (this.ccaravan[h] >= 0 && this.ctrade[h * nj + tb] < this.quotaFor(h, tb)) {
                    // Worth what the far end is short of, capped so a desperate neighbour cannot
                    // empty this village into a cart. It competes with every other trade on the
                    // same scale as everything else here.
                    mutable int want = this.shortOf(this.ccaravan[h], this.ccargo[h]) / 4;
                    if (want > 60) {
                        want = 60;
                    }
                    if (want > bestScore) {
                        bestScore = want;
                        best = tb;
                    }
                }
                // A workshop with an empty bench beats going out to the field: it is nearer, the
                // work is worth more, and somebody has already decided the village needs it.
                for (int cr in 1..Craft.count()) {
                    if (this.copen[h * Craft.count() + cr] < 0) {
                        continue;
                    }
                    int jb = this.jobOfCraft(cr);
                    if (this.ctrade[h * nj + jb] >= this.quotaFor(h, jb)) {
                        continue;
                    }
                    if (55 > bestScore) {
                        bestScore = 55;
                        best = jb;
                    }
                }
                // Somebody at the gate, or a granary worth walking to. Above every trade that feeds
                // and below the one that shelters: a village under attack does not stop to fell
                // timber, and a village that has decided to raid does not do it instead of finishing
                // the roof it is standing under.
                int rb = cast<int>(Job.Raider);
                boolean called = this.mustering(this.cnat[h]) >= 0;
                if ((this.cfoe[h] >= 0 || this.craided[h] > 0 || called)
                    && this.ctrade[h * nj + rb] < this.quotaFor(h, rb)) {
                    // A muster outranks a feud. When the nation calls, a village that was minding
                    // its own quarrel sends people anyway -- which is what having a nation MEANS,
                    // and the only reason an army is ever bigger than one village's grudge.
                    mutable int arms = 100;
                    if (called) {
                        arms = 130;
                    }
                    if (arms > bestScore) {
                        bestScore = arms;
                        best = rb;
                    }
                }
                // And something half-built beats everything, because until it stands nobody can
                // work in it and the whole reason it was marked out goes unanswered.
                if (this.cbusy[h] >= 0) {
                    int jb = cast<int>(Job.Builder);
                    if (this.ctrade[h * nj + jb] < this.quotaFor(h, jb)) {
                        bestScore = 120;
                        best = jb;
                    }
                }
                // And then somebody speaks. A chief does not ASSIGN work -- there is no such power in
                // this world and inventing one would make the whole leadership a lie -- they lean,
                // and whether that lands is decided by the listener, not the speaker. A bold and
                // ambitious person shrugs it off; a sociable one with nothing to prove goes along.
                //
                // The chief's own standing is the weight. Someone who has done nothing sways nobody
                // even holding the role, which is what stops a new heir inheriting real authority
                // along with the title.
                int lead = this.chief[h];
                if (lead >= 0 && lead != i && this.lean[h] != cast<int>(Job.Idle)) {
                    int jb = this.lean[h];
                    if (this.ctrade[h * nj + jb] < this.quotaFor(h, jb)) {
                        // Sway is measured against what a LIFE can earn, not against what the byte
                        // can hold. Dividing by 255 said two people in a hundred went along, which
                        // is not a leadership -- and the reason was arithmetic, not temperament: a
                        // six-minute life accumulates thirty-odd deeds, so a chief was being judged
                        // at a tenth of the scale the formula assumed. NOTABLE is the level at which
                        // somebody is properly established, and past it more renown adds nothing.
                        mutable int sway = this.folk.influenceOf(lead);
                        if (sway > Simulation.NOTABLE) {
                            sway = Simulation.NOTABLE;
                        }
                        int mind = this.folk.sociabilityOf(i) + 40
                                 - this.folk.boldnessOf(i) / 2 - this.folk.ambitionOf(i) / 2;
                        mutable int odds = sway * mind / Simulation.NOTABLE;
                        // And an elder standing behind him. A chief who has the old people's
                        // backing is heeded by people who would have shrugged him off, which is the
                        // only power an elder has and the whole of it -- they command nobody and
                        // they make the person who does easier to believe.
                        if (this.celder[h] >= 0 && this.celder[h] != i) {
                            odds = odds + odds / 4;
                        }
                        if (cast<int>(LandMath.hash01(this.seed ^ 0x2E77, i, this.tick) * 100.0) < odds) {
                            this.followed = this.followed + 1;
                            best = jb;
                            // Going along with somebody is a thing that happens to a person, and
                            // until now the only trace of it was a counter in the report.
                            this.folk.setAct(i, cast<int>(Act.Follow));
                        } else {
                            this.resisted = this.resisted + 1;
                        }
                    }
                }
                if (best != cast<int>(Job.Idle)) {
                    this.folk.setJob(i, best);
                    this.ctrade[h * nj + best] = this.ctrade[h * nj + best] + 1;
                    // Taking up a trade is the moment you would go to the store and pick up what
                    // it needs, so it is the moment this is asked -- not every tick, and not by a
                    // sweep over fifty thousand people looking for empty hands.
                    this.kitUp(i, h);
                }
                return;
            }

            private method jobOfCraft(int craft) returns int {
                if (craft == cast<int>(Craft.Wright)) {
                    return cast<int>(Job.Sawyer);
                }
                if (craft == cast<int>(Craft.Smith)) {
                    return cast<int>(Job.Smith);
                }
                if (craft == cast<int>(Craft.Victualler)) {
                    return cast<int>(Job.Baker);
                }
                if (craft == cast<int>(Craft.Weaving)) {
                    return cast<int>(Job.Weaver);
                }
                if (craft == cast<int>(Craft.Tilling)) {
                    return cast<int>(Job.Farmer);
                }
                if (craft == cast<int>(Craft.Lettering)) {
                    return cast<int>(Job.Scholar);
                }
                return cast<int>(Job.Idle);
            }

            private method craftOfJob(int job) returns int {
                if (job == cast<int>(Job.Sawyer)) {
                    return cast<int>(Craft.Wright);
                }
                if (job == cast<int>(Job.Smith)) {
                    return cast<int>(Craft.Smith);
                }
                if (job == cast<int>(Job.Baker)) {
                    return cast<int>(Craft.Victualler);
                }
                if (job == cast<int>(Job.Weaver)) {
                    return cast<int>(Craft.Weaving);
                }
                if (job == cast<int>(Job.Farmer)) {
                    return cast<int>(Craft.Tilling);
                }
                if (job == cast<int>(Job.Scholar)) {
                    return cast<int>(Craft.Lettering);
                }
                return cast<int>(Craft.NoCraft);
            }

            // Busy means committed to something. Wandering is NOT: somebody strolling because they had
            // nothing better to do should drop it the moment there is work, or half the population
            // spends its life finishing an aimless walk it started three seconds ago.
            private method busy(int i) returns boolean {
                int a = this.folk.actOf(i);
                return a != cast<int>(Act.Idle) && a != cast<int>(Act.Wander);
            }

            // Hunting. It is the one trade whose resource RUNS AWAY, and that is the whole difference
            // from the five that stand still: a hunter walks to where the herds are, and the herds
            // have already moved off settled ground, so he works the edge of his own community's
            // land rather than the middle of it.
            //
            // He does not chase. A kill is a stalk that takes as long as felling a tree, and if the
            // animal has wandered off in the meantime he has lost it -- which is exactly the shape
            // the woodcutter has with a tree somebody else emptied.
            public static float STALK = 20.0;            // seconds to bring one down
            public static int GAME_BLOCKS = 5;           // 16-cell blocks a hunter will range over

            private method workHunt(int i) returns void {
                int h = this.folk.homeOf(i);
                if (this.folk.carryAmtOf(i) > 0) {
                    if (this.busy(i)) {
                        return;
                    }
                    float hx = this.ccx[h];
                    float hy = this.ccy[h];
                    float dx = hx - this.folk.xAt(i);
                    float dy = hy - this.folk.yAt(i);
                    if (dx * dx + dy * dy < 4.0) {
                        int amt = this.folk.carryAmtOf(i);
                        this.stores.add(h, this.folk.carryKindOf(i), amt);
                        this.carried = this.carried + cast<long>(amt);
                        // Bringing food and timber home counts, a little at a time. Standing is
                        // mostly accumulated by ORDINARY work done for years, which is why age and
                        // deeds end up correlated without age being a term in it.
                        this.folk.earn(i, 1);
                        this.folk.setCarry(i, 0, 0);
                    } else {
                        this.folk.setTarget(i, cast<int>(hx), cast<int>(hy));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                        return;
                    }
                }
                if (this.busy(i)) {
                    return;
                }
                // Something within arm's reach: stalk it.
                int q = this.wild.preyNear(this.folk.xAt(i), this.folk.yAt(i), 3.0);
                if (q >= 0) {
                    this.folk.setTargetNode(i, q);
                    this.folk.setAct(i, cast<int>(Act.Hunt));
                    return;
                }
                // Otherwise walk toward the nearest block the census says holds game.
                int cbx = cast<int>(this.folk.xAt(i)) / 16;
                int cby = cast<int>(this.folk.yAt(i)) / 16;
                mutable int r = 0;
                while (r <= Simulation.GAME_BLOCKS) {
                    mutable int dy = 0 - r;
                    while (dy <= r) {
                        mutable int dx = 0 - r;
                        while (dx <= r) {
                            if (dx * dx + dy * dy > r * r || (r > 0 && dx * dx + dy * dy < (r - 1) * (r - 1))) {
                                dx = dx + 1;
                                continue;
                            }
                            if (this.wild.preyInBlock(cbx + dx, cby + dy) > 0) {
                                int tx = (cbx + dx) * 16 + 8;
                                int ty = (cby + dy) * 16 + 8;
                                if (this.walkable(tx, ty)) {
                                    this.folk.setTarget(i, tx, ty);
                                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                                    return;
                                }
                            }
                            dx = dx + 1;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                this.noWork = this.noWork + 1;
                this.folk.setJob(i, cast<int>(Job.Idle));
                this.folk.setThinkAt(i, this.tick + 30);
                return;
            }

            // The stalk paid off, or it did not. `take` says which species it was, so the meat and
            // the hide come off the animal's own table rather than out of a number here.
            private method killDone(int i) returns void {
                int q = this.folk.targetNodeOf(i);
                this.folk.setTargetNode(i, 0 - 1);
                this.folk.setAct(i, cast<int>(Act.Idle));
                if (q < 0 || !this.wild.aliveAt(q)) {
                    return;                               // it wandered off; that is hunting
                }
                float dx = this.wild.xAt(q) - this.folk.xAt(i);
                float dy = this.wild.yAt(q) - this.folk.yAt(i);
                if (dx * dx + dy * dy > 36.0) {
                    return;                               // out of reach by the time it mattered
                }
                int sp = this.wild.take(q);
                if (sp <= 0) {
                    return;
                }
                int h = this.folk.homeOf(i);
                // A carrier holds one good, so the meat goes home on his back and the hide is put
                // straight into the store where he stands -- he is at the kill, not at the village,
                // but a skin is light and a carcass is not.
                this.stores.add(h, cast<int>(Good.Hide), Beasts.hide(sp));
                this.folk.setCarry(i, cast<int>(Good.RawMeat), Beasts.meat(sp));
                this.hunted = this.hunted + 1;
                // A kill is seen, and it is remembered.
                this.folk.earn(i, 6);
                return;
            }

            // Raiding, and defending, which are the same verb pointed in opposite directions.
            //
            // A defender's foe is whoever is standing in their own village; an attacker's is a place
            // on the map. So a raider with plunder on their back is going home, a raider whose
            // village is under attack fights where they stand, and a raider with a quarrel and empty
            // hands marches. Three states and no others, which is why this is one method.
            private method workRaid(int i) returns void {
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return;
                }
                // Coming home with somebody else's grain.
                if (this.folk.carryAmtOf(i) > 0) {
                    if (this.busy(i)) {
                        return;
                    }
                    float dx = this.ccx[h] - this.folk.xAt(i);
                    float dy = this.ccy[h] - this.folk.yAt(i);
                    if (dx * dx + dy * dy < 4.0) {
                        int amt = this.folk.carryAmtOf(i);
                        this.stores.stow(h, this.folk.carryKindOf(i), amt);
                        this.plunder = this.plunder + cast<long>(amt);
                        this.carried = this.carried + cast<long>(amt);
                        // Coming home with what the village needed and somebody else had is the
                        // loudest thing anybody in this world does. It is also how a war chief
                        // comes to exist: standing is earned, and the leadership slice hands the
                        // role to whoever has the most of it.
                        this.folk.earn(i, 8);
                        this.folk.setCarry(i, 0, 0);
                    } else {
                        this.folk.setTarget(i, cast<int>(this.ccx[h]), cast<int>(this.ccy[h]));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                    }
                    return;
                }
                if (this.busy(i)) {
                    return;
                }
                // Anybody from another village within arm's reach, wherever we are. This is what
                // makes a defender: they never march, but the enemy comes to them.
                if (this.foeNear(i, h) >= 0) {
                    this.folk.setAct(i, cast<int>(Act.Fight));
                    return;
                }
                // The muster. If this person's nation has called an army out, that outranks the
                // village's own quarrel: they walk to the GENERAL, not to whoever their neighbours
                // are feuding with. This is where an army comes from -- there is no recruiting and
                // nobody is conscripted, it is simply that everyone who took up arms is heading for
                // the same man, and standing near him is what `countUnder` calls being in an army.
                int mine = this.mustering(this.cnat[h]);
                if (mine >= 0) {
                    int lead = this.host.generalOf(mine);
                    if (lead >= 0 && this.folk.alive(lead) && lead != i) {
                        this.folk.setTarget(i, cast<int>(this.folk.xAt(lead)),
                                               cast<int>(this.folk.yAt(lead)));
                        this.folk.setAct(i, cast<int>(Act.March));
                        return;
                    }
                }
                int foe = this.cfoe[h];
                if (foe < 0 || this.cpop[foe] <= 0) {
                    this.folk.setJob(i, cast<int>(Job.Idle));
                    return;                              // the quarrel is over, or its village is
                }
                this.folk.setTarget(i, cast<int>(this.ccx[foe]), cast<int>(this.ccy[foe]));
                this.folk.setAct(i, cast<int>(Act.WalkTo));
                return;
            }

            // Somebody of another community close enough to hit, or -1.
            //
            // A linear scan of fifty thousand rows per raider per decision would be the woodcutter's
            // mistake again, so it asks the wildlife index's neighbour -- no: it asks the ONE place
            // that already knows who is nearby, which is the block claim. A raider standing in a
            // block claimed by their foe is in the enemy village, and that is the whole test; who
            // exactly they hit is then found among the few dozen the reach covers.
            private method foeNear(int i, int h) returns int {
                int bx = cast<int>(this.folk.xAt(i)) / 16;
                int by = cast<int>(this.folk.yAt(i)) / 16;
                if (bx < 0 || by < 0 || bx >= this.claimW || by >= this.claimH) {
                    return 0 - 1;
                }
                int held = this.claim[by * this.claimW + bx];
                if (held < 0 || held == h) {
                    return 0 - 1;                        // our ground, or nobody's
                }
                // Somebody of that community, near. The search is bounded by the block, so it walks
                // the folk in it and not the world -- and it takes the first it finds, because a
                // fight is not an optimisation problem.
                int n = this.folk.limit();
                int stride = 1 + (i % 7);                // `step` is a keyword; this is not it
                mutable int seen = 0;
                mutable int j = i;
                while (seen < n) {
                    j = j + stride;
                    if (j >= n) {
                        j = j - n;
                    }
                    seen = seen + 1;
                    if (j == i || !this.folk.alive(j)) {
                        continue;
                    }
                    if (this.folk.homeOf(j) != held) {
                        continue;
                    }
                    float dx = this.folk.xAt(j) - this.folk.xAt(i);
                    float dy = this.folk.yAt(j) - this.folk.yAt(i);
                    if (dx * dx + dy * dy <= Simulation.SWING) {
                        return j;
                    }
                    if (seen > Simulation.LOOKERS) {
                        return 0 - 1;                    // nobody within a glance; keep marching
                    }
                }
                return 0 - 1;
            }

            // How long a blow takes, how far a spear reaches, and how many people somebody scans
            // before giving up and moving on. The last one is a BUDGET and not a radius: it is what
            // stops a raider standing in an empty enemy village from reading fifty thousand rows
            // every second looking for a fight that is not there.
            public static float MELEE = 3.0;
            public static fixed float SWING = 9.0;
            public static int LOOKERS = 600;

            // The blow lands, or it does not. Whoever swung takes a wound back if the other is armed
            // -- a raider against a raider is a fight and a raider against a forager is a killing,
            // and both belong in the numbers under their own names.
            private method blowLanded(int i) returns void {
                this.folk.setAct(i, cast<int>(Act.Idle));
                int h = this.folk.homeOf(i);
                int j = this.foeNear(i, h);
                if (j < 0) {
                    return;                              // they moved; nothing happened
                }
                int them = this.folk.homeOf(j);
                this.craided[them] = Simulation.GRUDGE;
                this.craider[them] = h;
                this.raids = this.raids + 1;
                boolean armed = this.folk.jobOf(j) == cast<int>(Job.Raider);
                // What a blow costs, and what it costs to take one. This is where the whole iron
                // chain arrives: a village that smelts, forges and mails its raiders beats one
                // that does not, and until now all that iron was a number on a shelf.
                mutable int blow = Simulation.HURT;
                if (this.folk.hasKit(i, AgentTable.K_WEAPON)) {
                    blow = blow * 8 / 5;
                }
                if (this.folk.hasKit(j, AgentTable.K_ARMOUR)) {
                    blow = blow * 3 / 5;
                }
                if (this.folk.wound(j, blow)) {
                    // A DEAD MAN IS NOT STILL THE CHIEF, and war was the one death in this world
                    // that forgot to say so. Old age, hunger, illness and the ground all vacate the
                    // office; a raid did not -- so a village whose chief was cut down at the gate
                    // went on answering to his index, and that row goes straight back on the free
                    // list. The next child born into the world inherited the chieftaincy, silently,
                    // at the age of nought.
                    this.vacate(j, this.folk.homeOf(j));
                    this.deathsWar = this.deathsWar + 1;
                    // A kill is seen and remembered. It is the same earning as bringing a load home,
                    // eight times over, which is exactly why a world with war in it produces chiefs
                    // who are not the best farmers.
                    this.folk.earn(i, 8);
                }
                mutable int back = Simulation.HURT;
                if (this.folk.hasKit(j, AgentTable.K_WEAPON)) {
                    back = back * 8 / 5;
                }
                if (this.folk.hasKit(i, AgentTable.K_ARMOUR)) {
                    back = back * 3 / 5;
                }
                if (armed && this.folk.wound(i, back)) {
                    this.vacate(i, this.folk.homeOf(i));
                    this.deathsWar = this.deathsWar + 1;
                    return;
                }
                // The granary is the point. Having reached it and cleared the way, take what can be
                // carried -- one load, the same as any other trade brings home.
                if (this.folk.carryAmtOf(i) == 0) {
                    int gd = this.stores.richest(them);
                    if (gd > 0) {
                        int took = this.stores.seize(them, gd, Simulation.LOAD);
                        if (took > 0) {
                            this.folk.setCarry(i, gd, took);
                        }
                    }
                }
                return;
            }

            // What a blow costs, and how long a village remembers one. A hundred points of health at
            // twenty-five a blow is four blows to kill somebody who does not fight back, which at
            // three seconds a blow is a raid that takes about as long as felling an oak. The grudge
            // is a hundred and twenty censuses -- two minutes, a third of a life -- so a feud
            // outlives the people who started it and ends without anybody deciding to end it.
            public static int HURT = 25;
            public static int GRUDGE = 120;

            // Raising a building. The builder walks to the site and works; when the last hour goes in
            // the timber and stone come out of the store and it opens. Paying at the END and not at
            // the start is what stops a plan from eating a village: a site nobody ever finishes has
            // cost nothing but the walking.
            private method workBuild(int i) returns void {
                int h = this.folk.homeOf(i);
                int b = this.cbusy[h];
                if (b < 0 || this.town.isWorking(b) || this.town.isGone(b)) {
                    // Nothing standing half-built. A builder in a place that knows how to lay a
                    // surface goes and lays one instead of going idle -- which is the whole of what
                    // the third era changes about the ground: up to here every road in the world
                    // appeared because feet wore it, and from here a people can decide.
                    if (this.eraOf(h) >= Simulation.PAVE_ERA && this.pave(i, h)) {
                        return;
                    }
                    this.folk.setJob(i, cast<int>(Job.Idle));
                    return;
                }
                if (this.busy(i)) {
                    return;
                }
                float bxf = cast<float>(this.town.xAt(b));
                float byf = cast<float>(this.town.yAt(b));
                float dx = bxf - this.folk.xAt(i);
                float dy = byf - this.folk.yAt(i);
                if (dx * dx + dy * dy >= 4.0) {
                    this.folk.setTarget(i, this.town.xAt(b), this.town.yAt(b));
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                this.folk.setWorkplace(i, b);
                this.folk.setAct(i, cast<int>(Act.Build));
                return;
            }

            // Laying a surface where the feet already chose one.
            //
            // A paver does not survey. He walks the road his village already has and puts stone on
            // it, which is why pavement in this world always follows a route that was worth having
            // -- nobody ever paves a line nobody walks. The stone comes off the shelves, so a place
            // that cannot quarry cannot pave however clever it is.
            //
            // He looks around HIMSELF rather than around the village, and that is the one place
            // this breaks the "ask per place, not per person" rule on purpose: the answer changes
            // every time somebody acts on it, so a per-place cache would be stale by the second
            // paver and every one of them would walk to the same cell.
            private method pave(int i, int h) returns boolean {
                if (!this.stores.has(h, cast<int>(Good.Stone), Simulation.PAVE_STONE)) {
                    return false;
                }
                int px = cast<int>(this.folk.xAt(i));
                int py = cast<int>(this.folk.yAt(i));
                mutable int r = 0;
                while (r <= Simulation.PAVE_REACH) {
                    mutable int dy = 0 - r;
                    while (dy <= r) {
                        mutable int dx = 0 - r;
                        while (dx <= r) {
                            if (dx == 0 - r || dx == r || dy == 0 - r || dy == r) {
                                int cx = px + dx;
                                int cy = py + dy;
                                if (this.paths.surfaceAt(cx, cy) == cast<int>(Surface.Road)) {
                                    if (this.paths.lay(cx, cy, cast<int>(Surface.Paved))) {
                                        this.stores.take(h, cast<int>(Good.Stone),
                                                         Simulation.PAVE_STONE);
                                        this.folk.setTarget(i, cx, cy);
                                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                                        this.folk.earn(i, 2);
                                        return true;
                                    }
                                }
                            }
                            dx = dx + 1;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                return false;
            }

            // The era at which a people stops accepting the ground it was given, what a cell of
            // pavement costs in stone, and how far a paver looks for the next one. The reach is
            // small on purpose: pavement should creep out from a town along its busiest road,
            // not appear in patches wherever somebody happened to be standing.
            public static int PAVE_ERA = 3;
            public static int PAVE_STONE = 4;
            public static int PAVE_REACH = 10;

            // A general walks to the town his nation wants, and everybody who has taken up arms
            // walks to HIM. That is the whole of the formation: an army is the people standing
            // around the man leading it, so it holds together by everybody having the same
            // destination rather than by anybody being told to keep a line.
            private method workLead(int i) returns void {
                mutable int mine = 0 - 1;
                for (int a in 0..this.host.limit()) {
                    if (this.host.alive(a) && this.host.generalOf(a) == i) {
                        mine = a;
                    }
                }
                if (mine < 0) {
                    this.folk.setJob(i, cast<int>(Job.Idle));
                    this.folk.setRole(i, cast<int>(Role.None));
                    return;
                }
                int t = this.host.targetOf(mine);
                if (t < 0 || this.busy(i)) {
                    return;
                }
                // Once he is in front of it he STOPS. A general who kept re-issuing the same order
                // every time he thought would stand there twitching, and worse, would drag the whole
                // formation a step at a time as everybody re-aimed at him.
                float dx = this.ccx[t] - this.folk.xAt(i);
                float dy = this.ccy[t] - this.folk.yAt(i);
                if (dx * dx + dy * dy < cast<float>(Simulation.SIEGE_LINE * Simulation.SIEGE_LINE)) {
                    this.folk.setThinkAt(i, this.tick + 40);
                    return;
                }
                this.folk.setTarget(i, cast<int>(this.ccx[t]), cast<int>(this.ccy[t]));
                this.folk.setAct(i, cast<int>(Act.March));
                return;
            }

            // WHICH BENCH OF HIS TRADE, and not merely which trade -- the same rule one step finer,
            // and the same step this file already took once for deciding what to BUILD.
            //
            // `copen` holds one free bench per CRAFT, taken in table order, which is the order things
            // were raised. A toolmaker is an era-one building and a weaponsmith an era-two one, so in
            // every town that ever raised a toolmaker the toolmaker holds the smith's bench for ever
            // and everything built beside it later stands empty. Measured: six hundred and three
            // toolmakers, four weaponsmiths, and NOT ONE WEAPON -- while four armouries in towns that
            // happened to have no free toolmaking bench produced fifty-four suits of armour and put
            // the first fifteen men in mail this world has ever seen. The difference between the two
            // was not the recipe; it was who got there first.
            //
            // So a craftsman walks to the bench that makes the thing his town most wants. `cmade`
            // already holds a free bench per OUTPUT -- it is filled in the same pass, one line below
            // the one that fills `copen` -- and `cwant` is read once a census, so this costs a walk
            // over the catalogue and no searching at all.
            private method benchFor(int h, int craft) returns int {
                int ng = Goods.count();
                mutable int best = 0 - 1;
                mutable int most = 0 - 1;
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.craft(k) != craft || !Builds.staffed(k)) {
                        continue;
                    }
                    int g = Builds.out(k);
                    if (g <= 0 || g >= ng) {
                        continue;
                    }
                    int b = this.cmade[h * ng + g];
                    if (b < 0) {
                        continue;
                    }
                    int wants = this.cwant[h * ng + g];
                    if (wants > most) {
                        most = wants;
                        best = b;
                    }
                }
                if (best < 0) {
                    return this.copen[h * Craft.count() + craft];
                }
                return best;
            }

            // Working inside one. A craftsman does not travel to a resource -- the resource has
            // already been carried home by somebody else, which is the whole point of the store
            // existing -- so this is a walk to the workshop and then a batch at a time.
            private method workCraft(int i) returns void {
                int h = this.folk.homeOf(i);
                int craft = this.craftOfJob(this.folk.jobOf(i));
                mutable int b = this.folk.workplaceOf(i);
                if (b < 0 || !this.town.isWorking(b) || this.town.ownerOf(b) != h
                    || Builds.craft(this.town.kindOf(b)) != craft) {
                    b = this.benchFor(h, craft);
                    if (b < 0) {
                        this.folk.setWorkplace(i, 0 - 1);
                        this.folk.setJob(i, cast<int>(Job.Idle));
                        this.folk.setThinkAt(i, this.tick + 20);
                        return;
                    }
                    this.folk.setWorkplace(i, b);
                }
                if (this.busy(i)) {
                    return;
                }
                float bxf = cast<float>(this.town.xAt(b));
                float byf = cast<float>(this.town.yAt(b));
                float dx = bxf - this.folk.xAt(i);
                float dy = byf - this.folk.yAt(i);
                if (dx * dx + dy * dy >= 4.0) {
                    this.folk.setTarget(i, this.town.xAt(b), this.town.yAt(b));
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                // Three trades that all "refine" and look nothing alike. Somebody bent over a
                // furrow, somebody copying a page and somebody at a bench are the same line of
                // arithmetic and three different things to watch, and the enum has had words for
                // all three since the beginning with nothing ever setting two of them.
                if (craft == cast<int>(Craft.Tilling)) {
                    this.folk.setAct(i, cast<int>(Act.Till));
                } else if (craft == cast<int>(Craft.Lettering)) {
                    this.folk.setAct(i, cast<int>(Act.Discover));
                } else {
                    this.folk.setAct(i, cast<int>(Act.Refine));
                }
                return;
            }

            // A batch comes off the bench. The inputs leave the store and the output enters it, and
            // if an input is missing the batch does not happen -- the workshop STALLS, and that stall
            // is the signal the next census reads when it decides what the village should build.
            private method batchDone(int i) returns void {
                int b = this.folk.workplaceOf(i);
                if (b < 0 || !this.town.isWorking(b)) {
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    return;
                }
                int h = this.town.ownerOf(b);
                int k = this.town.kindOf(b);
                int a1 = Builds.in1(k);
                int a2 = Builds.in2(k);
                boolean ready = this.stores.has(h, a1, Builds.n1(k))
                             && (a2 == cast<int>(Good.Nothing) || this.stores.has(h, a2, Builds.n2(k)));
                if (!ready) {
                    this.stalled = this.stalled + 1;
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    this.folk.setThinkAt(i, this.tick + 6);
                    return;
                }
                this.stores.take(h, a1, Builds.n1(k));
                if (a2 != cast<int>(Good.Nothing)) {
                    this.stores.take(h, a2, Builds.n2(k));
                }
                // WHAT COMES OFF THE LAND DEPENDS ON THE TIME OF YEAR; what comes off a bench does
                // not. A smith works the same in February as in August and a field does not, and
                // that difference is the entire reason a granary exists -- so it is applied to the
                // tilling craft and to nothing else.
                mutable int made = Builds.nout(k);
                if (Builds.craft(k) == cast<int>(Craft.Tilling)) {
                    made = made * this.season() / 100;
                    if (made < 1) {
                        made = 1;      // even a hard winter yields something, or nobody would sow
                    }
                }
                this.stores.add(h, Builds.out(k), made);
                this.crafted = this.crafted + 1;
                this.folk.earn(i, 1);
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // Any extractive trade, whole: find something of your kind, walk to it, work a load off
            // it, carry it home, put it in the store. Everything an economy needs is in this loop --
            // a resource that runs out, a distance that costs time, and a store that grows.
            //
            // It is ONE method for all five trades and not five methods, because a woodcutter and a
            // fisherman differ in exactly two things: which Harvest class they look for and which
            // Good comes off it. Everything else -- the community's site, the local search, the
            // walk, the load, the trip home -- is the same work, and writing it five times would be
            // five places to fix the next thing found wrong with it.
            private method workGather(int i) returns void {
                NodeField* nf = this.g.surface();
                int h = this.folk.homeOf(i);
                int hclass = this.harvestOf(this.folk.jobOf(i));
                if (hclass == cast<int>(Harvest.Nothing)) {
                    return;
                }
                if (this.folk.carryAmtOf(i) > 0) {
                    // Carrying: head home if not already going there, hand over on arrival.
                    if (this.busy(i)) {
                        return;
                    }
                    float hx = this.ccx[h];
                    float hy = this.ccy[h];
                    float dx = hx - this.folk.xAt(i);
                    float dy = hy - this.folk.yAt(i);
                    if (dx * dx + dy * dy < 4.0) {
                        int amt = this.folk.carryAmtOf(i);
                        this.stores.add(h, this.folk.carryKindOf(i), amt);
                        this.carried = this.carried + cast<long>(amt);
                        // Bringing food and timber home counts, a little at a time. Standing is
                        // mostly accumulated by ORDINARY work done for years, which is why age and
                        // deeds end up correlated without age being a term in it.
                        this.folk.earn(i, 1);
                        this.folk.setCarry(i, 0, 0);
                        // and straight back out. Returning here left the man standing in his own
                        // village with nothing decided, so the next thing that touched him was the
                        // wander -- which is why a fifth of all the time in the world was being
                        // spent strolling in circles between one load and the next.
                    } else {
                        this.folk.setTarget(i, cast<int>(hx), cast<int>(hy));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                        return;
                    }
                }
                if (this.busy(i)) {
                    return;
                }
                int t = this.folk.targetNodeOf(i);
                if (t >= 0) {
                    // Standing at the thing it set out for -- unless somebody else emptied it first,
                    // which is exactly what a shared, finite resource does to a plan.
                    if (nf.qtyAt(t) > 0) {
                        this.folk.setAct(i, cast<int>(Act.Gather));
                        return;
                    }
                    this.folk.setTargetNode(i, 0 - 1);
                }
                // Look around where you stand -- six cells, not forty. If there is nothing, you do not
                // go looking: you go where your community says the work is, and only search again
                // once you are there. A person who does not know the world cannot search it, and a
                // person who searches it forty cells at a time, thousands of times a second, is a
                // profiler entry rather than a woodcutter.
                int at = h * Harvest.count() + hclass;
                mutable int found = this.findNode(i, hclass, Simulation.REACH);
                if (found < 0) {
                    if (h < 0 || h >= this.ncomm || this.cworkX[at] < 0) {
                        this.noWork = this.noWork + 1;
                        this.folk.setJob(i, cast<int>(Job.Idle));  // this trade has nothing here
                        this.folk.setThinkAt(i, this.tick + 30);
                        return;
                    }
                    // A point inside the block, different for each person, so a hundred woodcutters
                    // fan out across the wood instead of queueing at one corner of it. It has to be
                    // ground you can stand on: aiming at whatever the jitter lands on sent one walk
                    // in six into a lake or a cliff face, to be abandoned thirty seconds later --
                    // `stuck` went from two in a hundred journeys to seventeen.
                    mutable int wx = this.cworkX[at] * 16 + 8;
                    mutable int wy = this.cworkY[at] * 16 + 8;
                    mutable int tries = 0;
                    while (tries < 4) {
                        int jx = cast<int>(LandMath.hash01(this.seed ^ 0x11B3, i * 5 + tries, this.tick) * 16.0);
                        int jy = cast<int>(LandMath.hash01(this.seed ^ 0x274D, i * 5 + tries, this.tick) * 16.0);
                        int tx = this.cworkX[at] * 16 + jx;
                        int ty = this.cworkY[at] * 16 + jy;
                        if (this.walkable(tx, ty)) {
                            wx = tx;
                            wy = ty;
                            tries = 4;
                        } else {
                            tries = tries + 1;
                        }
                    }
                    float ax = cast<float>(wx) - this.folk.xAt(i);
                    float ay = cast<float>(wy) - this.folk.yAt(i);
                    if (ax * ax + ay * ay < 4.0) {
                        // Inside the block, six cells searched, and nothing. The block still counts
                        // work, so it is further in than the search reached: wait a moment and aim
                        // at a different point rather than re-deciding on every tick.
                        this.noWork = this.noWork + 1;
                        this.folk.setThinkAt(i, this.tick + 3);
                        return;
                    }
                    this.folk.setTarget(i, wx, wy);
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                this.folk.setTargetNode(i, found);
                this.folk.setTarget(i, nf.cellXAt(found), nf.cellYAt(found));
                this.folk.setAct(i, cast<int>(Act.WalkTo));
                return;
            }

            public method livingCount() returns int {
                return this.folk.count();
            }

            public method bornCount() returns long {
                return this.births;
            }

            // Armies that gave up rather than ran out of clock, and the fighting weight of a man.
            public method routedArmies() returns long {
                return this.host.routedCount();
            }

            public method mettleOf(int i) returns int {
                return this.mettle(i);
            }

            // Places that cannot keep everybody in drinking water, and works raised against it.
            public method thirstyCount() returns int {
                mutable int n = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] > 0 && this.cdrink[c] < this.cpop[c]) {
                        n = n + 1;
                    }
                }
                return n;
            }

            public method waterworksMarked() returns long {
                return this.watered;
            }

            // Sickness: how many it has touched, how many it has taken, and how filthy a place is.
            public method tookIll() returns long {
                return this.fellIll;
            }

            public method deathsFromIllness() returns long {
                return this.deathsIll;
            }

            public method filthOf(int c) returns int {
                return this.cfilth[c];
            }

            // Towns with a harbour standing, and how much has crossed water rather than country.
            public method portCount() returns int {
                mutable int n = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] > 0 && this.cport[c] > 0) {
                        n = n + 1;
                    }
                }
                return n;
            }

            public method shippedUnits() returns long {
                return this.shipped;
            }

            // Routes whose far end flies another flag. Overland this is always zero by construction;
            // a harbour is the only thing that makes it anything else.
            public method foreignRoutes() returns int {
                mutable int n = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    int d = this.ccaravan[c];
                    if (d >= 0 && d < this.ncomm && this.cnat[d] != this.cnat[c]) {
                        n = n + 1;
                    }
                }
                return n;
            }

            public method step(float dt) returns void {
                this.frames = this.frames + 1;
                this.clock = this.clock + dt;
                this.tick = cast<int>(this.clock);
                this.meter.begin();
                if (this.clock >= this.censusDue) {
                    this.census();
                    this.censusDue = this.clock + 1.0;
                    this.meter.lap(cast<int>(Phase.Census));
                }
                this.g.surface().regrow(dt);
                // And the paths fade, for the same reason the woods grow back: without it every
                // cell anybody ever crossed is a road for ever, and after an arc the map is a
                // brown smear instead of a network. A route still in use is topped up far faster
                // than this takes it away, so what fades is exactly what stopped being used.
                this.paths.fade(dt);
                this.meter.lap(cast<int>(Phase.Regrow));
                // Split, because the phase profile said "beasts" and that is not an answer you can
                // act on. Ageing and breeding is one loop; walking is another; they are timed apart
                // so the next question gets asked of the right one.
                this.wild.live(dt);
                this.meter.lap(cast<int>(Phase.Breeding));
                this.wild.move(dt);
                this.meter.lap(cast<int>(Phase.Beasts));
                this.wild.prowl(dt);
                this.meter.lap(cast<int>(Phase.Prowl));
                this.live(dt);
                this.meter.lap(cast<int>(Phase.Living));
                this.think();
                this.meter.lap(cast<int>(Phase.Thinking));
                this.move(dt);
                this.meter.lap(cast<int>(Phase.Moving));
                this.meter.tick();
                return;
            }

            public method clockMeter() returns Meter* {
                return this.meter;
            }

            // How many people are standing where they could not possibly stand. The strongest
            // correctness check movement has: `stuck` counts those who gave up, but somebody who
            // walked THROUGH a cliff never gets stuck and never complains -- they simply end up in
            // the sea, and only a sweep finds them.
            public method offLand() returns int {
                mutable int bad = 0;
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        if (!this.walkable(cast<int>(this.folk.xAt(i)), cast<int>(this.folk.yAt(i)))) {
                            bad = bad + 1;
                        }
                    }
                    i = i + 1;
                }
                return bad;
            }

            public method report() returns void {
                // The worst frame is the budget by construction, so it says nothing on its own.
                // What matters is DEMAND against CAPACITY: how many decisions a second the population
                // actually wants, versus how many the budget can serve. Headroom is the real answer,
                // and a saturated worst frame at startup only means the queue absorbed the whole
                // population coming due on tick zero -- which is what it is for.
                int perFrame = cast<int>(this.thoughtTotal / cast<long>(this.frames));
                int capacity = this.budget * 60;
                int demand = this.folk.count() / 3;
                System.IO.Console.println($"sim: t={cast<int>(this.clock)}s over {this.frames} frames | arrivals {this.arrivals} | stuck {this.stuckTotal}");
                System.IO.Console.println($"  think: {perFrame}/frame average, worst {this.worstThink} (budget {this.budget}) | demand {demand}/s vs capacity {capacity}/s");
                System.IO.Console.println($"  people standing off walkable ground: {this.offLand()}");
                System.IO.Console.println($"  life: {this.folk.count()} alive | {this.births} born, {this.deathsOld} of old age, {this.deathsHunger} starved, {this.deathsIll} of illness, {this.deathsWar} killed, {this.deathsWorld} taken by the world");
                // THE number of this slice. Walking is pure cost -- it produces nothing -- so the
                // share of it says whether the map is a place people can live in or a distance they
                // spend their lives crossing. Everything about how big a community is, how far a
                // trade may range and whether the economy can stay local hangs off it.
                long busy = this.walkTicks + this.workTicks;
                mutable int share = 0;
                if (busy > 0) {
                    share = cast<int>(this.walkTicks * cast<long>(1000) / busy);
                }
                System.IO.Console.println($"  travel share: {share}/1000 of busy time spent walking");
                System.IO.Console.println($"  time: {this.walkTicks} walking to work, {this.workTicks} working, {this.wanderTicks} wandering with nothing to do");
                System.IO.Console.println($"  work: {this.carried} units carried home, {this.felled} nodes worked out, {this.noWork} decisions found nothing");
                System.IO.Console.println($"  food: {this.meals} eaten, {this.hungryTicks} times somebody found the larder empty");
                // What the world actually holds. THE number of this slice: a chain in ECONOMY.md
                // section 1 that no community ever fills is a chain that does not exist, whatever
                // the code says, and one held by a single village is a chain the world cannot rely
                // on. Reading it per good is the only way to tell those apart.
                System.IO.Console.println("  stores (produced / communities holding any):");
                mutable int idle = 0;
                for (int gd in 1..Goods.count()) {
                    long made = this.stores.producedOf(gd);
                    if (made == 0) {
                        idle = idle + 1;
                        continue;
                    }
                    System.IO.Console.println($"    {Goods.name(gd)}: {made} / {this.stores.holders(gd)}");
                }
                System.IO.Console.println($"    ({idle} goods never produced at all)");
                // How the trades were shared out, counted from the living rather than from intent --
                // and by JOB, because a smith has no Harvest class and counting by that one read
                // every craftsman in the world as idle.
                mutable int[] byTrade = new int[Job.count()]();
                int n = this.folk.limit();
                mutable int k = 0;
                while (k < n) {
                    if (this.folk.alive(k) && this.folk.isAdult(k)) {
                        int jb = this.folk.jobOf(k);
                        byTrade[jb] = byTrade[jb] + 1;
                    }
                    k = k + 1;
                }
                System.IO.Console.println($"  out of doors: wood {byTrade[cast<int>(Job.Woodcutter)]} | forage {byTrade[cast<int>(Job.Forager)]} | quarry {byTrade[cast<int>(Job.Quarrier)]} | mine {byTrade[cast<int>(Job.Miner)]} | fish {byTrade[cast<int>(Job.Fisher)]} | hunt {byTrade[cast<int>(Job.Hunter)]}");
                System.IO.Console.println($"  indoors: sawyer {byTrade[cast<int>(Job.Sawyer)]} | smith {byTrade[cast<int>(Job.Smith)]} | baker {byTrade[cast<int>(Job.Baker)]} | weaver {byTrade[cast<int>(Job.Weaver)]} | builder {byTrade[cast<int>(Job.Builder)]} | idle {byTrade[cast<int>(Job.Idle)]}");
                // Under arms, against everybody who is not. This line exists because the first war
                // measurement did not have it: crafting fell by two thirds and there was no number
                // anywhere saying that a third of the world's grown people were carrying a spear.
                mutable int grown = 0;
                for (int jb in 0..Job.count()) {
                    grown = grown + byTrade[jb];
                }
                mutable int armedShare = 0;
                if (grown > 0) {
                    armedShare = byTrade[cast<int>(Job.Raider)] * 100 / grown;
                }
                System.IO.Console.println($"  under arms: {byTrade[cast<int>(Job.Raider)]} of {grown} grown ({armedShare} in a hundred)");
                delete byTrade;
                // What the villages built, and whether the workshops in them ever run. A building
                // that stands and never makes anything is a chain that does not exist.
                System.IO.Console.println($"  built: {this.town.working()} standing of {this.town.count()} marked out | {this.crafted} batches made, {this.stalled} could not start");
                mutable String line = "  workshops:";
                for (int bk in 1..BuildingKind.count()) {
                    if (Builds.houses(bk)) {
                        continue;                        // shelter is counted on its own line
                    }
                    int cnt = this.town.countOfKind(bk);
                    if (cnt > 0) {
                        line = line + $" {Builds.name(bk)}={cnt}";
                    }
                }
                System.IO.Console.println(line);
                // Shelter, and whether the villages are keeping up with themselves. `under a roof`
                // is the number that matters: a place that is building housing and still falling
                // behind is one whose people are outrunning its timber, which is a story, and a
                // place at a hundred per cent has stopped needing to build at all.
                mutable String homes = "  homes:";
                mutable int roofs = 0;
                mutable int roofed = 0;
                mutable int souls = 0;
                for (int hc in 0..this.ncomm) {
                    if (this.cpop[hc] <= 0) {
                        continue;
                    }
                    souls = souls + this.cpop[hc];
                    mutable int r = this.croom[hc];
                    if (r > this.cpop[hc]) {
                        r = this.cpop[hc];
                    }
                    roofed = roofed + r;
                }
                for (int bk in 1..BuildingKind.count()) {
                    if (!Builds.houses(bk)) {
                        continue;
                    }
                    int cnt = this.town.countOfKind(bk);
                    roofs = roofs + cnt;
                    if (cnt > 0) {
                        homes = homes + $" {Builds.name(bk)}={cnt}";
                    }
                }
                mutable int sheltered = 0;
                if (souls > 0) {
                    sheltered = roofed * 100 / souls;
                }
                System.IO.Console.println($"  shelter: {roofs} homes standing | {roofed} of {souls} under a roof ({sheltered} per cent) | {this.housed} plots marked out, {this.rebuilt} rebuilt bigger, {this.pulled} workshops pulled down");
                System.IO.Console.println(homes);
                // The map of the world as its people drew it. `held` is how much ground anybody
                // claims at all, and the biggest and smallest countries say whether territory came
                // out as a shape or as a stamped disk -- if every place holds the same number of
                // blocks, the claim is not being read off the population, it is being drawn.
                mutable int[] land = new int[this.ncomm]();
                mutable int held = 0;
                for (int b in 0..this.claimW * this.claimH) {
                    int who = this.claim[b];
                    if (who >= 0) {
                        land[who] = land[who] + 1;
                        held = held + 1;
                    }
                }
                mutable int widest = 0;
                mutable int narrow = 0;
                mutable int countries = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    countries = countries + 1;
                    if (land[c] > widest) {
                        widest = land[c];
                    }
                    if (narrow == 0 || land[c] < narrow) {
                        narrow = land[c];
                    }
                }
                delete land;
                mutable int mean = 0;
                if (countries > 0) {
                    mean = held / countries;
                }
                System.IO.Console.println($"  land: {countries} places holding {held} blocks of {this.claimW * this.claimH} | widest {widest}, mean {mean}, narrowest {narrow}");
                System.IO.Console.println($"  spread: {this.hived} villages founded by splitting ({this.hivedFolk} folk walked out) | {this.joined} grew into a bigger neighbour ({this.joinedFolk} folk) | {this.fled} left a place that could not feed them");
                // War. `at war` is community-seconds and not wars: a quarrel has no beginning
                // anybody declares, so what can honestly be counted is how much of the world's time
                // was spent with somebody to fight. Places at war RIGHT NOW is the second number,
                // and if it is zero at the end of an arc while the first is large, the feuds all
                // burned out -- which is a world, not a bug.
                mutable int fighting = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] > 0 && this.cfoe[c] >= 0) {
                        fighting = fighting + 1;
                    }
                }
                System.IO.Console.println($"  war: {this.feuds} community-seconds at war, {fighting} places at war now | {this.raids} blows struck, {this.deathsWar} killed, {this.plunder} carried off somebody else's shelves");
                mutable int levy = 0;
                mutable int armed = 0;
                mutable int mailed = 0;
                mutable int p = 0;
                while (p < this.folk.limit()) {
                    if (this.folk.alive(p) && this.folk.jobOf(p) == cast<int>(Job.Raider)) {
                        if (this.folk.hasKit(p, AgentTable.K_ARMOUR)) {
                            mailed = mailed + 1;
                        } else if (this.folk.hasKit(p, AgentTable.K_WEAPON)) {
                            armed = armed + 1;
                        } else {
                            levy = levy + 1;
                        }
                    }
                    p = p + 1;
                }
                System.IO.Console.println($"  troops: {levy} levies, {armed} with a weapon, {mailed} in mail || {this.host.routedCount()} armies went home having had enough");
                System.IO.Console.println($"  standing between countries: {this.realm.friendships()} pairs at peace, {this.realm.alliances()} of them allied | {this.dealt} loads crossed a border");
                // What the world did without being asked. Kept apart from war on purpose: a world
                // where nobody has ever been killed by the ground they chose to live on is a world
                // where choosing that ground was free.
                System.IO.Console.println($"  the world's own hand: {this.fates.timesOf(cast<int>(Calamity.Eruption))} eruptions, {this.fates.timesOf(cast<int>(Calamity.Quake))} quakes, {this.fates.timesOf(cast<int>(Calamity.Fire))} fires, {this.fates.timesOf(cast<int>(Calamity.Flood))} floods, {this.fates.timesOf(cast<int>(Calamity.Storm))} storms");
                System.IO.Console.println($"    it killed {this.fates.everKilled()} and took down {this.fates.everWrecked()} buildings || fire alone: {this.fates.tollOf(cast<int>(Calamity.Fire))} dead, {this.fates.wreckedOf(cast<int>(Calamity.Fire))} burned");
                // What is left standing, against what the world started with. A resource that only
                // goes down is being liquidated, and this is where that shows.
                NodeField* nf = this.g.surface();
                System.IO.Console.println($"  left standing: timber {nf.totalOf(1)} | forage {nf.totalOf(2)} | quarry {nf.totalOf(3)} | ore {nf.totalOf(4)} | fishing {nf.totalOf(5)}");
                System.IO.Console.println($"  hunt: {this.hunted} animals brought down by people");
                // Who is listened to, and whether being listened to means anything. A world where
                // everybody follows has no temperament in it; one where nobody does has a leadership
                // that exists only in this line.
                mutable int seated = 0;
                for (int c in 0..this.ncomm) {
                    if (this.chief[c] >= 0) {
                        seated = seated + 1;
                    }
                }
                long said = this.followed + this.resisted;
                mutable int heed = 0;
                if (said > 0) {
                    heed = cast<int>(this.followed * cast<long>(1000) / said);
                }
                System.IO.Console.println($"  chiefs: {seated} seated | {this.risen} rose, {this.passed} handed on | {heed}/1000 of those spoken to went along ({this.followed} of {said})");
                mutable int elders = 0;
                mutable int priests = 0;
                for (int c in 0..this.ncomm) {
                    if (this.celder[c] >= 0) {
                        elders = elders + 1;
                    }
                    if (this.cpriest[c] >= 0) {
                        priests = priests + 1;
                    }
                }
                mutable int carters = 0;
                mutable int routes = 0;
                for (int c in 0..this.ncomm) {
                    if (this.ctchief[c] >= 0) {
                        carters = carters + 1;
                    }
                    if (this.ccaravan[c] >= 0) {
                        routes = routes + 1;
                    }
                }
                System.IO.Console.println($"  standing: {elders} elders, {priests} priests and {carters} trade chiefs seated now || {this.eldersSeated} elders, {this.priestsSeated} priests, {this.tradeChiefs} trade chiefs in all");
                mutable int lines = 0;
                for (int nat in 0..this.realm.limit()) {
                    if (this.realm.alive(nat) && this.nrailTo[nat] >= 0) {
                        lines = lines + 1;
                    }
                }
                mutable int ports = 0;
                mutable int overseas = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    if (this.cport[c] > 0) {
                        ports = ports + 1;
                    }
                    int d = this.ccaravan[c];
                    if (d >= 0 && d < this.ncomm && this.cnat[d] != this.cnat[c]) {
                        overseas = overseas + 1;
                    }
                }
                System.IO.Console.println($"  trade: {routes} routes running | {this.caravans} loads set out, {this.trafficked} units carried between towns");
                System.IO.Console.println($"  sea: {ports} towns with a harbour | {overseas} routes cross a border | {this.shipped} units went by water");
                mutable int dry = 0;
                mutable int thirsty = 0;
                mutable int inland = 0;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    if (!this.cfresh[c]) {
                        dry = dry + 1;
                    }
                    if (this.cdrink[c] < this.cpop[c]) {
                        thirsty = thirsty + 1;
                        inland = inland + this.cpop[c] - this.cdrink[c];
                    }
                }
                System.IO.Console.println($"  water: {dry} places with no river at hand | {thirsty} short of water | {inland} people without | {this.watered} works marked out");
                mutable int ailing = 0;
                mutable int q = 0;
                while (q < this.folk.limit()) {
                    if (this.folk.alive(q) && this.folk.illOf(q) > 0) {
                        ailing = ailing + 1;
                    }
                    q = q + 1;
                }
                System.IO.Console.println($"  sickness: {this.fellIll} took ill, {this.deathsIll} died of it, {ailing} ailing now | {this.tended} places raised against it");
                int years = cast<int>(this.clock / Simulation.YEAR);
                System.IO.Console.println($"  seasons: {years} years turned | the land is yielding {this.season()} in the hundred as this ends | {this.leanest} was the worst it got");
                System.IO.Console.println($"  rail: {lines} lines begun, {this.railed} cells of track laid");
                // THE number of the culture slice. Every community started at fifty on every axis,
                // so the spread at the end is entirely the work its people did coming back at them
                // through their children. A world where this stays near zero has a feedback loop
                // that is wired up and does nothing.
                mutable int[] lo = new int[5]();
                mutable int[] hi = new int[5]();
                mutable int[] sum = new int[5]();
                mutable int places = 0;
                for (int a in 0..5) {
                    lo[a] = 1000;
                    hi[a] = 0 - 1000;
                }
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    places = places + 1;
                    for (int a in 0..5) {
                        int v = this.cultureOf(c, a);
                        if (v < lo[a]) {
                            lo[a] = v;
                        }
                        if (v > hi[a]) {
                            hi[a] = v;
                        }
                        sum[a] = sum[a] + v;
                    }
                }
                // Where the world got to, and how. A world in one era learned nothing; a world all
                // in the last one has an era ladder too short to matter. The asymmetry between
                // neighbours is what the slice exists for.
                mutable int[] byEra = new int[Simulation.LAST_ERA + 1]();
                for (int nat in 0..this.realm.limit()) {
                    if (this.realm.alive(nat)) {
                        int e = this.realm.eraOf(nat);
                        byEra[e] = byEra[e] + 1;
                    }
                }
                System.IO.Console.println($"  eras: tribal {byEra[1]} | medieval {byEra[2]} | industrial {byEra[3]} | modern {byEra[4]} || {this.invented} invented, {this.learned} learned from a neighbour ({this.borrowed} of them from a cousin)");
                delete byEra;
                // The polities, and the shape of them. A world whose nations are all bands is a
                // world where nothing came together; one with a handful of empires and no bands
                // left is one where nothing can any longer come apart.
                int alive = this.realm.living();
                int bands = this.realm.countOfRank(cast<int>(Rank.Band));
                int chiefs = this.realm.countOfRank(cast<int>(Rank.Chiefdom));
                int kings = this.realm.countOfRank(cast<int>(Rank.Kingdom));
                int empires = this.realm.countOfRank(cast<int>(Rank.Empire));
                System.IO.Console.println($"  nations: {alive} living || {bands} bands, {chiefs} chiefdoms, {kings} kingdoms, {empires} empires || {this.annexed} towns changed hands, {this.extinct} peoples ended");
                // The peoples. A civilization is not a thing anybody joined -- it is the set of
                // countries that turn out to share a trunk, so this line is read off the same
                // language history the map is coloured from.
                int stocks = this.realm.civilizations();
                int tongues = this.realm.livingTongues();
                int eldest = this.realm.widestStock();
                if (eldest >= 0) {
                    int under = this.realm.nationsOfStock(eldest);
                    String greatest = Nations.stockName(eldest);
                    System.IO.Console.println($"  civilizations: {stocks} stocks speaking {tongues} living tongues || the widest is the {greatest}, {under} countries of one people");
                    for (int s in 0..this.realm.limit()) {
                        if (this.realm.trunkOf(s) == s && this.realm.nationsOfStock(s) > 1) {
                            String nm = Nations.stockName(s);
                            int cn = this.realm.nationsOfStock(s);
                            System.IO.Console.println($"    the {nm}: {cn} countries");
                        }
                    }
                }
                System.IO.Console.println($"  expansion: {this.hived} villages hived off ({this.hivedFolk} people), {this.colonies} colonies sent out ({this.colonists} settlers, {this.planted} arrived, {this.strayed} turned back), {this.joined} places merged");
                System.IO.Console.println($"  prospecting: {this.dug} tracts opened, {this.struck} working faces found");
                System.IO.Console.println($"  kit: {this.tooled} tools taken up, {this.wornOut} worn through || {this.armed} armed, {this.mailed} in mail");
                this.host.report();
                System.IO.Console.println($"  conquest: {this.conquests} towns taken by force, {this.converted} won over, {this.revolts} broke away");
                this.paths.report();
                int top = this.realm.biggest();
                if (top >= 0) {
                    int tp = this.realm.peopleOf(top);
                    int tt = this.realm.townsOf(top);
                    int tl = this.realm.landOf(top);
                    int te = this.realm.eraOf(top);
                    String tn = this.realm.nameOf(top);
                    String tc = this.realm.civilizationName(top);
                    System.IO.Console.println($"  the largest: {tn} of the {tc} -- {tp} people over {tt} towns and {tl} blocks, era {te}");
                }
                if (places > 0) {
                    System.IO.Console.println($"  culture over {places} places (all began at 50):");
                    System.IO.Console.println($"    bold {lo[0]}..{hi[0]} mean {sum[0] / places} | social {lo[1]}..{hi[1]} mean {sum[1] / places} | greed {lo[2]}..{hi[2]} mean {sum[2] / places}");
                    System.IO.Console.println($"    curious {lo[3]}..{hi[3]} mean {sum[3] / places} | ambition {lo[4]}..{hi[4]} mean {sum[4] / places}");
                }
                delete lo;
                delete hi;
                delete sum;
                this.wild.report();
                this.meter.report("clock");
                return;
            }
        }
    }
}
