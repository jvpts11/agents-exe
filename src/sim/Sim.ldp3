import System.IO.Console;
import Agents.World.Grid;
import Agents.World.Biomes;
import Agents.World.LandMath;
import Agents.World.NodeField;
import Agents.World.Nodes;
import Agents.World.Harvest;
import Agents.World.Good;
import Agents.World.Goods;
import Agents.World.BuildingKind;
import Agents.World.Craft;
import Agents.World.Builds;
import Agents.World.Species;
import Agents.World.Beasts;
import System.Math.Math;
import Agents.People.AgentTable;
import Agents.People.Act;
import Agents.People.Job;

// The clock. Named Simulation and not World or Sim: `World` is a NAMESPACE here and `Sim`
// is this one, and a type sharing either name corrupts symbol resolution -- which the compiler
// then reports against some unrelated file.
//
// Everything that changes over time is advanced from here, and it is split in two on
// purpose, because the two halves scale completely differently.
//
// THINKING is budgeted. A fixed number of agents decide per frame and no more, exactly as the
// terrain bake slices by cells rather than by rows -- the fix that killed the render stutter. An
// agent carries the tick it is next due, the queue is walked in order, and a bigger population means
// each person decides LESS OFTEN, never that more deciding happens in one frame. Constant cost per
// frame; more frames when there is more to do.
//
// MOVING is not budgeted, because it is a multiply-add: fifty thousand of them is nothing, and
// slicing it would only make positions stale for no gain. What the levels of detail actually save is
// the EXPENSIVE part of moving -- testing the ground and turning to face -- which only matters where
// somebody can see it. The rule from the design holds: you may fake what does not change an
// outcome, and travel TIME is an outcome while the trajectory is not, so everyone advances at the
// same speed and only those on screen walk around things.
program AgentsExe;

public bundle Agents {
    public namespace Sim {

        public class Simulation {
            private mutable Grid* g;
            private mutable AgentTable* folk;
            private mutable int seed;
            private mutable float clock;        // seconds since the world began
            private mutable int tick;           // whole seconds
            private mutable int cursor;         // where the think queue resumes
            private mutable int budget;         // agents allowed to decide in one frame
            // the near window, handed over by the renderer so a person on screen walks properly
            private mutable int nearX0;
            private mutable int nearY0;
            private mutable int nearX1;
            private mutable int nearY1;
            // instruments
            private mutable int thoughtThisFrame;
            private mutable int worstThink;
            private mutable int stuckTotal;
            private mutable int arrivals;
            private mutable long thoughtTotal;
            // Per community: how many live there, and how many are grown men and women. Rebuilt on
            // a slow clock -- one sweep of the table a second is nothing -- so every question about
            // whether a place can father or support anybody is a lookup.
            private mutable int[] cpop;
            private mutable int[] cadults;
            private mutable int[] cmales;
            private mutable float[] ccx;       // where the community actually is, as its mean
            private mutable float[] ccy;
            // Everything every community owns. It was a single `int cwood`, which was honest for one
            // trade and stopped being honest the moment there were six.
            private mutable Stores* stores;
            // Where this community knows there is work of each kind, or -1: one site per Harvest
            // class per community. A community is swept once a second anyway, so it can afford the
            // wide search that an individual cannot -- asking it costs one search per PLACE per
            // second instead of one per PERSON per decision.
            private mutable int[] cworkX;
            private mutable int[] cworkY;
            // How many of its grown people are already in each trade, so a place cannot become a
            // thousand woodcutters and no fishermen. Indexed by JOB and not by Harvest class,
            // because building and crafting are trades too and neither goes out to a resource.
            private mutable int[] ctrade;
            // Everything standing or going up anywhere in the world.
            private mutable Buildings* town;
            // And everything alive that is not a person.
            private mutable Wildlife* wild;
            private mutable long hunted;
            private mutable Meter* meter;
            // Who each community listens to, or -1, and what that person leans toward. A ROLE, not a
            // person: it outlives whoever fills it, because nobody lives longer than six minutes and
            // a leadership that died with its leader would never be seen at all.
            private mutable int[] chief;
            private mutable int[] lean;        // the Job the chief's temperament pushes toward
            private mutable long risen;        // roles that came into being
            private mutable long passed;       // and were handed on when the holder died
            private mutable long followed;     // decisions swayed by a chief
            private mutable long resisted;
            // Who claims each 16-cell block, or -1. Territory has no rule of its own yet -- that is
            // its own slice -- but it has an honest meaning already: a community's land is what its
            // people can reach and work, so the claim is a disk around where they actually are, and
            // where two disks overlap the nearer village wins. Stamped per community rather than
            // tested per block: a hundred villages times a six-block box is three thousand writes a
            // second, against a million and a half the other way round.
            private mutable int[] claim;
            private mutable int claimW;
            private mutable int claimH;
            private mutable int claimAge;      // bumped on every rebuild, so the renderer can notice
            private mutable long crafted;      // batches finished
            private mutable long stalled;      // batches that could not start for want of an input
            private mutable long raised;       // buildings finished
            private mutable int ncomm;
            private mutable float censusDue;
            private mutable long births;
            private mutable long deathsOld;
            private mutable long deathsHunger;
            // The number this slice exists to produce: seconds spent walking against seconds spent
            // working. On a map thirty-two times the original's it is the one that says whether a
            // person can make a living within a walk of home, or whether the whole economy has to
            // become regional.
            // Only journeys WITH A PURPOSE count here. Wandering is counted apart, because folding it
            // in flatters nothing and lies about everything: an idle child ambling in circles would
            // read as a woodcutter with a long commute, and the ratio would say the world is too big
            // when what it really said is that most people had nothing to do.
            private mutable long walkTicks;
            private mutable long wanderTicks;
            private mutable long workTicks;
            private mutable long felled;       // nodes worked out entirely
            private mutable long carried;      // units that reached a store
            private mutable long noWork;       // decisions that found nothing to do
            private mutable long meals;        // units eaten
            private mutable long hungryTicks;  // seconds lived by somebody with nothing to eat
            private mutable int frames;

            public static float SPEED = 1.25;       // cells a second

            // ---- the clock ----
            //
            // The step is FIXED and the RATE is what moves. Everything in this file is written
            // against dt -- hunger accrues per second, a walk covers SPEED cells a second, a batch
            // takes so many seconds -- and all of it stays true only while the step stays small.
            // Running the world faster by handing `step` a bigger dt would let a walker cross a
            // river in one frame and a woodcutter finish a tree he never reached; running it faster
            // by taking MORE steps changes nothing at all except how long the wall clock waits.
            //
            // So `advance` takes real seconds, multiplies by the rate, and spends the result in
            // whole ticks -- carrying the remainder, so no time is lost to rounding at any rate.
            public static float TICK = 0.05;
            public static int CATCHUP = 240;        // ticks one call may spend before it gives up

            private mutable float rate;
            private mutable float owed;
            private mutable boolean halted;

            public method setRate(float r) returns void {
                if (r < 0.0) {
                    return;
                }
                this.rate = r;
                this.owed = 0.0;
                return;
            }

            public method rateOf() returns float {
                return this.rate;
            }

            public method setHalted(boolean h) returns void {
                this.halted = h;
                this.owed = 0.0;
                return;
            }

            public method isHalted() returns boolean {
                return this.halted;
            }

            // Advance by `real` seconds of wall clock. Returns the ticks actually spent, which is
            // what a caller wants for a frame counter and also what tells it the machine could not
            // keep up: at a high rate the answer stops rising, and the world simply runs at whatever
            // the hardware can do instead of falling further behind on every frame.
            public method advance(float real) returns int {
                if (this.halted || this.rate <= 0.0) {
                    return 0;
                }
                this.owed = this.owed + real * this.rate;
                mutable int n = 0;
                while (this.owed >= Simulation.TICK && n < Simulation.CATCHUP) {
                    this.step(Simulation.TICK);
                    this.owed = this.owed - Simulation.TICK;
                    n = n + 1;
                }
                if (n >= Simulation.CATCHUP) {
                    // Whatever is still owed is time the machine never had. Dropping it is the only
                    // way out: carrying it forward means every frame owes more than the last, which
                    // is how a simulation stops responding altogether.
                    this.owed = 0.0;
                }
                return n;
            }

            public constructor Simulation(Grid* grid, AgentTable* people, int worldSeed) {
                this.g = grid;
                this.folk = people;
                this.seed = worldSeed;
                this.clock = 0.0;
                this.tick = 0;
                this.cursor = 0;
                this.budget = 2000;
                this.nearX0 = 0;
                this.nearY0 = 0;
                this.nearX1 = 0;
                this.nearY1 = 0;
                this.thoughtThisFrame = 0;
                this.worstThink = 0;
                this.stuckTotal = 0;
                this.arrivals = 0;
                this.thoughtTotal = 0;
                this.ncomm = 256;
                this.cpop = new int[this.ncomm]();
                this.cadults = new int[this.ncomm]();
                this.cmales = new int[this.ncomm]();
                this.ccx = new float[this.ncomm]();
                this.ccy = new float[this.ncomm]();
                this.stores = new Stores(this.ncomm) on heap;
                int nh = Harvest.count();
                this.cworkX = new int[this.ncomm * nh]();
                this.cworkY = new int[this.ncomm * nh]();
                this.ctrade = new int[this.ncomm * Job.count()]();
                this.town = new Buildings(this.ncomm * 16) on heap;
                this.claimW = (grid.width() + 15) / 16;
                this.claimH = (grid.height() + 15) / 16;
                this.claim = new int[this.claimW * this.claimH]();
                for (int b in 0..this.claimW * this.claimH) {
                    this.claim[b] = 0 - 1;
                }
                this.claimAge = 0;
                this.rate = 1.0;
                this.owed = 0.0;
                this.halted = false;
                this.wild = new Wildlife(grid, 60000, worldSeed) on heap;
                this.wild.seed(6);
                this.hunted = 0;
                this.meter = new Meter() on heap;
                this.chief = new int[this.ncomm]();
                this.lean = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    this.chief[c] = 0 - 1;
                    this.lean[c] = cast<int>(Job.Idle);
                }
                this.risen = 0;
                this.passed = 0;
                this.followed = 0;
                this.resisted = 0;
                this.crafted = 0;
                this.stalled = 0;
                this.raised = 0;
                for (int s in 0..this.ncomm * nh) {
                    this.cworkX[s] = 0 - 1;                 // nowhere known yet, and (0,0) is not it
                }
                this.censusDue = 0.0;
                this.births = 0;
                this.deathsOld = 0;
                this.deathsHunger = 0;
                this.walkTicks = 0;
                this.wanderTicks = 0;
                this.workTicks = 0;
                this.felled = 0;
                this.carried = 0;
                this.noWork = 0;
                this.meals = 0;
                this.hungryTicks = 0;
                this.frames = 0;
            }

            public destructor ~Simulation() returns void {
                delete this.cpop;
                delete this.cadults;
                delete this.cmales;
                delete this.ccx;
                delete this.ccy;
                delete this.stores;
                delete this.cworkX;
                delete this.cworkY;
                delete this.ctrade;
                delete this.town;
                delete this.claim;
                delete this.wild;
                delete this.meter;
                delete this.chief;
                delete this.lean;
            }

            // A village is where somebody starts being listened to. Below it a band simply defers to
            // whoever is oldest and nothing is decided; above it there is a role, and the role stays
            // when its holder dies.
            public static int VILLAGE = 120;

            // The standing at which somebody counts as properly established.
            //
            // Guessed twice and wrong both times, which is worth writing down. First against the
            // byte's range, 255: two people in a hundred went along. Then against "a few dozen
            // deeds", 45: five in a hundred. Then the run was asked instead of estimated -- a
            // village chief carries about eight, because an adult life is roughly two hundred and
            // fifty seconds and a load comes home every thirty. So this is fifteen: reachable by a
            // long and busy life, and a chief who has it sways two villagers in five.
            //
            // The lesson is the one this project keeps relearning: a constant that is supposed to
            // mean "what a life reaches" must be READ OFF a life, never reasoned toward.
            public static int NOTABLE = 15;

            public method fauna() returns Wildlife* {
                return this.wild;
            }

            // How far a community's claim reaches, in cells. Not a number picked to look right: it
            // is WORK_BLOCKS of sixteen cells, the same distance the community searches for work,
            // because what a village holds is what its people can get to and back from.
            public static int REIGN = 48;

            private method restake() returns void {
                for (int b in 0..this.claimW * this.claimH) {
                    this.claim[b] = 0 - 1;
                }
                int r = (Simulation.REIGN + 15) / 16;
                for (int c in 0..this.ncomm) {
                    if (this.cpop[c] <= 0) {
                        continue;
                    }
                    int cbx = cast<int>(this.ccx[c]) / 16;
                    int cby = cast<int>(this.ccy[c]) / 16;
                    mutable int dy = 0 - r;
                    while (dy <= r) {
                        mutable int dx = 0 - r;
                        while (dx <= r) {
                            int bx = cbx + dx;
                            int by = cby + dy;
                            if (bx < 0 || by < 0 || bx >= this.claimW || by >= this.claimH) {
                                dx = dx + 1;
                                continue;
                            }
                            if (dx * dx + dy * dy > r * r) {
                                dx = dx + 1;
                                continue;
                            }
                            int at = by * this.claimW + bx;
                            int held = this.claim[at];
                            if (held < 0) {
                                this.claim[at] = c;
                            } else {
                                // Two villages reach the same ground: the nearer one holds it.
                                float ax = this.ccx[c] - cast<float>(bx * 16 + 8);
                                float ay = this.ccy[c] - cast<float>(by * 16 + 8);
                                float bxd = this.ccx[held] - cast<float>(bx * 16 + 8);
                                float byd = this.ccy[held] - cast<float>(by * 16 + 8);
                                if (ax * ax + ay * ay < bxd * bxd + byd * byd) {
                                    this.claim[at] = c;
                                }
                            }
                            dx = dx + 1;
                        }
                        dy = dy + 1;
                    }
                }
                this.claimAge = this.claimAge + 1;
                // Wildlife is told the same thing, once, and treats settled ground as no longer
                // habitat. Fourteen thousand writes a second against a billion and a half distance
                // tests a frame is the whole reason it is done this way round.
                for (int by in 0..this.claimH) {
                    for (int bx in 0..this.claimW) {
                        this.wild.setSettled(bx, by, this.claim[by * this.claimW + bx] >= 0);
                    }
                }
                this.wild.reindex();
                return;
            }

            // Who holds this cell, or -1. The block says which community is near, and the cell-level
            // range test rounds the block grid off into a disk -- so a border reads as the edge of
            // how far people go, not as the sixteen-cell squares the index happens to use.
            public method ownerAt(int x, int y) returns int {
                if (x < 0 || y < 0) {
                    return 0 - 1;
                }
                int bx = x / 16;
                int by = y / 16;
                if (bx >= this.claimW || by >= this.claimH) {
                    return 0 - 1;
                }
                int c = this.claim[by * this.claimW + bx];
                if (c < 0) {
                    return 0 - 1;
                }
                float dx = this.ccx[c] - (cast<float>(x) + 0.5);
                float dy = this.ccy[c] - (cast<float>(y) + 0.5);
                if (dx * dx + dy * dy > cast<float>(Simulation.REIGN * Simulation.REIGN)) {
                    return 0 - 1;
                }
                // Nobody holds the sea, and nobody holds a cliff face. A claim is over ground its
                // people can walk on and work -- which is also what stops a coastal village looking
                // like a naval power on the map.
                if (!this.walkable(x, y)) {
                    return 0 - 1;
                }
                return c;
            }

            public method claimVersion() returns int {
                return this.claimAge;
            }

            public method store() returns Stores* {
                return this.stores;
            }

            public method buildings() returns Buildings* {
                return this.town;
            }

            public method setBudget(int b) returns void
                requires b > 0
            {
                this.budget = b;
                return;
            }

            // The renderer knows which cells are on screen at full detail; the simulation needs the
            // same rectangle to know who is worth walking properly.
            public method setNearWindow(int x0, int y0, int x1, int y1) returns void {
                this.nearX0 = x0;
                this.nearY0 = y0;
                this.nearX1 = x1;
                this.nearY1 = y1;
                return;
            }

            public method seconds() returns float {
                return this.clock;
            }

            public method thoughtLastFrame() returns int {
                return this.thoughtThisFrame;
            }

            public method worstFrame() returns int {
                return this.worstThink;
            }

            public method stuck() returns int {
                return this.stuckTotal;
            }

            public method arrived() returns int {
                return this.arrivals;
            }

            private method walkable(int x, int y) returns boolean {
                if (x < 0 || y < 0 || x >= this.g.width() || y >= this.g.height()) {
                    return false;
                }
                return Biomes.walkable(this.g.biomeAt(x, y));
            }

            // Can this be walked to in a straight line? Six samples along the way, which is all a
            // person needs to see that the far bank is across water. Without it an agent sets off
            // toward somewhere it can plainly see it cannot reach, slides along the shore for thirty
            // seconds and gives up -- and half the abandoned journeys were exactly that.
            private method clearLine(float x0, float y0, int tx, int ty) returns boolean {
                float dx = cast<float>(tx) + 0.5 - x0;
                float dy = cast<float>(ty) + 0.5 - y0;
                mutable int k = 1;
                while (k <= 6) {
                    float f = cast<float>(k) / 7.0;
                    if (!this.walkable(cast<int>(x0 + dx * f), cast<int>(y0 + dy * f))) {
                        return false;
                    }
                    k = k + 1;
                }
                return true;
            }

            // Pick somewhere to go. For now that is a spot near where the agent already is, which is
            // not a placeholder: a community lives and works within a short walk of home, and that
            // is exactly what keeps travel affordable on a map thirty-two times the original's.
            // Journeys BETWEEN communities are a different verb and get the region graph with them.
            private method chooseTarget(int i) returns void {
                float here_x = this.folk.xAt(i);
                float here_y = this.folk.yAt(i);
                mutable int k = 0;
                while (k < 8) {
                    float a = LandMath.hash01(this.seed ^ 0x77E1, i * 31 + k, this.tick) * 6.2831853;
                    float d = 3.0 + LandMath.hash01(this.seed ^ 0x1C4B, i * 17 + k, this.tick) * 20.0;
                    int tx = cast<int>(here_x + LandMath.cos(a) * d);
                    int ty = cast<int>(here_y + LandMath.sin(a) * d);
                    if (this.walkable(tx, ty) && this.clearLine(here_x, here_y, tx, ty)) {
                        this.folk.setTarget(i, tx, ty);
                        this.folk.setAct(i, cast<int>(Act.Wander));
                        return;
                    }
                    k = k + 1;
                }
                // Nowhere to go from here: stand still rather than walk into the sea.
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // The budgeted half. Walk the queue from where it stopped, decide for those who are due,
            // and stop at the budget -- the queue keeps its place, so nobody is ever skipped, they
            // simply wait their turn.
            private method think() returns void {
                this.thoughtThisFrame = 0;
                int n = this.folk.limit();
                if (n == 0) {
                    return;
                }
                mutable int scanned = 0;
                while (scanned < n && this.thoughtThisFrame < this.budget) {
                    mutable int i = this.cursor;
                    this.cursor = this.cursor + 1;
                    if (this.cursor >= n) {
                        this.cursor = 0;
                    }
                    scanned = scanned + 1;
                    if (!this.folk.alive(i)) {
                        continue;
                    }
                    if (this.folk.thinkAtOf(i) > this.tick) {
                        continue;
                    }
                    // A grown person takes a trade their community has room and work for, and then
                    // goes and does it. Everybody being a woodcutter -- which is what the previous
                    // slice measured -- was the harshest possible test of travel, and it also took
                    // ninety-one per cent of the world's trees in one arc. What stops that is not a
                    // cap on cutting: it is that there are five other things worth doing.
                    if (this.folk.isAdult(i)) {
                        if (this.folk.jobOf(i) == cast<int>(Job.Idle)) {
                            this.chooseJob(i);
                        }
                        int jb = this.folk.jobOf(i);
                        if (jb == cast<int>(Job.Builder)) {
                            this.workBuild(i);
                        } else if (jb == cast<int>(Job.Hunter)) {
                            this.workHunt(i);
                        } else if (this.craftOfJob(jb) != cast<int>(Craft.NoCraft)) {
                            this.workCraft(i);
                        } else {
                            this.workGather(i);
                        }
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Idle)) {
                        this.chooseTarget(i);
                    }
                    // Re-decide in two to four seconds, spread so a cohort born together does not
                    // come due on the same tick for the rest of their lives.
                    //
                    // Only if nothing above asked for longer. This used to be unconditional, which
                    // quietly cancelled every backing-off a decision made: somebody who had just
                    // learned there is no wood for miles and asked not to be woken for half a minute
                    // was woken two seconds later to learn it again.
                    if (this.folk.thinkAtOf(i) <= this.tick) {
                        int jitter = cast<int>(LandMath.hash01(this.seed ^ 0x3F09, i, this.tick) * 3.0);
                        this.folk.setThinkAt(i, this.tick + 2 + jitter);
                    }
                    this.thoughtThisFrame = this.thoughtThisFrame + 1;
                }
                if (this.thoughtThisFrame > this.worstThink) {
                    this.worstThink = this.thoughtThisFrame;
                }
                this.thoughtTotal = this.thoughtTotal + cast<long>(this.thoughtThisFrame);
                return;
            }

            private method nearby(int x, int y) returns boolean {
                return x >= this.nearX0 && y >= this.nearY0 && x < this.nearX1 && y < this.nearY1;
            }

            // A load comes off the tree, and the tree really loses it. `harvest` returns what was
            // actually there, which is how a resource that runs out differs from one that only says
            // it does -- the last cutter at a nearly-empty tree gets whatever is left and no more.
            private method chop(int i) returns void {
                NodeField* nf = this.g.surface();
                int t = this.folk.targetNodeOf(i);
                if (t < 0) {
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    return;
                }
                // What comes off it is decided by the NODE and not by the worker: the table in
                // docs/ECONOMY.md section 1 says an oak gives Wood and a salt deposit gives Salt,
                // and reading it here is what stops the trades and the world drifting apart.
                int good = Nodes.gives(nf.kindAt(t));
                int got = nf.harvest(t, this.loadFor(this.harvestOf(this.folk.jobOf(i))));
                if (got <= 0) {
                    this.folk.setTargetNode(i, 0 - 1);
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    return;
                }
                if (nf.qtyAt(t) <= 0) {
                    this.felled = this.felled + 1;               // that one is gone for good
                    this.folk.setTargetNode(i, 0 - 1);
                }
                this.folk.setCarry(i, good, got);
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // The unbudgeted half. Everyone advances at the same speed, so travel time is honest
            // everywhere; only the people on screen pay for testing the ground and turning to face.
            private method move(float dt) returns void {
                float span = Simulation.SPEED * dt;
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (!this.folk.alive(i)) {
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Gather)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        if (this.folk.timerOf(i) >= this.workTime(this.harvestOf(this.folk.jobOf(i)))) {
                            this.chop(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Hunt)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        if (this.folk.timerOf(i) >= Simulation.STALK) {
                            this.killDone(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Refine)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        int wp = this.folk.workplaceOf(i);
                        if (wp >= 0 && this.folk.timerOf(i) >= Builds.secs(this.town.kindOf(wp))) {
                            this.batchDone(i);
                        }
                        i = i + 1;
                        continue;
                    }
                    if (this.folk.actOf(i) == cast<int>(Act.Build)) {
                        this.folk.addTimer(i, dt);
                        this.workTicks = this.workTicks + 1;
                        int wp = this.folk.workplaceOf(i);
                        if (wp < 0 || this.town.isWorking(wp)) {
                            this.folk.setAct(i, cast<int>(Act.Idle));
                            i = i + 1;
                            continue;
                        }
                        if (this.town.raise(wp, dt)) {
                            int k = this.town.kindOf(wp);
                            int own = this.town.ownerOf(wp);
                            this.stores.take(own, cast<int>(Good.Wood), Builds.woodCost(k));
                            this.stores.take(own, cast<int>(Good.Stone), Builds.stoneCost(k));
                            this.raised = this.raised + 1;
                            // Raising a building is the biggest single thing anybody does alone.
                            this.folk.earn(i, 12);
                            this.folk.setAct(i, cast<int>(Act.Idle));
                            this.folk.setJob(i, cast<int>(Job.Idle));
                            this.folk.setWorkplace(i, 0 - 1);
                        }
                        i = i + 1;
                        continue;
                    }
                    boolean wandering = this.folk.actOf(i) == cast<int>(Act.Wander);
                    if (this.folk.actOf(i) != cast<int>(Act.WalkTo) && !wandering) {
                        i = i + 1;
                        continue;
                    }
                    if (wandering) {
                        this.wanderTicks = this.wanderTicks + 1;
                    } else {
                        this.walkTicks = this.walkTicks + 1;
                    }
                    float x = this.folk.xAt(i);
                    float y = this.folk.yAt(i);
                    float tx = cast<float>(this.folk.targetXOf(i)) + 0.5;
                    float ty = cast<float>(this.folk.targetYOf(i)) + 0.5;
                    float dx = tx - x;
                    float dy = ty - y;
                    // Squared distance for the arrival test: there is no reason to take a root just
                    // to compare against a constant, and this runs fifty thousand times a frame.
                    float d2 = dx * dx + dy * dy;
                    if (d2 < 0.2025) {
                        this.folk.setAct(i, cast<int>(Act.Idle));
                        this.arrivals = this.arrivals + 1;
                        i = i + 1;
                        continue;
                    }
                    // Math.sqrt is one machine instruction. LandMath.sqrt -- which the worldgen and
                    // the renderer both use -- is a sixteen-iteration Newton loop, sixteen DIVISIONS
                    // per call, and at fifty thousand calls a frame that is the whole cost of moving.
                    float dist = cast<float>(Math.sqrt(cast<double>(d2)));
                    // `setAct` zeroes the timer, so a timer still at zero means this is the first
                    // step of the walk and the distance in hand is the whole journey.
                    if (this.folk.timerOf(i) == 0.0) {
                        this.folk.setJourney(i, dist);
                    }
                    this.folk.addTimer(i, dt);
                    // Patience is measured against the length of THIS journey, three times what it
                    // ought to take plus a few seconds of slack for going round things. A flat
                    // half-minute -- what this was -- called every walk longer than thirty-seven
                    // cells a failure, so the moment people started going to woodland forty-eight
                    // cells off, one journey in six was reported as broken routing when the only
                    // thing broken was the stopwatch.
                    if (this.folk.timerOf(i) > 5.0 + 3.0 * this.folk.journeyOf(i) / Simulation.SPEED) {
                        this.stuckTotal = this.stuckTotal + 1;
                        this.folk.setAct(i, cast<int>(Act.Idle));
                        i = i + 1;
                        continue;
                    }
                    float ux = dx / dist;
                    float uy = dy / dist;
                    mutable float nx = x + ux * span;
                    mutable float ny = y + uy * span;
                    int cx = cast<int>(x);
                    int cy = cast<int>(y);
                    // THE GROUND TEST IS NOT OPTIONAL, at any level of detail. It was, and a sweep
                    // found three hundred and ninety-four people standing in the sea and on bare
                    // cliffs -- while `stuck` read zero, because somebody who walks THROUGH a cliff
                    // never gets stuck and never complains. Ending up somewhere you could never be
                    // is an outcome, and the rule only ever allowed faking what is not one.
                    //
                    // Sliding is not optional either, and that was a second mistake on the same
                    // axis: whether you slide along a rock or stop dead at it decides whether you
                    // ARRIVE, and arriving is an outcome. Restricting it to the near tier left
                    // three thousand journeys a minute abandoned off screen and none on it.
                    //
                    // What a level of detail may actually skip is turning to face the way you walk,
                    // which nobody can see from outside the window and which changes nothing.
                    if (!this.walkable(cast<int>(nx), cast<int>(ny))) {
                        if (this.walkable(cast<int>(nx), cy)) {
                            ny = y;
                        } else if (this.walkable(cx, cast<int>(ny))) {
                            nx = x;
                        } else {
                            nx = x;
                            ny = y;
                        }
                    }
                    if (this.nearby(cx, cy)) {
                        mutable int d = 0;
                        if (ux >= 0.0 && uy >= 0.0) {
                            d = 1;
                        } else if (ux >= 0.0) {
                            d = 2;
                        } else if (uy >= 0.0) {
                            d = 0;
                        } else {
                            d = 3;
                        }
                        this.folk.setDir(i, d);
                    }
                    this.folk.setPos(i, nx, ny);
                    i = i + 1;
                }
                return;
            }

            // Everything that happens to a body whether it wants it or not. This runs for EVERYBODY
            // every step and is not on the think budget: ageing and hunger are not decisions, and
            // somebody off screen must age at exactly the rate of somebody on it or it stops being
            // one world. It is a handful of byte updates a head, cheaper than deciding to skip them.
            public static float ADULT_AT = 60.0;
            public static float HUNGER_EVERY = 7.0;      // one point of hunger per this many seconds
            // Both of these were set against a scale that does not exist. Hunger killed at a hundred
            // points and a life is three hundred and sixty seconds, so at a point every seven the
            // most anyone ever reached was fifty-one: NOBODY COULD STARVE, and the starvation counter
            // read zero for the honest reason that the mechanism was unreachable. Eating started at
            // thirty, which is two hundred and ten seconds -- most of a life -- so a person ate about
            // once before dying of old age and the larders filled up with food nobody wanted.
            //
            // Against a six-minute life: peckish after thirty-five seconds, dead after a hundred and
            // seventy-five without anything at all. That is about ten meals in a life, which is what
            // makes food a constraint instead of decoration.
            public static int HUNGRY_AT = 5;
            public static int STARVE_AT = 25;
            public static float TIRED_EVERY = 12.0;
            public static float TERM = 45.0;             // a pregnancy
            public static float FERTILE_TO = 0.85;       // of a lifespan
            // What a full larder means, in units of food per head. Reach it and a community is as
            // fertile as it gets; hold half of it and the birth rate halves with it.
            //
            // This replaces CARRY, a fixed number of people that stood in for how much food there
            // was. The design said from the start that both it and FERTILITY "stand in for the real
            // limit -- how much food there is -- and are replaced by it, not tuned around it, when
            // the economy arrives". It has arrived: a community's ceiling is now something it can
            // raise by working well and lose by stripping the land around it.
            public static int LARDER = 8;
            public static float FERTILITY = 0.045;       // chance per SECOND with a full larder

            private method live(float dt) returns void {
                float t = this.clock;
                boolean hungrier = cast<int>(t / Simulation.HUNGER_EVERY) > cast<int>((t - dt) / Simulation.HUNGER_EVERY);
                boolean wearier = cast<int>(t / Simulation.TIRED_EVERY) > cast<int>((t - dt) / Simulation.TIRED_EVERY);
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (!this.folk.alive(i)) {
                        i = i + 1;
                        continue;
                    }
                    this.folk.addAge(i, dt);
                    if (this.folk.ageOf(i) >= this.folk.lifespanOf(i)) {
                        this.folk.kill(i);
                        this.deathsOld = this.deathsOld + 1;
                        i = i + 1;
                        continue;
                    }
                    if (!this.folk.isAdult(i) && this.folk.ageOf(i) >= Simulation.ADULT_AT) {
                        this.folk.makeAdult(i);
                    }
                    // Needs are whole points in a byte, so they are only touched on the step where a
                    // whole point has actually accrued. Rounding a fraction up every frame would
                    // starve the world in seconds.
                    if (hungrier) {
                        this.folk.setHunger(i, this.folk.hungerOf(i) + 1);
                    }
                    if (wearier) {
                        this.folk.setTired(i, this.folk.tiredOf(i) + 1);
                    }
                    if (this.folk.hungerOf(i) >= Simulation.STARVE_AT) {
                        this.folk.kill(i);
                        this.deathsHunger = this.deathsHunger + 1;
                        i = i + 1;
                        continue;
                    }
                    // Food was free until this slice, and CARRY stood in for it. It is real now:
                    // eating takes something edible out of the community's store, and if the store
                    // is empty the hunger stays and eventually kills. This is the whole reason the
                    // forager and the fisherman exist, and the reason a place that quarries
                    // beautifully and grows nothing does not last.
                    if (this.folk.hungerOf(i) >= Simulation.HUNGRY_AT) {
                        int hh = this.folk.homeOf(i);
                        int ate = this.stores.eat(hh, 1);
                        if (ate > 0) {
                            this.meals = this.meals + cast<long>(ate);
                            this.folk.setHunger(i, 0);
                        } else {
                            this.hungryTicks = this.hungryTicks + 1;
                        }
                    }
                    if (this.folk.tiredOf(i) >= 70) {
                        this.folk.setTired(i, 0);
                    }
                    if (this.folk.gestate(i, dt)) {
                        int child = this.folk.bear(i, this.seed, cast<int>(this.births));
                        if (child >= 0) {
                            this.births = this.births + 1;
                        }
                    }
                    // Conceiving belongs HERE and not among the decisions. It used to ride on the
                    // think queue, which quietly tied the birth rate to how often somebody happened
                    // to be wondering about firewood: the moment a woodcutter with no wood in reach
                    // learned to stop asking every two seconds, the women of that community stopped
                    // conceiving with them, and the world fell from forty-nine thousand to seven.
                    // A body is not on a budget.
                    // Once a SECOND, not twenty times a second, and spread so the world does not
                    // check everybody on the same tick. The odds are two in a thousand per tick;
                    // rolling that twenty times and rolling it once at twenty times the chance are
                    // the same population and one twentieth of the arithmetic -- and the profile
                    // said this loop was twenty-nine per cent of the whole clock.
                    if ((i + this.frames) % 20 == 0) {
                        if (this.mayConceive(i, dt * 20.0)) {
                            this.folk.conceive(i, Simulation.TERM);
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            private method census() returns void {
                int nh = Harvest.count();
                int nj = Job.count();
                this.town.clearHands();
                mutable int c = 0;
                while (c < this.ncomm) {
                    this.cpop[c] = 0;
                    this.cadults[c] = 0;
                    this.cmales[c] = 0;
                    this.ccx[c] = 0.0;
                    this.ccy[c] = 0.0;
                    for (int jb in 0..nj) {
                        this.ctrade[c * nj + jb] = 0;
                    }
                    c = c + 1;
                }
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm) {
                            this.cpop[h] = this.cpop[h] + 1;
                            this.ccx[h] = this.ccx[h] + this.folk.xAt(i);
                            this.ccy[h] = this.ccy[h] + this.folk.yAt(i);
                            if (this.folk.isAdult(i)) {
                                this.cadults[h] = this.cadults[h] + 1;
                                if (!this.folk.isFemale(i)) {
                                    this.cmales[h] = this.cmales[h] + 1;
                                }
                                // Who is already doing what, and who is standing in which workshop.
                                // Counted from the people themselves and never incrementally, so a
                                // death or a change of trade can never leave a phantom worker
                                // holding a place in a quota or a bench in a forge.
                                int jb = this.folk.jobOf(i);
                                this.ctrade[h * nj + jb] = this.ctrade[h * nj + jb] + 1;
                                int wp = this.folk.workplaceOf(i);
                                if (wp >= 0) {
                                    this.town.addHand(wp);
                                }
                            }
                        }
                    }
                    i = i + 1;
                }
                // Where a community IS, taken as where its people are. Nobody planted a flag: the
                // centre is the average of everybody standing there, so it drifts as they do -- and
                // when a place empties out, it stops existing rather than leaving a marker behind.
                c = 0;
                while (c < this.ncomm) {
                    if (this.cpop[c] > 0) {
                        this.ccx[c] = this.ccx[c] / cast<float>(this.cpop[c]);
                        this.ccy[c] = this.ccy[c] / cast<float>(this.cpop[c]);
                        // And where its work is, of every kind. The wide search happens HERE, once
                        // for the whole place, instead of once per person per decision -- which was
                        // eighteen million failed searches in two hours of world time, each sweeping
                        // six thousand cells, and four fifths of the running time.
                        for (int hc in 1..Harvest.count()) {
                            this.findWork(c, hc);
                        }
                        this.considerBuilding(c);
                    } else {
                        for (int hc in 0..Harvest.count()) {
                            this.cworkX[c * Harvest.count() + hc] = 0 - 1;
                        }
                    }
                    c = c + 1;
                }
                this.restake();
                this.hearWho();
                return;
            }

            // Who each community listens to. Nobody is appointed: the census already walks everybody,
            // so it can see who has the most standing and hand the role to them -- and hand it on
            // again when they die, which at six minutes a life is often. That is what makes a
            // succession an event rather than a script.
            private method hearWho() returns void {
                int n = this.folk.limit();
                mutable int[] bestI = new int[this.ncomm]();
                mutable int[] bestV = new int[this.ncomm]();
                for (int c in 0..this.ncomm) {
                    bestI[c] = 0 - 1;
                    bestV[c] = 0 - 1;
                }
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i) && this.folk.isAdult(i)) {
                        int h = this.folk.homeOf(i);
                        if (h >= 0 && h < this.ncomm) {
                            int v = this.folk.influenceOf(i);
                            if (v > bestV[h]) {
                                bestV[h] = v;
                                bestI[h] = i;
                            }
                        }
                    }
                    i = i + 1;
                }
                for (int c in 0..this.ncomm) {
                    int had = this.chief[c];
                    boolean vacant = had < 0 || !this.folk.alive(had)
                                  || this.folk.homeOf(had) != c;
                    if (this.cpop[c] < Simulation.VILLAGE) {
                        // A band is too small to need anybody in charge. If it had a chief and has
                        // shrunk below a village, the role goes away with the reason for it.
                        if (had >= 0 && this.folk.alive(had)) {
                            this.folk.setRole(had, cast<int>(Role.None));
                        }
                        this.chief[c] = 0 - 1;
                        this.lean[c] = cast<int>(Job.Idle);
                        continue;
                    }
                    if (!vacant) {
                        continue;                          // still living, still theirs
                    }
                    int heir = bestI[c];
                    if (heir < 0 || bestV[c] <= 0) {
                        continue;                          // nobody has done anything worth heeding
                    }
                    this.folk.setRole(heir, cast<int>(Role.Chief));
                    this.chief[c] = heir;
                    this.lean[c] = this.leaning(heir);
                    if (had < 0) {
                        this.risen = this.risen + 1;
                    } else {
                        this.passed = this.passed + 1;
                    }
                }
                delete bestI;
                delete bestV;
                return;
            }

            // What a person pushes their village toward, read off the temperament they were born
            // with and drifted from their mother. It is not a plan and it is not optimal -- a greedy
            // chief wants the village digging whether or not the village needs stone. That is the
            // point: it is why two communities on identical ground come out different.
            private method leaning(int i) returns int {
                int bold = this.folk.boldnessOf(i);
                int greed = this.folk.greedOf(i);
                int social = this.folk.sociabilityOf(i);
                int curious = this.folk.curiosityOf(i);
                mutable int best = greed;
                mutable int pick = cast<int>(Job.Miner);
                if (bold > best) {
                    best = bold;
                    pick = cast<int>(Job.Hunter);
                }
                if (social > best) {
                    best = social;
                    pick = cast<int>(Job.Builder);
                }
                if (curious > best) {
                    best = curious;
                    pick = cast<int>(Job.Quarrier);
                }
                return pick;
            }

            // What this community should put up next, if anything. The rule is docs/ECONOMY.md's own:
            // a building is GROWN FROM NEED, and need is visible as a pile. A village with wood
            // stacking up and no sawmill wants a sawmill; one with iron and no charcoal does not want
            // a smithy, it wants a kiln -- and it finds that out because the smithy it would have
            // built stalls, and a stalled workshop is a want the next census can read.
            //
            // Nothing is spent here. Marking out a site costs nothing but the decision; the timber
            // and stone come out of the store when the builders have actually raised it, so a plan
            // can never eat a village's winter.
            private method considerBuilding(int c) returns void {
                if (this.town.find(c, cast<int>(BuildingKind.TownHall)) < 0) {
                    // The seat, free at founding, at the middle of where the people actually are.
                    int b = this.town.mark(cast<int>(this.ccx[c]), cast<int>(this.ccy[c]),
                                           cast<int>(BuildingKind.TownHall), c);
                    if (b >= 0) {
                        this.town.raise(b, Buildings.RAISE);
                    }
                    return;
                }
                if (this.town.unfinished(c) >= 0) {
                    return;                          // one thing at a time; finish it first
                }
                mutable int best = cast<int>(BuildingKind.NoBuilding);
                mutable int bestScore = 0;
                for (int k in 1..BuildingKind.count()) {
                    if (!Builds.produces(k)) {
                        continue;
                    }
                    if (this.town.find(c, k) >= 0) {
                        continue;                    // it already has one
                    }
                    if (!this.stores.has(c, cast<int>(Good.Wood), Builds.woodCost(k))) {
                        continue;
                    }
                    if (!this.stores.has(c, cast<int>(Good.Stone), Builds.stoneCost(k))) {
                        continue;
                    }
                    // Worth is the SCARCER input, not the sum: a smithy is worth what it can smelt,
                    // and all the iron in the world is worth nothing without charcoal.
                    mutable int worth = this.stores.amountOf(c, Builds.in1(k));
                    if (Builds.in2(k) != cast<int>(Good.Nothing)) {
                        int other = this.stores.amountOf(c, Builds.in2(k));
                        if (other < worth) {
                            worth = other;
                        }
                    }
                    if (worth > bestScore) {
                        bestScore = worth;
                        best = k;
                    }
                }
                if (best == cast<int>(BuildingKind.NoBuilding) || bestScore < Simulation.WANT) {
                    return;
                }
                // Somewhere near the middle, on ground you can stand on and not on top of something
                // already there.
                mutable int tries = 0;
                while (tries < 10) {
                    float a = LandMath.hash01(this.seed ^ 0x7C3B, c * 31 + tries, this.tick) * 6.2831853;
                    float d = 4.0 + LandMath.hash01(this.seed ^ 0x51A9, c * 17 + tries, this.tick) * 10.0;
                    int px = cast<int>(this.ccx[c] + LandMath.cos(a) * d);
                    int py = cast<int>(this.ccy[c] + LandMath.sin(a) * d);
                    if (this.walkable(px, py)) {
                        this.town.mark(px, py, best, c);
                        return;
                    }
                    tries = tries + 1;
                }
                return;
            }

            // Enough of an input piling up to be worth a workshop.
            public static int WANT = 60;

            // How many of a community's grown people should be in one trade. Everybody doing the same
            // thing is not a village, and it is also the fastest way to strip a resource: the first
            // measurement had thirty-two thousand woodcutters take ninety-one per cent of the world's
            // trees in one arc. A share per trade, with a floor, so a small place still fishes.
            private method quotaFor(int c, int job) returns int {
                int adults = this.cadults[c];
                if (adults <= 0) {
                    return 0;
                }
                mutable int q = adults / 6;
                // Except that a hungry place puts most of its hands on food. A flat share of the
                // adults for every trade is what a spreadsheet does, not what people do: the first
                // measurement had a sixth of each village foraging while the larder was empty seventy
                // million times over, and the world died out in nineteen generations with woodcutters
                // still dutifully cutting wood.
                if (job == cast<int>(Job.Forager) || job == cast<int>(Job.Fisher)
                    || job == cast<int>(Job.Hunter)) {
                    if (this.stores.foodOf(c) < this.cpop[c] * Simulation.LARDER) {
                        q = adults / 2;
                    }
                }
                if (q < 2) {
                    q = 2;
                }
                return q;
            }

            // How long one load takes, and how much of it comes away. Picking berries is not felling
            // an oak and neither is cutting into a seam: giving them all the same eighteen seconds
            // said a forager feeds about as many mouths as a woodcutter fills woodsheds, which is how
            // a world with plenty of berries in it starved to death.
            private method workTime(int hclass) returns float {
                if (hclass == cast<int>(Harvest.Forage)) {
                    return 8.0;
                }
                if (hclass == cast<int>(Harvest.Fishing)) {
                    return 12.0;
                }
                if (hclass == cast<int>(Harvest.Quarry)) {
                    return 22.0;
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return 28.0;
                }
                return Simulation.CHOP;
            }

            private method loadFor(int hclass) returns int {
                if (hclass == cast<int>(Harvest.Forage)) {
                    return 12;
                }
                if (hclass == cast<int>(Harvest.Fishing)) {
                    return 20;
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return 8;
                }
                return Simulation.LOAD;
            }

            // The nearest BLOCK with work of one kind, in blocks of sixteen cells. Not the nearest
            // node: a community that knows one tree sends everybody to it, the first arrival takes
            // it and the rest walk to a stump. A block is an area, so people spread out inside it by
            // themselves, and it stays true without being re-searched because `harvest` decrements
            // it as things are used up.
            //
            // A place with nothing of that kind within reach records none, and its people stop
            // asking instead of each of them discovering the same emptiness over and over.
            private method findWork(int c, int hclass) returns void {
                NodeField* nf = this.g.surface();
                int at = c * Harvest.count() + hclass;
                int cbx = cast<int>(this.ccx[c]) / 16;
                int cby = cast<int>(this.ccy[c]) / 16;
                if (this.cworkX[at] >= 0) {
                    if (nf.inBlock(this.cworkX[at], this.cworkY[at], hclass) > 0) {
                        return;                                  // it is all still there
                    }
                }
                mutable int r = 0;
                while (r <= Simulation.WORK_BLOCKS) {
                    mutable int dx = 0 - r;
                    while (dx <= r) {
                        if (nf.inBlock(cbx + dx, cby - r, hclass) > 0) {
                            this.cworkX[at] = cbx + dx;
                            this.cworkY[at] = cby - r;
                            return;
                        }
                        if (nf.inBlock(cbx + dx, cby + r, hclass) > 0) {
                            this.cworkX[at] = cbx + dx;
                            this.cworkY[at] = cby + r;
                            return;
                        }
                        dx = dx + 1;
                    }
                    mutable int dy = 1 - r;
                    while (dy <= r - 1) {
                        if (nf.inBlock(cbx - r, cby + dy, hclass) > 0) {
                            this.cworkX[at] = cbx - r;
                            this.cworkY[at] = cby + dy;
                            return;
                        }
                        if (nf.inBlock(cbx + r, cby + dy, hclass) > 0) {
                            this.cworkX[at] = cbx + r;
                            this.cworkY[at] = cby + dy;
                            return;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                this.cworkX[at] = 0 - 1;
                return;
            }

            // Whether a grown woman conceives now, as a logistic against the LARDER: the chance falls
            // as the food per head falls, so the population finds its own level rather than running
            // away or dying out -- and the level is now something the community's own work decides.
            //
            // The first attempt died out inside fifteen generations, and the arithmetic says exactly
            // why -- worth keeping written down, because it is the same shape of mistake every time.
            // A woman must bear TWO children to replace herself and a man. Her fertile window runs
            // from sixty seconds to FERTILE_TO of a life, about two hundred and fifty seconds. Each
            // child costs TERM in gestation plus 1/(p*room) waiting to conceive, so
            // 2*(TERM + 1/(p*room)) <= 250 -- which at p = 0.045 a second puts the balance at about
            // room = 0.28. The first attempt had an effective chance of 0.0057 a second inside a
            // window of two hundred and fifty: most women never conceived at all.
            //
            // The shape underneath was wrong too. With `p = base * emptiness`, the only point where
            // births balance deaths is emptiness = 1, which is a population of zero: it was drawn
            // toward extinction by construction. With FERTILITY set well ABOVE replacement, the
            // balance lands at a real population instead, and the world finds it rather than me.
            private method mayConceive(int i, float dt) returns boolean {
                if (!this.folk.isFemale(i) || !this.folk.isAdult(i) || this.folk.isPregnant(i)) {
                    return false;
                }
                if (this.folk.ageOf(i) > this.folk.lifespanOf(i) * Simulation.FERTILE_TO) {
                    return false;
                }
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return false;
                }
                if (this.cmales[h] == 0) {
                    return false;                       // nobody to father a child
                }
                // How much room there is, which since this slice means HOW MUCH FOOD THERE IS. CARRY
                // was a stand-in for it and the design said so from the start: "both numbers stand
                // in for the real limit -- how much food there is -- and are replaced by it, not
                // tuned around it, when the economy arrives." It has arrived. A community with a
                // full larder is empty; one living hand to mouth does not conceive.
                float larder = cast<float>(this.stores.foodOf(h))
                             / cast<float>(this.cpop[h] * Simulation.LARDER + 1);
                mutable float room = larder;
                if (room > 1.0) {
                    room = 1.0;
                }
                if (room <= 0.0) {
                    return false;
                }
                // Per SECOND scaled by the step, not per decision -- and drawn on the frame counter,
                // because `tick` is whole seconds and would hand the same number to all twenty steps
                // inside one of them.
                return LandMath.hash01(this.seed ^ 0x6C21, i, this.frames) < Simulation.FERTILITY * dt * room;
            }

            public static int WORK_BLOCKS = 3;           // 16-cell blocks a COMMUNITY looks over: 48 cells
            public static int REACH = 6;                 // cells a person searches where they stand
            // A WORK SESSION, not a grab. At five seconds a load the trade was seventy-one per cent
            // walking -- and the wood was only seven or eight cells away, so the map was never the
            // reason. What decides that ratio is how much work one trip is worth, and five seconds
            // of felling for twelve of carrying is not what cutting firewood is. At eighteen, a man
            // spends his day at the tree and the walk becomes what it should be: the cost of the
            // trip, not the trip itself.
            public static float CHOP = 18.0;             // seconds to take a load off a tree
            public static int LOAD = 10;                 // wood carried in one trip

            // The nearest node this trade can work, searched ring by ring outward so the FIRST one
            // found is the closest and the search stops there. Ring by ring and not square by square:
            // scanning the whole box at each radius would re-test everything inside it and turn a
            // search into a sweep.
            //
            // A PERSON only ever calls this with a small radius, standing where the community said
            // the work was. The wide version belongs to the community and runs once a second.
            private method findNode(int i, int hclass, int reach) returns int {
                NodeField* nf = this.g.surface();
                int cx = cast<int>(this.folk.xAt(i));
                int cy = cast<int>(this.folk.yAt(i));
                mutable int here = nf.nodeAt(cx, cy, hclass);
                if (here >= 0) {
                    return here;
                }
                mutable int r = 1;
                while (r <= reach) {
                    mutable int dx = 0 - r;
                    while (dx <= r) {
                        mutable int t = nf.nodeAt(cx + dx, cy - r, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        t = nf.nodeAt(cx + dx, cy + r, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        dx = dx + 1;
                    }
                    mutable int dy = 1 - r;
                    while (dy <= r - 1) {
                        mutable int t = nf.nodeAt(cx - r, cy + dy, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        t = nf.nodeAt(cx + r, cy + dy, hclass);
                        if (t >= 0) {
                            return t;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                return 0 - 1;
            }

            // The trade a Job goes out to do. Not every job is an extraction -- the refiners work in
            // buildings and have no Harvest class at all, which is exactly why they wait for them.
            private method harvestOf(int job) returns int {
                if (job == cast<int>(Job.Woodcutter)) {
                    return cast<int>(Harvest.Timber);
                }
                if (job == cast<int>(Job.Forager)) {
                    return cast<int>(Harvest.Forage);
                }
                if (job == cast<int>(Job.Quarrier)) {
                    return cast<int>(Harvest.Quarry);
                }
                if (job == cast<int>(Job.Miner)) {
                    return cast<int>(Harvest.Mine);
                }
                if (job == cast<int>(Job.Fisher)) {
                    return cast<int>(Harvest.Fishing);
                }
                return cast<int>(Harvest.Nothing);
            }

            private method jobOfHarvest(int hclass) returns int {
                if (hclass == cast<int>(Harvest.Timber)) {
                    return cast<int>(Job.Woodcutter);
                }
                if (hclass == cast<int>(Harvest.Forage)) {
                    return cast<int>(Job.Forager);
                }
                if (hclass == cast<int>(Harvest.Quarry)) {
                    return cast<int>(Job.Quarrier);
                }
                if (hclass == cast<int>(Harvest.Mine)) {
                    return cast<int>(Job.Miner);
                }
                if (hclass == cast<int>(Harvest.Fishing)) {
                    return cast<int>(Job.Fisher);
                }
                return cast<int>(Job.Idle);
            }

            // Choose a trade. Two rules, in order, and both of them are about the community rather
            // than the person: you do not take up a trade there is no work for, and you do not take
            // up one that is already full. What is left is picked by what the place is SHORT of --
            // food first, because a village that quarries beautifully and starves is not a village.
            private method chooseJob(int i) returns void {
                int h = this.folk.homeOf(i);
                if (h < 0 || h >= this.ncomm) {
                    return;
                }
                int nh = Harvest.count();
                int nj = Job.count();
                mutable int best = cast<int>(Job.Idle);
                mutable int bestScore = 0;
                for (int hc in 1..nh) {
                    if (this.cworkX[h * nh + hc] < 0) {
                        continue;                            // nothing of the kind within reach
                    }
                    int jb = this.jobOfHarvest(hc);
                    if (this.ctrade[h * nj + jb] >= this.quotaFor(h, jb)) {
                        continue;                            // that trade is full here
                    }
                    // Hungry places want food. It is not a preference, it is the only need the
                    // simulation can kill you for.
                    mutable int want = 10;
                    if (hc == cast<int>(Harvest.Forage) || hc == cast<int>(Harvest.Fishing)) {
                        want = 10 + 40 * (this.cpop[h] + 1) / (this.stores.foodOf(h) + 1);
                        if (want > 100) {
                            want = 100;
                        }
                    }
                    if (want > bestScore) {
                        bestScore = want;
                        best = jb;
                    }
                }
                // Hunting is not a Harvest class -- its resource walks -- so it is asked for on its
                // own terms: is there game within a hunter's range of where this village is.
                int hb = cast<int>(Job.Hunter);
                if (this.ctrade[h * nj + hb] < this.quotaFor(h, hb)) {
                    int cbx = cast<int>(this.ccx[h]) / 16;
                    int cby = cast<int>(this.ccy[h]) / 16;
                    mutable boolean game = false;
                    mutable int gy = 0 - Simulation.GAME_BLOCKS;
                    while (gy <= Simulation.GAME_BLOCKS) {
                        mutable int gx = 0 - Simulation.GAME_BLOCKS;
                        while (gx <= Simulation.GAME_BLOCKS) {
                            if (this.wild.preyInBlock(cbx + gx, cby + gy) > 0) {
                                game = true;
                                gx = Simulation.GAME_BLOCKS;
                            }
                            gx = gx + 1;
                        }
                        gy = gy + 1;
                    }
                    if (game) {
                        // Meat is food, so a hungry village wants a hunter as badly as a forager.
                        mutable int want = 12;
                        int need = 10 + 40 * (this.cpop[h] + 1) / (this.stores.foodOf(h) + 1);
                        if (need > want) {
                            want = need;
                        }
                        if (want > 100) {
                            want = 100;
                        }
                        if (want > bestScore) {
                            bestScore = want;
                            best = hb;
                        }
                    }
                }
                // A workshop with an empty bench beats going out to the field: it is nearer, the
                // work is worth more, and somebody has already decided the village needs it.
                for (int cr in 1..Craft.count()) {
                    if (this.town.openFor(h, cr) < 0) {
                        continue;
                    }
                    int jb = this.jobOfCraft(cr);
                    if (this.ctrade[h * nj + jb] >= this.quotaFor(h, jb)) {
                        continue;
                    }
                    if (55 > bestScore) {
                        bestScore = 55;
                        best = jb;
                    }
                }
                // And something half-built beats everything, because until it stands nobody can
                // work in it and the whole reason it was marked out goes unanswered.
                if (this.town.unfinished(h) >= 0) {
                    int jb = cast<int>(Job.Builder);
                    if (this.ctrade[h * nj + jb] < this.quotaFor(h, jb)) {
                        bestScore = 120;
                        best = jb;
                    }
                }
                // And then somebody speaks. A chief does not ASSIGN work -- there is no such power in
                // this world and inventing one would make the whole leadership a lie -- they lean,
                // and whether that lands is decided by the listener, not the speaker. A bold and
                // ambitious person shrugs it off; a sociable one with nothing to prove goes along.
                //
                // The chief's own standing is the weight. Someone who has done nothing sways nobody
                // even holding the role, which is what stops a new heir inheriting real authority
                // along with the title.
                int lead = this.chief[h];
                if (lead >= 0 && lead != i && this.lean[h] != cast<int>(Job.Idle)) {
                    int jb = this.lean[h];
                    if (this.ctrade[h * nj + jb] < this.quotaFor(h, jb)) {
                        // Sway is measured against what a LIFE can earn, not against what the byte
                        // can hold. Dividing by 255 said two people in a hundred went along, which
                        // is not a leadership -- and the reason was arithmetic, not temperament: a
                        // six-minute life accumulates thirty-odd deeds, so a chief was being judged
                        // at a tenth of the scale the formula assumed. NOTABLE is the level at which
                        // somebody is properly established, and past it more renown adds nothing.
                        mutable int sway = this.folk.influenceOf(lead);
                        if (sway > Simulation.NOTABLE) {
                            sway = Simulation.NOTABLE;
                        }
                        int mind = this.folk.sociabilityOf(i) + 40
                                 - this.folk.boldnessOf(i) / 2 - this.folk.ambitionOf(i) / 2;
                        int odds = sway * mind / Simulation.NOTABLE;
                        if (cast<int>(LandMath.hash01(this.seed ^ 0x2E77, i, this.tick) * 100.0) < odds) {
                            this.followed = this.followed + 1;
                            best = jb;
                        } else {
                            this.resisted = this.resisted + 1;
                        }
                    }
                }
                if (best != cast<int>(Job.Idle)) {
                    this.folk.setJob(i, best);
                    this.ctrade[h * nj + best] = this.ctrade[h * nj + best] + 1;
                }
                return;
            }

            private method jobOfCraft(int craft) returns int {
                if (craft == cast<int>(Craft.Wright)) {
                    return cast<int>(Job.Sawyer);
                }
                if (craft == cast<int>(Craft.Smith)) {
                    return cast<int>(Job.Smith);
                }
                if (craft == cast<int>(Craft.Victualler)) {
                    return cast<int>(Job.Baker);
                }
                if (craft == cast<int>(Craft.Weaving)) {
                    return cast<int>(Job.Weaver);
                }
                return cast<int>(Job.Idle);
            }

            private method craftOfJob(int job) returns int {
                if (job == cast<int>(Job.Sawyer)) {
                    return cast<int>(Craft.Wright);
                }
                if (job == cast<int>(Job.Smith)) {
                    return cast<int>(Craft.Smith);
                }
                if (job == cast<int>(Job.Baker)) {
                    return cast<int>(Craft.Victualler);
                }
                if (job == cast<int>(Job.Weaver)) {
                    return cast<int>(Craft.Weaving);
                }
                return cast<int>(Craft.NoCraft);
            }

            // Busy means committed to something. Wandering is NOT: somebody strolling because they had
            // nothing better to do should drop it the moment there is work, or half the population
            // spends its life finishing an aimless walk it started three seconds ago.
            private method busy(int i) returns boolean {
                int a = this.folk.actOf(i);
                return a != cast<int>(Act.Idle) && a != cast<int>(Act.Wander);
            }

            // Hunting. It is the one trade whose resource RUNS AWAY, and that is the whole difference
            // from the five that stand still: a hunter walks to where the herds are, and the herds
            // have already moved off settled ground, so he works the edge of his own community's
            // land rather than the middle of it.
            //
            // He does not chase. A kill is a stalk that takes as long as felling a tree, and if the
            // animal has wandered off in the meantime he has lost it -- which is exactly the shape
            // the woodcutter has with a tree somebody else emptied.
            public static float STALK = 20.0;            // seconds to bring one down
            public static int GAME_BLOCKS = 5;           // 16-cell blocks a hunter will range over

            private method workHunt(int i) returns void {
                int h = this.folk.homeOf(i);
                if (this.folk.carryAmtOf(i) > 0) {
                    if (this.busy(i)) {
                        return;
                    }
                    float hx = this.ccx[h];
                    float hy = this.ccy[h];
                    float dx = hx - this.folk.xAt(i);
                    float dy = hy - this.folk.yAt(i);
                    if (dx * dx + dy * dy < 4.0) {
                        int amt = this.folk.carryAmtOf(i);
                        this.stores.add(h, this.folk.carryKindOf(i), amt);
                        this.carried = this.carried + cast<long>(amt);
                        // Bringing food and timber home counts, a little at a time. Standing is
                        // mostly accumulated by ORDINARY work done for years, which is why age and
                        // deeds end up correlated without age being a term in it.
                        this.folk.earn(i, 1);
                        this.folk.setCarry(i, 0, 0);
                    } else {
                        this.folk.setTarget(i, cast<int>(hx), cast<int>(hy));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                        return;
                    }
                }
                if (this.busy(i)) {
                    return;
                }
                // Something within arm's reach: stalk it.
                int q = this.wild.preyNear(this.folk.xAt(i), this.folk.yAt(i), 3.0);
                if (q >= 0) {
                    this.folk.setTargetNode(i, q);
                    this.folk.setAct(i, cast<int>(Act.Hunt));
                    return;
                }
                // Otherwise walk toward the nearest block the census says holds game.
                int cbx = cast<int>(this.folk.xAt(i)) / 16;
                int cby = cast<int>(this.folk.yAt(i)) / 16;
                mutable int r = 0;
                while (r <= Simulation.GAME_BLOCKS) {
                    mutable int dy = 0 - r;
                    while (dy <= r) {
                        mutable int dx = 0 - r;
                        while (dx <= r) {
                            if (dx * dx + dy * dy > r * r || (r > 0 && dx * dx + dy * dy < (r - 1) * (r - 1))) {
                                dx = dx + 1;
                                continue;
                            }
                            if (this.wild.preyInBlock(cbx + dx, cby + dy) > 0) {
                                int tx = (cbx + dx) * 16 + 8;
                                int ty = (cby + dy) * 16 + 8;
                                if (this.walkable(tx, ty)) {
                                    this.folk.setTarget(i, tx, ty);
                                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                                    return;
                                }
                            }
                            dx = dx + 1;
                        }
                        dy = dy + 1;
                    }
                    r = r + 1;
                }
                this.noWork = this.noWork + 1;
                this.folk.setJob(i, cast<int>(Job.Idle));
                this.folk.setThinkAt(i, this.tick + 30);
                return;
            }

            // The stalk paid off, or it did not. `take` says which species it was, so the meat and
            // the hide come off the animal's own table rather than out of a number here.
            private method killDone(int i) returns void {
                int q = this.folk.targetNodeOf(i);
                this.folk.setTargetNode(i, 0 - 1);
                this.folk.setAct(i, cast<int>(Act.Idle));
                if (q < 0 || !this.wild.aliveAt(q)) {
                    return;                               // it wandered off; that is hunting
                }
                float dx = this.wild.xAt(q) - this.folk.xAt(i);
                float dy = this.wild.yAt(q) - this.folk.yAt(i);
                if (dx * dx + dy * dy > 36.0) {
                    return;                               // out of reach by the time it mattered
                }
                int sp = this.wild.take(q);
                if (sp <= 0) {
                    return;
                }
                int h = this.folk.homeOf(i);
                // A carrier holds one good, so the meat goes home on his back and the hide is put
                // straight into the store where he stands -- he is at the kill, not at the village,
                // but a skin is light and a carcass is not.
                this.stores.add(h, cast<int>(Good.Hide), Beasts.hide(sp));
                this.folk.setCarry(i, cast<int>(Good.RawMeat), Beasts.meat(sp));
                this.hunted = this.hunted + 1;
                // A kill is seen, and it is remembered.
                this.folk.earn(i, 6);
                return;
            }

            // Raising a building. The builder walks to the site and works; when the last hour goes in
            // the timber and stone come out of the store and it opens. Paying at the END and not at
            // the start is what stops a plan from eating a village: a site nobody ever finishes has
            // cost nothing but the walking.
            private method workBuild(int i) returns void {
                int h = this.folk.homeOf(i);
                int b = this.town.unfinished(h);
                if (b < 0) {
                    this.folk.setJob(i, cast<int>(Job.Idle));
                    return;
                }
                if (this.busy(i)) {
                    return;
                }
                float bxf = cast<float>(this.town.xAt(b));
                float byf = cast<float>(this.town.yAt(b));
                float dx = bxf - this.folk.xAt(i);
                float dy = byf - this.folk.yAt(i);
                if (dx * dx + dy * dy >= 4.0) {
                    this.folk.setTarget(i, this.town.xAt(b), this.town.yAt(b));
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                this.folk.setWorkplace(i, b);
                this.folk.setAct(i, cast<int>(Act.Build));
                return;
            }

            // Working inside one. A craftsman does not travel to a resource -- the resource has
            // already been carried home by somebody else, which is the whole point of the store
            // existing -- so this is a walk to the workshop and then a batch at a time.
            private method workCraft(int i) returns void {
                int h = this.folk.homeOf(i);
                int craft = this.craftOfJob(this.folk.jobOf(i));
                mutable int b = this.folk.workplaceOf(i);
                if (b < 0 || !this.town.isWorking(b) || this.town.ownerOf(b) != h
                    || Builds.craft(this.town.kindOf(b)) != craft) {
                    b = this.town.openFor(h, craft);
                    if (b < 0) {
                        this.folk.setWorkplace(i, 0 - 1);
                        this.folk.setJob(i, cast<int>(Job.Idle));
                        this.folk.setThinkAt(i, this.tick + 20);
                        return;
                    }
                    this.folk.setWorkplace(i, b);
                }
                if (this.busy(i)) {
                    return;
                }
                float bxf = cast<float>(this.town.xAt(b));
                float byf = cast<float>(this.town.yAt(b));
                float dx = bxf - this.folk.xAt(i);
                float dy = byf - this.folk.yAt(i);
                if (dx * dx + dy * dy >= 4.0) {
                    this.folk.setTarget(i, this.town.xAt(b), this.town.yAt(b));
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                this.folk.setAct(i, cast<int>(Act.Refine));
                return;
            }

            // A batch comes off the bench. The inputs leave the store and the output enters it, and
            // if an input is missing the batch does not happen -- the workshop STALLS, and that stall
            // is the signal the next census reads when it decides what the village should build.
            private method batchDone(int i) returns void {
                int b = this.folk.workplaceOf(i);
                if (b < 0 || !this.town.isWorking(b)) {
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    return;
                }
                int h = this.town.ownerOf(b);
                int k = this.town.kindOf(b);
                int a1 = Builds.in1(k);
                int a2 = Builds.in2(k);
                boolean ready = this.stores.has(h, a1, Builds.n1(k))
                             && (a2 == cast<int>(Good.Nothing) || this.stores.has(h, a2, Builds.n2(k)));
                if (!ready) {
                    this.stalled = this.stalled + 1;
                    this.folk.setAct(i, cast<int>(Act.Idle));
                    this.folk.setThinkAt(i, this.tick + 6);
                    return;
                }
                this.stores.take(h, a1, Builds.n1(k));
                if (a2 != cast<int>(Good.Nothing)) {
                    this.stores.take(h, a2, Builds.n2(k));
                }
                this.stores.add(h, Builds.out(k), Builds.nout(k));
                this.crafted = this.crafted + 1;
                this.folk.earn(i, 1);
                this.folk.setAct(i, cast<int>(Act.Idle));
                return;
            }

            // Any extractive trade, whole: find something of your kind, walk to it, work a load off
            // it, carry it home, put it in the store. Everything an economy needs is in this loop --
            // a resource that runs out, a distance that costs time, and a store that grows.
            //
            // It is ONE method for all five trades and not five methods, because a woodcutter and a
            // fisherman differ in exactly two things: which Harvest class they look for and which
            // Good comes off it. Everything else -- the community's site, the local search, the
            // walk, the load, the trip home -- is the same work, and writing it five times would be
            // five places to fix the next thing found wrong with it.
            private method workGather(int i) returns void {
                NodeField* nf = this.g.surface();
                int h = this.folk.homeOf(i);
                int hclass = this.harvestOf(this.folk.jobOf(i));
                if (hclass == cast<int>(Harvest.Nothing)) {
                    return;
                }
                if (this.folk.carryAmtOf(i) > 0) {
                    // Carrying: head home if not already going there, hand over on arrival.
                    if (this.busy(i)) {
                        return;
                    }
                    float hx = this.ccx[h];
                    float hy = this.ccy[h];
                    float dx = hx - this.folk.xAt(i);
                    float dy = hy - this.folk.yAt(i);
                    if (dx * dx + dy * dy < 4.0) {
                        int amt = this.folk.carryAmtOf(i);
                        this.stores.add(h, this.folk.carryKindOf(i), amt);
                        this.carried = this.carried + cast<long>(amt);
                        // Bringing food and timber home counts, a little at a time. Standing is
                        // mostly accumulated by ORDINARY work done for years, which is why age and
                        // deeds end up correlated without age being a term in it.
                        this.folk.earn(i, 1);
                        this.folk.setCarry(i, 0, 0);
                        // and straight back out. Returning here left the man standing in his own
                        // village with nothing decided, so the next thing that touched him was the
                        // wander -- which is why a fifth of all the time in the world was being
                        // spent strolling in circles between one load and the next.
                    } else {
                        this.folk.setTarget(i, cast<int>(hx), cast<int>(hy));
                        this.folk.setAct(i, cast<int>(Act.WalkTo));
                        return;
                    }
                }
                if (this.busy(i)) {
                    return;
                }
                int t = this.folk.targetNodeOf(i);
                if (t >= 0) {
                    // Standing at the thing it set out for -- unless somebody else emptied it first,
                    // which is exactly what a shared, finite resource does to a plan.
                    if (nf.qtyAt(t) > 0) {
                        this.folk.setAct(i, cast<int>(Act.Gather));
                        return;
                    }
                    this.folk.setTargetNode(i, 0 - 1);
                }
                // Look around where you stand -- six cells, not forty. If there is nothing, you do not
                // go looking: you go where your community says the work is, and only search again
                // once you are there. A person who does not know the world cannot search it, and a
                // person who searches it forty cells at a time, thousands of times a second, is a
                // profiler entry rather than a woodcutter.
                int at = h * Harvest.count() + hclass;
                mutable int found = this.findNode(i, hclass, Simulation.REACH);
                if (found < 0) {
                    if (h < 0 || h >= this.ncomm || this.cworkX[at] < 0) {
                        this.noWork = this.noWork + 1;
                        this.folk.setJob(i, cast<int>(Job.Idle));  // this trade has nothing here
                        this.folk.setThinkAt(i, this.tick + 30);
                        return;
                    }
                    // A point inside the block, different for each person, so a hundred woodcutters
                    // fan out across the wood instead of queueing at one corner of it. It has to be
                    // ground you can stand on: aiming at whatever the jitter lands on sent one walk
                    // in six into a lake or a cliff face, to be abandoned thirty seconds later --
                    // `stuck` went from two in a hundred journeys to seventeen.
                    mutable int wx = this.cworkX[at] * 16 + 8;
                    mutable int wy = this.cworkY[at] * 16 + 8;
                    mutable int tries = 0;
                    while (tries < 4) {
                        int jx = cast<int>(LandMath.hash01(this.seed ^ 0x11B3, i * 5 + tries, this.tick) * 16.0);
                        int jy = cast<int>(LandMath.hash01(this.seed ^ 0x274D, i * 5 + tries, this.tick) * 16.0);
                        int tx = this.cworkX[at] * 16 + jx;
                        int ty = this.cworkY[at] * 16 + jy;
                        if (this.walkable(tx, ty)) {
                            wx = tx;
                            wy = ty;
                            tries = 4;
                        } else {
                            tries = tries + 1;
                        }
                    }
                    float ax = cast<float>(wx) - this.folk.xAt(i);
                    float ay = cast<float>(wy) - this.folk.yAt(i);
                    if (ax * ax + ay * ay < 4.0) {
                        // Inside the block, six cells searched, and nothing. The block still counts
                        // work, so it is further in than the search reached: wait a moment and aim
                        // at a different point rather than re-deciding on every tick.
                        this.noWork = this.noWork + 1;
                        this.folk.setThinkAt(i, this.tick + 3);
                        return;
                    }
                    this.folk.setTarget(i, wx, wy);
                    this.folk.setAct(i, cast<int>(Act.WalkTo));
                    return;
                }
                this.folk.setTargetNode(i, found);
                this.folk.setTarget(i, nf.cellXAt(found), nf.cellYAt(found));
                this.folk.setAct(i, cast<int>(Act.WalkTo));
                return;
            }

            public method livingCount() returns int {
                return this.folk.count();
            }

            public method bornCount() returns long {
                return this.births;
            }

            public method step(float dt) returns void {
                this.frames = this.frames + 1;
                this.clock = this.clock + dt;
                this.tick = cast<int>(this.clock);
                this.meter.begin();
                if (this.clock >= this.censusDue) {
                    this.census();
                    this.censusDue = this.clock + 1.0;
                    this.meter.lap(cast<int>(Phase.Census));
                }
                this.g.surface().regrow(dt);
                this.meter.lap(cast<int>(Phase.Regrow));
                this.wild.step(dt);
                this.meter.lap(cast<int>(Phase.Beasts));
                this.wild.prowl(dt);
                this.meter.lap(cast<int>(Phase.Prowl));
                this.live(dt);
                this.meter.lap(cast<int>(Phase.Living));
                this.think();
                this.meter.lap(cast<int>(Phase.Thinking));
                this.move(dt);
                this.meter.lap(cast<int>(Phase.Moving));
                this.meter.tick();
                return;
            }

            public method clockMeter() returns Meter* {
                return this.meter;
            }

            // How many people are standing where they could not possibly stand. The strongest
            // correctness check movement has: `stuck` counts those who gave up, but somebody who
            // walked THROUGH a cliff never gets stuck and never complains -- they simply end up in
            // the sea, and only a sweep finds them.
            public method offLand() returns int {
                mutable int bad = 0;
                int n = this.folk.limit();
                mutable int i = 0;
                while (i < n) {
                    if (this.folk.alive(i)) {
                        if (!this.walkable(cast<int>(this.folk.xAt(i)), cast<int>(this.folk.yAt(i)))) {
                            bad = bad + 1;
                        }
                    }
                    i = i + 1;
                }
                return bad;
            }

            public method report() returns void {
                // The worst frame is the budget by construction, so it says nothing on its own.
                // What matters is DEMAND against CAPACITY: how many decisions a second the population
                // actually wants, versus how many the budget can serve. Headroom is the real answer,
                // and a saturated worst frame at startup only means the queue absorbed the whole
                // population coming due on tick zero -- which is what it is for.
                int perFrame = cast<int>(this.thoughtTotal / cast<long>(this.frames));
                int capacity = this.budget * 60;
                int demand = this.folk.count() / 3;
                System.IO.Console.println($"sim: t={cast<int>(this.clock)}s over {this.frames} frames | arrivals {this.arrivals} | stuck {this.stuckTotal}");
                System.IO.Console.println($"  think: {perFrame}/frame average, worst {this.worstThink} (budget {this.budget}) | demand {demand}/s vs capacity {capacity}/s");
                System.IO.Console.println($"  people standing off walkable ground: {this.offLand()}");
                System.IO.Console.println($"  life: {this.folk.count()} alive | {this.births} born, {this.deathsOld} of old age, {this.deathsHunger} starved");
                // THE number of this slice. Walking is pure cost -- it produces nothing -- so the
                // share of it says whether the map is a place people can live in or a distance they
                // spend their lives crossing. Everything about how big a community is, how far a
                // trade may range and whether the economy can stay local hangs off it.
                long busy = this.walkTicks + this.workTicks;
                mutable int share = 0;
                if (busy > 0) {
                    share = cast<int>(this.walkTicks * cast<long>(1000) / busy);
                }
                System.IO.Console.println($"  travel share: {share}/1000 of busy time spent walking");
                System.IO.Console.println($"  time: {this.walkTicks} walking to work, {this.workTicks} working, {this.wanderTicks} wandering with nothing to do");
                System.IO.Console.println($"  work: {this.carried} units carried home, {this.felled} nodes worked out, {this.noWork} decisions found nothing");
                System.IO.Console.println($"  food: {this.meals} eaten, {this.hungryTicks} times somebody found the larder empty");
                // What the world actually holds. THE number of this slice: a chain in ECONOMY.md
                // section 1 that no community ever fills is a chain that does not exist, whatever
                // the code says, and one held by a single village is a chain the world cannot rely
                // on. Reading it per good is the only way to tell those apart.
                System.IO.Console.println("  stores (produced / communities holding any):");
                mutable int idle = 0;
                for (int gd in 1..Goods.count()) {
                    long made = this.stores.producedOf(gd);
                    if (made == 0) {
                        idle = idle + 1;
                        continue;
                    }
                    System.IO.Console.println($"    {Goods.name(gd)}: {made} / {this.stores.holders(gd)}");
                }
                System.IO.Console.println($"    ({idle} goods never produced at all)");
                // How the trades were shared out, counted from the living rather than from intent --
                // and by JOB, because a smith has no Harvest class and counting by that one read
                // every craftsman in the world as idle.
                mutable int[] byTrade = new int[Job.count()]();
                int n = this.folk.limit();
                mutable int k = 0;
                while (k < n) {
                    if (this.folk.alive(k) && this.folk.isAdult(k)) {
                        int jb = this.folk.jobOf(k);
                        byTrade[jb] = byTrade[jb] + 1;
                    }
                    k = k + 1;
                }
                System.IO.Console.println($"  out of doors: wood {byTrade[cast<int>(Job.Woodcutter)]} | forage {byTrade[cast<int>(Job.Forager)]} | quarry {byTrade[cast<int>(Job.Quarrier)]} | mine {byTrade[cast<int>(Job.Miner)]} | fish {byTrade[cast<int>(Job.Fisher)]} | hunt {byTrade[cast<int>(Job.Hunter)]}");
                System.IO.Console.println($"  indoors: sawyer {byTrade[cast<int>(Job.Sawyer)]} | smith {byTrade[cast<int>(Job.Smith)]} | baker {byTrade[cast<int>(Job.Baker)]} | weaver {byTrade[cast<int>(Job.Weaver)]} | builder {byTrade[cast<int>(Job.Builder)]} | idle {byTrade[cast<int>(Job.Idle)]}");
                delete byTrade;
                // What the villages built, and whether the workshops in them ever run. A building
                // that stands and never makes anything is a chain that does not exist.
                System.IO.Console.println($"  built: {this.town.working()} standing of {this.town.count()} marked out | {this.crafted} batches made, {this.stalled} could not start");
                mutable String line = "  workshops:";
                for (int bk in 1..BuildingKind.count()) {
                    int cnt = this.town.countOfKind(bk);
                    if (cnt > 0) {
                        line = line + $" {Builds.name(bk)}={cnt}";
                    }
                }
                System.IO.Console.println(line);
                // What is left standing, against what the world started with. A resource that only
                // goes down is being liquidated, and this is where that shows.
                NodeField* nf = this.g.surface();
                System.IO.Console.println($"  left standing: timber {nf.totalOf(1)} | forage {nf.totalOf(2)} | quarry {nf.totalOf(3)} | ore {nf.totalOf(4)} | fishing {nf.totalOf(5)}");
                System.IO.Console.println($"  hunt: {this.hunted} animals brought down by people");
                // Who is listened to, and whether being listened to means anything. A world where
                // everybody follows has no temperament in it; one where nobody does has a leadership
                // that exists only in this line.
                mutable int seated = 0;
                for (int c in 0..this.ncomm) {
                    if (this.chief[c] >= 0) {
                        seated = seated + 1;
                    }
                }
                long said = this.followed + this.resisted;
                mutable int heed = 0;
                if (said > 0) {
                    heed = cast<int>(this.followed * cast<long>(1000) / said);
                }
                System.IO.Console.println($"  chiefs: {seated} seated | {this.risen} rose, {this.passed} handed on | {heed}/1000 of those spoken to went along ({this.followed} of {said})");
                this.wild.report();
                this.meter.report("clock");
                return;
            }
        }
    }
}
