import System.IO.Console;

// Every resource node in the world, as INSTANCES with real positions -- not one slot per tile.
//
// The tile was the wrong unit. A tile either held a tree or it did not, so a wood came out as a
// lattice with one trunk per square and a fixed jitter, which is exactly what it looked like from
// the ground. Nature does not space plants by the grid; it spaces them by DISTANCE, and the distance
// closes up in a forest and opens out on a steppe. So a node carries a fractional position and a
// tile carries however many happen to fall in it -- three in a thicket, none in the clearing beside
// it.
//
// Storage is a flat structure-of-arrays sorted by cell, with one index per ROW. That is all the
// renderer needs, because it bakes its window row by row and can walk each row's instances in step
// with its own x loop; and a random per-tile question is a binary search inside one row rather than
// an eleven-megabyte index nobody else would ever read.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class NodeField {
            private mutable int w;
            private mutable int h;
            private mutable int n;
            private mutable int cap;
            private mutable float[] px;      // position in CELL units, fractional
            private mutable float[] py;
            private mutable byte[] kind;
            // What stood here before it was cleared. A felled tree sets `kind` to 0 and this keeps
            // the species, so the forest can come back as the forest it was rather than as whatever
            // the regrowth pass felt like planting. One byte per node -- 360 KB for the whole world.
            private mutable byte[] born;
            // A working face the world was born with and nobody has opened. Not the same as empty:
            // an empty node may be a seam that was worked out, and refilling one of those on the
            // next prospecting trip would make ore infinite. One bit's worth of fact, one byte.
            private mutable byte[] blind;
            private mutable short[] qty;
            private mutable int[] rowStart;  // h + 1 entries, valid once sorted
            // First instance standing on each cell, or -1. Eleven megabytes, and the header above
            // used to argue against paying them because only the renderer read this field and the
            // renderer walks rows. Agents changed that: a woodcutter asks "is there a tree on this
            // cell" thousands of times a second, and a row walk to answer it is the difference
            // between a lookup and a scan. Memory has been free in this project every time it has
            // been weighed against time, and this is no exception.
            private mutable int[] cellFirst;
            private mutable boolean ordered;
            // Live nodes per BLOCK of 16x16 cells, one plane per Harvest class -- a coarse map of
            // where the woods, the berries, the stone, the veins and the fishing are. Two hundred
            // and eighty-eight kilobytes for the whole world, at 16x16 blocks.
            //
            // A single node is the wrong thing to know about: tell a community where one tree is and
            // everybody walks to that tree, the first one there takes it and the rest arrive at a
            // stump. A block is where the WORK is, and people spread out inside it on their own. It
            // is kept live by `harvest`, so it never lies.
            private mutable int[] blockHave;
            // And the same map one notch finer: live nodes per block per GOOD.
            //
            // The class map answers "is there quarrying here", which turned out to be the wrong
            // question. A quarry class covers stone, marble, clay, sand and salt, so a village that
            // needed clay was sent to whichever face of the five was nearest -- three times out of
            // four a stone quarry -- and clay, sand and salt were never brought home anywhere in the
            // world. Two and a half megabytes buys the question the villagers were actually asking.
            private mutable int[] blockGood;
            // The sixteen-cell lattice the counts above are kept on -- the same geometry the Grid
            // labels its landmasses on, asked of the one class that owns it.
            private mutable BlockGrid* blocks;
            private mutable int bplane;        // blocks.count(), the stride between Harvest classes
            private mutable int renewAt;       // where the regrowth sweep resumes
            private mutable float renewDebt;   // nodes owed a top-up, carried between frames
            private mutable int renewSweeps;   // full passes completed: the clock a felled tree waits on

            public constructor NodeField(int w, int h) {
                this.w = w;
                this.h = h;
                this.n = 0;
                this.cap = 1024;
                this.px = new float[this.cap]();
                this.py = new float[this.cap]();
                this.kind = new byte[this.cap]();
                this.born = new byte[this.cap]();   // filled by finish(), once the sort has settled
                this.blind = new byte[this.cap]();
                this.qty = new short[this.cap]();
                this.rowStart = new int[h + 1]();
                this.cellFirst = new int[1]();
                this.ordered = false;
                this.blocks = new BlockGrid(w, h) on heap;
                this.bplane = this.blocks.count();
                this.blockHave = new int[this.bplane * Harvest.count()]();
                this.blockGood = new int[this.bplane * Goods.count()]();
                this.renewAt = 0;
                this.renewDebt = 0.0;
                this.renewSweeps = 0;
            }

            public destructor ~NodeField() returns void {
                delete this.px;
                delete this.py;
                delete this.kind;
                delete this.born;
                delete this.blind;
                delete this.qty;
                delete this.rowStart;
                delete this.cellFirst;
                delete this.blockHave;
                delete this.blockGood;
                delete this.blocks;
            }

            public method size() returns int {
                return this.n;
            }

            // ALL SIX ARRAYS, and the two that used to be left behind are why this wants a
            // comment. `born` and `blind` are filled by `finish()`, so while a world is being
            // generated -- every add before the one finish -- nothing reads them, and growing
            // without them looked harmless. It was only harmless in that order: finish
            // reallocates both at the current capacity, which quietly repaired the gap every
            // time.
            //
            // Append ANYTHING after finish -- regrowth seeding a node, a slice adding one -- and
            // the two are shorter than the field is long, so every read past the old capacity is
            // a wrong answer about what stood there and whether a seam was ever opened. Six
            // arrays are one field; they grow together.
            private method grow() returns void {
                int nc = this.cap * 2;
                float[] nx = new float[nc]();
                float[] ny = new float[nc]();
                byte[] nk = new byte[nc]();
                short[] nq = new short[nc]();
                byte[] nbo = new byte[nc]();
                byte[] nbl = new byte[nc]();
                mutable int i = 0;
                while (i < this.n) {
                    nx[i] = this.px[i];
                    ny[i] = this.py[i];
                    nk[i] = this.kind[i];
                    nq[i] = this.qty[i];
                    nbo[i] = this.born[i];
                    nbl[i] = this.blind[i];
                    i = i + 1;
                }
                delete this.px;
                delete this.py;
                delete this.kind;
                delete this.qty;
                delete this.born;
                delete this.blind;
                this.px = nx;
                this.py = ny;
                this.kind = nk;
                this.qty = nq;
                this.born = nbo;
                this.blind = nbl;
                this.cap = nc;
                return;
            }

            public method add(float fx, float fy, int k, int q) returns void
                requires k > 0
                requires k < Nodes.count()
                requires q >= 0
                requires q <= 32767
            {
                if (fx < 0.0 || fy < 0.0) {
                    return;
                }
                if (fx >= cast<float>(this.w) || fy >= cast<float>(this.h)) {
                    return;
                }
                if (this.n >= this.cap) {
                    this.grow();
                }
                this.px[this.n] = fx;
                this.py[this.n] = fy;
                this.kind[this.n] = cast<byte>(k);
                this.qty[this.n] = cast<short>(q);
                this.n = this.n + 1;
                this.ordered = false;
                return;
            }

            // Sort into cell order (row-major, then x within the row) with a counting sort, and
            // build the per-row index. Passes append in whatever order suits them; this is called
            // once when they are all done.
            //
            // SIX PASSES, IN THIS ORDER, AND THE ORDER IS THE ALGORITHM. `start` is one array
            // wearing three hats in turn -- bucket sizes, then bucket beginnings, then a moving
            // cursor the permute walks to the bucket ENDS -- and each pass below is named for the
            // hat it is wearing. The row index has to be read while the second hat is on, and the
            // cell index while the third is, which is why they are not adjacent. Reordering these
            // does not produce a slower world; it produces a different one.
            public method finish() returns void {
                int nc = this.w * this.h;
                int[] start = new int[nc + 1]();
                this.countPerCell(start);
                this.runningTotals(start, nc);
                this.readRowIndex(start, nc);
                this.permuteIntoCellOrder(start);
                this.seedRegrowthMemory();
                this.readCellIndex(start, nc);
                delete start;
                this.recountBlocks();
                this.sealBlindSeams();
                this.ordered = true;
                return;
            }

            // Pass one: how many instances stand on each cell, written one slot to the right so
            // the running totals below turn counts into beginnings without a second array.
            private method countPerCell(int[] start) returns void {
                mutable int i = 0;
                while (i < this.n) {
                    int c = this.cellOf(i);
                    start[c + 1] = start[c + 1] + 1;
                    i = i + 1;
                }
                return;
            }

            // Pass two: counts become where each bucket BEGINS.
            private method runningTotals(int[] start, int nc) returns void {
                mutable int run = 0;
                mutable int c = 0;
                while (c <= nc) {
                    run = run + start[c];
                    start[c] = run;
                    c = c + 1;
                }
                return;
            }

            // Pass three: the per-row index, read off the beginnings BEFORE the permute turns them
            // into a moving cursor -- start[y*w] is the first instance of row y, and start[nc] is
            // the total, which is exactly the end of the last row.
            private method readRowIndex(int[] start, int nc) returns void {
                mutable int y = 0;
                while (y <= this.h) {
                    mutable int cell = y * this.w;
                    if (cell > nc) {
                        cell = nc;
                    }
                    this.rowStart[y] = start[cell];
                    y = y + 1;
                }
                return;
            }

            // Pass four: everything moves into cell order, and `start` is left holding the END of
            // each bucket.
            private method permuteIntoCellOrder(int[] start) returns void {
                float[] ox = new float[this.cap]();
                float[] oy = new float[this.cap]();
                byte[] ok = new byte[this.cap]();
                short[] oq = new short[this.cap]();
                mutable int i = 0;
                while (i < this.n) {
                    int c = this.cellOf(i);
                    int dst = start[c];
                    start[c] = dst + 1;
                    ox[dst] = this.px[i];
                    oy[dst] = this.py[i];
                    ok[dst] = this.kind[i];
                    oq[dst] = this.qty[i];
                    i = i + 1;
                }
                delete this.px;
                delete this.py;
                delete this.kind;
                delete this.qty;
                this.px = ox;
                this.py = oy;
                this.kind = ok;
                this.qty = oq;
                return;
            }

            // Pass five: what the world was born with, taken here because nothing has been
            // harvested yet. A felled tree clears `kind`; this remembers the species so the wood
            // that grows back is the wood that was there.
            private method seedRegrowthMemory() returns void {
                delete this.born;
                this.born = new byte[this.cap]();
                mutable int i = 0;
                while (i < this.n) {
                    this.born[i] = this.kind[i];
                    i = i + 1;
                }
                return;
            }

            // Pass six: the first instance standing on each cell. `start[c]` has been walked
            // forward to the END of bucket c by the permute, so the beginning of c is where c-1
            // ended -- and a cell nobody stands on gets -1 rather than an empty range, so a caller
            // tests one integer instead of comparing two.
            private method readCellIndex(int[] start, int nc) returns void {
                delete this.cellFirst;
                this.cellFirst = new int[nc]();
                mutable int prev = 0;
                mutable int c = 0;
                while (c < nc) {
                    if (start[c] > prev) {
                        this.cellFirst[c] = prev;
                        prev = start[c];
                    } else {
                        this.cellFirst[c] = 0 - 1;
                    }
                    c = c + 1;
                }
                return;
            }

            // The coarse work map, counted once here and maintained by `harvest` from now on.
            private method recountBlocks() returns void {
                for (int b in 0..this.bplane * Harvest.count()) {
                    this.blockHave[b] = 0;
                }
                for (int bg in 0..this.bplane * Goods.count()) {
                    this.blockGood[bg] = 0;
                }
                for (int j in 0..this.n) {
                    int k = cast<int>(this.kind[j]) & 255;
                    if (k != 0 && cast<int>(this.qty[j]) > 0) {
                        this.creditBlock(j, k);
                    }
                }
                return;
            }

            // Seal the blind seams.
            //
            // A working face the world was born with carries nothing, and until it is opened it
            // has to be INDISTINGUISHABLE FROM BARE GROUND -- not merely empty. Leaving the kind
            // set with a quantity of zero looked equivalent and was not: every scan in the
            // codebase asks "is there ore here" by reading the kind, so a hundred and fourteen
            // seams read as ore that could not be worked, the resource audit reported 193 of 198
            // bodies reachable where 146 were, and the test that says a worked-out seam stays
            // worked out went red. The file already has a convention for this and it is the
            // right one: a spent seam clears its kind and `born` remembers what it was.
            private method sealBlindSeams() returns void {
                delete this.blind;
                this.blind = new byte[this.cap]();
                mutable int i = 0;
                while (i < this.n) {
                    int k = cast<int>(this.kind[i]) & 255;
                    if (k != 0 && cast<int>(this.qty[i]) == 0) {
                        int hc = Nodes.work(k);
                        if (hc == cast<int>(Harvest.Mine) || hc == cast<int>(Harvest.Quarry)) {
                            this.blind[i] = cast<byte>(1);
                            this.kind[i] = cast<byte>(0);
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            // WHAT IS GOING ON AT ONE SLOT, as a word rather than a pair of sentinel comparisons.
            // Sealed is asked first because a sealed seam also carries a kind of zero: the two
            // states that look alike from the kind alone are exactly the two this exists to
            // separate. The bytes underneath are untouched -- this is how to ask, not how it is
            // kept.
            public method stateAt(int i) returns NodeState {
                if (cast<int>(this.blind[i]) != 0) {
                    return NodeState.Sealed;
                }
                if ((cast<int>(this.kind[i]) & 255) != 0) {
                    return NodeState.Live;
                }
                return NodeState.Cleared;
            }

            // ONE NODE'S CONTRIBUTION TO THE TWO COARSE MAPS, added and taken away.
            //
            // The same nine lines stood in five places -- the recount at finish, a node worked to
            // nothing, a seam opened, a wood reseeded, a flow refilled -- and all five had to agree
            // about a thing that is easy to get half right: the class plane and the GOOD plane are
            // two maps, and crediting one without the other leaves the world claiming there is
            // mining here but no coal, which is a question people actually ask.
            private method creditBlock(int i, int k) returns void {
                int hc = Nodes.work(k);
                if (hc == cast<int>(Harvest.Nothing)) {
                    return;
                }
                int blk = this.blockOf(i);
                int b = hc * this.bplane + blk;
                this.blockHave[b] = this.blockHave[b] + 1;
                int gd = Nodes.gives(k);
                if (gd != Goods.NOTHING) {
                    int gb = gd * this.bplane + blk;
                    this.blockGood[gb] = this.blockGood[gb] + 1;
                }
                return;
            }

            private method debitBlock(int i, int k) returns void {
                int hc = Nodes.work(k);
                if (hc == cast<int>(Harvest.Nothing)) {
                    return;
                }
                int blk = this.blockOf(i);
                int b = hc * this.bplane + blk;
                this.blockHave[b] = this.blockHave[b] - 1;
                int gd = Nodes.gives(k);
                if (gd != Goods.NOTHING) {
                    int gb = gd * this.bplane + blk;
                    this.blockGood[gb] = this.blockGood[gb] - 1;
                }
                return;
            }

            private method blockOf(int i) returns int {
                return this.blocks.ofCellClamped(cast<int>(this.px[i]), cast<int>(this.py[i]));
            }

            public method blockCols() returns int {
                return this.blocks.cols();
            }

            public method blockRows() returns int {
                return this.blocks.rows();
            }

            // Live nodes of one Harvest class in the 16x16 block (bx, by). Zero outside the world.
            public method inBlock(int bx, int by, int hclass) returns int {
                if (!this.blocks.holds(bx, by)) {
                    return 0;
                }
                return this.blockHave[hclass * this.bplane + this.blocks.at(bx, by)];
            }

            // Live nodes yielding one particular GOOD in the block. Same map, asked the way the
            // people asking it actually think: not "is there mining here" but "is there COAL here".
            public method inBlockGood(int bx, int by, int good) returns int {
                if (!this.blocks.holds(bx, by)) {
                    return 0;
                }
                return this.blockGood[good * this.bplane + this.blocks.at(bx, by)];
            }

            // Whole-world stock of one good still standing in the ground.
            public method totalOfGood(int good) returns int {
                mutable int t = 0;
                for (int b in 0..this.bplane) {
                    t = t + this.blockGood[good * this.bplane + b];
                }
                return t;
            }

            // Whole-world stock of one Harvest class, which is what says whether a resource is being
            // liquidated or living within its means.
            public method totalOf(int hclass) returns int {
                mutable int t = 0;
                for (int b in 0..this.bplane) {
                    t = t + this.blockHave[hclass * this.bplane + b];
                }
                return t;
            }

            private method cellOf(int i) returns int {
                mutable int cx = cast<int>(this.px[i]);
                mutable int cy = cast<int>(this.py[i]);
                if (cx < 0) {
                    cx = 0;
                }
                if (cx >= this.w) {
                    cx = this.w - 1;
                }
                if (cy < 0) {
                    cy = 0;
                }
                if (cy >= this.h) {
                    cy = this.h - 1;
                }
                return cy * this.w + cx;
            }

            public method xAt(int i) returns float {
                return this.px[i];
            }

            public method yAt(int i) returns float {
                return this.py[i];
            }

            public method kindAt(int i) returns int {
                return cast<int>(this.kind[i]) & 255;
            }

            public method qtyAt(int i) returns int {
                return cast<int>(this.qty[i]);
            }

            public method cellXAt(int i) returns int {
                return cast<int>(this.px[i]);
            }

            public method cellYAt(int i) returns int {
                return cast<int>(this.py[i]);
            }

            // Instances of row y are [rowFirst(y), rowEnd(y)), in ascending x.
            public method rowFirst(int y) returns int {
                if (y < 0) {
                    return 0;
                }
                if (y > this.h) {
                    return this.n;
                }
                return this.rowStart[y];
            }

            public method rowEnd(int y) returns int {
                return this.rowFirst(y + 1);
            }

            // The first thing standing on this cell, or -1. One array read.
            public method firstAt(int x, int y) returns int {
                if (x < 0 || y < 0 || x >= this.w || y >= this.h) {
                    return 0 - 1;
                }
                return this.cellFirst[y * this.w + x];
            }

            // A live node giving THIS GOOD, standing on the cell, or -1.
            //
            // A harvest class is not a good: the quarry covers stone, marble, clay, sand and salt,
            // and a town short of stone that asks for "quarry work" is answered with sand. Asking
            // by good is what lets the town want several different things at once and get them.
            public method goodAt(int x, int y, int good) returns int {
                mutable int i = this.firstAt(x, y);
                if (i < 0) {
                    return 0 - 1;
                }
                int c = y * this.w + x;
                while (i < this.n && this.cellOf(i) == c) {
                    int k = cast<int>(this.kind[i]) & 255;
                    if (k != 0 && Nodes.gives(k) == good && cast<int>(this.qty[i]) > 0) {
                        return i;
                    }
                    i = i + 1;
                }
                return 0 - 1;
            }

            // A live node this trade can work, standing on the cell, or -1. Instances of one cell are
            // contiguous, so this walks the two or three that share it and no further.
            public method nodeAt(int x, int y, int hclass) returns int {
                mutable int i = this.firstAt(x, y);
                if (i < 0) {
                    return 0 - 1;
                }
                int c = y * this.w + x;
                while (i < this.n && this.cellOf(i) == c) {
                    int k = cast<int>(this.kind[i]) & 255;
                    if (k != 0 && Nodes.work(k) == hclass && cast<int>(this.qty[i]) > 0) {
                        return i;
                    }
                    i = i + 1;
                }
                return 0 - 1;
            }

            // Take up to `amount` from one instance, and empty it when it runs out. This is what
            // makes a quantity mean anything -- a resource that never runs out is decoration with a
            // better name, and every chain in ECONOMY.md is written as though nodes are finite.
            public method harvest(int i, int amount) returns int
                requires amount >= 0
            {
                mutable int have = cast<int>(this.qty[i]);
                if (have <= 0 || cast<int>(this.kind[i]) == 0) {
                    return 0;
                }
                mutable int take = amount;
                if (take > have) {
                    take = have;
                }
                have = have - take;
                this.qty[i] = cast<short>(have);
                if (have == 0) {
                    int k = cast<int>(this.kind[i]) & 255;
                    int hc = Nodes.work(k);
                    this.debitBlock(i, k);
                    // A picked bush is not a destroyed bush. Forage and fishing are FLOWS -- the
                    // berries come back, the shoal swims back -- so the node stays where it is with
                    // nothing on it and `regrow` fills it again.
                    //
                    // A felled tree and a worked-out seam both clear the kind, but they are not the
                    // same kind of gone: ore does not come back on any timescale a person lives
                    // through, and a forest does. `born` remembers what stood here so `regrow` can
                    // put the wood back where there is still wood nearby to seed it.
                    if (!cast<Harvest>(hc).renews()) {
                        this.kind[i] = cast<byte>(0);
                    }
                }
                return take;
            }

            // Open a seam that was standing here all along with nothing in it.
            //
            // A blind seam is a node the world was born with, carrying zero, so it is invisible to
            // everything: `nodeAt` skips it, the block counts never included it, and nobody can
            // work it or even see that it is there. Prospecting is what puts something in it.
            //
            // Placed at world generation rather than inserted here, and that is not a shortcut --
            // the field is sorted by cell and indexed once, so a node appended at runtime would
            // land outside its own row and quietly corrupt every spatial lookup after it. A slot
            // that already exists in the right place costs nothing and cannot do that.
            //
            // Returns the kind opened, or 0 if there was nothing under this cell.
            public method openSeam(int x, int y) returns int {
                mutable int i = this.firstAt(x, y);
                if (i < 0) {
                    return 0;
                }
                int c = y * this.w + x;
                while (i < this.n && this.cellOf(i) == c) {
                    // Sealed, and only sealed. A seam that was opened and then worked out has the
                    // same empty kind as one that was never opened, and telling the two apart is
                    // the whole job of this flag -- without it, prospecting the same hill twice
                    // would refill a mine that is genuinely finished, and ore would stop being
                    // finite.
                    if (cast<int>(this.blind[i]) != 0) {
                        int k = cast<int>(this.born[i]) & 255;
                        if (k != 0) {
                            this.blind[i] = cast<byte>(0);
                            this.kind[i] = cast<byte>(k);
                            this.qty[i] = cast<short>(Nodes.baseQty(k));
                            this.creditBlock(i, k);
                            return k;
                        }
                    }
                    i = i + 1;
                }
                return 0;
            }

            // A cleared slot, considered for coming back. (Which classes renew at all is the
            // harvest's own fact now -- Harvest.renews(), and the stone-famine story that earned
            // it lives there.)
            //
            // Only timber does: ore does not return on any timescale a person lives through, and a
            // quarry is a hole in the ground. A forest does, and it comes back the way a forest does
            // -- from seed, so only where there is still wood standing to seed it. Clear-cut a whole
            // block and the trees return slowly from the blocks around it; clear-cut the region and
            // it stays cleared, which is the only version of this rule that gives felling a cost.
            //
            // Deterministic, not random: the same arc replays the same way, which is what makes the
            // simulation testable at all. `renewSweeps` advances once per full pass, so a given slot
            // comes up for regrowth every REGROW_SWEEPS passes and the world does not come back all
            // at once.
            private method reseed(int i) returns void {
                int was = cast<int>(this.born[i]) & 255;
                if (was == 0) {
                    return;
                }
                int hc = Nodes.work(was);
                if (hc != cast<int>(Harvest.Timber)) {
                    return;
                }
                int b = this.blockOf(i);
                int plane = hc * this.bplane;
                int here = this.blockHave[plane + b];
                mutable int pace = NodeField.REGROW_SWEEPS;
                if (here == 0) {
                    // No seed source in this block: the wood has to walk in from a neighbour, which
                    // takes four times as long.
                    if (this.neighbourWood(b, plane) == 0) {
                        // Nothing standing anywhere near. The land still remembers it was forest --
                        // `born` says so -- and given long enough it becomes forest again, because a
                        // world where the last tree ends the possibility of trees is a trap rather
                        // than a consequence. Thirty-two times the base pace is about fourteen
                        // lifetimes: felling everything is not free, and it is not final either.
                        pace = NodeField.REGROW_SWEEPS * 32;
                    } else {
                        pace = NodeField.REGROW_SWEEPS * 4;
                    }
                }
                if ((this.renewSweeps + i) % pace != 0) {
                    return;
                }
                this.kind[i] = cast<byte>(was);
                this.qty[i] = cast<short>(Nodes.baseQty(was));
                this.creditBlock(i, was);
                return;
            }

            // Living timber in the four blocks around this one. Four reads, and only ever asked
            // about a slot that is already known to be bare.
            private method neighbourWood(int b, int plane) returns int {
                int bx = this.blocks.colOf(b);
                int by = this.blocks.rowOf(b);
                int stride = this.blocks.cols();
                mutable int total = 0;
                if (bx > 0) {
                    total = total + this.blockHave[plane + b - 1];
                }
                if (bx < stride - 1) {
                    total = total + this.blockHave[plane + b + 1];
                }
                if (by > 0) {
                    total = total + this.blockHave[plane + b - stride];
                }
                if (by < this.blocks.rows() - 1) {
                    total = total + this.blockHave[plane + b + stride];
                }
                return total;
            }

            // How many full sweeps a felled tree waits before it may come back. At a 20 s sweep that
            // is 160 s with wood still standing in the block, and 640 s -- most of two lifetimes --
            // when the block was cleared out and the seed has to arrive from next door.
            public static fixed int REGROW_SWEEPS = 8;

            // Sweep every node once per this many seconds, topping the renewable ones up. Sliced by
            // time rather than done all at once for the same reason the terrain bake is: constant
            // cost per frame, more frames when there is more to do.
            public static fixed float RENEW_SWEEP = 20.0;

            public method regrow(float dt) returns void {
                if (this.n == 0) {
                    return;
                }
                float share = cast<float>(this.n) * dt / NodeField.RENEW_SWEEP;
                this.renewDebt = this.renewDebt + share;
                mutable int todo = cast<int>(this.renewDebt);
                if (todo <= 0) {
                    return;
                }
                this.renewDebt = this.renewDebt - cast<float>(todo);
                if (todo > this.n) {
                    todo = this.n;
                }
                mutable int done = 0;
                while (done < todo) {
                    int i = this.renewAt;
                    this.renewAt = this.renewAt + 1;
                    if (this.renewAt >= this.n) {
                        this.renewAt = 0;
                        this.renewSweeps = this.renewSweeps + 1;
                    }
                    done = done + 1;
                    int k = cast<int>(this.kind[i]) & 255;
                    if (k == 0) {
                        this.reseed(i);
                        continue;
                    }
                    int hc = Nodes.work(k);
                    if (!cast<Harvest>(hc).renews()) {
                        continue;
                    }
                    int full = Nodes.baseQty(k);
                    mutable int have = cast<int>(this.qty[i]);
                    if (have >= full) {
                        continue;
                    }
                    // A fishing ground refills far faster than a berry patch, because what is being
                    // taken is a flow of fish and not the plant itself.
                    mutable int refill = full / 12;
                    if (refill < 1) {
                        refill = 1;
                    }
                    mutable int now = have + refill;
                    if (now > full) {
                        now = full;
                    }
                    this.qty[i] = cast<short>(now);
                    if (have == 0 && now > 0) {
                        this.creditBlock(i, k);
                    }
                }
                return;
            }

            // Per-cell counts, so a consumer that asks "how many trees are around here" thousands of
            // times reads an array instead of searching this one. Counts saturate at 255.
            public method cellCounts(byte[] out, boolean treesOnly) returns void {
                int nc = this.w * this.h;
                for (int i in 0..nc) {
                    out[i] = cast<byte>(0);
                }
                for (int i in 0..this.n) {
                    int k = cast<int>(this.kind[i]) & 255;
                    if (k == 0) {
                        continue;
                    }
                    if (treesOnly && !Nodes.isTree(k)) {
                        continue;
                    }
                    int c = this.cellOf(i);
                    int had = cast<int>(out[c]) & 255;
                    if (had < 255) {
                        out[c] = cast<byte>(had + 1);
                    }
                }
                return;
            }
        }
    }
}
