program AgentsExe;

// WHICH KIND OF RESOURCE NODE -- an oak, a coal seam, a fishing spot -- as the dense global index
// the world's per-cell arrays store and the engine's columns are read by.
//
// THE OTHER HALF OF `GoodId`. The two spaces have the same shape: a "Nothing" at zero, then four
// family enums laid end to end, both about seventy entries wide. One method stands between them and
// used to take and answer the same type:
//
//     Nodes.gives(nodeOrd) -> goodOrd
//
// Handing that a good index reads a real node kind and answers what that node yields, which is a
// real good. Nothing fails, nothing is out of range, and a berry bush turns into iron ore.
//
// NOT `EconomyNodes`, which is the catalog VALUE -- a thing with a class, an atlas entry and a
// trade. This is where that value lives in an array: one byte per cell in the node field, one row
// per kind in every column the engine derives.
public bundle Agents {
    public namespace World {

        public newtype NodeId = int;
    }
}
