import System.IO.Console;
program AgentsExe;

// Why a generated world was turned down, and the ORDER is the answer.
//
// Generation is a search, and the audit returns the FIRST criterion that fails rather than a list,
// so the order these are declared in is the order a world is judged: the shape of the land before
// what is buried in it, because a world with fused continents is not worth asking about its ore.
//
// `None` is first so that zero means accepted -- the value a caller gets when nothing failed is the
// one that reads as "no reason".
public bundle Agents {
    public namespace World {

        public enum RejectReason {
            None, TooFewLandmasses, FusedContinents, DominantMass, SizeSpread,
            IslandCount, MountainShare, MountainLinearity, FlatLandContract,
            // resources
            MissingResource, BarrenContinent, ForestDust, ForestCover, OreUnreachable
        }
    }
}
