import System.IO.Console;
program AgentsExe;

// The four ages a people can live in, under the names the design documents always used for
// them. The ordinals are the catalogue's era numbers: a kind buildable "from era 2" has been
// medieval in every ledger and every essay, and now the code says so in the same words.
//
// The rule from docs/BUILDING_CATALOG.md rides with the number: unlocking an age only WIDENS
// the menu. Nothing is retired, a smithy keeps smelting long after a steel mill exists, and a
// village that never grows goes on drinking from the well it dug in the first age. An era on
// a row is a floor and never a window.
public bundle Agents {
    public namespace World {

        public enum Era {
            NoEra,
            Ancient,         // era I   -- shelter, gathering, and the crafts that need no metal
            Medieval,        // era II  -- the catalogue's default; most of it is a medieval town
            Industrial,      // era III -- coal, steel and the machine
            Modern           // era IV  -- the atom, the chip and the tower
        }
    }
}
