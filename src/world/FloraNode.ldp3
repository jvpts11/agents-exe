import System.IO.Console;
import Agents.World.EconomyNodes;
import Agents.World.NodeClass;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// The surface biology -- ECONOMY.md section 1's living nodes, never buried whatever they yield.
// index() is 9 + the local ordinal (the family begins where PropNode ends).
public bundle Agents {
    public namespace World {

        public enum FloraNode extends EconomyNodes {
            OakTree(130, ExtractedGood.Wood.index(), Harvest.Timber),
            PineTree(120, ExtractedGood.Wood.index(), Harvest.Timber),
            BirchTree(105, ExtractedGood.Wood.index(), Harvest.Timber),
            BerryBush(40, ExtractedGood.Berries.index(), Harvest.Forage),
            MushroomPatch(30, ExtractedGood.Mushrooms.index(), Harvest.Forage),
            HerbPlant(25, ExtractedGood.Herbs.index(), Harvest.Forage),
            WheatField(60, ExtractedGood.Grain.index(), Harvest.Forage),
            WildVine(45, ExtractedGood.Grapes.index(), Harvest.Forage),
            CottonPlant(50, ExtractedGood.Cotton.index(), Harvest.Forage),
            FlaxPlant(50, ExtractedGood.Flax.index(), Harvest.Forage),
            Reeds(60, ExtractedGood.Reeds.index(), Harvest.Forage),
            FishingSpot(900, ExtractedGood.Fish.index(), Harvest.Fishing),
            Cactus(35, ExtractedGood.Vegetables.index(), Harvest.Forage);

            private int qty;
            private int yieldIndex;
            private Harvest labour;

            public constructor FloraNode(int qty, int yieldIndex, Harvest labour) {
                this.qty = qty;
                this.yieldIndex = yieldIndex;
                this.labour = labour;
            }

            public method kind() returns NodeClass {
                return NodeClass.Biological;
            }

            public method atlas() returns NodeAtlas {
                return NodeAtlas.Nodes;
            }

            public method buryable() returns boolean {
                return false;
            }

            public method baseQty() returns int {
                return this.qty;
            }

            public method gives() returns int {
                return this.yieldIndex;
            }

            public method work() returns Harvest {
                return this.labour;
            }

            public method index() returns int {
                demand 9 == 1 + PropNode.count()
                    otherwise "the flora begins where the props end";
                return 9 + cast<int>(this);
            }
        }
    }
}
