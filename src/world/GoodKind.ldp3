import System.IO.Console;
program AgentsExe;

// The category axis of the goods (relayout design section 4a): what STAGE of the economy a good
// belongs to. The category is a fact of the FAMILY -- each family enum answers kind() in one
// line -- never a per-good column.
public bundle Agents {
    public namespace World {

        public enum GoodKind {
            Extracted,       // straight off a node or an animal
            Processed,       // out of a building: refined materials, and what a kitchen makes
            Manufactured,    // finished things a person carries or a place keeps
            Industrial       // what the third and fourth ages run on
        }
    }
}
