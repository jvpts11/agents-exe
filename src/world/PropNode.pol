import System.IO.Console;
import Agents.World.EconomyNodes;
import Agents.World.NodeClass;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// The promoted prop meshes -- seven tree species and the boulder, art already in props.index.
// Every tree yields the same Wood: the difference between an oak and a mangrove belongs to
// where they grow and what they look like, not to a separate entry in the warehouse. The class
// is PER CONSTANT because the boulder is stone among trees (verified against the standing
// table at C2.1). index() is 1 + the local ordinal; None sits at 0, outside every family.
public bundle Agents {
    public namespace World {

        public enum PropNode extends EconomyNodes {
            Broadleaf(NodeClass.Biological, 120, ExtractedGood.Wood.index(), Harvest.Timber),
            Pine(NodeClass.Biological, 120, ExtractedGood.Wood.index(), Harvest.Timber),
            Palm(NodeClass.Biological, 90, ExtractedGood.Wood.index(), Harvest.Timber),
            Acacia(NodeClass.Biological, 80, ExtractedGood.Wood.index(), Harvest.Timber),
            SwampTree(NodeClass.Biological, 110, ExtractedGood.Wood.index(), Harvest.Timber),
            Mangrove(NodeClass.Biological, 100, ExtractedGood.Wood.index(), Harvest.Timber),
            Laurel(NodeClass.Biological, 115, ExtractedGood.Wood.index(), Harvest.Timber),
            Boulder(NodeClass.StoneEarth, 200, ExtractedGood.Stone.index(), Harvest.Quarry);

            private NodeClass klass;
            private int qty;
            private int yieldIndex;
            private Harvest labour;

            public constructor PropNode(NodeClass klass, int qty, int yieldIndex, Harvest labour) {
                this.klass = klass;
                this.qty = qty;
                this.yieldIndex = yieldIndex;
                this.labour = labour;
            }

            public method kind() returns NodeClass {
                return klass;
            }

            public method atlas() returns NodeAtlas {
                return NodeAtlas.Props;
            }

            public method buryable() returns boolean {
                return false;
            }

            public method baseQty() returns int {
                return qty;
            }

            public method gives() returns int {
                return yieldIndex;
            }

            public method work() returns Harvest {
                return labour;
            }

            public method index() returns int {
                // Index 0 is None, which belongs to no family, and the props start after it. The
                // whole set has to keep fitting the byte the Grid stores per cell.
                demand Nodes.NONE == 0 otherwise "an empty cell reads as no node at all";
                return 1 + cast<int>(this);
            }
        }
    }
}
