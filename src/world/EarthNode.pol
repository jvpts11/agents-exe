import System.IO.Console;
import Agents.World.EconomyNodes;
import Agents.World.EconomyGoods;
import Agents.World.NodeClass;
import Agents.World.NodeId;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// Stone and earth: an outcrop on the surface over a body underground -- always buryable, always
// the quarrier's work. index() is 22 + the local ordinal. GemRock is NOT here: the standing
// table classes it MetalEnergy (a miner's find), verified at C2.1.
public bundle Agents {
    public namespace World {

        public enum EarthNode extends EconomyNodes {
            StoneRock(1200, ExtractedGood.Stone),
            MarbleOutcrop(800, ExtractedGood.Marble),
            ClayPit(700, ExtractedGood.Clay),
            SandBank(1400, ExtractedGood.Sand),
            SaltDeposit(600, ExtractedGood.Salt);

            private int qty;
            private EconomyGoods yieldOf;

            public constructor EarthNode(int qty, EconomyGoods yieldOf) {
                this.qty = qty;
                this.yieldOf = yieldOf;
            }

            public method kind() returns NodeClass {
                return NodeClass.StoneEarth;
            }

            public method atlas() returns NodeAtlas {
                return NodeAtlas.Nodes;
            }

            public method buryable() returns boolean {
                return true;
            }

            public method baseQty() returns int {
                return qty;
            }

            public method gives() returns EconomyGoods {
                return yieldOf;
            }

            public method work() returns Harvest {
                return Harvest.Quarry;
            }

            public method index() returns NodeId {
                demand 22 == 9 + FloraNode.count()
                    otherwise "the ground itself begins where the flora ends";
                return cast<NodeId>(22 + cast<int>(this));
            }
        }
    }
}
