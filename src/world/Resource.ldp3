import System.IO.Console;

// What a cell can hold: the world's resource nodes. The set is not a free list -- docs/ECONOMY.md
// section 1 is a contract between the world and the economy, and every node named there has a raw
// resource, a harvesting building and an era already assigned to it. So the contract is written as a
// `catalog`: NodeKind must contain every value EconomyNodes declares, and dropping one from the
// generator is a COMPILE error rather than a chain that silently starves at runtime.
//
// NodeKind's own constants are the ones the world adds on top of that contract: `None` (the empty
// cell) and the eight prop meshes promoted to nodes -- seven more tree species and the boulder --
// which give the forests a real species palette using art that already exists. They keep living in
// props.index, so each kind records WHICH atlas holds its mesh; the mesh file is named after the
// kind either way.
program AgentsExe;

public bundle Agents {
    public namespace World {

        // The economy's side of the contract (ECONOMY.md section 1), in that document's order.
        public catalog EconomyNodes {
            OakTree,
            PineTree,
            BirchTree,
            BerryBush,
            MushroomPatch,
            HerbPlant,
            WheatField,
            WildVine,
            CottonPlant,
            FlaxPlant,
            Reeds,
            FishingSpot,
            Cactus,
            StoneRock,
            MarbleOutcrop,
            ClayPit,
            SandBank,
            SaltDeposit,
            GemRock,
            IronVein,
            CopperVein,
            TinVein,
            GoldVein,
            SilverVein,
            CoalSeam,
            SulfurVent,
            OilSeep,
            RareEarth
        }

        // What a cell holds. Ordinal 0 is None, so an untouched grid is an empty one and the whole
        // set still fits in the byte the Grid stores per cell.
        public enum NodeKind extends EconomyNodes {
            None,
            Broadleaf,
            Pine,
            Palm,
            Acacia,
            SwampTree,
            Mangrove,
            Laurel,
            Boulder

            byCatalog {
                OakTree,
                PineTree,
                BirchTree,
                BerryBush,
                MushroomPatch,
                HerbPlant,
                WheatField,
                WildVine,
                CottonPlant,
                FlaxPlant,
                Reeds,
                FishingSpot,
                Cactus,
                StoneRock,
                MarbleOutcrop,
                ClayPit,
                SandBank,
                SaltDeposit,
                GemRock,
                IronVein,
                CopperVein,
                TinVein,
                GoldVein,
                SilverVein,
                CoalSeam,
                SulfurVent,
                OilSeep,
                RareEarth
            }
        }

        // How a node is grouped for the audit and for the prospecting rule: only the two mineral
        // classes ever have a body underground, and biology is surface-only by decision.
        public enum NodeClass {
            Biological,
            StoneEarth,
            MetalEnergy
        }

        // Who goes and gets it. This is the axis the WORK is organised along, and it is deliberately
        // not NodeClass: a boulder and an iron vein are both rock to a geologist, and a woodcutter
        // and a forager both take living things, but the man who goes out with an axe and the woman
        // who goes out with a basket are doing different jobs in different places.
        //
        // It is also the axis the world is INDEXED along. A community asks "where is there wood
        // within reach" a few times a second, and the answer comes from a coarse count per class --
        // one number per sixteen-cell block -- so the question costs a lookup instead of a sweep.
        public enum Harvest {
            Nothing,
            Timber,      // the ten tree species
            Forage,      // berries, mushrooms, herbs, wild grain, vines, fibre, reeds, cactus
            Quarry,      // loose stone, marble, clay, salt -- and the boulder
            Mine,        // the ten metal and energy veins
            Fishing      // fishing spots
        }

        // Which atlas holds a kind's mesh.
        public enum NodeAtlas {
            Nodes,
            Props
        }

        // The per-kind table, in the same parallel-array style as Biomes: filled once at class load,
        // read by ordinal. Sized from NodeKind.count() so it cannot drift from the enum.
        public class Nodes {
            private static mutable String[] NAME;
            private static mutable int[] ATLAS;
            private static mutable int[] KLASS;
            private static mutable boolean[] BURY;
            private static mutable int[] QTY;
            // What comes off it, and who goes and gets it -- the two facts that turn a thing standing
            // on the ground into a link in docs/ECONOMY.md's first chain.
            private static mutable int[] YIELD;
            private static mutable int[] WORK;

            onClassLoad {
                int n = NodeKind.count();
                Nodes.NAME = new String[n]();
                Nodes.ATLAS = new int[n]();
                Nodes.KLASS = new int[n]();
                Nodes.BURY = new boolean[n]();
                Nodes.QTY = new int[n]();
                Nodes.YIELD = new int[n]();
                Nodes.WORK = new int[n]();
                mutable int i = 0;
                while (i < n) {
                    Nodes.NAME[i] = "None";
                    Nodes.YIELD[i] = cast<int>(Good.Nothing);
                    Nodes.WORK[i] = cast<int>(Harvest.Nothing);
                    i = i + 1;
                }
                int nodes = cast<int>(NodeAtlas.Nodes);
                int props = cast<int>(NodeAtlas.Props);
                int bio = cast<int>(NodeClass.Biological);
                int rock = cast<int>(NodeClass.StoneEarth);
                int ore = cast<int>(NodeClass.MetalEnergy);

                int timber = cast<int>(Harvest.Timber);
                int forage = cast<int>(Harvest.Forage);
                int quarry = cast<int>(Harvest.Quarry);
                int mine = cast<int>(Harvest.Mine);
                int fishing = cast<int>(Harvest.Fishing);

                // kind, mesh atlas, class, has a buried body, units in an average node, what it
                // yields, who harvests it
                Nodes.put(cast<int>(NodeKind.None), "None", nodes, bio, false, 0,
                          cast<int>(Good.Nothing), cast<int>(Harvest.Nothing));

                // The promoted prop meshes: seven tree species and the boulder, art already in
                // props.index. Every species yields the same Wood -- the difference between an oak
                // and a mangrove belongs to where they grow and what they look like, not to a
                // separate entry in the warehouse.
                Nodes.put(cast<int>(NodeKind.Broadleaf), "Broadleaf", props, bio, false, 120,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.Pine), "Pine", props, bio, false, 120,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.Palm), "Palm", props, bio, false, 90,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.Acacia), "Acacia", props, bio, false, 80,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.SwampTree), "SwampTree", props, bio, false, 110,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.Mangrove), "Mangrove", props, bio, false, 100,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.Laurel), "Laurel", props, bio, false, 115,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.Boulder), "Boulder", props, rock, false, 200,
                          cast<int>(Good.Stone), quarry);

                // Surface biology: never buried, whatever its class.
                Nodes.put(cast<int>(NodeKind.OakTree), "OakTree", nodes, bio, false, 130,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.PineTree), "PineTree", nodes, bio, false, 120,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.BirchTree), "BirchTree", nodes, bio, false, 105,
                          cast<int>(Good.Wood), timber);
                Nodes.put(cast<int>(NodeKind.BerryBush), "BerryBush", nodes, bio, false, 40,
                          cast<int>(Good.Berries), forage);
                Nodes.put(cast<int>(NodeKind.MushroomPatch), "MushroomPatch", nodes, bio, false, 30,
                          cast<int>(Good.Mushrooms), forage);
                Nodes.put(cast<int>(NodeKind.HerbPlant), "HerbPlant", nodes, bio, false, 25,
                          cast<int>(Good.Herbs), forage);
                Nodes.put(cast<int>(NodeKind.WheatField), "WheatField", nodes, bio, false, 60,
                          cast<int>(Good.Grain), forage);
                Nodes.put(cast<int>(NodeKind.WildVine), "WildVine", nodes, bio, false, 45,
                          cast<int>(Good.Grapes), forage);
                Nodes.put(cast<int>(NodeKind.CottonPlant), "CottonPlant", nodes, bio, false, 50,
                          cast<int>(Good.Cotton), forage);
                Nodes.put(cast<int>(NodeKind.FlaxPlant), "FlaxPlant", nodes, bio, false, 50,
                          cast<int>(Good.Flax), forage);
                Nodes.put(cast<int>(NodeKind.Reeds), "Reeds", nodes, bio, false, 60,
                          cast<int>(Good.Reeds), forage);
                Nodes.put(cast<int>(NodeKind.FishingSpot), "FishingSpot", nodes, bio, false, 900,
                          cast<int>(Good.Fish), fishing);
                // A cactus in a desert is water and flesh, which is why anyone bothers with it.
                Nodes.put(cast<int>(NodeKind.Cactus), "Cactus", nodes, bio, false, 35,
                          cast<int>(Good.Vegetables), forage);

                // Stone and earth: an outcrop on the surface over a body underground.
                Nodes.put(cast<int>(NodeKind.StoneRock), "StoneRock", nodes, rock, true, 1200,
                          cast<int>(Good.Stone), quarry);
                Nodes.put(cast<int>(NodeKind.MarbleOutcrop), "MarbleOutcrop", nodes, rock, true, 800,
                          cast<int>(Good.Marble), quarry);
                Nodes.put(cast<int>(NodeKind.ClayPit), "ClayPit", nodes, rock, true, 700,
                          cast<int>(Good.Clay), quarry);
                // Sand. It sat in the goods catalogue with nothing anywhere in the world producing
                // it, so Glass -- the one thing made out of it -- could never be made either: two
                // dead entries that the chain test found on its own rather than anybody noticing.
                // Plentiful where it is at all, because a sand bank is not a seam.
                Nodes.put(cast<int>(NodeKind.SandBank), "SandBank", nodes, rock, true, 1400,
                          cast<int>(Good.Sand), quarry);
                Nodes.put(cast<int>(NodeKind.SaltDeposit), "SaltDeposit", nodes, rock, true, 600,
                          cast<int>(Good.Salt), quarry);

                // Metals and energy: the same, and the reason prospecting exists.
                Nodes.put(cast<int>(NodeKind.GemRock), "GemRock", nodes, ore, true, 120,
                          cast<int>(Good.Gems), mine);
                Nodes.put(cast<int>(NodeKind.IronVein), "IronVein", nodes, ore, true, 900,
                          cast<int>(Good.IronOre), mine);
                Nodes.put(cast<int>(NodeKind.CopperVein), "CopperVein", nodes, ore, true, 800,
                          cast<int>(Good.CopperOre), mine);
                Nodes.put(cast<int>(NodeKind.TinVein), "TinVein", nodes, ore, true, 500,
                          cast<int>(Good.TinOre), mine);
                Nodes.put(cast<int>(NodeKind.GoldVein), "GoldVein", nodes, ore, true, 250,
                          cast<int>(Good.GoldOre), mine);
                Nodes.put(cast<int>(NodeKind.SilverVein), "SilverVein", nodes, ore, true, 350,
                          cast<int>(Good.SilverOre), mine);
                Nodes.put(cast<int>(NodeKind.CoalSeam), "CoalSeam", nodes, ore, true, 1500,
                          cast<int>(Good.Coal), mine);
                Nodes.put(cast<int>(NodeKind.SulfurVent), "SulfurVent", nodes, ore, true, 400,
                          cast<int>(Good.Sulfur), mine);
                Nodes.put(cast<int>(NodeKind.OilSeep), "OilSeep", nodes, ore, true, 1200,
                          cast<int>(Good.Oil), mine);
                Nodes.put(cast<int>(NodeKind.RareEarth), "RareEarth", nodes, ore, true, 200,
                          cast<int>(Good.RareEarth), mine);
            }

            private static method put(int ord, String name, int atlas, int klass, boolean bury,
                                      int qty, int gives, int work) returns void {
                Nodes.NAME[ord] = name;
                Nodes.ATLAS[ord] = atlas;
                Nodes.KLASS[ord] = klass;
                Nodes.BURY[ord] = bury;
                Nodes.QTY[ord] = qty;
                Nodes.YIELD[ord] = gives;
                Nodes.WORK[ord] = work;
            }

            public static method count() returns int {
                return NodeKind.count();
            }

            // The kind's identifier, which is also the name of its .mesh file.
            public static method name(int ord) returns String {
                return Nodes.NAME[ord];
            }

            public static method atlas(int ord) returns int {
                return Nodes.ATLAS[ord];
            }

            public static method klass(int ord) returns int {
                return Nodes.KLASS[ord];
            }

            // True where a deposit of this kind can exist underground. It is a per-kind fact and not
            // a rule derived from the class: a boulder is loose stone lying on the ground, and there
            // is nothing under it to prospect for.
            public static method buryable(int ord) returns boolean {
                return Nodes.BURY[ord];
            }

            // Units an average node of this kind holds. Placement scales this by local richness --
            // the number that makes exhaustion possible at all.
            public static method baseQty(int ord) returns int {
                return Nodes.QTY[ord];
            }

            // Whether this kind is worth a projected shadow. The ground plants are not: a mushroom
            // patch casts nothing anybody can read at this scale, and its mesh is 273 triangles --
            // doubling that for a shadow spends a large part of the detail window's whole budget on
            // something invisible. Trees, boulders and outcrops stand up off the ground and keep it.
            public static method castsShadow(int ord) returns boolean {
                if (Nodes.isTree(ord)) {
                    return true;
                }
                if (ord == cast<int>(NodeKind.Boulder)) {
                    return true;
                }
                if (ord == cast<int>(NodeKind.Cactus)) {
                    return true;
                }
                if (ord == cast<int>(NodeKind.FishingSpot)) {
                    return false;               // it floats on the water
                }
                return Nodes.klass(ord) != cast<int>(NodeClass.Biological);
            }

            // What comes off a unit of it, as a Good ordinal.
            public static method gives(int ord) returns int {
                return Nodes.YIELD[ord];
            }

            // Which trade goes and gets it, as a Harvest ordinal.
            public static method work(int ord) returns int {
                return Nodes.WORK[ord];
            }

            public static method isTree(int ord) returns boolean {
                return Nodes.WORK[ord] == cast<int>(Harvest.Timber);
            }
        }
    }
}
