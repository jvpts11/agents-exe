import System.IO.Console;
import System.IO.File;
import System.Text.StringBuilder;
import System.Math.Bits;
import Agents.World.Grid;
import Agents.World.NodeField;
import Agents.World.WorldGen;
import Agents.World.Harvest;
import Agents.World.Goods;
program AgentsExe;

// The relayout's bit-identity judge (relayout design doc, section 2). Fingerprints a world through
// PUBLIC accessors only, in a FIXED documented order, so any change to what the generator produces
// -- one cell, one node, one block count -- changes the number. FNV-1a shape over 64 bits; integer
// overflow wraps by default in LDP3, which is exactly what a fingerprint wants.
public bundle Agents {
    public namespace World {

        public class WorldHash {
            // Order hashed, per world: w, h; per cell (row-major): elevation, temp, moist, biome,
            // flags, flowDx+1, flowDy+1, sub, subQty; then the surface: size; per instance:
            // kind, qty, cellX, cellY, the raw IEEE bits of px and py; then the block planes:
            // per harvest class and per good, per block (row-major), the block counts.
            public static method hashWorld(Grid* g) returns long {
                mutable long h = 0 - 3750763034362895579;   // the FNV-1a 64-bit offset basis
                h = WorldHash.mix(h, cast<long>(g.width()));
                h = WorldHash.mix(h, cast<long>(g.height()));
                for (mutable int y = 0; y < g.height(); y++) {
                    for (mutable int x = 0; x < g.width(); x++) {
                        h = WorldHash.mix(h, cast<long>(g.elevAt(x, y)));
                        h = WorldHash.mix(h, cast<long>(g.tempAt(x, y)));
                        h = WorldHash.mix(h, cast<long>(g.moistAt(x, y)));
                        h = WorldHash.mix(h, cast<long>(g.biomeAt(x, y)));
                        h = WorldHash.mix(h, cast<long>(g.flagsAt(x, y)));
                        h = WorldHash.mix(h, cast<long>(g.flowDx(x, y) + 1));
                        h = WorldHash.mix(h, cast<long>(g.flowDy(x, y) + 1));
                        h = WorldHash.mix(h, cast<long>(g.subAt(x, y)));
                        h = WorldHash.mix(h, cast<long>(g.subQtyAt(x, y)));
                    }
                }
                NodeField* f = g.surface();
                h = WorldHash.mix(h, cast<long>(f.size()));
                for (mutable int i = 0; i < f.size(); i++) {
                    h = WorldHash.mix(h, cast<long>(f.kindAt(i)));
                    h = WorldHash.mix(h, cast<long>(f.qtyAt(i)));
                    h = WorldHash.mix(h, cast<long>(f.cellXAt(i)));
                    h = WorldHash.mix(h, cast<long>(f.cellYAt(i)));
                    h = WorldHash.mix(h, WorldHash.floatBits(f.xAt(i)));
                    h = WorldHash.mix(h, WorldHash.floatBits(f.yAt(i)));
                }
                for (mutable int hc = 0; hc < Harvest.count(); hc++) {
                    for (mutable int by = 0; by < f.blockRows(); by++) {
                        for (mutable int bx = 0; bx < f.blockCols(); bx++) {
                            h = WorldHash.mix(h, cast<long>(f.inBlock(bx, by, hc)));
                        }
                    }
                }
                for (mutable int gd = 0; gd < Goods.count(); gd++) {
                    for (mutable int by = 0; by < f.blockRows(); by++) {
                        for (mutable int bx = 0; bx < f.blockCols(); bx++) {
                            h = WorldHash.mix(h, cast<long>(f.inBlockGood(bx, by, gd)));
                        }
                    }
                }
                return h;
            }

            // The 12-seed proof: prints one line per seed and writes worldhash.txt beside the
            // working directory, which tools/proof/check.ps1 diffs against goldens/worldhash.txt.
            public static method runProof() returns void {
                StringBuilder* sb = new StringBuilder() on heap;
                for (mutable int k = 0; k < 12; k++) {
                    int seed = 42 + k * 7717;
                    WorldGen gen = new WorldGen(seed) on stack;
                    gen.setWorld(0, 0.0 - 1.0);
                    Grid* g = gen.generate(2560, 1440);
                    long h = WorldHash.hashWorld(g);
                    System.IO.Console.println($"seed={seed} hash={h}");
                    sb.append($"seed={seed} hash={h}\n");
                    delete g;
                }
                File.writeAll("worldhash.txt", sb.toString());
                delete sb;
                return;
            }

            private static method mix(long h, long v) returns long {
                return (h ^ v) * 1099511628211;
            }

            // The exact bits of a float -- cast<long>(f) would round the VALUE; the fingerprint
            // wants the representation. float->double widening is exact (every f32 is a f64), so
            // the f64 bit pattern is a faithful, deterministic stand-in for the f32's.
            private static method floatBits(float f) returns long {
                return Bits.doubleToLong(cast<double>(f));
            }
        }
    }
}
