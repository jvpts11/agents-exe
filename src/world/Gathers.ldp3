import System.IO.Console;
program AgentsExe;

// Which trades fetch their own raw material, and from which harvest class. ONE array holds the
// fact; both directions (craft->harvest and harvest->craft) read it, which is what stops the two
// from drifting. The enums' own methods (Craft.gathers, Harvest.gatherer) are the typed surface.
public bundle Agents {
    public namespace World {

        public class Gathers {
            private static mutable int[] TAKES;   // Craft ordinal -> Harvest ordinal

            onClassLoad {
                Gathers.TAKES = new int[Craft.count()]();
                mutable int c = 0;
                while (c < Craft.count()) {
                    Gathers.TAKES[c] = cast<int>(Harvest.Nothing);
                    c = c + 1;
                }
                // Wood and earth: the wright fells his own timber and digs his own clay.
                Gathers.TAKES[cast<int>(Craft.Wright)] = cast<int>(Harvest.Timber);
                // Stone, gathered loose long before there is a quarry to cut it out of.
                Gathers.TAKES[cast<int>(Craft.Masonry)] = cast<int>(Harvest.Quarry);
                // Ore, likewise, from whatever is lying at the surface.
                Gathers.TAKES[cast<int>(Craft.Digging)] = cast<int>(Harvest.Mine);
                // Off the land itself -- berries, herbs, wild grain, reeds.
                Gathers.TAKES[cast<int>(Craft.Tilling)] = cast<int>(Harvest.Forage);
                // Out of the water. The smokehouse is a victualler's building.
                Gathers.TAKES[cast<int>(Craft.Victualler)] = cast<int>(Harvest.Fishing);
            }

            public static method takes(int craft) returns int {
                return Gathers.TAKES[craft];
            }

            public static method isGatherer(int craft) returns boolean {
                return Gathers.TAKES[craft] != cast<int>(Harvest.Nothing);
            }

            // The trade whose own hands bring this Harvest home. The inverse of the table above,
            // and the question the city actually asks: it is short of stone, so who does it need
            // more of? Answering it from the same array is what stops the two directions drifting.
            public static method whoTakes(int harvest) returns int {
                mutable int c = 0;
                while (c < Craft.count()) {
                    if (Gathers.TAKES[c] == harvest) {
                        return c;
                    }
                    c = c + 1;
                }
                return cast<int>(Craft.NoCraft);
            }
        }
    }
}
