import System.IO.Console;
import Agents.World.NodeId;
program AgentsExe;

// What a world can be asked about the layer UNDER its cells -- the ore bodies, the clay, the salt,
// and how much of them anybody has found. The Grid holds a `Buried` and forwards; this contract
// says which questions travel.
public bundle Agents {
    public namespace World {

        public interface Prospectable {
            // The buried kind under this cell, or NONE. What is really there, seen or not.
            method subAt(int x, int y) returns NodeId;

            method subQtyAt(int x, int y) returns int;

            method hasSub(int x, int y) returns boolean;

            method setSub(int x, int y, NodeId kind, int qty) returns void;

            // What a player may see of it: the kind once the cell is prospected, and NONE --
            // indistinguishable from bare ground -- until then.
            method knownSubAt(int x, int y) returns NodeId;

            // Reveal an area, returning how many buried cells became known.
            method prospect(int cx, int cy, int radius) returns int;
        }
    }
}
