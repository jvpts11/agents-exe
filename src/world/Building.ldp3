import System.IO.Console;

// What a community can build, and what happens inside it.
//
// docs/BUILDING_CATALOG.md holds a hundred and forty-five buildings across four eras and all of them
// are modelled and exported. What is HERE is the set the world can actually run today: the seat of
// power, and the Era I-II workshops whose recipes close a chain in docs/ECONOMY.md section 2 and 3
// out of goods this world actually produces. A Tannery needs Hide and there is no fauna yet; a
// Glassworks needs Sand and nothing places it. Those arrive with the slice that gives them inputs,
// and the report says how many meshes are still waiting so the gap is visible rather than quietly
// forgotten.
//
// The rule from the catalogue holds: unlocking an era only WIDENS the menu. Nothing is retired, and
// a Smithy keeps smelting long after a SteelMill exists.
program AgentsExe;

public bundle Agents {
    public namespace World {

        // Which mesh, and what the thing is for. The name is the identifier AND the .mesh file, so a
        // kind that cannot be drawn is caught when the atlas is bound rather than at the first frame
        // somebody looks at it.
        public enum BuildingKind {
            NoBuilding,
            TownHall,        // the seat, placed free at founding
            Sawmill,         // Wood -> Plank
            CharcoalKiln,    // Wood -> Charcoal
            Kiln,            // Clay -> Brick
            Pottery,         // Clay -> Pottery
            Glassworks,      // Sand + Charcoal -> Glass
            Weaver,          // Flax -> Cloth
            Smithy,          // IronOre + Charcoal -> IronIngot
            Forge,           // CopperOre -> CopperIngot
            Windmill,        // Grain -> Flour
            Bakery,          // Flour -> Bread
            Brewery,         // Grain -> Beer
            Smokehouse,      // Fish -> DriedMeat
            // Housing. It makes nothing and it is the only chain in the catalogue that UPGRADES IN
            // PLACE: a plot densifies under pressure rather than a second house appearing beside the
            // first, which is the exception BUILDING_CATALOG.md carved out and the reason a thriving
            // village looks different from a big one.
            Hut,             // era I
            House,           // era II
            Tenement,        // era III
            ResidentialTower,// era IV
            // ---- husbandry ----
            //
            // The one chain in the catalogue whose input is LAND rather than a good, and the reason
            // it had to exist: everything else here transforms something somebody carried home, so
            // the ceiling on how much food a world holds was whatever worldgen happened to scatter
            // on it. Foraging wild wheat cannot feed a city however many people do it. A field can,
            // because a field turns LABOUR into bread -- and that is the whole of why farming makes
            // countries possible and gathering does not.
            Farm,            // arable ground -> Grain
            Pasture,         // grazing        -> Milk
            SheepFold,       // grazing        -> Wool
            Orchard,         // arable ground  -> Fruit
            Apiary,          // grazing        -> Honey
            Henhouse,        // grazing        -> Egg
            // ---- the rest of the chains, now that their inputs exist ----
            Dairy,           // Milk -> Cheese
            Vineyard,        // Grapes -> Wine
            Tannery,         // Hide -> Leather
            PaperMill,       // Reeds -> Paper
            Preservery,      // Berries -> Preserves
            Bronzeworks,     // CopperIngot + TinOre -> BronzeIngot
            GoldSmelter,     // GoldOre -> GoldBar
            SilverSmelter,   // SilverOre -> SilverBar
            Ropewalk,        // Reeds -> Rope
            TextileMill,     // Cotton -> Cloth
            Ironworks,       // IronOre + Coal -> IronIngot, at industrial scale
            SteelMill,       // IronIngot + Coal -> Steel
            CementFactory,   // Stone + Coal -> Cement
            Cannery,         // DriedMeat + Steel -> CannedFood
            // ---- what a person carries ----
            //
            // The three that make an agent better at what it already does, rather than making a
            // good that sits on a shelf. This is where the iron chain finally arrives somewhere:
            // up to here a village could smelt all the iron in the hill and have nothing to show
            // for it but a number.
            // ---- what a town puts between itself and an army ----
            //
            // A wall makes nothing and houses nobody, and it is the only thing in the catalogue
            // that changes what happens to the town rather than what comes out of it. Before this
            // a raid and a war were the same event: somebody walked in. A wall is what makes a
            // siege a thing that takes TIME, and time is what turns a raid into a war.
            Palisade,        // era I  -- a stake fence
            Rampart,         // era II -- stone, and the reason a siege exists at all
            Keep,            // era III
            Watchtower,      // sees them coming
            Barracks,        // where soldiers are kept, and the only way a place has any
            Toolmaker,       // Wood + Stone -> Tools, the stone-age version
            Toolsmith,       // Plank + IronIngot -> Tools, twice as many for the same hour
            Weaponsmith,     // IronIngot + Plank -> Weapon
            Armory,          // IronIngot + Leather -> Armour
            // ---- learning ----
            //
            // These make nothing anybody can hold, and that is the point. A nation's era used to be
            // a side effect of having eaten well; here it is something a people BUILDS, staffs and
            // keeps up. A scriptorium eats paper and produces knowledge, so the reed beds at the
            // river turn into the university on the hill by a chain you can follow the whole way.
            Shrine,          // era I  -- the first place anybody wrote anything down
            Temple,
            Scriptorium,
            Library,
            School,
            University,
            // ---- the sea ----
            //
            // A harbour makes nothing either, and it belongs beside the wall for the same reason:
            // what it changes is what can HAPPEN to the town, not what comes out of it. A wall
            // decides who can reach you; a harbour decides who you can reach.
            //
            // It is the first thing in this catalogue that is worth building because of somewhere
            // ELSE. Every other want is a shortfall on the town's own shelves, answered by the town's
            // own hands; a port is a want answered by strangers, and it is the only way a place cut
            // off by land gets anything it cannot make.
            Harbor,          // era I -- Plank and Rope, and the far side of the water
            Shipwright,      // era I -- Plank + Rope -> Boat, and the reason rope is worth making
            // ---- water ----
            //
            // A person drinks every day of their life and this world had nothing to say about it.
            // Six meshes were cut for it and not one had a kind behind it, which made thirst the
            // largest thing in the catalogue that did not exist.
            //
            // These are shaped like the ROOF line and not like a workshop, because that is what they
            // are: a well does not make a good, it makes room for people, exactly as a hut does. A
            // town is watered or it is not, the same way it is housed or it is not, and the number
            // that matters is heads served.
            //
            // Geography decides who needs them at all. A village on a river never thinks about
            // water; a village on the steppe thinks about nothing else. That asymmetry is the whole
            // reason to have the line -- it puts a cost on ground that looked free.
            Well,            // era I  -- a hole and a bucket; a hamlet's worth
            RainCatcher,     // era I  -- for places with rain and no river
            Aqueduct,        // era II -- brings a river to a town that has none
            Fountain,        // era II -- a public source, and the first civic building
            WaterTower,      // era III
            WaterTreatment,  // era IV -- and the end of what dirty water does to people
            // ---- what looks after people ----
            //
            // Sickness is the only thing in this world that kills somebody who is doing everything
            // right, and until now it did not exist: hunger, tiredness, fear and loneliness are all
            // the body's own clocks, and there was nothing that came from OUTSIDE. Crowding and
            // dirty water are what a town does to the people in it, and these are what it can do
            // about that.
            Bathhouse,       // era II  -- the first thing anybody built against filth
            Apothecary,      // era II  -- Herbs into somebody getting better
            Hospital,        // era III
            ModernHospital,  // era IV
            // ---- what the orphaned goods are FOR ----
            //
            // Six goods came out of the ground and appeared nowhere else in this catalogue at all:
            // marble, salt, sulfur, gems, oil and rare earth. Three more -- bronze, gold and silver
            // -- appeared exactly once each, in the recipe that makes them, so nothing in the world
            // was ever made OF them. A good with a producer and no consumer is not scarce, it is
            // fictional: the want machinery cannot see it, so nobody mines it, so it never exists.
            //
            // These four close the ones that have both a mesh already cut and an age to live in.
            // Every one of them carries no other chain on its back, which is the rule three material
            // costs had to be reverted to learn. Sulfur, gems, oil and rare earth belong to the
            // third and fourth ages -- powder, jewellery, refining, electronics -- and wait for the
            // kinds that use them rather than getting a home that does not fit.
            Church,          // era II  -- gilding, and the rung between shrine and temple
            Manor,           // era II  -- a hall with silver on the table
            Lighthouse,      // era II  -- a bronze lamp and its reflector
            DryingRack,      // era II  -- salting meat, which is what salt is FOR
            Cathedral,       // era III -- marble, and the top of the ladder of learning
            // ---- the first two ages, filled in ----
            //
            // A hundred and forty-eight building meshes were cut for this game and sixty-nine of
            // them had a kind behind them. The rest were not missing features, they were features
            // that had been DRAWN and never wired: a village had one shelter and one shrine where
            // the art department gave it a tent, a longhouse, a cottage, a totem and a stone
            // circle. Everything below already has a mesh sitting on disk under its own name.
            //
            // Ordered by age, and every one of them earns its place on a ladder or in a chain that
            // already exists rather than inventing a mechanic to justify itself.
            Tent,            // era I   -- the roof below a hut
            StoragePit,      // era I   -- the first thing anybody built to keep food in
            Totem,           // era I   -- the rung below a shrine
            StoneCircle,     // era I   -- and the rung above it
            Longhouse,       // era I   -- a roof for a whole band
            Cottage,         // era II  -- and one for a family
            Carpenter,       // era II  -- plank into furniture
            Cooper,          // era II  -- plank into a barrel, which is how anything travels
            Mason,           // era II  -- stone dressed into blocks that hold a wall up
            Brickworks,      // era II  -- clay into brick, at a scale the village kiln cannot
            WaterMill,       // era II  -- grain into flour, on a river instead of in the wind
            Granary,         // era II  -- and somewhere to keep what the mill makes
            Marketplace,     // era II  -- where a town's spare goods find their way out of it
            TradingPost,     // era II  -- and where a road ends
            Tavern,          // era II  -- what beer is FOR
            Stable,          // era II  -- horses, which is how an army moves
            Dock,            // era II  -- a quay smaller than a harbour
            Shipyard,        // era II  -- and where the hulls come from
            Monastery,       // era II  -- learning, kept by people who do nothing else
            PrintingPress,   // era II  -- paper into books
            Jeweler,         // era II  -- gold, silver and gems into something worth guarding
            Quarry,          // era II  -- stone, dug rather than gathered
            Mine,            // era II  -- and ore, the same way
            CoalMine,        // era II  -- coal, which the third age runs on
            SaltMine,        // era II  -- salt, for the drying rack
            Courthouse,      // era II  -- somewhere a theft is answered
            WatchPost,       // era II  -- and somewhere it is seen from
            Fort,            // era II  -- a wall between a palisade and a keep
            Castle,          // era II  -- and the one above a keep
            Gate,            // era II  -- the way through either of them
            Monument,        // era II  -- marble, standing up, so everyone can see it
            Statue,          // era II  -- bronze, doing the same
            // ---- the third age: coal, steel and the machine ----
            Forum,           // civic ground, and somewhere an argument is settled in public
            House_Medium,    // the roof ladder, continued
            House_Large,
            SuburbanHouse,
            OilSource,       // oil, out of the ground
            OilRefinery,     // and into fuel
            Gasworks,        // coal, cooked, into chemicals
            CoalPowerPlant,  // and burnt, into power
            ChemicalPlant,   // sulfur and coal -- the last orphan good, closed
            PlasticsPlant,
            MachineShop,     // steel to a tolerance no hand holds
            Factory,         // parts and power into tools by the score
            Arsenal,         // and into weapons the same way
            AmmoFactory,
            CarFactory,
            TrainStation,
            MetroStation,
            Warehouse,
            Bank,
            StockExchange,
            DepartmentStore,
            Supermarket,
            FishMarket,
            PostOffice,
            PoliceStation,
            FireStation,
            College,
            // ---- the fourth age: the atom, the chip and the tower ----
            RareElementsMine,
            NuclearPlant,
            SolarFarm,
            OffshoreRig,
            RecyclingPlant,
            ChipFactory,
            ComputerFactory,
            RoboticsPlant,
            DrugFactory,
            DataCenter,
            SoftwareStudio,
            ResearchLab,
            TechCampus,
            BroadcastTower,
            TVStudio,
            Airport,
            Skyscraper,
            CorporateHQ,
            Mall,
            Stadium
        }

        // The trade that works inside. Kept as its own enum in World so the catalogue does not have
        // to reach into People for the Job ordinals; the simulation maps one to the other.
        public enum Craft {
            NoCraft,
            Wright,          // Sawmill, CharcoalKiln, Kiln, Pottery, PaperMill -- wood and earth
            Smith,           // Smithy, Forge, Bronzeworks, SteelMill -- metal
            Victualler,      // Windmill, Bakery, Brewery, Smokehouse, Dairy -- food
            Weaving,         // Weaver, Tannery, TextileMill -- fibre and skin
            Tilling,         // Farm, Pasture, Orchard, Apiary -- land
            Lettering        // Scriptorium, Library, School, University -- knowledge
        }

        // Where a building may stand. Almost everything goes in the village and asks nothing of the
        // ground under it; the husbandry chain is the exception, and it is the reason this enum
        // exists -- a farm on a mountainside is not a farm, and a world where it could be would make
        // geography stop mattering the moment agriculture arrived.
        public enum Ground {
            Anywhere,
            Arable,          // grass or floodplain, with water within reach
            Grazing,         // open ground, dry or cold; no water needed
            Waterside,       // a river, a lake or the coast
            Coast,           // the SEA only -- a boat on a lake reaches nobody
            Rock             // hill, mountain or bare stone
        }

        public class Builds {
            private static mutable String[] NAME;
            // The .mesh a kind draws with, which is NOT always its own name: a bronzeworks and an
            // ironworks are the same shed with a different fire in it, and two pens on a hillside
            // look alike whether the animals in them give milk or wool. Splitting the two is what
            // lets the catalogue name a chain honestly without waiting on a model for every one.
            private static mutable String[] MESH;
            // Knowledge made per census by one of these, staffed. Zero for everything that makes a
            // good instead -- a building either produces something you can hold or something you
            // can know, and the two are counted in different places for the same reason a granary
            // and a library are different rooms.
            private static mutable int[] STUDY;
            private static mutable int[] SITE;      // the Ground it needs under it
            private static mutable int[] CRAFT;
            private static mutable int[] WOOD;      // to put it up
            private static mutable int[] STONE;
            // A third material, and the reason it had to exist: with a cost of wood and stone and
            // nothing else, NOTHING in the world consumed a plank or a brick, so the sawmill and
            // the kiln were never wanted and never built. A house is made of planks. Saying so is
            // what gives the wright chain a customer.
            private static mutable int[] MAT;
            private static mutable int[] MATN;
            private static mutable int[] HANDS;     // people who can work it at once
            private static mutable int[] IN1;
            private static mutable int[] N1;
            private static mutable int[] IN2;
            private static mutable int[] N2;
            private static mutable int[] OUT;
            private static mutable int[] NOUT;
            private static mutable float[] SECS;    // one batch
            // The era a kind becomes buildable in, from docs/ECONOMY.md and BUILDING_CATALOG.md.
            // Unlocking an era only WIDENS the menu -- nothing is retired and a smithy keeps
            // smelting forever -- so this is a floor and never a window.
            private static mutable int[] ERA;
            private static mutable int[] ROOF;      // people it houses, 0 for anything that works
            // How much of an army's work this soaks up before the town is open. Zero for anything
            // that is not a wall, which is everything else in the catalogue.
            private static mutable int[] WALL;
            // How far over water this reaches, in cells. Zero for everything that is not a harbour.
            private static mutable int[] PORT;
            // How many people this can keep in drinking water. Zero for everything else.
            private static mutable int[] WATER;
            // How many people this can nurse back. Zero for everything else.
            private static mutable int[] CARE;
            // Men a place keeps standing under arms whatever the weather. A barracks is not a wall
            // and never was one: it was given a wall value of forty so it could get past the test
            // that throws out anything with no output, and that made it the weakest rung of a
            // ladder it does not belong on -- a palisade is sixty, so the day a village fenced
            // itself it stopped being able to raise a barracks for ever. Not one stood anywhere.
            private static mutable int[] KEEP;
            // How well a place is WATCHED. Not the same as how well it is walled: a wall stops an
            // army and a watch catches a thief, and until there was crime in the world there was
            // nothing for the second number to do.
            private static mutable int[] WATCH;

            onClassLoad {
                int n = BuildingKind.count();
                Builds.NAME = new String[n]();
                Builds.MESH = new String[n]();
                Builds.STUDY = new int[n]();
                Builds.SITE = new int[n]();
                Builds.CRAFT = new int[n]();
                Builds.WOOD = new int[n]();
                Builds.STONE = new int[n]();
                Builds.MAT = new int[n]();
                Builds.MATN = new int[n]();
                Builds.HANDS = new int[n]();
                Builds.IN1 = new int[n]();
                Builds.N1 = new int[n]();
                Builds.IN2 = new int[n]();
                Builds.N2 = new int[n]();
                Builds.OUT = new int[n]();
                Builds.NOUT = new int[n]();
                Builds.SECS = new float[n]();
                Builds.ERA = new int[n]();
                Builds.ROOF = new int[n]();
                Builds.WALL = new int[n]();
                Builds.PORT = new int[n]();
                Builds.WATER = new int[n]();
                Builds.CARE = new int[n]();
                Builds.KEEP = new int[n]();
                Builds.WATCH = new int[n]();
                mutable int i = 0;
                while (i < n) {
                    Builds.NAME[i] = "NoBuilding";
                    Builds.MESH[i] = "NoBuilding";
                    Builds.STUDY[i] = 0;
                    Builds.SITE[i] = cast<int>(Ground.Anywhere);
                    Builds.MAT[i] = cast<int>(Good.Nothing);
                    Builds.CRAFT[i] = cast<int>(Craft.NoCraft);
                    Builds.IN1[i] = cast<int>(Good.Nothing);
                    Builds.IN2[i] = cast<int>(Good.Nothing);
                    Builds.OUT[i] = cast<int>(Good.Nothing);
                    Builds.SECS[i] = 20.0;
                    Builds.ERA[i] = 2;                   // medieval unless the catalogue says older
                    i = i + 1;
                }
                int wright = cast<int>(Craft.Wright);
                int smith = cast<int>(Craft.Smith);
                int vict = cast<int>(Craft.Victualler);
                int weave = cast<int>(Craft.Weaving);
                int none = cast<int>(Good.Nothing);

                // kind, mesh name, craft, wood, stone, hands, in1, n1, in2, n2, out, nout, seconds
                Builds.put(cast<int>(BuildingKind.TownHall), "TownHall", cast<int>(Craft.NoCraft),
                           0, 0, 0, none, 0, none, 0, none, 0, 0.0);

                Builds.put(cast<int>(BuildingKind.Sawmill), "Sawmill", wright,
                           60, 20, 5, cast<int>(Good.Wood), 10, none, 0,
                           cast<int>(Good.Plank), 6, 14.0);
                Builds.put(cast<int>(BuildingKind.CharcoalKiln), "CharcoalKiln", wright,
                           30, 40, 3, cast<int>(Good.Wood), 12, none, 0,
                           cast<int>(Good.Charcoal), 5, 18.0);
                Builds.put(cast<int>(BuildingKind.Kiln), "Kiln", wright,
                           25, 45, 3, cast<int>(Good.Clay), 10, none, 0,
                           cast<int>(Good.Brick), 8, 16.0);
                Builds.put(cast<int>(BuildingKind.Pottery), "Pottery", wright,
                           40, 30, 4, cast<int>(Good.Clay), 8, none, 0,
                           cast<int>(Good.Pottery), 5, 15.0);

                Builds.put(cast<int>(BuildingKind.Weaver), "Weaver", weave,
                           50, 15, 5, cast<int>(Good.Flax), 10, none, 0,
                           cast<int>(Good.Cloth), 6, 16.0);

                // The one with two inputs, and the reason it matters: a smithy with iron and no
                // charcoal STALLS, and a stalled building is what tells a community to go and build
                // the kiln. That is the whole "grown from need" mechanism in one recipe.
                Builds.put(cast<int>(BuildingKind.Smithy), "Smithy", smith,
                           45, 60, 4, cast<int>(Good.IronOre), 6, cast<int>(Good.Charcoal), 4,
                           cast<int>(Good.IronIngot), 4, 24.0);
                Builds.put(cast<int>(BuildingKind.Forge), "Forge", smith,
                           40, 55, 4, cast<int>(Good.CopperOre), 6, none, 0,
                           cast<int>(Good.CopperIngot), 4, 22.0);

                Builds.put(cast<int>(BuildingKind.Windmill), "Windmill", vict,
                           70, 25, 3, cast<int>(Good.Grain), 12, none, 0,
                           cast<int>(Good.Flour), 10, 14.0);
                Builds.put(cast<int>(BuildingKind.Bakery), "Bakery", vict,
                           35, 40, 4, cast<int>(Good.Flour), 8, none, 0,
                           cast<int>(Good.Bread), 12, 12.0);
                Builds.put(cast<int>(BuildingKind.Brewery), "Brewery", vict,
                           50, 35, 3, cast<int>(Good.Grain), 10, none, 0,
                           cast<int>(Good.Beer), 8, 18.0);
                Builds.put(cast<int>(BuildingKind.Smokehouse), "Smokehouse", vict,
                           45, 20, 3, cast<int>(Good.Fish), 10, none, 0,
                           cast<int>(Good.DriedMeat), 9, 16.0);

                // ---- husbandry: the chain whose input is ground ----
                //
                // A field has no `in1`, and that is not a gap in the table -- it is the whole point.
                // Everything above turns a good into another good, so the amount of food a world can
                // hold was fixed by what worldgen scattered on it: pick every berry and there are no
                // more berries. A farm turns LABOUR into bread, and labour is the one input that
                // grows when a place does. That is the difference between a village and a city, and
                // between a world where the fourth era is a rumour and one where somebody reaches it.
                int till = cast<int>(Craft.Tilling);
                Builds.put(cast<int>(BuildingKind.Farm), "Farm", till,
                           25, 5, 8, none, 0, none, 0, cast<int>(Good.Grain), 14, 18.0);
                Builds.put(cast<int>(BuildingKind.Pasture), "Pasture", till,
                           18, 0, 5, none, 0, none, 0, cast<int>(Good.Milk), 10, 20.0);
                Builds.put(cast<int>(BuildingKind.SheepFold), "SheepFold", till,
                           16, 0, 4, none, 0, none, 0, cast<int>(Good.Wool), 8, 22.0);
                Builds.put(cast<int>(BuildingKind.Orchard), "Orchard", till,
                           20, 0, 5, none, 0, none, 0, cast<int>(Good.Fruit), 10, 22.0);
                Builds.put(cast<int>(BuildingKind.Apiary), "Apiary", till,
                           12, 0, 3, none, 0, none, 0, cast<int>(Good.Honey), 6, 26.0);
                Builds.put(cast<int>(BuildingKind.Henhouse), "Henhouse", till,
                           10, 0, 3, none, 0, none, 0, cast<int>(Good.Egg), 8, 18.0);
                Builds.MESH[cast<int>(BuildingKind.SheepFold)] = "Pasture";
                Builds.MESH[cast<int>(BuildingKind.Henhouse)] = "Stable";
                Builds.ERA[cast<int>(BuildingKind.Farm)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Pasture)] = 1;
                Builds.ERA[cast<int>(BuildingKind.SheepFold)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Orchard)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Apiary)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Henhouse)] = 1;
                Builds.SITE[cast<int>(BuildingKind.Henhouse)] = cast<int>(Ground.Grazing);
                Builds.SITE[cast<int>(BuildingKind.Farm)] = cast<int>(Ground.Arable);
                Builds.SITE[cast<int>(BuildingKind.Orchard)] = cast<int>(Ground.Arable);
                Builds.SITE[cast<int>(BuildingKind.Pasture)] = cast<int>(Ground.Grazing);
                Builds.SITE[cast<int>(BuildingKind.SheepFold)] = cast<int>(Ground.Grazing);
                Builds.SITE[cast<int>(BuildingKind.Apiary)] = cast<int>(Ground.Grazing);

                // ---- the chains whose inputs finally exist ----
                //
                // Every one of these was already named in the goods catalogue and made by nobody:
                // nineteen goods in the ledger with a lifetime total of zero. They are here now
                // because the things they eat are being produced -- hides come off the hunt, reeds
                // off the marshes, grapes and copper and tin out of the ground -- so each of these
                // closes a chain rather than opening one that dead-ends.
                Builds.put(cast<int>(BuildingKind.Dairy), "Dairy", vict,
                           30, 20, 3, cast<int>(Good.Milk), 8, none, 0,
                           cast<int>(Good.Cheese), 6, 16.0);
                Builds.put(cast<int>(BuildingKind.Vineyard), "Vineyard", vict,
                           25, 10, 4, cast<int>(Good.Grapes), 10, none, 0,
                           cast<int>(Good.Wine), 6, 20.0);
                Builds.put(cast<int>(BuildingKind.Preservery), "Preservery", vict,
                           28, 18, 3, cast<int>(Good.Berries), 12, none, 0,
                           cast<int>(Good.Preserves), 8, 18.0);
                Builds.put(cast<int>(BuildingKind.Tannery), "Tannery", weave,
                           40, 20, 4, cast<int>(Good.Hide), 8, none, 0,
                           cast<int>(Good.Leather), 6, 18.0);
                // AND WOOL, which had a fold that made it and nothing anywhere that took it.
                //
                // A mill spins both, and giving it two inputs is the shape the catalogue already
                // says is worth having: a workshop that STALLS for want of one of them is what
                // tells a village to go and keep sheep. The era-two weaver keeps its single flax
                // input, so the cloth chain still has a cheap rung.
                // AND RE-COSTED to match the age it now lives in, which the era move alone did not
                // do: at eighty timber and sixty stone this was dearer than an IRONWORKS, priced
                // when it sat among the third age's factories, and an era-two village never got near
                // it however much it wanted one. Not one was raised in the arc that moved it down,
                // and wool stayed dead for the second reason instead of the first.
                //
                // A fulling mill is a shed with a water wheel. Costed between the weaver it
                // supersedes (50 and 15) and the ironworks it is not (60 and 80), which is where a
                // shed with a wheel belongs. This is a change to a COST and not to a want -- every
                // reversal in this campaign has been a want made bigger, and a building priced out
                // of its own age is a different defect with a different fix.
                Builds.put(cast<int>(BuildingKind.TextileMill), "TextileMill", weave,
                           55, 30, 5, cast<int>(Good.Cotton), 12, cast<int>(Good.Wool), 6,
                           cast<int>(Good.Cloth), 12, 12.0);
                Builds.put(cast<int>(BuildingKind.PaperMill), "PaperMill", wright,
                           45, 25, 4, cast<int>(Good.Reeds), 12, none, 0,
                           cast<int>(Good.Paper), 8, 16.0);
                Builds.put(cast<int>(BuildingKind.Ropewalk), "Ropewalk", wright,
                           30, 10, 3, cast<int>(Good.Reeds), 10, none, 0,
                           cast<int>(Good.Rope), 8, 14.0);
                Builds.put(cast<int>(BuildingKind.CementFactory), "CementFactory", wright,
                           70, 90, 5, cast<int>(Good.Stone), 12, cast<int>(Good.Coal), 4,
                           cast<int>(Good.Cement), 8, 18.0);
                Builds.put(cast<int>(BuildingKind.Bronzeworks), "Bronzeworks", smith,
                           45, 70, 4, cast<int>(Good.CopperIngot), 4, cast<int>(Good.TinOre), 4,
                           cast<int>(Good.BronzeIngot), 4, 24.0);
                Builds.put(cast<int>(BuildingKind.GoldSmelter), "GoldSmelter", smith,
                           40, 60, 3, cast<int>(Good.GoldOre), 6, none, 0,
                           cast<int>(Good.GoldBar), 4, 22.0);
                Builds.put(cast<int>(BuildingKind.SilverSmelter), "SilverSmelter", smith,
                           40, 60, 3, cast<int>(Good.SilverOre), 6, none, 0,
                           cast<int>(Good.SilverBar), 4, 22.0);
                Builds.put(cast<int>(BuildingKind.Ironworks), "Ironworks", smith,
                           60, 80, 6, cast<int>(Good.IronOre), 8, cast<int>(Good.Coal), 4,
                           cast<int>(Good.IronIngot), 8, 20.0);
                Builds.put(cast<int>(BuildingKind.SteelMill), "SteelMill", smith,
                           80, 120, 6, cast<int>(Good.IronIngot), 6, cast<int>(Good.Coal), 6,
                           cast<int>(Good.Steel), 5, 26.0);
                Builds.put(cast<int>(BuildingKind.Cannery), "Cannery", vict,
                           60, 80, 5, cast<int>(Good.DriedMeat), 8, cast<int>(Good.Steel), 2,
                           cast<int>(Good.CannedFood), 10, 14.0);
                // A tool is a neolithic idea, not an iron-age one, and putting the first one behind
                // the second era was a design mistake caught by a ten-minute render: the world
                // reported nought tools taken up because nobody had reached the era that makes
                // them. A hafted stone is what a village HAS, and the smith's version is twice as
                // many for the same hour rather than the first of its kind.
                Builds.put(cast<int>(BuildingKind.Toolmaker), "Toolmaker", smith,
                           20, 12, 3, cast<int>(Good.Wood), 6, cast<int>(Good.Stone), 4,
                           cast<int>(Good.Tools), 3, 20.0);
                Builds.put(cast<int>(BuildingKind.Toolsmith), "Toolsmith", smith,
                           45, 35, 4, cast<int>(Good.Plank), 4, cast<int>(Good.IronIngot), 2,
                           cast<int>(Good.Tools), 6, 20.0);
                // Glass. The catalogue named a Glassworks in a comment for months and never had one,
                // because Sand had no source anywhere in the world -- so the entry would have been a
                // workshop that could never run. Sand is a node now, so this is a real chain.
                Builds.put(cast<int>(BuildingKind.Glassworks), "Glassworks", wright,
                           50, 40, 3, cast<int>(Good.Sand), 6, cast<int>(Good.Charcoal), 3,
                           cast<int>(Good.Glass), 4, 22.0);
                Builds.ERA[cast<int>(BuildingKind.Glassworks)] = 2;
                Builds.put(cast<int>(BuildingKind.Weaponsmith), "Weaponsmith", smith,
                           50, 45, 4, cast<int>(Good.IronIngot), 4, cast<int>(Good.Plank), 2,
                           cast<int>(Good.Weapon), 4, 24.0);
                Builds.put(cast<int>(BuildingKind.Armory), "Armory", smith,
                           55, 50, 4, cast<int>(Good.IronIngot), 4, cast<int>(Good.Leather), 2,
                           cast<int>(Good.Armour), 3, 26.0);
                Builds.MESH[cast<int>(BuildingKind.Toolmaker)] = "GatheringHut";
                Builds.MESH[cast<int>(BuildingKind.Toolsmith)] = "Carpenter";
                Builds.ERA[cast<int>(BuildingKind.Toolmaker)] = 1;
                Builds.MESH[cast<int>(BuildingKind.Weaponsmith)] = "Arsenal";
                Builds.ERA[cast<int>(BuildingKind.Toolsmith)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Weaponsmith)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Armory)] = 2;
                Builds.MESH[cast<int>(BuildingKind.Bronzeworks)] = "Ironworks";
                Builds.MESH[cast<int>(BuildingKind.GoldSmelter)] = "Jeweler";
                Builds.MESH[cast<int>(BuildingKind.SilverSmelter)] = "Jeweler";
                Builds.MESH[cast<int>(BuildingKind.Ropewalk)] = "Cooper";
                Builds.MESH[cast<int>(BuildingKind.Preservery)] = "DryingRack";
                Builds.ERA[cast<int>(BuildingKind.Ropewalk)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Dairy)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Vineyard)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Preservery)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Tannery)] = 2;
                Builds.ERA[cast<int>(BuildingKind.PaperMill)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Bronzeworks)] = 2;
                Builds.ERA[cast<int>(BuildingKind.GoldSmelter)] = 2;
                Builds.ERA[cast<int>(BuildingKind.SilverSmelter)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Ironworks)] = 3;
                Builds.ERA[cast<int>(BuildingKind.SteelMill)] = 3;
                Builds.ERA[cast<int>(BuildingKind.CementFactory)] = 3;
                // THE TEXTILE MILL COMES DOWN AN AGE, and two dead goods come with it.
                //
                // Wool and cotton have a producer each and one consumer between them -- this mill --
                // and it sat in an age hardly any people reach. So the only thing in the world that
                // ever wanted wool was a building nobody could raise, which meant nothing wanted a
                // sheepfold, which meant not one was built in twenty generations while six hundred
                // and fifty-eight pastures were: milk is food and food is wanted, and wool was
                // wanted by nobody. Cotton grew wild and was gathered by nobody for the same reason.
                //
                // Putting the mill in the second age is not a discount -- it still costs eighty
                // timber and sixty stone, which is among the dearest things a village can attempt,
                // and it still stalls without BOTH fibres. What changes is that the want can now
                // exist at all: a place that wants a mill wants wool, and wanting wool is what tells
                // somebody to go and keep sheep. A fulling mill is a medieval building anyway; the
                // third age was never the honest place for it.
                Builds.ERA[cast<int>(BuildingKind.TextileMill)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Cannery)] = 4;
                Builds.SITE[cast<int>(BuildingKind.Vineyard)] = cast<int>(Ground.Arable);

                // ---- learning ----
                //
                // A nation's era used to be a side effect of having eaten well, and nothing else.
                // That is half true and it was the whole rule: a fed people has time to think, but
                // thinking is also something a people BUILDS, staffs and keeps up, and a world where
                // it is not shows nothing on the map for the difference between a kingdom that will
                // reach the fourth era and one that will not.
                //
                // These make nothing anybody can hold. What they make is on `STUDY`, counted where
                // knowledge is counted. A scriptorium eats paper, paper comes off the reed beds at
                // the river, so the marshes turn into the university on the hill by a chain that can
                // be followed the whole way -- which is the same standard every other chain here is
                // held to.
                int letter = cast<int>(Craft.Lettering);
                Builds.put(cast<int>(BuildingKind.Shrine), "Shrine", letter,
                           20, 10, 2, none, 0, none, 0, none, 0, 30.0);
                Builds.put(cast<int>(BuildingKind.Temple), "Temple", letter,
                           50, 60, 4, none, 0, none, 0, none, 0, 30.0);
                Builds.put(cast<int>(BuildingKind.Scriptorium), "Scriptorium", letter,
                           45, 40, 4, cast<int>(Good.Paper), 4, none, 0, none, 0, 30.0);
                Builds.put(cast<int>(BuildingKind.Library), "Library", letter,
                           70, 90, 6, cast<int>(Good.Paper), 6, none, 0, none, 0, 30.0);
                Builds.put(cast<int>(BuildingKind.School), "School", letter,
                           90, 110, 8, cast<int>(Good.Paper), 8, none, 0, none, 0, 30.0);
                Builds.put(cast<int>(BuildingKind.University), "University", letter,
                           160, 220, 12, cast<int>(Good.Paper), 12, none, 0, none, 0, 30.0);
                Builds.ERA[cast<int>(BuildingKind.Shrine)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Temple)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Scriptorium)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Library)] = 2;
                Builds.ERA[cast<int>(BuildingKind.School)] = 3;
                Builds.ERA[cast<int>(BuildingKind.University)] = 4;
                Builds.STUDY[cast<int>(BuildingKind.Shrine)] = 8;
                Builds.STUDY[cast<int>(BuildingKind.Temple)] = 20;
                Builds.STUDY[cast<int>(BuildingKind.Scriptorium)] = 40;
                Builds.STUDY[cast<int>(BuildingKind.Library)] = 70;
                Builds.STUDY[cast<int>(BuildingKind.School)] = 110;
                Builds.STUDY[cast<int>(BuildingKind.University)] = 180;

                // ---- the wall ----
                //
                // Every one of these makes nothing. They are scored apart from the rest for that
                // reason: a want is a shortfall of some good, and safety is not a good. What a town
                // is short of here is the confidence to sleep, and it reads that off whether
                // anybody is currently coming for it.
                Builds.put(cast<int>(BuildingKind.Palisade), "Palisade", cast<int>(Craft.NoCraft),
                           40, 8, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Rampart), "Rampart", cast<int>(Craft.NoCraft),
                           30, 90, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Keep), "Keep", cast<int>(Craft.NoCraft),
                           80, 200, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Watchtower), "Watchtower", cast<int>(Craft.NoCraft),
                           45, 30, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Barracks), "Barracks", cast<int>(Craft.NoCraft),
                           60, 40, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.MESH[cast<int>(BuildingKind.Rampart)] = "WallStraight";
                Builds.ERA[cast<int>(BuildingKind.Palisade)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Rampart)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Keep)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Watchtower)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Barracks)] = 2;
                Builds.MAT[cast<int>(BuildingKind.Rampart)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Rampart)] = 20;
                Builds.MAT[cast<int>(BuildingKind.Keep)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Keep)] = 50;
                // A stake fence buys an afternoon; a rampart buys a season; a keep buys long enough
                // that the army in front of it starts to starve first. That escalation is what
                // makes the second and third eras worth reaching for a place with enemies.
                Builds.WALL[cast<int>(BuildingKind.Palisade)] = 60;
                Builds.WALL[cast<int>(BuildingKind.Rampart)] = 260;
                Builds.WALL[cast<int>(BuildingKind.Keep)] = 700;
                Builds.WALL[cast<int>(BuildingKind.Watchtower)] = 80;
                // Six men, standing, whatever else is happening. Read as a KEEP and not as a wall,
                // so a village that has already fenced itself can still raise one.
                Builds.KEEP[cast<int>(BuildingKind.Barracks)] = 6;
                // AND WHO IS LOOKING. A watchtower was a wall value and nothing else, so the one
                // building in the catalogue whose whole purpose is SEEING did the same job as a
                // fence. It sees a thief now, which is the job its name has always described.
                Builds.WATCH[cast<int>(BuildingKind.Watchtower)] = 6;
                Builds.WATCH[cast<int>(BuildingKind.Barracks)] = 3;
                Builds.WATCH[cast<int>(BuildingKind.Keep)] = 4;
                Builds.WATCH[cast<int>(BuildingKind.Palisade)] = 1;

                // ---- the harbour ----
                //
                // Planks and rope, which is the whole of a jetty and a mooring, and the first thing
                // in this world that ever wanted rope. The reed beds are worked, the ropewalk has a
                // recipe and an era, and in twenty generations not one length of rope was ever made
                // -- because nothing downstream asked for any. A want that nothing consumes is a
                // dead branch of the chain however correct its recipe is.
                Builds.put(cast<int>(BuildingKind.Harbor), "Harbor", cast<int>(Craft.NoCraft),
                           60, 20, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Harbor)] = 1;
                Builds.SITE[cast<int>(BuildingKind.Harbor)] = cast<int>(Ground.Coast);
                Builds.MAT[cast<int>(BuildingKind.Harbor)] = cast<int>(Good.Rope);
                Builds.MATN[cast<int>(BuildingKind.Harbor)] = 12;
                // Nine hundred cells of open water, against the two hundred and sixty a cart manages
                // overland. That ratio is the whole reason a port is worth planks: the sea is the
                // only road in this world that was already built.
                Builds.PORT[cast<int>(BuildingKind.Harbor)] = 900;

                // The shipwright, and the volume the whole sea chain was missing.
                //
                // Eighteen planks and sixteen rope for one hull. A jetty's dozen of rope was never
                // going to be worth a ropewalk -- sixteen a boat, and a coast that wants boats, is.
                // This is the shape that has worked twice already: not a want made bigger, but a
                // want that had nowhere to come FROM given somewhere.
                Builds.put(cast<int>(BuildingKind.Shipwright), "Shipwright", wright,
                           70, 15, 3, cast<int>(Good.Plank), 18, cast<int>(Good.Rope), 16,
                           cast<int>(Good.Boat), 1, 40.0);
                Builds.ERA[cast<int>(BuildingKind.Shipwright)] = 1;
                Builds.SITE[cast<int>(BuildingKind.Shipwright)] = cast<int>(Ground.Coast);

                // ---- water ----
                //
                // Heads served, and the escalation is the point: a well is a hamlet's answer and it
                // stays a hamlet's answer for ever, so a place that grows past forty has to learn
                // something. That is what makes a dry site a real cost rather than a texture.
                //
                // The aqueduct is the one that needs the WORLD and not just an era: it has to reach
                // a river or a lake, so it sits on Waterside like the mills do. Everything else can
                // be sunk or raised in the village itself.
                Builds.put(cast<int>(BuildingKind.Well), "Well", cast<int>(Craft.NoCraft),
                           15, 10, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.RainCatcher), "RainCatcher", cast<int>(Craft.NoCraft),
                           20, 4, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Aqueduct), "Aqueduct", cast<int>(Craft.NoCraft),
                           30, 90, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Fountain), "Fountain", cast<int>(Craft.NoCraft),
                           10, 45, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.WaterTower), "WaterTower", cast<int>(Craft.NoCraft),
                           40, 60, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.WaterTreatment), "WaterTreatment",
                           cast<int>(Craft.NoCraft),
                           50, 80, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Well)] = 1;
                Builds.ERA[cast<int>(BuildingKind.RainCatcher)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Aqueduct)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Fountain)] = 2;
                Builds.ERA[cast<int>(BuildingKind.WaterTower)] = 3;
                Builds.ERA[cast<int>(BuildingKind.WaterTreatment)] = 4;
                Builds.SITE[cast<int>(BuildingKind.Aqueduct)] = cast<int>(Ground.Waterside);
                Builds.MAT[cast<int>(BuildingKind.Aqueduct)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Aqueduct)] = 24;
                Builds.MAT[cast<int>(BuildingKind.WaterTower)] = cast<int>(Good.IronIngot);
                Builds.MATN[cast<int>(BuildingKind.WaterTower)] = 10;
                Builds.MAT[cast<int>(BuildingKind.WaterTreatment)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.WaterTreatment)] = 40;
                Builds.WATER[cast<int>(BuildingKind.Well)] = 40;
                Builds.WATER[cast<int>(BuildingKind.RainCatcher)] = 25;
                Builds.WATER[cast<int>(BuildingKind.Aqueduct)] = 300;
                Builds.WATER[cast<int>(BuildingKind.Fountain)] = 120;
                Builds.WATER[cast<int>(BuildingKind.WaterTower)] = 500;
                Builds.WATER[cast<int>(BuildingKind.WaterTreatment)] = 900;

                // ---- what looks after people ----
                //
                // An apothecary EATS HERBS, which is the point of putting it here rather than giving
                // care away with the era: six hundred and fifty thousand herbs are gathered in an
                // arc and nothing downstream ever wanted one. Now the commonest thing in the world
                // has somewhere to go, and a village that gathers well gets its sick back.
                Builds.put(cast<int>(BuildingKind.Bathhouse), "Bathhouse", cast<int>(Craft.NoCraft),
                           25, 55, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Apothecary), "Apothecary", cast<int>(Craft.Victualler),
                           30, 15, 2, cast<int>(Good.Herbs), 12, none, 0, none, 0, 16.0);
                Builds.put(cast<int>(BuildingKind.Hospital), "Hospital", cast<int>(Craft.NoCraft),
                           60, 70, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.ModernHospital), "ModernHospital",
                           cast<int>(Craft.NoCraft),
                           80, 120, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Bathhouse)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Apothecary)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Hospital)] = 3;
                Builds.ERA[cast<int>(BuildingKind.ModernHospital)] = 4;
                Builds.MAT[cast<int>(BuildingKind.Hospital)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Hospital)] = 20;
                Builds.MAT[cast<int>(BuildingKind.ModernHospital)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.ModernHospital)] = 50;
                Builds.CARE[cast<int>(BuildingKind.Bathhouse)] = 60;
                Builds.CARE[cast<int>(BuildingKind.Apothecary)] = 90;
                Builds.CARE[cast<int>(BuildingKind.Hospital)] = 260;
                Builds.CARE[cast<int>(BuildingKind.ModernHospital)] = 700;

                // ---- what the orphaned goods are FOR ----
                //
                // Marble, salt, silver and bronze are dug out of this world and appear nowhere else
                // in this catalogue -- marble and salt not once, silver and bronze only in the
                // recipe that makes them. A good with a producer and no consumer is not scarce, it
                // is fictional: the want machinery cannot see it, so nobody digs it, so it never
                // exists. Wool was in exactly this state until an hour ago.
                //
                // Each of these carries no other chain on its back, which is the rule three
                // reverted material costs paid for. Each also has a mesh already cut and sitting
                // unused on disk -- there are ninety-five of those, and the ones below are the four
                // whose good, age and purpose all line up.

                // GILDING, and the rung the ladder of learning was missing between the village
                // shrine and the town temple. Study 13 sits between 8 and 20 on purpose.
                Builds.put(cast<int>(BuildingKind.Church), "Church", letter,
                           40, 45, 2, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Church)] = 2;
                Builds.STUDY[cast<int>(BuildingKind.Church)] = 13;
                Builds.MAT[cast<int>(BuildingKind.Church)] = cast<int>(Good.GoldBar);
                Builds.MATN[cast<int>(BuildingKind.Church)] = 3;

                // A HALL WITH SILVER ON THE TABLE. It goes on the roof ladder above a house, so a
                // rich town houses more people per building and a poor one still builds houses --
                // the comfort ladder falls back on its own, which is what makes this safe.
                Builds.put(cast<int>(BuildingKind.Manor), "Manor", cast<int>(Craft.NoCraft),
                           60, 50, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Manor)] = 2;
                Builds.MAT[cast<int>(BuildingKind.Manor)] = cast<int>(Good.SilverBar);
                Builds.MATN[cast<int>(BuildingKind.Manor)] = 4;

                // A BRONZE LAMP AND ITS REFLECTOR. Scored as a port, because what a lighthouse is
                // worth is exactly what a harbour is worth -- it is the same road.
                Builds.put(cast<int>(BuildingKind.Lighthouse), "Lighthouse", cast<int>(Craft.NoCraft),
                           35, 60, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Lighthouse)] = 2;
                Builds.SITE[cast<int>(BuildingKind.Lighthouse)] = cast<int>(Ground.Coast);
                Builds.PORT[cast<int>(BuildingKind.Lighthouse)] = 40;
                Builds.MAT[cast<int>(BuildingKind.Lighthouse)] = cast<int>(Good.BronzeIngot);
                Builds.MATN[cast<int>(BuildingKind.Lighthouse)] = 6;

                // SALTING MEAT, which is what salt is for and the reason anybody ever dug it. A
                // second maker of dried meat, deliberately in the SECOND age so the smokehouse stays
                // the earliest one: `makerOf` returns the earliest, so putting this first would make
                // the whole world's dried meat depend on salt overnight. This one competes instead.
                Builds.put(cast<int>(BuildingKind.DryingRack), "DryingRack", vict,
                           20, 5, 2, cast<int>(Good.RawMeat), 8, cast<int>(Good.Salt), 4,
                           cast<int>(Good.DriedMeat), 10, 14.0);
                Builds.ERA[cast<int>(BuildingKind.DryingRack)] = 2;

                // MARBLE, and the top of the ladder of learning below the university.
                Builds.put(cast<int>(BuildingKind.Cathedral), "Cathedral", letter,
                           90, 140, 4, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Cathedral)] = 3;
                Builds.STUDY[cast<int>(BuildingKind.Cathedral)] = 140;
                Builds.MAT[cast<int>(BuildingKind.Cathedral)] = cast<int>(Good.Marble);
                Builds.MATN[cast<int>(BuildingKind.Cathedral)] = 30;

                // ================= THE FIRST TWO AGES, FILLED IN =================
                //
                // A hundred and forty-eight building meshes were cut for this game and sixty-nine
                // had a kind behind them. What follows is not new design -- it is the art that was
                // already drawn, wired to the ladders and chains this world already has. A village
                // had one shelter and one shrine where the meshes gave it a tent, a longhouse, a
                // cottage, a totem and a stone circle.
                //
                // Every one of them either sits on an existing ladder (roof, learning, wall, port,
                // water, care, watch, muster) or runs a recipe out of goods that already exist. Not
                // one of them invents a mechanic to justify itself, and where an honest recipe was
                // not available the kind waits rather than getting a dishonest one.

                // ---- THE FOUR GATHERING HUTS ARE NOT HERE, AND THE ARC THAT TRIED THEM IS WHY ----
                //
                // A gathering hut, a foragers' camp, a hunters' lodge and a fishing hut were given
                // the obvious recipe -- labour into food, exactly as a farm is -- and they broke the
                // economy in one arc. Seven hundred and ninety-nine fishing huts and four hundred
                // and sixty-one totems went up; FARMS FELL FROM THREE HUNDRED AND THREE TO
                // THIRTY-SEVEN; breweries, potteries and glassworks fell by four fifths; the goods
                // never produced went from four back to thirteen, taking bread, weapons and armour
                // with them, and the world's houses fell by a third.
                //
                // The error is not the numbers, it is the principle. Gathering by hand ALREADY
                // EXISTS in this world -- foragers, hunters and fishers work nodes directly, for
                // free, from the first minute. A building for it duplicates a mechanic and offers
                // nothing except a cheaper way to make food than farming, so every village built
                // one instead of a farm and the whole industrial half starved for want of the
                // surplus a farm makes.
                //
                // What these four meshes actually want is a mechanic this world has not got: a
                // place that lets somebody work nodes FURTHER AWAY than they otherwise could. That
                // is a real feature and it is worth building. It is not a catalogue entry, so these
                // wait for it rather than getting a recipe that happens to fit.

                // A cold pit with fruit in it is the oldest preserving there is, and it gives the
                // first age a rung on a chain that until now started in the second.
                Builds.put(cast<int>(BuildingKind.StoragePit), "StoragePit", vict,
                           14, 4, 2, cast<int>(Good.Fruit), 12, none, 0,
                           cast<int>(Good.Preserves), 8, 18.0);
                Builds.ERA[cast<int>(BuildingKind.StoragePit)] = 1;

                // ---- the roof ladder, from a tent up ----
                Builds.put(cast<int>(BuildingKind.Tent), "Tent", cast<int>(Craft.NoCraft),
                           6, 0, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Longhouse), "Longhouse", cast<int>(Craft.NoCraft),
                           30, 0, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Cottage), "Cottage", cast<int>(Craft.NoCraft),
                           22, 14, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Tent)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Longhouse)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Cottage)] = 2;
                Builds.ROOF[cast<int>(BuildingKind.Tent)] = 3;
                Builds.ROOF[cast<int>(BuildingKind.Longhouse)] = 12;
                Builds.ROOF[cast<int>(BuildingKind.Cottage)] = 18;

                // ---- and the ladder of learning, below the shrine ----
                Builds.put(cast<int>(BuildingKind.Totem), "Totem", letter,
                           8, 0, 1, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.StoneCircle), "StoneCircle", letter,
                           0, 20, 1, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Monastery), "Monastery", letter,
                           55, 60, 3, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Totem)] = 1;
                Builds.ERA[cast<int>(BuildingKind.StoneCircle)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Monastery)] = 2;
                Builds.STUDY[cast<int>(BuildingKind.Totem)] = 4;
                Builds.STUDY[cast<int>(BuildingKind.StoneCircle)] = 6;
                Builds.STUDY[cast<int>(BuildingKind.Monastery)] = 55;

                // ---- era II: the crafts the meshes were drawn for ----
                Builds.put(cast<int>(BuildingKind.Carpenter), "Carpenter", wright,
                           35, 10, 3, cast<int>(Good.Plank), 8, none, 0,
                           cast<int>(Good.Furniture), 5, 18.0);
                Builds.put(cast<int>(BuildingKind.Cooper), "Cooper", wright,
                           30, 8, 2, cast<int>(Good.Plank), 6, none, 0,
                           cast<int>(Good.Rope), 5, 16.0);
                // Lime mortar is stone and clay burnt together, and it is a mason's work four
                // hundred years before anybody builds a cement factory. It gives cement a rung in
                // the second age, which is where every other material in this catalogue starts.
                Builds.put(cast<int>(BuildingKind.Mason), "Mason", wright,
                           30, 40, 3, cast<int>(Good.Stone), 14, cast<int>(Good.Clay), 6,
                           cast<int>(Good.Cement), 6, 20.0);
                Builds.put(cast<int>(BuildingKind.Brickworks), "Brickworks", wright,
                           50, 45, 4, cast<int>(Good.Clay), 16, none, 0,
                           cast<int>(Good.Brick), 14, 16.0);
                // A mill on a river rather than in the wind. Same trade, different ground -- which
                // is the asymmetry the waterside site exists for.
                Builds.put(cast<int>(BuildingKind.WaterMill), "WaterMill", vict,
                           60, 30, 3, cast<int>(Good.Grain), 12, none, 0,
                           cast<int>(Good.Flour), 12, 12.0);
                Builds.SITE[cast<int>(BuildingKind.WaterMill)] = cast<int>(Ground.Waterside);
                // A granary with a hand quern in it: worse than a mill and available to a village
                // that has no river and no millwright.
                Builds.put(cast<int>(BuildingKind.Granary), "Granary", vict,
                           40, 20, 3, cast<int>(Good.Grain), 16, none, 0,
                           cast<int>(Good.Flour), 8, 22.0);
                Builds.put(cast<int>(BuildingKind.PrintingPress), "PrintingPress", letter,
                           45, 35, 3, cast<int>(Good.Paper), 10, none, 0,
                           cast<int>(Good.Book), 6, 18.0);
                Builds.put(cast<int>(BuildingKind.Jeweler), "Jeweler", smith,
                           35, 30, 2, cast<int>(Good.Gems), 6, cast<int>(Good.SilverBar), 2,
                           cast<int>(Good.Jewelry), 4, 22.0);
                Builds.ERA[cast<int>(BuildingKind.Carpenter)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Cooper)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Mason)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Brickworks)] = 2;
                Builds.ERA[cast<int>(BuildingKind.WaterMill)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Granary)] = 2;
                Builds.ERA[cast<int>(BuildingKind.PrintingPress)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Jeweler)] = 2;

                // ---- digging as an industry, rather than by hand at an outcrop ----
                //
                // People already quarry and mine at nodes. These are the places that do it at a
                // scale a pair of hands cannot, and they need the ground under them to be the right
                // ground -- which is the one thing in this catalogue that is about WHERE a town
                // settled rather than what it can afford.
                Builds.put(cast<int>(BuildingKind.Quarry), "Quarry", wright,
                           25, 10, 4, none, 0, none, 0, cast<int>(Good.Stone), 16, 18.0);
                Builds.put(cast<int>(BuildingKind.Mine), "Mine", smith,
                           40, 20, 4, none, 0, none, 0, cast<int>(Good.IronOre), 10, 22.0);
                Builds.put(cast<int>(BuildingKind.CoalMine), "CoalMine", smith,
                           40, 20, 4, none, 0, none, 0, cast<int>(Good.Coal), 12, 20.0);
                Builds.put(cast<int>(BuildingKind.SaltMine), "SaltMine", wright,
                           30, 15, 3, none, 0, none, 0, cast<int>(Good.Salt), 10, 20.0);
                Builds.ERA[cast<int>(BuildingKind.Quarry)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Mine)] = 2;
                Builds.ERA[cast<int>(BuildingKind.CoalMine)] = 2;
                Builds.ERA[cast<int>(BuildingKind.SaltMine)] = 2;
                Builds.SITE[cast<int>(BuildingKind.Quarry)] = cast<int>(Ground.Rock);
                Builds.SITE[cast<int>(BuildingKind.Mine)] = cast<int>(Ground.Rock);
                Builds.SITE[cast<int>(BuildingKind.CoalMine)] = cast<int>(Ground.Rock);
                Builds.SITE[cast<int>(BuildingKind.SaltMine)] = cast<int>(Ground.Rock);

                // ---- what a market is: the land's answer to being cut off ----
                //
                // The port column is scored on what a town CANNOT GET, which is exactly what a
                // market answers -- the difference is that a quay needs the coast and a market does
                // not. An inland town that nobody's cart reaches has the same problem a headland
                // has, and until now only the headland had a building for it.
                Builds.put(cast<int>(BuildingKind.Marketplace), "Marketplace", cast<int>(Craft.NoCraft),
                           35, 25, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.TradingPost), "TradingPost", cast<int>(Craft.NoCraft),
                           30, 15, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Dock), "Dock", cast<int>(Craft.NoCraft),
                           40, 20, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Shipyard), "Shipyard", wright,
                           70, 40, 5, cast<int>(Good.Plank), 20, cast<int>(Good.Rope), 8,
                           cast<int>(Good.Boat), 2, 40.0);
                Builds.ERA[cast<int>(BuildingKind.Marketplace)] = 2;
                Builds.ERA[cast<int>(BuildingKind.TradingPost)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Dock)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Shipyard)] = 2;
                Builds.PORT[cast<int>(BuildingKind.Marketplace)] = 200;
                Builds.PORT[cast<int>(BuildingKind.TradingPost)] = 120;
                Builds.PORT[cast<int>(BuildingKind.Dock)] = 350;
                Builds.SITE[cast<int>(BuildingKind.Dock)] = cast<int>(Ground.Coast);
                Builds.SITE[cast<int>(BuildingKind.Shipyard)] = cast<int>(Ground.Coast);

                // A tavern is where a town rests, and rest is the one thing this world already
                // measures as care. It is also the only consumer beer has ever had.
                Builds.put(cast<int>(BuildingKind.Tavern), "Tavern", vict,
                           35, 20, 3, cast<int>(Good.Beer), 8, none, 0, none, 0, 16.0);
                Builds.ERA[cast<int>(BuildingKind.Tavern)] = 2;
                Builds.CARE[cast<int>(BuildingKind.Tavern)] = 45;

                // ---- law, and the walls ----
                Builds.put(cast<int>(BuildingKind.WatchPost), "WatchPost", cast<int>(Craft.NoCraft),
                           18, 10, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Courthouse), "Courthouse", cast<int>(Craft.NoCraft),
                           45, 55, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.WatchPost)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Courthouse)] = 2;
                Builds.WATCH[cast<int>(BuildingKind.WatchPost)] = 4;
                Builds.WATCH[cast<int>(BuildingKind.Courthouse)] = 7;

                Builds.put(cast<int>(BuildingKind.Fort), "Fort", cast<int>(Craft.NoCraft),
                           60, 90, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Gate), "Gate", cast<int>(Craft.NoCraft),
                           25, 45, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Castle), "Castle", cast<int>(Craft.NoCraft),
                           120, 220, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Fort)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Gate)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Castle)] = 3;
                Builds.WALL[cast<int>(BuildingKind.Fort)] = 420;
                Builds.WALL[cast<int>(BuildingKind.Gate)] = 140;
                Builds.WALL[cast<int>(BuildingKind.Castle)] = 1100;
                Builds.WATCH[cast<int>(BuildingKind.Fort)] = 5;
                Builds.WATCH[cast<int>(BuildingKind.Castle)] = 8;
                Builds.MAT[cast<int>(BuildingKind.Castle)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Castle)] = 40;

                // A stable is muster capacity on four legs, which is the same column a barracks is
                // scored on and the same reason: it is what a country can KEEP standing.
                Builds.put(cast<int>(BuildingKind.Stable), "Stable", cast<int>(Craft.NoCraft),
                           40, 15, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Stable)] = 2;
                Builds.KEEP[cast<int>(BuildingKind.Stable)] = 4;

                // Marble and bronze, standing up where everybody can see them. They teach nothing a
                // school teaches, but a people that can spare the stone to say who it is has
                // something a people scratching for bread does not -- and study is the only column
                // in this catalogue that measures that.
                Builds.put(cast<int>(BuildingKind.Monument), "Monument", letter,
                           20, 80, 1, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Statue), "Statue", letter,
                           15, 40, 1, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Monument)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Statue)] = 2;
                Builds.STUDY[cast<int>(BuildingKind.Monument)] = 10;
                Builds.STUDY[cast<int>(BuildingKind.Statue)] = 7;
                Builds.MAT[cast<int>(BuildingKind.Monument)] = cast<int>(Good.Marble);
                Builds.MATN[cast<int>(BuildingKind.Monument)] = 20;
                Builds.MAT[cast<int>(BuildingKind.Statue)] = cast<int>(Good.BronzeIngot);
                Builds.MATN[cast<int>(BuildingKind.Statue)] = 8;

                // ================= THE THIRD AND FOURTH AGES =================
                //
                // The whole rest of the catalogue, in one pass and deliberately WITHOUT balancing
                // it kind by kind: a number tuned against half a chain is a number that has to be
                // tuned again when the other half lands, and the arc it costs to learn that is
                // twenty-five minutes each time. Everything goes in; the balancing is one round at
                // the end, against the complete set.
                //
                // These close the last four goods that came out of the ground and went nowhere:
                // sulfur into chemicals and ammunition, oil into fuel, rare earth into chips, and
                // gems into jewelry in the age below.

                // ---- power and the things that come out of the ground for it ----
                Builds.put(cast<int>(BuildingKind.OilSource), "OilSource", smith,
                           50, 30, 4, none, 0, none, 0, cast<int>(Good.Oil), 12, 20.0);
                Builds.SITE[cast<int>(BuildingKind.OilSource)] = cast<int>(Ground.Rock);
                Builds.put(cast<int>(BuildingKind.OilRefinery), "OilRefinery", smith,
                           90, 110, 6, cast<int>(Good.Oil), 12, none, 0,
                           cast<int>(Good.Fuel), 10, 18.0);
                Builds.put(cast<int>(BuildingKind.Gasworks), "Gasworks", smith,
                           70, 80, 5, cast<int>(Good.Coal), 14, none, 0,
                           cast<int>(Good.Chemicals), 8, 20.0);
                Builds.put(cast<int>(BuildingKind.CoalPowerPlant), "CoalPowerPlant", smith,
                           100, 140, 6, cast<int>(Good.Coal), 16, none, 0,
                           cast<int>(Good.Electricity), 14, 16.0);
                Builds.put(cast<int>(BuildingKind.ChemicalPlant), "ChemicalPlant", smith,
                           85, 100, 5, cast<int>(Good.Sulfur), 8, cast<int>(Good.Coal), 6,
                           cast<int>(Good.Chemicals), 12, 18.0);
                Builds.put(cast<int>(BuildingKind.PlasticsPlant), "PlasticsPlant", smith,
                           80, 90, 5, cast<int>(Good.Fuel), 8, cast<int>(Good.Chemicals), 6,
                           cast<int>(Good.Plastic), 12, 16.0);
                Builds.ERA[cast<int>(BuildingKind.OilSource)] = 3;
                Builds.ERA[cast<int>(BuildingKind.OilRefinery)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Gasworks)] = 3;
                Builds.ERA[cast<int>(BuildingKind.CoalPowerPlant)] = 3;
                Builds.ERA[cast<int>(BuildingKind.ChemicalPlant)] = 3;
                Builds.ERA[cast<int>(BuildingKind.PlasticsPlant)] = 3;
                Builds.MAT[cast<int>(BuildingKind.CoalPowerPlant)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.CoalPowerPlant)] = 30;

                // ---- the machine, and what it makes by the score ----
                // POWER AND NOT TOOLS, because a machine shop that eats tools while a factory and
                // a robotics plant both make tools is a ring, and the suite says so: three cycles
                // in the first pass over the industrial half, all of them mine. A shop turns steel
                // into parts on a lathe that has to be driven, which is the honest input anyway.
                Builds.put(cast<int>(BuildingKind.MachineShop), "MachineShop", smith,
                           70, 60, 5, cast<int>(Good.Steel), 6, cast<int>(Good.Electricity), 4,
                           cast<int>(Good.MachineParts), 8, 18.0);
                Builds.put(cast<int>(BuildingKind.Factory), "Factory", smith,
                           110, 130, 8, cast<int>(Good.MachineParts), 6,
                           cast<int>(Good.Electricity), 8, cast<int>(Good.Tools), 24, 14.0);
                Builds.put(cast<int>(BuildingKind.Arsenal), "Arsenal", smith,
                           95, 110, 6, cast<int>(Good.Steel), 8, cast<int>(Good.MachineParts), 4,
                           cast<int>(Good.Weapon), 14, 16.0);
                Builds.put(cast<int>(BuildingKind.AmmoFactory), "AmmoFactory", smith,
                           80, 90, 5, cast<int>(Good.Sulfur), 8, cast<int>(Good.IronIngot), 4,
                           cast<int>(Good.Ammo), 16, 14.0);
                Builds.put(cast<int>(BuildingKind.CarFactory), "CarFactory", smith,
                           120, 140, 8, cast<int>(Good.Steel), 10,
                           cast<int>(Good.MachineParts), 8, cast<int>(Good.Vehicle), 4, 22.0);
                Builds.ERA[cast<int>(BuildingKind.MachineShop)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Factory)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Arsenal)] = 3;
                Builds.ERA[cast<int>(BuildingKind.AmmoFactory)] = 3;
                Builds.ERA[cast<int>(BuildingKind.CarFactory)] = 3;
                Builds.MAT[cast<int>(BuildingKind.Factory)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Factory)] = 40;

                // ---- trade, at the scale a market cannot ----
                //
                // All of these are scored on the port column, which asks what a town CANNOT GET.
                // A station, a warehouse and an exchange are the same answer as a quay, reached by
                // a different road -- and none of them needs money to exist, which is why they can
                // be built now and priced later.
                Builds.put(cast<int>(BuildingKind.TrainStation), "TrainStation", cast<int>(Craft.NoCraft),
                           80, 100, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.MetroStation), "MetroStation", cast<int>(Craft.NoCraft),
                           60, 120, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Warehouse), "Warehouse", cast<int>(Craft.NoCraft),
                           70, 50, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Bank), "Bank", cast<int>(Craft.NoCraft),
                           50, 90, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.StockExchange), "StockExchange", cast<int>(Craft.NoCraft),
                           70, 120, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.DepartmentStore), "DepartmentStore", cast<int>(Craft.NoCraft),
                           75, 70, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Supermarket), "Supermarket", cast<int>(Craft.NoCraft),
                           65, 60, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.FishMarket), "FishMarket", cast<int>(Craft.NoCraft),
                           35, 25, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.PostOffice), "PostOffice", cast<int>(Craft.NoCraft),
                           45, 40, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.TrainStation)] = 3;
                Builds.ERA[cast<int>(BuildingKind.MetroStation)] = 4;
                Builds.ERA[cast<int>(BuildingKind.Warehouse)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Bank)] = 3;
                Builds.ERA[cast<int>(BuildingKind.StockExchange)] = 3;
                Builds.ERA[cast<int>(BuildingKind.DepartmentStore)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Supermarket)] = 4;
                Builds.ERA[cast<int>(BuildingKind.FishMarket)] = 2;
                Builds.ERA[cast<int>(BuildingKind.PostOffice)] = 3;
                Builds.PORT[cast<int>(BuildingKind.TrainStation)] = 1400;
                Builds.PORT[cast<int>(BuildingKind.MetroStation)] = 1800;
                Builds.PORT[cast<int>(BuildingKind.Warehouse)] = 500;
                Builds.PORT[cast<int>(BuildingKind.Bank)] = 600;
                Builds.PORT[cast<int>(BuildingKind.StockExchange)] = 1000;
                Builds.PORT[cast<int>(BuildingKind.DepartmentStore)] = 700;
                Builds.PORT[cast<int>(BuildingKind.Supermarket)] = 900;
                Builds.PORT[cast<int>(BuildingKind.FishMarket)] = 260;
                Builds.PORT[cast<int>(BuildingKind.PostOffice)] = 420;
                Builds.SITE[cast<int>(BuildingKind.FishMarket)] = cast<int>(Ground.Coast);

                // ---- law, learning and the civic ground ----
                Builds.put(cast<int>(BuildingKind.PoliceStation), "PoliceStation", cast<int>(Craft.NoCraft),
                           55, 65, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.FireStation), "FireStation", cast<int>(Craft.NoCraft),
                           55, 60, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Forum), "Forum", letter,
                           40, 70, 2, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.College), "College", letter,
                           85, 95, 4, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.PoliceStation)] = 3;
                Builds.ERA[cast<int>(BuildingKind.FireStation)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Forum)] = 2;
                Builds.ERA[cast<int>(BuildingKind.College)] = 3;
                Builds.WATCH[cast<int>(BuildingKind.PoliceStation)] = 14;
                Builds.WATCH[cast<int>(BuildingKind.FireStation)] = 6;
                Builds.WATCH[cast<int>(BuildingKind.Forum)] = 3;
                Builds.STUDY[cast<int>(BuildingKind.Forum)] = 16;
                Builds.STUDY[cast<int>(BuildingKind.College)] = 125;

                // ---- the roof ladder, all the way up ----
                Builds.put(cast<int>(BuildingKind.House_Medium), "House_Medium", cast<int>(Craft.NoCraft),
                           28, 20, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.House_Large), "House_Large", cast<int>(Craft.NoCraft),
                           45, 35, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.SuburbanHouse), "SuburbanHouse", cast<int>(Craft.NoCraft),
                           50, 45, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Skyscraper), "Skyscraper", cast<int>(Craft.NoCraft),
                           140, 260, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.House_Medium)] = 2;
                Builds.ERA[cast<int>(BuildingKind.House_Large)] = 2;
                Builds.ERA[cast<int>(BuildingKind.SuburbanHouse)] = 3;
                Builds.ERA[cast<int>(BuildingKind.Skyscraper)] = 4;
                Builds.ROOF[cast<int>(BuildingKind.House_Medium)] = 20;
                Builds.ROOF[cast<int>(BuildingKind.House_Large)] = 30;
                Builds.ROOF[cast<int>(BuildingKind.SuburbanHouse)] = 34;
                Builds.ROOF[cast<int>(BuildingKind.Skyscraper)] = 300;
                Builds.MAT[cast<int>(BuildingKind.Skyscraper)] = cast<int>(Good.Steel);
                Builds.MATN[cast<int>(BuildingKind.Skyscraper)] = 60;

                // ---- the fourth age ----
                Builds.put(cast<int>(BuildingKind.RareElementsMine), "RareElementsMine", smith,
                           90, 70, 5, none, 0, none, 0, cast<int>(Good.RareEarth), 8, 24.0);
                Builds.SITE[cast<int>(BuildingKind.RareElementsMine)] = cast<int>(Ground.Rock);
                Builds.put(cast<int>(BuildingKind.OffshoreRig), "OffshoreRig", smith,
                           130, 90, 6, none, 0, none, 0, cast<int>(Good.Oil), 20, 22.0);
                Builds.SITE[cast<int>(BuildingKind.OffshoreRig)] = cast<int>(Ground.Coast);
                Builds.put(cast<int>(BuildingKind.SolarFarm), "SolarFarm", smith,
                           60, 80, 3, none, 0, none, 0, cast<int>(Good.Electricity), 10, 20.0);
                Builds.SITE[cast<int>(BuildingKind.SolarFarm)] = cast<int>(Ground.Grazing);
                // Fuel only. It wanted steel as well, and a recycling plant makes steel out of the
                // power a reactor gives it -- which is the third ring the suite found. The concrete
                // it is poured from is already its material cost, which is where a reactor's mass
                // honestly sits.
                Builds.put(cast<int>(BuildingKind.NuclearPlant), "NuclearPlant", smith,
                           180, 260, 8, cast<int>(Good.RareEarth), 6, none, 0,
                           cast<int>(Good.Electricity), 48, 20.0);
                Builds.put(cast<int>(BuildingKind.RecyclingPlant), "RecyclingPlant", smith,
                           70, 80, 5, cast<int>(Good.Plastic), 10, cast<int>(Good.Electricity), 4,
                           cast<int>(Good.Steel), 8, 18.0);
                Builds.put(cast<int>(BuildingKind.ChipFactory), "ChipFactory", smith,
                           140, 150, 6, cast<int>(Good.RareEarth), 4,
                           cast<int>(Good.Electricity), 10, cast<int>(Good.Chip), 10, 16.0);
                Builds.put(cast<int>(BuildingKind.ComputerFactory), "ComputerFactory", smith,
                           120, 110, 6, cast<int>(Good.Chip), 6, cast<int>(Good.Plastic), 6,
                           cast<int>(Good.Computer), 6, 18.0);
                Builds.put(cast<int>(BuildingKind.RoboticsPlant), "RoboticsPlant", smith,
                           150, 140, 7, cast<int>(Good.MachineParts), 8, cast<int>(Good.Chip), 4,
                           cast<int>(Good.Tools), 36, 14.0);
                Builds.put(cast<int>(BuildingKind.DrugFactory), "DrugFactory", vict,
                           90, 95, 5, cast<int>(Good.Chemicals), 8, cast<int>(Good.Herbs), 6,
                           cast<int>(Good.Medicine), 12, 16.0);
                Builds.ERA[cast<int>(BuildingKind.RareElementsMine)] = 4;
                Builds.ERA[cast<int>(BuildingKind.OffshoreRig)] = 4;
                Builds.ERA[cast<int>(BuildingKind.SolarFarm)] = 4;
                Builds.ERA[cast<int>(BuildingKind.NuclearPlant)] = 4;
                Builds.ERA[cast<int>(BuildingKind.RecyclingPlant)] = 4;
                Builds.ERA[cast<int>(BuildingKind.ChipFactory)] = 4;
                Builds.ERA[cast<int>(BuildingKind.ComputerFactory)] = 4;
                Builds.ERA[cast<int>(BuildingKind.RoboticsPlant)] = 4;
                Builds.ERA[cast<int>(BuildingKind.DrugFactory)] = 4;
                Builds.MAT[cast<int>(BuildingKind.NuclearPlant)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.NuclearPlant)] = 80;

                // Knowledge, at the scale the fourth age keeps it. A data centre and a campus make
                // no good and never will -- what they make is what a library makes, and this
                // catalogue has had a column for that since the first shrine.
                Builds.put(cast<int>(BuildingKind.DataCenter), "DataCenter", letter,
                           110, 120, 4, cast<int>(Good.Computer), 8,
                           cast<int>(Good.Electricity), 20, none, 0, 16.0);
                Builds.put(cast<int>(BuildingKind.SoftwareStudio), "SoftwareStudio", letter,
                           70, 60, 4, cast<int>(Good.Computer), 4, none, 0, none, 0, 18.0);
                Builds.put(cast<int>(BuildingKind.ResearchLab), "ResearchLab", letter,
                           100, 110, 5, cast<int>(Good.Chemicals), 6, none, 0, none, 0, 18.0);
                Builds.put(cast<int>(BuildingKind.TechCampus), "TechCampus", letter,
                           160, 170, 8, cast<int>(Good.Computer), 10, none, 0, none, 0, 20.0);
                Builds.put(cast<int>(BuildingKind.BroadcastTower), "BroadcastTower", cast<int>(Craft.NoCraft),
                           60, 90, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.TVStudio), "TVStudio", letter,
                           85, 80, 4, cast<int>(Good.Electricity), 8, none, 0, none, 0, 18.0);
                Builds.ERA[cast<int>(BuildingKind.DataCenter)] = 4;
                Builds.ERA[cast<int>(BuildingKind.SoftwareStudio)] = 4;
                Builds.ERA[cast<int>(BuildingKind.ResearchLab)] = 4;
                Builds.ERA[cast<int>(BuildingKind.TechCampus)] = 4;
                Builds.ERA[cast<int>(BuildingKind.BroadcastTower)] = 4;
                Builds.ERA[cast<int>(BuildingKind.TVStudio)] = 4;
                Builds.STUDY[cast<int>(BuildingKind.DataCenter)] = 320;
                Builds.STUDY[cast<int>(BuildingKind.SoftwareStudio)] = 200;
                Builds.STUDY[cast<int>(BuildingKind.ResearchLab)] = 260;
                Builds.STUDY[cast<int>(BuildingKind.TechCampus)] = 420;
                Builds.STUDY[cast<int>(BuildingKind.TVStudio)] = 150;
                Builds.PORT[cast<int>(BuildingKind.BroadcastTower)] = 2200;

                // And the last four: the airport, the tower a company sits in, the mall and the
                // stadium. A stadium is scored as care because that is what a town gets out of
                // one -- the same column an alehouse is on, four ages later.
                Builds.put(cast<int>(BuildingKind.Airport), "Airport", cast<int>(Craft.NoCraft),
                           200, 240, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.CorporateHQ), "CorporateHQ", cast<int>(Craft.NoCraft),
                           130, 180, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Mall), "Mall", cast<int>(Craft.NoCraft),
                           110, 130, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Stadium), "Stadium", cast<int>(Craft.NoCraft),
                           150, 200, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Airport)] = 4;
                Builds.ERA[cast<int>(BuildingKind.CorporateHQ)] = 4;
                Builds.ERA[cast<int>(BuildingKind.Mall)] = 4;
                Builds.ERA[cast<int>(BuildingKind.Stadium)] = 4;
                Builds.PORT[cast<int>(BuildingKind.Airport)] = 3200;
                Builds.PORT[cast<int>(BuildingKind.CorporateHQ)] = 1600;
                Builds.PORT[cast<int>(BuildingKind.Mall)] = 1300;
                Builds.CARE[cast<int>(BuildingKind.Stadium)] = 900;
                Builds.MAT[cast<int>(BuildingKind.Airport)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.Airport)] = 60;
                Builds.MAT[cast<int>(BuildingKind.CorporateHQ)] = cast<int>(Good.Steel);
                Builds.MATN[cast<int>(BuildingKind.CorporateHQ)] = 40;

                // What a tribal village can put up at all. The catalogue's Era I list is shelter,
                // gathering and the two crafts that need no metal -- so a place that has discovered
                // nothing can fire clay and smoke fish and must invent its way to everything else.
                // That is the whole point of the era gate: it makes discovery worth something.
                Builds.ERA[cast<int>(BuildingKind.TownHall)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Kiln)] = 1;
                Builds.ERA[cast<int>(BuildingKind.Smokehouse)] = 1;
                Builds.ERA[cast<int>(BuildingKind.CharcoalKiln)] = 1;

                // Housing: cheap and small at the bottom, dear and dense at the top. Each rung is
                // an era later and holds about twice the last, which is what makes a plot worth
                // rebuilding rather than a second one worth clearing.
                Builds.put(cast<int>(BuildingKind.Hut), "Hut", cast<int>(Craft.NoCraft),
                           14, 4, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.House), "House", cast<int>(Craft.NoCraft),
                           34, 16, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.Tenement), "Tenement", cast<int>(Craft.NoCraft),
                           70, 60, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.put(cast<int>(BuildingKind.ResidentialTower), "ResidentialTower",
                           cast<int>(Craft.NoCraft),
                           120, 180, 0, none, 0, none, 0, none, 0, 0.0);
                Builds.ERA[cast<int>(BuildingKind.Hut)] = 1;
                Builds.ERA[cast<int>(BuildingKind.House)] = 2;
                Builds.ERA[cast<int>(BuildingKind.Tenement)] = 3;
                Builds.ERA[cast<int>(BuildingKind.ResidentialTower)] = 4;
                Builds.ROOF[cast<int>(BuildingKind.Hut)] = 6;
                Builds.ROOF[cast<int>(BuildingKind.House)] = 14;
                // A hall holds more than a house and fewer than a tenement, which is the whole of
                // what a manor is on this ladder.
                Builds.ROOF[cast<int>(BuildingKind.Manor)] = 24;
                Builds.ROOF[cast<int>(BuildingKind.Tenement)] = 40;
                Builds.ROOF[cast<int>(BuildingKind.ResidentialTower)] = 120;
                // What a roof is MADE of, above the timber and stone every building needs.
                //
                // This is the customer the wright chain never had. With a cost of wood and stone
                // and nothing else, nothing in the world consumed a plank or a brick, so nobody
                // ever wanted one, so the sawmill and the kiln were never raised and twenty-five
                // goods in the catalogue had a lifetime total of zero. A hut is sticks and a house
                // is planks; saying so out loud is the whole fix.
                Builds.MAT[cast<int>(BuildingKind.House)] = cast<int>(Good.Plank);
                Builds.MATN[cast<int>(BuildingKind.House)] = 10;
                Builds.MAT[cast<int>(BuildingKind.Tenement)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Tenement)] = 24;
                Builds.MAT[cast<int>(BuildingKind.ResidentialTower)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.ResidentialTower)] = 40;
                // And the same for the workshops that are more than a shed. A forge wants brick to
                // hold its heat, a mill wants sawn timber to turn.
                Builds.MAT[cast<int>(BuildingKind.Windmill)] = cast<int>(Good.Plank);
                Builds.MATN[cast<int>(BuildingKind.Windmill)] = 12;
                Builds.MAT[cast<int>(BuildingKind.Smithy)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Smithy)] = 12;
                Builds.MAT[cast<int>(BuildingKind.Bakery)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Bakery)] = 10;
                Builds.MAT[cast<int>(BuildingKind.Weaver)] = cast<int>(Good.Plank);
                Builds.MATN[cast<int>(BuildingKind.Weaver)] = 8;
                Builds.MAT[cast<int>(BuildingKind.Toolsmith)] = cast<int>(Good.Plank);
                Builds.MATN[cast<int>(BuildingKind.Toolsmith)] = 8;
                Builds.MAT[cast<int>(BuildingKind.Library)] = cast<int>(Good.Brick);
                Builds.MATN[cast<int>(BuildingKind.Library)] = 20;
                Builds.MAT[cast<int>(BuildingKind.University)] = cast<int>(Good.Cement);
                Builds.MATN[cast<int>(BuildingKind.University)] = 60;

                // FOUR GOODS NOBODY CONSUMED, GIVEN THE ONE THING THAT MAKES A GOOD REAL HERE.
                //
                // Wool, Cloth, Pottery and Glass each had a workshop, a recipe and a name, and not
                // one of them was ever produced in any arc -- because worth is unmet WANT, and
                // nothing in this world wanted any of them. Nobody wore cloth, held a pot or looked
                // through a glass, so their workshops were worth nought for ever.
                //
                // A building MATERIAL is the machinery that already answers this, and it is proven:
                // it is what took brick from three hundred and sixty units in three towns to a
                // hundred and twenty thousand in fifty-one. The seeding walks the CATALOGUE and not
                // the buildings that happen to be standing, so attaching a good to a kind a village
                // could raise is enough to make it wanted, and the explosion carries the want all
                // the way down to the clay and the sand.
                //
                // Sailcloth for the yard that builds hulls -- cloth is not clothing in this world.
                Builds.MAT[cast<int>(BuildingKind.Shipwright)] = cast<int>(Good.Cloth);
                Builds.MATN[cast<int>(BuildingKind.Shipwright)] = 8;
                // Jars. You cannot put food by without something to put it in.
                Builds.MAT[cast<int>(BuildingKind.Preservery)] = cast<int>(Good.Pottery);
                Builds.MATN[cast<int>(BuildingKind.Preservery)] = 6;
                Builds.MAT[cast<int>(BuildingKind.Cannery)] = cast<int>(Good.Pottery);
                Builds.MATN[cast<int>(BuildingKind.Cannery)] = 24;
                // AND IRON, which the want machinery could not see at all.
                //
                // Measured: quarriers 3326, MINERS 710, iron ore down to nine thousand, no
                // weaponsmith, nobody armed. The job census picks a harvest class by what the place
                // is short of, so clay and sand -- newly wanted, above -- pulled the diggers off
                // the ore, and iron had nothing to pull back with.
                //
                // The reason is `makerOf`, and it is not a bug: it returns the EARLIEST maker,
                // which is right for the explosion because a village explodes toward what it can
                // already build. Tools are made by the Toolmaker out of wood and stone, so the want
                // for TOOLS -- five hundred and eighty thousand of them, the largest manufactured
                // want in the world -- explodes into timber and rock and never once into iron. The
                // Toolsmith, which makes twice as many out of plank and ingot, is never wanted and
                // so never built. Iron's only large consumer is invisible.
                //
                // Same answer as the pottery and the glass, for the same reason and by the same
                // proven machinery: give it a building that is MADE of it. A watchtower has a bell
                // and hinges; a barracks has racks and fittings. Both are era two, both are things
                // villages now actually raise, and neither had a material at all -- so nothing
                // regresses and every era-two town starts wanting ingots, which explodes down to
                // the ore and the charcoal and puts somebody back in the mine.
                Builds.MAT[cast<int>(BuildingKind.Watchtower)] = cast<int>(Good.IronIngot);
                Builds.MATN[cast<int>(BuildingKind.Watchtower)] = 6;
                // NOT THE BARRACKS, THOUGH, and the arc that tried it is why.
                //
                // Iron worked: ore from nine thousand to forty-two, ingots from nothing to thirteen
                // hundred, a third more people down the mine, and behind the smithy a forge and a
                // weaponsmith and an armoury for the first time. And the widest country in the world
                // fell from twenty-five towns to seven, because the other half of the same change
                // had quietly put every army behind a material nobody had yet. A cost on a barracks
                // is a cost on war, and war is how this world gets big.
                //
                // So the demand moves off the war path and onto the bench, where it is at least as
                // honest: a toolmaker's bench is iron-fitted, six hundred of them stand in this
                // world, and TOOLS are the largest want in it. The demand that could not reach iron
                // by travelling down the tool line now reaches it at the shop that makes them.
                // AND NOT THE TOOLMAKER EITHER. Measured: toolmakers fell from six hundred and
                // twenty-five to SIX, and the iron they were supposed to pull went the other way --
                // ore forty-two thousand back down to ten, ingots thirteen hundred to two hundred,
                // a third of the miners gone home. A material cost does not add demand to a kind
                // that cannot pay it; it deletes the kind, and with the bench went the tools.
                //
                // AND NOT THE WELL. That was the third try and the third failure, and the fallback
                // that was supposed to make it safe is exactly what did the damage: every town in
                // the world dropped to a RAIN CATCHER, six hundred and seventy-three wells became
                // NONE, and a catcher waters twenty-five people where a well waters forty. The same
                // thirst then cost half again as many buildings, which came out of the same timber
                // and stone the workshops are made of -- sawmills halved, kilns halved, charcoal
                // quartered, apothecaries down by six sevenths, and the fourth age went from
                // eighteen nations to TWO.
                //
                // So the rule wants a fourth clause. A material cost is safe on a kind that is built
                // in numbers, carries no other chain, HAS a fallback, and whose fallback is not
                // WORSE at the job -- because a cheaper rung that does less of the same work is not
                // a discount, it is a tax on everything else the town would have built. The
                // watchtower stands alone as iron's consumer: few, marginal, and nothing downstream
                // of it. Iron is thinner for that, and the world is not.
                //
                // Third material cost in one day to delete the kind it was placed on. Written down
                // in ECONOMY_MEASUREMENTS.md so it is not attempted a fourth time.
                // Light. A room people read in needs a window, and that is what glass is for.
                Builds.MAT[cast<int>(BuildingKind.Scriptorium)] = cast<int>(Good.Glass);
                Builds.MATN[cast<int>(BuildingKind.Scriptorium)] = 4;
                Builds.MAT[cast<int>(BuildingKind.School)] = cast<int>(Good.Glass);
                Builds.MATN[cast<int>(BuildingKind.School)] = 12;
            }

            public static method roof(int ord) returns int {
                return Builds.ROOF[ord];
            }

            // How much of a besieger's work this soaks up, or 0.
            public static method wall(int ord) returns int {
                return Builds.WALL[ord];
            }

            // How far over water this reaches, in cells, or 0 for everything that is not a harbour.
            public static method port(int ord) returns int {
                return Builds.PORT[ord];
            }

            // How many people this keeps in drinking water, or 0.
            public static method water(int ord) returns int {
                return Builds.WATER[ord];
            }

            // How many people this nurses back, or 0.
            public static method care(int ord) returns int {
                return Builds.CARE[ord];
            }

            // Men this kind keeps standing under arms.
            public static method keeps(int ord) returns int {
                return Builds.KEEP[ord];
            }

            // How many eyes this kind puts on the store.
            public static method watches(int ord) returns int {
                return Builds.WATCH[ord];
            }

            // The best thing a people of this era knows how to build against sickness.
            public static method bestCare(int era) returns int {
                mutable int best = cast<int>(BuildingKind.NoBuilding);
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.CARE[k] <= 0 || Builds.ERA[k] > era) {
                        continue;
                    }
                    if (best < 0 || Builds.CARE[k] > Builds.CARE[best]) {
                        best = k;
                    }
                }
                return best;
            }

            // The most people a waterworks of this era can serve. Same shape as bestRoof and the
            // same rule from the catalogue: a new era widens the menu and retires nothing, so a
            // village that never grows goes on drinking from the well it dug in the first age.
            public static method bestWater(int era, boolean onWater) returns int {
                mutable int best = cast<int>(BuildingKind.NoBuilding);
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.WATER[k] <= 0 || Builds.ERA[k] > era) {
                        continue;
                    }
                    // An aqueduct has to reach a river; a place with no water in sight cannot have
                    // one however rich it is, which is exactly the constraint that makes dry ground
                    // cost something.
                    if (!onWater && Builds.SITE[k] == cast<int>(Ground.Waterside)) {
                        continue;
                    }
                    if (best < 0 || Builds.WATER[k] > Builds.WATER[best]) {
                        best = k;
                    }
                }
                return best;
            }

            // The best wall a people of this era knows how to raise. Same shape as `bestRoof`, and
            // the same rule from the catalogue: a new era widens the menu and retires nothing.
            public static method bestWall(int era) returns int {
                mutable int best = cast<int>(BuildingKind.NoBuilding);
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.WALL[k] > 0 && Builds.ERA[k] <= era) {
                        if (best < 0 || Builds.WALL[k] > Builds.WALL[best]) {
                            best = k;
                        }
                    }
                }
                return best;
            }

            public static method houses(int ord) returns boolean {
                return Builds.ROOF[ord] > 0;
            }

            // The best housing a community of this era knows how to raise. The catalogue's rule:
            // unlocking an era widens the menu and retires nothing, so this walks up and stops.
            public static method bestRoof(int era) returns int {
                mutable int best = cast<int>(BuildingKind.NoBuilding);
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.houses(k) && Builds.ERA[k] <= era) {
                        if (best < 0 || Builds.ROOF[k] > Builds.ROOF[best]) {
                            best = k;
                        }
                    }
                }
                return best;
            }

            // Who makes this good, at this era. The cheapest one that can: a people that has both a
            // Toolmaker and a Toolsmith is asked "what would I raise to get more of these" and the
            // answer is whichever it can actually afford, which is the earlier of the two.
            //
            // -1 for anything nobody makes -- a good that comes out of the ground rather than a
            // bench, which is where the explosion of wants down a chain has to stop.
            public static method makerOf(int good, int era) returns int {
                mutable int best = 0 - 1;
                if (good <= 0) {
                    return best;
                }
                for (int k in 1..BuildingKind.count()) {
                    if (Builds.OUT[k] != good || Builds.NOUT[k] <= 0 || Builds.ERA[k] > era) {
                        continue;
                    }
                    if (best < 0 || Builds.ERA[k] < Builds.ERA[best]) {
                        best = k;
                    }
                }
                return best;
            }

            private static method put(int ord, String name, int craft, int wood, int stone,
                                      int hands, int in1, int n1, int in2, int n2,
                                      int out, int nout, float secs) returns void {
                Builds.NAME[ord] = name;
                Builds.MESH[ord] = name;
                Builds.CRAFT[ord] = craft;
                Builds.WOOD[ord] = wood;
                Builds.STONE[ord] = stone;
                Builds.HANDS[ord] = hands;
                Builds.IN1[ord] = in1;
                Builds.N1[ord] = n1;
                Builds.IN2[ord] = in2;
                Builds.N2[ord] = n2;
                Builds.OUT[ord] = out;
                Builds.NOUT[ord] = nout;
                Builds.SECS[ord] = secs;
            }

            public static method count() returns int {
                return BuildingKind.count();
            }

            public static method name(int ord) returns String {
                return Builds.NAME[ord];
            }

            // The .mesh this kind draws with, which is not always its own name.
            public static method mesh(int ord) returns String {
                return Builds.MESH[ord];
            }

            // Knowledge a staffed one of these makes in a census, or 0.
            public static method study(int ord) returns int {
                return Builds.STUDY[ord];
            }

            public static method site(int ord) returns int {
                return Builds.SITE[ord];
            }

            // Whether anybody works here at all -- goods or knowledge. A place of learning is a
            // workplace like a forge: somebody has to be standing in it, it is idle without them,
            // and it is pulled down when nobody has set foot in it for long enough.
            public static method staffed(int ord) returns boolean {
                return Builds.OUT[ord] != cast<int>(Good.Nothing) || Builds.STUDY[ord] > 0;
            }

            public static method craft(int ord) returns int {
                return Builds.CRAFT[ord];
            }

            public static method woodCost(int ord) returns int {
                return Builds.WOOD[ord];
            }

            public static method stoneCost(int ord) returns int {
                return Builds.STONE[ord];
            }

            // The third material this kind is built out of, or Nothing.
            public static method matCost(int ord) returns int {
                return Builds.MAT[ord];
            }

            public static method matCostN(int ord) returns int {
                return Builds.MATN[ord];
            }

            public static method hands(int ord) returns int {
                return Builds.HANDS[ord];
            }

            public static method in1(int ord) returns int {
                return Builds.IN1[ord];
            }

            public static method n1(int ord) returns int {
                return Builds.N1[ord];
            }

            public static method in2(int ord) returns int {
                return Builds.IN2[ord];
            }

            public static method n2(int ord) returns int {
                return Builds.N2[ord];
            }

            public static method out(int ord) returns int {
                return Builds.OUT[ord];
            }

            public static method nout(int ord) returns int {
                return Builds.NOUT[ord];
            }

            public static method secs(int ord) returns float {
                return Builds.SECS[ord];
            }

            public static method era(int ord) returns int {
                return Builds.ERA[ord];
            }

            // Whether anybody works here at all. The seat of power does not transform anything; it
            // stands in the middle of the village and says who lives there.
            public static method produces(int ord) returns boolean {
                return Builds.OUT[ord] != cast<int>(Good.Nothing);
            }
        }
    }
}
