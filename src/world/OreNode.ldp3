import System.IO.Console;
import Agents.World.EconomyNodes;
import Agents.World.NodeClass;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// Metals and energy: the miner's finds, and the reason prospecting exists -- always buryable.
// Begins at GemRock (the standing table classes gems MetalEnergy, verified at C2.1).
// index() is 27 + the local ordinal, ending the kinds at 36.
public bundle Agents {
    public namespace World {

        public enum OreNode extends EconomyNodes {
            GemRock(120, ExtractedGood.Gems.index()),
            IronVein(900, ExtractedGood.IronOre.index()),
            CopperVein(800, ExtractedGood.CopperOre.index()),
            TinVein(500, ExtractedGood.TinOre.index()),
            GoldVein(250, ExtractedGood.GoldOre.index()),
            SilverVein(350, ExtractedGood.SilverOre.index()),
            CoalSeam(1500, ExtractedGood.Coal.index()),
            SulfurVent(400, ExtractedGood.Sulfur.index()),
            OilSeep(1200, ExtractedGood.Oil.index()),
            RareEarth(200, ExtractedGood.RareEarth.index());

            private int qty;
            private int yieldIndex;

            public constructor OreNode(int qty, int yieldIndex) {
                this.qty = qty;
                this.yieldIndex = yieldIndex;
            }

            public method kind() returns NodeClass {
                return NodeClass.MetalEnergy;
            }

            public method atlas() returns NodeAtlas {
                return NodeAtlas.Nodes;
            }

            public method buryable() returns boolean {
                return true;
            }

            public method baseQty() returns int {
                return this.qty;
            }

            public method gives() returns int {
                return this.yieldIndex;
            }

            public method work() returns Harvest {
                return Harvest.Mine;
            }

            public method index() returns int {
                demand 27 == 22 + EarthNode.count()
                    otherwise "the veins begin where the ground itself ends";
                return 27 + cast<int>(this);
            }
        }
    }
}
