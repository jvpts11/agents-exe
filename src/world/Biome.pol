import System.IO.Console;
program AgentsExe;

// The 40 biomes (BIOME_CATALOG.md). A SIMPLE enum: each constant is its ordinal (0..39), which is
// exactly what the SoA Grid stores per cell (a byte) and what the classifier returns. The biome
// answers its own questions -- each method is a one-line lookup into the Biomes engine, so the
// hot paths that carry raw ordinals keep their column reads and the typed surface costs nothing.
// Groups: BIOME1 water/coast (0..9), BIOME2 humid/tropical (10..21), BIOME3 temperate/polar (22..31),
// BIOME4 elevation/specials (32..39).
public bundle Agents {
    public namespace World {

        public enum Biome {
            MarineTrench, DeepOcean, Ocean, ShallowSea, CoralReef,
            SeaIce, Lake, River, Beach, RockyShore,
            Marsh, Swamp, Bog, Mangrove, TropicalRainforest, TropSeasonalForest,
            Savanna, ThornScrub, HotDesert, MedShrubland, WarmGrassland, LaurelForest,
            DeciduousForest, TemperateRainforest, Prairie, Steppe, ColdDesert,
            Taiga, Tundra, IceCap, Glacier, Snowfield,
            Hills, Mountain, AlpineMeadow, SnowPeak, Volcanic, Badlands, SaltFlat, Oasis;

            // The water test, named ONCE. Ordinals 0..7 are the open water and rivers; Beach (8)
            // is the first ground. Half the renderer's magic `< 8` comparisons meant this.
            public method isWater() returns boolean {
                return cast<int>(this) < 8;
            }

            public method red() returns int {
                return Biomes.red(cast<int>(this));
            }

            public method green() returns int {
                return Biomes.green(cast<int>(this));
            }

            public method blue() returns int {
                return Biomes.blue(cast<int>(this));
            }

            // A body may be here at all -- on foot, or swimming. False only for open sea.
            public method walkable() returns boolean {
                return Biomes.walkable(cast<int>(this));
            }

            // Being here means swimming: drawn half under, and quicker than walking.
            public method swims() returns boolean {
                return Biomes.swims(cast<int>(this));
            }

            // A town may be founded here and a building raised here.
            public method buildable() returns boolean {
                return Biomes.buildable(cast<int>(this));
            }

            // How fast it is crossed, against ordinary ground at one.
            public method pace() returns float {
                return Biomes.pace(cast<int>(this));
            }

            // High rock and ice: passable, slow, never settled.
            public method rough() returns boolean {
                return Biomes.rough(cast<int>(this));
            }
        }
    }
}
