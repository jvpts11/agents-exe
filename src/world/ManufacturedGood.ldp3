import System.IO.Console;
import Agents.World.EconomyGoods;
import Agents.World.GoodKind;
import Agents.World.GoodTier;
program AgentsExe;

// The finished things -- what a person carries (ECONOMY.md section 6), what a place keeps
// (section 7), and what the second age makes once it has more than food and walls.
// index() is 58 + the local ordinal.
public bundle Agents {
    public namespace World {

        public enum ManufacturedGood extends EconomyGoods {
            Tools(GoodTier.Material),
            Weapon(GoodTier.Material),
            Armour(GoodTier.Material),
            Boat(GoodTier.Material),
            Furniture(GoodTier.Material),
            Jewelry(GoodTier.Material),
            Book(GoodTier.Material);

            private GoodTier grade;

            public constructor ManufacturedGood(GoodTier grade) {
                this.grade = grade;
            }

            public method kind() returns GoodKind {
                return GoodKind.Manufactured;
            }

            public method tier() returns GoodTier {
                return grade;
            }

            public method edible() returns boolean {
                return grade == GoodTier.Food;
            }

            public method index() returns int {
                demand 58 == 34 + ProcessedGood.count()
                    otherwise "the manufactured goods begin where the processed ones end";
                return 58 + cast<int>(this);
            }
        }
    }
}
