import System.IO.Console;
program AgentsExe;

// The habitat bands. A species belongs to one, and the band is a rule over biomes rather than a
// list per species: the same fact stated once, so adding a species is choosing a band rather
// than re-deciding what tundra means. Ordinals preserve the B_* ints the table always stored
// (1 temperate .. 8 shore; NoBand at 0 is the empty band NoBeast sits in). The band's biome
// members are DATA rows in the Beasts engine, baked once into the per-species LIVES masks.
public bundle Agents {
    public namespace World {

        public enum HabitatBand {
            NoBand,
            Temperate,       // deciduous, laurel, temperate rainforest, shrubland, prairie, hills
            Grassland,       // prairie, steppe, warm grass, savanna
            Cold,            // taiga, tundra, snowfield, cold desert
            Mountain,        // hills, mountain, alpine meadow
            Desert,          // hot desert, thorn scrub, badlands, oasis
            Tropical,        // tropical forests, mangrove
            Wetland,         // marsh, swamp, bog, mangrove
            Shore            // beach, rocky shore, sea ice
        }
    }
}
