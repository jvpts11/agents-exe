import System.IO.Console;

// The world as Structure-of-Arrays: parallel flat arrays over a W x H grid, indexed y*W + x. The world
// is a FINITE RECTANGLE -- both X and Y clamp at the edges (real borders, no cylinder wrap). Compact
// element types (short/byte) keep even a 2560x1080 world near ~19 MB with no GC and a layout we control
// -- the LDP3 memory showcase. Elevation is quantized to 0..10000; temp/moist to 0..100; biome is a
// Biome ordinal; flags is a bitset; flow is the downstream direction code.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class Grid {
            // Flag bits packed into the `flags` byte array.
            public static fixed int FLAG_RIVER = 1;
            public static fixed int FLAG_LAKE = 2;
            public static fixed int FLAG_VENT = 4;
            public static fixed int FLAG_ENDORHEIC = 8;
            public static fixed int FLAG_COAST = 16;
            // The buried deposit under this cell is known. Worldgen sets it on outcrops; a
            // prospecting action, once the technology exists, sets it over an area.
            public static fixed int FLAG_PROSPECTED = 32;

            private mutable int w;
            private mutable int h;
            private mutable short[] elevation;   // 0..10000 (normalized height * 10000)
            private mutable byte[] temp;          // 0..100
            private mutable byte[] moist;         // 0..100
            private mutable byte[] biome;         // Biome ordinal
            private mutable byte[] flags;         // bitset (FLAG_*)
            private mutable byte[] flow;          // downstream direction code: 0=none, else 1 + (dx+1) + (dy+1)*3
            // What lies UNDER the cell. This layer really is per-tile -- an ore body occupies the
            // ground beneath a square, and nothing about it has a position finer than that. What
            // STANDS on the ground does not: it lives in `surf` as instances with real positions,
            // because plants are spaced by distance and not by the grid.
            private mutable byte[] sub;           // buried NodeKind ordinal, 0 = none
            private mutable short[] subQty;       // units left in the buried deposit
            private mutable NodeField* surf;

            public constructor Grid(int w, int h) {
                this.w = w;
                this.h = h;
                int n = w * h;
                this.elevation = new short[n]();
                this.temp = new byte[n]();
                this.moist = new byte[n]();
                this.biome = new byte[n]();
                this.flags = new byte[n]();
                this.flow = new byte[n]();
                this.sub = new byte[n]();
                this.subQty = new short[n]();
                this.surf = new NodeField(w, h) on heap;
            }

            public destructor ~Grid() returns void {
                delete this.elevation;
                delete this.temp;
                delete this.moist;
                delete this.biome;
                delete this.flags;
                delete this.flow;
                delete this.sub;
                delete this.subQty;
                delete this.surf;
            }

            public method width() returns int {
                return this.w;
            }

            public method height() returns int {
                return this.h;
            }

            // Finite rectangular index: both X and Y clamp at the edges (no wrap -- the world has real
            // east/west borders now, not a cylinder).
            public method idx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }

            public method elevAt(int x, int y) returns int {
                return cast<int>(this.elevation[this.idx(x, y)]);
            }

            public method setElev(int x, int y, int v) returns void {
                this.elevation[this.idx(x, y)] = cast<short>(v);
            }

            public method tempAt(int x, int y) returns int {
                return cast<int>(this.temp[this.idx(x, y)]);
            }

            public method setTemp(int x, int y, int v) returns void {
                this.temp[this.idx(x, y)] = cast<byte>(v);
            }

            public method moistAt(int x, int y) returns int {
                return cast<int>(this.moist[this.idx(x, y)]);
            }

            public method setMoist(int x, int y, int v) returns void {
                this.moist[this.idx(x, y)] = cast<byte>(v);
            }

            public method biomeAt(int x, int y) returns int {
                return cast<int>(this.biome[this.idx(x, y)]);
            }

            public method setBiome(int x, int y, int ordinal) returns void {
                this.biome[this.idx(x, y)] = cast<byte>(ordinal);
            }

            public method flagsAt(int x, int y) returns int {
                return cast<int>(this.flags[this.idx(x, y)]);
            }

            public method setFlag(int x, int y, int bit) returns void {
                int i = this.idx(x, y);
                this.flags[i] = cast<byte>(cast<int>(this.flags[i]) | bit);
            }

            public method hasFlag(int x, int y, int bit) returns boolean {
                return (this.flagsAt(x, y) & bit) != 0;
            }

            public method clearFlag(int x, int y, int bit) returns void {
                int i = this.idx(x, y);
                this.flags[i] = cast<byte>(cast<int>(this.flags[i]) & ~bit);
            }

            // ---- resources: what stands on the cell, and what lies under it ----

            // Everything standing on the ground: trees, undergrowth, reeds, boulders, outcrops.
            public method surface() returns NodeField* {
                return this.surf;
            }

            public method subAt(int x, int y) returns int {
                return cast<int>(this.sub[this.idx(x, y)]) & 255;
            }

            public method subQtyAt(int x, int y) returns int {
                return cast<int>(this.subQty[this.idx(x, y)]);
            }

            public method hasSub(int x, int y) returns boolean {
                return this.subAt(x, y) != 0;
            }

            // Only a kind with a body underground may be buried -- the contract that keeps biology
            // on the surface, checked here rather than trusted at every call site.
            public method setSub(int x, int y, int kind, int qty) returns void
                requires kind > 0
                requires kind < Nodes.count()
                requires Nodes.buryable(kind)
                requires qty >= 0
                requires qty <= 32767
            {
                int i = this.idx(x, y);
                this.sub[i] = cast<byte>(kind);
                this.subQty[i] = cast<short>(qty);
            }

            // What a player may see of the buried layer: its kind once the cell is prospected, and
            // 0 -- indistinguishable from bare ground -- until then.
            public method knownSubAt(int x, int y) returns int {
                if (!this.hasFlag(x, y, Grid.FLAG_PROSPECTED)) {
                    return 0;
                }
                return this.subAt(x, y);
            }

            // The prospecting action itself, for whatever technology comes to gate it. It reveals
            // what is ALREADY THERE -- worldgen placed every deposit, and prospecting only stops
            // them being invisible. Returns how many buried cells became known, which is the
            // feedback the action wants: prospecting bare ground tells you something too.
            public method prospect(int cx, int cy, int radius) returns int
                requires radius >= 0
            {
                mutable int revealed = 0;
                mutable int y = cy - radius;
                while (y <= cy + radius) {
                    if (y >= 0 && y < this.h) {
                        mutable int x = cx - radius;
                        while (x <= cx + radius) {
                            if (x >= 0 && x < this.w) {
                                int dx = x - cx;
                                int dy = y - cy;
                                if (dx * dx + dy * dy <= radius * radius) {
                                    if (!this.hasFlag(x, y, Grid.FLAG_PROSPECTED)) {
                                        this.setFlag(x, y, Grid.FLAG_PROSPECTED);
                                        if (this.hasSub(x, y)) {
                                            revealed = revealed + 1;
                                        }
                                    }
                                }
                            }
                            x = x + 1;
                        }
                    }
                    y = y + 1;
                }
                return revealed;
            }

            // Downstream flow direction as a per-cell code (0 = no flow). dx/dy are each in {-1,0,1}.
            public method setFlowDir(int x, int y, int dx, int dy) returns void {
                this.flow[this.idx(x, y)] = cast<byte>((dy + 1) * 3 + (dx + 1) + 1);
            }

            public method flowCode(int x, int y) returns int {
                return cast<int>(this.flow[this.idx(x, y)]) & 255;
            }

            public method hasFlow(int x, int y) returns boolean {
                return this.flowCode(x, y) != 0;
            }

            public method flowDx(int x, int y) returns int {
                int c = this.flowCode(x, y);
                if (c == 0) {
                    return 0;
                }
                return (c - 1) % 3 - 1;
            }

            public method flowDy(int x, int y) returns int {
                int c = this.flowCode(x, y);
                if (c == 0) {
                    return 0;
                }
                return (c - 1) / 3 - 1;
            }
        }
    }
}
