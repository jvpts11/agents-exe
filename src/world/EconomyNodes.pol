import System.IO.Console;
import Agents.World.EconomyGoods;
import Agents.World.NodeClass;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
program AgentsExe;

// The resource-node contract (relayout design section 4a): a methods-only catalog, implemented
// by the four node families. It declares no required values -- no byCatalog, no duplicated
// member lists. "Any node kind" is a value of this type; the world's storage holds the dense
// global index (index()), and the tick reads the engine's derived columns.
//
// gives() ANSWERS THE GOOD, and used to answer its global index instead -- because an enum
// constructor argument was once coerced by LLVM shape, so a catalog-typed one arrived as raw bits
// (ledger RL-6). That is fixed: arguments are coerced to what the callee DECLARED, and the
// compiler carries a regression test named for this exact shape. The workaround outlived its cause
// by a release, which is what to look for whenever a comment blames the compiler: go and check.
//
// The dense engine still stores the INDEX, because that is what the engine is for. `Nodes` asks
// each constant once at class load and calls `index()` there -- one place that converts, instead
// of thirteen constants each spelling `.index()` in their own declaration.
public bundle Agents {
    public namespace World {

        public catalog EconomyNodes {
            method kind() returns NodeClass;
            method atlas() returns NodeAtlas;
            method buryable() returns boolean;
            method baseQty() returns int;
            method gives() returns EconomyGoods;
            method work() returns Harvest;
            method index() returns int;
        }
    }
}
