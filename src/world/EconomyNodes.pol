import System.IO.Console;
import Agents.World.NodeClass;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
program AgentsExe;

// The resource-node contract (relayout design section 4a): a methods-only catalog, implemented
// by the four node families. It declares no required values -- no byCatalog, no duplicated
// member lists. "Any node kind" is a value of this type; the world's storage holds the dense
// global index (index()), and the tick reads the engine's derived columns.
//
// gives() answers the GOODS GLOBAL INDEX rather than the goods catalog type: an enum
// constructor argument is coerced by LLVM type today, so a catalog-typed argument would arrive
// as pointer bits (ledger RL-6, to be fixed in ldp3c); the index is the seam the engine wants
// anyway, and the constants spell it `ExtractedGood.Wood.index()`, which cannot drift.
public bundle Agents {
    public namespace World {

        public catalog EconomyNodes {
            method kind() returns NodeClass;
            method atlas() returns NodeAtlas;
            method buryable() returns boolean;
            method baseQty() returns int;
            method gives() returns int;
            method work() returns Harvest;
            method index() returns int;
        }
    }
}
