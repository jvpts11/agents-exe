import System.IO.Console;
program AgentsExe;

// The animals, and what each one is. Seventeen species, all of them modelled and exported.
//
// Fauna is NOT people with different art, and it does not share their table or their pool. An agent
// has a trade, a home, a store to carry things to and a community that decides things for it; a
// beast has a herd, a range and a diet. Everything they appear to have in common -- a position, an
// age, a death -- is common to everything alive, and copying the agent table to get it would have
// dragged twenty-five fields of village life along with it.
//
// A species answers its own questions -- one-line lookups into the Beasts engine, so the fauna
// tick keeps its column reads (fauna layout section 3: read in the tick -> parallel arrays) and
// the typed surface costs nothing.
public bundle Agents {
    public namespace World {

        public enum Species {
            NoBeast,
            // grazers and browsers -- what a hunter is after
            Deer, Boar, Rabbit, Bison, Reindeer, Ibex, Camel, Antelope, Mammoth,
            Sheep, Cattle, Horse, Seal,
            // and what is after them
            Wolf, Bear, Lion, Crocodile;

            public method diet() returns Diet {
                return cast<Diet>(Beasts.diet(cast<int>(this)));
            }

            public method band() returns HabitatBand {
                return cast<HabitatBand>(Beasts.band(cast<int>(this)));
            }

            public method herd() returns int {
                return Beasts.herd(cast<int>(this));
            }

            public method meat() returns int {
                return Beasts.meat(cast<int>(this));
            }

            public method hide() returns int {
                return Beasts.hide(cast<int>(this));
            }

            public method pace() returns float {
                return Beasts.pace(cast<int>(this));
            }

            public method life() returns float {
                return Beasts.life(cast<int>(this));
            }

            public method shy() returns float {
                return Beasts.shy(cast<int>(this));
            }

            public method isPrey() returns boolean {
                return Beasts.isPrey(cast<int>(this));
            }

            public method livesIn(Biome b) returns boolean {
                return Beasts.livesIn(cast<int>(this), cast<int>(b));
            }
        }
    }
}
