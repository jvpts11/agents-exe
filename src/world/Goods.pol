import System.IO.Console;
import Agents.World.EconomyGoods;
import Agents.World.GoodId;
import Agents.World.GoodKind;
import Agents.World.GoodTier;
import Agents.World.ExtractedGood;
import Agents.World.ProcessedGood;
import Agents.World.ManufacturedGood;
import Agents.World.IndustrialGood;
program AgentsExe;

// The dense engine the tick reads, DERIVED at class load from the four family enums -- declared
// once on the families, compiled here into the same columns (same values, same layout) the old
// hand-written rows produced, which the captured-table test proves byte for byte. Global index 0
// is Nothing -- outside every family, so a zeroed array is an empty warehouse -- and each family
// occupies its contiguous range: Extracted 1-33, Processed 34-57, Manufactured 58-64,
// Industrial 65-74 (the relayout design's locked map).
public bundle Agents {
    public namespace World {

        public class Goods {
            // The "no good" global index. Index 0 belongs to no family on purpose.
            public static fixed GoodId NOTHING = cast<GoodId>(0);

            private static mutable String[] NAME;
            private static mutable int[] TIER;

            onClassLoad {
                int n = Goods.count();
                Goods.NAME = new String[n]();
                Goods.TIER = new int[n]();
                Goods.NAME[0] = "Nothing";
                Goods.TIER[0] = cast<int>(GoodTier.None);
                for (ExtractedGood g in ExtractedGood.values()) {
                    int at = cast<int>(g.index());
                    Goods.NAME[at] = g.name();
                    Goods.TIER[at] = cast<int>(g.tier());
                }
                for (ProcessedGood g in ProcessedGood.values()) {
                    int at = cast<int>(g.index());
                    Goods.NAME[at] = g.name();
                    Goods.TIER[at] = cast<int>(g.tier());
                }
                for (ManufacturedGood g in ManufacturedGood.values()) {
                    int at = cast<int>(g.index());
                    Goods.NAME[at] = g.name();
                    Goods.TIER[at] = cast<int>(g.tier());
                }
                for (IndustrialGood g in IndustrialGood.values()) {
                    int at = cast<int>(g.index());
                    Goods.NAME[at] = g.name();
                    Goods.TIER[at] = cast<int>(g.tier());
                }
            }

            // Nothing plus the four families. Derived, so a good added to a family widens every
            // plane and table sized from this the moment it exists.
            public static method count() returns int {
                return 1 + ExtractedGood.count() + ProcessedGood.count() +
                       ManufacturedGood.count() + IndustrialGood.count();
            }

            public static method name(GoodId ord) returns String {
                return Goods.NAME[cast<int>(ord)];
            }

            public static method tier(GoodId ord) returns int {
                return Goods.TIER[cast<int>(ord)];
            }

            public static method edible(GoodId ord) returns boolean {
                return Goods.TIER[cast<int>(ord)] == cast<int>(GoodTier.Food);
            }
        }
    }
}
