import System.IO.Console;
import Agents.World.EconomyGoods;
import Agents.World.GoodKind;
import Agents.World.GoodTier;
program AgentsExe;

// The goods a building makes of the extracted ones -- ECONOMY.md sections 2 and 3 in the
// document's order: the refined materials, then what a kitchen or a mill makes of the food.
// index() is 34 + the local ordinal (the family begins where ExtractedGood ends).
public bundle Agents {
    public namespace World {

        public enum ProcessedGood extends EconomyGoods {
            Plank(GoodTier.Material),
            Charcoal(GoodTier.Material),
            Brick(GoodTier.Material),
            Pottery(GoodTier.Material),
            Glass(GoodTier.Material),
            Paper(GoodTier.Material),
            Leather(GoodTier.Material),
            Cloth(GoodTier.Material),
            Rope(GoodTier.Material),
            Cement(GoodTier.Material),
            IronIngot(GoodTier.Material),
            CopperIngot(GoodTier.Material),
            BronzeIngot(GoodTier.Material),
            Steel(GoodTier.Material),
            GoldBar(GoodTier.Material),
            SilverBar(GoodTier.Material),
            Flour(GoodTier.Material),
            Bread(GoodTier.Food),
            Beer(GoodTier.Food),
            Wine(GoodTier.Food),
            Cheese(GoodTier.Food),
            DriedMeat(GoodTier.Food),
            CannedFood(GoodTier.Food),
            Preserves(GoodTier.Food);

            private GoodTier grade;

            public constructor ProcessedGood(GoodTier grade) {
                this.grade = grade;
            }

            public method kind() returns GoodKind {
                return GoodKind.Processed;
            }

            public method tier() returns GoodTier {
                return grade;
            }

            public method edible() returns boolean {
                return grade == GoodTier.Food;
            }

            public method index() returns int {
                // Held to the family before it while the program is BUILT. A good added to the
                // extracted family would otherwise leave this offset behind, and the two families
                // would write over each other's rows in the goods table with nothing to say so.
                demand 34 == 1 + ExtractedGood.count()
                    otherwise "the processed goods begin where the extracted ones end";
                return 34 + cast<int>(this);
            }
        }
    }
}
