import System.IO.Console;
program AgentsExe;

// The six things a cell can be, packed into one byte, and the only place that packing is known.
//
// They were public constants and every reader wrote `hasFlag(x, y, Grid.FLAG_RIVER)` -- which is
// the encoding asked to do the job of a vocabulary. Thirty-three call sites had to know that a
// river is bit 0, and each of them was one typo away from asking about a lake instead: the bits
// are consecutive powers of two, so a wrong constant is a plausible question with a wrong answer.
//
// The predicates take a FETCHED byte rather than a cell, because the classifier reads the flags
// once per cell and asks three questions of them -- two and a half million times a world. A method
// per (x, y) would be three more array reads for nothing. The Grid offers the per-cell spellings
// on top of these, for the readers that have a cell and not a byte.
public bundle Agents {
    public namespace World {

        public class CellFlags {
            private static fixed int RIVER = 1;
            private static fixed int LAKE = 2;
            private static fixed int VENT = 4;
            // A basin with no outlet to the sea. WRITTEN BY NOTHING TODAY -- the classifier reads
            // it and worldgen never sets it, so no salt flat has ever been made this way. That is a
            // standing fact about the model, not a bug to be fixed in passing: giving it a setter
            // here would be inventing a mechanic. It keeps its bit and its reader until somebody
            // decides what fills it.
            private static fixed int ENDORHEIC = 8;
            private static fixed int COAST = 16;
            // The buried deposit under this cell is known. Worldgen sets it on outcrops; a
            // prospecting action, once the technology exists, sets it over an area.
            private static fixed int PROSPECTED = 32;

            public static method hasRiver(int f) returns boolean {
                return (f & CellFlags.RIVER) != 0;
            }

            public static method isLake(int f) returns boolean {
                return (f & CellFlags.LAKE) != 0;
            }

            public static method hasVent(int f) returns boolean {
                return (f & CellFlags.VENT) != 0;
            }

            public static method isEndorheic(int f) returns boolean {
                return (f & CellFlags.ENDORHEIC) != 0;
            }

            public static method isCoast(int f) returns boolean {
                return (f & CellFlags.COAST) != 0;
            }

            public static method isProspected(int f) returns boolean {
                return (f & CellFlags.PROSPECTED) != 0;
            }

            public static method withRiver(int f) returns int {
                return f | CellFlags.RIVER;
            }

            public static method withLake(int f) returns int {
                return f | CellFlags.LAKE;
            }

            public static method withVent(int f) returns int {
                return f | CellFlags.VENT;
            }

            public static method withCoast(int f) returns int {
                return f | CellFlags.COAST;
            }

            public static method withProspected(int f) returns int {
                return f | CellFlags.PROSPECTED;
            }
        }
    }
}
