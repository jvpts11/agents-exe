import System.IO.Console;
program AgentsExe;

// What a world can be asked about its continents. Named as an interface because the Grid does not
// answer it itself -- it holds a `Landmasses` and forwards, and this is the contract that says
// which questions travel.
public bundle Agents {
    public namespace World {

        public interface Massed {
            // Flood the blocks that hold walkable ground. Called once, after the terrain is final
            // and before anybody is placed on it.
            method labelMasses() returns void;

            // Which landmass this cell's block belongs to, or -1 off the map and on water.
            method massAt(int x, int y) returns int;

            method massCount() returns int;

            // Say that this mass was seeded with people on it.
            method markMassPeopled(int x, int y) returns void;

            // Ground nobody started on: reaching it later is colonisation.
            method massBeganEmpty(int x, int y) returns boolean;
        }
    }
}
