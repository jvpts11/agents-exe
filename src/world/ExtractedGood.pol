import System.IO.Console;
import Agents.World.EconomyGoods;
import Agents.World.GoodId;
import Agents.World.GoodKind;
import Agents.World.GoodTier;
program AgentsExe;

// The goods that come straight off a node or an animal -- ECONOMY.md section 1, in the
// document's order, which is also the order the global index depends on: index() is
// 1 + the local ordinal, reproducing the numbering the stored world has always used
// (Nothing sits at 0, outside every family). Each constant carries its own tier; the
// dense table the tick reads is DERIVED from these rows at class load (Goods.ldp3).
public bundle Agents {
    public namespace World {

        public enum ExtractedGood extends EconomyGoods {
            Wood(GoodTier.Raw),
            Stone(GoodTier.Raw),
            Marble(GoodTier.Raw),
            Clay(GoodTier.Raw),
            Sand(GoodTier.Raw),
            Coal(GoodTier.Raw),
            Salt(GoodTier.Raw),
            Sulfur(GoodTier.Raw),
            Gems(GoodTier.Raw),
            Oil(GoodTier.Raw),
            RareEarth(GoodTier.Raw),
            IronOre(GoodTier.Raw),
            CopperOre(GoodTier.Raw),
            TinOre(GoodTier.Raw),
            GoldOre(GoodTier.Raw),
            SilverOre(GoodTier.Raw),
            Grain(GoodTier.Food),
            Berries(GoodTier.Food),
            Fruit(GoodTier.Food),
            Grapes(GoodTier.Food),
            Vegetables(GoodTier.Food),
            Mushrooms(GoodTier.Food),
            Herbs(GoodTier.Raw),
            Fish(GoodTier.Food),
            RawMeat(GoodTier.Food),
            Milk(GoodTier.Food),
            Honey(GoodTier.Food),
            Egg(GoodTier.Food),
            Cotton(GoodTier.Raw),
            Flax(GoodTier.Raw),
            Wool(GoodTier.Raw),
            Hide(GoodTier.Raw),
            Reeds(GoodTier.Raw);

            private GoodTier grade;

            public constructor ExtractedGood(GoodTier grade) {
                this.grade = grade;
            }

            public method kind() returns GoodKind {
                return GoodKind.Extracted;
            }

            public method tier() returns GoodTier {
                return grade;
            }

            public method edible() returns boolean {
                return grade == GoodTier.Food;
            }

            public method index() returns GoodId {
                // The one offset in the goods space that is not another family's size: index 0 is
                // Nothing, which belongs to no family, and the extracted goods start after it.
                demand cast<int>(Goods.NOTHING) == 0
                    otherwise "an empty shelf reads as no good at all";
                return cast<GoodId>(1 + cast<int>(this));
            }
        }
    }
}
