import System.IO.Console;
program AgentsExe;

// One tectonic plate: where it was seeded, what it is made of, what it grew into, and which way it
// is drifting.
//
// TEN PARALLEL ARRAYS, all indexed by the same plate id at sixty-nine sites. Ten arrays are ten
// chances to reach into one of them with a neighbour's id and no way to notice: a plate's area read
// against another's centroid is a plausible number, and the continent it builds looks like land.
// They also had to be allocated, freed and reallocated together in four places, which is four
// chances for one of them to be a different length from the other nine.
//
// A value struct, so the plates stay one flat allocation with the elements inline. At most
// forty-eight of them on a coarse grid: this is a small array walked by index, and it is never
// copied.
public bundle Agents {
    public namespace World {

        public struct Plate {
            // Where the plate was seeded, in coarse coordinates.
            public mutable int sx;
            public mutable int sy;
            // Which PlateKind, as its ordinal -- the value the partition publishes for Tectonics
            // and the ore pass to read.
            public mutable int kind;
            // Continent id, or -1. A continent is whatever stayed above water, so this is decided
            // after the flood rather than chosen.
            public mutable int continent;
            // Coarse cells the plate ended up owning.
            public mutable int area;
            // 1 when the plate touches the map border. The world is a finite rectangle, so an edge
            // plate is a different thing from an interior one.
            public mutable int edge;
            // Centroid in coarse coordinates, accumulated in scan order and then divided by the
            // area. THE ORDER OF THAT SUM IS LOAD-BEARING: float addition does not associate, and
            // the centroid decides which plates are near enough to interact.
            public mutable float cx;
            public mutable float cy;
            // Plate motion, a unit vector. Tectonics reads it to decide what happens at each
            // margin.
            public mutable float mx;
            public mutable float my;
        }
    }
}
