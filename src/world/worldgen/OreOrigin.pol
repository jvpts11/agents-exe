import System.IO.Console;
program AgentsExe;

// Where a deposit came from.
//
// Ore is placed by GEOLOGY and not by biome, and this is the axis that says so. Tectonics already
// knows which boundaries collided, which subducted, which plates are old stable cratons and where
// it put the volcanic arcs -- and every bit of that used to be thrown away the moment the relief
// had been written into the elevation. It is the right input: a world with no volcanic arc then
// simply has no porphyry copper, which is correct, and a mountain belt carries the metals that
// mountain belts carry.
//
// Ordinals are used as table rows, so the order is the table's.
public bundle Agents {
    public namespace World {

        public enum OreOrigin {
            None,
            Orogenic,       // continent met continent: the metals of a mountain belt
            Porphyry,       // a volcanic arc over a subducting slab
            Basin,          // low, flat, thick sediment
            Craton,         // old stable crust, deep roots
            Highland        // any high ground: building stone
        }
    }
}
