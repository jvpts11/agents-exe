import System.IO.Console;

// The deformation stage. Landmass built the relief and flooded it; every mountain, trench, rift and
// volcanic arc in the world is put here, and ONLY here.
//
// That division is deliberate. Landmass caps ordinary land at 0.62 by construction, so nothing it
// does can enter the 0.63 mountain band -- which means mountain coverage can never become a side
// effect of tuning a noise amplitude somewhere else. It is set by one number in this file, closed
// against a measurement.
//
// Relief follows PLATE BOUNDARIES, so a range is linear because the boundary it sits on is a long
// sinuous curve, not because linearity was imposed on a blob. What happens at a boundary is decided
// by physics: who is converging with whom, and whether the crust meeting there is continental or
// oceanic.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class Tectonics implements ElevationPass {
            // Ordinary land ends at 0.62 and the mountain family owns 0.63..1.0, so this is the
            // whole headroom an uplift of 1.0 is allowed to use.
            public static float BAND = 0.42;

            private mutable int seed;
            private mutable int pw;
            private mutable int ph;
            private mutable int nPlates;

            private mutable float[] bdist;      // coarse: distance to the nearest plate boundary
            private mutable int[] bpair;        // coarse: which boundary that is, or -1
            private mutable float[] pcx;        // plate centroids, coarse coords
            private mutable float[] pcy;
            // The dense pair matrix: kind, strength and which plate rides over, per pair.
            private mutable PlatePair[] pairs;
            private mutable float[] def;        // full res: + uplift, - depression, before scaling
            private mutable byte[] arcMask;     // full res: 1 on an island arc, which MAY breach
            private mutable float mountainShare;

            // The physics is evaluated on the COARSE grid, where every discrete decision -- which
            // boundary, which plate, which side of it -- is exact for the cell that owns it. Only
            // these smooth scalars are carried up to full resolution.
            private mutable float[] cdef;       // deformation
            private mutable float[] carc;       // volcanic-arc strength
            private mutable float[] cisl;       // 1 on the overriding side of an island arc
            private mutable float sDef;         // sampleAt results
            private mutable float sArc;
            private mutable float sIsl;

            public constructor Tectonics(int seed) {
                this.seed = seed;
                pw = 1;
                ph = 1;
                nPlates = 0;
                mountainShare = 0.16;
                bdist = new float[1]();
                bpair = new int[1]();
                pcx = new float[1]();
                pcy = new float[1]();
                pairs = new PlatePair[1]();
                def = new float[1]();
                arcMask = new byte[1]();
                cdef = new float[1]();
                carc = new float[1]();
                cisl = new float[1]();
                sDef = 0.0;
                sArc = 0.0;
                sIsl = 0.0;
            }

            public destructor ~Tectonics() returns void {
                delete bdist;
                delete bpair;
                delete pcx;
                delete pcy;
                delete pairs;
                delete def;
                delete arcMask;
                delete cdef;
                delete carc;
                delete cisl;
            }

            public override method name() returns String {
                return "tectonics";
            }

            public override method apply(WorldField* f) returns void {
                pw = f.pw;
                ph = f.ph;
                nPlates = f.nPlates;
                if (nPlates <= 0) {
                    return;
                }
                int pn = pw * ph;
                delete bdist;
                delete bpair;
                delete pcx;
                delete pcy;
                delete pairs;
                delete def;
                delete arcMask;
                delete cdef;
                delete carc;
                delete cisl;
                bdist = new float[pn]();
                bpair = new int[pn]();
                pcx = new float[nPlates]();
                pcy = new float[nPlates]();
                int np2 = nPlates * nPlates;
                pairs = new PlatePair[np2]();
                def = new float[f.w * f.h]();
                arcMask = new byte[f.w * f.h]();
                cdef = new float[pn]();
                carc = new float[pn]();
                cisl = new float[pn]();

                centroids(f);
                findBoundaries(f);
                classifyBoundaries(f);
                buildCoarseDeformation(f);
                buildDeformation(f);
                fitAndApply(f);
                return;
            }

            private method centroids(WorldField* f) returns void {
                int[] cnt = new int[nPlates]();
                mutable int i = 0;
                while (i < nPlates) {
                    pcx[i] = 0.0;
                    pcy[i] = 0.0;
                    i = i + 1;
                }
                int pn = pw * ph;
                i = 0;
                while (i < pn) {
                    int p = f.plate[i];
                    pcx[p] = pcx[p] + cast<float>(i % pw);
                    pcy[p] = pcy[p] + cast<float>(i / pw);
                    cnt[p] = cnt[p] + 1;
                    i = i + 1;
                }
                i = 0;
                while (i < nPlates) {
                    if (cnt[i] > 0) {
                        pcx[i] = pcx[i] / cast<float>(cnt[i]);
                        pcy[i] = pcy[i] / cast<float>(cnt[i]);
                    }
                    i = i + 1;
                }
                delete cnt;
                return;
            }

            private method pairOf(int a, int b) returns int {
                if (a < b) {
                    return a * nPlates + b;
                }
                return b * nPlates + a;
            }

            // Distance to the nearest plate boundary, carrying WHICH boundary it is. Two-pass
            // chamfer, propagating the label along with the distance -- the label crossing to the
            // far side of a boundary is harmless and in fact wanted: both sides of a subduction zone
            // need to know they are on it, one to raise a range and the other to sink a trench.
            private method findBoundaries(WorldField* f) returns void {
                int pn = pw * ph;
                mutable int i = 0;
                while (i < pn) {
                    int x = i % pw;
                    int y = i / pw;
                    int self = f.plate[i];
                    mutable int other = 0 - 1;
                    if (x > 0 && f.plate[i - 1] != self) {
                        other = f.plate[i - 1];
                    }
                    if (x + 1 < pw && f.plate[i + 1] != self) {
                        other = f.plate[i + 1];
                    }
                    if (y > 0 && f.plate[i - pw] != self) {
                        other = f.plate[i - pw];
                    }
                    if (y + 1 < ph && f.plate[i + pw] != self) {
                        other = f.plate[i + pw];
                    }
                    if (other >= 0) {
                        bdist[i] = 0.0;
                        bpair[i] = pairOf(self, other);
                    } else {
                        bdist[i] = 1000000000.0;
                        bpair[i] = 0 - 1;
                    }
                    i = i + 1;
                }
                float dOrt = 1.0;
                float dDia = 1.41421356;
                mutable int y2 = 0;
                while (y2 < ph) {
                    mutable int x2 = 0;
                    while (x2 < pw) {
                        int c = y2 * pw + x2;
                        if (x2 > 0) {
                            relax(c, c - 1, dOrt);
                        }
                        if (y2 > 0) {
                            relax(c, c - pw, dOrt);
                        }
                        if (x2 > 0 && y2 > 0) {
                            relax(c, c - pw - 1, dDia);
                        }
                        if (x2 + 1 < pw && y2 > 0) {
                            relax(c, c - pw + 1, dDia);
                        }
                        x2 = x2 + 1;
                    }
                    y2 = y2 + 1;
                }
                y2 = ph - 1;
                while (y2 >= 0) {
                    mutable int x2 = pw - 1;
                    while (x2 >= 0) {
                        int c = y2 * pw + x2;
                        if (x2 + 1 < pw) {
                            relax(c, c + 1, dOrt);
                        }
                        if (y2 + 1 < ph) {
                            relax(c, c + pw, dOrt);
                        }
                        if (x2 + 1 < pw && y2 + 1 < ph) {
                            relax(c, c + pw + 1, dDia);
                        }
                        if (x2 > 0 && y2 + 1 < ph) {
                            relax(c, c + pw - 1, dDia);
                        }
                        x2 = x2 - 1;
                    }
                    y2 = y2 - 1;
                }
                return;
            }

            // `step` and `from` are both LDP3 keywords -- hence the names.
            private method relax(int c, int src, float span) returns void {
                float cand = bdist[src] + span;
                if (cand < bdist[c]) {
                    bdist[c] = cand;
                    bpair[c] = bpair[src];
                }
                return;
            }

            // Convergence is the relative drift of the two plates ALONG the line joining them:
            // positive means they are closing. Everything a boundary does follows from its sign,
            // its magnitude, and whether the crust on each side is continental or oceanic.
            private method classifyBoundaries(WorldField* f) returns void {
                mutable int a = 0;
                while (a < nPlates) {
                    mutable int b = a + 1;
                    while (b < nPlates) {
                        int p = a * nPlates + b;
                        float lx = pcx[b] - pcx[a];
                        float ly = pcy[b] - pcy[a];
                        float len = LandMath.sqrt(lx * lx + ly * ly);
                        if (len > 0.001) {
                            float ux = lx / len;
                            float uy = ly / len;
                            float conv = (f.plates[a].mx - f.plates[b].mx) * ux
                                       + (f.plates[a].my - f.plates[b].my) * uy;
                            // island crust is thin: for boundary physics it behaves like ocean floor,
                            // which is why this asks for Craton and not "not Oceanic"
                            boolean contA = f.plates[a].kind == cast<int>(PlateKind.Craton);
                            boolean contB = f.plates[b].kind == cast<int>(PlateKind.Craton);
                            mutable float s = conv;
                            if (s < 0.0) {
                                s = 0.0 - s;
                            }
                            if (s > 1.0) {
                                s = 1.0;
                            }
                            pairs[p].strength = s;
                            pairs[p].over = a;
                            if (conv > 0.15) {
                                if (contA && contB) {
                                    pairs[p].kind = cast<int>(BoundaryKind.Collision);
                                } else if (contA || contB) {
                                    pairs[p].kind = cast<int>(BoundaryKind.Subduction);
                                    // the continental plate always rides over the oceanic one
                                    if (contB) {
                                        pairs[p].over = b;
                                    }
                                } else {
                                    pairs[p].kind = cast<int>(BoundaryKind.IslandArc);
                                }
                            } else if (conv < 0.0 - 0.15) {
                                if (contA || contB) {
                                    pairs[p].kind = cast<int>(BoundaryKind.Rift);
                                } else {
                                    pairs[p].kind = cast<int>(BoundaryKind.Ridge);
                                }
                            } else {
                                pairs[p].kind = cast<int>(BoundaryKind.None);
                            }
                        }
                        b = b + 1;
                    }
                    a = a + 1;
                }
                return;
            }

            // exp(-t*t): the crest profile. mu is how far from the boundary the feature sits, sigma
            // how wide it is -- both in COARSE cells, so a sigma of 3 is about 24 map cells and a
            // range rises over tens of cells rather than ramping across a continent.
            private method crest(float d, float mu, float sigma) returns float {
                float t = (d - mu) / sigma;
                return LandMath.exp(0.0 - t * t);
            }

            private method distAt(float nx, float ny) returns float {
                mutable float gx = nx * cast<float>(pw) - 0.5;
                mutable float gy = ny * cast<float>(ph) - 0.5;
                if (gx < 0.0) {
                    gx = 0.0;
                }
                if (gy < 0.0) {
                    gy = 0.0;
                }
                mutable int x0 = cast<int>(gx);
                mutable int y0 = cast<int>(gy);
                if (x0 > pw - 2) {
                    x0 = pw - 2;
                }
                if (y0 > ph - 2) {
                    y0 = ph - 2;
                }
                if (x0 < 0) {
                    x0 = 0;
                }
                if (y0 < 0) {
                    y0 = 0;
                }
                float tx = gx - cast<float>(x0);
                float ty = gy - cast<float>(y0);
                int c = y0 * pw + x0;
                float p00 = bdist[c];
                float p10 = bdist[c + 1];
                float p01 = bdist[c + pw];
                float p11 = bdist[c + pw + 1];
                float ab = p00 + (p10 - p00) * tx;
                float cd = p01 + (p11 - p01) * tx;
                return ab + (cd - ab) * ty;
            }

            // The physics, evaluated ONCE PER COARSE CELL. Every discrete decision lives here --
            // which boundary, which plate, which side of it -- because here the cell owns them
            // exactly. Reading those decisions at full resolution by NEAREST NEIGHBOUR is what put
            // perfectly straight, axis-aligned edges all over the world: a volcanic arc, an island
            // and a mountain belt each ended dead on a coarse-cell edge instead of on its own
            // contour. Nothing discrete crosses to full resolution now -- only smooth scalars do.
            private method buildCoarseDeformation(WorldField* f) returns void {
                int pn = pw * ph;
                mutable int i = 0;
                while (i < pn) {
                    cdef[i] = 0.0;
                    carc[i] = 0.0;
                    cisl[i] = 0.0;
                    int pair = bpair[i];
                    if (pair >= 0) {
                        int kind = pairs[pair].kind;
                        if (kind != cast<int>(BoundaryKind.None)) {
                            float nx = cast<float>(i % pw) / cast<float>(pw);
                            float ny = cast<float>(i / pw) / cast<float>(ph);
                            // Noise on the DISTANCE: it makes a range wander, fork and vary in
                            // height along its length instead of tracing the boundary like a drawn
                            // line, and it cannot pull the range off the boundary the way warping
                            // the sampled position would.
                            float wob = LandMath.fbm(seed ^ WorldSalts.BOUNDARY_WOBBLE, nx, ny, 17, 4) - 0.5;
                            float d = bdist[i] + wob * 3.4;
                            int self = f.plate[i];
                            float str = pairs[pair].strength;
                            mutable float v = 0.0;
                            mutable float arc = 0.0;
                            if (kind == cast<int>(BoundaryKind.Collision)) {
                                // two continents pile into each other: one broad high belt
                                // straddling the suture, no trench and no volcanoes
                                v = str * crest(d, 0.0, 6.5);
                            } else if (kind == cast<int>(BoundaryKind.Subduction)) {
                                if (self == pairs[pair].over) {
                                    // overriding continent: coastal range, then the volcanic arc
                                    // further inland -- the Andes and their volcanoes
                                    v = str * (crest(d, 2.0, 3.2) * 0.95);
                                    arc = str * crest(d, 8.5, 2.4);
                                    v = v + arc * 0.70;
                                } else {
                                    // the descending slab drags the sea floor down
                                    v = 0.0 - str * crest(d, 3.0, 2.2);
                                }
                            } else if (kind == cast<int>(BoundaryKind.IslandArc)) {
                                if (self == pairs[pair].over) {
                                    // BEADS, not a crest. An arc that breaches along its whole
                                    // length is a causeway: it reaches a continent at each end and
                                    // welds them, and the biggest landmass went from 24% to 38% of
                                    // all land. Real arcs are a line of separate cones.
                                    float bead = LandMath.fbm(seed ^ WorldSalts.ARC_BEADS, nx, ny, 44, 3);
                                    v = str * crest(d, 3.5, 1.9) * (0.0 - 0.15 + 1.55 * bead);
                                    arc = v;
                                    cisl[i] = 1.0;
                                } else {
                                    v = 0.0 - str * crest(d, 3.0, 2.0);
                                }
                            } else if (kind == cast<int>(BoundaryKind.Rift)) {
                                // the floor drops between two raised shoulders
                                v = str * crest(d, 5.0, 2.2) * 0.55
                                    - str * crest(d, 0.0, 2.0) * 0.70;
                            } else {
                                v = str * crest(d, 0.0, 4.5) * 0.55;
                            }
                            cdef[i] = v;
                            carc[i] = arc;
                        }
                    }
                    i = i + 1;
                }
                publishOrigin(f);
                return;
            }

            // Hand the boundary classification on instead of dropping it. Everything here is about
            // to be discarded once the relief has been written into the elevation, and it is the
            // only record the world keeps of WHY a piece of crust is the way it is -- which is
            // exactly what deciding where the ore goes needs.
            private method publishOrigin(WorldField* f) returns void {
                int pn = pw * ph;
                delete f.margins;
                f.margins = new Margin[pn]();
                for (int i in 0..pn) {
                    int pair = bpair[i];
                    if (pair < 0) {
                        continue;
                    }
                    f.margins[i].origin = cast<byte>(pairs[pair].kind);
                    // bdist is in coarse cells along the cost graph; a boundary's influence on the
                    // rock reaches about as far as its relief does.
                    mutable float near = 1.0 - bdist[i] / 12.0;
                    if (near < 0.0) {
                        near = 0.0;
                    }
                    if (near > 1.0) {
                        near = 1.0;
                    }
                    f.margins[i].near = near;
                }
                return;
            }

            // Bilinear read of the three coarse fields at one position, weights computed once.
            private method sampleAt(float nx, float ny) returns void {
                mutable float gx = nx * cast<float>(pw) - 0.5;
                mutable float gy = ny * cast<float>(ph) - 0.5;
                if (gx < 0.0) {
                    gx = 0.0;
                }
                if (gy < 0.0) {
                    gy = 0.0;
                }
                mutable int x0 = cast<int>(gx);
                mutable int y0 = cast<int>(gy);
                if (x0 > pw - 2) {
                    x0 = pw - 2;
                }
                if (y0 > ph - 2) {
                    y0 = ph - 2;
                }
                if (x0 < 0) {
                    x0 = 0;
                }
                if (y0 < 0) {
                    y0 = 0;
                }
                float tx = gx - cast<float>(x0);
                float ty = gy - cast<float>(y0);
                int c = y0 * pw + x0;
                int c2 = c + pw;
                float a0 = cdef[c] + (cdef[c + 1] - cdef[c]) * tx;
                float a1 = cdef[c2] + (cdef[c2 + 1] - cdef[c2]) * tx;
                sDef = a0 + (a1 - a0) * ty;
                float b0 = carc[c] + (carc[c + 1] - carc[c]) * tx;
                float b1 = carc[c2] + (carc[c2 + 1] - carc[c2]) * tx;
                sArc = b0 + (b1 - b0) * ty;
                float e0 = cisl[c] + (cisl[c + 1] - cisl[c]) * tx;
                float e1 = cisl[c2] + (cisl[c2 + 1] - cisl[c2]) * tx;
                sIsl = e0 + (e1 - e0) * ty;
                return;
            }

            private method buildDeformation(WorldField* f) returns void {
                mutable int y = 0;
                while (y < f.h) {
                    float ny = cast<float>(y) / cast<float>(f.h);
                    mutable int x = 0;
                    while (x < f.w) {
                        int cell = y * f.w + x;
                        float nx = cast<float>(x) / cast<float>(f.w);
                        sampleAt(nx, ny);
                        mutable float v = sDef;
                        if (v != 0.0) {
                            // Full-resolution grain, MULTIPLIED in so it vanishes wherever the
                            // deformation does. Added in, it would put relief where the physics
                            // says there is none, and draw edges of its own.
                            float grain = LandMath.fbm(seed ^ WorldSalts.CRUST_GRAIN, nx, ny, 60, 3);
                            v = v * (0.86 + 0.28 * grain);
                            // Sharpen the uplift: the crest keeps its value while the flanks shrink.
                            // Coverage and peak height are different questions -- the fit loop sets
                            // the amplitude from the SHARE of land in the band, so a profile with fat
                            // flanks reaches its share while the amplitude is still small and the
                            // highest summit stops at 0.86, below the snow line, with no SnowPeak
                            // anywhere. Thinning the flanks forces a larger amplitude for the share.
                            if (v > 0.0) {
                                v = 0.68 * v + 0.32 * v * v * v;
                            }
                            def[cell] = v;
                        }
                        if (sIsl > 0.5) {
                            arcMask[cell] = cast<byte>(1);
                        }
                        if (sArc > 0.55) {
                            f.vent[cell] = cast<byte>(1);
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                return;
            }

            // Choose the uplift amplitude so the mountain family covers its share of land, then
            // apply once. This is solved, not searched: a land cell crosses 0.63 exactly when
            // amp >= (0.63 - e) / (BAND * def), so histogramming that per-cell threshold gives the
            // whole curve of share-against-amplitude in a single pass.
            private method fitAndApply(WorldField* f) returns void {
                int n = f.w * f.h;
                int bins = 2048;
                float span = 4.0;
                int[] hist = new int[bins]();
                mutable int land = 0;
                mutable float bestTop = 0.0;
                mutable float bestBase = 0.0;
                mutable float bestGain = 1.0;
                mutable int i = 0;
                while (i < n) {
                    if (f.eb[i] >= f.sea) {
                        land = land + 1;
                        if (def[i] > 0.0001) {
                            float need = (Contour.HIGHLAND - f.eb[i]) / (Tectonics.BAND * def[i]);
                            if (need < span) {
                                mutable int b = cast<int>(need / span * cast<float>(bins));
                                if (b < 0) {
                                    b = 0;
                                }
                                hist[b] = hist[b] + 1;
                            }
                            // remember the cell that will end up highest, so the amplitude can be
                            // held to a floor that guarantees the band is actually reached
                            float gain = def[i] * Tectonics.BAND;
                            if (f.eb[i] + gain > bestTop) {
                                bestTop = f.eb[i] + gain;
                                bestBase = f.eb[i];
                                bestGain = gain;
                            }
                        }
                    }
                    i = i + 1;
                }
                int want = cast<int>(cast<float>(land) * mountainShare);
                mutable int acc = 0;
                mutable int bin = 0;
                while (bin < bins && acc < want) {
                    acc = acc + hist[bin];
                    bin = bin + 1;
                }
                delete hist;
                mutable float amp = span * cast<float>(bin) / cast<float>(bins);
                // Coverage alone does not guarantee height. The share can be reached while the
                // tallest summit is still at 0.89 -- under the snow line, so no SnowPeak and no
                // Glacier exist anywhere. Hold the amplitude to whatever puts the highest cell at
                // 0.94; the share band is wide enough to absorb the difference.
                if (bestGain > 0.0001) {
                    float needPeak = (0.94 - bestBase) / bestGain;
                    if (needPeak > amp) {
                        amp = needPeak;
                    }
                }
                if (amp < 0.15) {
                    amp = 0.15;
                }
                if (amp > span) {
                    amp = span;
                }

                i = 0;
                while (i < n) {
                    float v = def[i];
                    if (v != 0.0) {
                        mutable float e = f.eb[i];
                        if (e >= f.sea) {
                            if (v > 0.0) {
                                e = e + v * amp * Tectonics.BAND;
                                if (e > 1.0) {
                                    e = 1.0;
                                }
                            } else {
                                // A rift floor sinks but stays land: dropping it under the sea would
                                // cut a continent in half after the flood already fixed the coasts.
                                //
                                // SQUEEZE toward the waterline; never clamp at it. The clamp that
                                // used to be here gave every cell the rift dug deep enough exactly
                                // the same elevation -- a dead flat plateau at 0.442, eight cells
                                // running, with the ocean at 0.31 beside it. That cliff IS the
                                // abrupt stop: the coast became the edge of a SATURATED REGION
                                // instead of a contour, and the edge of a saturated region is always
                                // a wall, and a wall drawn by a threshold is straight. Scaling the
                                // headroom approaches the waterline without reaching it, and never
                                // flattens, so the coast goes back to being a contour.
                                float floorZ = f.sea + 0.012;
                                mutable float shrink = 1.0 + v * 0.55;
                                if (shrink < 0.15) {
                                    shrink = 0.15;
                                }
                                e = floorZ + (e - floorZ) * shrink;
                            }
                        } else {
                            if (v < 0.0) {
                                // Trench: the only thing in the world allowed under 0.22. It
                                // approaches its floor rather than piling onto it -- a clamped floor
                                // is a flat pan whose rim is the same kind of wall -- and it FADES
                                // OUT at the shoreline.
                                //
                                // That fade is the actual "the island stops out of nowhere". With a
                                // trench running close inshore the deepening applied right up to the
                                // waterline, so the shelf was eaten and land at 0.441 sat directly
                                // against ocean at 0.32: a cliff of an eighth of the whole elevation
                                // range in a single cell, with no beach and no shallows. Real
                                // trenches leave a shelf, however narrow.
                                mutable float shelf = (f.sea - e) / 0.06;
                                if (shelf > 1.0) {
                                    shelf = 1.0;
                                }
                                if (shelf < 0.0) {
                                    shelf = 0.0;
                                }
                                e = 0.04 + (e - 0.04) / (1.0 - v * 0.55 * shelf);
                            } else if (cast<int>(arcMask[i]) != 0) {
                                // An island ARC is allowed to breach. This is the whole point of the
                                // feature and it was silently disabled: every rise in the ocean was
                                // clamped under the sea level, so ocean-ocean convergence built a
                                // submarine ridge and no island ever appeared. Five of twelve seeds
                                // were rejected for having too few islands because of it.
                                // a fraction of the land band: only cones standing on the shallower
                                // sea floor break the surface, which is what keeps them islands
                                e = e + v * amp * 0.16;
                                if (e > 1.0) {
                                    e = 1.0;
                                }
                            } else {
                                // A mid-ocean ridge rises but never breaks the surface -- again by
                                // closing the gap to the waterline rather than clamping onto it,
                                // which would pave a flat shelf at exactly sea-0.006 and put a
                                // straight rim around it.
                                float lid = f.sea - 0.006;
                                e = lid - (lid - e) / (1.0 + v * amp * 0.55);
                            }
                        }
                        f.eb[i] = e;
                    }
                    i = i + 1;
                }
                return;
            }

        }
    }
}
