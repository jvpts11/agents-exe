import System.IO.Console;

// Everything that grows or lies on the ground and is not a tree: berries, mushrooms, herbs, the
// fibre and grain plants, reeds, cactus, loose stone, and the fishing spots out on the water.
//
// It runs AFTER Flora and reads what Flora wrote, because where undergrowth lives is defined by the
// trees: at the forest EDGE and in its CLEARINGS, not under a closed canopy and not out in the open.
// A cell that holds no tree but has trees around it is exactly that place, and it costs one
// neighbourhood count to find.
//
// Reeds, fishing spots and boulders are not undergrowth and do not follow that rule -- they key off
// fresh water, off shallow water near a shore, and off exposed rock. They are here rather than in
// Flora because they are the same KIND of thing: one surface node per cell, placed by a gate and a
// draw, and splitting them across two files would only mean two copies of the machinery.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class Groundcover implements WorldPass {
            private mutable int seed;
            private mutable int w;
            private mutable int h;
            // undergrowth: up to three species per biome and its peak share, per mille
            private mutable int[] ua;
            private mutable int[] ub;
            private mutable int[] uc;
            private mutable int[] ucov;
            // loose surface stone per biome, per mille
            private mutable int[] bcov;
            private mutable int[] dFresh;   // rings to river or lake
            private mutable int[] dLand;    // rings to land, for the fishing spots
            private mutable byte[] trees;   // trees per cell, from the field Flora just filled

            public constructor Groundcover(int seed) {
                this.seed = seed;
                this.w = 1;
                this.h = 1;
                this.ua = new int[Biomes.COUNT]();
                this.ub = new int[Biomes.COUNT]();
                this.uc = new int[Biomes.COUNT]();
                this.ucov = new int[Biomes.COUNT]();
                this.bcov = new int[Biomes.COUNT]();
                this.dFresh = new int[1]();
                this.dLand = new int[1]();
                this.trees = new byte[1]();
                this.buildTables();
            }

            public destructor ~Groundcover() returns void {
                delete this.ua;
                delete this.ub;
                delete this.uc;
                delete this.ucov;
                delete this.bcov;
                delete this.dFresh;
                delete this.dLand;
                delete this.trees;
            }

            public override method name() returns String {
                return "groundcover";
            }

            private method setUnder(int biome, int a, int b, int c, int cov) returns void
                requires biome >= 0
                requires biome < Biomes.COUNT
                requires cov >= 0
                requires cov <= 1000
            {
                this.ua[biome] = a;
                this.ub[biome] = b;
                this.uc[biome] = c;
                this.ucov[biome] = cov;
            }

            private method setStone(int biome, int cov) returns void
                requires biome >= 0
                requires biome < Biomes.COUNT
                requires cov >= 0
                requires cov <= 1000
            {
                this.bcov[biome] = cov;
            }

            private method buildTables() returns void {
                int berry = FloraNode.BerryBush.index();
                int shroom = FloraNode.MushroomPatch.index();
                int herb = FloraNode.HerbPlant.index();
                int wheat = FloraNode.WheatField.index();
                int vine = FloraNode.WildVine.index();
                int cotton = FloraNode.CottonPlant.index();
                int flax = FloraNode.FlaxPlant.index();
                int reeds = FloraNode.Reeds.index();
                int cactus = FloraNode.Cactus.index();
                int none = 0;
                // wetlands: reeds and fungus
                this.setUnder(10, reeds, herb, none, 260);              // Marsh
                this.setUnder(11, shroom, reeds, herb, 170);            // Swamp
                this.setUnder(12, shroom, reeds, none, 140);            // Bog
                this.setUnder(13, reeds, none, none, 90);               // Mangrove
                // warm forest: vines and fruit
                this.setUnder(14, vine, shroom, herb, 190);             // TropicalRainforest
                this.setUnder(15, vine, berry, herb, 140);              // TropSeasonalForest
                // warm open: fibre
                this.setUnder(16, cotton, herb, none, 70);              // Savanna
                this.setUnder(17, cactus, cotton, none, 80);            // ThornScrub
                this.setUnder(18, cactus, none, none, 30);              // HotDesert
                this.setUnder(19, herb, flax, berry, 130);              // MedShrubland
                this.setUnder(20, wheat, flax, herb, 110);              // WarmGrassland
                // temperate and boreal forest: berries and fungus
                this.setUnder(21, berry, herb, shroom, 160);            // LaurelForest
                this.setUnder(22, berry, shroom, herb, 190);            // DeciduousForest
                this.setUnder(23, shroom, berry, herb, 200);            // TemperateRainforest
                this.setUnder(27, berry, shroom, none, 170);            // Taiga
                // temperate open: wild grain and flax
                this.setUnder(24, wheat, flax, herb, 120);              // Prairie
                this.setUnder(25, wheat, flax, none, 80);               // Steppe
                this.setUnder(26, herb, none, none, 20);                // ColdDesert
                this.setUnder(28, berry, herb, none, 70);               // Tundra
                // high ground and the oasis
                this.setUnder(32, berry, herb, flax, 100);              // Hills
                this.setUnder(34, herb, berry, none, 150);              // AlpineMeadow
                this.setUnder(37, cactus, none, none, 25);              // Badlands
                this.setUnder(39, herb, wheat, none, 220);              // Oasis
                // loose stone, wherever rock is at or near the surface
                this.setStone(9, 90);                                   // RockyShore
                this.setStone(26, 30);                                  // ColdDesert
                this.setStone(31, 15);                                  // Snowfield
                this.setStone(32, 70);                                  // Hills
                this.setStone(33, 120);                                 // Mountain
                this.setStone(34, 45);                                  // AlpineMeadow
                this.setStone(36, 60);                                  // Volcanic
                this.setStone(37, 130);                                 // Badlands
                return;
            }

            private method idx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }

            private method dilate(int[] d, int rings) returns void {
                mutable int p = 0;
                while (p < rings) {
                    mutable int y = 0;
                    while (y < this.h) {
                        mutable int x = 0;
                        while (x < this.w) {
                            int i = y * this.w + x;
                            mutable int m = d[i];
                            int a = d[this.idx(x - 1, y)] + 1;
                            int b = d[this.idx(x + 1, y)] + 1;
                            int c = d[this.idx(x, y - 1)] + 1;
                            int e = d[this.idx(x, y + 1)] + 1;
                            if (a < m) {
                                m = a;
                            }
                            if (b < m) {
                                m = b;
                            }
                            if (c < m) {
                                m = c;
                            }
                            if (e < m) {
                                m = e;
                            }
                            d[i] = m;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    p = p + 1;
                }
                return;
            }

            private method distanceFields(Grid* g) returns void {
                int n = this.w * this.h;
                for (int i in 0..n) {
                    int x = i % this.w;
                    int y = i / this.w;
                    // A SaltFlat is a lake that dried up -- classify turns a basin in a bone-dry
                    // climate into one -- and it keeps the lake flag. Reading the flag alone put
                    // reed beds all over the salt pans, which is where reeds most obviously cannot
                    // grow. The biome has the last word on whether there is any water left.
                    boolean fresh = (g.hasFlag(x, y, Grid.FLAG_RIVER) || g.hasFlag(x, y, Grid.FLAG_LAKE))
                                    && g.biomeAt(x, y) != 38;
                    if (fresh) {
                        this.dFresh[i] = 0;
                    } else {
                        this.dFresh[i] = 9999;
                    }
                    if (g.biomeAt(x, y) >= 8) {
                        this.dLand[i] = 0;
                    } else {
                        this.dLand[i] = 9999;
                    }
                }
                this.dilate(this.dFresh, 3);
                this.dilate(this.dLand, 4);
                return;
            }

            // How many trees stand in the surrounding tiles, read off a count built once. Zero
            // means open country; a high count means closed canopy; in between is the forest edge
            // and the rim of a clearing, which is where almost everything that is not a tree grows.
            private method treesNear(int x, int y) returns int {
                mutable int c = 0;
                mutable int dy = 0 - 2;
                while (dy <= 2) {
                    mutable int dx = 0 - 2;
                    while (dx <= 2) {
                        c = c + (cast<int>(this.trees[this.idx(x + dx, y + dy)]) & 255);
                        dx = dx + 1;
                    }
                    dy = dy + 1;
                }
                return c;
            }

            // Scatter `ipc` plants of one kind through a tile, stratified so they keep apart. The
            // same reasoning as the trees: what a tile holds is a consequence of the spacing, never
            // a cap of one.
            private method scatter(NodeField* field, int x, int y, int kind, float ipc,
                                   int salt) returns int {
                mutable int k = 1;
                while (k * k < ipc && k < 3) {
                    k = k + 1;
                }
                float p = ipc / cast<float>(k * k);
                float span = 1.0 / cast<float>(k);
                mutable int made = 0;
                for (int sy in 0..k) {
                    for (int sx in 0..k) {
                        int hx = x * 4 + sx;
                        int hy = y * 4 + sy;
                        if (LandMath.hash01(this.seed ^ salt, hx, hy) >= p) {
                            continue;
                        }
                        float jx = LandMath.hash01(this.seed ^ 0x2AB1, hx, hy);
                        float jy = LandMath.hash01(this.seed ^ 0x5CD3, hx, hy);
                        float fx = cast<float>(x) + (cast<float>(sx) + 0.15 + jx * 0.70) * span;
                        float fy = cast<float>(y) + (cast<float>(sy) + 0.15 + jy * 0.70) * span;
                        float vary = LandMath.hash01(this.seed ^ 0x1E93, hx, hy);
                        int qty = Nodes.baseQty(kind) * (70 + cast<int>(vary * 60.0)) / 100;
                        field.add(fx, fy, kind, qty);
                        made = made + 1;
                    }
                }
                return made;
            }

            public override method apply(Grid* g, WorldField* f) returns void {
                this.w = g.width();
                this.h = g.height();
                int n = this.w * this.h;
                delete this.dFresh;
                delete this.dLand;
                this.dFresh = new int[n]();
                this.dLand = new int[n]();
                this.distanceFields(g);
                NodeField* field = g.surface();
                delete this.trees;
                this.trees = new byte[n]();
                field.cellCounts(this.trees, true);
                int reeds = FloraNode.Reeds.index();
                int boulder = PropNode.Boulder.index();
                int fishing = FloraNode.FishingSpot.index();
                int claypit = EarthNode.ClayPit.index();
                int sandbank = EarthNode.SandBank.index();
                int saltdep = EarthNode.SaltDeposit.index();
                mutable int nUnder = 0;
                mutable int nReed = 0;
                mutable int nStone = 0;
                mutable int nFish = 0;
                mutable int nClay = 0;
                mutable int nSand = 0;
                mutable int nSalt = 0;
                for (int y in 0..this.h) {
                    float ny = cast<float>(y) / cast<float>(this.h);
                    for (int x in 0..this.w) {
                        int i = y * this.w + x;
                        int biome = g.biomeAt(x, y);
                        float nx = cast<float>(x) / cast<float>(this.w);
                        // One shared patchiness field for everything here, so a berry thicket, a
                        // reed bed and a boulder field are all PATCHES rather than an even sprinkle
                        // -- the same reason the trees needed a field, at a smaller scale.
                        float patch = LandMath.fbm(this.seed ^ 0x9A17, nx, ny, 60, 3);
                        if (biome < 8) {
                            // OPEN WATER: fishing spots, in the shallows within reach of a shore.
                            // A spot no boat can be launched to is not a resource.
                            if (biome == 3 || biome == 4 || biome == 6) {
                                if (this.dLand[i] <= 4 && patch > 0.52) {
                                    nFish = nFish + this.scatter(field, x, y, fishing, 0.030, 0x4C0F);
                                }
                            }
                            continue;
                        }
                        // REEDS first: the margin of fresh water beats whatever else the biome grows
                        // there, which is what a reed bed looks like from the bank.
                        // ... and a salt pan beside a real lake is still a salt pan.
                        if (this.dFresh[i] <= 1 && Biomes.walkable(biome) && biome != 38) {
                            nReed = nReed + this.scatter(field, x, y, reeds,
                                                         0.62 * (0.4 + patch), 0x7701);
                            // AND THE BANK ITSELF, which is clay.
                            //
                            // Clay was a buried deposit and nothing else, so the only clay in the
                            // world sat under a basin waiting for somebody to prospect it: eight
                            // towns out of a hundred and ninety-five ever held any, four thousand
                            // units in twenty generations, six kilns standing. Brick is fired clay
                            // and a smithy costs twelve brick to raise, so the entire metal half of
                            // the catalogue -- smithy, weaponsmith, armoury, and every rail that
                            // needed a sleeper -- was downstream of a good the map never placed.
                            //
                            // A riverbank is not a seam. It is the commonest clay there is, it is
                            // exactly where the reed bed already tells you the ground is soft, and
                            // this world has tens of thousands of cells of it. Sparse, because a
                            // pit holds seven hundred units and a bank is not a quarry.
                            nClay = nClay + this.scatter(field, x, y, claypit,
                                                         0.020 * (0.5 + patch), 0x0C1A);
                            continue;
                        }
                        // THE SHORE, which is sand -- and the desert, which is more of it.
                        //
                        // Sand had the same shape of hole as clay: one buried origin, nine towns
                        // holding any, and Glass -- the one thing made out of it -- never made
                        // anywhere in twenty generations. A beach is sand you can pick up.
                        if (biome == 8) {
                            nSand = nSand + this.scatter(field, x, y, sandbank,
                                                         0.030 * (0.5 + patch), 0x5A0D);
                        } else if (biome == 18 || biome == 26) {
                            nSand = nSand + this.scatter(field, x, y, sandbank,
                                                         0.008 * (0.4 + patch), 0x5A0D);
                        } else if (biome == 38) {
                            // A salt flat is a flat of SALT, and salt was never produced anywhere in
                            // the world by anybody -- the one place it obviously lies was doing
                            // nothing but being a colour on the map.
                            nSalt = nSalt + this.scatter(field, x, y, saltdep,
                                                         0.050 * (0.5 + patch), 0x5A17);
                        }
                        // LOOSE STONE, wherever rock reaches the surface.
                        int bc = this.bcov[biome];
                        if (bc > 0) {
                            float bd = cast<float>(bc) / 1000.0 * (0.35 + 1.3 * patch);
                            nStone = nStone + this.scatter(field, x, y, boulder, bd, 0x3355);
                        }
                        // UNDERGROWTH. It is likeliest at the forest EDGE: a couple of trees nearby
                        // is a clearing rim, a tile packed with them is closed canopy where little
                        // reaches the floor, and none at all is open country. The tile no longer
                        // has to be empty for any of this -- a fern under a tree is exactly where a
                        // fern belongs, and refusing it was an artefact of one slot per tile.
                        int uc2 = this.ucov[biome];
                        if (uc2 == 0) {
                            continue;
                        }
                        int near = this.treesNear(x, y);
                        mutable float shade = 0.55;
                        if (near > 0) {
                            shade = 1.9;
                        }
                        if (near > 14) {
                            shade = 0.9;                    // closed canopy: the floor goes quiet
                        }
                        float ud = cast<float>(uc2) / 1000.0 * (0.30 + 1.4 * patch) * shade;
                        float zone = LandMath.fbm(this.seed ^ 0x71D3, nx, ny, 14, 3);
                        float pick = LandMath.hash01(this.seed ^ 0x1E93, x * 11 + 2, y * 3 + 9);
                        mutable int kind = this.ua[biome];
                        if (pick > 0.88 && this.uc[biome] != 0) {
                            kind = this.uc[biome];
                        } else if (zone > 0.50 && this.ub[biome] != 0) {
                            kind = this.ub[biome];
                        }
                        if (kind == 0) {
                            continue;
                        }
                        nUnder = nUnder + this.scatter(field, x, y, kind, ud, 0x4C0F);
                    }
                }
                System.IO.Console.println($"groundcover: {nUnder} undergrowth, {nReed} reeds, {nStone} stone, {nFish} fishing");
                System.IO.Console.println($"  the ground itself: {nClay} clay banks, {nSand} sand, {nSalt} salt");
                return;
            }
        }
    }
}
