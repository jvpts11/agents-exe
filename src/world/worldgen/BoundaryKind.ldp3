import System.IO.Console;
program AgentsExe;

// What is happening where two plates meet. The coarse origin plane stores the ordinal, so these
// ARE the stored values -- and they outlive the relief they built, because the ore pass places
// metal by the boundary that made the rock rather than by the biome that ended up on top of it.
public bundle Agents {
    public namespace World {

        public enum BoundaryKind {
            None,
            Collision,      // continent meets continent: Himalaya
            Subduction,     // ocean dives under continent: Andes + trench
            IslandArc,      // ocean meets ocean: arc + trench
            Rift,           // continent pulls apart: valley with shoulders
            Ridge           // sea floor spreads: mid-ocean ridge
        }
    }
}
