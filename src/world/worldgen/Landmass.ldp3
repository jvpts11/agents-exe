import System.IO.Console;
import Agents.World.Grid;

// The silhouette stage. A landmass is the union of elliptical lobes planted along a short, gently
// turning skeleton -- non-radial BY CONSTRUCTION.
//
// Why that matters: three previous generations of this worldgen failed the same way. All of them
// described a continent as centre + radius + noise, and a noisy circle still reads as a circle;
// the domain warp strong enough to disguise it is also strong enough to smear neighbouring
// continents into one connected web. Lobes on a skeleton produce gulfs where two lobes meet and
// peninsulas where one juts out, without any warp of the sampled position.
program AgentsExe;

public bundle Agents {
    public namespace World {

        // One blob of a landmass: an ellipse with its own size, flattening and rotation, plus the
        // vector helpers the skeleton walk needs. (There is deliberately no Vec2 here: the project
        // already has Agents.Math.Vec2, and declaring a second type of that name in another
        // namespace corrupts symbol resolution -- see the compiler bug filed for it.)
        public struct Lobe {
            public mutable float cx;
            public mutable float cy;
            public mutable float rx;
            public mutable float ry;
            public mutable float ang;

            public constructor Lobe(float cx, float cy, float rx, float ry, float ang) {
                this.cx = cx;
                this.cy = cy;
                this.rx = rx;
                this.ry = ry;
                this.ang = ang;
            }

            // Normalized elliptical distance from this lobe to a point: 1.0 is the lobe's rim.
            public method distanceTo(float px, float py, float aspect) returns float {
                float dx = (px - this.cx) * aspect;
                float dy = py - this.cy;
                float ca = LandMath.cos(this.ang);
                float sa = LandMath.sin(this.ang);
                float ux = (dx * ca + dy * sa) / this.rx;
                float uy = (dy * ca - dx * sa) / this.ry;
                return LandMath.sqrt(ux * ux + uy * uy);
            }
        }

        // Scalar maths the worldgen stages share. Kept as statics so Landmass and Tectonics use
        // ONE implementation: two divergent noise functions would silently desynchronise the
        // coastline from the climate that is sampled over it.
        public class LandMath {
            public static method sqrt(float v) returns float {
                if (v <= 0.0) {
                    return 0.0;
                }
                mutable float g = v;
                mutable int i = 0;
                while (i < 16) {
                    g = 0.5 * (g + v / g);
                    i = i + 1;
                }
                return g;
            }

            public static method sin(float x) returns float {
                mutable float t = x;
                float pi = 3.14159265;
                float two = 2.0 * pi;
                while (t > pi) {
                    t = t - two;
                }
                while (t < 0.0 - pi) {
                    t = t + two;
                }
                float t2 = t * t;
                return t - t * t2 / 6.0 + t * t2 * t2 / 120.0 - t * t2 * t2 * t2 / 5040.0;
            }

            public static method cos(float x) returns float {
                return LandMath.sin(x + 1.5707963);
            }

            // exp by range reduction: exp(x) = exp(x/64)^64, with a 4-term Taylor on the small
            // argument. Accurate enough for the crest profile and cheap.
            public static method exp(float x) returns float {
                mutable boolean negative = false;
                mutable float v = x;
                if (v < 0.0) {
                    v = 0.0 - v;
                    negative = true;
                }
                if (v > 40.0) {
                    v = 40.0;
                }
                float t = v / 64.0;
                mutable float e = 1.0 + t + t * t * 0.5 + t * t * t / 6.0 + t * t * t * t / 24.0;
                mutable int i = 0;
                while (i < 6) {
                    e = e * e;
                    i = i + 1;
                }
                if (negative) {
                    return 1.0 / e;
                }
                return e;
            }

            public static method hash01(int seed, int xi, int yi) returns float {
                mutable int n = xi * 374761393;
                n = n + yi * 668265263;
                n = n + seed * 1442695041;
                n = n ^ (n >> 13);
                n = n * 1274126177;
                n = n ^ (n >> 16);
                int m = n & 2147483647;
                return cast<float>(m) / 2147483647.0;
            }

            private static method smooth(float t) returns float {
                return t * t * (3.0 - 2.0 * t);
            }

            public static method vnoise(int seed, float fx, float fy, int period) returns float {
                mutable int p = period;
                if (p < 1) {
                    p = 1;
                }
                int x0 = cast<int>(fx);
                int y0 = cast<int>(fy);
                float tx = fx - cast<float>(x0);
                float ty = fy - cast<float>(y0);
                int x0w = x0 % p;
                int x1w = (x0 + 1) % p;
                float sx = LandMath.smooth(tx);
                float sy = LandMath.smooth(ty);
                float a = LandMath.hash01(seed, x0w, y0);
                float b = LandMath.hash01(seed, x1w, y0);
                float c = LandMath.hash01(seed, x0w, y0 + 1);
                float d = LandMath.hash01(seed, x1w, y0 + 1);
                float ab = a + (b - a) * sx;
                float cd = c + (d - c) * sx;
                return ab + (cd - ab) * sy;
            }

            // multi-octave value noise over normalized coordinates
            public static method fbm(int seed, float nx, float ny, int cells, int octaves) returns float {
                mutable float sum = 0.0;
                mutable float amp = 1.0;
                mutable float tot = 0.0;
                mutable int c = cells;
                mutable int o = 0;
                while (o < octaves) {
                    float v = LandMath.vnoise(seed, nx * cast<float>(c), ny * cast<float>(c), c);
                    sum = sum + v * amp;
                    tot = tot + amp;
                    amp = amp * 0.5;
                    c = c * 2;
                    o = o + 1;
                }
                return sum / tot;
            }
        }

        // NOTE: this was a `record ContinentProfile(int lobes, float wander, ...)`. A record with
        // any float field cannot be declared at all right now -- its synthesized toString() calls
        // .toString() on every field and float has none (compiler bug filed). The profile
        // therefore lives in the parallel arrays inside Landmass, which is what the per-cell hot
        // path wants anyway; restore the record once float gains a string conversion.

        // The land mask has exactly one owner at a time: Landmass builds it, Tectonics consumes it.
        // `movable` makes the compiler enforce that -- a second reader is a compile error.
        public movable class LandMask {
            private mutable byte[] cells;
            private mutable int n;
            private mutable int live;

            public constructor LandMask(int n) {
                this.n = n;
                this.live = 0;
                this.cells = new byte[n]();
            }

            public destructor ~LandMask() returns void {
                delete this.cells;
            }

            public method at(int i) returns boolean {
                return cast<int>(this.cells[i]) != 0;
            }

            public method set(int i) returns void {
                if (cast<int>(this.cells[i]) == 0) {
                    this.cells[i] = cast<byte>(1);
                    this.live = this.live + 1;
                }
                return;
            }

            public method count() returns int {
                return this.live;
            }
        }

        public class Landmass implements ElevationPass {
            private mutable int seed;
            private mutable int nmass;        // continents + islands
            private mutable int nCont;        // how many of them are continents (islands follow)
            private mutable int cellCols;     // continent cell grid
            private mutable int cellRows;
            // skeleton lobes, packed: [lobeStart[i] .. lobeStart[i]+lobeCount[i]) belong to mass i
            private mutable Lobe[] lobe;
            private mutable int[] lobeStart;
            private mutable int[] lobeCount;
            private mutable float[] cxs;        // skeleton origin, normalized
            private mutable float[] cys;
            private mutable float[] rad;        // base radius, in height-fractions
            private mutable float[] bbx0;       // per-landmass bounding box, normalized
            private mutable float[] bby0;
            private mutable float[] bbx1;
            private mutable float[] bby1;
            private mutable LandMask mask;
            // profile fields, one entry per landmass
            private mutable int[] pLobes;
            private mutable float[] pWander;
            private mutable float[] pTurn;
            private mutable float[] pAspect;
            private mutable float[] pCoastAmp;
            private mutable float[] pCoastFreq;
            private mutable float[] pShare;

            public constructor Landmass(int seed) {
                this.seed = seed;
                this.nmass = 0;
                this.nCont = 0;
                this.cellCols = 1;
                this.cellRows = 1;
                this.lobe = new Lobe[1]();
                this.lobeStart = new int[1]();
                this.lobeCount = new int[1]();
                this.cxs = new float[1]();
                this.cys = new float[1]();
                this.rad = new float[1]();
                this.bbx0 = new float[1]();
                this.bby0 = new float[1]();
                this.bbx1 = new float[1]();
                this.bby1 = new float[1]();
                this.mask = new LandMask(1) on heap;
                this.pLobes = new int[1]();
                this.pWander = new float[1]();
                this.pTurn = new float[1]();
                this.pAspect = new float[1]();
                this.pCoastAmp = new float[1]();
                this.pCoastFreq = new float[1]();
                this.pShare = new float[1]();
            }

            public destructor ~Landmass() returns void {
                delete this.lobe;
                delete this.lobeStart;
                delete this.lobeCount;
                delete this.cxs;
                delete this.cys;
                delete this.rad;
                delete this.bbx0;
                delete this.bby0;
                delete this.bbx1;
                delete this.bby1;
                delete this.mask;
                delete this.pLobes;
                delete this.pWander;
                delete this.pTurn;
                delete this.pAspect;
                delete this.pCoastAmp;
                delete this.pCoastFreq;
                delete this.pShare;
            }

            public method profileCount() returns int {
                return this.nmass;
            }

            public method lobesOf(int i) returns int {
                return this.pLobes[i];
            }

            public method shareOf(int i) returns float {
                return this.pShare[i];
            }

            private method allocProfiles(int n) returns void {
                delete this.pLobes;
                delete this.pWander;
                delete this.pTurn;
                delete this.pAspect;
                delete this.pCoastAmp;
                delete this.pCoastFreq;
                delete this.pShare;
                this.pLobes = new int[n]();
                this.pWander = new float[n]();
                this.pTurn = new float[n]();
                this.pAspect = new float[n]();
                this.pCoastAmp = new float[n]();
                this.pCoastFreq = new float[n]();
                this.pShare = new float[n]();
                this.nmass = n;
                return;
            }

            // Sizes follow a linear ramp with largest:smallest = 3:1, jittered +-15%, normalised so
            // the shares sum to 1. Drawn from a DEDICATED stream so the geography never shifts when
            // an unrelated stage changes how many random numbers it consumes -- a lesson from the
            // previous rewrite, where re-rolling one jitter silently emptied two biomes.
            public method drawProfiles(int nc, int nIsl) returns void {
                int n = nc + nIsl;
                this.allocProfiles(n);
                this.nCont = nc;
                Rng2 rng = new Rng2(this.seed ^ 0x2C0F) on stack;
                float[] raw = new float[nc]();
                mutable float total = 0.0;
                mutable int i = 0;
                while (i < nc) {
                    mutable float ramp = 3.0;
                    if (nc > 1) {
                        ramp = 3.0 - 2.0 * cast<float>(i) / cast<float>(nc - 1);
                    }
                    float jitter = 0.85 + 0.30 * rng.unit();
                    raw[i] = ramp * jitter;
                    total = total + raw[i];
                    i = i + 1;
                }
                i = 0;
                while (i < nc) {
                    this.pLobes[i] = 3 + rng.nextInt(6);
                    this.pWander[i] = 0.35 + 0.50 * rng.unit();
                    this.pTurn[i] = 0.35 + 0.85 * rng.unit();
                    this.pAspect[i] = 1.0 + 1.5 * rng.unit();
                    this.pCoastAmp[i] = 0.06 + 0.28 * rng.unit();
                    this.pCoastFreq[i] = 3.0 + 11.0 * rng.unit();
                    this.pShare[i] = raw[i] / total;
                    i = i + 1;
                }
                // Islands: a single lobe each, small, and ragged out of proportion to their size --
                // that is what reads as an island rather than a shrunken continent.
                while (i < n) {
                    this.pLobes[i] = 1;
                    this.pWander[i] = 0.0;
                    this.pTurn[i] = 0.0;
                    this.pAspect[i] = 1.0 + 1.2 * rng.unit();
                    this.pCoastAmp[i] = 0.16 + 0.24 * rng.unit();
                    this.pCoastFreq[i] = 9.0 + 12.0 * rng.unit();
                    this.pShare[i] = 0.0;
                    i = i + 1;
                }
                delete raw;
                return;
            }

            private method allocMasses(int n) returns void {
                delete this.lobeStart;
                delete this.lobeCount;
                delete this.cxs;
                delete this.cys;
                delete this.rad;
                delete this.bbx0;
                delete this.bby0;
                delete this.bbx1;
                delete this.bby1;
                this.lobeStart = new int[n]();
                this.lobeCount = new int[n]();
                this.cxs = new float[n]();
                this.cys = new float[n]();
                this.rad = new float[n]();
                this.bbx0 = new float[n]();
                this.bby0 = new float[n]();
                this.bbx1 = new float[n]();
                this.bby1 = new float[n]();
                return;
            }

            // Where a landmass's skeleton starts, for the audit's fused-continent test.
            public method centreX(int i, int w) returns int {
                return cast<int>(this.cxs[i] * cast<float>(w));
            }

            public method centreY(int i, int h) returns int {
                return cast<int>(this.cys[i] * cast<float>(h));
            }

            public method massCount() returns int {
                return this.nmass;
            }

            // Continental centres by dart throwing with a guaranteed separation, then a short
            // turning walk per landmass with an elliptical lobe at every node. The first lobe is
            // full radius (the core); the rest vary 0.4x..1.3x, so a mass has a body and limbs
            // rather than being one uniform cloud.
            private method plantSkeletons(float aspect) returns void {
                Rng2 rng = new Rng2(this.seed ^ 0x51ED) on stack;
                mutable int total = 0;
                mutable int i = 0;
                while (i < this.nmass) {
                    total = total + this.pLobes[i];
                    i = i + 1;
                }
                delete this.lobe;
                this.lobe = new Lobe[total]();
                mutable int w = 0;
                i = 0;
                while (i < this.nmass) {
                    // Each continent owns a disjoint CELL of the map and never leaves it, so
                    // "the continents do not touch" holds by construction. Relaxation was tried
                    // first and could not work: masses built by a walk have wildly irregular
                    // footprints, so pushing them apart either fused them or crushed them all into
                    // the middle depending on how the clearance was estimated. Cells make the
                    // packing a layout decision instead of an emergent one; the size differences
                    // still come from each mass's own area target, which just leaves the smaller
                    // ones with room to spare inside their cell.
                    if (i < this.nCont) {
                        int gx = i % this.cellCols;
                        int gy = i / this.cellCols;
                        this.cxs[i] = this.cellX0(gx) + this.cellW() * (0.35 + 0.30 * rng.unit());
                        this.cys[i] = this.cellY0(gy) + this.cellH() * (0.35 + 0.30 * rng.unit());
                    } else {
                        // islands live in open water: throw darts, reject anything landing on a
                        // continent's box
                        mutable int tries = 0;
                        mutable boolean placed = false;
                        while (!placed && tries < 300) {
                            float tx = 0.06 + rng.unit() * 0.88;
                            float ty = 0.08 + rng.unit() * 0.84;
                            mutable boolean ok = true;
                            mutable int j = 0;
                            while (j < this.nCont) {
                                if (tx > this.bbx0[j] - 0.02 && tx < this.bbx1[j] + 0.02
                                    && ty > this.bby0[j] - 0.02 && ty < this.bby1[j] + 0.02) {
                                    ok = false;
                                    j = this.nCont;
                                }
                                j = j + 1;
                            }
                            if (ok) {
                                this.cxs[i] = tx;
                                this.cys[i] = ty;
                                placed = true;
                            }
                            tries = tries + 1;
                        }
                        if (!placed) {
                            this.cxs[i] = 0.06 + rng.unit() * 0.88;
                            this.cys[i] = 0.08 + rng.unit() * 0.84;
                        }
                    }
                    this.lobeStart[i] = w;
                    this.lobeCount[i] = this.pLobes[i];
                    mutable float px = this.cxs[i];
                    mutable float py = this.cys[i];
                    mutable float dir = rng.unit() * 6.28318;
                    mutable int k = 0;
                    while (k < this.pLobes[i]) {
                        mutable float lr = this.rad[i];
                        if (k > 0) {
                            lr = this.rad[i] * (0.4 + 0.9 * rng.unit());
                        }
                        float asp = 1.0 + (this.pAspect[i] - 1.0) * rng.unit();
                        this.lobe[w] = new Lobe(px, py, lr, lr / asp, rng.unit() * 3.14159);
                        w = w + 1;
                        dir = dir + (rng.unit() * 2.0 - 1.0) * this.pTurn[i];
                        float stride = this.pWander[i] * this.rad[i];
                        px = px + LandMath.cos(dir) * stride / aspect;
                        py = py + LandMath.sin(dir) * stride;
                        k = k + 1;
                    }
                    this.computeBox(i, aspect);
                    i = i + 1;
                }
                return;
            }

            // Bounding box over a landmass's lobes, padded by the coast noise AND by the offshore
            // band the depth ramp needs. Cells reject a whole landmass with four comparisons;
            // without this the inner loop would test ~50 lobes on every one of 3.7M cells.
            private method computeBox(int i, float aspect) returns void {
                float pad = 1.0 + this.pCoastAmp[i] + 0.40;
                mutable float x0 = 9.0;
                mutable float y0 = 9.0;
                mutable float x1 = 0.0 - 9.0;
                mutable float y1 = 0.0 - 9.0;
                mutable int k = 0;
                while (k < this.lobeCount[i]) {
                    int li = this.lobeStart[i] + k;
                    float ex = this.lobe[li].rx * pad / aspect;
                    float ey = this.lobe[li].ry * pad;
                    float cx = this.lobe[li].cx;
                    float cy = this.lobe[li].cy;
                    if (cx - ex < x0) {
                        x0 = cx - ex;
                    }
                    if (cy - ey < y0) {
                        y0 = cy - ey;
                    }
                    if (cx + ex > x1) {
                        x1 = cx + ex;
                    }
                    if (cy + ey > y1) {
                        y1 = cy + ey;
                    }
                    k = k + 1;
                }
                this.bbx0[i] = x0;
                this.bby0[i] = y0;
                this.bbx1[i] = x1;
                this.bby1[i] = y1;
                return;
            }

            // Union of a landmass's lobes as a MIN over normalized elliptical distances. The result
            // is NOT clamped: positive means land (and how far inland), negative means sea (and how
            // far offshore), so one field yields both the plateau and the shelf-to-deep ramp.
            // Coast noise is added to the DISTANCE, never to the sampled position -- that ravels the
            // coastline without dragging one landmass into its neighbour, which is the trick the
            // original agents.exe uses (replica_world.md 6c) and the reason the previous rewrites,
            // which warped the position instead, welded their continents together.
            private method massValue(int i, float nx, float ny, float aspect) returns float {
                if (nx < this.bbx0[i] || nx > this.bbx1[i] || ny < this.bby0[i] || ny > this.bby1[i]) {
                    return 0.0 - 9.0;
                }
                mutable float d = 9.0;
                mutable int k = 0;
                while (k < this.lobeCount[i]) {
                    float dd = this.lobe[this.lobeStart[i] + k].distanceTo(nx, ny, aspect);
                    if (dd < d) {
                        d = dd;
                    }
                    k = k + 1;
                }
                float freq = this.pCoastFreq[i];
                float n1 = LandMath.vnoise(this.seed + i * 37, nx * freq, ny * freq, cast<int>(freq));
                float n2 = LandMath.vnoise(this.seed + i * 91, nx * freq * 2.7 + 5.0,
                                           ny * freq * 2.7 + 9.0, cast<int>(freq * 2.7) + 1);
                d = d + (n1 - 0.5) * this.pCoastAmp[i] + (n2 - 0.5) * this.pCoastAmp[i] * 0.45;
                return 1.0 - d;
            }

            public override method name() returns String {
                return "landmass";
            }

            public override method apply(WorldField* f) returns void {
                float aspect = cast<float>(f.w) / cast<float>(f.h);
                mutable int nc = f.nContinents;
                if (nc <= 0) {
                    nc = 6;
                }
                int nIsl = 5;
                this.nmass = nc + nIsl;
                this.drawProfiles(nc, nIsl);
                this.allocMasses(this.nmass);
                mutable float landT = f.landRatio;
                if (landT < 0.0) {
                    landT = 0.38;
                }
                // First guess only: a landmass is a WALK of lobes, so its real area is several
                // times one circle of this radius. fitRadii measures and corrects.
                mutable int i = 0;
                while (i < nc) {
                    this.rad[i] = LandMath.sqrt(this.pShare[i] * landT * aspect / 3.14159) * 0.45;
                    i = i + 1;
                }
                while (i < this.nmass) {
                    this.rad[i] = 0.022 + 0.020 * LandMath.hash01(this.seed + i * 17, i, 3);
                    i = i + 1;
                }
                this.cellCols = cast<int>(LandMath.sqrt(cast<float>(nc) * aspect + 0.5));
                if (this.cellCols < 1) {
                    this.cellCols = 1;
                }
                this.cellRows = (nc + this.cellCols - 1) / this.cellCols;
                this.plantSkeletons(aspect);
                mutable int fi = 0;
                while (fi < this.nCont) {
                    this.fitToCell(fi, aspect);
                    fi = fi + 1;
                }
                this.fitRadii(f, aspect, landT);
                this.rasterize(f, aspect);
                return;
            }

            // ---- the continent cell grid ----------------------------------------------------
            // A cell per continent, laid out over the usable map with a gutter between them. The
            // gutter is the ocean that guarantees separation.
            private method cellW() returns float {
                return 0.94 / cast<float>(this.cellCols);
            }

            private method cellH() returns float {
                return 0.90 / cast<float>(this.cellRows);
            }

            private method cellX0(int gx) returns float {
                return 0.03 + this.cellW() * cast<float>(gx);
            }

            private method cellY0(int gy) returns float {
                return 0.05 + this.cellH() * cast<float>(gy);
            }

            // Shrink a continent until its shoreline box fits inside its own cell, leaving the
            // gutter clear. Called after every growth step, so a mass can chase its area target
            // but can never spill into a neighbour.
            private method fitToCell(int i, float aspect) returns void {
                if (i >= this.nCont) {
                    return;
                }
                int gx = i % this.cellCols;
                int gy = i / this.cellCols;
                float gutX = this.cellW() * 0.10;
                float gutY = this.cellH() * 0.10;
                float lx = this.cellX0(gx) + gutX;
                float hx = this.cellX0(gx) + this.cellW() - gutX;
                float ly = this.cellY0(gy) + gutY;
                float hy = this.cellY0(gy) + this.cellH() - gutY;
                mutable int guard = 0;
                while (guard < 12) {
                    mutable float k = 1.0;
                    if (this.bbx1[i] - this.bbx0[i] > hx - lx) {
                        k = (hx - lx) / (this.bbx1[i] - this.bbx0[i]);
                    }
                    float ky = 1.0;
                    if (this.bby1[i] - this.bby0[i] > hy - ly) {
                        float k2 = (hy - ly) / (this.bby1[i] - this.bby0[i]);
                        if (k2 < k) {
                            k = k2;
                        }
                    }
                    if (k < 0.999) {
                        this.scaleMass(i, k * 0.98, aspect);
                    } else {
                        guard = 12;
                    }
                    guard = guard + 1;
                }
                // slide it fully inside the cell
                mutable float dx = 0.0;
                mutable float dy = 0.0;
                if (this.bbx0[i] < lx) {
                    dx = lx - this.bbx0[i];
                }
                if (this.bbx1[i] > hx) {
                    dx = hx - this.bbx1[i];
                }
                if (this.bby0[i] < ly) {
                    dy = ly - this.bby0[i];
                }
                if (this.bby1[i] > hy) {
                    dy = hy - this.bby1[i];
                }
                if (dx != 0.0 || dy != 0.0) {
                    this.translateMass(i, dx, dy, aspect);
                }
                return;
            }

            // How far a landmass actually reaches from its skeleton origin: the walk carries lobes
            // well past `rad`, so a circle of `rad` is not the footprint.
            private method effRadius(int i, float aspect) returns float {
                mutable float best = 0.0;
                mutable int k = 0;
                while (k < this.lobeCount[i]) {
                    int li = this.lobeStart[i] + k;
                    float dx = (this.lobe[li].cx - this.cxs[i]) * aspect;
                    float dy = this.lobe[li].cy - this.cys[i];
                    mutable float r = this.lobe[li].rx;
                    if (this.lobe[li].ry > r) {
                        r = this.lobe[li].ry;
                    }
                    // The coast noise is added to the DISTANCE, so it pushes the shoreline out by
                    // up to coastAmp of the lobe radius. Separation that ignores that leaves a gap
                    // the noise then bridges -- which is precisely how two masses kept touching.
                    r = r * (1.0 + this.pCoastAmp[i]);
                    float reach = LandMath.sqrt(dx * dx + dy * dy) + r;
                    if (reach > best) {
                        best = reach;
                    }
                    k = k + 1;
                }
                return best;
            }

            private method translateMass(int i, float dx, float dy, float aspect) returns void {
                this.cxs[i] = this.cxs[i] + dx;
                this.cys[i] = this.cys[i] + dy;
                mutable int k = 0;
                while (k < this.lobeCount[i]) {
                    int li = this.lobeStart[i] + k;
                    this.lobe[li] = new Lobe(this.lobe[li].cx + dx, this.lobe[li].cy + dy,
                                             this.lobe[li].rx, this.lobe[li].ry, this.lobe[li].ang);
                    k = k + 1;
                }
                this.computeBox(i, aspect);
                return;
            }

            // Relaxation on BOUNDING BOXES, not circles. A landmass built by a walk is long and
            // thin, so a circle around its origin claims several times its real footprint: asking
            // for circle clearance demanded more room than the map has, the relaxation saturated
            // against the walls, and every mass jammed into the middle and fused. Boxes are tight,
            // and pushing along the axis of LEAST overlap slides masses past each other instead of
            // shoving them all outward. Translation only -- each mass keeps its shape.
            private method separateMasses(float aspect) returns void {
                // shoreline reach without the shelf padding computeBox adds for the depth ramp
                float shrink = 0.40;
                mutable int pass = 0;
                while (pass < 30) {
                    mutable boolean moved = false;
                    mutable int i = 0;
                    while (i < this.nmass) {
                        mutable int j = i + 1;
                        while (j < this.nmass) {
                            float ax0 = this.bbx0[i] + shrink * this.rad[i] / aspect;
                            float ax1 = this.bbx1[i] - shrink * this.rad[i] / aspect;
                            float ay0 = this.bby0[i] + shrink * this.rad[i];
                            float ay1 = this.bby1[i] - shrink * this.rad[i];
                            float bx0 = this.bbx0[j] + shrink * this.rad[j] / aspect;
                            float bx1 = this.bbx1[j] - shrink * this.rad[j] / aspect;
                            float by0 = this.bby0[j] + shrink * this.rad[j];
                            float by1 = this.bby1[j] - shrink * this.rad[j];
                            float gap = 0.012;
                            float overX = this.overlapOf(ax0, ax1, bx0, bx1) + gap;
                            float overY = this.overlapOf(ay0, ay1, by0, by1) + gap;
                            if (overX > gap && overY > gap) {
                                // separate along whichever axis needs the smaller move
                                if (overX * aspect < overY) {
                                    mutable float s = overX * 0.5;
                                    if (this.cxs[i] > this.cxs[j]) {
                                        s = 0.0 - s;
                                    }
                                    this.translateMass(i, 0.0 - s, 0.0, aspect);
                                    this.translateMass(j, s, 0.0, aspect);
                                } else {
                                    mutable float s = overY * 0.5;
                                    if (this.cys[i] > this.cys[j]) {
                                        s = 0.0 - s;
                                    }
                                    this.translateMass(i, 0.0, 0.0 - s, aspect);
                                    this.translateMass(j, 0.0, s, aspect);
                                }
                                moved = true;
                            }
                            j = j + 1;
                        }
                        i = i + 1;
                    }
                    // keep every mass inside the map, with room for the border ocean falloff
                    i = 0;
                    while (i < this.nmass) {
                        mutable float dx = 0.0;
                        mutable float dy = 0.0;
                        if (this.bbx0[i] < 0.02) {
                            dx = 0.02 - this.bbx0[i];
                        }
                        if (this.bbx1[i] > 0.98) {
                            dx = 0.98 - this.bbx1[i];
                        }
                        if (this.bby0[i] < 0.03) {
                            dy = 0.03 - this.bby0[i];
                        }
                        if (this.bby1[i] > 0.97) {
                            dy = 0.97 - this.bby1[i];
                        }
                        if (dx != 0.0 || dy != 0.0) {
                            this.translateMass(i, dx, dy, aspect);
                            moved = true;
                        }
                        i = i + 1;
                    }
                    if (!moved) {
                        pass = 30;
                    }
                    pass = pass + 1;
                }
                return;
            }

            // Overlap of two intervals, negative when they are already apart.
            private method overlapOf(float a0, float a1, float b0, float b1) returns float {
                mutable float hi = a1;
                if (b1 < hi) {
                    hi = b1;
                }
                mutable float lo = a0;
                if (b0 > lo) {
                    lo = b0;
                }
                return hi - lo;
            }

            // Closed loop instead of a guess: rasterise at 1/8 resolution (58k cells, trivial),
            // measure the area each CONTINENT actually claims, and scale its radius by the square
            // root of the error. Overlap between lobes, the coast noise and the walk's spread are
            // all absorbed by the measurement rather than modelled. Islands are left alone.
            private method fitRadii(WorldField* f, float aspect, float landT) returns void {
                int sw = f.w / 8;
                int sh = f.h / 8;
                int[] got = new int[this.nmass]();
                mutable int round = 0;
                while (round < 4) {
                    mutable int i = 0;
                    while (i < this.nmass) {
                        got[i] = 0;
                        i = i + 1;
                    }
                    mutable int y = 0;
                    while (y < sh) {
                        float ny = cast<float>(y) / cast<float>(sh);
                        mutable int x = 0;
                        while (x < sw) {
                            float nx = cast<float>(x) / cast<float>(sw);
                            mutable float best = 0.0;
                            mutable int who = 0 - 1;
                            i = 0;
                            while (i < this.nmass) {
                                float v = this.massValue(i, nx, ny, aspect);
                                if (v > best) {
                                    best = v;
                                    who = i;
                                }
                                i = i + 1;
                            }
                            if (who >= 0) {
                                got[who] = got[who] + 1;
                            }
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    int total = sw * sh;
                    i = 0;
                    while (i < this.nCont) {
                        float actual = cast<float>(got[i]) / cast<float>(total);
                        float target = this.pShare[i] * landT;
                        if (actual > 0.00002) {
                            mutable float k = LandMath.sqrt(target / actual);
                            if (k > 1.6) {
                                k = 1.6;
                            }
                            if (k < 0.62) {
                                k = 0.62;
                            }
                            this.scaleMass(i, k, aspect);
                            this.fitToCell(i, aspect);
                        }
                        i = i + 1;
                    }
                    round = round + 1;
                }
                delete got;
                return;
            }

            // Grow or shrink one landmass about its skeleton origin: the lobes keep their relative
            // layout, so the shape it was given survives the resize.
            private method scaleMass(int i, float k, float aspect) returns void {
                this.rad[i] = this.rad[i] * k;
                mutable int j = 0;
                while (j < this.lobeCount[i]) {
                    int li = this.lobeStart[i] + j;
                    float ox = this.lobe[li].cx - this.cxs[i];
                    float oy = this.lobe[li].cy - this.cys[i];
                    this.lobe[li] = new Lobe(this.cxs[i] + ox * k, this.cys[i] + oy * k,
                                             this.lobe[li].rx * k, this.lobe[li].ry * k,
                                             this.lobe[li].ang);
                    j = j + 1;
                }
                this.computeBox(i, aspect);
                return;
            }

            // Full-resolution pass. Land tops out at 0.62 BY CONSTRUCTION (0.44 + 0.14 + 0.04), so
            // nothing here can reach the 0.63 mountain band -- only Tectonics may do that, which is
            // what stops mountain coverage from being a side effect of noise tuning.
            private method rasterize(WorldField* f, float aspect) returns void {
                delete this.mask;
                this.mask = new LandMask(f.w * f.h) on heap;
                mutable int y = 0;
                while (y < f.h) {
                    float ny = cast<float>(y) / cast<float>(f.h);
                    mutable int x = 0;
                    while (x < f.w) {
                        float nx = cast<float>(x) / cast<float>(f.w);
                        mutable float m = 0.0 - 9.0;
                        mutable int i = 0;
                        while (i < this.nmass) {
                            float v = this.massValue(i, nx, ny, aspect);
                            if (v > m) {
                                m = v;
                            }
                            i = i + 1;
                        }
                        int cell = y * f.w + x;
                        if (m > 0.0) {
                            this.mask.set(cell);
                            mutable float plateau = m * 2.8;
                            if (plateau > 1.0) {
                                plateau = 1.0;
                            }
                            float d = LandMath.fbm(f.seed, nx, ny, 6, 5);
                            f.eb[cell] = 0.44 + 0.14 * plateau + 0.04 * d;
                        } else {
                            // Steep drop, not a gentle ramp. The sea level is a PERCENTILE over
                            // every cell, so a wide ocean band puts that percentile in the middle
                            // of the sea floor and half the ocean comes back as shallows and ice.
                            // x12 keeps the shelf a narrow coastal strip and drops the rest to the
                            // floor, so the percentile lands where the coast actually is.
                            mutable float depth = (0.0 - m) * 12.0;
                            if (depth > 1.0) {
                                depth = 1.0;
                            }
                            f.eb[cell] = 0.42 - 0.32 * depth;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                this.borderFalloff(f);
                return;
            }

            // Map-edge ocean, floor 0.30: a 0.15 floor used to push border cells under the trench
            // cut and painted the artificial trench ring along the south edge.
            private method borderFalloff(WorldField* f) returns void {
                float margin = 0.07;
                mutable int i = 0;
                int n = f.w * f.h;
                while (i < n) {
                    int x = i % f.w;
                    int y = i / f.w;
                    float nx = cast<float>(x) / cast<float>(f.w - 1);
                    float ny = cast<float>(y) / cast<float>(f.h - 1);
                    mutable float edge = nx;
                    if (1.0 - nx < edge) {
                        edge = 1.0 - nx;
                    }
                    if (ny < edge) {
                        edge = ny;
                    }
                    if (1.0 - ny < edge) {
                        edge = 1.0 - ny;
                    }
                    if (edge < margin) {
                        mutable float t = edge / margin;
                        t = t * t * (3.0 - 2.0 * t);
                        // Pull TOWARD the deep-ocean floor, never below it. Multiplying the value
                        // scaled open ocean down too and drew a visible rectangle where the margin
                        // began; interpolating leaves an already-deep cell untouched.
                        float floorZ = 0.10;
                        if (f.eb[i] > floorZ) {
                            f.eb[i] = floorZ + (f.eb[i] - floorZ) * t;
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            // Floats are printed as scaled integers: string interpolation does not accept float
            // (filed as a language gap), so every fractional value here is shown x1000.
            public method dumpProfiles() returns void {
                mutable int i = 0;
                while (i < this.nmass) {
                    int lobes = this.pLobes[i];
                    int wander = cast<int>(this.pWander[i] * 1000.0);
                    int turn = cast<int>(this.pTurn[i] * 1000.0);
                    int aspect = cast<int>(this.pAspect[i] * 1000.0);
                    int amp = cast<int>(this.pCoastAmp[i] * 1000.0);
                    int freq = cast<int>(this.pCoastFreq[i] * 1000.0);
                    int share = cast<int>(this.pShare[i] * 1000.0);
                    System.IO.Console.println($"continent {i}: lobes={lobes} wander={wander} turn={turn} aspect={aspect} coastAmp={amp} coastFreq={freq} share={share}  (fractions x1000)");
                    i = i + 1;
                }
                return;
            }
        }
    }
}
