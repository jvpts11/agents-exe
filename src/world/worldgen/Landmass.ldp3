import System.IO.Console;

// The relief stage: build a height field for the WHOLE map, then flood it. Continents are whatever
// stays above water -- an emergent property, never a decision.
//
// Why the inversion. Four earlier generations were rejected, and they failed the same way: each one
// decided WHERE a continent goes and then painted ocean around it. Placement is an explicit choice,
// so it always carried a pattern -- symmetry, or fusion when the symmetry was broken, or crushing
// when the fusion was fixed. With no placement step there is nothing to carry a pattern; fusion
// stops being a bug (two high regions that touch simply ARE one continent -- Eurasia is exactly
// that); and the size spread comes free, because an elevation distribution is naturally uneven.
//
// Why the plate partition is NOT Voronoi. Euclidean nearest-seed cuts the map into CONVEX polygons:
// the edges are straight segments by construction, and noise on the boundary only serrates the line
// while the macro shape stays a polygon -- that is where the triangles and rectangles came from.
// Real plates are not "the points nearest a centre"; they are bounded by lines of weakness in the
// lithosphere (sutures, old rifts, scars of earlier collisions), which is why they are sinuous,
// non-convex and branching. So the METRIC changes: a cell belongs to the seed that can REACH it
// most cheaply through a noisy resistance field. Plates spread fast through weak crust and stall
// against strong crust. No straight line is ever computed, so none can appear in the result.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class Landmass implements ElevationPass {
            private mutable int seed;
            private mutable int pw;             // coarse plate grid
            private mutable int ph;
            private mutable int nPlates;
            private mutable int nCont;

            // coarse fields, pw*ph
            private mutable int[] owner;        // plate id per coarse cell
            private mutable float[] cost;       // lithospheric resistance -- the growth metric
            private mutable float[] dist;       // accumulated travel cost from the owning seed
            private mutable float[] sdf;        // signed distance to the coast contour, in cells
            private mutable float[] dt;         // chamfer scratch
            private mutable float[] crust;      // crust thickness, saturated

            // binary min-heap for the cost-distance growth
            private mutable float[] hk;
            private mutable int[] hv;
            private mutable int hn;
            private mutable int hcap;

            // per plate: seed, kind, continent, area, edge, centroid and motion, one row each
            private mutable Plate[] plates;
            private mutable float[] cw;         // per continent: its drawn share weight
            private mutable byte[] adj;         // nPlates*nPlates adjacency

            private mutable int[] offX;         // 8-neighbourhood
            private mutable int[] offY;

            public constructor Landmass(int seed) {
                this.seed = seed;
                this.pw = 1;
                this.ph = 1;
                this.nPlates = 0;
                this.nCont = 0;
                this.hn = 0;
                this.hcap = 1;
                this.owner = new int[1]();
                this.cost = new float[1]();
                this.dist = new float[1]();
                this.sdf = new float[1]();
                this.dt = new float[1]();
                this.crust = new float[1]();
                this.hk = new float[1]();
                this.hv = new int[1]();
                this.plates = new Plate[1]();
                this.cw = new float[1]();
                this.adj = new byte[1]();
                this.offX = new int[8]();
                this.offY = new int[8]();
                this.offX[0] = 0 - 1;   this.offY[0] = 0;
                this.offX[1] = 1;       this.offY[1] = 0;
                this.offX[2] = 0;       this.offY[2] = 0 - 1;
                this.offX[3] = 0;       this.offY[3] = 1;
                this.offX[4] = 0 - 1;   this.offY[4] = 0 - 1;
                this.offX[5] = 1;       this.offY[5] = 0 - 1;
                this.offX[6] = 0 - 1;   this.offY[6] = 1;
                this.offX[7] = 1;       this.offY[7] = 1;
            }

            public destructor ~Landmass() returns void {
                delete this.owner;
                delete this.cost;
                delete this.dist;
                delete this.sdf;
                delete this.dt;
                delete this.crust;
                delete this.hk;
                delete this.hv;
                delete this.plates;
                delete this.cw;
                delete this.adj;
                delete this.offX;
                delete this.offY;
            }

            public override method name() returns String {
                return "landmass";
            }

            public override method apply(WorldField* f) returns void {
                mutable int nc = f.nContinents;
                if (nc <= 0) {
                    nc = 6;
                }
                this.nCont = nc;
                // Eight plates per continent. Enough craton plates to weld into continents AND
                // enough oceanic ones left over to keep them apart -- but the real reason for the
                // number is GRANULARITY: with five, a continent that needed to grow was often boxed
                // in by its neighbours, the balancing loop stalled, and continental crust came in at
                // 34% against a 46% target, which let the flood cut BELOW the cratons and merge
                // landmasses across open water. Smaller plates give the loop somewhere to go.
                this.nPlates = nc * 8;
                if (this.nPlates < 32) {
                    this.nPlates = 32;
                }
                // FIXED coarse resolution, not w/8. Deriving it from the render size made the plate
                // partition depend on it, so the same seed produced a different world at 1280x720
                // than at 2560x1440 -- and the plate diagnostic was describing a world the audit
                // never saw. 320 cells on the long axis is finer than any plate margin.
                this.pw = 320;
                this.ph = 320 * f.h / f.w;
                if (this.ph < 48) {
                    this.ph = 48;
                }
                this.allocGrids(this.pw * this.ph);
                this.allocPlates(this.nPlates);

                this.buildCost();
                this.seedPlates();
                this.growPlates();
                this.measurePlates();
                this.buildAdjacency();
                this.chooseCratons();
                this.buildCrust();

                mutable float landT = f.landRatio;
                if (landT < 0.0) {
                    landT = 0.38;
                }
                this.raiseAndFlood(f, landT);
                this.publish(f);
                return;
            }

            private method allocGrids(int pn) returns void {
                delete this.owner;
                delete this.cost;
                delete this.dist;
                delete this.sdf;
                delete this.dt;
                delete this.crust;
                delete this.hk;
                delete this.hv;
                this.owner = new int[pn]();
                this.cost = new float[pn]();
                this.dist = new float[pn]();
                this.sdf = new float[pn]();
                this.dt = new float[pn]();
                this.crust = new float[pn]();
                this.hcap = pn * 8;
                this.hk = new float[this.hcap]();
                this.hv = new int[this.hcap]();
                this.hn = 0;
                return;
            }

            private method allocPlates(int np) returns void {
                delete this.plates;
                delete this.cw;
                delete this.adj;
                this.plates = new Plate[np]();
                this.cw = new float[np]();
                this.adj = new byte[np * np]();
                return;
            }

            // ---- 1. the resistance field --------------------------------------------------------
            // Two scales on purpose: the low-frequency term makes a growing plate take
            // continental-scale detours, the high-frequency one makes the boundary ragged where it
            // finally stalls. Raised to the 4th power so most of the map is cheap and the walls are
            // rare and strong (~17:1) -- that contrast is what produces fingers, gulfs and triple
            // junctions instead of blobs. A flat cost field would give back the polygons.
            private method buildCost() returns void {
                int pn = this.pw * this.ph;
                mutable int i = 0;
                while (i < pn) {
                    int x = i % this.pw;
                    int y = i / this.pw;
                    float nx = cast<float>(x) / cast<float>(this.pw);
                    float ny = cast<float>(y) / cast<float>(this.ph);
                    float lo = LandMath.fbm(this.seed ^ 0x0C57, nx, ny, 3, 3);
                    float hi = LandMath.fbm(this.seed ^ 0x5A17, nx, ny, 13, 3);
                    float r = lo * 0.72 + hi * 0.28;
                    float r2 = r * r;
                    this.cost[i] = 0.05 + 3.0 * r2 * r2;
                    i = i + 1;
                }
                return;
            }

            // ---- 2. seeds ----------------------------------------------------------------------
            // Seeds are placed with a plain minimum separation. That is not a contradiction of the
            // non-Euclidean partition: the seed POSITIONS only decide how many plates there are and
            // roughly where they nucleate. Their SHAPE comes entirely from the cost field.
            private method seedPlates() returns void {
                Rng rng = new Rng(this.seed ^ 0x7A31) on stack;
                float cellArea = cast<float>(this.pw * this.ph) / cast<float>(this.nPlates);
                mutable float minSep = LandMath.sqrt(cellArea) * 0.62;
                mutable int placed = 0;
                mutable int guard = 0;
                while (placed < this.nPlates && guard < 30000) {
                    int tx = rng.nextInt(this.pw);
                    int ty = rng.nextInt(this.ph);
                    mutable boolean ok = true;
                    mutable int j = 0;
                    while (j < placed) {
                        float dx = cast<float>(tx - this.plates[j].sx);
                        float dy = cast<float>(ty - this.plates[j].sy);
                        if (dx * dx + dy * dy < minSep * minSep) {
                            ok = false;
                            j = placed;
                        }
                        j = j + 1;
                    }
                    if (ok) {
                        this.plates[placed].sx = tx;
                        this.plates[placed].sy = ty;
                        placed = placed + 1;
                    }
                    guard = guard + 1;
                    if (guard % 5000 == 0) {
                        minSep = minSep * 0.82;
                    }
                }
                while (placed < this.nPlates) {
                    this.plates[placed].sx = rng.nextInt(this.pw);
                    this.plates[placed].sy = rng.nextInt(this.ph);
                    placed = placed + 1;
                }
                mutable int i = 0;
                while (i < this.nPlates) {
                    float a = rng.unit() * 6.28318;
                    this.plates[i].mx = LandMath.cos(a);
                    this.plates[i].my = LandMath.sin(a);
                    i = i + 1;
                }
                return;
            }

            // ---- 3. cost-distance growth (the non-Euclidean core) -------------------------------
            // Multi-source Dijkstra over the coarse grid. A step is charged the MEAN resistance of
            // the two cells times its length (1 or sqrt(2)), so the graph itself adds no directional
            // bias -- a 4-neighbourhood would impose a diamond metric and a uniform cost field an
            // octagonal one, both of which are just Euclidean artefacts wearing a different shape.
            private method growPlates() returns void {
                int pn = this.pw * this.ph;
                mutable int i = 0;
                while (i < pn) {
                    this.dist[i] = 1000000000.0;
                    this.owner[i] = 0 - 1;
                    i = i + 1;
                }
                this.hn = 0;
                i = 0;
                while (i < this.nPlates) {
                    int c = this.plates[i].sy * this.pw + this.plates[i].sx;
                    this.dist[c] = 0.0;
                    this.owner[c] = i;
                    this.hpush(0.0, c);
                    i = i + 1;
                }
                while (this.hn > 0) {
                    float d = this.hk[0];
                    int c = this.hpop();
                    // stale heap entry: this cell was relaxed again after being pushed
                    if (d <= this.dist[c] + 0.0000001) {
                        int cx = c % this.pw;
                        int cy = c / this.pw;
                        int who = this.owner[c];
                        mutable int k = 0;
                        while (k < 8) {
                            int nx = cx + this.offX[k];
                            int ny = cy + this.offY[k];
                            if (nx >= 0 && nx < this.pw && ny >= 0 && ny < this.ph) {
                                int nc = ny * this.pw + nx;
                                mutable float len = 1.0;
                                if (k >= 4) {
                                    len = 1.41421356;
                                }
                                float nd = d + 0.5 * (this.cost[c] + this.cost[nc]) * len;
                                if (nd < this.dist[nc]) {
                                    this.dist[nc] = nd;
                                    this.owner[nc] = who;
                                    this.hpush(nd, nc);
                                }
                            }
                            k = k + 1;
                        }
                    }
                }
                // any cell the heap could not reach (only possible if it overflowed) falls to the
                // nearest seed so the partition is always total
                i = 0;
                while (i < pn) {
                    if (this.owner[i] < 0) {
                        this.owner[i] = this.nearestSeed(i % this.pw, i / this.pw);
                    }
                    i = i + 1;
                }
                return;
            }

            private method nearestSeed(int x, int y) returns int {
                mutable int best = 0;
                mutable int bd = 2000000000;
                mutable int i = 0;
                while (i < this.nPlates) {
                    int dx = x - this.plates[i].sx;
                    int dy = y - this.plates[i].sy;
                    int d = dx * dx + dy * dy;
                    if (d < bd) {
                        bd = d;
                        best = i;
                    }
                    i = i + 1;
                }
                return best;
            }

            private method hpush(float key, int val) returns void {
                if (this.hn >= this.hcap) {
                    return;
                }
                mutable int i = this.hn;
                this.hk[i] = key;
                this.hv[i] = val;
                this.hn = this.hn + 1;
                while (i > 0) {
                    int p = (i - 1) / 2;
                    if (this.hk[p] <= this.hk[i]) {
                        i = 0;
                    } else {
                        float tk = this.hk[p];
                        int tv = this.hv[p];
                        this.hk[p] = this.hk[i];
                        this.hv[p] = this.hv[i];
                        this.hk[i] = tk;
                        this.hv[i] = tv;
                        i = p;
                    }
                }
                return;
            }

            private method hpop() returns int {
                int top = this.hv[0];
                this.hn = this.hn - 1;
                this.hk[0] = this.hk[this.hn];
                this.hv[0] = this.hv[this.hn];
                mutable int i = 0;
                mutable boolean go = true;
                while (go) {
                    int l = 2 * i + 1;
                    int r = l + 1;
                    mutable int s = i;
                    if (l < this.hn && this.hk[l] < this.hk[s]) {
                        s = l;
                    }
                    if (r < this.hn && this.hk[r] < this.hk[s]) {
                        s = r;
                    }
                    if (s == i) {
                        go = false;
                    } else {
                        float tk = this.hk[s];
                        int tv = this.hv[s];
                        this.hk[s] = this.hk[i];
                        this.hv[s] = this.hv[i];
                        this.hk[i] = tk;
                        this.hv[i] = tv;
                        i = s;
                    }
                }
                return top;
            }

            // ---- 4. plate statistics and adjacency ----------------------------------------------
            private method measurePlates() returns void {
                mutable int i = 0;
                while (i < this.nPlates) {
                    this.plates[i].area = 0;
                    this.plates[i].edge = 0;
                    this.plates[i].cx = 0.0;
                    this.plates[i].cy = 0.0;
                    i = i + 1;
                }
                int pn = this.pw * this.ph;
                i = 0;
                while (i < pn) {
                    int p = this.owner[i];
                    int x = i % this.pw;
                    int y = i / this.pw;
                    this.plates[p].area = this.plates[p].area + 1;
                    this.plates[p].cx = this.plates[p].cx + cast<float>(x);
                    this.plates[p].cy = this.plates[p].cy + cast<float>(y);
                    if (x == 0 || y == 0 || x == this.pw - 1 || y == this.ph - 1) {
                        this.plates[p].edge = 1;
                    }
                    i = i + 1;
                }
                i = 0;
                while (i < this.nPlates) {
                    if (this.plates[i].area > 0) {
                        this.plates[i].cx = this.plates[i].cx / cast<float>(this.plates[i].area);
                        this.plates[i].cy = this.plates[i].cy / cast<float>(this.plates[i].area);
                    }
                    i = i + 1;
                }
                return;
            }

            private method buildAdjacency() returns void {
                mutable int i = 0;
                int nn = this.nPlates * this.nPlates;
                while (i < nn) {
                    this.adj[i] = cast<byte>(0);
                    i = i + 1;
                }
                mutable int y = 0;
                while (y < this.ph) {
                    mutable int x = 0;
                    while (x < this.pw) {
                        int c = y * this.pw + x;
                        int a = this.owner[c];
                        if (x + 1 < this.pw) {
                            int b = this.owner[c + 1];
                            if (b != a) {
                                this.adj[a * this.nPlates + b] = cast<byte>(1);
                                this.adj[b * this.nPlates + a] = cast<byte>(1);
                            }
                        }
                        if (y + 1 < this.ph) {
                            int b = this.owner[c + this.pw];
                            if (b != a) {
                                this.adj[a * this.nPlates + b] = cast<byte>(1);
                                this.adj[b * this.nPlates + a] = cast<byte>(1);
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                return;
            }

            private method touches(int a, int b) returns boolean {
                return cast<int>(this.adj[a * this.nPlates + b]) != 0;
            }

            // Is plate p next to any plate already owned by continent c?
            private method nextToCont(int p, int c) returns boolean {
                mutable int i = 0;
                while (i < this.nPlates) {
                    if (this.plates[i].continent == c && this.touches(p, i)) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // Is plate p next to any continent OTHER than c? (c = -1 asks about any continent.)
            private method nextToOther(int p, int c) returns boolean {
                mutable int i = 0;
                while (i < this.nPlates) {
                    if (this.plates[i].continent >= 0 && this.plates[i].continent != c && this.touches(p, i)) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // ---- 5. cratons and welding ---------------------------------------------------------
            // Nuclei by farthest-point sampling, then each absorbs 0..3 adjacent plates. A candidate
            // that also touches ANOTHER continent is refused, so an oceanic plate always survives
            // between two continents: the separation is topological, not geometric, which is why
            // there is no packing step and no grid to show through.
            //
            // The size spread therefore comes from a DISCRETE, physical quantity -- how many plates
            // got welded. A four-plate continent beside a one-plate continent is Eurasia beside
            // Australia. No ratio is imposed anywhere.
            private method chooseCratons() returns void {
                Rng rng = new Rng(this.seed ^ 0x1BEE) on stack;
                mutable int i = 0;
                while (i < this.nPlates) {
                    this.plates[i].kind = cast<int>(PlateKind.Oceanic);
                    this.plates[i].continent = 0 - 1;
                    i = i + 1;
                }
                mutable float avg = 0.0;
                i = 0;
                while (i < this.nPlates) {
                    avg = avg + cast<float>(this.plates[i].area);
                    i = i + 1;
                }
                avg = avg / cast<float>(this.nPlates);
                if (avg < 1.0) {
                    avg = 1.0;
                }

                // first nucleus: the biggest interior plate
                mutable int first = 0;
                mutable float bestA = 0.0 - 1.0;
                i = 0;
                while (i < this.nPlates) {
                    mutable float a = cast<float>(this.plates[i].area);
                    if (this.plates[i].edge != 0) {
                        a = a * 0.35;
                    }
                    if (a > bestA) {
                        bestA = a;
                        first = i;
                    }
                    i = i + 1;
                }
                this.plates[first].kind = cast<int>(PlateKind.Craton);
                this.plates[first].continent = 0;
                mutable int made = 1;
                mutable boolean more = true;
                while (made < this.nCont && more) {
                    mutable int pick = 0 - 1;
                    mutable float bestScore = 0.0 - 1.0;
                    i = 0;
                    while (i < this.nPlates) {
                        if (this.plates[i].continent < 0 && !this.nextToOther(i, 0 - 1)) {
                            mutable float md = 1000000000.0;
                            mutable int j = 0;
                            while (j < this.nPlates) {
                                if (this.plates[j].continent >= 0) {
                                    float dx = this.plates[i].cx - this.plates[j].cx;
                                    float dy = this.plates[i].cy - this.plates[j].cy;
                                    float dd = LandMath.sqrt(dx * dx + dy * dy);
                                    if (dd < md) {
                                        md = dd;
                                    }
                                }
                                j = j + 1;
                            }
                            mutable float sc = md * (0.55 + 0.90 * cast<float>(this.plates[i].area) / avg);
                            if (this.plates[i].edge != 0) {
                                sc = sc * 0.60;
                            }
                            if (sc > bestScore) {
                                bestScore = sc;
                                pick = i;
                            }
                        }
                        i = i + 1;
                    }
                    if (pick < 0) {
                        more = false;
                    } else {
                        this.plates[pick].kind = cast<int>(PlateKind.Craton);
                        this.plates[pick].continent = made;
                        made = made + 1;
                    }
                }
                this.nCont = made;

                // Continents grow toward their OWN weighted share of the crust. The weight is drawn
                // once per continent and is where the size spread comes from -- it has to be a draw,
                // because a loop that simply feeds the smallest continent until coverage is reached
                // is an EQUALISER: chasing only the crust target it drove all six continents to
                // within 1.68:1 of each other, which is the symmetry this rewrite exists to remove,
                // arriving by a different road.
                //
                // Weights run 1.0 to 2.4. Land area grows faster than plate area -- the flood cuts a
                // fixed depth into every margin, so a craton twice the size keeps more than twice the
                // land -- and the ~2.2:1 spread six draws actually produce lands near 3:1 in the land
                // the audit measures.
                mutable float wsum = 0.0;
                i = 0;
                while (i < this.nCont) {
                    float u = rng.unit();
                    this.cw[i] = 1.0 + u * u * 1.8;
                    wsum = wsum + this.cw[i];
                    i = i + 1;
                }

                // Closed loop, not a plate count: plate areas vary by 10x, so any fixed number of
                // welds lands somewhere different on every seed. Each round feeds whichever continent
                // is furthest below its own quota, so coverage and spread are reached together.
                int total = this.pw * this.ph;
                int target = cast<int>(cast<float>(total) * 0.46);
                int[] boxedIn = new int[this.nCont]();
                mutable boolean progress = true;
                while (progress && this.cratonArea() < target) {
                    progress = false;
                    mutable int pick = 0 - 1;
                    mutable float worstGap = 0.0 - 1000000000.0;
                    i = 0;
                    while (i < this.nCont) {
                        if (boxedIn[i] == 0) {
                            float quota = this.cw[i] / wsum * cast<float>(target);
                            float gap = quota - cast<float>(this.contArea(i));
                            if (gap > worstGap) {
                                worstGap = gap;
                                pick = i;
                            }
                        }
                        i = i + 1;
                    }
                    if (pick >= 0) {
                        // a continent with no free neighbour left is out of the running, but the
                        // others may still grow
                        if (!this.weldOne(pick)) {
                            boxedIn[pick] = 1;
                        }
                        progress = true;
                    }
                }
                delete boxedIn;

                // A continent hemmed in by its neighbours cannot reach its quota, and the spread
                // then reflects the accident of who had room rather than the weights that were
                // drawn -- over twelve seeds that showed up as land ratios from 1.5:1 to 10:1. Pull
                // the extreme back by feeding the smaller continents, never the leader, and stop as
                // soon as the spread is merely acceptable rather than equal.
                int ceiling = cast<int>(cast<float>(total) * 0.55);
                mutable boolean pulling = true;
                while (pulling && this.cratonArea() < ceiling && this.contRatio() > 260) {
                    pulling = false;
                    int mean = this.cratonArea() / this.nCont;
                    mutable int lowMark = 0 - 1;
                    mutable int tried = 0;
                    while (tried < this.nCont && !pulling) {
                        mutable int pick = 0 - 1;
                        mutable int least = 2000000000;
                        mutable int j = 0;
                        while (j < this.nCont) {
                            int a = this.contArea(j);
                            if (a > lowMark && a < least && a < mean) {
                                least = a;
                                pick = j;
                            }
                            j = j + 1;
                        }
                        if (pick < 0) {
                            tried = this.nCont;
                        } else {
                            pulling = this.weldOne(pick);
                            lowMark = least;
                            tried = tried + 1;
                        }
                    }
                }

                // Island cratons: oceanic plates whose crust only clears the water deep in the plate
                // interior. (Real island ARCS are a boundary product and belong to Tectonics; these
                // are the isolated ones -- Iceland, Hawaii.)
                //
                // At most ONE adjacent continent, which is exactly the anti-bridge condition:
                // welding two continents needs a plate that touches both. Banning ALL adjacency
                // instead was safe but found no candidates at all; allowing any adjacency turned an
                // island into a land bridge and merged two continents into half of all land.
                mutable int isl = 0;
                mutable boolean going = true;
                while (isl < 2 && going) {
                    mutable int pick = 0 - 1;
                    mutable float bestSc = 0.0 - 1.0;
                    i = 0;
                    while (i < this.nPlates) {
                        if (this.plates[i].kind == cast<int>(PlateKind.Oceanic)
                            && this.adjacentContinents(i) <= 1
                            && cast<float>(this.plates[i].area) > avg * 0.35) {
                            mutable float far = 1000000000.0;
                            mutable int j = 0;
                            while (j < this.nPlates) {
                                if (this.plates[j].kind == cast<int>(PlateKind.Craton)) {
                                    float dx = this.plates[i].cx - this.plates[j].cx;
                                    float dy = this.plates[i].cy - this.plates[j].cy;
                                    float dd = LandMath.sqrt(dx * dx + dy * dy);
                                    if (dd < far) {
                                        far = dd;
                                    }
                                }
                                j = j + 1;
                            }
                            float sc = far * (0.7 + 0.6 * rng.unit());
                            if (sc > bestSc) {
                                bestSc = sc;
                                pick = i;
                            }
                        }
                        i = i + 1;
                    }
                    if (pick < 0) {
                        going = false;
                    } else {
                        this.plates[pick].kind = cast<int>(PlateKind.Island);
                        this.plates[pick].continent = 0 - 1;
                        isl = isl + 1;
                    }
                }
                return;
            }

            // Weld the biggest available plate onto continent c. A candidate that also touches
            // ANOTHER continent is refused, so an oceanic plate always survives in between.
            private method weldOne(int c) returns boolean {
                mutable int pick = 0 - 1;
                mutable int pickA = 0 - 1;
                mutable int i = 0;
                while (i < this.nPlates) {
                    if (this.plates[i].continent < 0 && this.nextToCont(i, c) && !this.nextToOther(i, c)) {
                        if (this.plates[i].area > pickA) {
                            pickA = this.plates[i].area;
                            pick = i;
                        }
                    }
                    i = i + 1;
                }
                if (pick < 0) {
                    return false;
                }
                this.plates[pick].kind = cast<int>(PlateKind.Craton);
                this.plates[pick].continent = c;
                return true;
            }

            private method cratonArea() returns int {
                mutable int a = 0;
                mutable int i = 0;
                while (i < this.nPlates) {
                    if (this.plates[i].kind == cast<int>(PlateKind.Craton)) {
                        a = a + this.plates[i].area;
                    }
                    i = i + 1;
                }
                return a;
            }

            // How many distinct continents plate p touches. Two is a land bridge.
            private method adjacentContinents(int p) returns int {
                mutable int seen = 0;
                mutable int c = 0;
                while (c < this.nCont) {
                    if (this.nextToCont(p, c)) {
                        seen = seen + 1;
                    }
                    c = c + 1;
                }
                return seen;
            }

            // biggest : smallest continent by plate area, x100
            private method contRatio() returns int {
                mutable int big = 0;
                mutable int small = 2000000000;
                mutable int i = 0;
                while (i < this.nCont) {
                    int a = this.contArea(i);
                    if (a > big) {
                        big = a;
                    }
                    if (a < small) {
                        small = a;
                    }
                    i = i + 1;
                }
                if (small <= 0) {
                    return 0;
                }
                return big * 100 / small;
            }

            private method contArea(int c) returns int {
                mutable int a = 0;
                mutable int i = 0;
                while (i < this.nPlates) {
                    if (this.plates[i].continent == c) {
                        a = a + this.plates[i].area;
                    }
                    i = i + 1;
                }
                return a;
            }

            // ---- 6. crust thickness --------------------------------------------------------------
            // A signed distance to the continental/oceanic border, softened and wobbled. The border
            // is already irregular (it is a cost-distance boundary), so its distance transform is
            // irregular everywhere -- thick core, thin margins, no circle anywhere.
            private method buildCrust() returns void {
                int pn = this.pw * this.ph;
                // distance from every cell to the nearest OCEANIC cell -> depth into the crust
                this.chamfer(true);
                mutable int i = 0;
                while (i < pn) {
                    this.sdf[i] = this.dt[i];
                    i = i + 1;
                }
                // distance to the nearest CONTINENTAL cell -> how far offshore
                this.chamfer(false);
                i = 0;
                while (i < pn) {
                    if (this.plates[this.owner[i]].kind == cast<int>(PlateKind.Oceanic)) {
                        this.sdf[i] = 0.0 - this.dt[i];
                    }
                    i = i + 1;
                }

                // How much of an island plate a cell is, as a SMOOTH field. The inset below used to
                // be switched on plate membership, cell by cell: the moment you left the island
                // plate the crust jumped by half a unit, so the flood contour stopped following a
                // contour and started following the PLATE EDGE -- and a small island came out with
                // its coast cut dead straight down one side. Blurring the membership over a few
                // coarse cells makes the crust continuous again, and the coast goes back to being
                // decided by the water level rather than by which plate a cell happens to be in.
                i = 0;
                while (i < pn) {
                    if (this.plates[this.owner[i]].kind == cast<int>(PlateKind.Island)) {
                        this.dt[i] = 1.0;
                    } else {
                        this.dt[i] = 0.0;
                    }
                    i = i + 1;
                }
                mutable int blur = 0;
                while (blur < 3) {
                    mutable int y = 0;
                    while (y < this.ph) {
                        mutable int x = 0;
                        while (x < this.pw) {
                            int c = y * this.pw + x;
                            mutable float acc = this.dt[c];
                            mutable float cnt = 1.0;
                            if (x > 0) {
                                acc = acc + this.dt[c - 1];
                                cnt = cnt + 1.0;
                            }
                            if (x + 1 < this.pw) {
                                acc = acc + this.dt[c + 1];
                                cnt = cnt + 1.0;
                            }
                            if (y > 0) {
                                acc = acc + this.dt[c - this.pw];
                                cnt = cnt + 1.0;
                            }
                            if (y + 1 < this.ph) {
                                acc = acc + this.dt[c + this.pw];
                                cnt = cnt + 1.0;
                            }
                            this.dt[c] = acc / cnt;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    blur = blur + 1;
                }

                float margin = 0.055 * cast<float>(this.ph);
                i = 0;
                while (i < pn) {
                    int x = i % this.pw;
                    int y = i / this.pw;
                    float nx = cast<float>(x) / cast<float>(this.pw);
                    float ny = cast<float>(y) / cast<float>(this.ph);
                    mutable float s = this.sdf[i] / margin;
                    // Only the deep interior of an island plate clears the water, and low. The
                    // inset is in MARGINS, so it has to stay well under half a plate's width or the
                    // island vanishes entirely. It is BLENDED by the smoothed membership above, not
                    // switched, so no cell boundary can become a coastline.
                    float iw = this.dt[i];
                    if (iw > 0.001) {
                        float inset = (s - 0.90) * 0.60;
                        s = s * (1.0 - iw) + inset * iw;
                    }
                    // Shift the CONTOUR, never the sampled position. Warping the position is what
                    // welded neighbouring landmasses together in the earlier rewrites; moving the
                    // contour ravels a coast without dragging anything into anything else.
                    float wob = LandMath.fbm(this.seed ^ 0x33A9, nx, ny, 5, 4) - 0.5;
                    s = s - wob * 1.35;
                    mutable float sat = s;
                    if (s > 0.0) {
                        sat = s / (1.0 + s * 0.45);
                    } else {
                        sat = s / (1.0 - s * 0.45);
                    }
                    this.crust[i] = sat;
                    i = i + 1;
                }
                return;
            }

            // Two-pass chamfer distance transform into this.dt. `fromOceanic` seeds the oceanic
            // cells (so continental cells learn how far inland they are) and vice versa.
            private method chamfer(boolean fromOceanic) returns void {
                int pn = this.pw * this.ph;
                mutable int i = 0;
                while (i < pn) {
                    boolean oceanic = this.plates[this.owner[i]].kind == cast<int>(PlateKind.Oceanic);
                    mutable boolean isSeed = oceanic;
                    if (!fromOceanic) {
                        isSeed = !oceanic;
                    }
                    if (isSeed) {
                        this.dt[i] = 0.0;
                    } else {
                        this.dt[i] = 1000000000.0;
                    }
                    i = i + 1;
                }
                float dOrt = 1.0;
                float dDia = 1.41421356;
                mutable int y = 0;
                while (y < this.ph) {
                    mutable int x = 0;
                    while (x < this.pw) {
                        int c = y * this.pw + x;
                        mutable float b = this.dt[c];
                        if (x > 0 && this.dt[c - 1] + dOrt < b) {
                            b = this.dt[c - 1] + dOrt;
                        }
                        if (y > 0 && this.dt[c - this.pw] + dOrt < b) {
                            b = this.dt[c - this.pw] + dOrt;
                        }
                        if (x > 0 && y > 0 && this.dt[c - this.pw - 1] + dDia < b) {
                            b = this.dt[c - this.pw - 1] + dDia;
                        }
                        if (x + 1 < this.pw && y > 0 && this.dt[c - this.pw + 1] + dDia < b) {
                            b = this.dt[c - this.pw + 1] + dDia;
                        }
                        this.dt[c] = b;
                        x = x + 1;
                    }
                    y = y + 1;
                }
                y = this.ph - 1;
                while (y >= 0) {
                    mutable int x = this.pw - 1;
                    while (x >= 0) {
                        int c = y * this.pw + x;
                        mutable float b = this.dt[c];
                        if (x + 1 < this.pw && this.dt[c + 1] + dOrt < b) {
                            b = this.dt[c + 1] + dOrt;
                        }
                        if (y + 1 < this.ph && this.dt[c + this.pw] + dOrt < b) {
                            b = this.dt[c + this.pw] + dOrt;
                        }
                        if (x + 1 < this.pw && y + 1 < this.ph && this.dt[c + this.pw + 1] + dDia < b) {
                            b = this.dt[c + this.pw + 1] + dDia;
                        }
                        if (x > 0 && y + 1 < this.ph && this.dt[c + this.pw - 1] + dDia < b) {
                            b = this.dt[c + this.pw - 1] + dDia;
                        }
                        this.dt[c] = b;
                        x = x - 1;
                    }
                    y = y - 1;
                }
                return;
            }

            private method crustAt(float nx, float ny) returns float {
                mutable float gx = nx * cast<float>(this.pw) - 0.5;
                mutable float gy = ny * cast<float>(this.ph) - 0.5;
                if (gx < 0.0) {
                    gx = 0.0;
                }
                if (gy < 0.0) {
                    gy = 0.0;
                }
                mutable int x0 = cast<int>(gx);
                mutable int y0 = cast<int>(gy);
                if (x0 > this.pw - 2) {
                    x0 = this.pw - 2;
                }
                if (y0 > this.ph - 2) {
                    y0 = this.ph - 2;
                }
                if (x0 < 0) {
                    x0 = 0;
                }
                if (y0 < 0) {
                    y0 = 0;
                }
                mutable float tx = gx - cast<float>(x0);
                mutable float ty = gy - cast<float>(y0);
                if (tx < 0.0) {
                    tx = 0.0;
                }
                if (tx > 1.0) {
                    tx = 1.0;
                }
                if (ty < 0.0) {
                    ty = 0.0;
                }
                if (ty > 1.0) {
                    ty = 1.0;
                }
                int c = y0 * this.pw + x0;
                float a = this.crust[c];
                float b = this.crust[c + 1];
                float d = this.crust[c + this.pw];
                float e = this.crust[c + this.pw + 1];
                float ab = a + (b - a) * tx;
                float de = d + (e - d) * tx;
                return ab + (de - ab) * ty;
            }

            // ---- 7. raise, flood, remap ---------------------------------------------------------
            // The height field has no fixed range: the flood picks the contour that yields the
            // requested land ratio, and only then is everything remapped into the elevation
            // contract. Pouring a fixed volume of water IS a percentile -- the reason the percentile
            // failed before is that the old field was a plateau over a flat sea floor, so the
            // percentile snapped to the floor and handed back the whole shelf as land. A continuum
            // has no such step to snap to.
            //
            // Ordinary land tops out at 0.62 BY CONSTRUCTION and the sea floor bottoms out at 0.26.
            // Nothing here can enter the 0.63 mountain band or the trench band below 0.22 -- those
            // belong to Tectonics, which is what stops mountain coverage and trenches from being
            // side effects of noise tuning.
            private method raiseAndFlood(WorldField* f, float landT) returns void {
                int n = f.w * f.h;
                mutable float lo = 1000000000.0;
                mutable float hi = 0.0 - 1000000000.0;
                mutable int y = 0;
                while (y < f.h) {
                    float ny = cast<float>(y) / cast<float>(f.h);
                    mutable int x = 0;
                    while (x < f.w) {
                        float nx = cast<float>(x) / cast<float>(f.w);
                        mutable float v = this.crustAt(nx, ny);
                        // full-resolution coastline ravel, on the value (= on the contour)
                        v = v - (LandMath.fbm(this.seed ^ 0x77C1, nx, ny, 26, 4) - 0.5) * 0.62;
                        // interior texture, so the flood never meets a flat surface
                        v = v + (LandMath.fbm(this.seed ^ 0x2D4B, nx, ny, 9, 5) - 0.5) * 0.30;
                        // Map-edge ocean, subtracted on the RAW field so the flood counts it. As a
                        // later pass it drowned land the percentile had already counted as land,
                        // and the world came out at 31.4% against a 38% target -- the same mistake
                        // as eroding after the flood, in a different place.
                        mutable float edge = nx;
                        if (1.0 - nx < edge) {
                            edge = 1.0 - nx;
                        }
                        if (ny < edge) {
                            edge = ny;
                        }
                        if (1.0 - ny < edge) {
                            edge = 1.0 - ny;
                        }
                        if (edge < 0.07) {
                            mutable float te = edge / 0.07;
                            te = te * te * (3.0 - 2.0 * te);
                            v = v - (1.0 - te) * 1.40;
                        }
                        int cell = y * f.w + x;
                        f.eb[cell] = v;
                        x = x + 1;
                    }
                    y = y + 1;
                }

                // Erode BEFORE flooding, not after. Erosion happens to terrain and the sea fills
                // what is left -- and mechanically it has to be this way round: a relaxation run on
                // the finished field averages a coastal land cell against the ocean beside it and
                // drags it under, which cost 6 points of land ratio (31.7% against a 38% target)
                // when this ran as a later pass. On the raw continuum there is no coastline yet, so
                // there is nothing to drag anything across.
                this.erodeRaw(f, 3);

                mutable int i = 0;
                while (i < n) {
                    float v = f.eb[i];
                    if (v < lo) {
                        lo = v;
                    }
                    if (v > hi) {
                        hi = v;
                    }
                    i = i + 1;
                }
                if (hi - lo < 0.000001) {
                    hi = lo + 1.0;
                }

                // Two histograms. The sea contour is a quantile over EVERY cell -- that is what
                // makes the land ratio exact. The depth SCALE is a quantile over the interior only:
                // the map-edge penalty puts a deep frame at the bottom of the distribution, and
                // reading the 98th percentile off it dragged the reference far below any real sea
                // floor, which squashed the whole ocean into the shallow band (deep ocean fell from
                // 18.6% to 4.8% of the world).
                int bins = 2048;
                int[] hist = new int[bins]();
                int[] hin = new int[bins]();
                float span = hi - lo;
                mutable int nin = 0;
                i = 0;
                while (i < n) {
                    mutable int b = cast<int>((f.eb[i] - lo) / span * cast<float>(bins));
                    if (b < 0) {
                        b = 0;
                    }
                    if (b >= bins) {
                        b = bins - 1;
                    }
                    hist[b] = hist[b] + 1;
                    float nx = cast<float>(i % f.w) / cast<float>(f.w);
                    float ny = cast<float>(i / f.w) / cast<float>(f.h);
                    mutable float edge = nx;
                    if (1.0 - nx < edge) {
                        edge = 1.0 - nx;
                    }
                    if (ny < edge) {
                        edge = ny;
                    }
                    if (1.0 - ny < edge) {
                        edge = 1.0 - ny;
                    }
                    if (edge >= 0.07) {
                        hin[b] = hin[b] + 1;
                        nin = nin + 1;
                    }
                    i = i + 1;
                }
                float sea = this.quantile(hist, bins, lo, span, n, landT);
                float top = this.quantile(hin, bins, lo, span, nin, 0.02);
                float bot = this.quantile(hin, bins, lo, span, nin, 0.98);
                delete hist;
                delete hin;

                mutable float up = top - sea;
                if (up < 0.000001) {
                    up = 0.000001;
                }
                mutable float down = sea - bot;
                if (down < 0.000001) {
                    down = 0.000001;
                }

                i = 0;
                while (i < n) {
                    float v = f.eb[i];
                    if (v >= sea) {
                        mutable float t = (v - sea) / up;
                        if (t > 1.0) {
                            t = 1.0;
                        }
                        // slightly concave: broad lowlands, a minority of high interior
                        float t2 = t * (0.35 + 0.65 * t);
                        f.eb[i] = 0.44 + 0.18 * t2;
                    } else {
                        mutable float t = (sea - v) / down;
                        if (t > 1.0) {
                            t = 1.0;
                        }
                        float t2 = t * (0.45 + 0.55 * t);
                        f.eb[i] = 0.429 - 0.169 * t2;
                    }
                    i = i + 1;
                }
                f.sea = 0.43;
                return;
            }

            // Thermal relaxation on the raw field: 4-neighbour, in place, edges clamped.
            private method erodeRaw(WorldField* f, int passes) returns void {
                mutable int p = 0;
                while (p < passes) {
                    mutable int y = 0;
                    while (y < f.h) {
                        mutable int x = 0;
                        while (x < f.w) {
                            int i = y * f.w + x;
                            float c = f.eb[i];
                            float l = f.eb[f.idx(x - 1, y)];
                            float r = f.eb[f.idx(x + 1, y)];
                            float u = f.eb[f.idx(x, y - 1)];
                            float d = f.eb[f.idx(x, y + 1)];
                            float avg = (l + r + u + d) * 0.25;
                            f.eb[i] = c * 0.6 + avg * 0.4;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    p = p + 1;
                }
                return;
            }

            // The value with `frac` of all cells above it.
            private method quantile(int[] hist, int bins, float lo, float span, int n, float frac) returns float {
                int want = cast<int>(cast<float>(n) * frac);
                mutable int cum = 0;
                mutable int b = bins - 1;
                while (b > 0 && cum < want) {
                    cum = cum + hist[b];
                    b = b - 1;
                }
                return lo + span * cast<float>(b) / cast<float>(bins);
            }

            // Hand the plate partition to the next pass. Tectonics deforms boundaries, so it needs
            // who owns what, which plates are continental, and how each one is moving.
            private method publish(WorldField* f) returns void {
                f.pw = this.pw;
                f.ph = this.ph;
                f.nPlates = this.nPlates;
                delete f.plate;
                delete f.plates;
                int pn = this.pw * this.ph;
                f.plate = new int[pn]();
                f.plates = new Plate[this.nPlates]();
                mutable int i = 0;
                while (i < pn) {
                    f.plate[i] = this.owner[i];
                    i = i + 1;
                }
                // The whole row, not four fields picked out of it. Copies, never aliases: this
                // pass is destroyed with its own array while the field outlives it.
                i = 0;
                while (i < this.nPlates) {
                    f.plates[i] = this.plates[i];
                    i = i + 1;
                }
                return;
            }

            // Diagnostic: run the pass on a small field and print what the plates turned into.
            // The number that matters is the last one -- what share of LAND sits on continental
            // crust. If land spills off the cratons the flood is cutting a noise field instead of
            // a crust field, which is exactly the failure this rewrite exists to avoid.
            public method dumpPlates(int w, int h, int nc) returns void {
                WorldField* f = new WorldField(w, h, this.seed) on heap;
                f.nContinents = nc;
                ElevationPass* pass = this;
                pass.apply(f);

                System.IO.Console.println("continent  plates   coarse area   share of map");
                mutable int c = 0;
                while (c < this.nCont) {
                    mutable int plates = 0;
                    mutable int i = 0;
                    while (i < this.nPlates) {
                        if (this.plates[i].continent == c) {
                            plates = plates + 1;
                        }
                        i = i + 1;
                    }
                    int area = this.contArea(c);
                    int share = area * 1000 / (this.pw * this.ph);
                    System.IO.Console.println($"    {c}         {plates}        {area}          {share} per mille");
                    c = c + 1;
                }

                mutable int cratons = 0;
                mutable int islands = 0;
                mutable int i2 = 0;
                while (i2 < this.nPlates) {
                    if (this.plates[i2].kind == cast<int>(PlateKind.Craton)) {
                        cratons = cratons + 1;
                    }
                    if (this.plates[i2].kind == cast<int>(PlateKind.Island)) {
                        islands = islands + 1;
                    }
                    i2 = i2 + 1;
                }
                int crustShare = this.cratonArea() * 100 / (this.pw * this.ph);

                // where the land actually landed. Land is read straight off the elevation: only
                // this pass has run here (no Tectonics), and raiseAndFlood's remap puts every
                // land cell at 0.44 + 0.18*t2 (>= 0.44) and every water cell at 0.429 - 0.169*t2
                // (<= 0.429) -- so `eb >= 0.44` IS the land mask, exactly. The LandMask class this
                // replaced claimed Tectonics consumed it; nothing did, and it died in the relayout.
                mutable int land = 0;
                mutable int onCraton = 0;
                mutable int cell = 0;
                int n = w * h;
                while (cell < n) {
                    if (f.eb[cell] >= 0.44) {
                        land = land + 1;
                        int gx = (cell % w) * this.pw / w;
                        int gy = (cell / w) * this.ph / h;
                        if (this.plates[this.owner[gy * this.pw + gx]].kind != cast<int>(PlateKind.Oceanic)) {
                            onCraton = onCraton + 1;
                        }
                    }
                    cell = cell + 1;
                }
                int landPct = land * 100 / n;
                mutable int fit = 100;
                if (land > 0) {
                    fit = onCraton * 100 / land;
                }
                System.IO.Console.println($"continents {this.nCont}, craton plates {cratons} + {islands} island, of {this.nPlates}");
                System.IO.Console.println($"continental crust {crustShare} percent of the map, land {landPct} percent, land on continental crust {fit} percent");
                delete f;
                return;
            }
        }
    }
}
