import System.IO.Console;
program AgentsExe;

// What a plate is made of. The partition stores the ordinal, so these ARE the stored values.
//
// They were three constants on Landmass and, in the pass that reads them from another file, a bare
// `== 1`. Two spellings of the same fact, one of which is a magic number crossing a module
// boundary: nothing in the ore pass said which kind 1 was, and nothing would have complained if a
// fourth kind had been inserted above it and moved every crust in the world.
public bundle Agents {
    public namespace World {

        public enum PlateKind {
            // Sea floor: thin, dense, and what gets pushed under something else.
            Oceanic,
            // Old stable continental crust with deep roots. What a continent is built on.
            Craton,
            // A craton small enough to be an island rather than a landmass.
            Island
        }
    }
}
