import System.IO.Console;
program AgentsExe;

// One ore field: where it came from, how near the surface it sits, and what it managed to show at
// the top.
//
// The outcrop count is the field's whole reason for existing as a thing rather than a set of
// cells. Outcrops are decided per BODY and not per cell, because an ore field that produced no
// outcrop anywhere is invisible -- and one invisible field is a whole resource an agent can never
// reach. The fallback is the guarantee: an exposed cell held in reserve, so a field that rolled
// badly everywhere still breaks the surface once.
//
// The seam count is deliberately NOT here. It is sized and zeroed after the bodies are placed,
// when how many there are is finally known, and folding it in would mean that reallocation wiped
// the four facts below along with it.
public bundle Agents {
    public namespace World {

        public struct OreBody {
            // Which OreOrigin seeded it, as its ordinal.
            public mutable int origin;
            // 0..100: how near the surface it sits. A shallow body is poorer but far likelier to
            // break the surface, which is where depth earns its place at generation time instead
            // of being stored per cell.
            public mutable int shallow;
            // Outcrops it produced.
            public mutable int outcrops;
            // An exposed cell of this body held in reserve, or -1.
            public mutable int fallback;
        }
    }
}
