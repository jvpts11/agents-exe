import System.IO.Console;
program AgentsExe;

// The two ends of the interior's height range: the 2nd percentile and the 98th.
//
// They are an ANSWER rather than a pair of numbers -- the height scale is fitted between them, and
// asking for one without the other is meaningless. Reading the extremes rather than the true
// minimum and maximum is the point: a single freak cell at either end would otherwise set the scale
// for the whole world, so the fit ignores the outermost two percent at each end deliberately.
//
// INTERIOR only, and that is the other half of why this is one value. The border falloff drives
// elevation at the map edges, so including them would fit the scale to an artefact of the frame
// rather than to the terrain.
public bundle Agents {
    public namespace World {

        public record ReliefBand(float top, float bottom) {
            // How much room there is above the waterline, never zero -- the scale divides by it.
            public method riseAbove(float sea) returns float {
                float up = this.top - sea;
                if (up < 0.000001) {
                    return 0.000001;
                }
                return up;
            }

            // And how much below it.
            public method dropBelow(float sea) returns float {
                float down = sea - this.bottom;
                if (down < 0.000001) {
                    return 0.000001;
                }
                return down;
            }
        }
    }
}
