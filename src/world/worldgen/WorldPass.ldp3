import System.IO.Console;
import Agents.World.Grid;
program AgentsExe;

// One stage of world CONTENT, run after the terrain is classified: it reads the finished Grid --
// and the generation field behind it, which still knows where the plates and the boundaries were
// -- and writes into the layers the game is played on.
public bundle Agents {
    public namespace World {

        public interface WorldPass {
            method name() returns String;
            method apply(Grid* g, WorldField* f) returns void;
        }
    }
}
