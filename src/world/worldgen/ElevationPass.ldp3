import System.IO.Console;
program AgentsExe;

// One stage of elevation construction, so the pipeline is a list rather than a hardcoded call
// chain and each stage can be tested on its own.
public bundle Agents {
    public namespace World {

        public interface ElevationPass {
            method name() returns String;
            method apply(WorldField* f) returns void;
        }
    }
}
