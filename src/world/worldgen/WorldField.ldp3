import System.IO.Console;
program AgentsExe;

// The scratch shared by the generation passes: dimensions, parameters and the elevation field.
// Owned by WorldGen for the duration of generate().
//
// WHY THE TWO FULL-RESOLUTION BUFFERS ARE STILL BARE ARRAYS, and it is a measurement rather than
// an oversight. Everything here that could be grouped has been: the plates arrive as rows and the
// boundary as margins, and both are COARSE -- a few hundred entries on the plate grid, read once
// per plate or once per coarse cell. `eb` and `vent` are not. They are indexed inside the per-cell
// loops of five passes, `f.eb[i]` written straight into the arithmetic rather than bound to a
// local first, over two and a half million cells a pass. Putting an accessor in front of that buys
// tidiness and pays for it in the one place this project has never been willing to pay.
//
// So they stay reachable, and the reason is written here instead of being folklore. If that ever
// changes it changes with a number beside it -- measured improvements are their own step of the
// relayout, after the form is right, never smuggled in beside a rename.
public bundle Agents {
    public namespace World {

        public class WorldField {
            public mutable int w;
            public mutable int h;
            public mutable int seed;
            public mutable int nContinents;
            public mutable float landRatio;
            public mutable float sea;
            public mutable float[] eb;

            // The plate partition, filled in by Landmass and read by Tectonics. It lives on the
            // COARSE grid (pw x ph): boundary physics works at the scale of a plate margin, and a
            // full-resolution copy would cost 15 MB to say the same thing.
            public mutable int pw;
            public mutable int ph;
            public mutable int nPlates;
            public mutable int[] plate;      // pw*ph -> plate id
            // The plates themselves, by id. Four parallel arrays picked out of the relief pass's
            // own rows before this: it built a Plate for each one and then published a quarter of
            // it, so the same fact lived in two shapes and the copy between them could disagree.
            public mutable Plate[] plates;
            public mutable byte[] vent;      // full res: 1 where Tectonics put a volcano
            // Where the crust came from, published by Tectonics and read by the ore pass. Placing
            // metals by biome would be arbitrary; placing them by the boundary that made the rock is
            // what the real world does, and the classification already exists -- it was simply
            // thrown away once the relief had been applied.
            public mutable Margin[] margins; // coarse: the nearest boundary's kind, and how near

            public constructor WorldField(int w, int h, int seed) {
                this.w = w;
                this.h = h;
                this.seed = seed;
                this.nContinents = 6;
                this.landRatio = 0.0 - 1.0;
                this.sea = 0.42;
                this.eb = new float[w * h]();
                this.pw = 1;
                this.ph = 1;
                this.nPlates = 0;
                this.plate = new int[1]();
                this.plates = new Plate[1]();
                this.vent = new byte[w * h]();
                this.margins = new Margin[1]();
            }

            public destructor ~WorldField() returns void {
                delete this.eb;
                delete this.plate;
                delete this.plates;
                delete this.vent;
                delete this.margins;
            }

            // Plate id at a FULL-resolution cell.
            public method plateAt(int x, int y) returns int {
                mutable int gx = x * this.pw / this.w;
                mutable int gy = y * this.ph / this.h;
                if (gx >= this.pw) {
                    gx = this.pw - 1;
                }
                if (gy >= this.ph) {
                    gy = this.ph - 1;
                }
                if (gx < 0) {
                    gx = 0;
                }
                if (gy < 0) {
                    gy = 0;
                }
                return this.plate[gy * this.pw + gx];
            }

            public method idx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }
        }
    }
}
