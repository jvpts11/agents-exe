import System.IO.Console;
program AgentsExe;

// EVERY NUMBER THIS WORLD IS SEEDED WITH, in one place.
//
// A salt is XOR-ed into the seed so that two fields drawn for the same world do not come out
// correlated -- the canopy must not follow the coastline just because both were asked of the same
// number. Thirty-seven of them were hex literals sitting inline at their call sites, in five files,
// in two different spellings: most XOR-ed at the point of use, eight passed as a bare argument to
// `scatter`. Searching for one spelling finds a quarter of them.
//
// THEY ARE VALUES, NOT CHOICES. Changing one does not improve a world, it makes a different world:
// every seed in the goldens was drawn through exactly these numbers. Nothing here may be tidied.
//
// ---- THE FOUR COLLISIONS, WHICH ARE KEPT ----
//
// Four values appear twice. They are accidents of picking hex by hand, and they are PART OF THE
// WORLD: two fields sharing a salt are drawn from the same stream, and the worlds that exist were
// drawn that way. They are named separately and listed here so the next person to add a pass can
// see what is already taken -- which is how a fifth collision gets avoided rather than how these
// four get "fixed".
//
//   0x1E93   SCATTER_VARIATION  and  UNDERGROWTH_PICK     (both Groundcover)
//   0x4C0F   FISHING_SPOTS      and  UNDERGROWTH          (both Groundcover)
//   0x5A0D   SHORE_SAND         and  DESERT_SAND          (both Groundcover, and both sand)
//   0x5A17   RELIEF_FINE        and  SALT_FLATS           (Landmass and Groundcover -- this one
//                                                          crosses a file, so neither site could
//                                                          ever have seen the other)
public bundle Agents {
    public namespace World {

        public class WorldSalts {
            // ---- the relief, and the plates under it ----
            public static fixed int RELIEF_BROAD = 0x0C57;      // the low, wide height field
            public static fixed int RELIEF_FINE = 0x5A17;       // the detail laid over it
            public static fixed int PLATE_SEEDS = 0x7A31;       // where the plates are seeded
            public static fixed int CRATON_CHOICE = 0x1BEE;     // which of them are old crust
            public static fixed int COAST_WOBBLE = 0x33A9;      // the coastline's waver
            public static fixed int RELIEF_CARVE = 0x77C1;      // taken out of the height
            public static fixed int RELIEF_SWELL = 0x2D4B;      // and put back into it

            // ---- what the plates do where they meet ----
            public static fixed int BOUNDARY_WOBBLE = 0x39A1;   // the margin's waver
            public static fixed int ARC_BEADS = 0x5E4D;         // the beading along an island arc
            public static fixed int CRUST_GRAIN = 0x11C3;       // fine grain over the whole crust

            // ---- what lies under the ground ----
            public static fixed int OUTCROP_ROLL = 0x0C90;      // whether a body breaks the surface
            public static fixed int SEAM_ROLL = 0x3D51;         // whether a cell carries a seam
            public static fixed int NODE_JITTER_X = 0x6611;     // where in its cell a node stands
            public static fixed int NODE_JITTER_Y = 0x7722;
            public static fixed int BODY_PLACEMENT = 0x0DEB0;   // where the ore fields go

            // ---- what grows ----
            public static fixed int CANOPY_BODY = 0x1F05;       // the broad density field
            public static fixed int CANOPY_TEXTURE = 0x77A3;    // and the fine one over it
            public static fixed int SPECIES_ZONE = 0x2C17;      // which species a region favours
            public static fixed int TREE_ROLL = 0x5EED;         // whether this cell carries one
            public static fixed int SPECIES_PICK = 0x3B41;      // the minority draw
            public static fixed int TREE_JITTER_X = 0x11B7;     // where in its cell a tree stands
            public static fixed int TREE_JITTER_Y = 0x33C5;
            public static fixed int TREE_VARIATION = 0x6D2B;    // how much it carries

            // ---- what covers the ground ----
            public static fixed int SCATTER_JITTER_X = 0x2AB1;  // where in its cell a scatter lands
            public static fixed int SCATTER_JITTER_Y = 0x5CD3;
            public static fixed int SCATTER_VARIATION = 0x1E93; // how much it carries
            public static fixed int PATCH_FIELD = 0x9A17;       // the patchiness of everything here
            public static fixed int UNDERGROWTH_ZONE = 0x71D3;  // which undergrowth a region favours
            public static fixed int UNDERGROWTH_PICK = 0x1E93;  // and which one this cell gets
            public static fixed int FISHING_SPOTS = 0x4C0F;
            public static fixed int REEDS = 0x7701;
            public static fixed int RIVERBANK_CLAY = 0x0C1A;
            public static fixed int SHORE_SAND = 0x5A0D;
            public static fixed int DESERT_SAND = 0x5A0D;
            public static fixed int SALT_FLATS = 0x5A17;
            public static fixed int BOULDERS = 0x3355;
            public static fixed int UNDERGROWTH = 0x4C0F;
        }
    }
}
