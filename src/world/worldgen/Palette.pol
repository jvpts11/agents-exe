import System.IO.Console;
import Agents.World.NodeId;
import Agents.World.Nodes;
program AgentsExe;

// What a biome grows: up to three species and the peak share of its cells that carry a tree, in
// per mille. The value the field multiplies, not the share that comes out -- clearings take a bite
// out of it, which is what the audit measures.
public bundle Agents {
    public namespace World {

        public record Palette(NodeId a, NodeId b, NodeId c, int cover) {
            // `zone` is the broad species field, `salt` a per-cell draw. The third species is the
            // minority, and a palette that has not named one falls back to the first.
            public method pick(float zone, float salt) returns NodeId {
                if (salt > 0.90 && c != Nodes.NONE) {
                    return c;
                }
                if (zone > 0.52 && b != Nodes.NONE) {
                    return b;
                }
                return a;
            }
        }
    }
}
