import System.IO.Console;
program AgentsExe;

// What the crust under one coarse cell was made by: the nearest plate boundary's kind, and how
// close that boundary is.
//
// The two are meaningless apart. The kind alone says a subduction zone is somewhere in the
// neighbourhood; the nearness alone says a boundary is right here without saying which. Every
// reader takes both at the same index, and they were two arrays that had to be allocated, filled
// and read in step.
//
// This is what SURVIVES the relief. Tectonics knows which boundaries collided, which subducted and
// where the arcs are, and all of it used to be thrown away the moment the uplift had been written
// into the elevation -- so ore had to be placed by biome, which is arbitrary. Publishing the margin
// is what lets metal be placed by the rock that made it.
public bundle Agents {
    public namespace World {

        public struct Margin {
            // Which BoundaryKind, as its ordinal. A byte because the coarse plane is stored, and
            // because the readers cast it back exactly as they always did.
            public mutable byte origin;
            // 0 far from the boundary, 1 on it.
            public mutable float near;
        }
    }
}
