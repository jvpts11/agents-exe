import System.IO.Console;
import Agents.World.Grid;
program AgentsExe;

// What every cell IS, once the terrain and the climate are both settled.
//
// The order below is the model: the specials answer first, each of them decided by something the
// climate does not know about -- a vent, a lake flag, depth, altitude, an endorheic basin, a rare
// draw -- and what survives all of them is ordinary ground, handed to the Whittaker diagram. Read
// top to bottom, it is a list of everything that outranks climate, in the order it outranks it.
//
// This pass also writes the elevation into the Grid, scaled to the stored units. It is the last
// stage that sees the generation field, so it is where the 0..1 height becomes the short every
// later reader works from.
public bundle Agents {
    public namespace World {

        public class Classifier {
            // A vent is PLACED by Tectonics on the volcanic arc of a subduction zone, so it is
            // trusted -- but volcanic land still has to be high land. The old distance-to-water
            // gate existed to stop volcanic blobs appearing wherever noise happened to peak
            // inland; it would also have cut the real arcs, which sit tens of cells behind the
            // coastal range.
            public static fixed double VOLCANIC_FLOOR = 0.55;
            // A basin in a bone-dry climate is a dried-up salt flat, not a lake.
            public static fixed double LAKE_DRIES = 0.22;

            // Depth bands, RELATIVE to the percentile sea level: absolute cuts squeezed whole
            // bands out of existence whenever the sea level moved.
            public static fixed double TRENCH_BELOW = 0.21;
            public static fixed double DEEP_BELOW = 0.09;
            public static fixed double SHALLOW_WITHIN = 0.03;
            // Reefs are scattered ATOLL PATCHES in warm shallows, not a carpet over the whole
            // tropical band: a coarse noise mask keeps about one in six of them.
            public static fixed double REEF_MASK = 0.62;

            // Coast is low ground TOUCHING the water, by ring distance -- not every low flat. A
            // wide shelf inland of the shore is ordinary lowland, not kilometres of beach.
            public static fixed int COAST_RINGS = 2;
            public static fixed double COAST_WITHIN = 0.03;

            // The snow line is pure ALTITUDE: high enough is snow, whatever the tuning of latitude
            // and lapse does. The band under it partitions by climate instead.
            public static fixed double SNOW_LINE = 0.80;
            public static fixed double MOUNTAIN_LINE = 0.74;
            // Poleward half of the map: high ridges carry glaciers. Latitude directly, so the band
            // survives any retuning of temperature.
            public static fixed double GLACIER_LAT = 0.52;

            // Inside the outer tenth of the map the border-ocean falloff controls the depth rather
            // than geology, which drew an artificial trench ring hugging the map edges.
            public static fixed int EDGE_FRAME = 10;

            private mutable int seed;

            public constructor Classifier(int seed) {
                this.seed = seed;
            }

            public method apply(Grid* g, Scratch* s) returns void {
                mutable int y = 0;
                while (y < s.h) {
                    mutable int x = 0;
                    while (x < s.w) {
                        int i = y * s.w + x;
                        float e = s.elevation[i];
                        float t = cast<float>(g.tempAt(x, y)) / 100.0;
                        float m = cast<float>(g.moistAt(x, y)) / 100.0;
                        int fg = g.flagsAt(x, y);
                        g.setElev(x, y, cast<int>(e * 10000.0));
                        g.setBiome(x, y, this.biomeFor(s, e, t, m, fg, s.water[i], x, y));
                        x = x + 1;
                    }
                    y = y + 1;
                }
                return;
            }

            private method biomeFor(Scratch* s, float e, float t, float m, int fg, int distw,
                                    int x, int y) returns int {
                // Hard overrides. A river cell KEEPS its terrain biome -- the renderer draws a blue
                // channel over the land following the stored flow direction, because rivers wind
                // through terrain rather than painting the whole tile. Lakes and vents do recolour.
                if (CellFlags.hasVent(fg) && e >= s.sea && e >= Classifier.VOLCANIC_FLOOR) {
                    return cast<int>(Biome.Volcanic);
                }
                if (CellFlags.isLake(fg) && e >= s.sea) {
                    if (m < Classifier.LAKE_DRIES) { return cast<int>(Biome.SaltFlat); }
                    return cast<int>(Biome.Lake);
                }
                if (e < s.sea) {
                    // Sea ice is a SURFACE sheet -- it covers polar water of any depth, so it
                    // outranks the depth bands.
                    if (t < 0.15) { return cast<int>(Biome.SeaIce); }
                    if (e < s.sea - Classifier.TRENCH_BELOW && !this.nearEdge(s, x, y)) {
                        return cast<int>(Biome.MarineTrench);
                    }
                    if (e < s.sea - Classifier.DEEP_BELOW) { return cast<int>(Biome.DeepOcean); }
                    if (e >= s.sea - Classifier.SHALLOW_WITHIN) {
                        if (t >= 0.85 && m >= 0.80) {
                            float rn = LandMath.vnoise(this.seed,
                                                   cast<float>(x) / cast<float>(s.w) * 23.0,
                                                   cast<float>(y) / cast<float>(s.h) * 23.0, 23);
                            if (rn > Classifier.REEF_MASK) { return cast<int>(Biome.CoralReef); }
                        }
                        return cast<int>(Biome.ShallowSea);
                    }
                    return cast<int>(Biome.Ocean);
                }
                if (e < s.sea + Classifier.COAST_WITHIN && distw <= Classifier.COAST_RINGS) {
                    if (t >= 0.85 && m >= 0.60) { return cast<int>(Biome.Mangrove); }
                    if (t < 0.35) { return cast<int>(Biome.RockyShore); }
                    return cast<int>(Biome.Beach);
                }
                if (e >= Classifier.SNOW_LINE) {
                    return cast<int>(Biome.SnowPeak);
                }
                if (e >= Classifier.MOUNTAIN_LINE) {
                    if (s.absLat(y) >= Classifier.GLACIER_LAT) { return cast<int>(Biome.Glacier); }
                    if (m >= 0.45) { return cast<int>(Biome.AlpineMeadow); }
                    return cast<int>(Biome.Mountain);
                }
                // The contour line: ordinary land is capped below it by the relief pass, the
                // renderer starts stacking at it, and the highland biomes begin here. When this
                // said 0.58 the flat plateau interiors landed in the mountain band and half the
                // world came out as hills and badlands.
                if (e >= Contour.HIGHLAND) {
                    // Cold high ground ices over -- glacier tongues wherever the seed actually put
                    // its poleward ranges, whatever the lapse and latitude tuning does.
                    if (e >= 0.70 && t < 0.22) { return cast<int>(Biome.Glacier); }
                    if (t < 0.10) { return cast<int>(Biome.Glacier); }
                    if (m < 0.26) { return cast<int>(Biome.Badlands); }
                    if (t < 0.28) { return cast<int>(Biome.Mountain); }  // truly cold highland = rock
                    // The green shoulder under the peaks. 0.64 is anchored to where warm land
                    // actually exists: a seed can roll every tall ridge into polar latitudes, and
                    // the meadow must survive that.
                    if (e >= 0.64 && t >= 0.30 && m >= 0.32) { return cast<int>(Biome.AlpineMeadow); }
                    return cast<int>(Biome.Hills);
                }
                // Lowland specials.
                if (m < 0.20 && CellFlags.isEndorheic(fg)) { return cast<int>(Biome.SaltFlat); }
                // An oasis is a RARE, isolated pool cell inside hot desert -- not a coastal band.
                if (t >= 0.55 && m < 0.20
                    && LandMath.hash01(this.seed, x * 13 + 7, y * 17 + 3) > 0.995) {
                    return cast<int>(Biome.Oasis);
                }
                // Wetlands. A cold bog waterlogs at lower moisture -- barely any evaporation.
                if (t < 0.35 && m >= 0.78) { return cast<int>(Biome.Bog); }
                if (m >= 0.84) {
                    if (t >= 0.78) { return cast<int>(Biome.Swamp); }
                    return cast<int>(Biome.Marsh);
                }
                // Everything the specials did not claim is ordinary ground, decided by climate.
                return Whittaker.biomeFor(t, m);
            }

            private method nearEdge(Scratch* s, int x, int y) returns boolean {
                int bx = s.w / Classifier.EDGE_FRAME;
                int by = s.h / Classifier.EDGE_FRAME;
                if (x < bx || x >= s.w - bx) {
                    return true;
                }
                if (y < by || y >= s.h - by) {
                    return true;
                }
                return false;
            }
        }
    }
}
