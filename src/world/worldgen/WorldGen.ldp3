import System.IO.Console;
import System.Memory.Units.megabytes;
import Agents.World.Grid;
import Agents.World.Biome;
import Agents.World.WorldAudit;

// World generation: deterministic, size-agnostic.
// Pipeline: relief + flood -> tectonic deformation -> thermal erosion -> climate (latitude/lapse
// temp, moisture with belts + coastal bonus) -> hydrology (steepest-descent rivers + lake pits) ->
// BIOME_CATALOG classification (with river/lake/vent/endorheic overrides). Scratch buffers live in
// fields (freed at the end) so passes share them without array-copy semantics.
//
// The elevation stages are ElevationPass implementations. Landmass builds a height field for the
// whole map and floods it -- continents are whatever stays above water, never a placement decision
// -- and hands its plate partition on through WorldField; Tectonics then deforms the boundaries.
program AgentsExe;

public bundle Agents {
    public namespace World {

        // One stage of elevation construction, so the pipeline is a list rather than a hardcoded
        // call chain and each stage can be tested on its own.
        public interface ElevationPass {
            method name() returns String;
            method apply(WorldField* f) returns void;
        }

        // One stage of world CONTENT, run after the terrain is classified: it reads the finished
        // Grid -- and the generation field behind it, which still knows where the plates and the
        // boundaries were -- and writes into the layers the game is played on.
        public interface WorldPass {
            method name() returns String;
            method apply(Grid* g, WorldField* f) returns void;
        }

        // The scratch shared by the passes: dimensions, parameters and the elevation field.
        // Owned by WorldGen for the duration of generate().
        public class WorldField {
            public mutable int w;
            public mutable int h;
            public mutable int seed;
            public mutable int worldType;
            public mutable int nContinents;
            public mutable float landRatio;
            public mutable float sea;
            public mutable float[] eb;

            // The plate partition, filled in by Landmass and read by Tectonics. It lives on the
            // COARSE grid (pw x ph): boundary physics works at the scale of a plate margin, and a
            // full-resolution copy would cost 15 MB to say the same thing.
            public mutable int pw;
            public mutable int ph;
            public mutable int nPlates;
            public mutable int nCont;
            public mutable int[] plate;      // pw*ph -> plate id
            public mutable int[] pkind;      // 0 oceanic, 1 craton, 2 island craton
            public mutable int[] pcont;      // continent id, or -1
            public mutable float[] pmx;      // plate drift, unit vector
            public mutable float[] pmy;
            public mutable byte[] vent;      // full res: 1 where Tectonics put a volcano
            // Where the crust came from, published by Tectonics and read by the ore pass. Placing
            // metals by biome would be arbitrary; placing them by the boundary that made the rock is
            // what the real world does, and the classification already exists -- it was simply
            // thrown away once the relief had been applied.
            public mutable byte[] borigin;   // coarse: kind of the nearest boundary (Tectonics.B_*)
            public mutable float[] bnear;    // coarse: 0 far from it, 1 on it

            public constructor WorldField(int w, int h, int seed) {
                this.w = w;
                this.h = h;
                this.seed = seed;
                this.worldType = 0;
                this.nContinents = 6;
                this.landRatio = 0.0 - 1.0;
                this.sea = 0.42;
                this.eb = new float[w * h]();
                this.pw = 1;
                this.ph = 1;
                this.nPlates = 0;
                this.nCont = 0;
                this.plate = new int[1]();
                this.pkind = new int[1]();
                this.pcont = new int[1]();
                this.pmx = new float[1]();
                this.pmy = new float[1]();
                this.vent = new byte[w * h]();
                this.borigin = new byte[1]();
                this.bnear = new float[1]();
            }

            public destructor ~WorldField() returns void {
                delete this.eb;
                delete this.plate;
                delete this.pkind;
                delete this.pcont;
                delete this.pmx;
                delete this.pmy;
                delete this.vent;
                delete this.borigin;
                delete this.bnear;
            }

            // Plate id at a FULL-resolution cell.
            public method plateAt(int x, int y) returns int {
                mutable int gx = x * this.pw / this.w;
                mutable int gy = y * this.ph / this.h;
                if (gx >= this.pw) {
                    gx = this.pw - 1;
                }
                if (gy >= this.ph) {
                    gy = this.ph - 1;
                }
                if (gx < 0) {
                    gx = 0;
                }
                if (gy < 0) {
                    gy = 0;
                }
                return this.plate[gy * this.pw + gx];
            }

            public method idx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }
        }

        public class WorldGen {
            private mutable int seed;
            private mutable int octaves;
            private mutable int baseCells;
            private mutable float sea;          // sea level in [0,1] -- the flood contour Landmass reports
            private mutable int worldType;      // 0 Continents, 1 Pangaea, 2 Archipelago, 3 InlandSeas
            private mutable float landRatio;    // fraction of the map that is land; < 0 = use world default
            private mutable int nContinents;    // Continental mode: number of continents; <= 0 = auto by aspect

            private mutable int w;
            private mutable int h;

            // scratch (allocated in generate, freed at the end)
            private mutable float[] eb;         // elevation 0..1
            private mutable int[] wtr;          // ring distance to water
            private mutable int[] dn;           // downstream cell index, or -1
            private mutable float[] fl;         // flow accumulation
            private mutable float[] fld;        // pit/flat-filled elevation (priority-flood)
            private mutable float[] hkey;       // binary min-heap: keys (flood elevation)
            private mutable int[] hval;         // binary min-heap: values (cell index)

            public constructor WorldGen(int seed) {
                this.seed = seed;
                this.octaves = 6;
                this.baseCells = 3;
                this.sea = 0.42;
                this.worldType = 0;
                this.landRatio = 0.0 - 1.0;
                this.nContinents = 0;
            }

            // Continental mode only: how many distinct continents to grow (<= 0 keeps the aspect-based
            // default). A New-Game knob.
            public method setContinents(int n) returns void {
                this.nContinents = n;
            }

            // Pick a world shape (0 Continents, 1 Pangaea, 2 Archipelago, 3 InlandSeas) and the fraction of
            // the map that should be land. A land < 0 keeps the world's default ratio.
            public method setWorld(int worldType, float land) returns void {
                this.worldType = worldType;
                this.landRatio = land;
            }

            private method defaultLand(int t) returns float {
                if (t == 1) {
                    return 0.40;
                }
                if (t == 2) {
                    return 0.22;
                }
                if (t == 3) {
                    return 0.72;
                }
                return 0.38;
            }

            // ---- integer hash / value noise / fbm (seamless in X) ----
            private method hash01(int xi, int yi) returns float {
                mutable int n = xi * 374761393;
                n = n + yi * 668265263;
                n = n + this.seed * 1442695041;
                n = n ^ (n >> 13);
                n = n * 1274126177;
                n = n ^ (n >> 16);
                int m = n & 2147483647;
                return cast<float>(m) / 2147483647.0;
            }

            private method smooth(float t) returns float {
                return t * t * (3.0 - 2.0 * t);
            }

            private method vnoise(float fx, float fy, int period) returns float {
                int x0 = cast<int>(fx);
                int y0 = cast<int>(fy);
                float tx = fx - cast<float>(x0);
                float ty = fy - cast<float>(y0);
                int x0w = x0 % period;
                int x1w = (x0 + 1) % period;
                float sx = this.smooth(tx);
                float sy = this.smooth(ty);
                float a = this.hash01(x0w, y0);
                float b = this.hash01(x1w, y0);
                float c = this.hash01(x0w, y0 + 1);
                float d = this.hash01(x1w, y0 + 1);
                float ab = a + (b - a) * sx;
                float cd = c + (d - c) * sx;
                return ab + (cd - ab) * sy;
            }

            private method fbm(int x, int y, int salt) returns float {
                float nx = cast<float>(x) / cast<float>(this.w);
                float ny = cast<float>(y) / cast<float>(this.h);
                mutable float sum = 0.0;
                mutable float amp = 1.0;
                mutable float tot = 0.0;
                mutable int cells = this.baseCells + salt;
                mutable int o = 0;
                while (o < this.octaves) {
                    float v = this.vnoise(nx * cast<float>(cells), ny * cast<float>(cells), cells);
                    sum = sum + v * amp;
                    tot = tot + amp;
                    amp = amp * 0.5;
                    cells = cells * 2;
                    o = o + 1;
                }
                return sum / tot;
            }

            // scratch index with X wrap, Y clamp (parallel to Grid layout)
            private method sidx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }

            // ---- pass 3: thermal erosion (a few relaxation passes, 4-neighbour) ----
            private method erode(int passes) returns void {
                mutable int p = 0;
                while (p < passes) {
                    mutable int y = 0;
                    while (y < this.h) {
                        mutable int x = 0;
                        while (x < this.w) {
                            int i = y * this.w + x;
                            float c = this.eb[i];
                            float l = this.eb[this.sidx(x - 1, y)];
                            float r = this.eb[this.sidx(x + 1, y)];
                            float u = this.eb[this.sidx(x, y - 1)];
                            float dn2 = this.eb[this.sidx(x, y + 1)];
                            float avg = (l + r + u + dn2) * 0.25;
                            this.eb[i] = c * 0.6 + avg * 0.4;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    p = p + 1;
                }
            }

            // ---- pass 4: climate (temperature, moisture with belts + coastal bonus) ----
            private method belt(float alat) returns float {
                if (alat < 0.12) {
                    return 0.90;
                }
                if (alat < 0.36) {
                    float t = (alat - 0.12) / 0.24;
                    return 0.90 - 0.70 * t;
                }
                if (alat < 0.66) {
                    float t = (alat - 0.36) / 0.30;
                    return 0.20 + 0.50 * t;
                }
                float t = (alat - 0.66) / 0.34;
                return 0.70 - 0.50 * t;
            }

            private method absLat(int y) returns float {
                float ny = cast<float>(y) / cast<float>(this.h - 1);
                mutable float d = 2.0 * ny - 1.0;
                if (d < 0.0) {
                    d = 0.0 - d;
                }
                return d;
            }

            // ring distance to the nearest water cell (approximate, K dilation passes)
            private method distToWater(int rings) returns void {
                mutable int i = 0;
                int n = this.w * this.h;
                while (i < n) {
                    if (this.eb[i] < this.sea) {
                        this.wtr[i] = 0;
                    } else {
                        this.wtr[i] = 9999;
                    }
                    i = i + 1;
                }
                mutable int p = 0;
                while (p < rings) {
                    mutable int y = 0;
                    while (y < this.h) {
                        mutable int x = 0;
                        while (x < this.w) {
                            int idx = y * this.w + x;
                            mutable int m = this.wtr[idx];
                            int a = this.wtr[this.sidx(x - 1, y)] + 1;
                            int b = this.wtr[this.sidx(x + 1, y)] + 1;
                            int c = this.wtr[this.sidx(x, y - 1)] + 1;
                            int e = this.wtr[this.sidx(x, y + 1)] + 1;
                            if (a < m) { m = a; }
                            if (b < m) { m = b; }
                            if (c < m) { m = c; }
                            if (e < m) { m = e; }
                            this.wtr[idx] = m;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    p = p + 1;
                }
            }

            private method climate(Grid* g) returns void {
                // 32 rings: how far ocean moisture reaches inland. 8 cells on a 2560-wide map died
                // inside the beach band, so no m>=0.8 biome (rainforest/wetland/ice cap) ever formed;
                // 32 gives real coastal climate bands with a continental dry interior.
                int rings = 32;
                this.distToWater(rings);
                mutable int y = 0;
                while (y < this.h) {
                    float alat = this.absLat(y);
                    float latBand = 1.0 - alat;
                    float beltM = this.belt(alat);
                    mutable int x = 0;
                    while (x < this.w) {
                        int i = y * this.w + x;
                        float e = this.eb[i];
                        mutable float lapse = 0.0;
                        if (e > this.sea) {
                            // 0.75: high ground cools into rock/glacier/meadow bands without
                            // freezing whole continents (0.9 froze everything above e~0.70)
                            lapse = 0.75 * (e - this.sea);
                        }
                        float tnoise = (this.fbm(x, y, 17) - 0.5) * 0.14;   // wavy climate bands, not straight lines
                        mutable float t = latBand - lapse + tnoise;
                        if (t < 0.0) { t = 0.0; }
                        if (t > 1.0) { t = 1.0; }
                        float mn = this.fbm(x, y, 37);
                        mutable float coast = 0.0;
                        if (this.wtr[i] < rings) {
                            coast = 1.0 - cast<float>(this.wtr[i]) / cast<float>(rings);
                        }
                        // coast-heavy blend: oceans are where moisture comes from -- the top decile
                        // (rainforests, wetlands, ice caps) forms along wet coasts and fades inland
                        mutable float m = 0.46 * mn + 0.26 * beltM + 0.28 * coast;
                        // Stretch the contrast around the mean: the raw blend almost never leaves
                        // [0.2, 0.8], so every m>=0.80 biome (wetlands, rainforests, IceCap) and most
                        // m<0.20 deserts NEVER generated. Widening both tails puts the whole Whittaker
                        // table in play.
                        m = 0.5 + (m - 0.5) * 1.6;
                        if (m > 1.0) { m = 1.0; }
                        if (m < 0.0) { m = 0.0; }
                        g.setTemp(x, y, cast<int>(t * 100.0));
                        g.setMoist(x, y, cast<int>(m * 100.0));
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }

            // ---- pass 5: hydrology (steepest descent -> rivers; pits -> lakes) ----
            // Binary min-heap over (flood-elevation key, cell value). Push bubbles the new leaf up.
            private method heapPush(int hn, float key, int val) returns int {
                mutable int c = hn;
                while (c > 0) {
                    int p = (c - 1) / 2;
                    if (this.hkey[p] <= key) {
                        break;
                    }
                    this.hkey[c] = this.hkey[p];
                    this.hval[c] = this.hval[p];
                    c = p;
                }
                this.hkey[c] = key;
                this.hval[c] = val;
                return hn + 1;
            }

            // Remove the minimum (already read from index 0 by the caller): move the last leaf to the root
            // and sift it down. Returns the new size.
            private method heapPop(int hn) returns int {
                int newn = hn - 1;
                float key = this.hkey[newn];
                int val = this.hval[newn];
                mutable int c = 0;
                while (true) {
                    int l = 2 * c + 1;
                    if (l >= newn) {
                        break;
                    }
                    mutable int child = l;
                    int rr = l + 1;
                    if (rr < newn && this.hkey[rr] < this.hkey[l]) {
                        child = rr;
                    }
                    if (this.hkey[child] >= key) {
                        break;
                    }
                    this.hkey[c] = this.hkey[child];
                    this.hval[c] = this.hval[child];
                    c = child;
                }
                this.hkey[c] = key;
                this.hval[c] = val;
                return newn;
            }

            // Priority-Flood + epsilon (Barnes et al.): flood inward from the sea through a min-heap, so
            // every land cell gets a monotonic downhill path to the ocean. This fills pits AND resolves
            // flats (a tiny epsilon gradient), and the order in which cells are discovered IS the drainage
            // tree -- each cell drains to the neighbour that reached it -- giving convergent, dendritic
            // rivers with no straight parallel-diagonal artifacts. Filled depressions become lakes.
            // Permanent ice -- an icecap or a glacier. Not a channel: it is the thing a river starts
            // BELOW. Snowfield is deliberately excluded, because snowfield melts and a river may
            // both rise on it and cross it. The tests mirror classify's own so the two agree.
            private method glaciated(Grid* g, int x, int y, float e) returns boolean {
                float t = cast<float>(g.tempAt(x, y)) / 100.0;
                float m = cast<float>(g.moistAt(x, y)) / 100.0;
                if (t < 0.05) {
                    return true;                                  // IceCap: nothing melts
                }
                if (t < 0.15 && m >= 0.80) {
                    return true;                                  // IceCap: wet polar
                }
                if (e >= 0.63) {
                    if (t < 0.10) {
                        return true;                              // Glacier
                    }
                    if (e >= 0.70 && t < 0.22) {
                        return true;                              // Glacier
                    }
                    if (e >= 0.74 && this.absLat(y) >= 0.52) {
                        return true;                              // Glacier
                    }
                }
                return false;
            }

            private method hydrology(Grid* g) returns void {
                int n = this.w * this.h;
                float eps = 0.00001;
                // wtr is free after climate(): reuse it as the visited flag.
                mutable int i = 0;
                while (i < n) {
                    this.wtr[i] = 0;
                    this.fld[i] = this.eb[i];
                    this.dn[i] = 0 - 1;
                    this.fl[i] = 1.0;
                    i = i + 1;
                }
                // Seed the heap with every sea cell (the outlets, at their true elevation).
                mutable int hn = 0;
                mutable int s = 0;
                while (s < n) {
                    if (this.eb[s] < this.sea) {
                        this.wtr[s] = 1;
                        hn = this.heapPush(hn, this.eb[s], s);
                    }
                    s = s + 1;
                }
                // A fully-land world (no sea) still needs an outlet: seed the single lowest cell.
                if (hn == 0) {
                    mutable int lo = 0;
                    mutable int k = 1;
                    while (k < n) {
                        if (this.eb[k] < this.eb[lo]) {
                            lo = k;
                        }
                        k = k + 1;
                    }
                    this.wtr[lo] = 1;
                    hn = this.heapPush(hn, this.eb[lo], lo);
                }
                int[] order = new int[n]();   // pop order, for downstream flow accumulation in reverse
                mutable int oc = 0;
                while (hn > 0) {
                    int cell = this.hval[0];
                    float cfld = this.hkey[0];
                    hn = this.heapPop(hn);
                    order[oc] = cell;
                    oc = oc + 1;
                    int cx = cell % this.w;
                    int cy = cell / this.w;
                    mutable int oy = 0 - 1;
                    while (oy <= 1) {
                        mutable int ox = 0 - 1;
                        while (ox <= 1) {
                            if (!(ox == 0 && oy == 0)) {
                                int nyy = cy + oy;
                                if (nyy >= 0 && nyy < this.h) {
                                    int j = this.sidx(cx + ox, nyy);
                                    if (this.wtr[j] == 0) {
                                        this.wtr[j] = 1;
                                        mutable float nf = this.eb[j];
                                        if (nf < cfld + eps) {
                                            nf = cfld + eps;
                                        }
                                        this.fld[j] = nf;
                                        this.dn[j] = cell;
                                        hn = this.heapPush(hn, nf, j);
                                    }
                                }
                            }
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                }
                // Re-route each land cell to its STEEPEST fld neighbour instead of the discovery
                // parent: on smooth slopes the flood wavefront sweeps uniformly, so parent links run
                // in straight parallel diagonals (the "rivers that never connect"). Steepest descent
                // on the filled surface follows the actual valleys, so tributaries CONVERGE into a
                // dendritic network -- and fld is pit-free (epsilon), so descent always reaches the
                // sea. The reverse-fld accumulation order below stays valid for any descending link.
                mutable int rc = 0;
                while (rc < n) {
                    if (this.dn[rc] != 0 - 1) {
                        int rcx = rc % this.w;
                        int rcy = rc / this.w;
                        mutable float bestF = this.fld[rc];
                        mutable int bestJ = 0 - 1;
                        mutable int ry = 0 - 1;
                        while (ry <= 1) {
                            mutable int rx = 0 - 1;
                            while (rx <= 1) {
                                if (!(rx == 0 && ry == 0)) {
                                    int nxx = rcx + rx;
                                    int nyy = rcy + ry;
                                    if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                        int j = nyy * this.w + nxx;
                                        if (this.fld[j] < bestF) {
                                            bestF = this.fld[j];
                                            bestJ = j;
                                        }
                                    }
                                }
                                rx = rx + 1;
                            }
                            ry = ry + 1;
                        }
                        if (bestJ != 0 - 1) {
                            this.dn[rc] = bestJ;
                        }
                    }
                    rc = rc + 1;
                }
                // Flow accumulation: leaves first (reverse discovery order), pushing flow downstream.
                mutable int r = oc - 1;
                while (r >= 0) {
                    int cell = order[r];
                    int d = this.dn[cell];
                    if (d != 0 - 1) {
                        this.fl[d] = this.fl[d] + this.fl[cell];
                    }
                    r = r - 1;
                }
                // CHANNEL CAPTURE: a channel running right beside a bigger one gets absorbed by it.
                // Steepest descent alone can keep two parallel channels one cell apart for long
                // stretches (and braid ugly knots at junctions); re-aiming every cell at its
                // largest-flow downhill neighbour merges the minor channel into the major, then the
                // accumulation is recomputed over the same (still strictly descending) order.
                mutable int cc = 0;
                while (cc < n) {
                    if (this.dn[cc] != 0 - 1) {
                        int ccx = cc % this.w;
                        int ccy = cc / this.w;
                        mutable float bestFl = 0.0 - 1.0;
                        mutable int bestJ = 0 - 1;
                        mutable int cy2 = 0 - 1;
                        while (cy2 <= 1) {
                            mutable int cx2 = 0 - 1;
                            while (cx2 <= 1) {
                                if (!(cx2 == 0 && cy2 == 0)) {
                                    int nxx = ccx + cx2;
                                    int nyy = ccy + cy2;
                                    if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                        int j = nyy * this.w + nxx;
                                        if (this.fld[j] < this.fld[cc] && this.fl[j] > bestFl) {
                                            bestFl = this.fl[j];
                                            bestJ = j;
                                        }
                                    }
                                }
                                cx2 = cx2 + 1;
                            }
                            cy2 = cy2 + 1;
                        }
                        if (bestJ != 0 - 1) {
                            this.dn[cc] = bestJ;
                        }
                    }
                    cc = cc + 1;
                }
                // Rivers never climb, and never touch permanent ice. Both were visible in one shot:
                // a channel rising on an icecap, running clean across it, then going UP a mountain
                // and back down the far side.
                //
                // The pit-filled surface is monotonic by construction, but it is not the real one --
                // a spill path out of a filled basin crosses the rim, and the rim can be genuinely
                // higher than the ground the water came from. So the link is re-tested against the
                // REAL elevation, and a link that would climb is replaced by one that does not, or
                // cut. Cutting is the right answer, not a failure: the water pools where it stops,
                // which is what it does in reality, and the cell is already a lake by the fld test.
                // A link into ice is treated the same way, so the channel routes AROUND a glacier
                // instead of through it -- and the mountain itself is never touched.
                mutable int vv = 0;
                while (vv < n) {
                    int d0 = this.dn[vv];
                    if (d0 != 0 - 1) {
                        int vx = vv % this.w;
                        int vy = vv / this.w;
                        boolean iceHere = this.glaciated(g, vx, vy, this.eb[vv]);
                        boolean climbs = this.eb[d0] > this.eb[vv] + 0.0005;
                        boolean intoIce = this.glaciated(g, d0 % this.w, d0 / this.w, this.eb[d0]);
                        if (iceHere) {
                            this.dn[vv] = 0 - 1;
                        } else if (climbs || intoIce) {
                            mutable float bestE = this.eb[vv];
                            mutable int bj = 0 - 1;
                            mutable int vy2 = 0 - 1;
                            while (vy2 <= 1) {
                                mutable int vx2 = 0 - 1;
                                while (vx2 <= 1) {
                                    if (!(vx2 == 0 && vy2 == 0)) {
                                        int nxx = vx + vx2;
                                        int nyy = vy + vy2;
                                        if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                            int j = nyy * this.w + nxx;
                                            // still strictly descending on fld, so the accumulation
                                            // order below stays valid
                                            if (this.fld[j] < this.fld[vv] && this.eb[j] <= bestE
                                                && !this.glaciated(g, nxx, nyy, this.eb[j])) {
                                                bestE = this.eb[j];
                                                bj = j;
                                            }
                                        }
                                    }
                                    vx2 = vx2 + 1;
                                }
                                vy2 = vy2 + 1;
                            }
                            this.dn[vv] = bj;
                        }
                    }
                    vv = vv + 1;
                }
                mutable int z = 0;
                while (z < n) {
                    this.fl[z] = 1.0;
                    z = z + 1;
                }
                r = oc - 1;
                while (r >= 0) {
                    int cell = order[r];
                    int d = this.dn[cell];
                    if (d != 0 - 1) {
                        this.fl[d] = this.fl[d] + this.fl[cell];
                    }
                    r = r - 1;
                }
                // Classify hydrographic features: a cell filled well above its real height is a lake;
                // otherwise a land cell carrying enough flow is a river, drawn toward its downstream cell.
                float riverThr = cast<float>(this.w) * 0.14;
                mutable int q = 0;
                while (q < n) {
                    int x = q % this.w;
                    int y = q / this.w;
                    if (this.eb[q] >= this.sea) {
                        if (this.fld[q] > this.eb[q] + 0.005) {
                            g.setFlag(x, y, Grid.FLAG_LAKE);
                        } else if (this.dn[q] == 0 - 1 && this.fl[q] > riverThr) {
                            // A channel whose link was cut for climbing or for running into ice has
                            // to END somewhere. It ends in a pool -- a proglacial lake at the ice
                            // margin, or a terminal lake against the ridge it may not climb. Without
                            // this the river simply stopped in open grass, which reads as broken.
                            g.setFlag(x, y, Grid.FLAG_LAKE);
                        } else {
                            if (this.dn[q] != 0 - 1 && this.fl[q] > riverThr) {
                                g.setFlag(x, y, Grid.FLAG_RIVER);
                                int d = this.dn[q];
                                mutable int gdx = d % this.w - x;
                                if (gdx > 1) {
                                    gdx = gdx - this.w;
                                }
                                if (gdx < 0 - 1) {
                                    gdx = gdx + this.w;
                                }
                                g.setFlowDir(x, y, gdx, d / this.w - y);
                            }
                        }
                    }
                    q = q + 1;
                }
                delete order;
            }

            // ---- pass 6: classify every cell into a Biome ordinal ----
            private method classifyAll(Grid* g) returns void {
                mutable int y = 0;
                while (y < this.h) {
                    mutable int x = 0;
                    while (x < this.w) {
                        int i = y * this.w + x;
                        float e = this.eb[i];
                        float t = cast<float>(g.tempAt(x, y)) / 100.0;
                        float m = cast<float>(g.moistAt(x, y)) / 100.0;
                        int fg = g.flagsAt(x, y);
                        g.setElev(x, y, cast<int>(e * 10000.0));
                        g.setBiome(x, y, this.classify(e, t, m, fg, this.wtr[i], x, y));
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }

            private method classify(float e, float t, float m, int fg, int distw, int x, int y) returns int {
                // hard overrides. NOTE: a river cell keeps its terrain biome -- the renderer draws a blue
                // channel over the land following the stored flow direction (spec: rivers wind through
                // terrain, they don't paint the whole tile). Lakes and vents still recolour the cell.
                // Volcanic lands live on HIGH ground near the convergent ridges, and volcanic ARCS
                // hug the coast (distw): where a subduction boundary runs deep under a continent's
                // interior, the same uplift shows as an ordinary mountain range instead.
                // A vent is now PLACED, by Tectonics, on the volcanic arc of a subduction zone --
                // so it is trusted. The old distance-to-water gate existed to stop volcanic blobs
                // appearing wherever noise happened to peak inland; it would also have cut the real
                // arcs, which sit tens of cells behind the coastal range.
                if ((fg & Grid.FLAG_VENT) != 0 && e >= this.sea && e >= 0.55) { return cast<int>(Biome.Volcanic); }
                if ((fg & Grid.FLAG_LAKE) != 0 && e >= this.sea) {
                    // a basin in a bone-dry climate is a dried-up salt flat, not a lake
                    if (m < 0.22) { return cast<int>(Biome.SaltFlat); }
                    return cast<int>(Biome.Lake);
                }
                // water -- depth bands RELATIVE to the percentile sea level (absolute cuts squeezed
                // whole bands out of existence whenever the sea level moved)
                if (e < this.sea) {
                    // sea ice is a SURFACE sheet -- it covers polar water of any depth, so it must
                    // outrank the depth bands
                    if (t < 0.15) { return cast<int>(Biome.SeaIce); }
                    // trenches only in the deep INTERIOR basins -- the border falloff also drives
                    // elevation under the trench cut, which drew an artificial trench ring hugging
                    // the map edges (the "giant trench in the south")
                    if (e < this.sea - 0.21 && !this.nearEdge(x, y)) { return cast<int>(Biome.MarineTrench); }
                    if (e < this.sea - 0.09) { return cast<int>(Biome.DeepOcean); }
                    if (e >= this.sea - 0.03) {
                        // reefs are scattered ATOLL PATCHES in warm shallows, not a carpet over the
                        // whole tropical band -- a coarse noise mask keeps ~1 in 6 warm shallows
                        if (t >= 0.85 && m >= 0.80) {
                            float rn = this.vnoise(cast<float>(x) / cast<float>(this.w) * 23.0,
                                                   cast<float>(y) / cast<float>(this.h) * 23.0, 23);
                            if (rn > 0.62) { return cast<int>(Biome.CoralReef); }
                        }
                        return cast<int>(Biome.ShallowSea);
                    }
                    return cast<int>(Biome.Ocean);
                }
                // coast: low ground TOUCHING the water (distw), not every low flat -- a wide flat
                // shelf inland of the shore is ordinary lowland, not kilometres of beach/rocky shore
                if (e < this.sea + 0.03 && distw <= 2) {
                    if (t >= 0.85 && m >= 0.60) { return cast<int>(Biome.Mangrove); }
                    if (t < 0.35) { return cast<int>(Biome.RockyShore); }
                    return cast<int>(Biome.Beach);
                }
                // peaks & mountains: the SNOW LINE is pure altitude (high enough = snow, whatever
                // the tuning of latitude/lapse does), and the band under it partitions by climate --
                // cold face = glacier, warm wet shoulder = alpine meadow, the rest bare rock.
                if (e >= 0.80) {
                    return cast<int>(Biome.SnowPeak);
                }
                if (e >= 0.74) {
                    // poleward half of the map: high ridges carry glaciers (latitude directly, so
                    // the band survives any lapse/temperature retuning)
                    if (this.absLat(y) >= 0.52) { return cast<int>(Biome.Glacier); }
                    if (m >= 0.45) { return cast<int>(Biome.AlpineMeadow); }
                    return cast<int>(Biome.Mountain);
                }
                // 0.63 is THE contract line, shared by three places that must agree: Landmass caps
                // ordinary land below it, the renderer's stackLvl starts stacking at it, and the
                // highland biomes begin here. When this said 0.58 the flat plateau interiors landed
                // in the mountain band and half the world came out as hills and badlands.
                if (e >= 0.63) {
                    // cold high ground ices over -- glacier tongues wherever the seed actually put
                    // its poleward ranges, whatever the lapse/latitude tuning does
                    if (e >= 0.70 && t < 0.22) { return cast<int>(Biome.Glacier); }
                    if (t < 0.10) { return cast<int>(Biome.Glacier); }
                    if (m < 0.26) { return cast<int>(Biome.Badlands); }
                    if (t < 0.28) { return cast<int>(Biome.Mountain); }   // truly cold highland (glacier rims) = rock
                    // the green shoulder under the peaks: warm-enough, wet-enough high ground
                    // (0.64: anchored to where warm land actually exists -- a seed can roll every
                    // tall ridge into polar latitudes, and the meadow must survive that)
                    if (e >= 0.64 && t >= 0.30 && m >= 0.32) { return cast<int>(Biome.AlpineMeadow); }
                    return cast<int>(Biome.Hills);
                }
                // lowland specials
                if (m < 0.20 && (fg & Grid.FLAG_ENDORHEIC) != 0) { return cast<int>(Biome.SaltFlat); }
                // An oasis is a RARE, isolated pool cell inside hot desert -- not a coastal band.
                if (t >= 0.55 && m < 0.20 && this.hash01(x * 13 + 7, y * 17 + 3) > 0.995) {
                    return cast<int>(Biome.Oasis);
                }
                // wetlands (a cold bog waterlogs at lower moisture -- barely any evaporation)
                if (t < 0.35 && m >= 0.78) { return cast<int>(Biome.Bog); }
                if (m >= 0.84) {
                    if (t >= 0.78) { return cast<int>(Biome.Swamp); }
                    return cast<int>(Biome.Marsh);
                }
                return this.whittaker(t, m);
            }

            // Inside the outer 10% frame of the map, where the border-ocean falloff (not geology)
            // controls the depth.
            private method nearEdge(int x, int y) returns boolean {
                int bx = this.w / 10;
                int by = this.h / 10;
                if (x < bx || x >= this.w - bx) {
                    return true;
                }
                if (y < by || y >= this.h - by) {
                    return true;
                }
                return false;
            }

            private method whittaker(float t, float m) returns int {
                // below ~0.05 nothing melts, regardless of how little falls: permanent ice cap --
                // this is what covers the extreme polar strips (the belt model keeps poles dry, so
                // the m>=0.80 route alone never fired there)
                if (t < 0.05) { return cast<int>(Biome.IceCap); }
                if (t < 0.15) {
                    if (m < 0.20) { return cast<int>(Biome.ColdDesert); }
                    if (m < 0.60) { return cast<int>(Biome.Tundra); }
                    if (m < 0.80) { return cast<int>(Biome.Snowfield); }
                    return cast<int>(Biome.IceCap);
                }
                if (t < 0.35) {
                    if (m < 0.20) { return cast<int>(Biome.ColdDesert); }
                    if (m < 0.40) { return cast<int>(Biome.Steppe); }
                    return cast<int>(Biome.Taiga);
                }
                if (t < 0.55) {
                    if (m < 0.20) { return cast<int>(Biome.ColdDesert); }
                    if (m < 0.40) { return cast<int>(Biome.Steppe); }
                    if (m < 0.60) { return cast<int>(Biome.Prairie); }
                    if (m < 0.80) { return cast<int>(Biome.DeciduousForest); }
                    return cast<int>(Biome.TemperateRainforest);
                }
                if (t < 0.78) {
                    if (m < 0.20) { return cast<int>(Biome.HotDesert); }
                    if (m < 0.40) { return cast<int>(Biome.ThornScrub); }
                    if (m < 0.60) { return cast<int>(Biome.MedShrubland); }
                    if (m < 0.80) { return cast<int>(Biome.WarmGrassland); }
                    return cast<int>(Biome.LaurelForest);
                }
                if (m < 0.20) { return cast<int>(Biome.HotDesert); }
                if (m < 0.40) { return cast<int>(Biome.Savanna); }
                if (m < 0.60) { return cast<int>(Biome.TropSeasonalForest); }
                return cast<int>(Biome.TropicalRainforest);
            }

            public method generate(int w, int h) returns Grid* {
                this.w = w;
                this.h = h;
                // Generation descriptors live in one arena freed in a single call; the big per-cell
                // grids stay explicit heap arrays.
                region descriptors = itself.allocate(4 megabytes);
                defer {
                    release region descriptors;
                }
                int n = w * h;
                Grid* g = new Grid(w, h) on heap;
                this.eb = new float[n]();
                this.wtr = new int[n]();
                this.dn = new int[n]();
                this.fl = new float[n]();
                this.fld = new float[n]();
                this.hkey = new float[n]();
                this.hval = new int[n]();

                // Elevation is built by the passes, through the interface: Landmass builds the
                // relief and floods it, then (from the next slice) Tectonics deforms the plate
                // boundaries it left behind.
                WorldField* wf = new WorldField(w, h, this.seed) on heap;
                wf.worldType = this.worldType;
                wf.nContinents = this.nContinents;
                mutable float land = this.landRatio;
                if (land < 0.0) {
                    land = this.defaultLand(this.worldType);
                }
                wf.landRatio = land;
                Landmass* landPass = new Landmass(this.seed) on heap;
                mutable ElevationPass* pass = landPass;
                pass.apply(wf);
                Tectonics* tecPass = new Tectonics(this.seed) on heap;
                pass = tecPass;
                pass.apply(wf);
                mutable int ci = 0;
                while (ci < n) {
                    this.eb[ci] = wf.eb[ci];
                    if (cast<int>(wf.vent[ci]) != 0) {
                        g.setFlag(ci % w, ci / w, Grid.FLAG_VENT);
                    }
                    ci = ci + 1;
                }
                // Erosion now happens inside Landmass, on the raw field BEFORE the flood: running
                // it here averaged coastal land against the ocean next to it and quietly ate 6
                // points of the land ratio.
                //
                // The flood already placed the coastline at the requested land ratio, so the sea
                // level is whatever contour it chose -- not a number tuned here.
                this.sea = wf.sea;
                this.climate(g);
                this.hydrology(g);
                // hydrology reused wtr as its visited flag -- rebuild the distance-to-water field
                // classify needs (coast band <= 2, volcanic-arc gate <= 24)
                this.distToWater(24);
                this.classifyAll(g);
                // Content passes: the terrain is settled, and what LIVES on it goes in now.
                Flora* floraPass = new Flora(this.seed) on heap;
                mutable WorldPass* content = floraPass;
                content.apply(g, wf);
                // Groundcover reads what Flora wrote -- undergrowth is defined by where the trees
                // are -- so the order here is a real dependency, not a preference.
                Groundcover* coverPass = new Groundcover(this.seed) on heap;
                content = coverPass;
                content.apply(g, wf);
                Deposits* orePass = new Deposits(this.seed) on heap;
                content = orePass;
                content.apply(g, wf);
                // Every pass appended in whatever order suited it; sort the surface nodes into cell
                // order once, now that they are all in, so the renderer can walk a row of them in
                // step with its own loop.
                g.surface().finish();

                delete orePass;
                delete coverPass;
                delete floraPass;
                delete landPass;
                delete tecPass;
                delete wf;
                delete this.eb;
                delete this.wtr;
                delete this.dn;
                delete this.fl;
                delete this.fld;
                delete this.hkey;
                delete this.hval;
                return g;
            }

            // Generation is a SEARCH, and this is the half of it that was missing.
            //
            // WorldAudit exists to say whether a generated world is worth playing, and until now the
            // only thing that ever asked it was a `preview` mode run by hand: the game itself took
            // whatever the first roll produced. Three seeds in twelve produce a world the project's
            // own criteria reject -- one continent and five scraps, or fourteen islands -- and three
            // players in twelve got that world with nothing to tell them it was not the intended
            // shape. So roll again.
            //
            // The retry seed is derived from the one that failed, so the same starting seed still
            // gives the same world: a search, not a lottery. `tries` bounds it; if nothing passes,
            // the last roll is returned rather than nothing, because a flawed world beats no world
            // and the caller has been told which criterion it failed.
            private static method rollOnce(int seed, int worldType, float land, int continents,
                                           int w, int h) returns Grid* {
                WorldGen gen = new WorldGen(seed) on stack;
                gen.setWorld(worldType, land);
                if (continents > 0) {
                    gen.setContinents(continents);
                }
                return gen.generate(w, h);
            }

            public static method acceptable(int seed, int worldType, float land, int continents,
                                            int w, int h, int tries, boolean loud) returns Grid* {
                int want = 6;
                mutable Grid* kept = WorldGen.rollOnce(seed, worldType, land, continents, w, h);
                mutable int attempt = 0;
                mutable boolean settled = false;
                while (!settled) {
                    WorldAudit* wa = new WorldAudit(kept) on heap;
                    wa.analyse();
                    int v = wa.verdict(want);
                    String why = wa.reasonName(v);
                    delete wa;
                    attempt = attempt + 1;
                    if (v == 0) {
                        if (loud && attempt > 1) {
                            System.IO.Console.println($"world: accepted on roll {attempt}");
                        }
                        settled = true;
                    } else {
                        if (attempt >= tries) {
                            if (loud) {
                                System.IO.Console.println($"world: no roll passed in {tries}; keeping the last, which fails on {why}");
                            }
                            settled = true;
                        } else {
                            if (loud) {
                                System.IO.Console.println($"world: roll {attempt} fails on {why}, rolling again");
                            }
                            delete kept;
                            kept = WorldGen.rollOnce(seed + attempt * 7717, worldType, land,
                                                     continents, w, h);
                        }
                    }
                }
                return kept;
            }
        }

        // A tiny local RNG for plate seeding (unit float helper), independent of the spatial hash.
        public class Rng2 {
            private mutable long state;

            public constructor Rng2(int seed) {
                mutable long s = cast<long>(seed);
                if (s <= 0) {
                    s = 1;
                }
                this.state = s % 2147483647;
                if (this.state == 0) {
                    this.state = 1;
                }
            }

            public method nextInt(int bound) returns int {
                this.state = (this.state * 48271) % 2147483647;
                if (bound <= 0) {
                    return 0;
                }
                return cast<int>(this.state) % bound;
            }

            public method unit() returns float {
                this.state = (this.state * 48271) % 2147483647;
                return cast<float>(this.state) / 2147483647.0;
            }
        }
    }
}
