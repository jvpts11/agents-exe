import System.IO.Console;
import System.Memory.Units.megabytes;
import Agents.World.Grid;
import Agents.World.Biome;
import Agents.World.WorldAudit;

// World generation: deterministic, size-agnostic.
// Pipeline: relief + flood -> tectonic deformation -> thermal erosion -> climate (latitude/lapse
// temp, moisture with belts + coastal bonus) -> hydrology (steepest-descent rivers + lake pits) ->
// BIOME_CATALOG classification (with river/lake/vent/endorheic overrides). Scratch buffers live in
// fields (freed at the end) so passes share them without array-copy semantics.
//
// The elevation stages are ElevationPass implementations. Landmass builds a height field for the
// whole map and floods it -- continents are whatever stays above water, never a placement decision
// -- and hands its plate partition on through WorldField; Tectonics then deforms the boundaries.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class WorldGen {
            private mutable int seed;
            private mutable int octaves;
            private mutable int baseCells;
            private mutable int worldType;      // 0 Continents, 1 Pangaea, 2 Archipelago, 3 InlandSeas
            private mutable float landRatio;    // fraction of the map that is land; < 0 = use world default
            private mutable int nContinents;    // Continental mode: number of continents; <= 0 = auto by aspect

            private mutable int w;
            private mutable int h;

            // The working state of one generation: the planes the stages hand between them, the
            // flood's frontier, and the coordinate questions all of them ask. Sized in `generate`
            // and emptied again at the end.
            private mutable Scratch* scratch;

            public constructor WorldGen(int seed) {
                this.seed = seed;
                this.octaves = 6;
                this.baseCells = 3;
                this.worldType = 0;
                this.landRatio = 0.0 - 1.0;
                this.nContinents = 0;
                // THE SCRATCH IS OWNED FROM THE FIRST MOMENT, EMPTY.
                //
                // Its planes were left unassigned until `generate` ran, on the grounds that nothing
                // reads them before then. A new object's storage is whatever was last there, so
                // they did not start empty -- they started WRONG, and `generate` ends by deleting
                // them, so a WorldGen that never generated held pointers into somebody else's
                // memory. It owns a valid empty Scratch from the first moment instead.
                this.w = 0;
                this.h = 0;
                this.scratch = new Scratch() on heap;
            }

            public destructor ~WorldGen() returns void {
                delete this.scratch;
                return;
            }

            // Continental mode only: how many distinct continents to grow (<= 0 keeps the aspect-based
            // default). A New-Game knob.
            public method setContinents(int n) returns void {
                this.nContinents = n;
            }

            // Pick a world shape (0 Continents, 1 Pangaea, 2 Archipelago, 3 InlandSeas) and the fraction of
            // the map that should be land. A land < 0 keeps the world's default ratio.
            public method setWorld(int worldType, float land) returns void {
                this.worldType = worldType;
                this.landRatio = land;
            }

            private method defaultLand(int t) returns float {
                if (t == 1) {
                    return 0.40;
                }
                if (t == 2) {
                    return 0.22;
                }
                if (t == 3) {
                    return 0.72;
                }
                return 0.38;
            }

            // ---- pass 5: hydrology (steepest descent -> rivers; pits -> lakes) ----
            // Priority-Flood + epsilon (Barnes et al.): flood inward from the sea through a min-heap, so
            // every land cell gets a monotonic downhill path to the ocean. This fills pits AND resolves
            // flats (a tiny epsilon gradient), and the order in which cells are discovered IS the drainage
            // tree -- each cell drains to the neighbour that reached it -- giving convergent, dendritic
            // rivers with no straight parallel-diagonal artifacts. Filled depressions become lakes.
            // Permanent ice -- an icecap or a glacier. Not a channel: it is the thing a river starts
            // BELOW. Snowfield is deliberately excluded, because snowfield melts and a river may
            // both rise on it and cross it. The tests mirror classify's own so the two agree.
            private method glaciated(Grid* g, int x, int y, float e) returns boolean {
                float t = cast<float>(g.tempAt(x, y)) / 100.0;
                float m = cast<float>(g.moistAt(x, y)) / 100.0;
                if (t < 0.05) {
                    return true;                                  // IceCap: nothing melts
                }
                if (t < 0.15 && m >= 0.80) {
                    return true;                                  // IceCap: wet polar
                }
                if (e >= Contour.HIGHLAND) {
                    if (t < 0.10) {
                        return true;                              // Glacier
                    }
                    if (e >= 0.70 && t < 0.22) {
                        return true;                              // Glacier
                    }
                    if (e >= 0.74 && this.scratch.absLat(y) >= 0.52) {
                        return true;                              // Glacier
                    }
                }
                return false;
            }

            private method hydrology(Grid* g) returns void {
                int n = this.w * this.h;
                float eps = 0.00001;
                // wtr is free after climate(): reuse it as the visited flag.
                mutable int i = 0;
                while (i < n) {
                    this.scratch.water[i] = 0;
                    this.scratch.flooded[i] = this.scratch.elevation[i];
                    this.scratch.downstream[i] = 0 - 1;
                    this.scratch.flow[i] = 1.0;
                    i = i + 1;
                }
                // Seed the heap with every sea cell (the outlets, at their true elevation).
                mutable int s = 0;
                while (s < n) {
                    if (this.scratch.elevation[s] < this.scratch.sea) {
                        this.scratch.water[s] = 1;
                        this.scratch.drain.push(this.scratch.elevation[s], s);
                    }
                    s = s + 1;
                }
                // A fully-land world (no sea) still needs an outlet: seed the single lowest cell.
                if (this.scratch.drain.size() == 0) {
                    mutable int lo = 0;
                    mutable int k = 1;
                    while (k < n) {
                        if (this.scratch.elevation[k] < this.scratch.elevation[lo]) {
                            lo = k;
                        }
                        k = k + 1;
                    }
                    this.scratch.water[lo] = 1;
                    this.scratch.drain.push(this.scratch.elevation[lo], lo);
                }
                int[] order = new int[n]();   // pop order, for downstream flow accumulation in reverse
                mutable int oc = 0;
                while (this.scratch.drain.size() > 0) {
                    int cell = this.scratch.drain.topVal();
                    float cfld = this.scratch.drain.topKey();
                    this.scratch.drain.pop();
                    order[oc] = cell;
                    oc = oc + 1;
                    int cx = cell % this.w;
                    int cy = cell / this.w;
                    mutable int oy = 0 - 1;
                    while (oy <= 1) {
                        mutable int ox = 0 - 1;
                        while (ox <= 1) {
                            if (!(ox == 0 && oy == 0)) {
                                int nyy = cy + oy;
                                if (nyy >= 0 && nyy < this.h) {
                                    int j = this.scratch.idx(cx + ox, nyy);
                                    if (this.scratch.water[j] == 0) {
                                        this.scratch.water[j] = 1;
                                        mutable float nf = this.scratch.elevation[j];
                                        if (nf < cfld + eps) {
                                            nf = cfld + eps;
                                        }
                                        this.scratch.flooded[j] = nf;
                                        this.scratch.downstream[j] = cell;
                                        this.scratch.drain.push(nf, j);
                                    }
                                }
                            }
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                }
                // Re-route each land cell to its STEEPEST fld neighbour instead of the discovery
                // parent: on smooth slopes the flood wavefront sweeps uniformly, so parent links run
                // in straight parallel diagonals (the "rivers that never connect"). Steepest descent
                // on the filled surface follows the actual valleys, so tributaries CONVERGE into a
                // dendritic network -- and fld is pit-free (epsilon), so descent always reaches the
                // sea. The reverse-fld accumulation order below stays valid for any descending link.
                mutable int rc = 0;
                while (rc < n) {
                    if (this.scratch.downstream[rc] != 0 - 1) {
                        int rcx = rc % this.w;
                        int rcy = rc / this.w;
                        mutable float bestF = this.scratch.flooded[rc];
                        mutable int bestJ = 0 - 1;
                        mutable int ry = 0 - 1;
                        while (ry <= 1) {
                            mutable int rx = 0 - 1;
                            while (rx <= 1) {
                                if (!(rx == 0 && ry == 0)) {
                                    int nxx = rcx + rx;
                                    int nyy = rcy + ry;
                                    if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                        int j = nyy * this.w + nxx;
                                        if (this.scratch.flooded[j] < bestF) {
                                            bestF = this.scratch.flooded[j];
                                            bestJ = j;
                                        }
                                    }
                                }
                                rx = rx + 1;
                            }
                            ry = ry + 1;
                        }
                        if (bestJ != 0 - 1) {
                            this.scratch.downstream[rc] = bestJ;
                        }
                    }
                    rc = rc + 1;
                }
                // Flow accumulation: leaves first (reverse discovery order), pushing flow downstream.
                mutable int r = oc - 1;
                while (r >= 0) {
                    int cell = order[r];
                    int d = this.scratch.downstream[cell];
                    if (d != 0 - 1) {
                        this.scratch.flow[d] = this.scratch.flow[d] + this.scratch.flow[cell];
                    }
                    r = r - 1;
                }
                // CHANNEL CAPTURE: a channel running right beside a bigger one gets absorbed by it.
                // Steepest descent alone can keep two parallel channels one cell apart for long
                // stretches (and braid ugly knots at junctions); re-aiming every cell at its
                // largest-flow downhill neighbour merges the minor channel into the major, then the
                // accumulation is recomputed over the same (still strictly descending) order.
                mutable int cc = 0;
                while (cc < n) {
                    if (this.scratch.downstream[cc] != 0 - 1) {
                        int ccx = cc % this.w;
                        int ccy = cc / this.w;
                        mutable float bestFl = 0.0 - 1.0;
                        mutable int bestJ = 0 - 1;
                        mutable int cy2 = 0 - 1;
                        while (cy2 <= 1) {
                            mutable int cx2 = 0 - 1;
                            while (cx2 <= 1) {
                                if (!(cx2 == 0 && cy2 == 0)) {
                                    int nxx = ccx + cx2;
                                    int nyy = ccy + cy2;
                                    if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                        int j = nyy * this.w + nxx;
                                        if (this.scratch.flooded[j] < this.scratch.flooded[cc] && this.scratch.flow[j] > bestFl) {
                                            bestFl = this.scratch.flow[j];
                                            bestJ = j;
                                        }
                                    }
                                }
                                cx2 = cx2 + 1;
                            }
                            cy2 = cy2 + 1;
                        }
                        if (bestJ != 0 - 1) {
                            this.scratch.downstream[cc] = bestJ;
                        }
                    }
                    cc = cc + 1;
                }
                // Rivers never climb, and never touch permanent ice. Both were visible in one shot:
                // a channel rising on an icecap, running clean across it, then going UP a mountain
                // and back down the far side.
                //
                // The pit-filled surface is monotonic by construction, but it is not the real one --
                // a spill path out of a filled basin crosses the rim, and the rim can be genuinely
                // higher than the ground the water came from. So the link is re-tested against the
                // REAL elevation, and a link that would climb is replaced by one that does not, or
                // cut. Cutting is the right answer, not a failure: the water pools where it stops,
                // which is what it does in reality, and the cell is already a lake by the fld test.
                // A link into ice is treated the same way, so the channel routes AROUND a glacier
                // instead of through it -- and the mountain itself is never touched.
                mutable int vv = 0;
                while (vv < n) {
                    int d0 = this.scratch.downstream[vv];
                    if (d0 != 0 - 1) {
                        int vx = vv % this.w;
                        int vy = vv / this.w;
                        boolean iceHere = this.glaciated(g, vx, vy, this.scratch.elevation[vv]);
                        boolean climbs = this.scratch.elevation[d0] > this.scratch.elevation[vv] + 0.0005;
                        boolean intoIce = this.glaciated(g, d0 % this.w, d0 / this.w, this.scratch.elevation[d0]);
                        if (iceHere) {
                            this.scratch.downstream[vv] = 0 - 1;
                        } else if (climbs || intoIce) {
                            mutable float bestE = this.scratch.elevation[vv];
                            mutable int bj = 0 - 1;
                            mutable int vy2 = 0 - 1;
                            while (vy2 <= 1) {
                                mutable int vx2 = 0 - 1;
                                while (vx2 <= 1) {
                                    if (!(vx2 == 0 && vy2 == 0)) {
                                        int nxx = vx + vx2;
                                        int nyy = vy + vy2;
                                        if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                            int j = nyy * this.w + nxx;
                                            // still strictly descending on fld, so the accumulation
                                            // order below stays valid
                                            if (this.scratch.flooded[j] < this.scratch.flooded[vv] && this.scratch.elevation[j] <= bestE
                                                && !this.glaciated(g, nxx, nyy, this.scratch.elevation[j])) {
                                                bestE = this.scratch.elevation[j];
                                                bj = j;
                                            }
                                        }
                                    }
                                    vx2 = vx2 + 1;
                                }
                                vy2 = vy2 + 1;
                            }
                            this.scratch.downstream[vv] = bj;
                        }
                    }
                    vv = vv + 1;
                }
                mutable int z = 0;
                while (z < n) {
                    this.scratch.flow[z] = 1.0;
                    z = z + 1;
                }
                r = oc - 1;
                while (r >= 0) {
                    int cell = order[r];
                    int d = this.scratch.downstream[cell];
                    if (d != 0 - 1) {
                        this.scratch.flow[d] = this.scratch.flow[d] + this.scratch.flow[cell];
                    }
                    r = r - 1;
                }
                // Classify hydrographic features: a cell filled well above its real height is a lake;
                // otherwise a land cell carrying enough flow is a river, drawn toward its downstream cell.
                float riverThr = cast<float>(this.w) * 0.14;
                mutable int q = 0;
                while (q < n) {
                    int x = q % this.w;
                    int y = q / this.w;
                    if (this.scratch.elevation[q] >= this.scratch.sea) {
                        // THE COAST, which nothing has ever marked.
                        //
                        // FLAG_COAST has been declared since the grid was written and set exactly
                        // nowhere -- four places read it and not one wrote it, so every cell in
                        // every world answered "no" and the whole coastal half of Ground.Waterside
                        // was dead alongside it. A harbour could never be sited however badly a town
                        // wanted one, and no amount of fixing what a port is WORTH was ever going to
                        // show up, which is two measured arcs spent on the wrong half of the
                        // question.
                        //
                        // It belongs on the LAND side: a quay is built on the shore, and a person
                        // has to stand where they build. Land whose neighbour is below sea level.
                        if ((x > 0 && this.scratch.elevation[q - 1] < this.scratch.sea)
                            || (x + 1 < this.w && this.scratch.elevation[q + 1] < this.scratch.sea)
                            || (y > 0 && this.scratch.elevation[q - this.w] < this.scratch.sea)
                            || (y + 1 < this.h && this.scratch.elevation[q + this.w] < this.scratch.sea)) {
                            g.setCoast(x, y);
                        }
                        if (this.scratch.flooded[q] > this.scratch.elevation[q] + 0.005) {
                            g.setLake(x, y);
                        } else if (this.scratch.downstream[q] == 0 - 1 && this.scratch.flow[q] > riverThr) {
                            // A channel whose link was cut for climbing or for running into ice has
                            // to END somewhere. It ends in a pool -- a proglacial lake at the ice
                            // margin, or a terminal lake against the ridge it may not climb. Without
                            // this the river simply stopped in open grass, which reads as broken.
                            g.setLake(x, y);
                        } else {
                            if (this.scratch.downstream[q] != 0 - 1 && this.scratch.flow[q] > riverThr) {
                                g.setRiver(x, y);
                                int d = this.scratch.downstream[q];
                                mutable int gdx = d % this.w - x;
                                if (gdx > 1) {
                                    gdx = gdx - this.w;
                                }
                                if (gdx < 0 - 1) {
                                    gdx = gdx + this.w;
                                }
                                g.setFlowDir(x, y, gdx, d / this.w - y);
                            }
                        }
                    }
                    q = q + 1;
                }
                delete order;
            }

            public method generate(int w, int h) returns Grid* {
                // The highland line is written in two units -- 0..1 here, and scaled by ten
                // thousand where the Grid stores it -- and nine places test one or the other. They
                // are written out separately on purpose, so this is where the build checks they
                // still mean the same height. It settles while the program is built and emits
                // nothing; if it ever fails, somebody moved one spelling and not the other.
                demand Contour.HIGHLAND_STORED - cast<int>(Contour.HIGHLAND * 10000.0)
                           <= Contour.ENCODING_SLACK
                    otherwise "the stored highland line has drifted above the field one";
                demand cast<int>(Contour.HIGHLAND * 10000.0) - Contour.HIGHLAND_STORED
                           <= Contour.ENCODING_SLACK
                    otherwise "the stored highland line has drifted below the field one";
                this.w = w;
                this.h = h;
                // Generation descriptors live in one arena freed in a single call; the big per-cell
                // grids stay explicit heap arrays.
                region descriptors = itself.allocate(4 megabytes);
                defer {
                    release region descriptors;
                }
                int n = w * h;
                Grid* g = new Grid(w, h) on heap;
                this.scratch.sizeFor(w, h);  // frees the empty ones, or a previous generate's

                // Elevation is built by the passes, through the interface: Landmass builds the
                // relief and floods it, then (from the next slice) Tectonics deforms the plate
                // boundaries it left behind.
                WorldField* wf = new WorldField(w, h, this.seed) on heap;
                wf.nContinents = this.nContinents;
                mutable float land = this.landRatio;
                if (land < 0.0) {
                    land = this.defaultLand(this.worldType);
                }
                wf.landRatio = land;
                // THE PIPELINE IS A LIST, and being a list is the point: the order of these two is
                // a real dependency -- Landmass builds the relief, floods it, and leaves behind the
                // plate partition that Tectonics then deforms -- and a list says so where a
                // hardcoded call chain only implied it.
                //
                // `name()` on the pass interface still has no caller. It is left alone rather than
                // deleted because the sequencer this method is going to become is its customer, and
                // it is named here so the next person knows it is waiting rather than unused.
                ElevationPass*[] relief = new ElevationPass*[2]();
                relief[0] = new Landmass(this.seed) on heap;
                relief[1] = new Tectonics(this.seed) on heap;
                for (int r in 0..relief.length()) {
                    relief[r].apply(wf);
                }
                mutable int ci = 0;
                while (ci < n) {
                    this.scratch.elevation[ci] = wf.eb[ci];
                    if (cast<int>(wf.vent[ci]) != 0) {
                        g.setVent(ci % w, ci / w);
                    }
                    ci = ci + 1;
                }
                // Erosion now happens inside Landmass, on the raw field BEFORE the flood: running
                // it here averaged coastal land against the ocean next to it and quietly ate 6
                // points of the land ratio.
                //
                // The flood already placed the coastline at the requested land ratio, so the sea
                // level is whatever contour it chose -- not a number tuned here.
                this.scratch.sea = wf.sea;
                Climate* climate = new Climate(this.seed, this.octaves, this.baseCells) on heap;
                climate.apply(g, this.scratch);
                delete climate;
                this.hydrology(g);
                // The hydrology overwrote the water plane as its visited flag -- see Scratch's
                // header, where that reuse is written down -- so rebuild the distance the
                // classifier needs. Twenty-four rings rather than the climate's thirty-two,
                // because what the classifier asks of it is nearer: a coast band of two, and a
                // volcanic-arc gate of twenty-four.
                this.scratch.distanceToWater(24);
                Classifier* classifier = new Classifier(this.seed) on heap;
                classifier.apply(g, this.scratch);
                delete classifier;
                // Content passes: the terrain is settled, and what LIVES on it goes in now.
                //
                // Groundcover reads what Flora wrote -- undergrowth is defined by where the trees
                // are -- so this order is a real dependency and not a preference either. Deposits
                // goes last because it is the only one that writes UNDER the ground and wants the
                // surface settled first.
                WorldPass*[] content = new WorldPass*[3]();
                content[0] = new Flora(this.seed) on heap;
                content[1] = new Groundcover(this.seed) on heap;
                content[2] = new Deposits(this.seed) on heap;
                for (int c in 0..content.length()) {
                    content[c].apply(g, wf);
                }
                // Every pass appended in whatever order suited it; sort the surface nodes into cell
                // order once, now that they are all in, so the renderer can walk a row of them in
                // step with its own loop.
                g.surface().finish();

                for (int c in 0..content.length()) {
                    delete content[c];
                }
                delete content;
                for (int r in 0..relief.length()) {
                    delete relief[r];
                }
                delete relief;
                delete wf;
                // Back to owning an empty scratch rather than a freed one: the state after
                // generating is the state before it, which is what makes the destructor safe.
                this.scratch.release();
                this.scratch.empty();
                return g;
            }

            // Generation is a SEARCH, and this is the half of it that was missing.
            //
            // WorldAudit exists to say whether a generated world is worth playing, and until now the
            // only thing that ever asked it was a `preview` mode run by hand: the game itself took
            // whatever the first roll produced. Three seeds in twelve produce a world the project's
            // own criteria reject -- one continent and five scraps, or fourteen islands -- and three
            // players in twelve got that world with nothing to tell them it was not the intended
            // shape. So roll again.
            //
            // The retry seed is derived from the one that failed, so the same starting seed still
            // gives the same world: a search, not a lottery. `tries` bounds it; if nothing passes,
            // the last roll is returned rather than nothing, because a flawed world beats no world
            // and the caller has been told which criterion it failed.
            private static method rollOnce(int seed, int worldType, float land, int continents,
                                           int w, int h) returns Grid* {
                WorldGen gen = new WorldGen(seed) on stack;
                gen.setWorld(worldType, land);
                if (continents > 0) {
                    gen.setContinents(continents);
                }
                return gen.generate(w, h);
            }

            public static method acceptable(int seed, int worldType, float land, int continents,
                                            int w, int h, int tries, boolean loud) returns Grid* {
                int want = 6;
                mutable Grid* kept = WorldGen.rollOnce(seed, worldType, land, continents, w, h);
                mutable int attempt = 0;
                mutable boolean settled = false;
                while (!settled) {
                    WorldAudit* wa = new WorldAudit(kept) on heap;
                    wa.analyse();
                    int v = wa.verdict(want);
                    String why = wa.reasonName(v);
                    delete wa;
                    attempt = attempt + 1;
                    if (v == 0) {
                        if (loud && attempt > 1) {
                            System.IO.Console.println($"world: accepted on roll {attempt}");
                        }
                        settled = true;
                    } else {
                        if (attempt >= tries) {
                            if (loud) {
                                System.IO.Console.println($"world: no roll passed in {tries}; keeping the last, which fails on {why}");
                            }
                            settled = true;
                        } else {
                            if (loud) {
                                System.IO.Console.println($"world: roll {attempt} fails on {why}, rolling again");
                            }
                            delete kept;
                            kept = WorldGen.rollOnce(seed + attempt * 7717, worldType, land,
                                                     continents, w, h);
                        }
                    }
                }
                return kept;
            }
        }

    }
}
