import System.IO.Console;
import System.Memory.Units.megabytes;
import Agents.World.Grid;
import Agents.World.Biome;

// World generation: deterministic, size-agnostic.
// Pipeline: landmass silhouette -> tectonic relief -> thermal erosion -> climate (latitude/lapse
// temp, moisture with belts + coastal bonus) -> hydrology (steepest-descent rivers + lake pits) ->
// BIOME_CATALOG classification (with river/lake/vent/endorheic overrides). Scratch buffers live in
// fields (freed at the end) so passes share them without array-copy semantics.
//
// The elevation stages are two ElevationPass implementations: Landmass decides WHERE land is and
// leaves it flat; Tectonics receives that mask and only deforms it. Land first, plates second --
// the reverse (plates drawing the coastlines) is what produced the connected web this replaced.
program AgentsExe;

public bundle Agents {
    public namespace World {

        // One stage of elevation construction, so the pipeline is a list rather than a hardcoded
        // call chain and each stage can be tested on its own.
        public interface ElevationPass {
            method name() returns String;
            method apply(WorldField* f) returns void;
        }

        // The scratch shared by the passes: dimensions, parameters and the elevation field.
        // Owned by WorldGen for the duration of generate().
        public class WorldField {
            public mutable int w;
            public mutable int h;
            public mutable int seed;
            public mutable int worldType;
            public mutable int nContinents;
            public mutable float landRatio;
            public mutable float sea;
            public mutable float[] eb;

            public constructor WorldField(int w, int h, int seed) {
                this.w = w;
                this.h = h;
                this.seed = seed;
                this.worldType = 0;
                this.nContinents = 6;
                this.landRatio = 0.0 - 1.0;
                this.sea = 0.42;
                this.eb = new float[w * h]();
            }

            public destructor ~WorldField() returns void {
                delete this.eb;
            }

            public method idx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }
        }

        public class WorldGen {
            private mutable int seed;
            private mutable int octaves;
            private mutable int baseCells;
            private mutable float sea;          // sea level in [0,1] -- derived from landRatio per world
            private mutable int nPlates;
            private mutable int worldType;      // 0 Continents, 1 Pangaea, 2 Archipelago, 3 InlandSeas
            private mutable float landRatio;    // fraction of the map that is land; < 0 = use world default
            private mutable int nContinents;    // Continental mode: number of continents; <= 0 = auto by aspect

            private mutable int w;
            private mutable int h;

            // scratch (allocated in generate, freed at the end)
            private mutable float[] eb;         // elevation 0..1
            private mutable int[] wtr;          // ring distance to water
            private mutable int[] dn;           // downstream cell index, or -1
            private mutable float[] fl;         // flow accumulation
            private mutable int[] plateId;
            private mutable float[] fld;        // pit/flat-filled elevation (priority-flood)
            private mutable float[] hkey;       // binary min-heap: keys (flood elevation)
            private mutable int[] hval;         // binary min-heap: values (cell index)

            // plate descriptors
            private mutable int[] px;
            private mutable int[] py;
            private mutable int[] ptype;        // 0 oceanic, 1 continental
            private mutable float[] pbase;
            private mutable float[] pdx;
            private mutable float[] pdy;
            private mutable float[] crad;       // continental plates: plateau-mask radius (height fractions)

            public constructor WorldGen(int seed) {
                this.seed = seed;
                this.octaves = 6;
                this.baseCells = 3;
                this.sea = 0.42;
                this.nPlates = 12;
                this.worldType = 0;
                this.landRatio = 0.0 - 1.0;
                this.nContinents = 0;
            }

            // Continental mode only: how many distinct continents to grow (<= 0 keeps the aspect-based
            // default). A New-Game knob.
            public method setContinents(int n) returns void {
                this.nContinents = n;
            }

            // Pick a world shape (0 Continents, 1 Pangaea, 2 Archipelago, 3 InlandSeas) and the fraction of
            // the map that should be land. A land < 0 keeps the world's default ratio.
            public method setWorld(int worldType, float land) returns void {
                this.worldType = worldType;
                this.landRatio = land;
            }

            private method defaultLand(int t) returns float {
                if (t == 1) {
                    return 0.40;
                }
                if (t == 2) {
                    return 0.22;
                }
                if (t == 3) {
                    return 0.72;
                }
                return 0.38;
            }

            // ---- integer hash / value noise / fbm (seamless in X) ----
            private method hash01(int xi, int yi) returns float {
                mutable int n = xi * 374761393;
                n = n + yi * 668265263;
                n = n + this.seed * 1442695041;
                n = n ^ (n >> 13);
                n = n * 1274126177;
                n = n ^ (n >> 16);
                int m = n & 2147483647;
                return cast<float>(m) / 2147483647.0;
            }

            private method smooth(float t) returns float {
                return t * t * (3.0 - 2.0 * t);
            }

            private method vnoise(float fx, float fy, int period) returns float {
                int x0 = cast<int>(fx);
                int y0 = cast<int>(fy);
                float tx = fx - cast<float>(x0);
                float ty = fy - cast<float>(y0);
                int x0w = x0 % period;
                int x1w = (x0 + 1) % period;
                float sx = this.smooth(tx);
                float sy = this.smooth(ty);
                float a = this.hash01(x0w, y0);
                float b = this.hash01(x1w, y0);
                float c = this.hash01(x0w, y0 + 1);
                float d = this.hash01(x1w, y0 + 1);
                float ab = a + (b - a) * sx;
                float cd = c + (d - c) * sx;
                return ab + (cd - ab) * sy;
            }

            private method fbm(int x, int y, int salt) returns float {
                float nx = cast<float>(x) / cast<float>(this.w);
                float ny = cast<float>(y) / cast<float>(this.h);
                mutable float sum = 0.0;
                mutable float amp = 1.0;
                mutable float tot = 0.0;
                mutable int cells = this.baseCells + salt;
                mutable int o = 0;
                while (o < this.octaves) {
                    float v = this.vnoise(nx * cast<float>(cells), ny * cast<float>(cells), cells);
                    sum = sum + v * amp;
                    tot = tot + amp;
                    amp = amp * 0.5;
                    cells = cells * 2;
                    o = o + 1;
                }
                return sum / tot;
            }

            // scratch index with X wrap, Y clamp (parallel to Grid layout)
            private method sidx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= this.w) {
                    xx = this.w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= this.h) {
                    yy = this.h - 1;
                }
                return yy * this.w + xx;
            }

            // Plain X distance between two columns (no wrap -- finite rectangular world).
            private method dxWrap(int a, int b) returns int {
                mutable int d = a - b;
                if (d < 0) {
                    d = 0 - d;
                }
                return d;
            }

            private method gridCols(int nc) returns int {
                float aspect = cast<float>(this.w) / cast<float>(this.h);
                mutable int cols = cast<int>(this.fsqrt(cast<float>(nc) * aspect + 0.5));
                if (cols < 1) {
                    cols = 1;
                }
                return cols;
            }

            // How many plates the chosen world mode lays out (must match buildPlates).
            private method platesFor(int t) returns int {
                if (t == 1) {
                    return 12;                       // Pangaea: 2 continental core + 10 oceanic
                }
                if (t == 2) {
                    return 12;                       // Archipelago: all oceanic (arcs make the islands)
                }
                if (t == 3) {
                    return 14;                       // InlandSeas: 9 continental + 5 oceanic basins
                }
                mutable int nc = this.nContinents;
                if (nc <= 0) {
                    nc = 6;
                }
                int cols = this.gridCols(nc);
                int rows = (nc + cols - 1) / cols;
                // continents + 8 border ring + a dual-grid oceanic seed at every corner between
                // continents (the plate GRAPH powers the boundary physics; the land SHAPE itself
                // is the plateau mask anchored on the continental plates)
                return nc + 8 + (cols + 1) * (rows + 1);
            }

            private method seedPlate(int p, int x, int y, int typ, float base, Rng2 rng) returns void {
                this.px[p] = x;
                this.py[p] = y;
                this.ptype[p] = typ;
                this.pbase[p] = base;
                this.pdx[p] = rng.unit() * 2.0 - 1.0;
                this.pdy[p] = rng.unit() * 2.0 - 1.0;
            }

            // ---- pass 1: TECTONIC plates -> the whole large-scale world ----
            // Continents ARE the continental plates and ocean basins ARE the oceanic plates (the
            // blended plate field decides land vs sea; the percentile sea level fine-tunes the
            // ratio). Boundary physics on top: continent-continent collision -> mountain ranges;
            // oceanic subduction -> offshore TRENCH + coastal range + a CONTIGUOUS volcanic arc;
            // ocean-ocean convergence -> island arc paired with a trench; divergence -> a low
            // mid-ocean ridge. This is what makes coasts, ranges and volcano lands line up the way
            // real tectonics does.
            private method buildPlates(Grid* g) returns void {
                Rng2 rng = new Rng2(this.seed ^ 0x51ED) on stack;
                mutable int p = 0;
                if (this.worldType == 0) {
                    // Continental: continental plates on a jittered grid, inset from the borders;
                    // 8 oceanic seeds ringing the map edge + a few interior oceanic basins between.
                    mutable int nc = this.nContinents;
                    if (nc <= 0) {
                        nc = 6;
                    }
                    mutable int cols = this.gridCols(nc);
                    int rows = (nc + cols - 1) / cols;
                    // plateau-mask radius sized from the LAND TARGET (blob area ~ land ratio)
                    mutable float landT = this.landRatio;
                    if (landT < 0.0) {
                        landT = this.defaultLand(this.worldType);
                    }
                    float aspect2 = cast<float>(this.w) / cast<float>(this.h);
                    float r0 = this.fsqrt(landT * aspect2 / (cast<float>(nc) * 3.14159));
                    // Continental centres on the jittered grid, drawn from a DEDICATED stream:
                    // the continental geography (the layout the game's look depends on) stays
                    // stable no matter how the plate physics evolves its own draws.
                    Rng2 crng = new Rng2(this.seed ^ 0x2C0F) on stack;
                    mutable int c = 0;
                    while (c < nc) {
                        int gxi = c % cols;
                        int gyi = c / cols;
                        mutable float cxn = (cast<float>(gxi) + 0.5) / cast<float>(cols) + (crng.unit() - 0.5) * 0.6 / cast<float>(cols);
                        mutable float cyn = (cast<float>(gyi) + 0.5) / cast<float>(rows) + (crng.unit() - 0.5) * 0.6 / cast<float>(rows);
                        cxn = 0.10 + cxn * 0.80;
                        cyn = 0.15 + cyn * 0.70;
                        this.seedPlate(p, cast<int>(cxn * cast<float>(this.w)), cast<int>(cyn * cast<float>(this.h)),
                                       1, 0.52 + 0.10 * rng.unit(), rng);
                        this.crad[p] = r0 * (1.05 + 0.30 * crng.unit());
                        p = p + 1;
                        c = c + 1;
                    }
                    mutable int k = 0;
                    while (k < 8) {
                        mutable float bxn = 0.5;
                        mutable float byn = 0.5;
                        if (k == 0) { bxn = 0.03; byn = 0.04; }
                        if (k == 1) { bxn = 0.50; byn = 0.02; }
                        if (k == 2) { bxn = 0.97; byn = 0.04; }
                        if (k == 3) { bxn = 0.02; byn = 0.50; }
                        if (k == 4) { bxn = 0.98; byn = 0.50; }
                        if (k == 5) { bxn = 0.03; byn = 0.96; }
                        if (k == 6) { bxn = 0.50; byn = 0.98; }
                        if (k == 7) { bxn = 0.97; byn = 0.96; }
                        bxn = bxn + (rng.unit() - 0.5) * 0.06;
                        byn = byn + (rng.unit() - 0.5) * 0.06;
                        this.seedPlate(p, cast<int>(bxn * cast<float>(this.w)), cast<int>(byn * cast<float>(this.h)),
                                       0, 0.10 + 0.06 * rng.unit(), rng);
                        p = p + 1;
                        k = k + 1;
                    }
                    // Oceanic seeds on the dual grid (one per corner between continents): the plate
                    // GRAPH this creates -- who converges with whom, and where -- drives the
                    // boundary physics; the coastline itself comes from the plateau mask anchored
                    // on the continental seeds (applyWorldShape).
                    mutable int gy = 0;
                    while (gy <= rows) {
                        mutable int gx = 0;
                        while (gx <= cols) {
                            mutable float oxn = 0.10 + (cast<float>(gx) / cast<float>(cols) + (rng.unit() - 0.5) * 0.30 / cast<float>(cols)) * 0.80;
                            mutable float oyn = 0.15 + (cast<float>(gy) / cast<float>(rows) + (rng.unit() - 0.5) * 0.30 / cast<float>(rows)) * 0.70;
                            this.seedPlate(p, cast<int>(oxn * cast<float>(this.w)), cast<int>(oyn * cast<float>(this.h)),
                                           0, 0.10 + 0.06 * rng.unit(), rng);
                            p = p + 1;
                            gx = gx + 1;
                        }
                        gy = gy + 1;
                    }
                } else if (this.worldType == 1) {
                    // Pangaea: two fused continental plates in the middle, oceanic everywhere else.
                    this.seedPlate(0, this.w / 2 - this.w / 12, this.h / 2 - this.h / 10, 1, 0.54 + 0.08 * rng.unit(), rng);
                    this.seedPlate(1, this.w / 2 + this.w / 12, this.h / 2 + this.h / 10, 1, 0.54 + 0.08 * rng.unit(), rng);
                    p = 2;
                    mutable int k = 0;
                    while (k < 10) {
                        mutable int ox = rng.nextInt(this.w);
                        mutable int oy = rng.nextInt(this.h);
                        // keep oceanic seeds away from the centre so the core stays continental
                        if (this.dxWrap(ox, this.w / 2) < this.w / 5 && oy > this.h / 3 && oy < this.h * 2 / 3) {
                            ox = (ox + this.w / 2) % this.w;
                        }
                        this.seedPlate(p, ox, oy, 0, 0.10 + 0.06 * rng.unit(), rng);
                        p = p + 1;
                        k = k + 1;
                    }
                } else if (this.worldType == 2) {
                    // Archipelago: all oceanic -- land comes from island arcs + the fragment noise.
                    while (p < 12) {
                        this.seedPlate(p, rng.nextInt(this.w), rng.nextInt(this.h), 0, 0.12 + 0.06 * rng.unit(), rng);
                        p = p + 1;
                    }
                } else {
                    // InlandSeas: a 3x3 continental sheet covering the map, oceanic basins INSIDE it.
                    mutable int c = 0;
                    while (c < 9) {
                        int gxi = c % 3;
                        int gyi = c / 3;
                        float cxn = 0.06 + (cast<float>(gxi) + 0.5) / 3.0 * 0.88 + (rng.unit() - 0.5) * 0.10;
                        float cyn = 0.06 + (cast<float>(gyi) + 0.5) / 3.0 * 0.88 + (rng.unit() - 0.5) * 0.10;
                        this.seedPlate(p, cast<int>(cxn * cast<float>(this.w)), cast<int>(cyn * cast<float>(this.h)),
                                       1, 0.52 + 0.08 * rng.unit(), rng);
                        p = p + 1;
                        c = c + 1;
                    }
                    mutable int k = 0;
                    while (k < 5) {
                        this.seedPlate(p, rng.nextInt(this.w), this.h / 6 + rng.nextInt(this.h * 2 / 3),
                                       0, 0.12 + 0.06 * rng.unit(), rng);
                        p = p + 1;
                        k = k + 1;
                    }
                }
                mutable int y = 0;
                while (y < this.h) {
                    mutable int x = 0;
                    while (x < this.w) {
                        int i = y * this.w + x;
                        // Domain-warp the sample point so plate boundaries (and thus coastlines) are
                        // organic wiggles, not straight Voronoi edges.
                        float nx = cast<float>(x) / cast<float>(this.w);
                        float ny = cast<float>(y) / cast<float>(this.h);
                        float warp = cast<float>(this.w) * 0.12;
                        mutable int wx = x + cast<int>((this.vnoise(nx * 3.0, ny * 3.0, 3) - 0.5) * 2.0 * warp);
                        mutable int wy = y + cast<int>((this.vnoise(nx * 3.0 + 11.0, ny * 3.0 + 7.0, 3) - 0.5) * 2.0 * warp);
                        if (wx < 0) {
                            wx = 0;
                        }
                        if (wx >= this.w) {
                            wx = this.w - 1;
                        }
                        if (wy < 0) {
                            wy = 0;
                        }
                        if (wy >= this.h) {
                            wy = this.h - 1;
                        }
                        mutable int best = 0;
                        mutable int bestd = 2000000000;
                        mutable int second = 0;
                        mutable int secondd = 2000000000;
                        mutable float sumW = 0.0;
                        mutable float sumB = 0.0;
                        mutable int k = 0;
                        while (k < this.nPlates) {
                            int ddx = this.dxWrap(wx, this.px[k]);
                            int ddy = wy - this.py[k];
                            int dist = ddx * ddx + ddy * ddy;
                            // SHARP inverse-distance blend (cubed weight): the nearest plate
                            // dominates, so each plate's interior is a plateau at ITS base height
                            // with a narrow ramp at the boundary. Gentler weights averaged all the
                            // plates into a mid-height mush -- no deep basins, no high interiors --
                            // and the more plates in the layout, the sharper this needs to be.
                            float invd = 1.0 / (cast<float>(dist) + 4096.0);
                            float wgt = invd * invd * invd;
                            sumW = sumW + wgt;
                            sumB = sumB + this.pbase[k] * wgt;
                            if (dist < bestd) {
                                secondd = bestd;
                                second = best;
                                bestd = dist;
                                best = k;
                            } else {
                                if (dist < secondd) {
                                    secondd = dist;
                                    second = k;
                                }
                            }
                            k = k + 1;
                        }
                        this.plateId[i] = best;
                        mutable float base = sumB / sumW;
                        // boundary: closeness of the two nearest plates -> mountain ridges where they converge
                        float db = cast<float>(bestd);
                        float ds = cast<float>(secondd);
                        mutable float border = 0.0;
                        if (ds > 0.0) {
                            border = 1.0 - (ds - db) / ds;
                        }
                        if (border > 0.55) {
                            mutable float conv = this.convergence(best, second);
                            if (conv > 1.0) {
                                conv = 1.0;
                            }
                            float edge = (border - 0.55) / 0.45;
                            // Strength varies ALONG the boundary (low-frequency noise): ranges swell
                            // and pinch, and the volcanic arcs break into segmented chains instead of
                            // one unbroken ribbon snaking across the map.
                            float bmod = 0.45 + 1.10 * this.vnoise(nx * 9.0, ny * 9.0, 9);
                            if (conv > 0.0) {
                                // sqrt(edge): the strong zone reaches further from the boundary line,
                                // so ranges have body instead of a knife-edge crest
                                float eff = conv * this.fsqrt(edge) * bmod;
                                int tA = this.ptype[best];
                                int tB = this.ptype[second];
                                if (tA == 1 && tB == 1) {
                                    // continent-continent collision: the big mountain ranges
                                    base = base + 0.70 * eff;
                                } else if (tA == 1) {
                                    // an oceanic plate subducts under us: coastal range + a
                                    // volcanic arc along the strongest stretches
                                    base = base + 0.60 * eff;
                                    if (conv > 0.55 && eff > 0.40) {
                                        g.setFlag(x, y, Grid.FLAG_VENT);
                                    }
                                } else if (tB == 1) {
                                    // we are the subducting oceanic side: the offshore trench.
                                    // Deep coefficient (the boundary blend bleeds the continental
                                    // base into this side), but ONLY in oceanic context -- carving
                                    // where the land mask later covers the spot sliced water
                                    // channels straight through continents.
                                    if (base < 0.35) {
                                        base = base - 0.55 * eff;
                                    }
                                } else {
                                    // ocean-ocean convergence: island arc on one side of the
                                    // boundary, trench on the other (deterministic pairing)
                                    if (best < second) {
                                        base = base + 0.40 * eff;
                                        if (conv > 0.55 && eff > 0.45) {
                                            g.setFlag(x, y, Grid.FLAG_VENT);
                                        }
                                    } else {
                                        if (base < 0.35) {
                                            base = base - 0.40 * eff;
                                        }
                                    }
                                }
                            } else {
                                if (conv < 0.0 - 0.25 && this.ptype[best] == 0 && this.ptype[second] == 0) {
                                    // divergent oceanic boundary: a low mid-ocean ridge
                                    base = base + 0.06 * (0.0 - conv) * edge;
                                }
                            }
                        }
                        if (base < 0.0) { base = 0.0; }
                        if (base > 1.0) { base = 1.0; }
                        this.eb[i] = base;
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }

            // do plates `a` and `b` push together (+) or apart (-)? Sign of relative drift along the link.
            private method convergence(int a, int b) returns float {
                float lx = cast<float>(this.px[b] - this.px[a]);
                float ly = cast<float>(this.py[b] - this.py[a]);
                float len = lx * lx + ly * ly;
                if (len < 0.001) {
                    return 0.0;
                }
                float inv = 1.0 / this.fsqrt(len);
                float ux = lx * inv;
                float uy = ly * inv;
                float toward = (this.pdx[a] * ux + this.pdy[a] * uy) - (this.pdx[b] * ux + this.pdy[b] * uy);
                return toward;   // >0 converging
            }

            private method fsqrt(float v) returns float {
                if (v <= 0.0) {
                    return 0.0;
                }
                mutable float g = v;
                mutable int i = 0;
                while (i < 12) {
                    g = 0.5 * (g + v / g);
                    i = i + 1;
                }
                return g;
            }

            // ---- pass 2: blend in fractal detail, normalize ----
            private method addDetail() returns void {
                mutable int i = 0;
                int n = this.w * this.h;
                while (i < n) {
                    int x = i % this.w;
                    int y = i / this.w;
                    float d = this.fbm(x, y, 0);
                    this.eb[i] = 0.62 * this.eb[i] + 0.38 * d;
                    i = i + 1;
                }
            }

            // Land shape on top of the tectonic plate field. The COASTLINE comes from a plateau
            // mask anchored on the continental plates (organic warped blobs -- the proven look);
            // underneath it the plate field carries the boundary physics (collision ranges,
            // trenches, volcanic arcs), kept alive in the ocean at reduced weight.
            private method applyWorldShape() returns void {
                int n = this.w * this.h;
                if (this.worldType == 0) {
                    mutable int i = 0;
                    while (i < n) {
                        int x = i % this.w;
                        int y = i / this.w;
                        float nx = cast<float>(x) / cast<float>(this.w);
                        float ny = cast<float>(y) / cast<float>(this.h);
                        float wxf = nx + (this.vnoise(nx * 3.0, ny * 3.0, 3) - 0.5) * 0.30
                                    + (this.vnoise(nx * 7.0 + 2.0, ny * 7.0 + 4.0, 7) - 0.5) * 0.14;
                        float wyf = ny + (this.vnoise(nx * 3.0 + 5.0, ny * 3.0 + 9.0, 3) - 0.5) * 0.30
                                    + (this.vnoise(nx * 7.0 + 8.0, ny * 7.0 + 1.0, 7) - 0.5) * 0.14;
                        mutable float mask = 0.0;
                        mutable int k = 0;
                        while (k < this.nPlates) {
                            if (this.ptype[k] == 1) {
                                float cxn = cast<float>(this.px[k]) / cast<float>(this.w);
                                float cyn = cast<float>(this.py[k]) / cast<float>(this.h);
                                float dxn = (wxf - cxn) * cast<float>(this.w) / cast<float>(this.h);
                                float dyn = wyf - cyn;
                                float d2 = this.fsqrt(dxn * dxn + dyn * dyn);
                                float m = 1.0 - d2 / this.crad[k];
                                if (m > mask) {
                                    mask = m;
                                }
                            }
                            k = k + 1;
                        }
                        if (mask < 0.0) {
                            mask = 0.0;
                        }
                        mutable float shaped = mask * 2.8;
                        if (shaped > 1.0) {
                            shaped = 1.0;
                        }
                        // land: plateau over the plate field (ridges survive inside the 0.62 term);
                        // sea: the plate field at reduced weight, so trenches, island arcs and
                        // mid-ocean ridges still shape the ocean floor
                        // ocean side: the plate field at HALF weight, capped -- trenches and arcs
                        // still texture the sea floor, but a boundary ridge crossing a strait shows
                        // as an island chain at most, never as a land bridge
                        mutable float oc = this.eb[i];
                        if (oc > 0.32) {
                            oc = 0.32;
                        }
                        this.eb[i] = shaped * (0.30 + 0.62 * this.eb[i]) + (1.0 - shaped) * 0.55 * oc;
                        i = i + 1;
                    }
                } else if (this.worldType == 1) {
                    int cx = this.w / 2;
                    int cy = this.h / 2;
                    mutable int i = 0;
                    while (i < n) {
                        int x = i % this.w;
                        int y = i / this.w;
                        float fx = cast<float>(this.dxWrap(x, cx)) / (cast<float>(this.w) * 0.5);
                        float fy = cast<float>(y - cy) / (cast<float>(this.h) * 0.5);
                        float r = this.fsqrt(fx * fx + fy * fy);
                        float nx = cast<float>(x) / cast<float>(this.w);
                        float ny = cast<float>(y) / cast<float>(this.h);
                        float wob = 0.78 + 0.55 * this.vnoise(nx * 2.0, ny * 2.0, 2);
                        mutable float blob = wob - r;
                        if (blob < 0.0) {
                            blob = 0.0;
                        }
                        mutable float shaped = blob * 2.6;
                        if (shaped > 1.0) {
                            shaped = 1.0;
                        }
                        // ocean side: the plate field at HALF weight, capped -- trenches and arcs
                        // still texture the sea floor, but a boundary ridge crossing a strait shows
                        // as an island chain at most, never as a land bridge
                        mutable float oc = this.eb[i];
                        if (oc > 0.32) {
                            oc = 0.32;
                        }
                        this.eb[i] = shaped * (0.30 + 0.62 * this.eb[i]) + (1.0 - shaped) * 0.55 * oc;
                        i = i + 1;
                    }
                }
                if (this.worldType == 2) {
                    // Archipelago: fragment the oceanic field with high-frequency noise so the island
                    // arcs break into chains instead of continuous ribbons.
                    mutable int i = 0;
                    while (i < n) {
                        int x = i % this.w;
                        int y = i / this.w;
                        float nx = cast<float>(x) / cast<float>(this.w);
                        float ny = cast<float>(y) / cast<float>(this.h);
                        float hi = this.vnoise(nx * 11.0, ny * 11.0, 11);
                        this.eb[i] = this.eb[i] * 0.55 + hi * 0.45;
                        i = i + 1;
                    }
                }
                // Ocean border falloff (Continents / Archipelago): push elevation down toward every map
                // edge so land never runs off the border -- the world reads as continents in an ocean,
                // not terrain cropped by the map. The percentile sea level keeps the land ratio exact.
                if (this.worldType == 0 || this.worldType == 2) {
                    float margin = 0.07;
                    mutable int i = 0;
                    while (i < n) {
                        int x = i % this.w;
                        int y = i / this.w;
                        float nx = cast<float>(x) / cast<float>(this.w - 1);
                        float ny = cast<float>(y) / cast<float>(this.h - 1);
                        mutable float edge = nx;
                        if (1.0 - nx < edge) { edge = 1.0 - nx; }
                        if (ny < edge) { edge = ny; }
                        if (1.0 - ny < edge) { edge = 1.0 - ny; }
                        if (edge < margin) {
                            mutable float t = edge / margin;
                            t = t * t * (3.0 - 2.0 * t);
                            this.eb[i] = this.eb[i] * (0.15 + 0.85 * t);
                        }
                        i = i + 1;
                    }
                }
            }

            // Choose the sea level so that exactly `land` fraction of cells sit above it, via a histogram of
            // the final elevation field. This makes the land/water ratio exact regardless of world shape.
            private method computeSeaLevel(float land) returns float {
                int n = this.w * this.h;
                int bins = 2048;
                int[] hist = new int[bins]();
                mutable int i = 0;
                while (i < n) {
                    mutable int bi = cast<int>(this.eb[i] * cast<float>(bins));
                    if (bi < 0) {
                        bi = 0;
                    }
                    if (bi >= bins) {
                        bi = bins - 1;
                    }
                    hist[bi] = hist[bi] + 1;
                    i = i + 1;
                }
                int waterTarget = cast<int>(cast<float>(n) * (1.0 - land));
                mutable int acc = 0;
                mutable int seaBin = bins - 1;
                mutable int b = 0;
                while (b < bins) {
                    acc = acc + hist[b];
                    if (acc >= waterTarget) {
                        seaBin = b;
                        b = bins;
                    } else {
                        b = b + 1;
                    }
                }
                delete hist;
                return cast<float>(seaBin) / cast<float>(bins);
            }

            // ---- pass 3: thermal erosion (a few relaxation passes, 4-neighbour) ----
            private method erode(int passes) returns void {
                mutable int p = 0;
                while (p < passes) {
                    mutable int y = 0;
                    while (y < this.h) {
                        mutable int x = 0;
                        while (x < this.w) {
                            int i = y * this.w + x;
                            float c = this.eb[i];
                            float l = this.eb[this.sidx(x - 1, y)];
                            float r = this.eb[this.sidx(x + 1, y)];
                            float u = this.eb[this.sidx(x, y - 1)];
                            float dn2 = this.eb[this.sidx(x, y + 1)];
                            float avg = (l + r + u + dn2) * 0.25;
                            this.eb[i] = c * 0.6 + avg * 0.4;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    p = p + 1;
                }
            }

            // ---- pass 4: climate (temperature, moisture with belts + coastal bonus) ----
            private method belt(float alat) returns float {
                if (alat < 0.12) {
                    return 0.90;
                }
                if (alat < 0.36) {
                    float t = (alat - 0.12) / 0.24;
                    return 0.90 - 0.70 * t;
                }
                if (alat < 0.66) {
                    float t = (alat - 0.36) / 0.30;
                    return 0.20 + 0.50 * t;
                }
                float t = (alat - 0.66) / 0.34;
                return 0.70 - 0.50 * t;
            }

            private method absLat(int y) returns float {
                float ny = cast<float>(y) / cast<float>(this.h - 1);
                mutable float d = 2.0 * ny - 1.0;
                if (d < 0.0) {
                    d = 0.0 - d;
                }
                return d;
            }

            // ring distance to the nearest water cell (approximate, K dilation passes)
            private method distToWater(int rings) returns void {
                mutable int i = 0;
                int n = this.w * this.h;
                while (i < n) {
                    if (this.eb[i] < this.sea) {
                        this.wtr[i] = 0;
                    } else {
                        this.wtr[i] = 9999;
                    }
                    i = i + 1;
                }
                mutable int p = 0;
                while (p < rings) {
                    mutable int y = 0;
                    while (y < this.h) {
                        mutable int x = 0;
                        while (x < this.w) {
                            int idx = y * this.w + x;
                            mutable int m = this.wtr[idx];
                            int a = this.wtr[this.sidx(x - 1, y)] + 1;
                            int b = this.wtr[this.sidx(x + 1, y)] + 1;
                            int c = this.wtr[this.sidx(x, y - 1)] + 1;
                            int e = this.wtr[this.sidx(x, y + 1)] + 1;
                            if (a < m) { m = a; }
                            if (b < m) { m = b; }
                            if (c < m) { m = c; }
                            if (e < m) { m = e; }
                            this.wtr[idx] = m;
                            x = x + 1;
                        }
                        y = y + 1;
                    }
                    p = p + 1;
                }
            }

            private method climate(Grid* g) returns void {
                // 32 rings: how far ocean moisture reaches inland. 8 cells on a 2560-wide map died
                // inside the beach band, so no m>=0.8 biome (rainforest/wetland/ice cap) ever formed;
                // 32 gives real coastal climate bands with a continental dry interior.
                int rings = 32;
                this.distToWater(rings);
                mutable int y = 0;
                while (y < this.h) {
                    float alat = this.absLat(y);
                    float latBand = 1.0 - alat;
                    float beltM = this.belt(alat);
                    mutable int x = 0;
                    while (x < this.w) {
                        int i = y * this.w + x;
                        float e = this.eb[i];
                        mutable float lapse = 0.0;
                        if (e > this.sea) {
                            // 0.75: high ground cools into rock/glacier/meadow bands without
                            // freezing whole continents (0.9 froze everything above e~0.70)
                            lapse = 0.75 * (e - this.sea);
                        }
                        float tnoise = (this.fbm(x, y, 17) - 0.5) * 0.14;   // wavy climate bands, not straight lines
                        mutable float t = latBand - lapse + tnoise;
                        if (t < 0.0) { t = 0.0; }
                        if (t > 1.0) { t = 1.0; }
                        float mn = this.fbm(x, y, 37);
                        mutable float coast = 0.0;
                        if (this.wtr[i] < rings) {
                            coast = 1.0 - cast<float>(this.wtr[i]) / cast<float>(rings);
                        }
                        // coast-heavy blend: oceans are where moisture comes from -- the top decile
                        // (rainforests, wetlands, ice caps) forms along wet coasts and fades inland
                        mutable float m = 0.46 * mn + 0.26 * beltM + 0.28 * coast;
                        // Stretch the contrast around the mean: the raw blend almost never leaves
                        // [0.2, 0.8], so every m>=0.80 biome (wetlands, rainforests, IceCap) and most
                        // m<0.20 deserts NEVER generated. Widening both tails puts the whole Whittaker
                        // table in play.
                        m = 0.5 + (m - 0.5) * 1.6;
                        if (m > 1.0) { m = 1.0; }
                        if (m < 0.0) { m = 0.0; }
                        g.setTemp(x, y, cast<int>(t * 100.0));
                        g.setMoist(x, y, cast<int>(m * 100.0));
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }

            // ---- pass 5: hydrology (steepest descent -> rivers; pits -> lakes) ----
            // Binary min-heap over (flood-elevation key, cell value). Push bubbles the new leaf up.
            private method heapPush(int hn, float key, int val) returns int {
                mutable int c = hn;
                while (c > 0) {
                    int p = (c - 1) / 2;
                    if (this.hkey[p] <= key) {
                        break;
                    }
                    this.hkey[c] = this.hkey[p];
                    this.hval[c] = this.hval[p];
                    c = p;
                }
                this.hkey[c] = key;
                this.hval[c] = val;
                return hn + 1;
            }

            // Remove the minimum (already read from index 0 by the caller): move the last leaf to the root
            // and sift it down. Returns the new size.
            private method heapPop(int hn) returns int {
                int newn = hn - 1;
                float key = this.hkey[newn];
                int val = this.hval[newn];
                mutable int c = 0;
                while (true) {
                    int l = 2 * c + 1;
                    if (l >= newn) {
                        break;
                    }
                    mutable int child = l;
                    int rr = l + 1;
                    if (rr < newn && this.hkey[rr] < this.hkey[l]) {
                        child = rr;
                    }
                    if (this.hkey[child] >= key) {
                        break;
                    }
                    this.hkey[c] = this.hkey[child];
                    this.hval[c] = this.hval[child];
                    c = child;
                }
                this.hkey[c] = key;
                this.hval[c] = val;
                return newn;
            }

            // Priority-Flood + epsilon (Barnes et al.): flood inward from the sea through a min-heap, so
            // every land cell gets a monotonic downhill path to the ocean. This fills pits AND resolves
            // flats (a tiny epsilon gradient), and the order in which cells are discovered IS the drainage
            // tree -- each cell drains to the neighbour that reached it -- giving convergent, dendritic
            // rivers with no straight parallel-diagonal artifacts. Filled depressions become lakes.
            private method hydrology(Grid* g) returns void {
                int n = this.w * this.h;
                float eps = 0.00001;
                // wtr is free after climate(): reuse it as the visited flag.
                mutable int i = 0;
                while (i < n) {
                    this.wtr[i] = 0;
                    this.fld[i] = this.eb[i];
                    this.dn[i] = 0 - 1;
                    this.fl[i] = 1.0;
                    i = i + 1;
                }
                // Seed the heap with every sea cell (the outlets, at their true elevation).
                mutable int hn = 0;
                mutable int s = 0;
                while (s < n) {
                    if (this.eb[s] < this.sea) {
                        this.wtr[s] = 1;
                        hn = this.heapPush(hn, this.eb[s], s);
                    }
                    s = s + 1;
                }
                // A fully-land world (no sea) still needs an outlet: seed the single lowest cell.
                if (hn == 0) {
                    mutable int lo = 0;
                    mutable int k = 1;
                    while (k < n) {
                        if (this.eb[k] < this.eb[lo]) {
                            lo = k;
                        }
                        k = k + 1;
                    }
                    this.wtr[lo] = 1;
                    hn = this.heapPush(hn, this.eb[lo], lo);
                }
                int[] order = new int[n]();   // pop order, for downstream flow accumulation in reverse
                mutable int oc = 0;
                while (hn > 0) {
                    int cell = this.hval[0];
                    float cfld = this.hkey[0];
                    hn = this.heapPop(hn);
                    order[oc] = cell;
                    oc = oc + 1;
                    int cx = cell % this.w;
                    int cy = cell / this.w;
                    mutable int oy = 0 - 1;
                    while (oy <= 1) {
                        mutable int ox = 0 - 1;
                        while (ox <= 1) {
                            if (!(ox == 0 && oy == 0)) {
                                int nyy = cy + oy;
                                if (nyy >= 0 && nyy < this.h) {
                                    int j = this.sidx(cx + ox, nyy);
                                    if (this.wtr[j] == 0) {
                                        this.wtr[j] = 1;
                                        mutable float nf = this.eb[j];
                                        if (nf < cfld + eps) {
                                            nf = cfld + eps;
                                        }
                                        this.fld[j] = nf;
                                        this.dn[j] = cell;
                                        hn = this.heapPush(hn, nf, j);
                                    }
                                }
                            }
                            ox = ox + 1;
                        }
                        oy = oy + 1;
                    }
                }
                // Re-route each land cell to its STEEPEST fld neighbour instead of the discovery
                // parent: on smooth slopes the flood wavefront sweeps uniformly, so parent links run
                // in straight parallel diagonals (the "rivers that never connect"). Steepest descent
                // on the filled surface follows the actual valleys, so tributaries CONVERGE into a
                // dendritic network -- and fld is pit-free (epsilon), so descent always reaches the
                // sea. The reverse-fld accumulation order below stays valid for any descending link.
                mutable int rc = 0;
                while (rc < n) {
                    if (this.dn[rc] != 0 - 1) {
                        int rcx = rc % this.w;
                        int rcy = rc / this.w;
                        mutable float bestF = this.fld[rc];
                        mutable int bestJ = 0 - 1;
                        mutable int ry = 0 - 1;
                        while (ry <= 1) {
                            mutable int rx = 0 - 1;
                            while (rx <= 1) {
                                if (!(rx == 0 && ry == 0)) {
                                    int nxx = rcx + rx;
                                    int nyy = rcy + ry;
                                    if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                        int j = nyy * this.w + nxx;
                                        if (this.fld[j] < bestF) {
                                            bestF = this.fld[j];
                                            bestJ = j;
                                        }
                                    }
                                }
                                rx = rx + 1;
                            }
                            ry = ry + 1;
                        }
                        if (bestJ != 0 - 1) {
                            this.dn[rc] = bestJ;
                        }
                    }
                    rc = rc + 1;
                }
                // Flow accumulation: leaves first (reverse discovery order), pushing flow downstream.
                mutable int r = oc - 1;
                while (r >= 0) {
                    int cell = order[r];
                    int d = this.dn[cell];
                    if (d != 0 - 1) {
                        this.fl[d] = this.fl[d] + this.fl[cell];
                    }
                    r = r - 1;
                }
                // CHANNEL CAPTURE: a channel running right beside a bigger one gets absorbed by it.
                // Steepest descent alone can keep two parallel channels one cell apart for long
                // stretches (and braid ugly knots at junctions); re-aiming every cell at its
                // largest-flow downhill neighbour merges the minor channel into the major, then the
                // accumulation is recomputed over the same (still strictly descending) order.
                mutable int cc = 0;
                while (cc < n) {
                    if (this.dn[cc] != 0 - 1) {
                        int ccx = cc % this.w;
                        int ccy = cc / this.w;
                        mutable float bestFl = 0.0 - 1.0;
                        mutable int bestJ = 0 - 1;
                        mutable int cy2 = 0 - 1;
                        while (cy2 <= 1) {
                            mutable int cx2 = 0 - 1;
                            while (cx2 <= 1) {
                                if (!(cx2 == 0 && cy2 == 0)) {
                                    int nxx = ccx + cx2;
                                    int nyy = ccy + cy2;
                                    if (nxx >= 0 && nxx < this.w && nyy >= 0 && nyy < this.h) {
                                        int j = nyy * this.w + nxx;
                                        if (this.fld[j] < this.fld[cc] && this.fl[j] > bestFl) {
                                            bestFl = this.fl[j];
                                            bestJ = j;
                                        }
                                    }
                                }
                                cx2 = cx2 + 1;
                            }
                            cy2 = cy2 + 1;
                        }
                        if (bestJ != 0 - 1) {
                            this.dn[cc] = bestJ;
                        }
                    }
                    cc = cc + 1;
                }
                mutable int z = 0;
                while (z < n) {
                    this.fl[z] = 1.0;
                    z = z + 1;
                }
                r = oc - 1;
                while (r >= 0) {
                    int cell = order[r];
                    int d = this.dn[cell];
                    if (d != 0 - 1) {
                        this.fl[d] = this.fl[d] + this.fl[cell];
                    }
                    r = r - 1;
                }
                // Classify hydrographic features: a cell filled well above its real height is a lake;
                // otherwise a land cell carrying enough flow is a river, drawn toward its downstream cell.
                float riverThr = cast<float>(this.w) * 0.14;
                mutable int q = 0;
                while (q < n) {
                    int x = q % this.w;
                    int y = q / this.w;
                    if (this.eb[q] >= this.sea) {
                        if (this.fld[q] > this.eb[q] + 0.005) {
                            g.setFlag(x, y, Grid.FLAG_LAKE);
                        } else {
                            if (this.dn[q] != 0 - 1 && this.fl[q] > riverThr) {
                                g.setFlag(x, y, Grid.FLAG_RIVER);
                                int d = this.dn[q];
                                mutable int gdx = d % this.w - x;
                                if (gdx > 1) {
                                    gdx = gdx - this.w;
                                }
                                if (gdx < 0 - 1) {
                                    gdx = gdx + this.w;
                                }
                                g.setFlowDir(x, y, gdx, d / this.w - y);
                            }
                        }
                    }
                    q = q + 1;
                }
                delete order;
            }

            // ---- pass 6: classify every cell into a Biome ordinal ----
            private method classifyAll(Grid* g) returns void {
                mutable int y = 0;
                while (y < this.h) {
                    mutable int x = 0;
                    while (x < this.w) {
                        int i = y * this.w + x;
                        float e = this.eb[i];
                        float t = cast<float>(g.tempAt(x, y)) / 100.0;
                        float m = cast<float>(g.moistAt(x, y)) / 100.0;
                        int fg = g.flagsAt(x, y);
                        g.setElev(x, y, cast<int>(e * 10000.0));
                        g.setBiome(x, y, this.classify(e, t, m, fg, this.wtr[i], x, y));
                        x = x + 1;
                    }
                    y = y + 1;
                }
            }

            private method classify(float e, float t, float m, int fg, int distw, int x, int y) returns int {
                // hard overrides. NOTE: a river cell keeps its terrain biome -- the renderer draws a blue
                // channel over the land following the stored flow direction (spec: rivers wind through
                // terrain, they don't paint the whole tile). Lakes and vents still recolour the cell.
                // Volcanic lands live on HIGH ground near the convergent ridges, and volcanic ARCS
                // hug the coast (distw): where a subduction boundary runs deep under a continent's
                // interior, the same uplift shows as an ordinary mountain range instead.
                if ((fg & Grid.FLAG_VENT) != 0 && e >= this.sea && e >= 0.55 && distw <= 24) { return cast<int>(Biome.Volcanic); }
                if ((fg & Grid.FLAG_LAKE) != 0 && e >= this.sea) {
                    // a basin in a bone-dry climate is a dried-up salt flat, not a lake
                    if (m < 0.22) { return cast<int>(Biome.SaltFlat); }
                    return cast<int>(Biome.Lake);
                }
                // water -- depth bands RELATIVE to the percentile sea level (absolute cuts squeezed
                // whole bands out of existence whenever the sea level moved)
                if (e < this.sea) {
                    // sea ice is a SURFACE sheet -- it covers polar water of any depth, so it must
                    // outrank the depth bands
                    if (t < 0.15) { return cast<int>(Biome.SeaIce); }
                    // trenches only in the deep INTERIOR basins -- the border falloff also drives
                    // elevation under the trench cut, which drew an artificial trench ring hugging
                    // the map edges (the "giant trench in the south")
                    if (e < this.sea - 0.21 && !this.nearEdge(x, y)) { return cast<int>(Biome.MarineTrench); }
                    if (e < this.sea - 0.09) { return cast<int>(Biome.DeepOcean); }
                    if (e >= this.sea - 0.03) {
                        // reefs are scattered ATOLL PATCHES in warm shallows, not a carpet over the
                        // whole tropical band -- a coarse noise mask keeps ~1 in 6 warm shallows
                        if (t >= 0.85 && m >= 0.80) {
                            float rn = this.vnoise(cast<float>(x) / cast<float>(this.w) * 23.0,
                                                   cast<float>(y) / cast<float>(this.h) * 23.0, 23);
                            if (rn > 0.62) { return cast<int>(Biome.CoralReef); }
                        }
                        return cast<int>(Biome.ShallowSea);
                    }
                    return cast<int>(Biome.Ocean);
                }
                // coast: low ground TOUCHING the water (distw), not every low flat -- a wide flat
                // shelf inland of the shore is ordinary lowland, not kilometres of beach/rocky shore
                if (e < this.sea + 0.03 && distw <= 2) {
                    if (t >= 0.85 && m >= 0.60) { return cast<int>(Biome.Mangrove); }
                    if (t < 0.35) { return cast<int>(Biome.RockyShore); }
                    return cast<int>(Biome.Beach);
                }
                // peaks & mountains: the SNOW LINE is pure altitude (high enough = snow, whatever
                // the tuning of latitude/lapse does), and the band under it partitions by climate --
                // cold face = glacier, warm wet shoulder = alpine meadow, the rest bare rock.
                if (e >= 0.80) {
                    return cast<int>(Biome.SnowPeak);
                }
                if (e >= 0.74) {
                    // poleward half of the map: high ridges carry glaciers (latitude directly, so
                    // the band survives any lapse/temperature retuning)
                    if (this.absLat(y) >= 0.52) { return cast<int>(Biome.Glacier); }
                    if (m >= 0.45) { return cast<int>(Biome.AlpineMeadow); }
                    return cast<int>(Biome.Mountain);
                }
                // 0.63 is THE contract line, shared by three places that must agree: Landmass caps
                // ordinary land below it, the renderer's stackLvl starts stacking at it, and the
                // highland biomes begin here. When this said 0.58 the flat plateau interiors landed
                // in the mountain band and half the world came out as hills and badlands.
                if (e >= 0.63) {
                    // cold high ground ices over -- glacier tongues wherever the seed actually put
                    // its poleward ranges, whatever the lapse/latitude tuning does
                    if (e >= 0.70 && t < 0.22) { return cast<int>(Biome.Glacier); }
                    if (t < 0.10) { return cast<int>(Biome.Glacier); }
                    if (m < 0.26) { return cast<int>(Biome.Badlands); }
                    if (t < 0.28) { return cast<int>(Biome.Mountain); }   // truly cold highland (glacier rims) = rock
                    // the green shoulder under the peaks: warm-enough, wet-enough high ground
                    // (0.64: anchored to where warm land actually exists -- a seed can roll every
                    // tall ridge into polar latitudes, and the meadow must survive that)
                    if (e >= 0.64 && t >= 0.30 && m >= 0.32) { return cast<int>(Biome.AlpineMeadow); }
                    return cast<int>(Biome.Hills);
                }
                // lowland specials
                if (m < 0.20 && (fg & Grid.FLAG_ENDORHEIC) != 0) { return cast<int>(Biome.SaltFlat); }
                // An oasis is a RARE, isolated pool cell inside hot desert -- not a coastal band.
                if (t >= 0.55 && m < 0.20 && this.hash01(x * 13 + 7, y * 17 + 3) > 0.995) {
                    return cast<int>(Biome.Oasis);
                }
                // wetlands (a cold bog waterlogs at lower moisture -- barely any evaporation)
                if (t < 0.35 && m >= 0.78) { return cast<int>(Biome.Bog); }
                if (m >= 0.84) {
                    if (t >= 0.78) { return cast<int>(Biome.Swamp); }
                    return cast<int>(Biome.Marsh);
                }
                return this.whittaker(t, m);
            }

            // Inside the outer 10% frame of the map, where the border-ocean falloff (not geology)
            // controls the depth.
            private method nearEdge(int x, int y) returns boolean {
                int bx = this.w / 10;
                int by = this.h / 10;
                if (x < bx || x >= this.w - bx) {
                    return true;
                }
                if (y < by || y >= this.h - by) {
                    return true;
                }
                return false;
            }

            private method whittaker(float t, float m) returns int {
                // below ~0.05 nothing melts, regardless of how little falls: permanent ice cap --
                // this is what covers the extreme polar strips (the belt model keeps poles dry, so
                // the m>=0.80 route alone never fired there)
                if (t < 0.05) { return cast<int>(Biome.IceCap); }
                if (t < 0.15) {
                    if (m < 0.20) { return cast<int>(Biome.ColdDesert); }
                    if (m < 0.60) { return cast<int>(Biome.Tundra); }
                    if (m < 0.80) { return cast<int>(Biome.Snowfield); }
                    return cast<int>(Biome.IceCap);
                }
                if (t < 0.35) {
                    if (m < 0.20) { return cast<int>(Biome.ColdDesert); }
                    if (m < 0.40) { return cast<int>(Biome.Steppe); }
                    return cast<int>(Biome.Taiga);
                }
                if (t < 0.55) {
                    if (m < 0.20) { return cast<int>(Biome.ColdDesert); }
                    if (m < 0.40) { return cast<int>(Biome.Steppe); }
                    if (m < 0.60) { return cast<int>(Biome.Prairie); }
                    if (m < 0.80) { return cast<int>(Biome.DeciduousForest); }
                    return cast<int>(Biome.TemperateRainforest);
                }
                if (t < 0.78) {
                    if (m < 0.20) { return cast<int>(Biome.HotDesert); }
                    if (m < 0.40) { return cast<int>(Biome.ThornScrub); }
                    if (m < 0.60) { return cast<int>(Biome.MedShrubland); }
                    if (m < 0.80) { return cast<int>(Biome.WarmGrassland); }
                    return cast<int>(Biome.LaurelForest);
                }
                if (m < 0.20) { return cast<int>(Biome.HotDesert); }
                if (m < 0.40) { return cast<int>(Biome.Savanna); }
                if (m < 0.60) { return cast<int>(Biome.TropSeasonalForest); }
                return cast<int>(Biome.TropicalRainforest);
            }

            public method generate(int w, int h) returns Grid* {
                this.w = w;
                this.h = h;
                this.nPlates = this.platesFor(this.worldType);
                // Generation descriptors (profiles, lobes, plate records) live in one arena freed
                // in a single call; the big per-cell grids stay explicit heap arrays.
                region descriptors = itself.allocate(4 megabytes);
                defer {
                    release region descriptors;
                }
                int n = w * h;
                Grid* g = new Grid(w, h) on heap;
                this.eb = new float[n]();
                this.wtr = new int[n]();
                this.dn = new int[n]();
                this.fl = new float[n]();
                this.plateId = new int[n]();
                this.fld = new float[n]();
                this.hkey = new float[n]();
                this.hval = new int[n]();
                this.px = new int[this.nPlates]();
                this.py = new int[this.nPlates]();
                this.ptype = new int[this.nPlates]();
                this.pbase = new float[this.nPlates]();
                this.pdx = new float[this.nPlates]();
                this.pdy = new float[this.nPlates]();
                this.crad = new float[this.nPlates]();

                // Elevation is built by the passes, through the interface: Landmass decides WHERE
                // land is and leaves it flat, then (from the next slice) Tectonics deforms it.
                WorldField* wf = new WorldField(w, h, this.seed) on heap;
                wf.worldType = this.worldType;
                wf.nContinents = this.nContinents;
                wf.landRatio = this.landRatio;
                Landmass* landPass = new Landmass(this.seed) on heap;
                ElevationPass* pass = landPass;
                pass.apply(wf);
                mutable int ci = 0;
                while (ci < n) {
                    this.eb[ci] = wf.eb[ci];
                    ci = ci + 1;
                }
                this.erode(3);
                mutable float land = this.landRatio;
                if (land < 0.0) {
                    land = this.defaultLand(this.worldType);
                }
                // FIXED sea level, not a percentile. Landmass now decides the coastline directly
                // (its fit loop targets the land area), so the shoreline is the 0.43 contour by
                // construction. The percentile made the two fight each other: with most of the sea
                // floor at one value the percentile snapped to it, and everything above -- the
                // whole shelf -- came back as land.
                this.sea = 0.43;
                this.climate(g);
                this.hydrology(g);
                // hydrology reused wtr as its visited flag -- rebuild the distance-to-water field
                // classify needs (coast band <= 2, volcanic-arc gate <= 24)
                this.distToWater(24);
                this.classifyAll(g);

                delete landPass;
                delete wf;
                delete this.eb;
                delete this.wtr;
                delete this.dn;
                delete this.fl;
                delete this.plateId;
                delete this.fld;
                delete this.hkey;
                delete this.hval;
                delete this.px;
                delete this.py;
                delete this.ptype;
                delete this.pbase;
                delete this.pdx;
                delete this.pdy;
                delete this.crad;
                return g;
            }
        }

        // A tiny local RNG for plate seeding (unit float helper), independent of the spatial hash.
        public class Rng2 {
            private mutable long state;

            public constructor Rng2(int seed) {
                mutable long s = cast<long>(seed);
                if (s <= 0) {
                    s = 1;
                }
                this.state = s % 2147483647;
                if (this.state == 0) {
                    this.state = 1;
                }
            }

            public method nextInt(int bound) returns int {
                this.state = (this.state * 48271) % 2147483647;
                if (bound <= 0) {
                    return 0;
                }
                return cast<int>(this.state) % bound;
            }

            public method unit() returns float {
                this.state = (this.state * 48271) % 2147483647;
                return cast<float>(this.state) / 2147483647.0;
            }
        }
    }
}
