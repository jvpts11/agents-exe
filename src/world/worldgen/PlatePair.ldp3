import System.IO.Console;
program AgentsExe;

// What is happening between two particular plates: the boundary they share, how hard they are
// pressing, and which of the two rides over the other.
//
// Three parallel arrays over the same dense nPlates x nPlates matrix, indexed by the same number
// at every one of their fourteen sites. Parallel arrays are three chances to index one of them
// with the wrong pair and no way to notice -- the strength of one margin read against the kind of
// another is a plausible number, and the relief it builds looks like terrain.
//
// A value struct, so the matrix stays one flat allocation with the elements inline: this is a
// coarse grid of at most forty-eight plates, and the array is indexed, never copied.
public bundle Agents {
    public namespace World {

        public struct PlatePair {
            // Which BoundaryKind, as its ordinal -- the same value the coarse origin plane
            // publishes for the ore pass to read long after the relief is done.
            public mutable int kind;
            // |convergence|, 0..1: how hard the two are pushing or pulling.
            public mutable float strength;
            // The plate that rides OVER the other one, which is the half of a subduction that
            // decides where the mountains go and where the trench does.
            public mutable int over;
        }
    }
}
