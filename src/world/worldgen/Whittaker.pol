import System.IO.Console;
program AgentsExe;

// What grows where, from temperature and moisture alone -- the Whittaker diagram, as a ladder.
//
// This is the LAST word in classification, reached only after the specials have had their say:
// water, ice, highland, wetland, salt flat and oasis all answer earlier, because each of them is
// decided by something this diagram does not know about (depth, elevation, a flag, a rare draw).
// What is left is ordinary ground, and ordinary ground is decided by climate.
//
// THE SHAPE IS THE MODEL. Five temperature bands, each with its own moisture ladder, and the
// ladders are deliberately not the same length: cold ground has fewer distinct things it can be
// than temperate ground does. The cut points below are the diagram, and every one of them is a
// number somebody chose by looking at generated worlds -- naming them does not make them
// adjustable, it makes them visible.
public bundle Agents {
    public namespace World {

        public class Whittaker {
            // ---- the five temperature bands ----
            // Below this nothing melts however little falls: permanent ice cap. This is what covers
            // the extreme polar strips -- the belt model keeps the poles dry, so the wet route into
            // IceCap never fired there.
            public static fixed double FROZEN = 0.05;
            public static fixed double POLAR = 0.15;
            public static fixed double COLD = 0.35;
            public static fixed double TEMPERATE = 0.55;
            public static fixed double WARM = 0.78;

            // ---- the moisture ladder, shared by every band that is long enough to use it ----
            public static fixed double ARID = 0.20;
            public static fixed double SEMIARID = 0.40;
            public static fixed double MODERATE = 0.60;
            public static fixed double HUMID = 0.80;

            public static method biomeFor(float t, float m) returns int {
                if (t < Whittaker.FROZEN) { return cast<int>(Biome.IceCap); }
                if (t < Whittaker.POLAR) {
                    if (m < Whittaker.ARID) { return cast<int>(Biome.ColdDesert); }
                    if (m < Whittaker.MODERATE) { return cast<int>(Biome.Tundra); }
                    if (m < Whittaker.HUMID) { return cast<int>(Biome.Snowfield); }
                    return cast<int>(Biome.IceCap);
                }
                if (t < Whittaker.COLD) {
                    if (m < Whittaker.ARID) { return cast<int>(Biome.ColdDesert); }
                    if (m < Whittaker.SEMIARID) { return cast<int>(Biome.Steppe); }
                    return cast<int>(Biome.Taiga);
                }
                if (t < Whittaker.TEMPERATE) {
                    if (m < Whittaker.ARID) { return cast<int>(Biome.ColdDesert); }
                    if (m < Whittaker.SEMIARID) { return cast<int>(Biome.Steppe); }
                    if (m < Whittaker.MODERATE) { return cast<int>(Biome.Prairie); }
                    if (m < Whittaker.HUMID) { return cast<int>(Biome.DeciduousForest); }
                    return cast<int>(Biome.TemperateRainforest);
                }
                if (t < Whittaker.WARM) {
                    if (m < Whittaker.ARID) { return cast<int>(Biome.HotDesert); }
                    if (m < Whittaker.SEMIARID) { return cast<int>(Biome.ThornScrub); }
                    if (m < Whittaker.MODERATE) { return cast<int>(Biome.MedShrubland); }
                    if (m < Whittaker.HUMID) { return cast<int>(Biome.WarmGrassland); }
                    return cast<int>(Biome.LaurelForest);
                }
                if (m < Whittaker.ARID) { return cast<int>(Biome.HotDesert); }
                if (m < Whittaker.SEMIARID) { return cast<int>(Biome.Savanna); }
                if (m < Whittaker.MODERATE) { return cast<int>(Biome.TropSeasonalForest); }
                return cast<int>(Biome.TropicalRainforest);
            }
        }
    }
}
