import System.IO.Console;
import System.Math.Math;
program AgentsExe;

// Scalar maths the worldgen stages share. Kept as statics so Landmass and Tectonics use ONE
// implementation: two divergent noise functions would silently desynchronise the coastline from
// the climate that is sampled over it.
//
// ---- THESE WERE FROZEN, AND THEY WERE UNFROZEN ON PURPOSE (2026-08-11) ----
//
// The note that stood here said these were not slow versions of `Math.*` waiting to be replaced,
// and that swapping them would move every downstream float. The second half was true. The first
// half was an assumption, and it was measured and found wrong: the hand-written series are not a
// different valid choice, they are INACCURATE.
//
//   sine, four terms over [-pi, pi]: differs from the hardware on 85% of a 800,001-point sweep,
//   worst absolute error 0.075 AT x = ±pi -- where the true answer is zero. That is not rounding;
//   at the seam of its own range reduction the series stops being a sine.
//
//   root, Newton from g = v: over 0.001..4000 it lands within 1 ulp of the hardware but differs on
//   a quarter of inputs. Above about 1.6 million it has not converged at all -- fourteen
//   iterations and twenty disagree on 83% of a two-million-point sweep out there.
//
// So this file now calls the intrinsics. It exists because Landmass and Tectonics must share ONE
// implementation -- two divergent noise functions would silently desynchronise the coastline from
// the climate sampled over it -- and that reason is unchanged.
//
// THE PRICE, PAID KNOWINGLY: every seed produces a different world than it did before this commit,
// every golden image changed, and the world audit was re-run to confirm the new world is still a
// good one rather than merely a new one.
public bundle Agents {
    public namespace World {

        public class LandMath {
            // A negative argument answers zero rather than trapping. The callers reach here with
            // sums of squares, so a negative is a rounding artefact at zero and not a question
            // worth refusing -- that behaviour predates the intrinsic and is kept.
            public static method sqrt(float v) returns float {
                if (v <= 0.0) {
                    return 0.0;
                }
                return cast<float>(Math.sqrt(cast<double>(v)));
            }

            public static method sin(float x) returns float {
                return cast<float>(Math.sin(cast<double>(x)));
            }

            public static method cos(float x) returns float {
                return cast<float>(Math.cos(cast<double>(x)));
            }

            // The clamp at 40 stays: it is not an accuracy dodge but a range guard -- the crest
            // profile can be handed a large negative, and exp(40) is already 2.4e17.
            public static method exp(float x) returns float {
                mutable float v = x;
                if (v > 40.0) {
                    v = 40.0;
                }
                if (v < 0.0 - 40.0) {
                    v = 0.0 - 40.0;
                }
                return cast<float>(Math.exp(cast<double>(v)));
            }

            public static method hash01(int seed, int xi, int yi) returns float {
                mutable int n = xi * 374761393;
                n = n + yi * 668265263;
                n = n + seed * 1442695041;
                n = n ^ (n >> 13);
                n = n * 1274126177;
                n = n ^ (n >> 16);
                int m = n & 2147483647;
                return cast<float>(m) / 2147483647.0;
            }

            private static method smooth(float t) returns float {
                return t * t * (3.0 - 2.0 * t);
            }

            public static method vnoise(int seed, float fx, float fy, int period) returns float {
                mutable int p = period;
                if (p < 1) {
                    p = 1;
                }
                int x0 = cast<int>(fx);
                int y0 = cast<int>(fy);
                float tx = fx - cast<float>(x0);
                float ty = fy - cast<float>(y0);
                int x0w = x0 % p;
                int x1w = (x0 + 1) % p;
                float sx = LandMath.smooth(tx);
                float sy = LandMath.smooth(ty);
                float a = LandMath.hash01(seed, x0w, y0);
                float b = LandMath.hash01(seed, x1w, y0);
                float c = LandMath.hash01(seed, x0w, y0 + 1);
                float d = LandMath.hash01(seed, x1w, y0 + 1);
                float ab = a + (b - a) * sx;
                float cd = c + (d - c) * sx;
                return ab + (cd - ab) * sy;
            }

            // multi-octave value noise over normalized coordinates
            public static method fbm(int seed, float nx, float ny, int cells, int octaves) returns float {
                mutable float sum = 0.0;
                mutable float amp = 1.0;
                mutable float tot = 0.0;
                mutable int c = cells;
                mutable int o = 0;
                while (o < octaves) {
                    float v = LandMath.vnoise(seed, nx * cast<float>(c), ny * cast<float>(c), c);
                    sum = sum + v * amp;
                    tot = tot + amp;
                    amp = amp * 0.5;
                    c = c * 2;
                    o = o + 1;
                }
                return sum / tot;
            }
        }
    }
}
