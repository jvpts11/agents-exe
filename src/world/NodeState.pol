import System.IO.Console;
program AgentsExe;

// What is going on at one slot in the NodeField.
//
// Three states, told apart by two sentinels that are easy to read wrongly: a felled tree and a
// never-opened seam BOTH have a kind of zero, and treating them alike is the defect that cost this
// world its ore. A seam that was worked out and one that was never touched look identical from the
// kind alone, so prospecting the same hill twice refilled a mine that was genuinely finished and
// ore stopped being finite. The `blind` byte is what separates them, and this enum is that fact
// with a name on it rather than a comparison repeated at every reader.
//
// The encodings underneath do not change: this is how to ASK, not how it is stored.
public bundle Agents {
    public namespace World {

        public enum NodeState {
            // Something stands here and can be worked.
            Live,
            // Nothing stands here now, but something did. `born` remembers the species, which is
            // how a wood grows back as the wood it was rather than as whatever regrowth fancied.
            Cleared,
            // A working face the world was born with, carrying nothing until somebody opens it.
            // Invisible on purpose: it has to be indistinguishable from bare ground, because every
            // scan asks "is there ore here" by reading the kind.
            Sealed
        }
    }
}
