import System.IO.Console;
import System.Text.StringBuilder;
import Agents.World.Grid;
import Agents.World.Biome;

// Objective acceptance criteria for a generated world. Generation is a search, and without a judge
// that runs before a human looks, every tuning round is a coin flip: three worldgen rewrites were
// rejected on sight for defects nobody had defined a number for. Every measure here is a number,
// and `verdict` returns the FIRST criterion that fails.
program AgentsExe;

public bundle Agents {
    public namespace World {

        public class WorldAudit {
            private mutable Grid* g;
            private mutable int w;
            private mutable int h;
            private mutable int[] comp;        // component id per cell, -1 = water
            private mutable int[] area;        // area per component id
            private mutable int[] stack;       // flood-fill worklist
            private mutable int capacity;
            private mutable int ncomp;
            private mutable int landCells;
            private mutable int[] top;         // the 32 biggest landmasses, descending
            private mutable int nReal;         // components bigger than the noise floor

            // relief: 8-connected components of the HIGHLAND band, and of the volcanic biome
            private mutable int[] rcomp;
            private mutable int[] rarea;
            private mutable int[] rx0;
            private mutable int[] ry0;
            private mutable int[] rx1;
            private mutable int[] ry1;
            private mutable int highCells;
            private mutable int peakMax;
            private mutable int chainElong;    // area-weighted length/width, x100
            private mutable int ventArcs;
            private mutable int ventLargest;
            private mutable int ventCells;
            private mutable int vAtX;
            private mutable int vAtY;

            // resources: the census. Built before the generator that fills it, on purpose -- the
            // worldgen rewrites that were rejected on sight were all judged by eye first, and the
            // numbers only arrived after the third attempt.
            private mutable int[] nodeCount;   // surface nodes per NodeKind ordinal
            private mutable int[] subCount;    // buried deposits per NodeKind ordinal
            private mutable int[] biomeCells;  // land cells per biome
            private mutable int[] biomeTrees;  // of those, cells holding a tree
            private mutable int nodeCells;
            private mutable int subCells;
            private mutable int prospected;
            private mutable int knownSub;      // buried cells a player can already see
            private mutable int oreBodies;
            private mutable int oreSeen;
            private mutable int forestPatches;
            private mutable int forestCells;
            private mutable int forestBiggest;
            private mutable int forestClumped;  // tree cells living in a patch of CLUMP or more
            private mutable int massesLivable;  // landmasses with wood AND stone AND water
            private mutable int massesCounted;
            private mutable boolean[] compLivable;
            private mutable int[] ranked;      // component ids of the biggest landmasses, in order
            private mutable byte[] treeCells;  // trees standing on each cell, from the node field

            public constructor WorldAudit(Grid* grid) {
                g = grid;
                w = grid.width();
                h = grid.height();
                capacity = 65536;
                comp = new int[w * h]();
                area = new int[capacity]();
                stack = new int[w * h]();
                top = new int[32]();
                ncomp = 0;
                landCells = 0;
                nReal = 0;
                rcomp = new int[w * h]();
                rarea = new int[capacity]();
                rx0 = new int[capacity]();
                ry0 = new int[capacity]();
                rx1 = new int[capacity]();
                ry1 = new int[capacity]();
                highCells = 0;
                peakMax = 0;
                chainElong = 0;
                ventArcs = 0;
                ventLargest = 0;
                ventCells = 0;
                vAtX = 0;
                vAtY = 0;
                nodeCount = new int[Nodes.count()]();
                subCount = new int[Nodes.count()]();
                biomeCells = new int[Biomes.count()]();
                biomeTrees = new int[Biomes.count()]();
                nodeCells = 0;
                subCells = 0;
                prospected = 0;
                knownSub = 0;
                oreBodies = 0;
                oreSeen = 0;
                forestPatches = 0;
                forestCells = 0;
                forestBiggest = 0;
                forestClumped = 0;
                massesLivable = 0;
                massesCounted = 0;
                compLivable = new boolean[capacity]();
                ranked = new int[32]();
                treeCells = new byte[w * h]();
            }

            public destructor ~WorldAudit() returns void {
                delete comp;
                delete area;
                delete stack;
                delete top;
                delete rcomp;
                delete rarea;
                delete rx0;
                delete ry0;
                delete rx1;
                delete ry1;
                delete nodeCount;
                delete subCount;
                delete biomeCells;
                delete biomeTrees;
                delete compLivable;
                delete ranked;
                delete treeCells;
            }

            private method isLand(int x, int y) returns boolean {
                return g.biomeAt(x, y) >= 8;
            }

            // 8-connected flood fill over land, iterative: a 3.7M-cell world would blow a
            // recursive stack long before it finished.
            public method analyse() returns void {
                mutable int i = 0;
                int n = w * h;
                while (i < n) {
                    comp[i] = 0 - 1;
                    i = i + 1;
                }
                i = 0;
                while (i < capacity) {
                    area[i] = 0;
                    i = i + 1;
                }
                ncomp = 0;
                landCells = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int seedCell = y * w + x;
                        if (isLand(x, y) && comp[seedCell] == 0 - 1) {
                            int id = ncomp;
                            ncomp = ncomp + 1;
                            mutable int sp = 0;
                            stack[sp] = seedCell;
                            sp = sp + 1;
                            comp[seedCell] = id;
                            mutable int count = 0;
                            while (sp > 0) {
                                sp = sp - 1;
                                int cell = stack[sp];
                                int cx = cell % w;
                                int cy = cell / w;
                                count = count + 1;
                                mutable int dy = 0 - 1;
                                while (dy <= 1) {
                                    mutable int dx = 0 - 1;
                                    while (dx <= 1) {
                                        int nx = cx + dx;
                                        int ny = cy + dy;
                                        if (nx >= 0 && ny >= 0 && nx < w && ny < h) {
                                            int ni = ny * w + nx;
                                            if (comp[ni] == 0 - 1 && isLand(nx, ny)) {
                                                comp[ni] = id;
                                                stack[sp] = ni;
                                                sp = sp + 1;
                                            }
                                        }
                                        dx = dx + 1;
                                    }
                                    dy = dy + 1;
                                }
                            }
                            if (id < capacity) {
                                area[id] = count;
                            }
                            landCells = landCells + count;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                rank();
                analyseRelief();
                // The resource census reads the component map this pass just built, so it belongs
                // here rather than at a call site that could forget the ordering.
                analyseResources();
                return;
            }

            // ---- relief ------------------------------------------------------------------------
            // The highland band is read off the ELEVATION, not off the biome names: the contour is
            // the contract line, and measuring it directly is what catches a mismatch between what
            // the generator built and what classify decided to call it. The audit holds no copy of
            // that number -- a judge with its own private idea of where the mountains start is not
            // judging the thing that was built.
            private method isHigh(int x, int y) returns boolean {
                return isLand(x, y) && g.elevAt(x, y) >= Contour.HIGHLAND_STORED;
            }

            private method isVent(int x, int y) returns boolean {
                return g.biomeAt(x, y) == 36;
            }

            private method analyseRelief() returns void {
                peakMax = 0;
                highCells = 0;
                ventCells = 0;
                mutable int i = 0;
                int n = w * h;
                while (i < n) {
                    int x = i % w;
                    int y = i / w;
                    if (isLand(x, y)) {
                        int e = g.elevAt(x, y);
                        if (e > peakMax) {
                            peakMax = e;
                        }
                        if (e >= Contour.HIGHLAND_STORED) {
                            highCells = highCells + 1;
                        }
                    }
                    if (isVent(x, y)) {
                        ventCells = ventCells + 1;
                    }
                    i = i + 1;
                }
                chainElong = floodRelief(0);
                floodRelief(1);
                return;
            }

            // 8-connected components of the relief predicate. mode 0 = highland (returns the
            // area-weighted elongation x100), mode 1 = volcanic (fills ventArcs/ventLargest).
            private method floodRelief(int mode) returns int {
                mutable int i = 0;
                int n = w * h;
                while (i < n) {
                    rcomp[i] = 0 - 1;
                    i = i + 1;
                }
                mutable int nc = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        int seedCell = y * w + x;
                        mutable boolean hit = isHigh(x, y);
                        if (mode == 1) {
                            hit = isVent(x, y);
                        }
                        if (hit && rcomp[seedCell] == 0 - 1 && nc < capacity) {
                            int id = nc;
                            nc = nc + 1;
                            mutable int sp = 0;
                            stack[sp] = seedCell;
                            sp = sp + 1;
                            rcomp[seedCell] = id;
                            mutable int count = 0;
                            mutable int bx0 = x;
                            mutable int by0 = y;
                            mutable int bx1 = x;
                            mutable int by1 = y;
                            while (sp > 0) {
                                sp = sp - 1;
                                int cell = stack[sp];
                                int cx = cell % w;
                                int cy = cell / w;
                                count = count + 1;
                                if (cx < bx0) {
                                    bx0 = cx;
                                }
                                if (cy < by0) {
                                    by0 = cy;
                                }
                                if (cx > bx1) {
                                    bx1 = cx;
                                }
                                if (cy > by1) {
                                    by1 = cy;
                                }
                                mutable int dy = 0 - 1;
                                while (dy <= 1) {
                                    mutable int dx = 0 - 1;
                                    while (dx <= 1) {
                                        int nx = cx + dx;
                                        int ny = cy + dy;
                                        if (nx >= 0 && ny >= 0 && nx < w && ny < h) {
                                            int ni = ny * w + nx;
                                            mutable boolean ok = isHigh(nx, ny);
                                            if (mode == 1) {
                                                ok = isVent(nx, ny);
                                            }
                                            if (rcomp[ni] == 0 - 1 && ok) {
                                                rcomp[ni] = id;
                                                stack[sp] = ni;
                                                sp = sp + 1;
                                            }
                                        }
                                        dx = dx + 1;
                                    }
                                    dy = dy + 1;
                                }
                            }
                            rarea[id] = count;
                            rx0[id] = bx0;
                            ry0[id] = by0;
                            rx1[id] = bx1;
                            ry1[id] = by1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                int floorSz = noiseFloor();
                if (mode == 1) {
                    mutable int arcs = 0;
                    mutable int big = 0;
                    i = 0;
                    while (i < nc) {
                        if (rarea[i] >= floorSz) {
                            arcs = arcs + 1;
                        }
                        if (rarea[i] > big) {
                            big = rarea[i];
                        }
                        i = i + 1;
                    }
                    ventArcs = arcs;
                    ventLargest = big;
                    return 0;
                }
                // Length over width, area-weighted. A range is long and thin; a slab is not.
                // Width is derived (area / length) rather than measured, because a chain that bends
                // has no single cross-section -- what matters is that it does not fill its own box.
                mutable int wsum = 0;
                mutable int acc = 0;
                i = 0;
                while (i < nc) {
                    int a = rarea[i];
                    if (a >= floorSz) {
                        mutable int len = rx1[i] - rx0[i] + 1;
                        int hgt = ry1[i] - ry0[i] + 1;
                        if (hgt > len) {
                            len = hgt;
                        }
                        int elong = len * len * 100 / a;
                        acc = acc + elong * a;
                        wsum = wsum + a;
                    }
                    i = i + 1;
                }
                if (wsum == 0) {
                    return 0;
                }
                return acc / wsum;
            }

            // The longest DEAD STRAIGHT, axis-aligned stretch of biome boundary in the world.
            // A natural boundary staircases, so its straight runs are short; a boundary that came
            // from reading a discrete decision (which plate, which side of it) off a coarse grid by
            // nearest neighbour runs straight for as long as that decision holds, which is how a
            // volcanic arc, an island and a shelf all ended dead on a perfectly vertical line.
            // This is the number that says whether the abrupt stop is gone, instead of my eye.
            // Reported separately by orientation, because they have different causes and mixing
            // them hid the one that mattered. A long HORIZONTAL edge is usually honest: climate is
            // a function of latitude, so a sea-ice or tundra line runs along a parallel. A long
            // VERTICAL edge has no such excuse -- nothing in the model depends on x alone.
            public method straightestEdge() returns int {
                mutable int v = straightestV();
                int hh = straightestH();
                if (hh > v) {
                    v = hh;
                }
                return v;
            }

            // Measured on the COASTLINE, not on biome pairs. The first version of this required the
            // same pair of biomes along the whole run, and along the cut in question the pair keeps
            // changing -- grass|beach, beach|shallow, shallow|deep -- so the counter reset at every
            // step and the instrument reported 33 for an artefact a hundred cells long. What the
            // eye actually sees is the land/water boundary running dead straight.
            public method straightestV() returns int {
                mutable int best = 0;
                mutable int x = 0;
                while (x + 1 < w) {
                    mutable int run = 0;
                    mutable int y = 0;
                    while (y < h) {
                        if (isLand(x, y) != isLand(x + 1, y)) {
                            run = run + 1;
                            if (run > best) {
                                best = run;
                                vAtX = x;
                                vAtY = y - run + 1;
                            }
                        } else {
                            run = 0;
                        }
                        y = y + 1;
                    }
                    x = x + 1;
                }
                return best;
            }

            // Where the longest vertical run was, so it can be cut open and looked at instead of
            // argued about.
            public method vSeamX() returns int {
                return vAtX;
            }

            public method vSeamY() returns int {
                return vAtY;
            }

            public method straightestH() returns int {
                mutable int best = 0;
                mutable int y2 = 0;
                while (y2 + 1 < h) {
                    mutable int run = 0;
                    mutable int x2 = 0;
                    while (x2 < w) {
                        if (isLand(x2, y2) != isLand(x2, y2 + 1)) {
                            run = run + 1;
                            if (run > best) {
                                best = run;
                            }
                        } else {
                            run = 0;
                        }
                        x2 = x2 + 1;
                    }
                    y2 = y2 + 1;
                }
                return best;
            }

            public method highlandShare() returns int {
                if (landCells == 0) {
                    return 0;
                }
                return highCells * 1000 / landCells;
            }

            public method peakElevation() returns int {
                return peakMax;
            }

            public method chainElongation() returns int {
                return chainElong;
            }

            // Continents are the N BIGGEST landmasses, not every component over some absolute
            // share. The share rule was wrong: a Greenland-sized island cleared 0.5% of the land,
            // got counted as a continent, and blew the size ratio to 39:1 -- reporting a defect
            // where the world actually had six continents and a few big islands, which is what
            // Earth looks like. Rank once, then read the criteria off the ranking.
            private method rank() returns void {
                mutable int i = 0;
                while (i < 32) {
                    top[i] = 0;
                    i = i + 1;
                }
                nReal = 0;
                int lim = compLimit();
                i = 0;
                while (i < lim) {
                    int a = area[i];
                    if (a > noiseFloor()) {
                        nReal = nReal + 1;
                        // insertion into the descending top list
                        mutable int j = 31;
                        while (j > 0 && top[j - 1] < a) {
                            top[j] = top[j - 1];
                            j = j - 1;
                        }
                        if (j < 32) {
                            top[j] = a;
                        }
                    }
                    i = i + 1;
                }
                return;
            }

            // Below this a component is coastal noise, not a feature: one part in 20000 of the
            // world, ~180 cells at 2560x1440.
            private method noiseFloor() returns int {
                mutable int f = w * h / 20000;
                if (f < 40) {
                    f = 40;
                }
                return f;
            }

            private method compLimit() returns int {
                if (ncomp < capacity) {
                    return ncomp;
                }
                return capacity;
            }

            public method landTotal() returns int {
                return landCells;
            }

            // every landmass above the noise floor -- continents AND islands
            public method components() returns int {
                return nReal;
            }

            // the n-th biggest landmass (0-based), or 0
            public method nthArea(int n) returns int {
                if (n < 0 || n >= 32) {
                    return 0;
                }
                return top[n];
            }

            public method islandCount(int wantContinents) returns int {
                mutable int c = nReal - wantContinents;
                if (c < 0) {
                    c = 0;
                }
                return c;
            }

            // per mille of all land held by the biggest landmass
            public method largestShare() returns int {
                if (landCells == 0) {
                    return 0;
                }
                return top[0] * 1000 / landCells;
            }

            // biggest : smallest among the CONTINENTS, x100
            public method sizeRatio(int wantContinents) returns int {
                mutable int k = wantContinents;
                if (k > nReal) {
                    k = nReal;
                }
                if (k > 32) {
                    k = 32;
                }
                if (k < 2) {
                    return 0;
                }
                int worst = top[k - 1];
                if (worst <= 0) {
                    return 0;
                }
                return top[0] * 100 / worst;
            }

            // The precise form of "as massas nao podem se ligar": how many pairs of continent
            // centres share a connected component. A narrow waist INSIDE one landmass is
            // legitimate (Panama exists) and is deliberately not punished.
            public method fusedContinents(int[] cx, int[] cy, int n) returns int {
                int[] owner = new int[n]();
                mutable int i = 0;
                while (i < n) {
                    owner[i] = comp[clampIdx(cx[i], cy[i])];
                    i = i + 1;
                }
                mutable int fused = 0;
                i = 0;
                while (i < n) {
                    if (owner[i] >= 0) {
                        mutable int j = i + 1;
                        while (j < n) {
                            if (owner[j] == owner[i]) {
                                fused = fused + 1;
                            }
                            j = j + 1;
                        }
                    }
                    i = i + 1;
                }
                delete owner;
                return fused;
            }

            private method clampIdx(int x, int y) returns int {
                mutable int xx = x;
                if (xx < 0) {
                    xx = 0;
                }
                if (xx >= w) {
                    xx = w - 1;
                }
                mutable int yy = y;
                if (yy < 0) {
                    yy = 0;
                }
                if (yy >= h) {
                    yy = h - 1;
                }
                return yy * w + xx;
            }

            // ---- the resource census ----
            // Runs after analyse(), because the per-landmass check reads its component map.

            private method waterNear(int x, int y) returns boolean {
                if (g.hasRiver(x, y)) {
                    return true;
                }
                if (g.isLake(x, y)) {
                    return true;
                }
                if (g.biomeAt(x - 1, y) < 8) { return true; }
                if (g.biomeAt(x + 1, y) < 8) { return true; }
                if (g.biomeAt(x, y - 1) < 8) { return true; }
                if (g.biomeAt(x, y + 1) < 8) { return true; }
                return false;
            }

            private method isStoneSource(int kind) returns boolean {
                if (kind == PropNode.Boulder.index()) {
                    return true;
                }
                if (kind == EarthNode.StoneRock.index()) {
                    return true;
                }
                return false;
            }

            public method analyseResources() returns void {
                for (int k in 0..Nodes.count()) {
                    nodeCount[k] = 0;
                    subCount[k] = 0;
                }
                for (int b in 0..Biomes.count()) {
                    biomeCells[b] = 0;
                    biomeTrees[b] = 0;
                }
                nodeCells = 0;
                subCells = 0;
                prospected = 0;
                knownSub = 0;
                NodeField* nf = g.surface();
                nf.cellCounts(treeCells, true);
                // Surface nodes are INSTANCES, so they are counted one by one -- a tile may hold
                // three of them, and the old per-tile sweep would have seen one.
                for (int i in 0..nf.size()) {
                    int k = nf.kindAt(i);
                    if (k == 0) {
                        continue;
                    }
                    nodeCount[k] = nodeCount[k] + 1;
                    nodeCells = nodeCells + 1;
                }
                // Per landmass, the three things an agent cannot start without. Sized to the
                // component table, so an unranked island is judged on the same terms as a continent.
                int lim = compLimit();
                boolean[] wood = new boolean[lim + 1]();
                boolean[] stone = new boolean[lim + 1]();
                boolean[] water = new boolean[lim + 1]();
                boolean[] seen = new boolean[lim + 1]();
                for (int y in 0..this.h) {
                    for (int x in 0..this.w) {
                        int i = y * w + x;
                        int ord = g.biomeAt(x, y);
                        boolean land = ord >= 8;
                        boolean hasTree = (cast<int>(treeCells[i]) & 255) > 0;
                        if (land) {
                            biomeCells[ord] = biomeCells[ord] + 1;
                            if (hasTree) {
                                biomeTrees[ord] = biomeTrees[ord] + 1;
                            }
                        }
                        int burd = g.subAt(x, y);
                        if (burd != 0) {
                            subCount[burd] = subCount[burd] + 1;
                            subCells = subCells + 1;
                        }
                        if (g.isProspected(x, y)) {
                            prospected = prospected + 1;
                            if (burd != 0) {
                                knownSub = knownSub + 1;
                            }
                        }
                        if (land) {
                            int c = comp[i];
                            if (c >= 0 && c < lim) {
                                seen[c] = true;
                                if (hasTree) {
                                    wood[c] = true;
                                }
                                if (!water[c] && waterNear(x, y)) {
                                    water[c] = true;
                                }
                            }
                        }
                    }
                }
                // Stone is a node kind, so it is read off the instances rather than the tiles.
                for (int i in 0..nf.size()) {
                    if (isStoneSource(nf.kindAt(i))) {
                        int c = comp[clampIdx(nf.cellXAt(i), nf.cellYAt(i))];
                        if (c >= 0 && c < lim) {
                            stone[c] = true;
                        }
                    }
                }
                massesLivable = 0;
                massesCounted = 0;
                int floor = noiseFloor();
                for (int c in 0..lim) {
                    compLivable[c] = wood[c] && stone[c] && water[c];
                    if (seen[c] && area[c] > floor) {
                        massesCounted = massesCounted + 1;
                        if (compLivable[c]) {
                            massesLivable = massesLivable + 1;
                        }
                    }
                }
                delete wood;
                delete stone;
                delete water;
                delete seen;
                forestPatches = floodForest();
                analyseOre();
                return;
            }

            // 8-connected components over cells holding a TREE. The one number that says whether a
            // forest generator worked at all: a per-cell density produces thousands of one-cell
            // patches, a field produces tens of big ones, and the two are indistinguishable in a
            // total count.
            private method floodForest() returns int {
                int n = w * h;
                int[] mark = new int[n]();          // zero-initialised: 0 = not yet visited
                mutable int patches = 0;
                mutable int cells = 0;
                mutable int biggest = 0;
                mutable int clumped = 0;
                for (int sy in 0..this.h) {
                    for (int sx in 0..this.w) {
                        int s0 = sy * w + sx;
                        if (mark[s0] == 0 && (cast<int>(treeCells[s0]) & 255) > 0) {
                            mutable int sp = 0;
                            stack[sp] = s0;
                            sp = sp + 1;
                            mark[s0] = 1;
                            mutable int size = 0;
                            while (sp > 0) {
                                sp = sp - 1;
                                int cur = stack[sp];
                                size = size + 1;
                                int cx = cur % w;
                                int cy = cur / w;
                                mutable int dy = 0 - 1;
                                while (dy <= 1) {
                                    mutable int dx = 0 - 1;
                                    while (dx <= 1) {
                                        int nx = cx + dx;
                                        int ny = cy + dy;
                                        if (nx >= 0 && ny >= 0 && nx < w && ny < h) {
                                            int j = ny * w + nx;
                                            if (mark[j] == 0 && (cast<int>(treeCells[j]) & 255) > 0) {
                                                mark[j] = 1;
                                                stack[sp] = j;
                                                sp = sp + 1;
                                            }
                                        }
                                        dx = dx + 1;
                                    }
                                    dy = dy + 1;
                                }
                            }
                            patches = patches + 1;
                            cells = cells + size;
                            if (size >= WorldAudit.CLUMP) {
                                clumped = clumped + size;
                            }
                            if (size > biggest) {
                                biggest = size;
                            }
                        }
                    }
                }
                delete mark;
                forestCells = cells;
                forestBiggest = biggest;
                forestClumped = clumped;
                return patches;
            }

            // 8-connected components of the buried layer, one kind at a time, and how many of them
            // hold a cell the player can already see. Measured HERE rather than taken from the
            // generator's own tally, because an audit that trusts the thing it is auditing cannot
            // catch it lying -- and this is the number the early game lives on.
            private method analyseOre() returns void {
                int n = w * h;
                int[] mark = new int[n]();
                mutable int bodies = 0;
                mutable int reach = 0;
                for (int sy in 0..this.h) {
                    for (int sx in 0..this.w) {
                        int s0 = sy * w + sx;
                        int kind = g.subAt(sx, sy);
                        if (mark[s0] != 0 || kind == 0) {
                            continue;
                        }
                        mutable int sp = 0;
                        stack[sp] = s0;
                        sp = sp + 1;
                        mark[s0] = 1;
                        mutable boolean seenHere = false;
                        while (sp > 0) {
                            sp = sp - 1;
                            int cur = stack[sp];
                            int cx = cur % w;
                            int cy = cur / w;
                            if (g.isProspected(cx, cy)) {
                                seenHere = true;
                            }
                            mutable int dy = 0 - 1;
                            while (dy <= 1) {
                                mutable int dx = 0 - 1;
                                while (dx <= 1) {
                                    int nx = cx + dx;
                                    int ny = cy + dy;
                                    if (nx >= 0 && ny >= 0 && nx < w && ny < h) {
                                        int j = ny * w + nx;
                                        if (mark[j] == 0 && g.subAt(nx, ny) == kind) {
                                            mark[j] = 1;
                                            stack[sp] = j;
                                            sp = sp + 1;
                                        }
                                    }
                                    dx = dx + 1;
                                }
                                dy = dy + 1;
                            }
                        }
                        bodies = bodies + 1;
                        if (seenHere) {
                            reach = reach + 1;
                        }
                    }
                }
                delete mark;
                oreBodies = bodies;
                oreSeen = reach;
                return;
            }

            public method oreBodyCount() returns int {
                return oreBodies;
            }

            // Per mille of ore bodies with at least one cell showing at the surface. Low means the
            // early game starves: everything is down there and nothing can be found.
            public method oreReach() returns int {
                if (oreBodies == 0) {
                    return 0;
                }
                return oreSeen * 1000 / oreBodies;
            }

            // The first forest biome whose tree cover falls outside the band, or -1. Biomes with
            // almost no cells are skipped: a seed that rolled three cells of taiga should not fail
            // on the cover of three cells.
            public method forestCoverFail() returns int {
                int[] want = new int[5]();
                want[0] = 14;                                   // TropicalRainforest
                want[1] = 21;                                   // LaurelForest
                want[2] = 22;                                   // DeciduousForest
                want[3] = 23;                                   // TemperateRainforest
                want[4] = 27;                                   // Taiga
                mutable int bad = 0 - 1;
                for (int k in 0..5) {
                    int b = want[k];
                    if (biomeCells[b] >= 20000) {
                        int c = treeCover(b);
                        if (c < 250 || c > 900) {
                            if (bad < 0) {
                                bad = b;
                            }
                        }
                    }
                }
                delete want;
                return bad;
            }

            public method nodeTotal() returns int {
                return nodeCells;
            }

            public method subTotal() returns int {
                return subCells;
            }

            public method prospectedCells() returns int {
                return prospected;
            }

            public method patchCount() returns int {
                return forestPatches;
            }

            // Mean cells per forest patch. Dust reads as 1, a wood as hundreds.
            public method meanPatch() returns int {
                if (forestPatches == 0) {
                    return 0;
                }
                return forestCells / forestPatches;
            }

            public method largestPatch() returns int {
                return forestBiggest;
            }

            // A patch this big is a WOOD; anything smaller is a copse or a stray tree.
            public static int CLUMP = 64;

            // Per mille of all tree cells that live in a patch of CLUMP or more. This is the number
            // that tells dust from forest, and it does it independently of how dense the trees are:
            // a per-cell hash scores near zero at ANY density, because its trees never touch in
            // runs; a density field scores high even when the field itself is thin.
            public method clumpShare() returns int {
                if (forestCells == 0) {
                    return 0;
                }
                return forestClumped * 1000 / forestCells;
            }

            // Per mille of a biome's cells that carry a tree.
            public method treeCover(int biomeOrd) returns int {
                if (biomeCells[biomeOrd] == 0) {
                    return 0;
                }
                return biomeTrees[biomeOrd] * 1000 / biomeCells[biomeOrd];
            }

            // How many NodeKinds never appear anywhere: a missing kind breaks a chain in ECONOMY.md,
            // so it has to fail as loudly as a missing biome does.
            public method kindsMissing() returns int {
                mutable int miss = 0;
                for (int k in 1..Nodes.count()) {
                    if (nodeCount[k] == 0 && subCount[k] == 0) {
                        miss = miss + 1;
                    }
                }
                return miss;
            }

            public method livableMasses() returns int {
                return massesLivable;
            }

            // Of the `want` BIGGEST landmasses -- the continents -- how many an agent could actually
            // start on. An island without stone is a fact of geography and not a defect; a continent
            // without it is a generation failure, and only this number tells them apart.
            public method livableContinents(int want) returns int {
                int lim = compLimit();
                mutable int ok = 0;
                mutable int rank2 = 0;
                while (rank2 < want) {
                    mutable int bestC = 0 - 1;
                    mutable int bestA = 0;
                    for (int c in 0..lim) {
                        if (area[c] > bestA && !compRanked(c, rank2)) {
                            bestA = area[c];
                            bestC = c;
                        }
                    }
                    if (bestC < 0) {
                        return ok;
                    }
                    ranked[rank2] = bestC;
                    if (compLivable[bestC]) {
                        ok = ok + 1;
                    }
                    rank2 = rank2 + 1;
                }
                return ok;
            }

            // Already taken by an earlier rank in the selection above.
            private method compRanked(int c, int upto) returns boolean {
                mutable int k = 0;
                while (k < upto) {
                    if (ranked[k] == c) {
                        return true;
                    }
                    k = k + 1;
                }
                return false;
            }

            public method countedMasses() returns int {
                return massesCounted;
            }

            public method resourceReport(int wantContinents) returns void {
                StringBuilder rs = new StringBuilder() on heap;
                rs.append("resources: surface ");
                rs.appendInt(nodeCells);
                rs.append(" nodes | buried ");
                rs.appendInt(subCells);
                rs.append(" cells, ");
                rs.appendInt(knownSub);
                rs.append(" of them already visible | prospected ");
                rs.appendInt(prospected);
                rs.append(" | kinds missing ");
                rs.appendInt(kindsMissing());
                rs.append(" of ");
                rs.appendInt(Nodes.count() - 1);
                rs.append(" | ore bodies ");
                rs.appendInt(oreBodyCount());
                rs.append(", reachable ");
                rs.appendInt(oreReach());
                rs.append("/1000 (want 450+)");
                System.IO.Console.println(rs.toString());
                delete rs;
                StringBuilder fp = new StringBuilder() on heap;
                fp.append("  forest: ");
                fp.appendInt(forestPatches);
                fp.append(" patches, mean ");
                fp.appendInt(meanPatch());
                fp.append(" cells, biggest ");
                fp.appendInt(forestBiggest);
                fp.append(" | in woods (64+) ");
                fp.appendInt(clumpShare());
                fp.append("/1000 | wood+stone+water: continents ");
                fp.appendInt(livableContinents(wantContinents));
                fp.append("/");
                fp.appendInt(wantContinents);
                fp.append(", all landmasses ");
                fp.appendInt(massesLivable);
                fp.append("/");
                fp.appendInt(massesCounted);
                System.IO.Console.println(fp.toString());
                delete fp;
                // Tree cover per biome, which is where a palette that is too thin or too thick
                // actually shows -- the world total hides it behind the biomes that grow nothing.
                StringBuilder tc = new StringBuilder() on heap;
                tc.append("  tree cover /1000:");
                for (int b in 0..Biomes.count()) {
                    if (biomeTrees[b] > 0) {
                        tc.append(" ");
                        tc.append(Biomes.name(b));
                        tc.append("=");
                        tc.appendInt(treeCover(b));
                    }
                }
                System.IO.Console.println(tc.toString());
                delete tc;
                // Per-kind tally, only for kinds that exist, so the line stays readable.
                StringBuilder kc = new StringBuilder() on heap;
                kc.append("  by kind:");
                mutable boolean any = false;
                for (int k in 1..Nodes.count()) {
                    int tot = nodeCount[k] + subCount[k];
                    if (tot > 0) {
                        kc.append(" ");
                        kc.append(Nodes.name(k));
                        kc.append("=");
                        kc.appendInt(tot);
                        any = true;
                    }
                }
                if (!any) {
                    kc.append(" (none placed)");
                }
                System.IO.Console.println(kc.toString());
                delete kc;
                return;
            }

            public method reasonName(int ordinal) returns String {
                if (ordinal == 0) {
                    return "PASS";
                }
                if (ordinal == 1) {
                    return "TooFewLandmasses";
                }
                if (ordinal == 2) {
                    return "FusedContinents";
                }
                if (ordinal == 3) {
                    return "DominantMass";
                }
                if (ordinal == 4) {
                    return "SizeSpread";
                }
                if (ordinal == 5) {
                    return "IslandCount";
                }
                if (ordinal == 6) {
                    return "MountainShare";
                }
                if (ordinal == 7) {
                    return "MountainLinearity";
                }
                if (ordinal == 8) {
                    return "FlatLandContract";
                }
                if (ordinal == 9) {
                    return "MissingResource";
                }
                if (ordinal == 10) {
                    return "BarrenContinent";
                }
                if (ordinal == 11) {
                    return "ForestDust";
                }
                if (ordinal == 12) {
                    return "ForestCover";
                }
                return "OreUnreachable";
            }

            // Shape verdict. The relief criteria join this method once Tectonics exists.
            public method verdict(int wantContinents) returns int {
                if (components() < wantContinents) {
                    return cast<int>(RejectReason.TooFewLandmasses);
                }
                if (largestShare() > 450) {
                    return cast<int>(RejectReason.DominantMass);
                }
                // 1.5:1 to 6:1 between the biggest continent and the smallest. The first band here
                // was 2:1 to 4.5:1, taken from Earth's six largest continents, and it rejected 7 of
                // 12 seeds -- half of them for being too uniform, half for being too uneven, and
                // none of them visibly wrong when the twelve renders were laid side by side. The
                // criterion that guards the thing that actually matters is DominantMass above: no
                // single landmass may hold more than 45% of the land, and no seed has ever come
                // close (21-35%). This one only rules out a world of six clones and a world with
                // one continent and five scraps.
                int r = sizeRatio(wantContinents);
                if (r < 150 || r > 600) {
                    return cast<int>(RejectReason.SizeSpread);
                }
                int isl = islandCount(wantContinents);
                if (isl < 3 || isl > 12) {
                    return cast<int>(RejectReason.IslandCount);
                }
                // relief
                int hs = highlandShare();
                if (hs < 80 || hs > 280) {
                    return cast<int>(RejectReason.MountainShare);
                }
                if (chainElongation() < 250) {
                    return cast<int>(RejectReason.MountainLinearity);
                }
                // the band has to be REACHED, not merely entered: a range that tops out at 0.70 has
                // no snow line, and Glacier/SnowPeak never appear anywhere in the world
                if (peakElevation() < 9000) {
                    return cast<int>(RejectReason.FlatLandContract);
                }
                // resources. A missing kind comes first because it is not a matter of degree: every
                // node in ECONOMY.md section 1 has a building and an era behind it, and a world
                // without one has a chain that can never complete.
                if (kindsMissing() > 0) {
                    return cast<int>(RejectReason.MissingResource);
                }
                if (livableContinents(wantContinents) < wantContinents) {
                    return cast<int>(RejectReason.BarrenContinent);
                }
                // Dust versus forest, independent of density: below this the trees are a sprinkle,
                // whatever the cover says.
                if (clumpShare() < 400) {
                    return cast<int>(RejectReason.ForestDust);
                }
                if (forestCoverFail() >= 0) {
                    return cast<int>(RejectReason.ForestCover);
                }
                // If most ore bodies show nowhere, everything is down there and nothing can be
                // found, and the early game starves before prospecting is ever unlocked.
                if (oreBodyCount() > 0 && oreReach() < 450) {
                    return cast<int>(RejectReason.OreUnreachable);
                }
                return cast<int>(RejectReason.None);
            }

            public method report(int wantContinents) returns void {
                StringBuilder sb = new StringBuilder() on heap;
                sb.append("shape: landmasses ");
                sb.appendInt(components());
                sb.append(" (want ");
                sb.appendInt(wantContinents);
                sb.append(" continents) | islands ");
                sb.appendInt(islandCount(wantContinents));
                sb.append(" | largest ");
                sb.appendInt(largestShare());
                sb.append("/1000 of land | size ratio ");
                sb.appendInt(sizeRatio(wantContinents));
                sb.append("/100");
                System.IO.Console.println(sb.toString());
                delete sb;
                StringBuilder sz = new StringBuilder() on heap;
                sz.append("  landmass areas:");
                mutable int k = 0;
                mutable int lim = nReal;
                if (lim > 12) {
                    lim = 12;
                }
                while (k < lim) {
                    sz.append(" ");
                    sz.appendInt(nthArea(k));
                    if (k == wantContinents - 1) {
                        sz.append(" |");
                    }
                    k = k + 1;
                }
                System.IO.Console.println(sz.toString());
                delete sz;
                StringBuilder rl = new StringBuilder() on heap;
                rl.append("relief: highland ");
                rl.appendInt(highlandShare());
                rl.append("/1000 of land (want 80..280) | peak ");
                rl.appendInt(peakElevation());
                rl.append("/10000 (want 9000+) | chain elongation ");
                rl.appendInt(chainElongation());
                rl.append("/100 (want 250+) | volcanic ");
                rl.appendInt(ventCells);
                rl.append(" cells in ");
                rl.appendInt(ventArcs);
                rl.append(" arcs, biggest ");
                rl.appendInt(ventLargest);
                rl.append(" | longest straight coast: vertical ");
                rl.appendInt(straightestV());
                rl.append(" at x=");
                rl.appendInt(vSeamX());
                rl.append(",y=");
                rl.appendInt(vSeamY());
                rl.append(" | horizontal ");
                rl.appendInt(straightestH());
                System.IO.Console.println(rl.toString());
                delete rl;
                resourceReport(wantContinents);
                int v = verdict(wantContinents);
                String nm = reasonName(v);
                StringBuilder s2 = new StringBuilder() on heap;
                if (v == 0) {
                    s2.append("verdict: PASS");
                } else {
                    s2.append("verdict: FAIL - ");
                    s2.append(nm);
                }
                System.IO.Console.println(s2.toString());
                delete s2;
                return;
            }
        }
    }
}
