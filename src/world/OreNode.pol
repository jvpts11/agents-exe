import System.IO.Console;
import Agents.World.EconomyNodes;
import Agents.World.EconomyGoods;
import Agents.World.NodeClass;
import Agents.World.NodeId;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// Metals and energy: the miner's finds, and the reason prospecting exists -- always buryable.
// Begins at GemRock (the standing table classes gems MetalEnergy, verified at C2.1).
// index() is 27 + the local ordinal, ending the kinds at 36.
public bundle Agents {
    public namespace World {

        public enum OreNode extends EconomyNodes {
            GemRock(120, ExtractedGood.Gems),
            IronVein(900, ExtractedGood.IronOre),
            CopperVein(800, ExtractedGood.CopperOre),
            TinVein(500, ExtractedGood.TinOre),
            GoldVein(250, ExtractedGood.GoldOre),
            SilverVein(350, ExtractedGood.SilverOre),
            CoalSeam(1500, ExtractedGood.Coal),
            SulfurVent(400, ExtractedGood.Sulfur),
            OilSeep(1200, ExtractedGood.Oil),
            RareEarth(200, ExtractedGood.RareEarth);

            private int qty;
            private EconomyGoods yieldOf;

            public constructor OreNode(int qty, EconomyGoods yieldOf) {
                this.qty = qty;
                this.yieldOf = yieldOf;
            }

            public method kind() returns NodeClass {
                return NodeClass.MetalEnergy;
            }

            public method atlas() returns NodeAtlas {
                return NodeAtlas.Nodes;
            }

            public method buryable() returns boolean {
                return true;
            }

            public method baseQty() returns int {
                return qty;
            }

            public method gives() returns EconomyGoods {
                return yieldOf;
            }

            public method work() returns Harvest {
                return Harvest.Mine;
            }

            public method index() returns NodeId {
                demand 27 == 22 + EarthNode.count()
                    otherwise "the veins begin where the ground itself ends";
                return cast<NodeId>(27 + cast<int>(this));
            }
        }
    }
}
