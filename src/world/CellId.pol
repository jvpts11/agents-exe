program AgentsExe;

// WHICH CELL OF THE WORLD -- `y * width + x`, the index the owner map and the waymap are read by.
//
// IT EXISTS FOR ONE INTERFACE. `Landholder` has four methods and two of them take a number:
// `claim(cell)` takes an index into the world, and `cellAt(i)` takes a position in this holder's own
// list and RETURNS one of the first kind. Two different numbers, both `int`, one method apart --
// and handing `cellAt` a cell index does not fail. It returns whatever cell the holder took that
// many claims ago, which is a real cell somewhere else on the map.
//
// WHERE IT DOES NOT GO: the worldgen passes. `Hydrology`, `Landmass` and `WorldAudit` all have a
// local called `cell` inside one method -- flooding a basin, walking a stack -- and none of them
// hands it to anybody. A type earns its keep at a seam; inside one loop it is a cast per iteration
// and nothing learned.
public bundle Agents {
    public namespace World {

        public newtype CellId = int;
    }
}
