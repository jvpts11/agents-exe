import System.IO.Console;
program AgentsExe;

// Who goes and gets it. This is the axis the WORK is organised along, and it is deliberately
// not NodeClass: a boulder and an iron vein are both rock to a geologist, and a woodcutter
// and a forager both take living things, but the man who goes out with an axe and the woman
// who goes out with a basket are doing different jobs in different places.
//
// It is also the axis the world is INDEXED along. A community asks "where is there wood
// within reach" a few times a second, and the answer comes from a coarse count per class --
// one number per sixteen-cell block -- so the question costs a lookup instead of a sweep.
public bundle Agents {
    public namespace World {

        public enum Harvest {
            Nothing,
            Timber,      // the ten tree species
            Forage,      // berries, mushrooms, herbs, wild grain, vines, fibre, reeds, cactus
            Quarry,      // loose stone, marble, clay, salt -- and the boulder
            Mine,        // the ten metal and energy veins
            Fishing;     // fishing spots

            // Which harvest classes come back on their own. Berries fruit again and a fishing
            // ground refills; a tree that has been felled is gone and so is the ore out of a seam.
            // That distinction is the difference between a world people can live in and one they
            // strip: fifty thousand people eat about fourteen hundred units a second, and the wild
            // food standing in the world is six and a half million units, so without this the
            // whole species starves in an hour -- which is exactly what the first measurement did.
            //
            // AND ROCK, which is not a thing you use up. This was the largest single defect in the
            // old simulation and it hid behind a healthy-looking number for the whole campaign:
            // the world holds about sixteen thousand seven hundred boulder patches at two hundred
            // apiece, so three and a third million units of stone, and nearly every building in
            // the catalogue is made of some. Twenty generations strip all of it. The report never
            // showed it because it counts quarriers EMPLOYED, not stone DELIVERED -- and the
            // largest town in the world, three thousand eight hundred people in the third age,
            // ended an arc holding one hundred and seventy-seven thousand timber, ZERO stone, and
            // five hundred and thirty people standing at a quarry with nothing left in it.
            // Forty-one of the forty-seven kinds it could have raised were refused for want of
            // stone; the only three it could build -- pasture, sheepfold, orchard -- are the three
            // that cost none, which is why that world was made of pastures and henhouses, and why
            // flour, wool and every metal read as "a good nobody wants" when they were a good
            // nobody could BUILD THE SHOP FOR.
            //
            // A quarry node is not a pit, it is a patch of rocky ground, and a patch of rocky
            // ground does not stop having rock in it after two hours. ORE IS NOT INCLUDED: a seam
            // is genuinely finite, the metal chain's scarcity is the point, and a mine is the one
            // place where "it does not come back on any timescale a person lives through" is the
            // truth.
            public method renews() returns boolean {
                return this == Harvest.Forage || this == Harvest.Fishing
                    || this == Harvest.Quarry;
            }

            // The trade whose own hands bring this harvest home -- the inverse read off Gathers'
            // one array, so the two directions cannot drift.
            public method gatherer() returns Craft {
                return cast<Craft>(Gathers.whoTakes(cast<int>(this)));
            }
        }
    }
}
