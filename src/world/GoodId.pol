program AgentsExe;

// WHICH GOOD, as the dense global index the storehouses and the recipes are keyed by.
//
// NOT THE SAME THING AS `EconomyGoods`, and both are wanted. The catalog value is what a node
// ANSWERS with -- `PropNode.Boulder.gives()` is `ExtractedGood.Stone`, a thing with a tier and a
// name. This is the number that value lives at once it is in an array: one plane per good in the
// node field, one shelf per good in a storehouse, one line per good in a recipe.
//
// IT EXISTS BECAUSE THE NODE KINDS ARE NUMBERED THE SAME WAY. `Nodes.count()` and `Goods.count()`
// are both dense spaces starting at a "Nothing" at zero, and the two run through the same methods:
// `Nodes.gives(nodeOrd)` takes one and answers the other. Handing a storehouse a node kind does not
// fail -- it credits a shelf, and the shelf it credits is a real good.
public bundle Agents {
    public namespace World {

        public newtype GoodId = int;
    }
}
