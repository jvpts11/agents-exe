import System.IO.Console;
program AgentsExe;

// The sixteen trades that staff buildings. A craft answers its own gathering questions --
// one-line lookups into the Gathers table, whose single array keeps both directions of the
// craft<->harvest fact from ever drifting apart.
public bundle Agents {
    public namespace World {

        public enum Craft {
            NoCraft,
            Wright,          // Sawmill, CharcoalKiln, Kiln, Pottery, PaperMill -- wood and earth
            Smith,           // Smithy, Forge, Bronzeworks, SteelMill -- metal at an anvil
            Victualler,      // Windmill, Bakery, Brewery, Smokehouse, Dairy -- food
            Weaving,         // Weaver, Tannery, TextileMill -- fibre and skin
            Tilling,         // Farm, Pasture, Orchard, Apiary -- land
            Lettering,       // Scriptorium, Library, School, University -- knowledge
            Masonry,         // Mason, Brickworks, Quarry -- stone, dressed and fired
            Digging,         // Mine, CoalMine, SaltMine, OilSource, rigs -- underground
            Chemistry,       // Gasworks, OilRefinery, ChemicalPlant, PlasticsPlant, DrugFactory
            Machining,       // MachineShop, Factory, Arsenal, AmmoFactory, CarFactory, Robotics
            Powering,        // CoalPowerPlant, SolarFarm, NuclearPlant, ChipFactory -- the mains
            Healing,         // Apothecary, Bathhouse, Hospital -- the trade against dying of it
            // The three the design doc found missing, which closes the list at sixteen. Each one
            // already had a building in the catalogue and nobody to work it.
            Sailor,          // Harbor -- and the far side of the water
            Priest,          // StoneCircle, Shrine, and the rungs above them
            Builder;         // every site in the city, and no building of its own

            // The Harvest this trade fetches with its own hands, or Nothing.
            public method gathers() returns Harvest {
                return cast<Harvest>(Gathers.takes(cast<int>(this)));
            }

            public method isGatherer() returns boolean {
                return Gathers.isGatherer(cast<int>(this));
            }
        }
    }
}
