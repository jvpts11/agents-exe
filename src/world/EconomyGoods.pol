import System.IO.Console;
import Agents.World.GoodId;
import Agents.World.GoodKind;
import Agents.World.GoodTier;
program AgentsExe;

// The goods contract (relayout design section 4a): a methods-only catalog, implemented by the
// four family enums. It declares no required values, so there is no byCatalog anywhere -- the
// duplicated member lists the old single-implementer catalog carried died by construction.
// "Any good" is a value of this type; storage never holds one (storage holds the dense global
// index, which is index()).
public bundle Agents {
    public namespace World {

        public catalog EconomyGoods {
            method kind() returns GoodKind;
            method tier() returns GoodTier;
            method edible() returns boolean;
            // WHERE THIS GOOD LIVES IN AN ARRAY. A `GoodId` and not an int, because the node kinds
            // are numbered the same way -- a dense space with a "Nothing" at zero -- and the two run
            // through the same methods. See `GoodId`.
            method index() returns GoodId;
        }
    }
}
