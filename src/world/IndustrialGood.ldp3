import System.IO.Console;
import Agents.World.EconomyGoods;
import Agents.World.GoodKind;
import Agents.World.GoodTier;
program AgentsExe;

// What the third and fourth ages run on -- the goods that close the last veins the ground
// offers: sulfur into ammunition, oil into fuel, rare earth into chips. index() is 65 + the
// local ordinal, ending the goods at 74.
public bundle Agents {
    public namespace World {

        public enum IndustrialGood extends EconomyGoods {
            Fuel(GoodTier.Material),
            Electricity(GoodTier.Material),
            Chemicals(GoodTier.Material),
            Plastic(GoodTier.Material),
            MachineParts(GoodTier.Material),
            Chip(GoodTier.Material),
            Computer(GoodTier.Material),
            Medicine(GoodTier.Material),
            Ammo(GoodTier.Material),
            Vehicle(GoodTier.Material);

            private GoodTier grade;

            public constructor IndustrialGood(GoodTier grade) {
                this.grade = grade;
            }

            public method kind() returns GoodKind {
                return GoodKind.Industrial;
            }

            public method tier() returns GoodTier {
                return this.grade;
            }

            public method edible() returns boolean {
                return this.grade == GoodTier.Food;
            }

            public method index() returns int {
                return 65 + cast<int>(this);
            }
        }
    }
}
