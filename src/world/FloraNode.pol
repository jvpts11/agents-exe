import System.IO.Console;
import Agents.World.EconomyNodes;
import Agents.World.EconomyGoods;
import Agents.World.NodeClass;
import Agents.World.NodeId;
import Agents.World.NodeAtlas;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// The surface biology -- ECONOMY.md section 1's living nodes, never buried whatever they yield.
// index() is 9 + the local ordinal (the family begins where PropNode ends).
public bundle Agents {
    public namespace World {

        public enum FloraNode extends EconomyNodes {
            OakTree(130, ExtractedGood.Wood, Harvest.Timber),
            PineTree(120, ExtractedGood.Wood, Harvest.Timber),
            BirchTree(105, ExtractedGood.Wood, Harvest.Timber),
            BerryBush(40, ExtractedGood.Berries, Harvest.Forage),
            MushroomPatch(30, ExtractedGood.Mushrooms, Harvest.Forage),
            HerbPlant(25, ExtractedGood.Herbs, Harvest.Forage),
            WheatField(60, ExtractedGood.Grain, Harvest.Forage),
            WildVine(45, ExtractedGood.Grapes, Harvest.Forage),
            CottonPlant(50, ExtractedGood.Cotton, Harvest.Forage),
            FlaxPlant(50, ExtractedGood.Flax, Harvest.Forage),
            Reeds(60, ExtractedGood.Reeds, Harvest.Forage),
            FishingSpot(900, ExtractedGood.Fish, Harvest.Fishing),
            Cactus(35, ExtractedGood.Vegetables, Harvest.Forage);

            private int qty;
            private EconomyGoods yieldOf;
            private Harvest labour;

            public constructor FloraNode(int qty, EconomyGoods yieldOf, Harvest labour) {
                this.qty = qty;
                this.yieldOf = yieldOf;
                this.labour = labour;
            }

            public method kind() returns NodeClass {
                return NodeClass.Biological;
            }

            public method atlas() returns NodeAtlas {
                return NodeAtlas.Nodes;
            }

            public method buryable() returns boolean {
                return false;
            }

            public method baseQty() returns int {
                return qty;
            }

            public method gives() returns EconomyGoods {
                return yieldOf;
            }

            public method work() returns Harvest {
                return labour;
            }

            public method index() returns NodeId {
                demand 9 == 1 + PropNode.count()
                    otherwise "the flora begins where the props end";
                return cast<NodeId>(9 + cast<int>(this));
            }
        }
    }
}
