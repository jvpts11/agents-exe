import System.IO.Console;
program AgentsExe;

// WHICH LANDMASS EACH SIXTEEN-CELL BLOCK BELONGS TO, and which of those masses were seeded with
// nobody on them.
//
// The world knew elevation and biome and nothing about continents, so there was no way to ask the
// one question that matters once half of them are deliberately left empty: did anybody ever get
// there. A continent is a connected component of walkable ground -- ten thousand blocks to flood
// rather than two and a half million cells -- and once it is labelled the answer is a lookup
// instead of a survey.
//
// It reads the ground through the grid that owns it, which is the only thing it needs from
// outside: a mass is a fact ABOUT the biome map, so it borrows the map and owns the labelling.
public bundle Agents {
    public namespace World {

        public class Landmasses implements Massed {
            private mutable Grid* world;      // borrowed: the grid owns this, never the other way
            private mutable BlockGrid* blocks;
            private mutable int[] massId;     // per 16-cell block; -1 where there is no land
            private mutable boolean[] massEmpty;  // this mass began with nobody on it
            private mutable int masses;

            public constructor Landmasses(Grid* world, BlockGrid* blocks) {
                this.world = world;
                this.blocks = blocks;
                this.massId = new int[blocks.count()]();
                this.massEmpty = new boolean[blocks.count()]();
                this.masses = 0;
            }

            public destructor ~Landmasses() returns void {
                delete this.massId;
                delete this.massEmpty;
            }

            // Flood the blocks that hold walkable ground. Called once, after the terrain is final
            // and before anybody is placed on it.
            public override method labelMasses() returns void {
                int nb = this.blocks.count();
                for (int b in 0..nb) {
                    this.massId[b] = 0 - 1;
                    this.massEmpty[b] = true;
                }
                mutable int[] queue = new int[nb]();
                mutable int found = 0;
                for (int b0 in 0..nb) {
                    if (this.massId[b0] >= 0) {
                        continue;
                    }
                    if (!this.blockIsLand(b0)) {
                        continue;
                    }
                    mutable int qh = 0;
                    mutable int qt = 0;
                    queue[qt] = b0;
                    qt = qt + 1;
                    this.massId[b0] = found;
                    while (qh < qt) {
                        int at = queue[qh];
                        qh = qh + 1;
                        int ax = this.blocks.colOf(at);
                        int ay = this.blocks.rowOf(at);
                        mutable int d = 0;
                        while (d < 4) {
                            mutable int nx = ax;
                            mutable int ny = ay;
                            if (d == 0) {
                                nx = ax - 1;
                            } else if (d == 1) {
                                nx = ax + 1;
                            } else if (d == 2) {
                                ny = ay - 1;
                            } else {
                                ny = ay + 1;
                            }
                            d = d + 1;
                            if (!this.blocks.holds(nx, ny)) {
                                continue;
                            }
                            int nb2 = this.blocks.at(nx, ny);
                            if (this.massId[nb2] >= 0 || !this.blockIsLand(nb2)) {
                                continue;
                            }
                            this.massId[nb2] = found;
                            queue[qt] = nb2;
                            qt = qt + 1;
                        }
                    }
                    found = found + 1;
                }
                delete queue;
                this.masses = found;
                return;
            }

            // A block counts as land if any of its four corners is walkable -- a coastline block is
            // mostly water and still part of the continent behind it.
            private method blockIsLand(int b) returns boolean {
                int bx = this.blocks.originX(b);
                int by = this.blocks.originY(b);
                mutable int k = 0;
                while (k < 4) {
                    int px = bx + (k % 2) * 15;
                    int py = by + (k / 2) * 15;
                    k = k + 1;
                    if (px >= this.world.width() || py >= this.world.height()) {
                        continue;
                    }
                    if (Biomes.walkable(this.world.biomeAt(px, py))) {
                        return true;
                    }
                }
                return false;
            }

            public override method massAt(int x, int y) returns int {
                if (x < 0 || y < 0 || x >= this.world.width() || y >= this.world.height()) {
                    return 0 - 1;
                }
                return this.massId[this.blocks.ofCell(x, y)];
            }

            public override method massCount() returns int {
                return this.masses;
            }

            // Say that this mass was seeded with people on it. Anything still marked empty
            // afterwards is ground nobody started on, and reaching it later is colonisation.
            public override method markMassPeopled(int x, int y) returns void {
                int m = this.massAt(x, y);
                if (m < 0) {
                    return;
                }
                for (int b in 0..this.blocks.count()) {
                    if (this.massId[b] == m) {
                        this.massEmpty[b] = false;
                    }
                }
                return;
            }

            public override method massBeganEmpty(int x, int y) returns boolean {
                int m = this.massAt(x, y);
                if (m < 0) {
                    return false;
                }
                return this.massEmpty[this.blocks.ofCell(x, y)];
            }
        }
    }
}
