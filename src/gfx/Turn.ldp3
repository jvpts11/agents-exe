import System.IO.Console;
program AgentsExe;

// Which way a body faces, as the cosine and sine of its heading.
//
// It arrives already resolved rather than as an angle because every caller HAS a direction -- a
// person walks toward a tree, a cart is pointed along its road, a house faces its street -- and
// turning that into an angle so this can turn it back is two transcendental calls per instance per
// frame, at fifty thousand instances a frame.
//
// ---- WHY THIS IS A TYPE AND NOT TWO FLOATS ----
//
// `float ca, float sa` at the end of an eleven-parameter list is a pair that can be handed over
// backwards, and backwards is not a crash: the world comes out MIRRORED, every body facing the
// reflection of where it is going. That is the same class of bug as the one this renderer already
// shipped -- every mesh drawn at one fixed rotation for the whole project, which no test caught
// because a test reads numbers and this is a thing you have to look at. Two anonymous floats side
// by side is how you get the second one.
//
// The rotation itself is written here once, in two methods whose whole difference is a sign and an
// order: `lx*ca - ly*sa` against `lx*sa + ly*ca`. Transcribed by hand at four sites, the odds that
// all four have both right forever are not good, and half-right is a world that looks fine until
// somebody notices the shadows lean the wrong way.
public bundle Agents {
    public namespace Gfx {

        public struct Turn {
            public mutable float ca;
            public mutable float sa;

            public constructor Turn(float ca, float sa) {
                this.ca = ca;
                this.sa = sa;
            }

            // Facing the way the mesh was authored.
            public static method none() returns Turn {
                return new Turn(1.0, 0.0);
            }

            // Where a point of the model's own frame lands once the body is turned.
            public method x(float lx, float ly) returns float {
                return lx * ca - ly * sa;
            }

            public method y(float lx, float ly) returns float {
                return lx * sa + ly * ca;
            }
        }
    }
}
