import System.IO.Console;
import OpenGL.Text.FontAtlas;
import OpenGL.Text.GdiFont;
import OpenGL.Textures.Texture;
import Agents.Sim.Meter;
import Agents.Sim.Phase;
import Agents.Gfx.GroundHit;

// Text on the screen, and the first thing written with it: the two rates.
//
// Everything the game knew about its own speed was in the window title, which is fine for a number
// you glance at and useless for one you are trying to OPTIMISE against -- a title bar does not sit
// next to the thing that is slow, does not show a breakdown, and cannot be read from a screenshot.
// So the HUD gets a font, and the font gets used for the counter first because that is what is
// needed to judge the next slice.
//
// The atlas is monospaced ASCII rasterised once at startup, uploaded once, and drawn as one quad a
// character out of the batch that already exists. Nothing here is per-frame work beyond the quads.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class Hud {
            private mutable FontAtlas font;
            private mutable int tex;
            private mutable boolean ready;
            private mutable int cw;
            private mutable int ch;

            public constructor Hud(int px) {
                font = GdiFont.rasterizeAscii("Consolas", px);
                tex = Texture.upload2DRGBA(font.pixels, font.atlasW, font.atlasH);
                cw = font.cellW;
                ch = font.cellH;
                ready = tex != 0;
                if (!ready) {
                    System.IO.Console.println("hud: no font texture; text is off");
                }
            }

            public method cellW() returns int {
                return cw;
            }

            public method cellH() returns int {
                return ch;
            }

            public method texture() returns int {
                return tex;
            }

            // Draw a string. The caller owns the batch, so text and panels go in one flush.
            public method text(Batch2D* b, String s, int x, int y,
                               float r, float g, float bl, float a) returns int {
                if (!ready) {
                    return x;
                }
                b.setTexture(tex);
                mutable int px = x;
                for (int i in 0..s.length()) {
                    char c = s.charAt(i);
                    float[] uv = font.uv(c);
                    b.glyph(px, y, cw, ch, uv[0], uv[1], uv[2], uv[3], r, g, bl, a);
                    delete uv;
                    px = px + cw;
                }
                return px;
            }

            // The counter, bottom left, on a panel dark enough to read over snow and over ocean.
            // The rate and the heaviest phase behind it, because "it is slow" and "the terrain bake
            // is slow" are answers of very different use.
            //
            // ONE METER, and it used to take two. The second was the simulation's clock, and with
            // the simulation deleted it read a constant zero next to a phase name copied from the
            // first -- two lines of screen saying nothing, and one of them saying something false.
            // A number on screen that cannot be wrong is worth more than a slot kept warm for a
            // number that does not exist yet; when the new model has a clock, it gets its line back.
            // WHERE THE POINTER IS, in the world's own coordinates -- and what is under it.
            //
            // It sits by the cursor rather than in a corner because that is where the eye already
            // is: a readout on the other side of the screen makes you look away from the thing you
            // are pointing at, which is the one moment you did not want to.
            //
            // Off the world (above the horizon, or past the edge) it says so instead of printing
            // the last cell it knew. A number that keeps standing when the thing it measures is
            // gone is worse than no number.
            public method atCursor(Batch2D* b, GroundHit where, String ground, int mx, int my,
                                   int screenW, int screenH) returns void {
                if (!ready) {
                    return;
                }
                mutable String said = "off the world";
                if (where.onWorld) {
                    said = $"{where.x}, {where.y}  {ground}";
                }
                int w = cw * (said.length() + 2) + 8;
                int h = ch + 8;
                // Kept on screen: near the bottom or the right edge the box would hang off, so it
                // flips to the other side of the cursor rather than being clipped.
                mutable int x = mx + 18;
                mutable int y = my + 18;
                if (x + w > screenW) {
                    x = mx - 18 - w;
                }
                if (y + h > screenH) {
                    y = my - 18 - h;
                }
                if (x < 0) {
                    x = 0;
                }
                if (y < 0) {
                    y = 0;
                }
                b.rect(x, y, w, h, 0.04, 0.05, 0.07, 0.72);
                text(b, said, x + 4 + cw, y + 4, 0.90, 0.92, 0.96, 1.0);
                return;
            }

            public method rates(Batch2D* b, Meter* frame, int screenH) returns void {
                if (!ready) {
                    return;
                }
                int lines = 2;
                int w = cw * 34 + 12;
                int h = ch * lines + 10;
                int x = 8;
                int y = screenH - h - 8;
                b.rect(x, y, w, h, 0.04, 0.05, 0.07, 0.66);
                mutable int ty = y + 5;
                text(b, $"{frame.fps()} fps", x + 6, ty, 0.95, 0.95, 0.98, 1.0);
                ty = ty + ch;
                text(b, $"frame {frame.worstName()} {frame.worstShare()}/1000", x + 6, ty,
                          0.72, 0.80, 0.92, 1.0);
                return;
            }
        }
    }
}
