import Agents.World.Grid;

// Renders a window of the generated Grid in true 3D by instancing each cell's biome tile mesh from
// the atlas, raised to its elevation (mountains stand tall). Water biomes are flattened to a single
// sea-surface height so oceans read flat, not stepped. This is the headless verification of the real
// worldgen; the GL path will reuse the same cell->mesh mapping with culling + LOD for big worlds.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class World3D {
            // Ordinals 0..6 are water (MarineTrench..Lake); River(7) and up are land.
            public static method render(Raster3D* r, Grid* g, MeshAtlas* atlas,
                                        int x0, int y0, int wc, int hc, float vscale) returns void {
                float waterZ = 0.30 * vscale;
                r.fitAndAim(42.0, 32.0, wc, hc, vscale);
                mutable int gy = 0;
                while (gy < hc) {
                    mutable int gx = 0;
                    while (gx < wc) {
                        int cx = x0 + gx;
                        int cy = y0 + gy;
                        int ord = g.biomeAt(cx, cy);
                        float e = cast<float>(g.elevAt(cx, cy)) / 10000.0;
                        mutable float wz = e * vscale;
                        if (ord <= 6) {
                            wz = waterZ;
                        }
                        if (wz < waterZ) {
                            wz = waterZ;
                        }
                        float wx = cast<float>(gx) * 2.0;
                        float wy = cast<float>(gy) * 2.0;
                        int gbase = (gy * wc + gx + 1) * 64;
                        r.drawAtlas(atlas, ord, wx, wy, wz, gbase);
                        gx = gx + 1;
                    }
                    gy = gy + 1;
                }
            }
        }
    }
}
