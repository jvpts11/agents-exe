import System.IO.Console;
program AgentsExe;

// What a viewer can be told to do with the world: the six messages `main` sends on a mouse drag,
// a scroll wheel and the WASD keys.
//
// Named as an interface because the renderer does not answer these itself -- it holds an
// OrbitCamera and forwards, and this is the contract that says which questions travel.
public bundle Agents {
    public namespace Gfx {

        public interface Orbitable {
            // Swing around the target, and up or down. Elevation is clamped: past vertical the
            // view turns inside out, and at zero it is underground.
            method orbit(float dAz, float dEl) returns void;

            // Move in or out, clamped to the world's own scale.
            method zoomBy(float factor) returns void;

            // Slide the look-at target on the ground, relative to the view: forward is away from
            // the viewer on screen, right is screen right.
            method pan(float dForward, float dRight) returns void;

            // Put the target on a cell.
            method aimAt(int cellX, int cellY) returns void;

            // Set the whole view at once, for a scripted shot.
            method setView(float az, float el, float dist) returns void;

            // How far out the viewer is, which is what a caller scales its pan step by.
            method curDist() returns float;
        }
    }
}
