import Agents.Gfx.Painter;
import Agents.App.Ppm;

// The CPU painter: fills rectangles into an owned RGB buffer and can dump it as a PPM. This is both
// the headless fallback and how the visuals are checked -- the exact picture the windowed game draws.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class SoftPainter implements Painter {
            private mutable byte[] buf;
            private mutable int cW;
            private mutable int cH;

            public constructor SoftPainter(int cW, int cH) {
                this.cW = cW;
                this.cH = cH;
                buf = new byte[cW * cH * 3]();
            }

            public destructor ~SoftPainter() returns void {
                delete buf;
            }

            public override method fillRect(int x, int y, int w, int h, int r, int g, int b) returns void {
                mutable int py = y;
                int ye = y + h;
                int xe = x + w;
                while (py < ye) {
                    if (py >= 0 && py < cH) {
                        mutable int px = x;
                        while (px < xe) {
                            if (px >= 0 && px < cW) {
                                int i = (py * cW + px) * 3;
                                buf[i] = cast<byte>(r);
                                buf[i + 1] = cast<byte>(g);
                                buf[i + 2] = cast<byte>(b);
                            }
                            px = px + 1;
                        }
                    }
                    py = py + 1;
                }
            }

            // Scanline-fill an iso diamond by drawing one horizontal span per row.
            private method paintDiamond(int cx, int cy, int hw, int hh, int r, int g, int b) returns void {
                mutable int hy = hh;
                if (hy <= 0) {
                    hy = 1;
                }
                mutable int dy = 0 - hy;
                while (dy <= hy) {
                    mutable int ad = dy;
                    if (ad < 0) {
                        ad = 0 - ad;
                    }
                    // Round the row half-width UP: truncating leaves adjacent diamonds a pixel short of
                    // their shared edge, so the dark background bleeds through as a scaly seam. Ceiling
                    // makes neighbours overlap by at most a pixel instead -- a seamless iso surface.
                    int rowHw = (hw * (hy - ad) + hy - 1) / hy;
                    if (rowHw > 0) {
                        // Span is [cx-rowHw, cx+rowHw] inclusive -> width 2*rowHw+1, symmetric about cx.
                        // A 2*rowHw width would drop the rightmost column and leave a 1px seam on one
                        // diagonal; the odd, centred width lets neighbours meet edge-to-edge.
                        fillRect(cx - rowHw, cy + dy, rowHw * 2 + 1, 1, r, g, b);
                    }
                    dy = dy + 1;
                }
            }

            // A filled iso diamond with a subtle darker border, so each tile is delimited from its
            // neighbours -- a flat fill makes same-colour tiles blur into one shape. The border is a
            // 3/4-brightness shade of the tile drawn full-size, then the tile is filled one pixel in.
            // Below a few pixels the border would swallow the tile, so tiny tiles are drawn flat.
            public override method fillDiamond(int cx, int cy, int hw, int hh, int r, int g, int b) returns void {
                if (hw >= 4 && hh >= 2) {
                    paintDiamond(cx, cy, hw, hh, r * 3 / 4, g * 3 / 4, b * 3 / 4);
                    paintDiamond(cx, cy, hw - 2, hh - 1, r, g, b);
                } else {
                    paintDiamond(cx, cy, hw, hh, r, g, b);
                }
            }

            // X where edge (ax,ay)-(bx,by) crosses scanline y, or a large-negative sentinel if it does
            // not cross. Half-open in y ([lo,hi)) so a shared vertex is counted by only one edge.
            private method edgeX(int ax, int ay, int bx, int by, int y) returns int {
                if (ay == by) {
                    return 0 - 2000000000;
                }
                mutable int lo = ay;
                mutable int hi = by;
                if (lo > hi) {
                    lo = by;
                    hi = ay;
                }
                if (y < lo || y >= hi) {
                    return 0 - 2000000000;
                }
                return ax + (bx - ax) * (y - ay) / (by - ay);
            }

            // Scanline-fill a convex quad. Adjacent tiles pass identical shared corners, so the integer
            // edge intersections match exactly on shared edges -- seamless tessellation, no vertical gaps.
            public override method fillQuad(int x0, int y0, int x1, int y1, int x2, int y2, int x3, int y3,
                                            int r, int g, int b) returns void {
                mutable int minY = y0;
                minY = y1 < minY ? y1 : minY;
                minY = y2 < minY ? y2 : minY;
                minY = y3 < minY ? y3 : minY;
                mutable int maxY = y0;
                maxY = y1 > maxY ? y1 : maxY;
                maxY = y2 > maxY ? y2 : maxY;
                maxY = y3 > maxY ? y3 : maxY;
                minY = minY < 0 ? 0 : minY;
                maxY = maxY >= cH ? cH - 1 : maxY;
                int sentinel = 0 - 1000000000;
                mutable int y = minY;
                while (y <= maxY) {
                    int e0 = edgeX(x0, y0, x1, y1, y);
                    int e1 = edgeX(x1, y1, x2, y2, y);
                    int e2 = edgeX(x2, y2, x3, y3, y);
                    int e3 = edgeX(x3, y3, x0, y0, y);
                    mutable int lo = 2000000000;
                    mutable int hi = 0 - 2000000000;
                    lo = (e0 > sentinel && e0 < lo) ? e0 : lo;
                    hi = (e0 > sentinel && e0 > hi) ? e0 : hi;
                    lo = (e1 > sentinel && e1 < lo) ? e1 : lo;
                    hi = (e1 > sentinel && e1 > hi) ? e1 : hi;
                    lo = (e2 > sentinel && e2 < lo) ? e2 : lo;
                    hi = (e2 > sentinel && e2 > hi) ? e2 : hi;
                    lo = (e3 > sentinel && e3 < lo) ? e3 : lo;
                    hi = (e3 > sentinel && e3 > hi) ? e3 : hi;
                    if (hi >= lo) {
                        fillRect(lo, y, hi - lo + 1, 1, r, g, b);
                    }
                    y = y + 1;
                }
            }

            // Top-down PPM text (row 0 = top), so the buffer maps straight through.
            public method save(String path) returns void {
                mutable Ppm* file = new Ppm(cW, cH) on heap;
                mutable int y = 0;
                while (y < cH) {
                    mutable int x = 0;
                    while (x < cW) {
                        int i = (y * cW + x) * 3;
                        file.pixel(cast<int>(buf[i]) & 255, cast<int>(buf[i + 1]) & 255,
                                   cast<int>(buf[i + 2]) & 255);
                        x = x + 1;
                    }
                    y = y + 1;
                }
                file.save(path);
                delete file;
            }
        }
    }
}
