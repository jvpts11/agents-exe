import System.IO.File;
import System.Text.StringBuilder;
import Agents.Gfx.Painter;

// The CPU painter: fills rectangles into an owned RGB buffer and can dump it as a PPM. This is both
// the headless fallback and how the visuals are checked -- the exact picture the windowed game draws.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class SoftPainter implements Painter {
            private mutable byte[] buf;
            private mutable int cW;
            private mutable int cH;

            public constructor SoftPainter(int cW, int cH) {
                this.cW = cW;
                this.cH = cH;
                this.buf = new byte[cW * cH * 3]();
            }

            public destructor ~SoftPainter() returns void {
                delete this.buf;
            }

            public override method fillRect(int x, int y, int w, int h, int r, int g, int b) returns void {
                mutable int py = y;
                int ye = y + h;
                int xe = x + w;
                while (py < ye) {
                    if (py >= 0 && py < this.cH) {
                        mutable int px = x;
                        while (px < xe) {
                            if (px >= 0 && px < this.cW) {
                                int i = (py * this.cW + px) * 3;
                                this.buf[i] = cast<byte>(r);
                                this.buf[i + 1] = cast<byte>(g);
                                this.buf[i + 2] = cast<byte>(b);
                            }
                            px = px + 1;
                        }
                    }
                    py = py + 1;
                }
            }

            // Scanline-fill an iso diamond by drawing one horizontal span per row.
            private method paintDiamond(int cx, int cy, int hw, int hh, int r, int g, int b) returns void {
                mutable int hy = hh;
                if (hy <= 0) {
                    hy = 1;
                }
                mutable int dy = 0 - hy;
                while (dy <= hy) {
                    mutable int ad = dy;
                    if (ad < 0) {
                        ad = 0 - ad;
                    }
                    // Round the row half-width UP: truncating leaves adjacent diamonds a pixel short of
                    // their shared edge, so the dark background bleeds through as a scaly seam. Ceiling
                    // makes neighbours overlap by at most a pixel instead -- a seamless iso surface.
                    int rowHw = (hw * (hy - ad) + hy - 1) / hy;
                    if (rowHw > 0) {
                        // Span is [cx-rowHw, cx+rowHw] inclusive -> width 2*rowHw+1, symmetric about cx.
                        // A 2*rowHw width would drop the rightmost column and leave a 1px seam on one
                        // diagonal; the odd, centred width lets neighbours meet edge-to-edge.
                        this.fillRect(cx - rowHw, cy + dy, rowHw * 2 + 1, 1, r, g, b);
                    }
                    dy = dy + 1;
                }
            }

            // A filled iso diamond with a subtle darker border, so each tile is delimited from its
            // neighbours -- a flat fill makes same-colour tiles blur into one shape. The border is a
            // 3/4-brightness shade of the tile drawn full-size, then the tile is filled one pixel in.
            // Below a few pixels the border would swallow the tile, so tiny tiles are drawn flat.
            public override method fillDiamond(int cx, int cy, int hw, int hh, int r, int g, int b) returns void {
                if (hw >= 4 && hh >= 2) {
                    this.paintDiamond(cx, cy, hw, hh, r * 3 / 4, g * 3 / 4, b * 3 / 4);
                    this.paintDiamond(cx, cy, hw - 2, hh - 1, r, g, b);
                } else {
                    this.paintDiamond(cx, cy, hw, hh, r, g, b);
                }
            }

            // Top-down PPM text (row 0 = top), so the buffer maps straight through.
            public method save(String path) returns void {
                mutable StringBuilder sb = new StringBuilder() on heap;
                sb.append("P3\n");
                sb.appendInt(this.cW);
                sb.append(" ");
                sb.appendInt(this.cH);
                sb.append("\n255\n");
                mutable int y = 0;
                while (y < this.cH) {
                    mutable int x = 0;
                    while (x < this.cW) {
                        int i = (y * this.cW + x) * 3;
                        sb.appendInt(cast<int>(this.buf[i]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(this.buf[i + 1]) & 255);
                        sb.append(" ");
                        sb.appendInt(cast<int>(this.buf[i + 2]) & 255);
                        sb.append(" ");
                        x = x + 1;
                    }
                    sb.append("\n");
                    y = y + 1;
                }
                File.writeAll(path, sb.toString());
                delete sb;
            }
        }
    }
}
