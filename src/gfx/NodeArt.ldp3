import System.IO.Console;
import Agents.World.Nodes;
import Agents.World.NodeAtlas;
program AgentsExe;

// How every resource node kind is drawn, by kind.
//
// Resolved once at load: a kind NAMES its own mesh file, so the lookup is the kind's own name in
// whichever atlas the economy table points at. That is the same discipline the world tables run on
// -- an identifier that is the filename cannot drift from it -- and it is why there is no list here
// to fall out of step with the list of kinds.
public bundle Agents {
    public namespace Gfx {

        public class NodeArt {
            private mutable NodeLook[] rows;

            // HOW BIG A TREE IS DRAWN, and the number is here rather than inline because what it
            // has to be right about is a RATIO to something else on the screen.
            //
            // IT WAS 1.1 -- the scale the prop scatter happened to use before trees became resource
            // nodes -- and a person is drawn at half a unit, so a tree stood barely twice a person
            // and read as a shrub somebody was standing next to. A tile is two units across; at 2.75
            // a tree is about a tile and a third tall and five and a half people, which is a tree in
            // a world drawn at this scale rather than a botanical measurement (an oak is really
            // twelve people, and twelve people tall would hide the ground the game is played on).
            //
            // The mineral art is authored at tile scale already and keeps 1.0.
            public static fixed float A_TREE = 2.75;

            public constructor NodeArt() {
                rows = new NodeLook[1]();
            }

            public destructor ~NodeArt() returns void {
                delete rows;
            }

            public method load(MeshAtlas* props, MeshAtlas* nodes) returns void {
                int n = Nodes.count();
                delete rows;
                rows = new NodeLook[n]();
                mutable int k = 0;
                while (k < n) {
                    boolean inProps = Nodes.atlas(k) == cast<int>(NodeAtlas.Props);
                    rows[k].inProps = inProps;
                    if (k == 0) {
                        rows[k].model = 0 - 1;             // None is never drawn
                    } else if (inProps) {
                        rows[k].model = props.ordOf(Nodes.name(k));
                    } else {
                        rows[k].model = nodes.ordOf(Nodes.name(k));
                    }
                    if (Nodes.isTree(k)) {
                        rows[k].scale = NodeArt.A_TREE;
                    } else {
                        rows[k].scale = 1.0;
                    }
                    k = k + 1;
                }
                return;
            }

            public operator [] (int kind) returns NodeLook {
                return rows[kind];
            }
        }
    }
}
