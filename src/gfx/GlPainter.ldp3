import Agents.Gfx.Painter;

// The GPU painter: forwards each filled rectangle to the Batch2D quad batcher, converting 0-255 RGB
// to the shader's 0-1 floats. The windowed game draws through this; the same Scene.paint feeds it.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class GlPainter implements Painter {
            private mutable Batch2D* batch;

            public constructor GlPainter(Batch2D* batch) {
                this.batch = batch;
            }

            public override method fillRect(int x, int y, int w, int h, int r, int g, int b) returns void {
                this.batch.rect(x, y, w, h, cast<float>(r) / 255.0, cast<float>(g) / 255.0,
                                cast<float>(b) / 255.0, 1.0);
            }

            // One iso diamond = one Batch2D quad (top, right, bottom, left corners). Each tile gets a
            // subtle darker border so neighbours are delimited: draw the full diamond in a 3/4-brightness
            // shade, then the tile itself one pixel in. Tiny tiles skip the border (it would swallow them).
            public override method fillDiamond(int cx, int cy, int hw, int hh, int r, int g, int b) returns void {
                if (hw >= 4 && hh >= 2) {
                    this.batch.quad(cx, cy - hh, cx + hw, cy, cx, cy + hh, cx - hw, cy,
                                    cast<float>(r * 3 / 4) / 255.0, cast<float>(g * 3 / 4) / 255.0,
                                    cast<float>(b * 3 / 4) / 255.0, 1.0);
                    int iw = hw - 2;
                    int ih = hh - 1;
                    this.batch.quad(cx, cy - ih, cx + iw, cy, cx, cy + ih, cx - iw, cy,
                                    cast<float>(r) / 255.0, cast<float>(g) / 255.0, cast<float>(b) / 255.0, 1.0);
                } else {
                    this.batch.quad(cx, cy - hh, cx + hw, cy, cx, cy + hh, cx - hw, cy,
                                    cast<float>(r) / 255.0, cast<float>(g) / 255.0, cast<float>(b) / 255.0, 1.0);
                }
            }
        }
    }
}
