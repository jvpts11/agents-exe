import System.IO.Console;

// The isometric camera: holds a focus point in iso-world coordinates and a zoom, and converts between
// grid cells, iso-world, and screen pixels. Tiles are 2:1 diamonds, 64x32 at zoom 1 (half 32x16).
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class Camera {
            public static fixed int HW = 32;   // tile half-width  at zoom 1
            public static fixed int HH = 16;   // tile half-height at zoom 1

            private mutable float camX;   // iso-world point kept at screen centre
            private mutable float camY;
            private mutable float zoom;
            private mutable int sw;
            private mutable int sh;

            public constructor Camera(int sw, int sh) {
                this.sw = sw;
                this.sh = sh;
                this.camX = 0.0;
                this.camY = 0.0;
                this.zoom = 1.0;
            }

            public method resize(int sw, int sh) returns void {
                this.sw = sw;
                this.sh = sh;
            }

            public method zoomValue() returns float {
                return this.zoom;
            }

            public method setZoom(float z) returns void {
                mutable float zz = z;
                if (zz < 0.02) { zz = 0.02; }
                if (zz > 12.0) { zz = 12.0; }
                this.zoom = zz;
            }

            public method zoomBy(float factor) returns void {
                this.setZoom(this.zoom * factor);
            }

            public method panPixels(int dx, int dy) returns void {
                this.camX = this.camX - cast<float>(dx) / this.zoom;
                this.camY = this.camY - cast<float>(dy) / this.zoom;
            }

            public method focusCell(int gx, int gy) returns void {
                this.camX = cast<float>((gx - gy) * Camera.HW);
                this.camY = cast<float>((gx + gy) * Camera.HH);
            }

            // grid cell -> screen pixel
            public method screenX(int gx, int gy) returns int {
                float ix = cast<float>((gx - gy) * Camera.HW);
                return cast<int>((ix - this.camX) * this.zoom) + this.sw / 2;
            }

            public method screenY(int gx, int gy) returns int {
                float iy = cast<float>((gx + gy) * Camera.HH);
                return cast<int>((iy - this.camY) * this.zoom) + this.sh / 2;
            }

            public method tileHalfW() returns int {
                int v = cast<int>(cast<float>(Camera.HW) * this.zoom);
                if (v < 1) { return 1; }
                return v;
            }

            public method tileHalfH() returns int {
                int v = cast<int>(cast<float>(Camera.HH) * this.zoom);
                if (v < 1) { return 1; }
                return v;
            }

            // screen pixel -> grid coords (float); used to bound the visible cell range.
            public method gridXAt(int sx, int sy) returns float {
                float ix = cast<float>(sx - this.sw / 2) / this.zoom + this.camX;
                float iy = cast<float>(sy - this.sh / 2) / this.zoom + this.camY;
                float a = ix / cast<float>(Camera.HW);   // gx - gy
                float b = iy / cast<float>(Camera.HH);   // gx + gy
                return (a + b) * 0.5;
            }

            public method gridYAt(int sx, int sy) returns float {
                float ix = cast<float>(sx - this.sw / 2) / this.zoom + this.camX;
                float iy = cast<float>(sy - this.sh / 2) / this.zoom + this.camY;
                float a = ix / cast<float>(Camera.HW);
                float b = iy / cast<float>(Camera.HH);
                return (b - a) * 0.5;
            }
        }
    }
}
