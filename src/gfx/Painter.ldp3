// The one drawing primitive the scene needs: a filled rectangle in 0-255 RGB. Implemented once on the
// CPU (SoftPainter) and once on the GPU (GlPainter), so a single Scene.paint draws the whole game for
// both the windowed and the headless/verification paths. Exercises interfaces + dynamic dispatch.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public interface Painter {
            method fillRect(int x, int y, int w, int h, int r, int g, int b) returns void;
            // A filled isometric diamond centred at (cx,cy) with half-width hw and half-height hh
            // (corners top/right/bottom/left) -- used for small marks like river channel dots.
            method fillDiamond(int cx, int cy, int hw, int hh, int r, int g, int b) returns void;
            // A filled convex quad from four corners in order. The iso tile renderer draws each tile from
            // its four SHARED grid-lattice corners, so neighbours tessellate exactly with no seams.
            method fillQuad(int x0, int y0, int x1, int y1, int x2, int y2, int x3, int y3,
                            int r, int g, int b) returns void;
        }
    }
}
