import opengl.gl.Gl;
import opengl.gl.GL;
import opengl.glsl.Shader;

program AgentsExe;

// The program the world is drawn with, and the five uniforms it takes.
//
// A uniform location is an index into ONE program's table and means nothing in any other. The
// renderer held five of the world program's slots as loose ints and, until the pixel effect was
// given a type of its own, three of a second program's slots in the same flat list beside them,
// told apart by nothing but the `u` their names started with. Passing one program's slot to the
// other is not a compile error -- it is a uniform that silently does nothing, so the picture comes
// out lit or timed wrong with everything still drawing.
//
// The five arrive together and are set together, once a frame, so they are asked for as one call:
// there is no frame that wants the projection without the view, and a `use()` that set four of
// five would be the same bug wearing a method name.
public bundle Agents {
    public namespace Gfx {

        public class WorldShader {
            private mutable Gl gl;
            private mutable int prog;
            private mutable int slotProj;
            private mutable int slotView;
            private mutable int slotTime;
            private mutable int slotAlpha;
            private mutable int slotFlat;

            public constructor WorldShader(Gl gl, String vertSrc, String fragSrc) {
                this.gl = gl;
                this.prog = Shader.fromSource(gl, vertSrc, fragSrc);
                this.slotProj = gl.getUniformLocation(this.prog, "uProj");
                this.slotView = gl.getUniformLocation(this.prog, "uView");
                this.slotTime = gl.getUniformLocation(this.prog, "uTime");
                this.slotAlpha = gl.getUniformLocation(this.prog, "uAlpha");
                this.slotFlat = gl.getUniformLocation(this.prog, "uFlat");
            }

            // Bind the program and hand it everything it needs for this frame.
            public method use(GlMat4* proj, GlMat4* view, float timeSec, float alpha,
                              float flat) returns void {
                gl.useProgram(prog);
                gl.uniformMatrix4fv(slotProj, 1, cast<byte>(0), proj.ptr());
                gl.uniformMatrix4fv(slotView, 1, cast<byte>(0), view.ptr());
                gl.uniform1f(slotTime, timeSec);
                gl.uniform1f(slotAlpha, alpha);
                gl.uniform1f(slotFlat, flat);
                return;
            }
        }
    }
}
