import System.IO.Console;
program AgentsExe;

// Three floats that mean one thing: a place in the world, or a direction to face.
//
// The CPU rasterizer took its triangles as eighteen loose floats in a row -- three corners and
// three normals, `ax, ay, az, bx, by, bz, ccx, ccy, ccz, nax, nay, naz, ...` -- and a transposition
// anywhere in that row is not an error the compiler can see. Two of the eighteen swapped is a
// triangle that still draws, still shades, and is simply in the wrong place; you find it by
// noticing the picture, which is the failure mode this renderer has already paid for once.
//
// ---- WHY THIS IS NOT THE BUILT-IN `vec3` ----
//
// The language has one, and it is SIMD: its dot product adds three lanes in whatever order the
// hardware finds convenient, and a reassociated float sum is a different number. Every pixel this
// rasterizer produces is compared against a golden image, so the arithmetic here stays scalar and
// in the order it is written. This type is storage and naming; it does no maths. That is a
// deliberate line, not an omission -- the day something here wants a real dot product, it belongs
// in `vec3` and the goldens have to be re-shot on purpose.
public bundle Agents {
    public namespace Gfx {

        public struct Vec3 {
            public mutable float x;
            public mutable float y;
            public mutable float z;

            public constructor Vec3(float x, float y, float z) {
                this.x = x;
                this.y = y;
                this.z = z;
            }
        }
    }
}
