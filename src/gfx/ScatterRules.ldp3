import System.IO.Console;
import Agents.World.Biome;
program AgentsExe;

// What each biome scatters, by biome.
//
// Three parallel arrays -- `sProp`, `sMilli`, `sScale` -- indexed by the same ordinal at every one
// of their twenty sites. Three arrays are three chances to read one of them with the wrong biome
// and nothing to notice: a moss density against a volcano's scale is a plausible number and draws
// a plausible cell.
//
// A table keyed by an enum IS index-shaped, so it is spelled as one: `rules[Biome.Bog]`.
public bundle Agents {
    public namespace Gfx {

        public class ScatterRules {
            private mutable ScatterRule[] rows;

            public constructor ScatterRules() {
                rows = new ScatterRule[Biome.count()]();
                for (int i in 0..Biome.count()) {
                    rows[i].prop = 0 - 1;
                    rows[i].perMille = 0;
                    rows[i].scale = 0.0;
                }
            }

            public destructor ~ScatterRules() returns void {
                delete rows;
            }

            // Name the prop rather than the ordinal: a biome that asks for a mesh the atlas does
            // not carry keeps its empty row and simply scatters nothing, rather than indexing off
            // the end of an atlas.
            public method set(Biome b, MeshAtlas* props, String prop, int perMille,
                              float scale) returns void {
                int p = props.ordOf(prop);
                if (p >= 0) {
                    rows[cast<int>(b)].prop = p;
                    rows[cast<int>(b)].perMille = perMille;
                    rows[cast<int>(b)].scale = scale;
                }
                return;
            }

            public operator [] (Biome b) returns ScatterRule {
                return rows[cast<int>(b)];
            }

            // The hot path carries a bare ordinal -- the classifier's output, straight out of the
            // Grid's byte -- and casting it back to ask is the same read.
            public method at(int biomeOrdinal) returns ScatterRule {
                return rows[biomeOrdinal];
            }
        }
    }
}
