import System.IO.Console;
program AgentsExe;

// The authored river tiles, by shape.
//
// Sixteen `int` fields spelled `rvStraight`, `rvDiagonal`, `rvB45a`… held these, and each was
// filled by looking a mesh up by name. That is a CLOSED SET wearing a prefix: sixteen ints that
// can only ever be one of sixteen things, with the compiler unable to say so and the field names
// abbreviating the mesh names they stood for (`rvBend` for "BendDiag", `rvT` for "TJunction").
//
// THE CONSTANTS ARE THE MESH NAMES. That is not tidiness -- it is what lets the lookup table
// derive itself from `name()` instead of sixteen hand-written lines, so an identifier cannot drift
// from the file it names. The same move that killed the NAME columns in the world tables.
public bundle Agents {
    public namespace Gfx {

        public enum RiverForm {
            // Two connections, straight through.
            Straight,
            Diagonal,
            // A diagonal bend. NOTHING SELECTS THIS ONE: the mesh is authored and the tile is
            // loaded, but no branch of the picker ever returns it -- the 45- and 135-degree bends
            // and CornerDiag cover every two-connection case between them. Kept named rather than
            // deleted so the next person asking "is there a BendDiag tile?" gets an answer instead
            // of finding a mesh nobody mentions.
            BendDiag,
            Corner90,
            // Three connections.
            TJunction,
            Fork,
            // Four.
            Crossing,
            // A spring: no connections at all, or exactly one.
            Source,
            SourceDiag,
            // Where the river meets the sea, fan facing the water.
            Delta,
            // The 45- and 135-degree bends, and the diagonal corner, which are what make
            // two-connection coverage exact and complete.
            Bend45A,
            Bend45B,
            Bend135A,
            Bend135B,
            CornerDiag,
            // The fallback pool for a junction nothing else describes.
            Star
        }
    }
}
