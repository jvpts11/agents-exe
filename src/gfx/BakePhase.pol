import System.IO.Console;
program AgentsExe;

// The two halves of a sliced bake, in the order they run.
//
// It was `bkPhase`, an int compared against 0. Two states written as a number is the smallest
// version of the same mistake the detail window made with two booleans: the code reads `if
// (bkPhase == 0)` and the reader has to go and find out which half zero is.
//
// The order matters and is not arbitrary: nothing can be emitted until the counting pass has said
// how big the buffer must be, because the buffer is allocated BETWEEN them.
public bundle Agents {
    public namespace Gfx {

        public enum BakePhase {
            // Walk the window and add up triangles, caching the per-cell answers the emitting pass
            // would otherwise have to work out a second time.
            Counting,
            // Walk it again and write the vertices, reading those answers back.
            Emitting
        }
    }
}
