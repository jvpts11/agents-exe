import System.IO.Console;
import OpenGL.Core.Gl;
import OpenGL.Core.Wgl;
import OpenGL.Core.GlEnum;
import OpenGL.Shaders.Shader;
import System.Memory.Allocator;
import System.Memory.Raw;
program AgentsExe;

// The pixel look: render the world small, then blow it up with nearest sampling and draw an
// outline where the depth or the colour breaks.
//
// Twelve fields carried this on the renderer -- a framebuffer, two textures, its size, a second
// shader program, that program's vertex array and buffer, and three of ITS uniform slots sitting
// in the same flat list as the world program's five. A uniform location is an index into one
// particular program's table and means nothing anywhere else; two programs' slots told apart by a
// prefix is not a compile error when they are crossed, it is a uniform that silently does nothing.
//
// A CLASS: it owns GL objects, it is built once on first use and lives as long as the renderer.
//
// The toggle used to be a public mutable field the app wrote directly. It is asked and told now,
// which is what lets "turned off" and "never built" be one state instead of two -- the effect is
// built lazily on the first frame that wants it, so a session that never presses the key never
// allocates a framebuffer.
public bundle Agents {
    public namespace Gfx {

        public class PostFx {
            // The low resolution the world is rendered at before it is blown up. Small on purpose:
            // this is what makes a pixel a pixel.
            public static fixed int WIDTH = 640;
            public static fixed int HEIGHT = 400;

            private mutable Gl* gl;
            private mutable boolean wanted;
            private mutable int fbo;
            private mutable int colorTex;
            private mutable int depthTex;
            private mutable int fbW;
            private mutable int fbH;
            private mutable int prog;
            private mutable int vao;
            private mutable int vbo;
            private mutable int slotColor;
            private mutable int slotDepth;
            private mutable int slotTexel;

            public constructor PostFx(Gl* gl) {
                this.gl = gl;
                wanted = false;
                fbo = 0;
                colorTex = 0;
                depthTex = 0;
                fbW = 0;
                fbH = 0;
                prog = 0;
                vao = 0;
                vbo = 0;
                slotColor = 0;
                slotDepth = 0;
                slotTexel = 0;
            }

            public method enabled() returns boolean {
                return wanted;
            }

            public method toggle() returns void {
                wanted = !wanted;
                return;
            }

            // Point rendering at the low-resolution buffer, building it on the first frame that
            // asks. Answers false when the effect is off, so the caller draws straight to screen.
            public method beginFrame() returns boolean {
                if (!wanted) {
                    return false;
                }
                if (fbo == 0) {
                    build(PostFx.WIDTH, PostFx.HEIGHT);
                }
                gl.bindFramebuffer(GlEnum.FRAMEBUFFER,fbo);
                Wgl.glViewport(0, 0, fbW, fbH);
                return true;
            }

            // Blow the small picture up to the screen and outline it.
            public method present(int screenW, int screenH) returns void {
                gl.bindFramebuffer(GlEnum.FRAMEBUFFER,0);
                Wgl.glViewport(0, 0, screenW, screenH);
                Wgl.glDisable(GlEnum.DEPTH_TEST);
                Wgl.glClearColor(0.08, 0.10, 0.14, 1.0);
                Wgl.glClear(GlEnum.COLOR_BUFFER_BIT);
                gl.useProgram(prog);
                gl.activeTexture(GlEnum.TEXTURE0);
                Wgl.glBindTexture(GlEnum.TEXTURE_2D, colorTex);
                gl.uniform1i(slotColor, 0);
                gl.activeTexture(GlEnum.TEXTURE1);
                Wgl.glBindTexture(GlEnum.TEXTURE_2D, depthTex);
                gl.uniform1i(slotDepth, 1);
                gl.uniform2f(slotTexel, 1.0 / cast<float>(fbW),
                                  1.0 / cast<float>(fbH));
                gl.bindVertexArray(vao);
                Wgl.glDrawArrays(GlEnum.TRIANGLES, 0, 6);
                gl.bindVertexArray(0);
                gl.activeTexture(GlEnum.TEXTURE0);
                return;
            }

            private method makeTex(int fw, int fh, int internalFmt, int fmt, int typ) returns int {
                address idb = Allocator.alloc(4);
                Wgl.glGenTextures(1, cast<long>(idb));
                int tex = Raw.read<int>(idb);
                Allocator.free(idb);
                Wgl.glBindTexture(GlEnum.TEXTURE_2D, tex);
                Wgl.glTexImage2D(GlEnum.TEXTURE_2D, 0, internalFmt, fw, fh, 0, fmt, typ, cast<long>(0));
                Wgl.glTexParameteri(GlEnum.TEXTURE_2D, GlEnum.TEXTURE_MIN_FILTER, GlEnum.NEAREST);
                Wgl.glTexParameteri(GlEnum.TEXTURE_2D, GlEnum.TEXTURE_MAG_FILTER, GlEnum.NEAREST);
                Wgl.glTexParameteri(GlEnum.TEXTURE_2D, GlEnum.TEXTURE_WRAP_S, GlEnum.CLAMP_TO_EDGE);
                Wgl.glTexParameteri(GlEnum.TEXTURE_2D, GlEnum.TEXTURE_WRAP_T, GlEnum.CLAMP_TO_EDGE);
                return tex;
            }

            private method build(int fw, int fh) returns void {
                fbW = fw;
                fbH = fh;
                colorTex = makeTex(fw, fh, GlEnum.RGB, GlEnum.RGB, GlEnum.UNSIGNED_BYTE);
                depthTex = makeTex(fw, fh, GlEnum.DEPTH_COMPONENT24, GlEnum.DEPTH_COMPONENT,
                                             GlEnum.FLOAT);
                address fb = Allocator.alloc(4);
                gl.genFramebuffers(1, cast<long>(fb));
                fbo = Raw.read<int>(fb);
                Allocator.free(fb);
                gl.bindFramebuffer(GlEnum.FRAMEBUFFER,fbo);
                gl.framebufferTexture2D(GlEnum.FRAMEBUFFER, GlEnum.COLOR_ATTACHMENT0, GlEnum.TEXTURE_2D,
                                             colorTex, 0);
                gl.framebufferTexture2D(GlEnum.FRAMEBUFFER, GlEnum.DEPTH_ATTACHMENT, GlEnum.TEXTURE_2D,
                                             depthTex, 0);
                gl.bindFramebuffer(GlEnum.FRAMEBUFFER,0);
                prog = Shader.fromSource(gl, PostFx.vertSrc(), PostFx.fragSrc());
                vao = gl.genVertexArray();
                vbo = gl.genBuffer();
                float[] q = new float[24]();
                PostFx.fillQuad(q);
                gl.bindVertexArray(vao);
                gl.bindBuffer(GlEnum.ARRAY_BUFFER, vbo);
                gl.bufferDataFloats(GlEnum.ARRAY_BUFFER, q, GlEnum.STATIC_DRAW);
                gl.vertexAttribPointer(0, 2, GlEnum.FLOAT, cast<byte>(0), 16, 0);
                gl.enableVertexAttribArray(0);
                gl.vertexAttribPointer(1, 2, GlEnum.FLOAT, cast<byte>(0), 16, 8);
                gl.enableVertexAttribArray(1);
                gl.bindVertexArray(0);
                delete q;
                // These three belong to THIS program and nowhere else.
                slotColor = gl.getUniformLocation(prog, "uColor");
                slotDepth = gl.getUniformLocation(prog, "uDepth");
                slotTexel = gl.getUniformLocation(prog, "uTexel");
                return;
            }

            // The full-screen quad, two triangles with their texture coordinates.
            private static method fillQuad(float[] q) returns void {
                q[0] = 0.0 - 1.0;
                q[1] = 0.0 - 1.0;
                q[2] = 0.0;
                q[3] = 0.0;
                q[4] = 1.0;
                q[5] = 0.0 - 1.0;
                q[6] = 1.0;
                q[7] = 0.0;
                q[8] = 1.0;
                q[9] = 1.0;
                q[10] = 1.0;
                q[11] = 1.0;
                q[12] = 0.0 - 1.0;
                q[13] = 0.0 - 1.0;
                q[14] = 0.0;
                q[15] = 0.0;
                q[16] = 1.0;
                q[17] = 1.0;
                q[18] = 1.0;
                q[19] = 1.0;
                q[20] = 0.0 - 1.0;
                q[21] = 1.0;
                q[22] = 0.0;
                q[23] = 1.0;
            }

            private static method vertSrc() returns String {
                return "#version 330 core\nlayout(location=0) in vec2 aPos;\nlayout(location=1) in vec2 aUV;\nout vec2 vUV;\nvoid main(){ vUV=aUV; gl_Position=vec4(aPos,0.0,1.0); }\n";
            }

            private static method fragSrc() returns String {
                return "#version 330 core\nin vec2 vUV;\nout vec4 FragColor;\nuniform sampler2D uColor;\nuniform sampler2D uDepth;\nuniform vec2 uTexel;\nvoid main(){\n  vec3 bg = vec3(0.08,0.10,0.14);\n  float d = texture(uDepth, vUV).r;\n  if (d >= 0.9999) { FragColor = vec4(bg,1.0); return; }\n  vec3 c = texture(uColor, vUV).rgb;\n  float dl = texture(uDepth, vUV+vec2(-uTexel.x,0.0)).r;\n  float dr = texture(uDepth, vUV+vec2(uTexel.x,0.0)).r;\n  float du = texture(uDepth, vUV+vec2(0.0,-uTexel.y)).r;\n  float dd = texture(uDepth, vUV+vec2(0.0,uTexel.y)).r;\n  bool sil = (dl>=0.9999)||(dr>=0.9999)||(du>=0.9999)||(dd>=0.9999);\n  float dmax = max(max(abs(d-dl),abs(d-dr)),max(abs(d-du),abs(d-dd)));\n  vec3 cl = texture(uColor, vUV+vec2(-uTexel.x,0.0)).rgb;\n  vec3 cu = texture(uColor, vUV+vec2(0.0,-uTexel.y)).rgb;\n  float cd = max(length(c-cl), length(c-cu));\n  if (sil || dmax > 0.004 || cd > 0.34) { FragColor = vec4(0.20,0.20,0.24,1.0); return; }\n  vec3 q = floor(c*8.0 + 0.5)/8.0;\n  FragColor = vec4(q,1.0);\n}\n";
            }
        }
    }
}
