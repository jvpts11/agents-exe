import System.IO.Console;
program AgentsExe;

// What loose clutter a biome scatters on a cell that holds nothing else: which prop, how densely,
// and at what size.
//
// NO TREES. Every tree in the world is a resource node placed by the Flora worldgen pass, which is
// the only thing that knows where a wood actually is; what is scattered here is undergrowth and
// ground texture, whose whole job is to stop an empty cell reading as empty. A per-cell hash is
// exactly right for that and exactly wrong for a forest. Reeds, cactus and boulders left for the
// same reason: all three are harvestable, so all three are nodes, placed where the water, the
// desert and the rock are.
public bundle Agents {
    public namespace Gfx {

        public struct ScatterRule {
            // Prop ordinal in the props atlas, or -1 for a biome that scatters nothing.
            public mutable int prop;
            // Chance per cell, in per mille -- compared against a hash, so it is a density and not
            // a count.
            public mutable int perMille;
            public mutable float scale;

            public constructor ScatterRule(int prop, int perMille, float scale) {
                this.prop = prop;
                this.perMille = perMille;
                this.scale = scale;
            }

            public method scatters() returns boolean {
                return prop >= 0;
            }
        }
    }
}
