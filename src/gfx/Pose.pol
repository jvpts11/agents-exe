program AgentsExe;

// WHERE A BODY IS AND WHICH WAY IT FACES. Two `vec2`, and they travel together everywhere in this
// game: an agent's `Whereabouts` holds both, a herd's does, and the renderer's chase state kept the
// same pair as four parallel float arrays -- `atX`, `atY`, `faceX`, `faceY`.
//
// THE PAIR IS THE POINT, not either half. A position written without its facing is the defect this
// codebase has already met twice: a body that moves and keeps pointing where it used to, or one
// that is pointed along a jump it never walked. Keeping them in one value means the two are read
// and written in the same breath, and a `Pose[]` is still four columns in memory -- naming it costs
// nothing at run time and takes away the arrangement where the fourth array can be forgotten.
public bundle Agents {
    public namespace Gfx {

        public struct Pose {
            public mutable vec2 at;
            public mutable vec2 facing;

            public constructor Pose(vec2 at, vec2 facing) {
                this.at = at;
                this.facing = facing;
            }

            // Somewhere, pointing nowhere yet. A facing of zero is the one a reader can tell from a
            // direction, which is what `Turn.facing` asks about before it turns anything.
            public static method at(float x, float y) returns Pose {
                return new Pose(vec2(x, y), vec2(0.0, 0.0));
            }

            public method pointless() returns boolean {
                return this.facing.x == 0.0 && this.facing.y == 0.0;
            }

            // Move to a place and face the way the move went. The caller decides whether the step
            // was big enough to be a walk -- a jump keeps the old facing, and that decision belongs
            // where the thresholds are rather than in here.
            public method walkTo(float x, float y, float dx, float dy, float span) returns Pose {
                return new Pose(vec2(x, y), vec2(dx / span, dy / span));
            }
        }
    }
}
