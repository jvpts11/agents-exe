import Agents.App.Ppm;

// Software 3D rasterizer that bakes the agents-exe pixel look (ported from artgen/render3d.py):
// orbit camera (azimuth/elevation, orthographic), z-buffer, per-vertex normal interpolation, cel
// shading (0.60 + 0.42*ndl), an ID-buffer group-boundary outline in (55,55,65), supersample +
// box-downscale for the chunky pixel grid. Draws biome meshes straight from a MeshAtlas block, each
// extruded to a solid column so raised terrain has no see-through gaps. Headless verification path;
// the GL path mirrors it.
program AgentsExe;

public bundle Agents {
    public namespace Gfx {

        public class Raster3D {
            private mutable int nat;
            private mutable int nath;
            private mutable int ss;
            private mutable int wpx;
            private mutable int hpx;

            private mutable float[] col;
            private mutable int[] cov;
            private mutable float[] zb;
            private mutable int[] idb;

            private mutable float rx;
            private mutable float ry;
            private mutable float rz;
            private mutable float ux;
            private mutable float uy;
            private mutable float uz;
            private mutable float cx;
            private mutable float cy;
            private mutable float cz;
            private mutable float tx;
            private mutable float ty;
            private mutable float tz;
            private mutable float scale;
            private mutable float ox;
            private mutable float oy;
            private mutable float lx;
            private mutable float ly;
            private mutable float lz;

            public constructor Raster3D(int natW, int natH, int ss) {
                nat = natW;
                nath = natH;
                this.ss = ss;
                wpx = natW * ss;
                hpx = natH * ss;
                int n = wpx * hpx;
                col = new float[n * 3]();
                cov = new int[n]();
                zb = new float[n]();
                idb = new int[n]();
                mutable int i = 0;
                while (i < n) {
                    zb[i] = 0.0 - 1000000000.0;
                    idb[i] = 0 - 1;
                    i = i + 1;
                }
                float ln = fsqrt(0.35 * 0.35 + 0.55 * 0.55 + 0.95 * 0.95);
                lx = 0.35 / ln;
                ly = 0.55 / ln;
                lz = 0.95 / ln;
                // THE CAMERA STARTS AT NOTHING, and it always did -- these fifteen were never
                // assigned here at all. `setCamera` fills them, and every caller does call it
                // before drawing, so nothing has ever read the garbage; but "nothing has read it
                // yet" is not the same as "there is nothing to read". The compiler asked for this
                // the moment a `this.` came off the call above -- the field-initialisation check
                // treats `this.method()` in a constructor as discharging every pending field, so
                // the prefix on the square root had been switching it off.
                rx = 0.0;
                ry = 0.0;
                rz = 0.0;
                ux = 0.0;
                uy = 0.0;
                uz = 0.0;
                cx = 0.0;
                cy = 0.0;
                cz = 0.0;
                tx = 0.0;
                ty = 0.0;
                tz = 0.0;
                scale = 1.0;
                ox = 0.0;
                oy = 0.0;
            }

            public destructor ~Raster3D() returns void {
                delete col;
                delete cov;
                delete zb;
                delete idb;
            }

            // This path used fourteen iterations where the GL path used twenty, and the difference
            // was not a choice -- fourteen had not converged. See Newton.
            private method fsqrt(float v) returns float {
                return Newton.sqrt(v);
            }

            public method setCamera(float az, float el, float tx, float ty, float tz, float radius) returns void {
                float pi = 3.14159265;
                float a = az * pi / 180.0;
                float e = el * pi / 180.0;
                float ce = fcos(e);
                float se = fsin(e);
                cx = ce * fsin(a);
                cy = ce * fcos(a);
                cz = se;
                float r0x = 0.0 * cz - 1.0 * cy;
                float r0y = 1.0 * cx - 0.0 * cz;
                float r0z = 0.0 * cy - 0.0 * cx;
                float rl = fsqrt(r0x * r0x + r0y * r0y + r0z * r0z);
                rx = r0x / rl;
                ry = r0y / rl;
                rz = r0z / rl;
                float u0x = cy * rz - cz * ry;
                float u0y = cz * rx - cx * rz;
                float u0z = cx * ry - cy * rx;
                float ul = fsqrt(u0x * u0x + u0y * u0y + u0z * u0z);
                ux = u0x / ul;
                uy = u0y / ul;
                uz = u0z / ul;
                this.tx = tx;
                this.ty = ty;
                this.tz = tz;
                mutable float minN = cast<float>(nat);
                if (nath < nat) {
                    minN = cast<float>(nath);
                }
                scale = (minN * 0.46 / radius) * cast<float>(ss);
                ox = cast<float>(wpx) * 0.5;
                oy = cast<float>(hpx) * 0.5;
            }

            public method fitAndAim(float az, float el, int nCells, int mCells, float vscale) returns void {
                float hx = cast<float>(nCells - 1);
                float hy = cast<float>(mCells - 1);
                float radius = fsqrt(hx * hx + hy * hy) + vscale + 2.0;
                setCamera(az, el, hx, hy, vscale * 0.4, radius);
            }

            private method fsin(float x) returns float {
                return Newton.sin(x);
            }

            private method fcos(float x) returns float {
                return Newton.cos(x);
            }

            // One triangle: three corners, each with the normal it is shaded by, in one colour.
            //
            // These were twenty-two loose parameters -- eighteen of them floats of the same type in
            // a row, where any two swapped compiles and draws and is simply wrong somewhere on the
            // screen.
            public method drawTri(Vec3 a, Vec3 b, Vec3 c, Vec3 na, Vec3 nb, Vec3 nc,
                                  Rgb tint, int grp) returns void {
                float qax = a.x - tx;
                float qay = a.y - ty;
                float qaz = a.z - tz;
                float qbx = b.x - tx;
                float qby = b.y - ty;
                float qbz = b.z - tz;
                float qcx = c.x - tx;
                float qcy = c.y - ty;
                float qcz = c.z - tz;
                float sax = ox + scale * (qax * rx + qay * ry + qaz * rz);
                float say = oy - scale * (qax * ux + qay * uy + qaz * uz);
                float da = qax * cx + qay * cy + qaz * cz;
                float sbx = ox + scale * (qbx * rx + qby * ry + qbz * rz);
                float sby = oy - scale * (qbx * ux + qby * uy + qbz * uz);
                float db = qbx * cx + qby * cy + qbz * cz;
                float scx = ox + scale * (qcx * rx + qcy * ry + qcz * rz);
                float scy = oy - scale * (qcx * ux + qcy * uy + qcz * uz);
                float dc = qcx * cx + qcy * cy + qcz * cz;

                mutable int minx = ftoi(fmin3(sax, sbx, scx));
                mutable int maxx = ftoi(fmax3(sax, sbx, scx)) + 1;
                mutable int miny = ftoi(fmin3(say, sby, scy));
                mutable int maxy = ftoi(fmax3(say, sby, scy)) + 1;
                if (minx < 0) { minx = 0; }
                if (miny < 0) { miny = 0; }
                if (maxx > wpx) { maxx = wpx; }
                if (maxy > hpx) { maxy = hpx; }
                float denom = (sby - scy) * (sax - scx) + (scx - sbx) * (say - scy);
                if (denom < 0.0000001 && denom > 0.0 - 0.0000001) {
                    return;
                }
                float inv = 1.0 / denom;
                float br = cast<float>(tint.r);
                float bg = cast<float>(tint.g);
                float bb = cast<float>(tint.b);
                mutable int py = miny;
                while (py < maxy) {
                    float fy = cast<float>(py) + 0.5;
                    mutable int px = minx;
                    while (px < maxx) {
                        float fx = cast<float>(px) + 0.5;
                        float wa = ((sby - scy) * (fx - scx) + (scx - sbx) * (fy - scy)) * inv;
                        float wb = ((scy - say) * (fx - scx) + (sax - scx) * (fy - scy)) * inv;
                        float wc = 1.0 - wa - wb;
                        if (wa >= 0.0 - 0.0001 && wb >= 0.0 - 0.0001 && wc >= 0.0 - 0.0001) {
                            float depth = wa * da + wb * db + wc * dc;
                            int idx = py * wpx + px;
                            if (depth > zb[idx]) {
                                float nx = wa * na.x + wb * nb.x + wc * nc.x;
                                float ny = wa * na.y + wb * nb.y + wc * nc.y;
                                float nz = wa * na.z + wb * nb.z + wc * nc.z;
                                float nl = fsqrt(nx * nx + ny * ny + nz * nz) + 0.000000001;
                                mutable float ndl = (nx * lx + ny * ly + nz * lz) / nl;
                                if (ndl < 0.0) { ndl = 0.0; }
                                if (ndl > 1.0) { ndl = 1.0; }
                                mutable float sh = 0.60 + 0.42 * ndl;
                                if (sh > 1.0) { sh = 1.0; }
                                col[idx * 3] = br * sh;
                                col[idx * 3 + 1] = bg * sh;
                                col[idx * 3 + 2] = bb * sh;
                                cov[idx] = 1;
                                zb[idx] = depth;
                                idb[idx] = grp;
                            }
                        }
                        px = px + 1;
                    }
                    py = py + 1;
                }
            }

            private method ftoi(float v) returns int {
                return cast<int>(v);
            }

            private method fmin3(float a, float b, float c) returns float {
                mutable float m = a;
                if (b < m) { m = b; }
                if (c < m) { m = c; }
                return m;
            }

            private method fmax3(float a, float b, float c) returns float {
                mutable float m = a;
                if (b > m) { m = b; }
                if (c > m) { m = c; }
                return m;
            }

            // A flat quad: four corners sharing one normal, cut into two triangles.
            public method drawQuad(Vec3 a, Vec3 b, Vec3 c, Vec3 d, Vec3 n,
                                   Rgb tint, int grp) returns void {
                drawTri(a, b, c, n, n, n, tint, grp);
                drawTri(a, c, d, n, n, n, tint, grp);
            }

            // The wall that fills 0..wz beneath a raised tile, so a lifted plate reads as a solid
            // column instead of a slab over a hole. The GL renderer draws the same thing (see
            // `GlWorld3D.emitSkirt`); this is the preview's copy of it, and it stands apart because
            // it feeds a different pipeline -- flat quads with one normal each, against a vertex
            // buffer -- and shares no code with it, only the shape.
            private method drawSkirt(float wx, float wy, float wz, Rgb side, int grp) returns void {
                float x0 = wx - 1.0;
                float x1 = wx + 1.0;
                float y0 = wy - 1.0;
                float y1 = wy + 1.0;
                drawQuad(new Vec3(x1, y0, 0.0), new Vec3(x1, y1, 0.0), new Vec3(x1, y1, wz),
                              new Vec3(x1, y0, wz), new Vec3(1.0, 0.0, 0.0), side, grp);
                drawQuad(new Vec3(x0, y0, 0.0), new Vec3(x0, y0, wz), new Vec3(x0, y1, wz),
                              new Vec3(x0, y1, 0.0), new Vec3(0.0 - 1.0, 0.0, 0.0), side, grp);
                drawQuad(new Vec3(x0, y1, 0.0), new Vec3(x0, y1, wz), new Vec3(x1, y1, wz),
                              new Vec3(x1, y1, 0.0), new Vec3(0.0, 1.0, 0.0), side, grp);
                drawQuad(new Vec3(x0, y0, 0.0), new Vec3(x1, y0, 0.0), new Vec3(x1, y0, wz),
                              new Vec3(x0, y0, wz), new Vec3(0.0, 0.0 - 1.0, 0.0), side, grp);
            }

            // Draw biome `ord` at grid cell world-corner (wx,wy) raised to top height wz. A skirt fills
            // 0..wz so raised tiles read as solid columns. gbase uniquely tags the tile for the outline.
            public method drawAtlas(MeshAtlas* a, int ord, float wx, float wy, float wz, int gbase) returns void {
                int t0 = a.triStart[ord];
                int tn = a.triCount[ord];
                int sideGrp = gbase + a.grp[t0];
                if (wz > 0.02) {
                    drawSkirt(wx, wy, wz, a.colourOf(t0), sideGrp);
                }
                mutable int t = 0;
                while (t < tn) {
                    int tri = t0 + t;
                    int vb = tri * 3;
                    int v0 = vb;
                    int v1 = vb + 1;
                    int v2 = vb + 2;
                    drawTri(new Vec3(a.px[v0] + wx, a.py[v0] + wy, a.pz[v0] + wz),
                                 new Vec3(a.px[v1] + wx, a.py[v1] + wy, a.pz[v1] + wz),
                                 new Vec3(a.px[v2] + wx, a.py[v2] + wy, a.pz[v2] + wz),
                                 new Vec3(a.nx[v0], a.ny[v0], a.nz[v0]),
                                 new Vec3(a.nx[v1], a.ny[v1], a.nz[v1]),
                                 new Vec3(a.nx[v2], a.ny[v2], a.nz[v2]),
                                 a.colourOf(tri), gbase + a.grp[tri]);
                    t = t + 1;
                }
            }

            public method savePPM(String path, int bgr, int bgg, int bgb) returns void {
                int s = ss;
                int half = s / 2;
                mutable Ppm* file = new Ppm(nat, nath) on heap;
                mutable int oyp = 0;
                while (oyp < nath) {
                    mutable int oxp = 0;
                    while (oxp < nat) {
                        mutable float sr = 0.0;
                        mutable float sg = 0.0;
                        mutable float sbb = 0.0;
                        mutable int cnt = 0;
                        mutable int dy = 0;
                        while (dy < s) {
                            mutable int dx = 0;
                            while (dx < s) {
                                int spx = oxp * s + dx;
                                int spy = oyp * s + dy;
                                int si = spy * wpx + spx;
                                if (cov[si] == 1) {
                                    sr = sr + col[si * 3];
                                    sg = sg + col[si * 3 + 1];
                                    sbb = sbb + col[si * 3 + 2];
                                    cnt = cnt + 1;
                                }
                                dx = dx + 1;
                            }
                            dy = dy + 1;
                        }
                        int cxp = oxp * s + half;
                        int cyp = oyp * s + half;
                        int cid = idb[cyp * wpx + cxp];
                        mutable int rr = bgr;
                        mutable int gg = bgg;
                        mutable int bbo = bgb;
                        if (cid != 0 - 1) {
                            boolean edge = idDiff(cxp, cyp, cid, s);
                            if (edge) {
                                rr = 55;
                                gg = 55;
                                bbo = 65;
                            } else {
                                if (cnt > 0) {
                                    rr = clamp255(sr / cast<float>(cnt));
                                    gg = clamp255(sg / cast<float>(cnt));
                                    bbo = clamp255(sbb / cast<float>(cnt));
                                }
                            }
                        }
                        file.pixel(rr, gg, bbo);
                        oxp = oxp + 1;
                    }
                    oyp = oyp + 1;
                }
                file.save(path);
                delete file;
            }

            private method idDiff(int cxp, int cyp, int cid, int s) returns boolean {
                if (idAt(cxp - s, cyp) != cid) { return true; }
                if (idAt(cxp + s, cyp) != cid) { return true; }
                if (idAt(cxp, cyp - s) != cid) { return true; }
                if (idAt(cxp, cyp + s) != cid) { return true; }
                return false;
            }

            private method idAt(int x, int y) returns int {
                if (x < 0 || y < 0 || x >= wpx || y >= hpx) {
                    return 0 - 1;
                }
                return idb[y * wpx + x];
            }

            private method clamp255(float v) returns int {
                mutable int i = cast<int>(v * 255.0 + 0.5);
                if (i < 0) { i = 0; }
                if (i > 255) { i = 255; }
                return i;
            }
        }
    }
}
