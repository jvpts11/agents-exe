import System.IO.Console;
program AgentsExe;

// How one resource node kind is drawn: which model, out of which atlas, at what size.
//
// WHICH ATLAS is the field that has to travel with the other two. A kind's art lives in whichever
// atlas the economy table names -- the seven promoted tree species and the boulder are still props,
// everything else is a node mesh -- so a model index means nothing without the atlas it indexes.
// They were two arrays and a third for the scale, read together at every site and able to disagree
// at any of them.
public bundle Agents {
    public namespace Gfx {

        public struct NodeLook {
            // Model index inside the atlas below, or -1 for a kind whose mesh is missing. A missing
            // mesh is simply never drawn, rather than indexing off the end of an atlas.
            public mutable int model;
            // true = the props atlas, false = the nodes atlas.
            public mutable boolean inProps;
            public mutable float scale;

            public constructor NodeLook(int model, boolean inProps, float scale) {
                this.model = model;
                this.inProps = inProps;
                this.scale = scale;
            }

            public method drawable() returns boolean {
                return model >= 0;
            }
        }
    }
}
