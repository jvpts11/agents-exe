import System.IO.Console;
program AgentsExe;

// How one terrain model sits: where its top plate is, and how far it has to be lifted so every
// land plate shares one ground level.
//
// The two are read together at thirty-one sites and mean nothing apart. A top without its lift
// answers "how high is this mesh" when the question is always "how high is this mesh once it is
// standing where the others stand" -- and the models are authored at different heights, so the
// lift is not a detail, it is what stops a plateau reading as a staircase.
public bundle Agents {
    public namespace Gfx {

        public struct TerrainLook {
            // The z of the box top, as authored.
            public mutable float top;
            // What to add so this model's top lands on the shared ground level.
            public mutable float lift;

            public constructor TerrainLook(float top, float lift) {
                this.top = top;
                this.lift = lift;
            }

            // Where this model's top plate ends up once it is standing with the others.
            public method groundedTop() returns float {
                return top + lift;
            }
        }
    }
}
