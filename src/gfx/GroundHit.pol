program AgentsExe;

// WHERE A SCREEN PIXEL LANDS ON THE WORLD, or that it lands nowhere.
//
// The miss is a field and not a value of the coordinates, which is the lesson `CellHit` was written
// after: a search that answered the map's centre when it found nothing gave a caller a real cell it
// could not tell from an answer. A pixel above the horizon is a pixel with no cell under it, and
// there is no number that says so.
public bundle Agents {
    public namespace Gfx {

        public record GroundHit(boolean onWorld, int x, int y) {
        }
    }
}
