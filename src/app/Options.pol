import System.IO.Console;
import System.Text.Scanner;
program AgentsExe;

// The command line, read as NAMED options rather than by position.
//
// THE GAME ITSELF TAKES ALMOST NOTHING, and that is the decision this serves rather than a reason
// it is unnecessary. A run is seed 42 and the speed is the 1-6 keys, because a control the player
// cannot reach does not belong on the game. What is left out here is `for=`, which ends a session
// by itself so the implementation can be developed against the real game, and the instruments'
// own options -- `gensize w= h=`.
//
// WHY NOT POSITION, for what remains. `gensize 640 360` reads well enough with two numbers and
// stops reading with three, and a mistyped `hh=360` under a positional scheme is a number silently
// missing rather than a mistake. Every value arrives wearing its name.
//
// AND IT REMOVES THE TRAP THAT COST A DAY. A bare number used to be a seed, which meant a mistyped
// command was indistinguishable from a world to generate -- `gensiz` silently became seed 42 and
// opened the interactive window under a gate that waits for the process to exit. Nothing on the
// command line is a bare value now, so a word that is not a command and not `name=value` is a
// mistake and can be refused as one.
//
// WHAT IS READ IS MARKED, and that is the whole reason this is an object rather than a handful of
// static lookups. The alternative is for each command to hold a second list of the names it
// accepts, so an unknown option can be spotted -- two lists, written by hand, that must agree
// forever. That pair is exactly the defect `Gear` was built to end, where a pace and its key
// number lived in two if-ladders that had to be exact inverses. Here reading IS the declaration:
// whatever nobody asked for is still unread at the end, and `stray()` names it.
public bundle Agents {
    public namespace App {

        public class Options {
            private mutable string[] words;
            private mutable boolean[] taken;

            // The array is BORROWED, not owned: an array variable holds the block, so this is the
            // same array `main` was handed and there is nothing here to free. Only the tally of
            // what has been read belongs to this object.
            public constructor Options(string[] words) {
                this.words = words;
                taken = new boolean[words.length()]();
                if (words.length() > 0) {
                    taken[0] = true;               // words[0] is the command; it is not an option
                }
            }

            public destructor ~Options() returns void {
                delete taken;
                return;
            }

            // The value of `name=...`, as a number. Absent, or present and unreadable as a number,
            // both give the fallback: a command line is typed by a person and a run is not worth
            // refusing over, which is the same judgement `Gear.onKey` makes about a number outside
            // 1..6.
            public method number(String name, int fallback) returns int {
                String raw = text(name, "");
                if (raw.length() == 0) {
                    return fallback;
                }
                mutable Scanner sc = new Scanner(raw) on heap;
                mutable int got = fallback;
                if (sc.hasNext()) {
                    got = sc.nextInt();
                }
                delete sc;
                return got;
            }

            // Was this option written at all? ASKING IS NOT READING, so this does not mark it: a
            // command that asks and then never takes the value has still left it unread, and
            // `stray()` is right to say so.
            //
            // It exists so that "nobody asked" and "somebody asked for the default value" stay
            // different things WITHOUT a sentinel. `-1 means unset` would be the obvious way and it
            // is the one thing these layouts ban by name -- five of them list `Option<T>` against
            // *"the -1 sentinel"*. An `Option<int>` would be the other way and it is too much
            // machinery here: an Option is for an absence that TRAVELS, and this one is answered on
            // the next line.
            public method asked(String name) returns boolean {
                String head = name.concat("=");
                mutable int i = 1;
                while (i < words.length()) {
                    String word = words[i];
                    if (word.length() >= head.length()
                        && word.substring(0, head.length()).equals(head)) {
                        return true;
                    }
                    i = i + 1;
                }
                return false;
            }

            // The value of `name=...`, as text. Marks the option read, which is what lets an
            // unknown one be found afterwards.
            public method text(String name, String fallback) returns String {
                String head = name.concat("=");
                mutable int i = 1;
                while (i < words.length()) {
                    String word = words[i];
                    if (word.length() >= head.length()
                        && word.substring(0, head.length()).equals(head)) {
                        taken[i] = true;
                        return word.substring(head.length(), word.length());
                    }
                    i = i + 1;
                }
                return fallback;
            }

            // The first word the command never asked for, or "" if it read them all. A misspelt
            // option is silence otherwise -- `ssed=7` would run seed 42 and report nothing, which
            // is the quietest way to run the wrong world for an hour.
            public method stray() returns String {
                mutable int i = 0;
                while (i < words.length()) {
                    if (!taken[i]) {
                        return words[i];
                    }
                    i = i + 1;
                }
                return "";
            }
        }
    }
}
