import System.IO.Console;
program AgentsExe;

// A cell a search found.
//
// It used to travel as `y * width + x` in an `int`, with `-1` meaning nothing was found -- so the
// caller had to know the width to unpack it, and had to remember that one particular value of the
// answer is not an answer at all. Every site did both by hand, and one of them forgot: `findForest`
// answered the map centre when it found nothing, which is a real cell, and the caller could not
// tell that apart from having found a forest exactly in the middle.
public bundle Agents {
    public namespace App {

        public record CellHit(int x, int y) {
        }
    }
}
