import System.IO.Console;
program AgentsExe;

// The keys the windows listen for, by the code Windows sends.
//
// Twenty sites tested raw hex with the key's name in a trailing comment -- `0x53` with `// S`
// beside it -- which is a name the compiler cannot check and a reader cannot verify without a
// table nobody has open. 0x53 and 0x57 differ by four and are S and W, which are the two keys that
// pan in opposite directions; swapping them is a control that moves the wrong way and no error
// anywhere.
//
// These are the virtual-key codes, not characters: `A` here is the key in that position on the
// board, which is why the letters are the ASCII capitals and the arrows are not letters at all.
public bundle Agents {
    public namespace App {

        public class Key {
            public static fixed int LEFT_MOUSE = 0x01;
            public static fixed int ESCAPE = 0x1B;
            public static fixed int SPACE = 0x20;

            public static fixed int ARROW_LEFT = 0x25;
            public static fixed int ARROW_UP = 0x26;
            public static fixed int ARROW_RIGHT = 0x27;
            public static fixed int ARROW_DOWN = 0x28;

            // The gear keys, as a range: 1 through 6.
            public static fixed int DIGIT_1 = 0x31;
            public static fixed int DIGIT_6 = 0x36;

            public static fixed int A = 0x41;
            public static fixed int D = 0x44;
            public static fixed int P = 0x50;
            public static fixed int S = 0x53;
            public static fixed int W = 0x57;
        }
    }
}
