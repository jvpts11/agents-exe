import System.IO.Console;
program AgentsExe;

// How fast the world runs, by the number printed on the key that selects it.
//
// The pace was written twice, in two if-ladders that had to be exact inverses of each other:
// `paceOf` turned a key number into world-ticks-per-frame and `gearOf` turned it back. Six pairs
// of numbers kept in step by hand, and nothing checked they still were -- so a gear could report
// itself as one number and run at another's pace, which is a run labelled with a speed it never
// ran at. That already happened to this project once, for a different reason: the pace was
// computed, passed as a parameter, and never read, so every run at every gear went at one tick a
// frame with the HUD saying otherwise.
//
// One constant per gear, carrying its own pace, is the fix: there is one place the pair is
// written, and no second place to disagree with it.
//
// The gear travels as a GEAR from the command line to the loop. It used to be turned into a pace
// by the argument parser and back into a gear by the loop, which is what made two ladders
// necessary in the first place.
public bundle Agents {
    public namespace App {

        public enum Gear {
            // World ticks per frame. Gear one is real time; gear six is a century in an afternoon.
            One(1.0),
            Two(2.0),
            Three(5.0),
            Four(20.0),
            Five(60.0),
            Six(300.0);

            private float ticks;

            public constructor Gear(float ticks) {
                this.ticks = ticks;
            }

            // World ticks to run per frame at this gear.
            public method pace() returns float {
                return ticks;
            }

            // The number printed on the key that selects this gear, 1 to 6.
            public method number() returns int {
                return cast<int>(this) + 1;
            }

            // The gear a key number selects. Anything outside 1..6 lands on the nearest end
            // rather than failing: the number comes from a command line and from a keyboard, and
            // neither is worth refusing a run over.
            public static method onKey(int number) returns Gear {
                if (number <= 1) {
                    return Gear.One;
                }
                if (number == 2) {
                    return Gear.Two;
                }
                if (number == 3) {
                    return Gear.Three;
                }
                if (number == 4) {
                    return Gear.Four;
                }
                if (number == 5) {
                    return Gear.Five;
                }
                return Gear.Six;
            }
        }
    }
}
