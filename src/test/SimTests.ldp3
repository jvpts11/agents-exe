import System.IO.Console;
import System.Test.Test;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.People.AgentTable;
import Agents.People.Act;
import Agents.Sim.Simulation;
import Agents.Sim.Stores;
import Agents.Sim.Buildings;
import Agents.Sim.Nations;
import Agents.Sim.Rank;
import Agents.Sim.Armies;
import Agents.Sim.Fates;
import Agents.Sim.Calamity;
import Agents.World.Builds;
program AgentsExe;

// The simulation, end to end.
//
// Everything below runs a real arc on the real world with the real fifty thousand people, and then
// asserts on what the world looks like afterwards. These are not unit tests of a method: they are
// the questions someone asks after watching a run and wondering whether what they saw was right --
// does the population survive, does anybody build anything, does the map get claimed, does the
// economy move, does anyone go to war -- asked as numbers so nobody has to squint at a report.
//
// The arc is deliberately short (two generations rather than twenty) so the suite stays runnable;
// the twenty-generation arc is tagged `slow` and left out of the default run.

public bundle Agents {
    public namespace Checks {

        public class Arc {
            private static mutable Grid* world;
            private static mutable AgentTable* folk;
            private static mutable Simulation* sim;
            private static mutable int steps = 0;

            public static method PEOPLE() returns int {
                return 50000;
            }

            // A life is about 360 seconds of world time; at dt=0.05 that is 7200 steps. Two
            // generations is enough for people to be born, take a job, build, claim ground and
            // fall out with the neighbours -- everything the assertions below ask about.
            public static method STEPS() returns int {
                return 14400;
            }

            [BeforeAll]
            public static method runTheArc() returns void {
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Arc.world = gen.generate(2560, 1440);
                Arc.folk = new AgentTable(Arc.PEOPLE()) on heap;
                Arc.folk.seedWorld(Arc.world, Arc.PEOPLE(), 100, 42);
                Arc.sim = new Simulation(Arc.world, Arc.folk, 42) on heap;
                // Nobody is on screen: everyone takes the cheap path, which is the honest shape of
                // a headless run and also the one the tests want to exercise.
                Arc.sim.setNearWindow(0, 0, 0, 0);
                float dt = 0.05;
                mutable int frame = 0;
                while (frame < Arc.STEPS()) {
                    Arc.sim.step(dt);
                    frame = frame + 1;
                }
                Arc.steps = Arc.STEPS();
                return;
            }

            [AfterAll]
            public static method dropTheArc() returns void {
                delete Arc.sim;
                delete Arc.folk;
                delete Arc.world;
                return;
            }

            // The first thing to know about any arc: did the world survive it. An arc that ends
            // with everybody dead passed every other assertion for the wrong reason -- this is the
            // one that caught the migration bug where 130939 people left home on the same tick.
            [Tag(name: "sim")]
            [Test]
            public static method the_world_is_still_populated() returns void {
                Test.checking("people are alive at the end of the arc");
                Test.assertAtLeast(Arc.sim.livingCount(), 1000);
                Test.checking("and the population has not run away past its cap");
                Test.assertAtMost(Arc.sim.livingCount(), Arc.PEOPLE());
                Test.checking("children were born during the arc");
                Test.assertTrue(Arc.sim.bornCount() > cast<long>(0));
                return;
            }

            // Nobody should be standing in the sea. `offLand` is the count that says the movement
            // code let someone walk off the map or into water.
            [Tag(name: "sim")]
            [Test]
            public static method nobody_is_standing_in_the_sea() returns void {
                Test.checking("no living person is off land");
                Test.assertEqual(Arc.sim.offLand(), 0);
                return;
            }

            // A person who never arrives anywhere is a person whose pathing is broken. `stuck`
            // counts the ones that gave up.
            [Tag(name: "sim")]
            [Test]
            public static method people_get_where_they_are_going() returns void {
                Test.checking("journeys completed during the arc");
                Test.assertAtLeast(Arc.sim.arrived(), 1000);
                // Some sticking is expected -- a target node harvested out from under someone --
                // but it must be the exception, not the rule.
                Test.checking("stuck journeys stay a minority of arrivals");
                Test.assertAtMost(Arc.sim.stuck(), Arc.sim.arrived());
                return;
            }

            // Work has to produce something. An economy where every ledger is zero means the job
            // loop is running and nothing is coming out of it.
            [Tag(name: "sim")]
            [Test]
            public static method the_economy_moves() returns void {
                Stores* st = Arc.sim.store();
                mutable long produced = cast<long>(0);
                mutable long consumed = cast<long>(0);
                mutable int kindsProduced = 0;
                mutable int good = 0;
                while (good < st.goods()) {
                    long p = st.producedOf(good);
                    produced = produced + p;
                    consumed = consumed + st.consumedOf(good);
                    if (p > cast<long>(0)) {
                        kindsProduced = kindsProduced + 1;
                    }
                    good = good + 1;
                }
                Test.checking("goods were produced during the arc");
                Test.assertTrue(produced > cast<long>(0));
                Test.checking("goods were consumed during the arc");
                Test.assertTrue(consumed > cast<long>(0));
                // A world where only firewood is ever made is a world with one profession working.
                Test.checking("more than a handful of distinct goods are made");
                Test.assertAtLeast(kindsProduced, 5);
                return;
            }

            // No community may hold a negative amount of anything. A negative store is the shape a
            // take/add mismatch takes, and it is silent until something divides by it.
            [Tag(name: "sim")]
            [Test]
            public static method no_store_holds_a_negative_amount() returns void {
                Stores* st = Arc.sim.store();
                mutable int worstComm = 0 - 1;
                mutable int worstGood = 0 - 1;
                mutable int worstAmt = 0;
                mutable int comm = 0;
                while (comm < st.communities()) {
                    mutable int good = 0;
                    while (good < st.goods()) {
                        int amt = st.amountOf(comm, good);
                        if (amt < worstAmt) {
                            worstAmt = amt;
                            worstComm = comm;
                            worstGood = good;
                        }
                        good = good + 1;
                    }
                    comm = comm + 1;
                }
                if (worstAmt < 0) {
                    Test.fail($"community {worstComm} holds {worstAmt} of good {worstGood}");
                }
                Test.checking("every stock is zero or positive");
                Test.assertAtLeast(worstAmt, 0);
                return;
            }

            // People build. A world with no buildings after two generations means the build loop
            // never fires, which is invisible from the population figure.
            [Tag(name: "sim")]
            [Test]
            public static method people_build_and_the_buildings_are_used() returns void {
                Buildings* town = Arc.sim.buildings();
                Test.checking("buildings were raised during the arc");
                Test.assertAtLeast(town.count(), 10);
                Test.checking("and the buildings stay inside the table");
                Test.assertAtMost(town.count(), town.limit());
                Test.checking("some of them are working, not all half-built");
                Test.assertAtLeast(town.working(), 1);
                return;
            }

            // Every standing building belongs to a real community and sits on the map.
            [Tag(name: "sim")]
            [Test]
            public static method every_building_is_somewhere_real() returns void {
                Buildings* town = Arc.sim.buildings();
                Stores* st = Arc.sim.store();
                mutable int offMap = 0;
                mutable int badOwner = 0;
                mutable int i = 0;
                while (i < town.count()) {
                    if (!town.isGone(i)) {
                        int x = town.xAt(i);
                        int y = town.yAt(i);
                        if (x < 0 || y < 0 || x >= 2560 || y >= 1440) {
                            offMap = offMap + 1;
                        }
                        int o = town.ownerOf(i);
                        if (o < 0 || o >= st.communities()) {
                            badOwner = badOwner + 1;
                        }
                    }
                    i = i + 1;
                }
                Test.checking("no building stands off the map");
                Test.assertEqual(offMap, 0);
                Test.checking("every building belongs to a real community");
                Test.assertEqual(badOwner, 0);
                return;
            }

            // Industry scales with how big a place is.
            //
            // This was red for the whole life of the project and marked [ExpectedToFail], because
            // a place could hold exactly one building of each kind: a town of eight hundred got one
            // bakery, the same as a hamlet of forty, and the only way the world got more industry
            // was by getting more villages. Three replacements for the cap were measured over
            // twenty-generation arcs and all three were worse, because every one of them left the
            // SCORING alone -- a building's worth was the abundance of its input, and abundance is
            // not want.
            //
            // With worth read as unmet want the cap came off, and this went green by itself: the
            // suite reported "expected to fail but passed; the annotation is now a lie", which is
            // exactly what an expected failure is for.
            [Tag(name: "sim")]
            [Test]
            public static method a_big_place_builds_more_of_a_kind_than_a_small_one() returns void {
                Buildings* town = Arc.sim.buildings();
                // Does any community hold two WORKSHOPS of one kind? Housing is excluded on
                // purpose: a village has many huts and that has never been the question. The first
                // version of this test forgot to exclude them, and the [ExpectedToFail] annotation
                // reported "expected to fail but passed" -- which is precisely what it is for.
                mutable int pairs = 0;
                mutable int i = 0;
                while (i < town.count()) {
                    if (!town.isGone(i) && town.isWorking(i) && Builds.produces(town.kindOf(i))) {
                        mutable int j = i + 1;
                        while (j < town.count()) {
                            if (!town.isGone(j) && town.isWorking(j)
                                && town.ownerOf(j) == town.ownerOf(i)
                                && town.kindOf(j) == town.kindOf(i)) {
                                pairs = pairs + 1;
                                j = town.count();
                            } else {
                                j = j + 1;
                            }
                        }
                    }
                    i = i + 1;
                }
                Test.checking("some place has two workshops of one kind");
                Test.assertAtLeast(pairs, 1);
                return;
            }

            // Ground gets claimed. Territory is read from where people are, so an unclaimed world
            // means the majority vote never runs -- or runs and writes nowhere.
            [Tag(name: "sim")]
            [Test]
            public static method the_map_gets_claimed() returns void {
                mutable int owned = 0;
                mutable int y = 0;
                while (y < 1440) {
                    mutable int x = 0;
                    while (x < 2560) {
                        if (Arc.sim.ownerAt(x, y) >= 0) {
                            owned = owned + 1;
                        }
                        x = x + 32;
                    }
                    y = y + 32;
                }
                Test.checking("some of the world belongs to somebody");
                Test.assertAtLeast(owned, 20);
                return;
            }

            // Culture is read from the mix of trades a place practises, so every inhabited community
            // must have a reading, and the readings must stay inside their fixed-point range.
            [Tag(name: "sim")]
            [Test]
            public static method culture_readings_stay_in_range() returns void {
                Stores* st = Arc.sim.store();
                mutable int outOfRange = 0;
                mutable int comm = 0;
                while (comm < st.communities()) {
                    mutable int axis = 0;
                    while (axis < 5) {
                        int v = Arc.sim.cultureOf(comm, axis);
                        if (v < 0 - 1000 || v > 1000) {
                            outOfRange = outOfRange + 1;
                        }
                        axis = axis + 1;
                    }
                    comm = comm + 1;
                }
                Test.checking("every culture axis is inside its fixed-point range");
                Test.assertEqual(outOfRange, 0);
                return;
            }

            // Knowledge advances. An era that never moves means discovery is wired to nothing.
            [Tag(name: "sim")]
            [Test]
            public static method somebody_learns_something() returns void {
                Stores* st = Arc.sim.store();
                mutable int best = 0;
                mutable int comm = 0;
                while (comm < st.communities()) {
                    int e = Arc.sim.eraOf(comm);
                    if (e > best) {
                        best = e;
                    }
                    comm = comm + 1;
                }
                Test.checking("the most advanced community has an era at all");
                Test.assertAtLeast(best, 0);
                return;
            }

            // ---- the nation layer ----
            //
            // A settlement is a place; a nation is who those places answer to. Everything below asks
            // whether the second layer is CONSISTENT with the first, because it is entirely derived
            // from it -- a nation that holds towns nobody lives in, or whose capital is not its
            // biggest town, means the census read the world wrong, and every rank, border and era
            // downstream of that reading is wrong with it.

            [Tag(name: "sim")]
            [Test]
            public static method every_settled_place_answers_to_a_living_nation() returns void {
                Stores* st = Arc.sim.store();
                Nations* realm = Arc.sim.nations();
                mutable int orphans = 0;
                mutable int comm = 0;
                while (comm < st.communities()) {
                    if (Arc.sim.populationOf(comm) > 0) {
                        int nat = Arc.sim.nationOf(comm);
                        if (nat < 0 || nat >= realm.limit() || !realm.alive(nat)) {
                            orphans = orphans + 1;
                        }
                    }
                    comm = comm + 1;
                }
                Test.checking("no inhabited settlement is stateless");
                Test.assertEqual(orphans, 0);
                Test.checking("and the world has nations in it at all");
                Test.assertAtLeast(realm.living(), 1);
                return;
            }

            // The nation's headcount must be the sum of its towns', because it IS that sum -- it is
            // written by one pass over the settlements and read by everything from discovery to
            // rank. A drift between the two is the census having double-counted or dropped a town.
            [Tag(name: "sim")]
            [Test]
            public static method a_nation_holds_exactly_what_its_towns_hold() returns void {
                Stores* st = Arc.sim.store();
                Nations* realm = Arc.sim.nations();
                mutable int[] people = new int[realm.limit()]();
                mutable int[] towns = new int[realm.limit()]();
                mutable int comm = 0;
                while (comm < st.communities()) {
                    int pop = Arc.sim.populationOf(comm);
                    if (pop > 0) {
                        int nat = Arc.sim.nationOf(comm);
                        if (nat >= 0 && nat < realm.limit()) {
                            people[nat] = people[nat] + pop;
                            towns[nat] = towns[nat] + 1;
                        }
                    }
                    comm = comm + 1;
                }
                mutable int wrongPeople = 0;
                mutable int wrongTowns = 0;
                mutable int nat = 0;
                while (nat < realm.limit()) {
                    if (realm.alive(nat)) {
                        if (realm.peopleOf(nat) != people[nat]) {
                            wrongPeople = wrongPeople + 1;
                        }
                        if (realm.townsOf(nat) != towns[nat]) {
                            wrongTowns = wrongTowns + 1;
                        }
                    }
                    nat = nat + 1;
                }
                delete people;
                delete towns;
                Test.checking("every nation's headcount is the sum of its towns'");
                Test.assertEqual(wrongPeople, 0);
                Test.checking("and its holdings are the towns that answer to it");
                Test.assertEqual(wrongTowns, 0);
                return;
            }

            // Nobody chooses a capital: it is whichever town is biggest, so that a seat overtaken by
            // one of its own colonies moves rather than a country being permanently run from a
            // village that stopped mattering.
            [Tag(name: "sim")]
            [Test]
            public static method the_capital_is_the_biggest_town() returns void {
                Stores* st = Arc.sim.store();
                Nations* realm = Arc.sim.nations();
                mutable int wrong = 0;
                mutable int nat = 0;
                while (nat < realm.limit()) {
                    if (realm.alive(nat)) {
                        int seat = realm.seatOf(nat);
                        if (seat < 0) {
                            wrong = wrong + 1;
                        } else {
                            int held = Arc.sim.populationOf(seat);
                            mutable int comm = 0;
                            while (comm < st.communities()) {
                                if (Arc.sim.nationOf(comm) == nat
                                    && Arc.sim.populationOf(comm) > held) {
                                    wrong = wrong + 1;
                                    comm = st.communities();
                                } else {
                                    comm = comm + 1;
                                }
                            }
                        }
                    }
                    nat = nat + 1;
                }
                Test.checking("no nation is seated anywhere but its largest town");
                Test.assertEqual(wrong, 0);
                return;
            }

            // Rank is read, never set. A kingdom that does not hold three towns, or a band with a
            // ruler sitting in it, means the ladder has come loose from the state it is read from.
            [Tag(name: "sim")]
            [Test]
            public static method rank_matches_what_a_nation_actually_holds() returns void {
                Nations* realm = Arc.sim.nations();
                mutable int broken = 0;
                mutable int nat = 0;
                while (nat < realm.limit()) {
                    if (realm.alive(nat)) {
                        int r = realm.rankOf(nat);
                        boolean led = realm.rulerOf(nat) >= 0;
                        if (r == cast<int>(Rank.Band) && led) {
                            broken = broken + 1;
                        }
                        if (r != cast<int>(Rank.Band) && !led) {
                            broken = broken + 1;
                        }
                        if (r >= cast<int>(Rank.Kingdom) && realm.townsOf(nat) < 3) {
                            broken = broken + 1;
                        }
                        if (r == cast<int>(Rank.Empire) && realm.takenBy(nat) < 1) {
                            broken = broken + 1;
                        }
                    }
                    nat = nat + 1;
                }
                Test.checking("no nation is at a rank its holdings do not support");
                Test.assertEqual(broken, 0);
                return;
            }

            // Knowledge belongs to the nation, so a colony founded this morning builds what the
            // kingdom that sent it knows how to build -- and, the half that can actually go wrong,
            // NOTHING anywhere is built from a menu its owner has not earned. A standing building
            // whose era outranks its nation's is the era gate reading the wrong layer, which is
            // exactly the defect that moving knowledge up here could have introduced.
            [Tag(name: "sim")]
            [Test]
            public static method nobody_builds_above_their_nation_era() returns void {
                Buildings* town = Arc.sim.buildings();
                Nations* realm = Arc.sim.nations();
                mutable int ahead = 0;
                mutable int i = 0;
                while (i < town.count()) {
                    if (!town.isGone(i)) {
                        int owner = town.ownerOf(i);
                        int nat = Arc.sim.nationOf(owner);
                        if (nat >= 0 && Builds.era(town.kindOf(i)) > realm.eraOf(nat)) {
                            ahead = ahead + 1;
                        }
                    }
                    i = i + 1;
                }
                Test.checking("no building stands that its nation does not know how to raise");
                Test.assertEqual(ahead, 0);
                Test.checking("and nobody has climbed past the last rung");
                Test.assertAtMost(realm.bestEra(), 4);
                return;
            }

            // Whatever is in the field at the end of an arc has to be coherent. Two generations is
            // rarely long enough for anybody to reach the rank that lets them campaign, so most runs
            // pass these vacuously -- and that is fine: the day one of them does not is the day a
            // real defect shows up, which is the only thing an invariant is for. What must never
            // happen is an army with no head, or a country besieging itself.
            [Tag(name: "sim")]
            [Test]
            public static method no_army_is_leaderless_or_at_war_with_itself() returns void {
                Armies* host = Arc.sim.armies();
                AgentTable* folk = Arc.folk;
                mutable int headless = 0;
                mutable int civilWar = 0;
                mutable int aimless = 0;
                mutable int a = 0;
                while (a < host.limit()) {
                    if (host.alive(a)) {
                        int lead = host.generalOf(a);
                        if (lead < 0 || !folk.alive(lead)) {
                            headless = headless + 1;
                        }
                        int t = host.targetOf(a);
                        if (t < 0) {
                            aimless = aimless + 1;
                        } else if (Arc.sim.nationOf(t) == host.nationOf(a)) {
                            civilWar = civilWar + 1;
                        }
                    }
                    a = a + 1;
                }
                Test.checking("every army in the field has somebody at the head of it");
                Test.assertEqual(headless, 0);
                Test.checking("and something it is going for");
                Test.assertEqual(aimless, 0);
                Test.checking("and nobody is besieging their own country");
                Test.assertEqual(civilWar, 0);
                return;
            }

            // The border moved and nothing else did. A conquered town keeps its people and keeps its
            // language, so the ONLY way `held` is set on a place is if that place still exists and
            // still disagrees with the flag over it -- the disagreement being the whole point.
            [Tag(name: "sim")]
            [Test]
            public static method a_town_taken_by_force_still_has_its_own_people() returns void {
                Nations* realm = Arc.sim.nations();
                mutable int emptied = 0;
                mutable int alreadyTheirs = 0;
                mutable int c = 0;
                while (c < Arc.sim.communityCount()) {
                    if (Arc.sim.heldOf(c) > 0) {
                        if (Arc.sim.populationOf(c) <= 0) {
                            emptied = emptied + 1;
                        }
                        int nat = Arc.sim.nationOf(c);
                        if (nat >= 0 && Arc.sim.tongueOf(c) == realm.tongueOf(nat)) {
                            alreadyTheirs = alreadyTheirs + 1;
                        }
                    }
                    c = c + 1;
                }
                Test.checking("nobody was displaced by a conquest");
                Test.assertEqual(emptied, 0);
                Test.checking("and a town still being held has not already been won over");
                Test.assertEqual(alreadyTheirs, 0);
                // Books have to balance: every town flying somebody else's flag was taken by
                // somebody, and every one that stopped was either won over or broke away.
                Test.checking("no more towns were converted or revolted than were ever taken");
                Test.assertAtMost(cast<int>(Arc.sim.convertCount() + Arc.sim.revoltCount()),
                                  cast<int>(Arc.sim.conquestCount()));
                return;
            }

            // Nobody holds two of the three. A village has a chief, an elder and a priest, and if
            // one person could be two of them the roles would be a label on whoever happened to
            // have the most standing rather than three different things a place needs.
            [Tag(name: "sim")]
            [Test]
            public static method the_three_standings_are_three_people() returns void {
                AgentTable* folk = Arc.folk;
                mutable int doubled = 0;
                mutable int stranded = 0;
                mutable int seated = 0;
                mutable int c = 0;
                while (c < Arc.sim.communityCount()) {
                    int lead = Arc.sim.chiefOf(c);
                    int old = Arc.sim.elderOf(c);
                    int holy = Arc.sim.priestOf(c);
                    int cart = Arc.sim.tradeChiefOf(c);
                    // A role-holder who DIED since the last census is not checked for where they
                    // live: the seat is re-read every census and the next one clears it, so a dead
                    // elder is a state the world holds for under a second. What must never happen
                    // is a LIVING one standing for a place they do not live in -- that would be the
                    // seat surviving a move, which nothing re-reads would ever fix.
                    if (old >= 0) {
                        seated = seated + 1;
                        if (old == lead || old == holy || old == cart) {
                            doubled = doubled + 1;
                        }
                        if (folk.alive(old) && folk.homeOf(old) != c) {
                            stranded = stranded + 1;
                        }
                    }
                    if (holy >= 0) {
                        seated = seated + 1;
                        if (holy == lead || holy == cart) {
                            doubled = doubled + 1;
                        }
                        if (folk.alive(holy) && folk.homeOf(holy) != c) {
                            stranded = stranded + 1;
                        }
                    }
                    if (cart >= 0) {
                        seated = seated + 1;
                        if (cart == lead) {
                            doubled = doubled + 1;
                        }
                        if (folk.alive(cart) && folk.homeOf(cart) != c) {
                            stranded = stranded + 1;
                        }
                    }
                    c = c + 1;
                }
                Test.checking("somebody is standing in one of the three roles at all");
                Test.assertAtLeast(seated, 1);
                Test.checking("nobody holds two of them");
                Test.assertEqual(doubled, 0);
                Test.checking("and nobody living stands for a place they do not live in");
                Test.assertEqual(stranded, 0);
                return;
            }

            // A caravan runs inside one country. Sending a load to a neighbour would be trade with
            // a foreign power, which is a different thing entirely and is not what this models --
            // if a route ever crossed a border it would be a bug in who-answers-to-whom, not a
            // feature nobody asked for.
            [Tag(name: "sim")]
            [Test]
            public static method every_route_runs_inside_one_country() returns void {
                mutable int foreign = 0;
                mutable int empty = 0;
                mutable int routes = 0;
                mutable int c = 0;
                while (c < Arc.sim.communityCount()) {
                    int to = Arc.sim.caravanFrom(c);
                    if (to >= 0) {
                        routes = routes + 1;
                        if (Arc.sim.nationOf(to) != Arc.sim.nationOf(c)) {
                            foreign = foreign + 1;
                        }
                        if (to == c || Arc.sim.populationOf(to) <= 0) {
                            empty = empty + 1;
                        }
                        if (Arc.sim.cargoFrom(c) <= 0) {
                            empty = empty + 1;
                        }
                    }
                    c = c + 1;
                }
                Test.checking("somebody is carrying something somewhere");
                Test.assertAtLeast(routes, 1);
                Test.checking("no route crosses a border");
                Test.assertEqual(foreign, 0);
                Test.checking("and none goes nowhere or carries nothing");
                Test.assertEqual(empty, 0);
                return;
            }

            // Somebody, somewhere, has put something between themselves and their neighbours.
            //
            // This is here because the whole wall scoring was DEAD CODE for a wave and nothing
            // noticed: the kind loop skipped anything `staffed` said was not a workshop, and a wall
            // makes nothing, so every palisade in the catalogue was thrown out one line before the
            // block written to score it. A twenty-generation arc had thirty-four towns stormed and
            // not one wall standing anywhere in the world, and every test still passed.
            //
            // Raiding is universal in this world -- villages fall out with their neighbours in the
            // first generation -- so a world with no wall in it at all means the rule is unreachable
            // again rather than that nobody happened to want one.
            [Tag(name: "sim")]
            [Test]
            public static method somebody_has_built_a_wall() returns void {
                Buildings* town = Arc.sim.buildings();
                mutable int walls = 0;
                mutable int i = 0;
                while (i < town.count()) {
                    if (!town.isGone(i) && Builds.wall(town.kindOf(i)) > 0) {
                        walls = walls + 1;
                    }
                    i = i + 1;
                }
                Test.checking("at least one wall stands in the world");
                Test.assertAtLeast(walls, 1);
                return;
            }

            // A HARBOUR IS ONLY WORTH PLANKS IF IT REACHES SOMEBODY.
            //
            // Three things have to hold together or the whole sea slice is decoration. A harbour has
            // to stand somewhere; it has to stand ON THE COAST, because a jetty on a lake reaches
            // nobody and Ground.Coast exists for exactly that; and a route has to cross a border,
            // because overland every caravan goes to a town under the same flag BY CONSTRUCTION --
            // so a foreign destination can only have come over water.
            //
            // The third is the one that matters. It is the first thing two countries in this world
            // ever do to each other that is not a war.
            //
            // RED ON TIME, NOT ON TRUTH -- and the difference matters, so read this before deleting
            // either the test or the annotation.
            //
            // The sea WORKS. Measured over twenty generations on seed 42: forty-nine harbours,
            // thirteen shipwrights, one thousand seven hundred and fifty-nine boats in sixteen
            // towns of a good that did not exist, and twelve routes whose far end flies another
            // flag. What it took was three fixes, and the last one was the real one: FLAG_COAST had
            // been declared since the grid was written and set NOWHERE, so no cell in any world was
            // ever coast and a quay could not be sited however badly a town wanted one.
            //
            // This fixture is TWO generations. A harbour needs a people to reach the second era,
            // build a ropewalk, make rope and still be cut off by land, and two generations is not
            // enough for that chain however correct it is. So this stays [ExpectedToFail] as a
            // marker of a timescale, not of a defect -- and it is honest about which. What is owed
            // is a longer sim fixture; until then the arc report is where the sea is checked.
            [Tag(name: "sim")]
            [ExpectedToFail]
            [Test]
            public static method the_sea_is_a_road_between_countries() returns void {
                Buildings* town = Arc.sim.buildings();
                Grid* g = Arc.world;
                mutable int harbours = 0;
                mutable int inland = 0;
                mutable int i = 0;
                while (i < town.count()) {
                    if (!town.isGone(i) && Builds.port(town.kindOf(i)) > 0) {
                        harbours = harbours + 1;
                        if (!g.hasFlag(town.xAt(i), town.yAt(i), Grid.FLAG_COAST)) {
                            inland = inland + 1;
                        }
                    }
                    i = i + 1;
                }
                Test.checking("somebody has built a harbour");
                Test.assertAtLeast(harbours, 1);
                Test.checking("and not one of them stands away from the sea");
                Test.assertEqual(inland, 0);
                Test.checking("the towns holding one agree with the count");
                Test.assertAtLeast(Arc.sim.portCount(), 1);
                Test.checking("goods reach a town under another flag");
                Test.assertAtLeast(Arc.sim.foreignRoutes(), 1);
                return;
            }

            // A PLACE THAT CANNOT DRINK DIGS.
            //
            // Water was the largest thing in this catalogue that did not exist: six meshes cut for
            // it, not one kind behind them, and a person who drinks every day of a six-minute life
            // with nothing anywhere to say so. It is shaped like the roof and not like a workshop,
            // because a well makes room for people rather than a good.
            //
            // What this asserts is the ASYMMETRY, which is the whole reason to have the line. A
            // village on a river never enters the decision; a village on dry ground answers it
            // every census until it has dug enough. If every place in the world has a river at hand
            // then the ground costs nothing and the line is decoration -- so the test wants dry
            // places to exist AND to have done something about it.
            [Tag(name: "sim")]
            [Test]
            public static method dry_ground_costs_something() returns void {
                Buildings* town = Arc.sim.buildings();
                mutable int works = 0;
                mutable int i = 0;
                while (i < town.count()) {
                    if (!town.isGone(i) && Builds.water(town.kindOf(i)) > 0) {
                        works = works + 1;
                    }
                    i = i + 1;
                }
                Test.checking("somebody has sunk a well or raised a catcher");
                Test.assertAtLeast(works, 1);
                Test.checking("and the sites for them were marked by the water decision");
                Test.assertAtLeast(cast<int>(Arc.sim.waterworksMarked()), 1);
                // Not every place: a world where nobody is ever short of water has no geography in
                // it, and a world where everybody is for ever means the answer never arrives.
                Test.checking("being short of water is a condition some places are in, not all");
                Test.assertAtMost(Arc.sim.thirstyCount(), Arc.sim.communityCount());
                return;
            }

            // ARMOUR FINALLY MEANS SOMETHING.
            //
            // Three hundred suits of mail were forged in a measured arc and changed nothing, because
            // every fight in this world was a headcount and a headcount cannot tell one man from
            // another. What a soldier is is now read off what he carries -- levy, armed, mailed --
            // the same way a chief is read off who is listened to, and for the same reason: at six
            // minutes a life a stored rank is wrong within the minute.
            [Tag(name: "sim")]
            [Test]
            public static method a_man_is_worth_what_he_carries() returns void {
                mutable int bare = 0 - 1;
                mutable int kitted = 0 - 1;
                mutable int i = 0;
                while (i < Arc.folk.limit()) {
                    if (Arc.folk.alive(i)) {
                        if (kitted < 0 && Arc.folk.hasKit(i, AgentTable.K_WEAPON)) {
                            kitted = i;
                        }
                        if (bare < 0 && !Arc.folk.hasKit(i, AgentTable.K_WEAPON)) {
                            bare = i;
                        }
                    }
                    i = i + 1;
                }
                Test.checking("somebody unarmed is walking around, and weighs a levy's worth");
                Test.assertTrue(bare >= 0);
                Test.assertEqual(Arc.sim.mettleOf(bare), 1);
                // Conditional on the world having got there, the way the ore test is: a weapon is
                // the far end of the metal chain and two generations is not enough to reach it,
                // while a twenty-generation arc is. Asserting it flatly would report a defect that
                // is a timescale, and reaching for the index anyway is how the first version of
                // this test panicked on mettleOf(-1).
                if (kitted >= 0) {
                    Test.checking("and an armed man weighs more than he does");
                    Test.assertTrue(Arc.sim.mettleOf(kitted) > Arc.sim.mettleOf(bare));
                }
                return;
            }

            // A BAD PLACE TO LIVE IS A PLACE PEOPLE DIE IN.
            //
            // Hunger, tiredness, fear and loneliness are the body's own clocks and everybody in this
            // world has them. Sickness was the missing one: the thing that comes from OUTSIDE, from
            // what a town has done to itself -- too many people in too few rooms, and water nobody
            // cleaned. It is the only thing here that kills somebody who is doing everything right.
            //
            // So what this asserts is the LINK, not the corpses. Filth has to be a real number
            // somewhere and illness has to follow it; a world where everybody is ill regardless of
            // where they live has a disease that is weather, and a world where nobody ever is has a
            // system that is decoration.
            [Tag(name: "sim")]
            [Test]
            public static method a_crowded_town_makes_people_ill() returns void {
                mutable int filthiest = 0;
                for (int c in 0..Arc.sim.communityCount()) {
                    if (Arc.sim.filthOf(c) > filthiest) {
                        filthiest = Arc.sim.filthOf(c);
                    }
                }
                Test.checking("somewhere in the world is a hard place to stay well");
                Test.assertAtLeast(filthiest, 1);
                Test.checking("and somebody has taken ill there");
                Test.assertTrue(Arc.sim.tookIll() > cast<long>(0));
                // Not everybody: illness that everybody catches is weather, not a condition of a
                // place. Two generations is short, so this is a ceiling rather than a band.
                Test.checking("without carrying off the whole world");
                Test.assertTrue(Arc.sim.deathsFromIllness() < cast<long>(Arc.PEOPLE()));
                return;
            }

            // THE YEAR TURNS, AND THE LAND KNOWS IT.
            //
            // This world had no seasons: food was as easy in one second as in any other, so a
            // granary was somewhere to put a surplus rather than the thing that gets a village
            // through to spring, and the whole reason for storing anything was missing.
            //
            // One sun, so it is the same number everywhere at once -- a famine is something that
            // happens to everybody together, which is what makes trade between countries worth
            // having rather than an arbitrage nobody would notice.
            [Tag(name: "sim")]
            [Test]
            public static method the_year_turns() returns void {
                Test.checking("the land yields somewhere between a hard winter and a harvest");
                Test.assertBetween(Arc.sim.season(), 40, 160);
                Test.checking("and the arc was long enough to have seen a lean time");
                Test.assertAtMost(Arc.sim.leanestSeason(), 120);
                Test.checking("which never went to nothing -- a bad year is not the end of the world");
                Test.assertAtLeast(Arc.sim.leanestSeason(), 40);
                return;
            }

            // EVERY VERB IN THE ENUM IS ONE SOMEBODY ACTUALLY PERFORMS.
            //
            // Twelve of the twenty-two were dead: eating, resting, tilling, fleeing, courting,
            // raising a child, carrying a load, depositing it, following, leading, discovering and
            // teaching were all things the simulation DID and never recorded as a state anybody
            // could be in. The renderer cannot draw a verb nothing sets, so this world had people
            // who worked and fought and never once sat down to eat -- nine and a half million meals
            // and not one of them visible.
            //
            // Asked on the running total rather than a snapshot, because a two-second act is rarely
            // caught mid-frame however common it is. An act nobody has performed ONCE in two
            // generations is an act that is unreachable, not one that is merely rare.
            [Tag(name: "sim")]
            [Test]
            public static method every_verb_is_one_somebody_does() returns void {
                mutable int dead = 0;
                for (int a in 0..Act.count()) {
                    if (Arc.sim.everDid(a) <= cast<long>(0)) {
                        System.IO.Console.println($"    nobody has ever performed act {a}");
                        dead = dead + 1;
                    }
                }
                Test.checking("no verb in the enum is one nobody in the world ever performs");
                Test.assertEqual(dead, 0);
                return;
            }

            // The frame budget is the whole design: constant cost per frame, more frames when there
            // is more to do. A worst frame far above the budget means something is asking a question
            // per person per decision again.
            [Tag(name: "sim")]
            [Test]
            public static method the_frame_budget_holds() returns void {
                Test.checking("the worst frame stayed within a sane multiple of the budget");
                Test.assertAtMost(Arc.sim.worstFrame(), 200000);
                return;
            }

            // BOTH HALVES OF A MECHANISM HAVE TO BE REACHABLE.
            //
            // This codebase has shipped an unreachable threshold twice -- hunger that could kill at
            // a hundred points when the most anybody reached in a life was fifty-one, and an
            // illness that made five hundred and forty-five thousand people sick and killed exactly
            // one -- and both times the counter read a number that looked like an answer. So a new
            // mechanism gets asked the one question that catches that: does each side of it ever
            // happen?
            //
            // Theft needs a hungry person, a bare shelf at home, a reachable neighbour with food,
            // and a roll against that neighbour's watch. Being SEEN needs all of that plus a town
            // that built something to see with. If either number is nought after two generations,
            // the mechanism is decoration.
            [Tag(name: "sim")]
            [Test]
            public static method both_halves_of_crime_are_reachable() returns void {
                Test.checking("hunger drives somebody to a neighbour's shelf");
                Test.assertAtLeast(cast<int>(Arc.sim.crimesTried()), 1);
                Test.checking("and some of them get away with it");
                Test.assertAtLeast(cast<int>(Arc.sim.theftsDone()), 1);
                Test.checking("and some of them are seen");
                Test.assertAtLeast(cast<int>(Arc.sim.thievesCaught()), 1);
                Test.checking("nobody both gets away with it and is caught");
                Test.assertAtMost(cast<int>(Arc.sim.theftsDone())
                                  + cast<int>(Arc.sim.thievesCaught()),
                                  cast<int>(Arc.sim.crimesTried()));
                return;
            }

            // A CALAMITY SOMEBODY AIMED IS THE SAME CALAMITY.
            //
            // The player gets to fire one, and the whole value of that is that it goes through the
            // same door the ground does: the same effects, the same counters, the same quiet
            // afterwards. A hazard that behaves differently when a person aims it is two hazards
            // wearing one name, and the report would stop meaning anything.
            //
            // It lives in THIS class because it touches the arc's simulation, and a test that reads
            // another class's fixture is reading a pointer that class may already have freed --
            // which is exactly what the first draft of this did, and it took the whole suite down
            // with an access violation. The compiler warns about that now; I wrote the warning this
            // morning and then walked into it anyway.
            [Tag(name: "sim")]
            [Test]
            public static method a_calamity_somebody_aimed_is_the_same_calamity() returns void {
                int before = Arc.sim.disastersSeen();
                int town = Arc.sim.busiestTown();
                Test.checking("the world has a town to aim at");
                Test.assertAtLeast(town, 0);

                Test.checking("an aimed fire lands");
                Test.assertTrue(Arc.sim.strike(town, cast<int>(Calamity.Fire)));
                Test.checking("and it is counted exactly like one the world chose");
                Test.assertEqual(Arc.sim.disastersSeen(), before + 1);

                Test.checking("aiming at nowhere does nothing");
                Test.assertTrue(!Arc.sim.strike(0 - 1, cast<int>(Calamity.Fire)));
                Test.checking("and neither does aiming nothing at somewhere");
                Test.assertTrue(!Arc.sim.strike(town, cast<int>(Calamity.Nothing)));
                Test.checking("and neither of those was counted");
                Test.assertEqual(Arc.sim.disastersSeen(), before + 1);
                return;
            }

            // AN OFFICE IS HANDED ON, and not merely vacated and refilled from nowhere.
            //
            // A chief dies every few minutes at six minutes a life, so a two-generation arc has
            // hundreds of successions in it. Clearing the seat at the moment of death -- correct in
            // itself -- once threw away the fact that there HAD been a holder, and the whole world
            // silently switched to "nobody was in charge, somebody rose", which is a different
            // world: no line can descend through it and no dynasty can exist. It took a number in a
            // twenty-minute report to notice. This is that number, asked in four minutes.
            [Tag(name: "sim")]
            [Test]
            public static method a_seat_is_handed_on_and_not_merely_emptied() returns void {
                Test.checking("chiefs die and the office passes to somebody");
                Test.assertAtLeast(cast<int>(Arc.sim.handedOn()), 1);
                Test.checking("and the count of those is not larger than the successions there were");
                Test.assertAtMost(cast<int>(Arc.sim.handedToASon()),
                                  cast<int>(Arc.sim.handedOn()));
                return;
            }

            // NOBODY HOLDS AN OFFICE THEY ARE NOT ALIVE FOR.
            //
            // Every death in this world vacates the offices the dead held -- old age, hunger,
            // illness and the ground all did. War did not: a chief cut down at his own gate stayed
            // chief, and his row went straight back on the free list, so the next child born into
            // the world inherited the chieftaincy at the age of nought. This is the invariant that
            // says so, and it is checked over the whole world rather than by contriving a death.
            [Tag(name: "sim")]
            [Test]
            public static method an_office_is_held_by_somebody_alive() returns void {
                mutable int ghosts = 0;
                mutable int children = 0;
                for (int c in 0..Arc.sim.communityCount()) {
                    int chief = Arc.sim.chiefOf(c);
                    int elder = Arc.sim.elderOf(c);
                    int priest = Arc.sim.priestOf(c);
                    int trader = Arc.sim.tradeChiefOf(c);
                    if (chief >= 0 && !Arc.folk.alive(chief)) {
                        ghosts = ghosts + 1;
                    }
                    if (elder >= 0 && !Arc.folk.alive(elder)) {
                        ghosts = ghosts + 1;
                    }
                    if (priest >= 0 && !Arc.folk.alive(priest)) {
                        ghosts = ghosts + 1;
                    }
                    if (trader >= 0 && !Arc.folk.alive(trader)) {
                        ghosts = ghosts + 1;
                    }
                    if (chief >= 0 && Arc.folk.alive(chief) && !Arc.folk.isAdult(chief)) {
                        children = children + 1;
                    }
                }
                Test.checking("no village answers to somebody who is dead");
                Test.assertEqual(ghosts, 0);
                Test.checking("and no village answers to a child");
                Test.assertEqual(children, 0);
                return;
            }
        }

        // WHAT THE WORLD DOES WITHOUT BEING ASKED.
        //
        // Fates is asked questions here directly rather than through an arc, because what needs
        // pinning is the SHAPE of the rule and not the weather of one century: a place standing on
        // nothing in particular is only ever visited by fire, a place that has dug wells burns less
        // often than one that has not, and a place that has just been struck is left alone for a
        // while. None of the three is visible in a two-generation run, and all three are the
        // difference between a hazard and a random number.
        public class Calamities {

            // `spans` censuses of one place, counting what found it. An arc is about seven thousand
            // censuses, so a few hundred thousand here is a handful of centuries -- which is what an
            // eruption is measured in and a fire is not.
            private static method centuryOf(boolean vent, boolean shaky, boolean river,
                                            boolean coast, int homes, int wells,
                                            int want, int spans) returns int {
                Fates fates = new Fates(4) on stack;
                mutable int seen = 0;
                for (int t in 0..spans) {
                    int kind = fates.visit(1, vent, shaky, river, coast, homes, wells, 42, t);
                    if (kind == want) {
                        seen = seen + 1;
                    }
                }
                return seen;
            }

            [Tag(name: "sim")]
            [Test]
            public static method the_ground_you_stand_on_is_the_hazard_you_get() returns void {
                Test.checking("a town on flat dry ground is never buried by a mountain");
                Test.assertEqual(Calamities.centuryOf(false, false, false, false, 40, 0,
                                                      cast<int>(Calamity.Eruption), 200000), 0);
                Test.checking("nor shaken by ground that does not move");
                Test.assertEqual(Calamities.centuryOf(false, false, false, false, 40, 0,
                                                      cast<int>(Calamity.Quake), 200000), 0);
                Test.checking("nor flooded by a river it has not got");
                Test.assertEqual(Calamities.centuryOf(false, false, false, false, 40, 0,
                                                      cast<int>(Calamity.Flood), 200000), 0);
                Test.checking("but a town under a volcano does get buried, given long enough");
                Test.assertAtLeast(Calamities.centuryOf(true, false, false, false, 40, 0,
                                                        cast<int>(Calamity.Eruption), 200000), 1);
                return;
            }

            // The knot the whole water layer is tied with: a well was dug because people were
            // thirsty, and the town that dug it also does not burn down. Nobody had to be told.
            [Tag(name: "sim")]
            [Test]
            public static method a_town_with_water_burns_less() returns void {
                int dry = Calamities.centuryOf(false, false, false, false, 120, 0,
                                               cast<int>(Calamity.Fire), 40000);
                int wet = Calamities.centuryOf(false, false, false, false, 120, 6,
                                               cast<int>(Calamity.Fire), 40000);
                Test.checking("a town with no water at all does burn");
                Test.assertAtLeast(dry, 1);
                Test.checking("and one with six cisterns burns less often");
                Test.assertAtMost(wet, dry - 1);
                return;
            }

            // A CALAMITY SOMEBODY AIMED IS THE SAME CALAMITY.
            //
            // The player gets to fire one, and the whole value of that is that it goes through the
            // same door the ground does: the same effects, the same counters, the same quiet
            // afterwards. A hazard that behaves differently when a person aims it is two hazards
            // wearing one name, and the report would stop meaning anything.
            // AN AGE THAT MEANS SOMETHING BETWEEN BEING BORN AND DYING.
            //
            // Age decided exactly two things for the whole life of this project: whether somebody
            // was a child, and when they died. Between those it was a flat line -- an old man felled
            // a tree in the same time as a young one -- and the ELDER, the one role this world hands
            // out for having lived longest, was a title with nothing behind it.
            //
            // The shape is what matters and the shape is what is pinned: a long prime at full
            // speed, then a decline, and NOBODY is ever stopped from working. A village that needs
            // its old people at the harvest still gets them, more slowly, which is the true version
            // and also the kind one.
            [Tag(name: "sim")]
            [Test]
            public static method a_long_life_slows_the_hands() returns void {
                float span = 360.0;
                float young = Simulation.vigourOf(40.0, span);
                float prime = Simulation.vigourOf(200.0, span);
                float ageing = Simulation.vigourOf(300.0, span);
                float ancient = Simulation.vigourOf(355.0, span);

                Test.checking("the young work at full speed");
                Test.assertTrue(young == 1.0);
                Test.checking("and so does somebody in their prime");
                Test.assertTrue(prime == 1.0);
                Test.checking("an ageing worker is slower than one in their prime");
                Test.assertTrue(ageing > prime);
                Test.checking("and the oldest slower still");
                Test.assertTrue(ancient > ageing);
                Test.checking("but nobody is ever stopped -- a life never costs more than half again");
                Test.assertTrue(ancient <= 1.5);
                Test.checking("and a person with no lifespan at all is not divided by nought");
                Test.assertTrue(Simulation.vigourOf(10.0, 0.0) == 1.0);
                return;
            }

            // A place does not lose everything twice in a fortnight. Without the rest, a bad roll
            // is a town wiped off the map -- and a calamity nobody survives is one nobody watches
            // the aftermath of.
            [Tag(name: "sim")]
            [Test]
            public static method a_stricken_place_is_left_alone_for_a_while() returns void {
                Fates fates = new Fates(4) on stack;
                mutable int struckAt = 0 - 1;
                mutable int t = 0;
                while (t < 4000 && struckAt < 0) {
                    if (fates.visit(1, true, true, true, true, 200, 0, 42, t)
                        != cast<int>(Calamity.Nothing)) {
                        struckAt = t;
                    }
                    t = t + 1;
                }
                Test.checking("an exposed place is struck at all");
                Test.assertAtLeast(struckAt, 0);
                mutable int again = 0;
                for (int q in 0..200) {
                    if (fates.visit(1, true, true, true, true, 200, 0, 42, struckAt + 1 + q)
                        != cast<int>(Calamity.Nothing)) {
                        again = again + 1;
                    }
                }
                Test.checking("and then left alone");
                Test.assertEqual(again, 0);
                return;
            }
        }
    }
}
