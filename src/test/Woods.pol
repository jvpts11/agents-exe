import System.IO.Console;
import System.Test.Test;
import Agents.World.GoodId;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.NodeField;
import Agents.World.NodeState;
import Agents.World.Nodes;
import Agents.World.PropNode;
import Agents.World.Harvest;
import Agents.World.ExtractedGood;
program AgentsExe;

// SKIPPED, NOT DELETED (2026-08-12) -- worldgen is closed. `[Ignore]` rather than a comment block so
// the code still COMPILES and a type it names cannot change under it in silence. To bring it back,
// delete the `[Ignore]` lines. The same note, in full, is at the top of `Growth.ldp3`.
//
// WORTH READING BEFORE BRINGING THESE BACK: the second half of this file is about what happens to
// the world when PEOPLE use it -- felling, thinning, regrowth, a worked-out seam. Those are about
// the economy rather than about generation, and when the slices that own them arrive they will want
// the questions here even if they do not want this code.
//
// What the world is made of, and what happens to it when people use it.
//
// The distinction these tests pin is the one the economy rests on: a berry patch and a fishing
// ground are FLOWS and come back on their own; a seam of ore is a STOCK and does not; a forest is
// neither, and gets it wrong in both directions if you model it as either. Before this, wood was a
// stock -- 96% of the world's forest was felled in a single arc and none of it ever returned, so
// every long game ended on a plain.

public bundle Agents {
    public namespace Checks {

        public class Woods {
            private static mutable Grid* world;

            public static method W() returns int {
                return 640;
            }

            public static method H() returns int {
                return 360;
            }

            // A small world: these tests are about the RULE, and the rule does not care how big the
            // map is. A full-size world here would cost 3.7 s per test for nothing.
            [BeforeAll]
            public static method buildASmallWorld() returns void {
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Woods.world = gen.generate(Woods.W(), Woods.H());
                return;
            }

            [AfterAll]
            public static method dropTheWorld() returns void {
                delete Woods.world;
                return;
            }

            // Counts living nodes of one harvest class across the whole field.
            public static method standing(Harvest wantClass) returns int {
                NodeField* f = Woods.world.surface();
                mutable int total = 0;
                mutable int i = 0;
                while (i < f.size()) {
                    int k = f.kindAt(i);
                    if (k > 0 && Nodes.work(k) == wantClass) {
                        total = total + 1;
                    }
                    i = i + 1;
                }
                return total;
            }

            // Fells every tree in the field, the way a very determined century would.
            public static method fellEverything() returns int {
                NodeField* f = Woods.world.surface();
                mutable int felled = 0;
                mutable int i = 0;
                while (i < f.size()) {
                    int k = f.kindAt(i);
                    if (k > 0 && Nodes.work(k) == Harvest.Timber) {
                        // 32767 is the ceiling a node's quantity can hold, so this empties it
                        // whatever the generator put there -- baseQty is a floor, not the amount.
                        f.harvest(i, 32767);
                        felled = felled + 1;
                    }
                    i = i + 1;
                }
                return felled;
            }

            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method the_world_is_born_with_woods_and_seams() returns void {
                Test.checking("the world has timber");
                Test.assertAtLeast(Woods.standing(Harvest.Timber), 100);
                Test.checking("and forage");
                Test.assertAtLeast(Woods.standing(Harvest.Forage), 100);
                Test.checking("and something to mine");
                Test.assertAtLeast(Woods.standing(Harvest.Mine), 1);
                return;
            }

            // Fells every other tree: what a working century actually does to a wood, as opposed to
            // the total wipe below. Seed remains everywhere, so this is the fast path.
            public static method thinTheWoods() returns int {
                NodeField* f = Woods.world.surface();
                mutable int felled = 0;
                mutable int i = 0;
                while (i < f.size()) {
                    int k = f.kindAt(i);
                    if (k > 0 && Nodes.work(k) == Harvest.Timber && i % 2 == 0) {
                        f.harvest(i, 32767);
                        felled = felled + 1;
                    }
                    i = i + 1;
                }
                return felled;
            }

            // The heart of it. A thinned wood grows back, because there is seed standing in it.
            // This is the test that fails against the old model, where a felled tree was gone for
            // good and every long game ended on a plain.
            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method a_thinned_wood_grows_back() returns void {
                NodeField* f = Woods.world.surface();
                int before = Woods.standing(Harvest.Timber);
                int felled = Woods.thinTheWoods();
                Test.checking("the test actually felled trees");
                Test.assertAtLeast(felled, 100);
                int thinned = Woods.standing(Harvest.Timber);
                Test.checking("and the wood really is thinner");
                Test.assertAtMost(thinned, before - felled + 1);

                // Twenty minutes of world time: a tree waits eight sweeps of twenty seconds where
                // there is seed beside it, so this is several regrowth windows.
                mutable int t = 0;
                while (t < 1200) {
                    f.regrow(1.0);
                    t = t + 1;
                }
                int after = Woods.standing(Harvest.Timber);
                Test.checking("the wood is filling back in");
                Test.assertAtLeast(after, thinned + 1);
                // And not instantly: a world where felling costs nothing is a world where the
                // woodcutter is a decoration.
                Test.checking("but it has not simply been restored");
                Test.assertAtMost(after, before);
                return;
            }

            // The other end of the rule: fell the LOT, everywhere, and the land still remembers.
            // Not a dead end -- but it takes about fourteen lifetimes, which is the cost of doing it.
            [Tag(name: "slow")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method even_a_cleared_world_recovers_eventually() returns void {
                NodeField* f = Woods.world.surface();
                int felled = Woods.fellEverything();
                Test.checking("the test actually cleared the world");
                Test.assertAtLeast(felled, 100);
                Test.checking("and nothing at all is left standing");
                Test.assertEqual(Woods.standing(Harvest.Timber), 0);

                mutable int t = 0;
                while (t < 12000) {
                    f.regrow(1.0);
                    t = t + 1;
                }
                Test.checking("wood returns to a world that has none, given long enough");
                Test.assertAtLeast(Woods.standing(Harvest.Timber), 1);
                return;
            }

            // Ore is the other half of the rule, and it is the half that must NOT change: a worked-out
            // seam does not refill on any timescale a person lives through.
            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method a_worked_out_seam_stays_worked_out() returns void {
                NodeField* f = Woods.world.surface();
                mutable int mined = 0;
                mutable int i = 0;
                while (i < f.size()) {
                    int k = f.kindAt(i);
                    if (k > 0 && Nodes.work(k) == Harvest.Mine) {
                        // 32767 is the ceiling a node's quantity can hold, so this empties it
                        // whatever the generator put there -- baseQty is a floor, not the amount.
                        f.harvest(i, 32767);
                        mined = mined + 1;
                    }
                    i = i + 1;
                }
                if (mined == 0) {
                    Test.skip("this small world rolled no metal veins");
                    return;
                }
                mutable int t = 0;
                while (t < 1200) {
                    f.regrow(1.0);
                    t = t + 1;
                }
                Test.checking("the ore is still gone");
                Test.assertEqual(Woods.standing(Harvest.Mine), 0);
                return;
            }

            // A TRADE IS NOT A THING, and this is the test that says so.
            //
            // Every village in the world worked its quarriers hard -- three thousand of them in a
            // measured arc -- and between them they brought home a million and a half units of stone
            // and three thousand of clay, because "quarry" was one word for five different holes in
            // the ground and the nearest of them is a stone quarry three times out of four. Brick is
            // fired clay and a smithy costs twelve brick, so the whole metal half of the world was
            // downstream of that one conflation.
            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method a_trade_brings_home_more_than_one_thing() returns void {
                Test.checking("a quarrier can fetch more than stone");
                Test.assertAtLeast(Nodes.goodsIn(Harvest.Quarry), 2);
                Test.checking("and a miner more than iron");
                Test.assertAtLeast(Nodes.goodsIn(Harvest.Mine), 2);
                mutable boolean clay = false;
                for (int i in 0..Nodes.goodsIn(Harvest.Quarry)) {
                    if (Nodes.goodAt(Harvest.Quarry, i) == ExtractedGood.Clay.index()) {
                        clay = true;
                    }
                }
                Test.checking("clay is one of the things a quarrier can be sent for");
                Test.assertTrue(clay);
                return;
            }

            // The finer map has to agree with the coarser one, or a village walks to a block that
            // has nothing in it. Summing a class's goods over a block must give the class's own
            // count -- which is the invariant that catches a maintenance point somebody forgot when
            // a seam is opened, worked out, or grows back.
            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method the_two_maps_of_the_world_agree() returns void {
                NodeField* f = Woods.world.surface();
                mutable int checked = 0;
                for (int by in 0..f.blockRows()) {
                    for (int bx in 0..f.blockCols()) {
                        for (int k in 1..Harvest.count()) {
                            Harvest hc = cast<Harvest>(k);
                            int whole = f.inBlock(bx, by, hc);
                            mutable int parts = 0;
                            for (int i in 0..Nodes.goodsIn(hc)) {
                                parts = parts + f.inBlockGood(bx, by, Nodes.goodAt(hc, i));
                            }
                            if (whole != parts) {
                                Test.checking($"block {bx},{by} class {hc}: the two maps disagree");
                                Test.assertEqual(parts, whole);
                                return;
                            }
                            if (whole > 0) {
                                checked = checked + 1;
                            }
                        }
                    }
                }
                Test.checking("the check actually looked at blocks with work in them");
                Test.assertAtLeast(checked, 10);
                return;
            }

            // And it still agrees after the world has been used. A worked-out seam and a felled
            // wood both have to come off BOTH maps.
            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method the_two_maps_still_agree_after_a_century() returns void {
                NodeField* f = Woods.world.surface();
                mutable int i = 0;
                while (i < f.size()) {
                    if (f.kindAt(i) > 0 && i % 3 == 0) {
                        f.harvest(i, 32767);
                    }
                    i = i + 1;
                }
                mutable int t = 0;
                while (t < 2400) {
                    f.regrow(1.0);
                    t = t + 1;
                }
                for (int by in 0..f.blockRows()) {
                    for (int bx in 0..f.blockCols()) {
                        for (int k in 1..Harvest.count()) {
                            Harvest hc = cast<Harvest>(k);
                            int whole = f.inBlock(bx, by, hc);
                            mutable int parts = 0;
                            for (int gi in 0..Nodes.goodsIn(hc)) {
                                parts = parts + f.inBlockGood(bx, by, Nodes.goodAt(hc, gi));
                            }
                            if (whole != parts) {
                                Test.checking($"block {bx},{by} class {hc} drifted apart in use");
                                Test.assertEqual(parts, whole);
                                return;
                            }
                        }
                    }
                }
                Test.checking("the two maps still agree after felling and regrowth");
                Test.assertTrue(true);
                return;
            }

            // Counts living nodes yielding one good across the whole field.
            public static method standingGood(GoodId good) returns int {
                NodeField* f = Woods.world.surface();
                mutable int total = 0;
                mutable int i = 0;
                while (i < f.size()) {
                    int k = f.kindAt(i);
                    if (k > 0 && Nodes.gives(k) == good && f.qtyAt(i) > 0) {
                        total = total + 1;
                    }
                    i = i + 1;
                }
                return total;
            }

            // THE GROUND ITSELF, and the three goods that were only ever underneath it.
            //
            // Clay, sand and salt were buried deposits and nothing else, so the only ones in the
            // world sat under a basin waiting to be prospected: eight towns held clay, nine held
            // sand, and salt was never produced anywhere by anybody in twenty generations. Glass is
            // made of sand and brick is fired clay, and a smithy costs twelve brick -- so the metal
            // half of the catalogue was downstream of a good the map declined to place. A riverbank
            // is clay, a beach is sand, and a salt flat is salt; they are not seams and they should
            // never have needed a pick.
            [Tag(name: "world")]
            [Ignore(reason: "worldgen is closed -- see the note at the top of this file")]
            [Test]
            public static method the_bank_and_the_beach_are_worth_something() returns void {
                Test.checking("a riverbank is clay somebody can dig");
                Test.assertAtLeast(Woods.standingGood(ExtractedGood.Clay.index()), 1);
                Test.checking("and a shore is sand");
                Test.assertAtLeast(Woods.standingGood(ExtractedGood.Sand.index()), 1);
                return;
            }
        }

    }
}
