import System.IO.Console;
import System.Test.Test;
import Agents.App.Gear;
program AgentsExe;

// The app's own tools, checked.
//
// The gear is here because its failure mode is a run that reports one speed and goes at another,
// and that is invisible: nothing on screen looks wrong, the numbers in the log are simply about a
// world that ran at a different rate than the label says. This project has already published runs
// that way once.
public bundle Agents {
    public namespace Checks {

        public class App {

            // The number on the key and the gear it selects have to agree in BOTH directions.
            // Two if-ladders kept in step by hand is what this replaced, and this is the property
            // they had to have and nothing checked.
            [Tag(name: "app")]
            [Test]
            public static method a_key_number_and_its_gear_agree_both_ways() returns void {
                Test.assertEqual(Gear.onKey(1).number(), 1);
                Test.assertEqual(Gear.onKey(2).number(), 2);
                Test.assertEqual(Gear.onKey(3).number(), 3);
                Test.assertEqual(Gear.onKey(4).number(), 4);
                Test.assertEqual(Gear.onKey(5).number(), 5);
                Test.assertEqual(Gear.onKey(6).number(), 6);
                return;
            }

            // The six paces, stated. If one of these ever changes, it changes here too and on
            // purpose -- which is the whole reason the pair is written in one place.
            [Tag(name: "app")]
            [Test]
            public static method every_gear_runs_at_the_pace_it_always_has() returns void {
                Test.assertTrue(Gear.One.pace() == 1.0);
                Test.assertTrue(Gear.Two.pace() == 2.0);
                Test.assertTrue(Gear.Three.pace() == 5.0);
                Test.assertTrue(Gear.Four.pace() == 20.0);
                Test.assertTrue(Gear.Five.pace() == 60.0);
                Test.assertTrue(Gear.Six.pace() == 300.0);
                return;
            }

            // A number from a command line or a keyboard is not worth refusing a run over.
            [Tag(name: "app")]
            [Test]
            public static method a_number_outside_the_range_lands_on_the_nearest_gear() returns void {
                Test.assertEqual(Gear.onKey(0).number(), 1);
                Test.assertEqual(Gear.onKey(0 - 7).number(), 1);
                Test.assertEqual(Gear.onKey(99).number(), 6);
                return;
            }
        }
    }
}
