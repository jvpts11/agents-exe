import System.IO.Console;
import System.Test.Test;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.Biomes;
import Agents.People.AgentTable;
program AgentsExe;

// The people themselves, before anything happens to them.
//
// These are cheap: one small world, seeded once, and then questions about the table -- everybody is
// somewhere real, nobody is standing in the sea, the pool hands out each slot once, temperaments
// spread rather than clustering on a default. A defect here is invisible in an arc, because an arc
// papers over a bad start within a generation.

public bundle Agents {
    public namespace Checks {

        public class Folk {
            private static mutable Grid* world;
            private static mutable AgentTable* people;

            public static method W() returns int {
                return 640;
            }

            public static method H() returns int {
                return 360;
            }

            public static method HOW_MANY() returns int {
                return 4000;
            }

            [BeforeAll]
            public static method seedThem() returns void {
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                Folk.world = gen.generate(Folk.W(), Folk.H());
                Folk.people = new AgentTable(Folk.HOW_MANY()) on heap;
                Folk.people.seedWorld(Folk.world, Folk.HOW_MANY(), 20, 42);
                return;
            }

            [AfterAll]
            public static method dropThem() returns void {
                delete Folk.people;
                delete Folk.world;
                return;
            }

            [Tag(name: "people")]
            [Test]
            public static method the_world_gets_the_people_it_asked_for() returns void {
                Test.checking("the table filled up");
                Test.assertAtLeast(Folk.people.count(), Folk.HOW_MANY() / 2);
                Test.checking("and did not overflow its capacity");
                Test.assertAtMost(Folk.people.count(), Folk.people.capacity());
                return;
            }

            // Everybody is on land they can stand on. A person seeded into the sea is a person who
            // will spend their life failing to path anywhere, and the symptom shows up three
            // subsystems away as "movement is slow".
            [Tag(name: "people")]
            [Test]
            public static method everybody_is_standing_somewhere_they_could_stand() returns void {
                mutable int offMap = 0;
                mutable int inTheSea = 0;
                mutable int i = 0;
                while (i < Folk.people.capacity()) {
                    if (Folk.people.alive(i)) {
                        int x = cast<int>(Folk.people.xAt(i));
                        int y = cast<int>(Folk.people.yAt(i));
                        if (x < 0 || y < 0 || x >= Folk.W() || y >= Folk.H()) {
                            offMap = offMap + 1;
                        } else {
                            if (!Biomes.walkable(Folk.world.biomeAt(x, y))) {
                                inTheSea = inTheSea + 1;
                            }
                        }
                    }
                    i = i + 1;
                }
                Test.checking("nobody was seeded off the map");
                Test.assertEqual(offMap, 0);
                Test.checking("and nobody was seeded onto water or rock they cannot walk");
                Test.assertEqual(inTheSea, 0);
                return;
            }

            // Everybody belongs to a community, and the communities are the ones that were asked for.
            [Tag(name: "people")]
            [Test]
            public static method everybody_belongs_somewhere() returns void {
                mutable int homeless = 0;
                mutable int i = 0;
                while (i < Folk.people.capacity()) {
                    if (Folk.people.alive(i) && Folk.people.homeOf(i) < 0) {
                        homeless = homeless + 1;
                    }
                    i = i + 1;
                }
                Test.checking("everyone seeded has a community");
                Test.assertEqual(homeless, 0);
                return;
            }

            // Temperament is inherited and it has to SPREAD. A world where everybody has the same
            // boldness is a world with one personality, and the leadership rule -- a chief emerges by
            // influence, nobody appoints one -- has nothing to work with.
            [Tag(name: "people")]
            [Test]
            public static method temperaments_spread_rather_than_clustering() returns void {
                mutable int lowBold = 0;
                mutable int highBold = 0;
                mutable int lowSocial = 0;
                mutable int highSocial = 0;
                mutable int i = 0;
                while (i < Folk.people.capacity()) {
                    if (Folk.people.alive(i)) {
                        if (Folk.people.boldnessOf(i) < 30) {
                            lowBold = lowBold + 1;
                        }
                        if (Folk.people.boldnessOf(i) > 70) {
                            highBold = highBold + 1;
                        }
                        if (Folk.people.sociabilityOf(i) < 30) {
                            lowSocial = lowSocial + 1;
                        }
                        if (Folk.people.sociabilityOf(i) > 70) {
                            highSocial = highSocial + 1;
                        }
                    }
                    i = i + 1;
                }
                Test.checking("there are timid people");
                Test.assertAtLeast(lowBold, 1);
                Test.checking("and bold ones");
                Test.assertAtLeast(highBold, 1);
                Test.checking("and solitary ones");
                Test.assertAtLeast(lowSocial, 1);
                Test.checking("and gregarious ones");
                Test.assertAtLeast(highSocial, 1);
                return;
            }

            // Ages spread too, or the whole world dies in the same minute -- which is exactly what a
            // uniform starting age produces, one generation in.
            [Tag(name: "people")]
            [Test]
            public static method ages_spread_across_a_lifetime() returns void {
                mutable float youngest = 9999.0;
                mutable float oldest = 0.0;
                mutable int i = 0;
                while (i < Folk.people.capacity()) {
                    if (Folk.people.alive(i)) {
                        float a = Folk.people.ageOf(i);
                        if (a < youngest) {
                            youngest = a;
                        }
                        if (a > oldest) {
                            oldest = a;
                        }
                    }
                    i = i + 1;
                }
                Test.checking("the world starts with people of different ages");
                Test.assertTrue(oldest - youngest > 1.0);
                Test.checking("and nobody starts older than a life is long");
                Test.assertTrue(oldest < 1000.0);
                return;
            }

            // The pool hands out each slot once. A pool that hands the same index to two people is
            // the kind of defect that shows up as a person teleporting, months later.
            [Tag(name: "people")]
            [Test]
            public static method the_pool_never_hands_out_a_live_slot() returns void {
                int before = Folk.people.count();
                int a = Folk.people.spawn(10.0, 10.0, 0);
                int b = Folk.people.spawn(11.0, 11.0, 0);
                Test.checking("two spawns give two different slots");
                Test.assertNotEqual(a, b);
                Test.checking("and the table grew by two");
                Test.assertEqual(Folk.people.count(), before + 2);
                Folk.people.kill(a);
                Test.checking("a death frees the slot");
                Test.assertEqual(Folk.people.count(), before + 1);
                int c = Folk.people.spawn(12.0, 12.0, 0);
                Test.checking("and the freed slot is handed out again rather than growing the table");
                Test.assertEqual(c, a);
                Folk.people.kill(b);
                Folk.people.kill(c);
                return;
            }

            // A ROW IS NOT A PERSON, and kinship is the place that matters most.
            //
            // The free list is what lets fifty thousand people run a million births through four
            // thousand rows, and it means an index kept across a death names whoever was born into
            // the slot afterwards. `mother` was a bare index, so a child whose mother died and
            // whose mother's row was reused had a living stranger for a parent -- invisible only
            // because nothing in the world read the field. It reads it now.
            [Tag(name: "people")]
            [Test]
            public static method a_dead_mother_does_not_become_somebody_else() returns void {
                int mum = Folk.people.spawn(10.0, 10.0, 0);
                Test.checking("the test got a mother");
                Test.assertAtLeast(mum, 0);
                int kid = Folk.people.bear(mum, 42, 1);
                Test.checking("and a child of hers");
                Test.assertAtLeast(kid, 0);
                Test.checking("whose mother is who it should be");
                Test.assertEqual(Folk.people.motherLive(kid), mum);

                Folk.people.kill(mum);
                Test.checking("a dead mother is not a living mother");
                Test.assertEqual(Folk.people.motherLive(kid), 0 - 1);

                // The free list hands the same row straight back out. Before the serial, THIS is
                // the moment the child silently acquired a new parent.
                int stranger = Folk.people.spawn(20.0, 20.0, 0);
                Test.checking("the row really was recycled -- otherwise this proves nothing");
                Test.assertEqual(stranger, mum);
                Test.checking("and the child does not inherit whoever moved in");
                Test.assertEqual(Folk.people.motherLive(kid), 0 - 1);
                Test.checking("nor is the newcomer that child's parent");
                Test.assertTrue(!Folk.people.isChildOf(kid, stranger));
                Folk.people.kill(stranger);
                Folk.people.kill(kid);
                return;
            }

            // A MARRIAGE IS BETWEEN TWO PEOPLE, and does not survive one of them into a stranger.
            //
            // `spouse` sat in this table from the first slice: allocated, cleared at every birth,
            // never written and never read. It is written now, and it needs the guard the parent
            // links needed -- a dead partner's row goes to the next child born, and a marriage must
            // not quietly transfer to whoever inherits the slot.
            [Tag(name: "people")]
            [Test]
            public static method a_marriage_is_between_two_people() returns void {
                int her = Folk.people.spawn(30.0, 30.0, 0);
                int him = Folk.people.spawn(31.0, 30.0, 0);
                Test.checking("nobody starts out with a partner");
                Test.assertTrue(Folk.people.spouseLive(her) < 0);

                Folk.people.wed(her, him);
                Test.checking("a marriage reads the same from both sides");
                Test.assertEqual(Folk.people.spouseLive(her), him);
                Test.assertEqual(Folk.people.spouseLive(him), her);

                Folk.people.kill(him);
                Test.checking("a widow has no partner");
                Test.assertTrue(Folk.people.spouseLive(her) < 0);

                // The trap: the dead man's row goes to the next person born, who is not him.
                int stranger = Folk.people.spawn(31.0, 30.0, 0);
                Test.checking("and the marriage does not pass to whoever gets his row");
                Test.assertTrue(Folk.people.spouseLive(her) < 0);
                Folk.people.kill(stranger);
                Folk.people.kill(her);
                return;
            }

            // A DEBT AND A GRUDGE POINT AT A PERSON, not at a row.
            //
            // Fifty thousand people is two and a half billion pairs, so this world holds one friend
            // and one enemy each -- the person somebody would name if you asked. Same guard as the
            // marriage and the parents: a dead man's row goes to the next child born, and a grudge
            // must not transfer to whoever inherits it.
            [Tag(name: "people")]
            [Test]
            public static method a_grudge_is_against_a_person_and_not_a_row() returns void {
                int thief = Folk.people.spawn(40.0, 40.0, 0);
                int robbed = Folk.people.spawn(41.0, 40.0, 0);
                Test.checking("nobody starts out owing or blaming anybody");
                Test.assertTrue(Folk.people.friendLive(thief) < 0);
                Test.assertTrue(Folk.people.foeLive(thief) < 0);

                Folk.people.antagonise(robbed, thief);
                Test.checking("the one who was robbed remembers who did it");
                Test.assertEqual(Folk.people.foeLive(robbed), thief);
                Test.checking("and it is one-way until the other one is told");
                Test.assertTrue(Folk.people.foeLive(thief) < 0);

                Folk.people.befriend(thief, robbed);
                Test.checking("a debt and a grudge are separate slots");
                Test.assertEqual(Folk.people.friendLive(thief), robbed);
                Test.assertTrue(Folk.people.foeLive(thief) < 0);

                Folk.people.kill(thief);
                Test.checking("a grudge against the dead is not a grudge");
                Test.assertTrue(Folk.people.foeLive(robbed) < 0);

                // The trap: the dead man's row goes to the next person born, who is innocent.
                int stranger = Folk.people.spawn(41.0, 40.0, 0);
                Test.checking("and it does not pass to whoever inherits his row");
                Test.assertTrue(Folk.people.foeLive(robbed) < 0);
                Folk.people.kill(stranger);
                Folk.people.kill(robbed);
                return;
            }

            // SIBLINGS, and the trap that makes them wrong.
            //
            // Two people are of one blood if they share a parent -- and the SERIALS are what make
            // that safe. Two children of two long-dead mothers whose rows have both been handed on
            // to the same newborn would read as brother and sister off the bare index, which is
            // the same class of defect as a child inheriting a stranger for a parent.
            [Tag(name: "people")]
            [Test]
            public static method two_children_of_one_mother_are_kin() returns void {
                int mum = Folk.people.spawn(50.0, 50.0, 0);
                int dad = Folk.people.spawn(51.0, 50.0, 0);
                Folk.people.setSire(mum, dad);
                int one = Folk.people.bear(mum, 42, 11);
                Folk.people.setSire(mum, dad);
                int two = Folk.people.bear(mum, 42, 12);

                Test.checking("two children of one mother are kin");
                Test.assertTrue(Folk.people.isSiblingOf(one, two));
                Test.checking("and it reads the same both ways round");
                Test.assertTrue(Folk.people.isSiblingOf(two, one));
                Test.checking("nobody is their own sibling");
                Test.assertTrue(!Folk.people.isSiblingOf(one, one));

                // A stranger's child, born of nobody this pair knows.
                int other = Folk.people.spawn(60.0, 60.0, 0);
                int alone = Folk.people.bear(other, 42, 13);
                Test.checking("a stranger's child is not their brother");
                Test.assertTrue(!Folk.people.isSiblingOf(one, alone));

                // The trap: two people with NO parents at all must not read as kin just because
                // both their parent slots are empty.
                Test.checking("two people with no parents are not thereby related");
                Test.assertTrue(!Folk.people.isSiblingOf(mum, other));

                Test.checking("a brother stays a brother after their mother dies");
                Folk.people.kill(mum);
                Test.assertTrue(Folk.people.isSiblingOf(one, two));

                Folk.people.kill(one);
                Folk.people.kill(two);
                Folk.people.kill(alone);
                Folk.people.kill(other);
                Folk.people.kill(dad);
                return;
            }

            // A PERSON REMEMBERS WHAT HAPPENED TO THEM.
            //
            // Everything else in this table is inherited (temperament), a state (hunger, tiredness)
            // or somebody else's opinion (influence). Nerve is the first field that is a thing
            // which happened TO this person, and it is what makes two people in identical straits
            // do different things: the one who has got away with it before goes sooner.
            [Tag(name: "people")]
            [Test]
            public static method a_person_remembers_getting_away_with_it() returns void {
                int who = Folk.people.spawn(40.0, 40.0, 0);
                Test.checking("the test got somebody");
                Test.assertAtLeast(who, 0);
                Test.checking("nobody starts out knowing they can get away with it");
                Test.assertEqual(Folk.people.nerveOf(who), 0);

                Folk.people.emboldened(who);
                Folk.people.emboldened(who);
                Test.checking("and each time they do, they remember");
                Test.assertEqual(Folk.people.nerveOf(who), 2);

                Test.checking("a fright undoes it all at once, not by a step");
                Folk.people.frightened(who);
                Test.assertEqual(Folk.people.nerveOf(who), 0);

                mutable int t = 0;
                while (t < 20) {
                    Folk.people.emboldened(who);
                    t = t + 1;
                }
                Test.checking("a lifelong thief is bold rather than unstoppable");
                Test.assertAtMost(Folk.people.nerveOf(who), 5);

                // And it does not survive the row being handed to somebody else -- the same rule
                // the axe and the kin links follow.
                Folk.people.kill(who);
                int newborn = Folk.people.spawn(41.0, 40.0, 0);
                Test.checking("the row really was recycled");
                Test.assertEqual(newborn, who);
                Test.checking("and a newborn does not inherit a dead thief's nerve");
                Test.assertEqual(Folk.people.nerveOf(newborn), 0);
                Folk.people.kill(newborn);
                return;
            }

            // A father, which this world recorded for nobody: the field existed, was set to -1 at
            // birth, and nothing ever wrote it.
            [Tag(name: "people")]
            [Test]
            public static method a_child_has_two_parents() returns void {
                int mum = Folk.people.spawn(12.0, 12.0, 0);
                int dad = Folk.people.spawn(13.0, 12.0, 0);
                Test.checking("the test got both parents");
                Test.assertAtLeast(mum, 0);
                Test.assertAtLeast(dad, 0);
                Folk.people.setSire(mum, dad);
                int kid = Folk.people.bear(mum, 42, 2);
                Test.checking("the child knows its father");
                Test.assertEqual(Folk.people.fatherLive(kid), dad);
                Test.checking("and its father knows it");
                Test.assertTrue(Folk.people.isChildOf(kid, dad));
                Test.checking("and a pregnancy is spent once, not handed to every later child");
                int again = Folk.people.bear(mum, 42, 3);
                Test.assertEqual(Folk.people.fatherLive(again), 0 - 1);
                Folk.people.kill(kid);
                Folk.people.kill(again);
                Folk.people.kill(dad);
                Folk.people.kill(mum);
                return;
            }

            // Open ground with room around it, found rather than assumed.
            //
            // The first version of this asked only that the cell and its four neighbours be
            // walkable, and the test then failed with twelve overlapping pairs left over. That was
            // not the pass failing: twenty people needing a cell apiece have to spread to a radius
            // of about three, and the spot it picked did not HAVE three clear cells -- so the pass
            // correctly refused to push anybody into the sea and the crowd packed against the
            // shore. A test that crowds people onto a beach measures `slideTo`'s refusal rather
            // than the separation.
            //
            // So the patch is checked at the radius the crowd actually needs. If this ever fails to
            // find one, that is the world generator and not the pass.
            private static method openGround(int need, int which) returns int {
                mutable int found = 0;
                for (int y in need..Folk.H() - need) {
                    for (int x in need..Folk.W() - need) {
                        if (Folk.clearAround(x, y, need)) {
                            if (found == which) {
                                return y * Folk.W() + x;
                            }
                            found = found + 1;
                        }
                    }
                }
                return 0 - 1;
            }

            private static method clearAround(int cx, int cy, int r) returns boolean {
                for (int y in cy - r..cy + r + 1) {
                    for (int x in cx - r..cx + r + 1) {
                        if (!Biomes.walkable(Folk.world.biomeAt(x, y))) {
                            return false;
                        }
                    }
                }
                return true;
            }

            // THERE IS NO CROWDING TEST HERE ANY MORE, on purpose.
            //
            // One stood here and asserted that twenty people put on one spot ended up apart. It
            // passed against both separation passes this file has seen, and both are gone: agents
            // have no collision and no minimum distance. A test asserting the opposite of the rule
            // would be a test that has to be deleted the next time somebody is right, so it is
            // deleted now rather than left to argue with the game.
            //
            // `openGround` above is kept -- other tests want somewhere dry to stand.
        }
    }
}
