import System.IO.Console;
import System.Test.Test;
import Agents.World.Grid;
import Agents.World.WorldGen;
import Agents.World.WorldAudit;
import Agents.World.Biomes;
program AgentsExe;

// The acceptance criteria for a generated world, as tests.
//
// These used to be `WorldAudit.verdict()`: a hand-rolled judge with its own RejectReason enum,
// returning the FIRST criterion that failed, driven by a `preview` mode nobody ran except by hand.
// Every part of that was a test framework written by hand because the language did not have one.
// Now it does, so the judge is a judge again -- WorldAudit measures, and these decide.
//
// One test per seed rather than one per criterion, because a world costs ~3.7 s to generate and
// twelve criteria would mean twelve worlds each. Test.checking names the criterion, so a failure
// still says which one broke and by how much -- which is exactly what RejectReason was for.

public bundle Agents {
    public namespace Checks {

        public class WorldShape {
            // The twelve seeds the preview contact sheet has always used.
            public static method seeds() returns int[] {
                mutable int[] rows = new int[12]();
                mutable int k = 0;
                while (k < 12) {
                    rows[k] = 42 + k * 7717;
                    k = k + 1;
                }
                return rows;
            }

            public static method WIDTH() returns int {
                return 2560;
            }

            public static method HEIGHT() returns int {
                return 1440;
            }

            // Continental mode, six continents: the world the game actually starts in.
            //
            // Through WorldGen.acceptable, because that is the world a PLAYER gets -- generation is
            // a search and this asks whether the search delivers. Judging the raw first roll instead
            // would leave three of these twelve permanently red for a defect the search exists to
            // absorb, and a suite that is always red is a suite nobody reads. Which seeds need a
            // re-roll, and that the re-roll is deterministic, is WorldSearch's business below.
            [Cases(source: "seeds")]
            [Tag(name: "world")]
            [Test]
            public static method a_generated_world_is_acceptable(int seed) returns void {
                Grid* g = WorldGen.acceptable(seed, 0, 0.0 - 1.0, 0, WorldShape.WIDTH(),
                                              WorldShape.HEIGHT(), 6, false);
                WorldAudit* wa = new WorldAudit(g) on heap;
                wa.analyse();  // the resource census runs inside it

                // --- shape ---
                Test.checking("the world has at least six landmasses");
                Test.assertAtLeast(wa.components(), 6);

                // No single landmass may hold more than 45% of the land. This is the criterion that
                // guards what actually matters: a world with one continent and five scraps.
                Test.checking("no landmass holds more than 45% of the land (per 1000)");
                Test.assertAtMost(wa.largestShare(), 450);

                // 1.5:1 to 6:1 between biggest and smallest continent. The first band tried was
                // 2:1 to 4.5:1, from Earth's six largest, and it rejected 7 of 12 seeds -- none of
                // them visibly wrong when the twelve renders were laid side by side.
                Test.checking("biggest-to-smallest continent ratio (x100)");
                Test.assertBetween(wa.sizeRatio(6), 150, 600);

                Test.checking("island count outside the continents");
                Test.assertBetween(wa.islandCount(6), 3, 12);

                // --- relief ---
                Test.checking("highland share of land (per 1000)");
                Test.assertBetween(wa.highlandShare(), 80, 280);

                Test.checking("mountains form chains, not blobs (length/width x100)");
                Test.assertAtLeast(wa.chainElongation(), 250);

                // The band has to be REACHED, not merely entered: a range topping out at 0.70 has
                // no snow line, and Glacier/SnowPeak then appear nowhere in the world.
                Test.checking("the highest peak reaches the snow line (per 10000)");
                Test.assertAtLeast(wa.peakElevation(), 9000);

                // --- resources ---
                // A missing kind comes first because it is not a matter of degree: every node kind
                // has a building and an era behind it, and a world without one has a chain that can
                // never complete.
                Test.checking("every node kind appears somewhere");
                Test.assertEqual(wa.kindsMissing(), 0);

                Test.checking("every continent has wood, stone and water");
                Test.assertAtLeast(wa.livableContinents(6), 6);

                // Dust versus forest, independent of density: below this the trees are a sprinkle,
                // whatever the cover figure says.
                Test.checking("trees clump into woods rather than dust (per 1000)");
                Test.assertAtLeast(wa.clumpShare(), 400);

                Test.checking("no biome is outside its tree-cover band");
                Test.assertEqual(wa.forestCoverFail(), 0 - 1);

                // If most ore bodies show nowhere, everything is buried and nothing can be found:
                // the early game starves before prospecting is ever unlocked.
                if (wa.oreBodyCount() > 0) {
                    Test.checking("buried ore reaches the surface somewhere (per 1000)");
                    Test.assertAtLeast(wa.oreReach(), 450);
                }

                delete wa;
                delete g;
                return;
            }
        }

        // Generation is a search, so the search has to actually find something.
        //
        // Three of the twelve seeds above produce a world the criteria reject. Until this existed the
        // game took the first roll regardless, and three players in twelve got a world its own
        // designer would have thrown away. WorldGen.acceptable rolls again from a seed derived from
        // the one that failed -- deterministic, so the same starting seed still gives the same world.
        public class WorldSearch {
            // The three that fail on the first roll: 5 (fourteen islands), 6 and 11 (one continent
            // and five scraps, at ratios of 9.5:1).
            public static method rejectedSeeds() returns int[] {
                mutable int[] rows = new int[3]();
                rows[0] = 42 + 5 * 7717;
                rows[1] = 42 + 6 * 7717;
                rows[2] = 42 + 11 * 7717;
                return rows;
            }

            [Cases(source: "rejectedSeeds")]
            [Tag(name: "world")]
            [Test]
            public static method the_search_finds_a_world_the_first_roll_did_not(int seed) returns void {
                Grid* g = WorldGen.acceptable(seed, 0, 0.0 - 1.0, 0, WorldShape.WIDTH(),
                                              WorldShape.HEIGHT(), 6, false);
                WorldAudit* wa = new WorldAudit(g) on heap;
                wa.analyse();
                Test.checking("the world the search settled on passes every criterion");
                Test.assertEqual(wa.verdict(6), 0);
                delete wa;
                delete g;
                return;
            }

            // A search that is not deterministic is a lottery, and a seed stops meaning anything.
            [Tag(name: "world")]
            [Test]
            public static method the_search_is_deterministic() returns void {
                int seed = 42 + 6 * 7717;
                Grid* a = WorldGen.acceptable(seed, 0, 0.0 - 1.0, 0, 640, 360, 6, false);
                Grid* b = WorldGen.acceptable(seed, 0, 0.0 - 1.0, 0, 640, 360, 6, false);
                mutable int differences = 0;
                mutable int y = 0;
                while (y < 360) {
                    mutable int x = 0;
                    while (x < 640) {
                        if (a.biomeAt(x, y) != b.biomeAt(x, y)) {
                            differences = differences + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                Test.checking("the same seed gives the same world, roll after roll");
                Test.assertEqual(differences, 0);
                delete a;
                delete b;
                return;
            }
        }

        // The default world -- the one the game starts in -- gets the checks that are about the
        // world being COHERENT rather than about it being a good place to play: rivers that arrive
        // somewhere, a coastline that is not a drawn line, ice where ice belongs.
        public class DefaultWorld {
            private static mutable Grid* world;
            private static mutable int built = 0;

            [BeforeAll]
            public static method buildTheDefaultWorld() returns void {
                WorldGen gen = new WorldGen(42) on stack;
                gen.setWorld(0, 0.0 - 1.0);
                DefaultWorld.world = gen.generate(WorldShape.WIDTH(), WorldShape.HEIGHT());
                DefaultWorld.built = DefaultWorld.built + 1;
                return;
            }

            [AfterAll]
            public static method dropTheDefaultWorld() returns void {
                delete DefaultWorld.world;
                return;
            }

            [Tag(name: "world")]
            [Test]
            public static method the_fixture_is_built_once() returns void {
                Test.checking("the expensive world is generated once for the whole class");
                Test.assertEqual(DefaultWorld.built, 1);
                return;
            }

            // A river that stops in the middle of a field is the defect that took four rewrites to
            // find, and it is invisible in a screenshot. A river dying into a salt flat is a
            // legitimate endorheic terminus, not a defect -- hence the biome test rather than a
            // plain "did it reach water".
            [Tag(name: "world")]
            [Test]
            public static method every_river_arrives_somewhere() returns void {
                Grid* g = DefaultWorld.world;
                int w = g.width();
                int h = g.height();
                mutable int cells = 0;
                mutable int mouths = 0;
                mutable int broken = 0;
                mutable int noflow = 0;
                mutable int y = 0;
                while (y < h) {
                    mutable int x = 0;
                    while (x < w) {
                        if (g.hasFlag(x, y, Grid.FLAG_RIVER)) {
                            cells = cells + 1;
                            if (!g.hasFlow(x, y)) {
                                noflow = noflow + 1;
                            } else {
                                int tx = x + g.flowDx(x, y);
                                int ty = y + g.flowDy(x, y);
                                if (tx < 0 || ty < 0 || tx >= w || ty >= h) {
                                    broken = broken + 1;
                                } else {
                                    int tb = g.biomeAt(tx, ty);
                                    if (tb <= 7 || tb == 38) {
                                        mouths = mouths + 1;
                                    } else {
                                        if (!g.hasFlag(tx, ty, Grid.FLAG_RIVER)) {
                                            broken = broken + 1;
                                        }
                                    }
                                }
                            }
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                Test.checking("the world has a river network at all");
                Test.assertAtLeast(cells, 5000);
                Test.checking("rivers reach the sea or an endorheic basin");
                Test.assertAtLeast(mouths, 50);
                Test.checking("no river dies on dry land");
                Test.assertEqual(broken, 0);
                Test.checking("every river cell knows where it flows");
                Test.assertEqual(noflow, 0);
                return;
            }

            // The south-border trench: a defect that made one edge of the world a drawn line of deep
            // water. It was fixed once; nothing stops it coming back, and nobody would notice from a
            // top-down map, which is how it survived in the first place.
            [Tag(name: "world")]
            [Test]
            public static method the_map_edge_is_not_a_drawn_line() returns void {
                Grid* g = DefaultWorld.world;
                int w = g.width();
                int h = g.height();
                mutable int bottomDeep = 0;
                mutable int rowAbove = 0;
                mutable int x = 0;
                while (x < w) {
                    if (g.elevAt(x, h - 1) < 2000) {
                        bottomDeep = bottomDeep + 1;
                    }
                    if (g.elevAt(x, h - 64) < 2000) {
                        rowAbove = rowAbove + 1;
                    }
                    x = x + 1;
                }
                // The edge may legitimately be mostly ocean; what it may NOT be is a cliff that the
                // rest of the world does not share. If the bottom row is deep everywhere and the row
                // 64 cells up is not, that is the trench again.
                Test.checking("the bottom edge is not a trench the rest of the world lacks");
                if (bottomDeep > w * 95 / 100) {
                    Test.assertAtLeast(rowAbove, w * 60 / 100);
                }
                return;
            }

            // Ice belongs at the poles. A world with glacier in the middle latitudes means the
            // temperature field is not being read where the biome is chosen.
            [Tag(name: "world")]
            [Test]
            public static method ice_sits_at_the_poles() returns void {
                Grid* g = DefaultWorld.world;
                int w = g.width();
                int h = g.height();
                mutable int iceInTheBelt = 0;
                mutable int y = h / 3;
                while (y < h * 2 / 3) {
                    mutable int x = 0;
                    while (x < w) {
                        int b = g.biomeAt(x, y);
                        // IceCap (29) and Glacier (30). High mountains may legitimately be frozen,
                        // so only count the ones that are not up a mountain.
                        if ((b == 29 || b == 30) && g.elevAt(x, y) < 7000) {
                            iceInTheBelt = iceInTheBelt + 1;
                        }
                        x = x + 1;
                    }
                    y = y + 1;
                }
                Test.checking("no lowland ice in the middle third of the world");
                Test.assertAtMost(iceInTheBelt, w * h / 2000);
                return;
            }
        }
    }
}
