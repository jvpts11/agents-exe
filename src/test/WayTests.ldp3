import System.IO.Console;
import System.Test.Test;
import Agents.World.Ways;
import Agents.World.Surface;
program AgentsExe;

// The ground under the feet. Cheap tests on a small field rather than assertions on an arc,
// because every rule here is arithmetic and the arc would only tell us whether fifty thousand
// people happened to walk somewhere -- which is a different question, and the one the arc answers.

public bundle Agents {
    public namespace Checks {

        // Named Trodden and not Paths or Ground, both of which were tried and both of which broke
        // the build somewhere else entirely: `Paths` is a stdlib class, `Ground` is the enum in
        // Building.ldp3 that says what a farm may stand on. Either collision comes out as
        // "import of unknown symbol System.Memory.Units.megabytes" against WorldGen.ldp3, a file
        // with nothing to do with any of it. Toolchain #315/#330 are the same family and are
        // marked fixed; this pair is a live case of it.
        public class Trodden {
            [Tag(name: "ways")]
            [Test]
            public static method walking_wears_a_trail_and_then_a_road() returns void {
                Ways* w = new Ways(32, 32) on heap;
                Test.checking("bare ground to begin with");
                Test.assertEqual(w.surfaceAt(5, 5), cast<int>(Surface.Bare));
                mutable int k = 0;
                while (k < Ways.TRAIL_AT) {
                    w.walked(5, 5);
                    k = k + 1;
                }
                Test.checking("enough feet wear a trail");
                Test.assertEqual(w.surfaceAt(5, 5), cast<int>(Surface.Trail));
                while (k < Ways.ROAD_AT) {
                    w.walked(5, 5);
                    k = k + 1;
                }
                Test.checking("and enough more widen it into a road");
                Test.assertEqual(w.surfaceAt(5, 5), cast<int>(Surface.Road));
                // A cell nobody crossed is untouched: wear is where the walking was, and a
                // neighbour of a road is not a road.
                Test.checking("the cell next door is still bare");
                Test.assertEqual(w.surfaceAt(6, 5), cast<int>(Surface.Bare));
                delete w;
                return;
            }

            // Without this the map ends an arc as a brown smear rather than a network -- the same
            // failure the forest had before felling cost anything.
            [Tag(name: "ways")]
            [Test]
            public static method a_path_nobody_uses_goes_back_to_grass() returns void {
                Ways* w = new Ways(32, 32) on heap;
                mutable int k = 0;
                while (k < Ways.ROAD_AT) {
                    w.walked(9, 9);
                    k = k + 1;
                }
                Test.checking("a road to start with");
                Test.assertEqual(w.surfaceAt(9, 9), cast<int>(Surface.Road));
                // Long enough for the sweep to reach this cell often enough to undo it. One pass
                // takes off one, so it needs ROAD_AT passes.
                mutable int t = 0;
                while (t < Ways.ROAD_AT + 8) {
                    w.fade(Ways.FADE_SWEEP);
                    t = t + 1;
                }
                Test.checking("and grass again once nobody walks it");
                Test.assertEqual(w.surfaceAt(9, 9), cast<int>(Surface.Bare));
                delete w;
                return;
            }

            // Pavement is a decision, not a habit. It outranks any amount of wear and no amount of
            // disuse takes it away -- which is exactly the difference the third era buys.
            [Tag(name: "ways")]
            [Test]
            public static method what_was_laid_outlasts_what_was_worn() returns void {
                Ways* w = new Ways(32, 32) on heap;
                Test.checking("paving bare ground takes");
                Test.assertTrue(w.lay(3, 3, cast<int>(Surface.Paved)));
                Test.checking("and paving it twice is not a second road");
                Test.assertTrue(!w.lay(3, 3, cast<int>(Surface.Paved)));
                mutable int t = 0;
                while (t < 600) {
                    w.fade(Ways.FADE_SWEEP);
                    t = t + 1;
                }
                Test.checking("pavement does not fade");
                Test.assertEqual(w.surfaceAt(3, 3), cast<int>(Surface.Paved));
                delete w;
                return;
            }

            // The tile a cell draws is chosen by which neighbours carry a way, so a road that ends
            // at a village draws one arm and a crossroads draws four. If the mask were not
            // symmetric the two halves of a junction would disagree about whether they touch.
            [Tag(name: "ways")]
            [Test]
            public static method a_junction_agrees_with_itself() returns void {
                Ways* w = new Ways(32, 32) on heap;
                // A road running east-west through (10,10).
                mutable int x = 8;
                while (x <= 12) {
                    mutable int k = 0;
                    while (k < Ways.ROAD_AT) {
                        w.walked(x, 10);
                        k = k + 1;
                    }
                    x = x + 1;
                }
                int mid = w.maskAt(10, 10, cast<int>(Surface.Road));
                int east = 1 << 2;
                int west = 1 << 6;
                Test.checking("the middle of a straight road connects both ways");
                Test.assertEqual(mid & (east | west), east | west);
                int endCell = w.maskAt(8, 10, cast<int>(Surface.Road));
                Test.checking("the end of it connects one way only");
                Test.assertEqual(endCell & (east | west), east);
                // And the neighbour agrees: (9,10) sees a road to its west.
                int nextOne = w.maskAt(9, 10, cast<int>(Surface.Road));
                Test.checking("and its neighbour sees it back");
                Test.assertEqual(nextOne & west, west);
                delete w;
                return;
            }

            // A railway is not a better road. Rails meeting a lane is not a junction, and if the
            // rank test let it be one, every level crossing in the world would draw a fork.
            [Tag(name: "ways")]
            [Test]
            public static method a_railway_is_not_a_road() returns void {
                Ways* w = new Ways(32, 32) on heap;
                w.lay(20, 10, cast<int>(Surface.Rail));
                mutable int k = 0;
                while (k < Ways.ROAD_AT) {
                    w.walked(21, 10);
                    k = k + 1;
                }
                int road = w.maskAt(21, 10, cast<int>(Surface.Road));
                Test.checking("a road does not join into a railway");
                Test.assertEqual(road & (1 << 6), 0);
                int rail = w.maskAt(20, 10, cast<int>(Surface.Rail));
                Test.checking("nor a railway into a road");
                Test.assertEqual(rail & (1 << 2), 0);
                delete w;
                return;
            }
        }
    }
}
