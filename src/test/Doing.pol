import System.Test.Test;
import Agents.People.Population;
import Agents.People.Agent;
import Agents.People.AgentId;
import Agents.People.AgentClass;
import Agents.People.Activity;
import Agents.People.Doings;
import Agents.People.Body;
import Agents.People.Gauge;
import Agents.People.Sex;
import Agents.People.Orientation;
import Agents.People.Kindred;
import Agents.People.Relation;
import Agents.Sim.Clock;
import Agents.World.Grid;
import Agents.World.Biome;
import Agents.World.Waymap;
import Agents.People.Courting;
import Agents.Gfx.GlWorld3D;
import Agents.Nations.Atlas;
import Agents.People.BuildingId;
program AgentsExe;

// WHAT SOMEBODY IS DOING, AND WHY THAT AND NOT SOMETHING ELSE.
//
// THE FAILURE THESE ARE WRITTEN AGAINST is not a crash. Every defect this slice found looked like a
// healthy run: five thousand people "working" at buildings that do not exist, then everybody in
// "eating" while they starved to death. The counts were fine, the tick was fine, and the world was
// dead. So these checks ask what nothing else can ask -- that the score puts the right thing first.
public bundle Agents {
    public namespace Checks {

        public class Doing {
            public static fixed int SIDE = 64;

            // Ground anybody can walk on, everywhere. These checks are about what somebody CHOOSES,
            // so the ground must never be the reason a step did not happen.
            private static method pasture() returns Grid* {
                mutable Grid* g = new Grid(Doing.SIDE, Doing.SIDE) on heap;
                for (int y in 0..Doing.SIDE) {
                    for (int x in 0..Doing.SIDE) {
                        g.setBiome(x, y, cast<int>(Biome.Prairie));
                    }
                }
                g.labelMasses();
                return g;
            }

            private static method someone(Population* folk) returns Agent* {
                AgentId who = folk.bear(10.5, 10.5);
                Agent* one = folk.at(who);
                one.body.age = 25;
                one.identity.sex = Sex.Female;
                one.identity.orientation = Orientation.Straight;
                one.identity.nature.sociability = cast<ubyte>(128);
                one.identity.nature.curiosity = cast<ubyte>(128);
                return one;
            }

            // NOBODY IS IN NO ACTIVITY. `Idle` is the floor of the scoring for exactly this reason:
            // an agent whose every other urge is nought has to be doing SOMETHING, or it has no
            // pose, no drain and no name.
            [Tag(name: "people")]
            [Test]
            public static method somebody_with_nothing_pressing_is_idle() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                Agent* one = Doing.someone(folk);
                one.identity.nature.sociability = cast<ubyte>(0);
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(0));
                Test.assertEqual(cast<int>(one.activity), cast<int>(Activity.Idle));
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // AND NOBODY IS BORN INTO NOTHING EITHER, which is a different claim: the field is
            // written in the constructor rather than trusted to be the zeroth constant.
            [Tag(name: "people")]
            [Test]
            public static method a_person_is_doing_something_from_the_first_tick() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                AgentId who = folk.bear(10.5, 10.5);
                Test.assertEqual(cast<int>(folk.at(who).activity), cast<int>(Activity.Idle));
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // A HUNGRY PERSON GOES FOR FOOD RATHER THAN COURTING, and the margin is the point: it
            // used to be that hunger scored nothing at all until a body was three quarters of the
            // way from peckish to dead, so people courted while they starved.
            [Tag(name: "people")]
            [Test]
            public static method hunger_outweighs_company_long_before_it_is_fatal() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                Agent* one = Doing.someone(folk);
                // Half full: not an emergency by any threshold anybody would write.
                one.body.fed = new Gauge(Body.FULL / 2, 0, Body.FULL);
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(0));
                Test.assertEqual(cast<int>(one.activity), cast<int>(Activity.Gathering));
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // AND SOMEBODY CARRYING FOOD EATS IT INSTEAD OF LOOKING FOR MORE. Somebody with a meal
            // in hand walking off to find another one is the single most absurd thing to watch.
            [Tag(name: "people")]
            [Test]
            public static method food_in_hand_beats_food_in_the_ground() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                Agent* one = Doing.someone(folk);
                one.body.fed = new Gauge(Body.FULL / 2, 0, Body.FULL);
                one.inventory.carrying = 3;
                one.inventory.howMany = 5;
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(0));
                Test.assertEqual(cast<int>(one.activity), cast<int>(Activity.Eating));
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // A SPENT BODY LIES DOWN, and it beats hunger: somebody who will not sleep is somebody
            // who dies of not sleeping, and no other urge may outrank that.
            [Tag(name: "people")]
            [Test]
            public static method an_empty_body_sleeps_before_anything_else() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                Agent* one = Doing.someone(folk);
                one.body.fed = new Gauge(1, 0, Body.FULL);        // all but starving
                one.body.energy = new Gauge(1, 0, Body.RESTED);   // and all but spent
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(0));
                Test.assertEqual(cast<int>(one.activity), cast<int>(Activity.Sleeping));
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // AND SLEEPING MENDS IT, in a while and not in a lifetime. The first numbers written
            // here gave back exactly what work took, so a body spent TWO YEARS standing still to go
            // from weary to rested and half the world was asleep instead of eating.
            //
            // NOT TO FULL, AND THAT IS THE DESIGN RATHER THAN A SHORTFALL. Nothing here says "sleep
            // until the gauge is at its maximum" -- sleeping stops when something else is worth
            // more, which for a body already out of danger is nearly anything. A body that slept to
            // the brim every time would be a priority list wearing a score's clothes, which is the
            // one shape this whole file exists to keep out.
            [Tag(name: "people")]
            [Test]
            public static method a_body_mends_faster_than_it_wears_out() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                // TWO BODIES, AND THE ONLY DIFFERENCE IS A ROOF. Both start spent, both lie down --
                // one in a bed, one where it stands. `home` is written straight onto the far end of
                // the seam here because what is being measured is the arithmetic of mending, not
                // the linking; `Roofs` checks the linking.
                Agent* housed = Doing.someone(folk);
                Agent* rough = Doing.someone(folk);
                housed.whereabouts.home = cast<BuildingId>(0);
                housed.body.energy = new Gauge(1, 0, Body.RESTED);
                rough.body.energy = new Gauge(1, 0, Body.RESTED);
                mutable int slept = 0;
                mutable int inBed = 0;
                mutable int outside = 0;
                while (outside == 0 && slept < Clock.TICKS_A_YEAR) {
                    Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(slept));
                    slept = slept + 1;
                    if (inBed == 0 && housed.body.energy.value() > Body.WEARY) {
                        inBed = slept;
                    }
                    if (rough.body.energy.value() > Body.WEARY) {
                        outside = slept;
                    }
                }
                // Out of danger from nothing, in well under a quarter of a year. The bar is
                // deliberately loose: what it is written against is TWO YEARS, not a tick count.
                Test.assertTrue(inBed > 0);
                Test.assertTrue(inBed < Clock.TICKS_A_YEAR / 4);
                // AND SLEEPING ROUGH IS WORTH HALF A BED -- the whole mechanical difference a house
                // makes, and the reason a city that has outgrown its houses is visibly tireder.
                // Checked as a band rather than exactly 2x: the two bodies are charged on the same
                // `CHOOSE_EVERY` window but not on the same tick within it.
                Test.assertTrue(outside > inBed);
                Test.assertTrue(outside >= inBed * 2 - Doings.CHOOSE_EVERY);
                Test.assertTrue(outside <= inBed * 2 + Doings.CHOOSE_EVERY);
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // NOBODY DOES WHAT THEIR STANDING FORBIDS. Nine of the twenty-three belong to standings
            // nobody holds yet, and `mayBeEntered` is the whole of why they never happen -- not a
            // flag, not a slice marker, the same question that lets a scout wander the day there is
            // a scout.
            [Tag(name: "people")]
            [Test]
            public static method a_worker_may_not_do_a_scouts_work() returns void {
                Test.assertTrue(Activity.Gathering.mayBeEntered(AgentClass.Worker));
                Test.assertFalse(Activity.Exploring.mayBeEntered(AgentClass.Worker));
                Test.assertTrue(Activity.Exploring.mayBeEntered(AgentClass.Scout));
                Test.assertFalse(Activity.Marching.mayBeEntered(AgentClass.Worker));
                Test.assertTrue(Activity.Marching.mayBeEntered(AgentClass.Soldier));
                // And idling is everybody's, which is what makes it the floor.
                Test.assertTrue(Activity.Idle.mayBeEntered(AgentClass.Worker));
                Test.assertTrue(Activity.Idle.mayBeEntered(AgentClass.Protagonist));
                return;
            }

            // AND NOBODY WORKS WITHOUT A POST. This is the one that killed a world: `NOWHERE` is
            // minus one and a fresh field is nought, so every person alive claimed building nought
            // and stood in a field working at it until they starved.
            [Tag(name: "people")]
            [Test]
            public static method a_new_person_has_no_job_and_no_home() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                AgentId who = folk.bear(10.5, 10.5);
                Test.assertTrue(folk.at(who).whereabouts.jobless());
                Test.assertTrue(folk.at(who).whereabouts.homeless());
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // AND EVERYBODY IS BORN FACING SOMEWHERE. A zeroed `vec2` is a direction of no length,
            // which nothing can turn a body by -- invisible while everybody walks, and half the
            // drawn world pointing at the same nothing the moment an activity means standing still.
            [Tag(name: "people")]
            [Test]
            public static method a_new_person_faces_somewhere() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                mutable boolean varies = false;
                mutable float firstX = 0.0;
                for (int i in 0..20) {
                    AgentId who = folk.bear(10.5, 10.5);
                    vec2 way = folk.at(who).whereabouts.facing;
                    float span = way.x * way.x + way.y * way.y;
                    Test.assertTrue(span > 0.5);      // a real direction, not the origin
                    if (i == 0) {
                        firstX = way.x;
                    } else if (way.x != firstX) {
                        varies = true;
                    }
                }
                Test.assertTrue(varies);              // and not all the same one
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // WHAT MAY NOT BE CUT SHORT, IS NOT -- and it still has a way to end. An
            // uninterruptible activity with no way to stop wanting itself is a person frozen for
            // life, which is why the two that carry the flag both have one.
            [Tag(name: "people")]
            [Test]
            public static method mating_holds_until_it_has_worked() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                Agent* her = Doing.someone(folk);
                Agent* him = Doing.someone(folk);
                him.identity.sex = Sex.Male;
                Kindred.bind(folk, 0, 1, Relation.Spouse, Kindred.WED);
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(0));
                Test.assertEqual(cast<int>(her.activity), cast<int>(Activity.Mating));
                Test.assertFalse(Activity.Mating.interruptible());
                // Starving does not shift her out of it...
                her.body.fed = new Gauge(0, 0, Body.FULL);
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(Doings.CHOOSE_EVERY));
                Test.assertEqual(cast<int>(her.activity), cast<int>(Activity.Mating));
                // ...but a child on the way does, because then she no longer wants it.
                her.body.carrying = 0;
                her.body.expecting = cast<byte>(1);
                Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(Doings.CHOOSE_EVERY * 2));
                Test.assertEqual(cast<int>(her.activity), cast<int>(Activity.Gathering));
                delete ways;
                delete folk;
                delete g;
                return;
            }

            // A CHILD IS DRAWN SMALLER THAN AN ADULT, and grows into its size by the age this world
            // already calls grown. That age is `Courting.OF_AGE` and not a number of the renderer's
            // own: the size a body is drawn at and the age it may marry at must not be able to
            // drift apart, and the way to guarantee that is for there to be one of them.
            [Tag(name: "people")]
            [Test]
            public static method a_child_is_drawn_smaller_than_a_grown_body() returns void {
                float newborn = GlWorld3D.grownness(0);
                float half = GlWorld3D.grownness(Courting.OF_AGE / 2);
                float grown = GlWorld3D.grownness(Courting.OF_AGE);
                float old = GlWorld3D.grownness(90);
                Test.assertTrue(newborn < half);
                Test.assertTrue(half < grown);
                Test.assertWithin(cast<double>(grown), 1.0, 0.0001);
                Test.assertWithin(cast<double>(old), 1.0, 0.0001);
                // Half at birth, which is the number, and it is a RATIO of the one person scale --
                // so a child's shadow is a child's shadow without anybody saying so twice.
                Test.assertWithin(cast<double>(newborn), 0.5, 0.0001);
                // And it never goes backwards on the way up.
                mutable float last = 0.0;
                for (int y in 0..30) {
                    float now = GlWorld3D.grownness(y);
                    Test.assertTrue(now >= last);
                    last = now;
                }
                return;
            }

            // AND A COUPLE WHO ARE TOGETHER MAKE CHILDREN OF IT, which is what moved conception off
            // the calendar: it used to be a yearly appointment every married woman kept whether or
            // not she had seen her husband that century.
            [Tag(name: "people")]
            [Test]
            public static method being_together_is_what_makes_a_child() returns void {
                Population* folk = new Population(Doing.SIDE, Doing.SIDE) on heap;
                mutable Grid* g = Doing.pasture();
                Waymap* ways = new Waymap(g, folk.standing().grid()) on heap;
                Agent* her = Doing.someone(folk);
                Agent* him = Doing.someone(folk);
                him.identity.sex = Sex.Male;
                Kindred.bind(folk, 0, 1, Relation.Spouse, Kindred.WED);
                mutable int spent = 0;
                while (her.body.carrying == Body.NOT_CARRYING && spent < 20 * Clock.TICKS_A_YEAR) {
                    Doings.tick(folk, 0 as Atlas*, g, ways, cast<long>(spent));
                    spent = spent + 1;
                }
                Test.assertTrue(her.body.carrying != Body.NOT_CARRYING);
                Test.assertBetween(cast<int>(her.body.expecting), 1, 5);
                delete ways;
                delete folk;
                delete g;
                return;
            }
        }
    }
}
