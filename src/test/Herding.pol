import System.IO.Console;
import System.Test.Test;
import Agents.Sim.Wild;
import Agents.Sim.Herd;
import Agents.Sim.HerdMood;
import Agents.Sim.BeastState;
import Agents.Sim.BeastId;
import Agents.Sim.HerdId;
import Agents.Sim.BlockChain;
import Agents.Sim.Chronicle;
import Agents.Sim.Grazing;
import Agents.Sim.Prowl;
import Agents.People.Population;
import Agents.World.Grid;
import Agents.World.Biome;
import Agents.World.Species;
import Agents.World.Beasts;
import Agents.World.Rng;
program AgentsExe;

// THE BLOCK INDEX AND THE HERD'S TICK -- the arithmetic underneath what the window shows.
//
// WHAT THIS SUITE IS FOR AND WHAT IT IS NOT. Whether a herd LOOKS like a herd is judged by running
// the game and looking at it, and there is no substitute for that. What a window cannot show is
// whether the index still agrees with where the animals actually are after ten thousand ticks of
// moving, dying and being swapped into each other's slots -- a disagreement there draws perfectly
// and behaves strangely, which is the most expensive kind of defect this project has met.
//
// THE GROUND IS MADE BY HAND, one biome written into a small grid, and that is deliberate. Generating
// terrain to check that an animal walks toward its herd would make the check depend on the coastline
// it happened to land on, and slow, and it would fail for reasons that have nothing to do with the
// thing under test.
public bundle Agents {
    public namespace Checks {

        public class Herding {
            public static fixed int SIDE = 96;

            // Ground a grazer can live on, everywhere. Prairie is in the Grassland band, which is
            // where the bison in these checks belong.
            private static method pasture() returns Grid* {
                mutable Grid* g = new Grid(Herding.SIDE, Herding.SIDE) on heap;
                for (int y in 0..Herding.SIDE) {
                    for (int x in 0..Herding.SIDE) {
                        g.setBiome(x, y, cast<int>(Biome.Prairie));
                    }
                }
                return g;
            }

            // A WORLD WITH NOBODY IN IT, which is what a fauna check is: from S2.8 a deer runs from
            // a hunter as well as from a wolf, so the herd tick takes the people too. These checks
            // are about what animals do to each other, and handing them an empty band says that in
            // the one place rather than leaving each of them to imply it.
            private static method nobody() returns Population* {
                return new Population(Herding.SIDE, Herding.SIDE) on heap;
            }

            // AN ANIMAL IS FILED UNDER THE BLOCK IT STANDS IN. The bake reads the world through this
            // and nothing else, so an animal in the wrong chain is an animal that is drawn in the
            // wrong place -- or not at all.
            [Tag(name: "fauna")]
            [Test]
            public static method an_animal_is_filed_where_it_stands() returns void {
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                BeastId b = w.bear(Species.Bison, 40.5, 24.5);
                BlockChain* chain = w.standing();
                BlockId block = chain.grid().ofCellClamped(40, 24);
                Test.assertEqual(cast<int>(chain.blockOf(cast<int>(b))), cast<int>(block));
                Test.assertEqual(chain.firstIn(block), cast<int>(b));
                Test.assertEqual(chain.countIn(block), 1);
                delete w;
                return;
            }

            // AND IT IS RE-FILED WHEN IT CROSSES A BORDER, which is the only moment the index costs
            // anything. A step inside the same block must cost nothing and change nothing.
            [Tag(name: "fauna")]
            [Test]
            public static method crossing_a_block_border_refiles_it() returns void {
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                BeastId b = w.bear(Species.Bison, 15.5, 15.5);
                BlockChain* chain = w.standing();
                BlockId was = chain.blockOf(cast<int>(b));
                // Still inside block (0,0): sixteen cells a side.
                w.placeAt(b, 14.5, 15.5);
                Test.assertEqual(cast<int>(chain.blockOf(cast<int>(b))), cast<int>(was));
                // And over the line into block (1,0).
                w.placeAt(b, 16.5, 15.5);
                BlockId now = chain.blockOf(cast<int>(b));
                Test.assertTrue(now != was);
                Test.assertEqual(cast<int>(now), cast<int>(chain.grid().ofCellClamped(16, 15)));
                Test.assertEqual(chain.countIn(was), 0);
                Test.assertEqual(chain.countIn(now), 1);
                delete w;
                return;
            }

            // A DEATH TAKES THE DEAD OUT AND KEEPS THE MOVER IN. The last animal moves into the dead
            // one's slot, so it is filed under a NEW slot number in the same block -- get that wrong
            // and the block holds a slot that belongs to nobody, which the bake will happily draw.
            [Tag(name: "fauna")]
            [Test]
            public static method a_death_leaves_the_block_true() returns void {
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                BeastId one = w.bear(Species.Bison, 40.5, 40.5);
                BeastId two = w.bear(Species.Bison, 41.5, 40.5);
                BlockChain* chain = w.standing();
                BlockId block = chain.grid().ofCellClamped(40, 40);
                Test.assertEqual(chain.countIn(block), 2);
                w.bury(one);
                Test.assertEqual(w.count(), 1);
                // One animal left, and it is the one that is still alive: slot 0, which is where the
                // survivor was moved to.
                Test.assertEqual(chain.countIn(block), 1);
                Test.assertEqual(chain.firstIn(block), 0);
                Test.assertEqual(cast<int>(chain.blockOf(0)), cast<int>(block));
                delete w;
                return;
            }

            // A HERD THAT SETS OUT ARRIVES, AND THEN GRAZES AGAIN. A mood that is entered and never
            // left is a herd that walks forever, which is exactly what an unbounded wall-follower
            // looked like in the build this one replaced.
            [Tag(name: "fauna")]
            [Test]
            public static method a_herd_that_sets_out_arrives_and_settles() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(11) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* h = w.gather(Species.Bison, 20.5, 20.5, 6.0);
                for (int i in 0..6) {
                    h.admit(w.bear(Species.Bison, 20.5, 20.5));
                }
                h.aimAt(48.5, 20.5);
                h.setMood(HerdMood.MovingOn);
                // A bison walks 1.7 cells a second, a tick is a sixtieth of a second, and it has
                // twenty-eight cells to cross: about a thousand ticks. The bound is what makes this
                // a test rather than a hang.
                mutable int spent = 0;
                while (spent < 4000 && cast<int>(h.mood()) == cast<int>(HerdMood.MovingOn)) {
                    Grazing.tick(w, none, g, cast<long>(spent + 1), rng, log);
                    spent = spent + 1;
                }
                Test.assertEqual(cast<int>(h.mood()), cast<int>(HerdMood.Drifting));
                Test.assertTrue(h.x() > 48.0 && h.x() < 49.0);
                // AND ITS ANIMALS CAME WITH IT — said as "with it" rather than as a coordinate.
                // The first version asked for `x > 40` and was reading the herd's leash indirectly:
                // an animal trails up to a full range behind the centre and wanders inside that
                // range while it does, so the number that passes depends on two things it was not
                // trying to test and drifts whenever either changes. What it means is that nothing
                // was left standing at 20 where it started.
                float reach = h.reach();
                float leash = (reach + 2.0) * (reach + 2.0);
                mutable int link = h.firstMember();
                while (link >= 0) {
                    BeastId b = h.memberAt(link);
                    float dx = w.xOf(b) - h.x();
                    float dy = w.yOf(b) - h.y();
                    Test.assertTrue(dx * dx + dy * dy < leash);
                    Test.assertEqual(cast<int>(w.stateOf(b)), cast<int>(BeastState.Grazing));
                    link = h.afterMember(link);
                }
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // THE ANIMALS STAY WITH THE HERD. This is the whole of "it reads as a herd": nobody has
            // to be told the group is a group, they are simply near each other and they move at the
            // same time. Checked as arithmetic here; checked by looking at it in the game.
            [Tag(name: "fauna")]
            [Test]
            public static method the_animals_stay_with_their_herd() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(3) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                float reach = 6.0;
                Herd* h = w.gather(Species.Bison, 48.5, 48.5, reach);
                for (int i in 0..10) {
                    h.admit(w.bear(Species.Bison, 48.5 + cast<float>(i) * 0.4, 48.5));
                }
                for (int t in 0..2000) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                mutable int link = h.firstMember();
                mutable int counted = 0;
                while (link >= 0) {
                    BeastId b = h.memberAt(link);
                    float dx = w.xOf(b) - h.x();
                    float dy = w.yOf(b) - h.y();
                    // Inside the range, with a cell of slack: an animal at the edge takes a wobble
                    // outward before it is pulled back on the tick after.
                    Test.assertTrue(dx * dx + dy * dy < (reach + 1.0) * (reach + 1.0));
                    counted = counted + 1;
                    link = h.afterMember(link);
                }
                // At LEAST the ten that started: two thousand ticks is over half a minute of world
                // time and a herd on good ground breeds. What is being checked is that every animal
                // in the herd is WITH the herd, whatever their number.
                Test.assertTrue(counted >= 10);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // AND THE INDEX STILL AGREES WITH THEM AFTERWARDS, which is the promise `Wild.slide` was
            // allowed to make in exchange for the tick's biggest saving.
            //
            // WHY THIS EXISTS: the hot move does NOT tell the index anything. It is the move an animal
            // makes on nineteen ticks out of twenty -- a fraction of a cell, inside the cell it is
            // already filed under -- and its whole value is that it skips the two float-to-int
            // conversions the index would need to work out a cell it would then find unchanged. That
            // is safe exactly while the caller's "it did not leave its cell" is true, and no other
            // time. Get it wrong and nothing crashes: the animal is drawn in one block and looked for
            // in another, so a wolf hunts past its nose and a herd is frightened by nothing, which
            // reads as a tuning problem for as long as anybody is willing to believe it.
            //
            // Two thousand ticks of the real tick, on real ground, and then EVERY animal alive is
            // asked. Sixteen hundred animals filed sixteen hundred times over -- there is no sampling
            // here, because one animal in the wrong chain is the whole defect.
            [Tag(name: "fauna")]
            [Test]
            public static method every_animal_is_filed_where_it_stands_after_a_thousand_steps()
                    returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(7) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                // Four herds, spread out, so animals cross cell and block borders in every direction.
                for (int k in 0..4) {
                    float cx = 20.5 + cast<float>(k % 2) * 40.0;
                    float cy = 20.5 + cast<float>(k / 2) * 40.0;
                    Herd* h = w.gather(Species.Bison, cx, cy, 8.0);
                    for (int i in 0..12) {
                        h.admit(w.bear(Species.Bison, cx + cast<float>(i) * 0.5, cy));
                    }
                }
                for (int t in 0..2000) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertEqual(w.indexAgrees(), 0);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // A WORLD RUN BY SIX HANDS IS THE WORLD ONE HAND MAKES, animal for animal.
            //
            // THIS IS THE CHECK THE WHOLE PARALLEL TICK STANDS ON, and there is no weaker version of
            // it worth having. "About the same number of animals" would pass with a pass that loses
            // a move every few thousand ticks; what is asked here is that after two thousand ticks
            // every animal is in the same slot, at the same coordinates to the last bit, in the same
            // state, with the same wind. If the two worlds have drifted at all, they have drifted for
            // a reason -- an animal moved twice, a crossing applied out of order, two hands writing
            // the same word -- and every one of those reasons is a defect that would otherwise show
            // up months later as behaviour nobody can explain.
            //
            // EXACT EQUALITY OF FLOATS, deliberately. The arithmetic is the same arithmetic in the
            // same order; nothing here is an average or a sum over animals, where a different order
            // would round differently. A tolerance would be admitting the two worlds are allowed to
            // differ, which is the opposite of the claim.
            [Tag(name: "fauna")]
            [Test]
            public static method a_world_run_by_six_hands_is_the_world_one_hand_makes() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* one = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                Wild* many = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                many.shareBetween(6);
                Test.assertEqual(many.crew().howManyHands(), 6);
                mutable Rng* diceOne = new Rng(11) on heap;
                mutable Rng* diceMany = new Rng(11) on heap;
                mutable Chronicle* logOne = new Chronicle() on heap;
                mutable Chronicle* logMany = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                // The same four herds in both worlds, sown identically.
                for (int k in 0..4) {
                    float cx = 20.5 + cast<float>(k % 2) * 40.0;
                    float cy = 20.5 + cast<float>(k / 2) * 40.0;
                    Herd* a = one.gather(Species.Bison, cx, cy, 8.0);
                    Herd* b = many.gather(Species.Bison, cx, cy, 8.0);
                    for (int i in 0..12) {
                        float x = cx + cast<float>(i) * 0.5;
                        a.admit(one.bear(Species.Bison, x, cy));
                        b.admit(many.bear(Species.Bison, x, cy));
                    }
                }
                for (int t in 0..2000) {
                    Grazing.tick(one, none, g, cast<long>(t + 1), diceOne, logOne);
                    Grazing.tick(many, none, g, cast<long>(t + 1), diceMany, logMany);
                }
                Test.assertEqual(many.count(), one.count());
                for (int i in 0..one.count()) {
                    BeastId b = cast<BeastId>(i);
                    Test.assertTrue(one.xOf(b) == many.xOf(b));
                    Test.assertTrue(one.yOf(b) == many.yOf(b));
                    Test.assertEqual(cast<int>(many.stateOf(b)), cast<int>(one.stateOf(b)));
                    Test.assertEqual(many.staminaOf(b), one.staminaOf(b));
                }
                // And both indexes still agree with their own animals.
                Test.assertEqual(one.indexAgrees(), 0);
                Test.assertEqual(many.indexAgrees(), 0);
                delete none;
                delete logMany;
                delete logOne;
                delete diceMany;
                delete diceOne;
                delete many;
                delete one;
                delete g;
                return;
            }

            // NOTHING WALKS INTO THE SEA. The habitat rule holds for every animal on every tick, and
            // the ONE exception is an animal crossing to somewhere else, which is why that state has
            // a name of its own.
            [Tag(name: "fauna")]
            [Test]
            public static method nothing_grazes_on_ground_it_cannot_live_on() returns void {
                mutable Grid* g = Herding.pasture();
                // The eastern half is open water.
                for (int y in 0..Herding.SIDE) {
                    for (int x in 48..Herding.SIDE) {
                        g.setBiome(x, y, cast<int>(Biome.Ocean));
                    }
                }
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(5) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                // Right up against the shore, where a drift of a tenth of a cell would take an
                // animal into the water if nothing stopped it.
                Herd* h = w.gather(Species.Bison, 47.0, 40.5, 5.0);
                for (int i in 0..8) {
                    h.admit(w.bear(Species.Bison, 47.2, 40.5));
                }
                for (int t in 0..1500) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                mutable int link = h.firstMember();
                while (link >= 0) {
                    BeastId b = h.memberAt(link);
                    int bx = cast<int>(w.xOf(b));
                    int by = cast<int>(w.yOf(b));
                    boolean crossing = cast<int>(w.stateOf(b)) == cast<int>(BeastState.Migrating);
                    if (!crossing) {
                        Test.assertTrue(Beasts.livesIn(cast<int>(Species.Bison), g.biomeAt(bx, by)));
                    }
                    link = h.afterMember(link);
                }
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // A PERSON WALKING TOWARD DEER SEES THEM GO -- the fauna spec calls that single
            // behaviour the difference between a world that feels inhabited and one that is
            // decorated. There are no people yet, so what it runs from here is the predator, through
            // the same comparison against the same `SHY` the hunter will walk into in S2.
            [Tag(name: "fauna")]
            [Test]
            public static method a_herd_runs_from_a_predator_that_comes_near() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(23) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* h = w.gather(Species.Bison, 40.5, 40.5, 6.0);
                for (int i in 0..6) {
                    h.admit(w.bear(Species.Bison, 40.5, 40.5));
                }
                // Well inside a bison's twelve cells of shyness, and standing still.
                BeastId wolf = w.bear(Species.Wolf, 32.5, 40.5);
                float wasAway = h.x() - w.xOf(wolf);

                // Long enough for a bison to run itself out: it notices on its first decision tick
                // (once a second, and this is the only herd), and a thousand of stamina at six a
                // tick is a hundred and sixty-seven ticks of flat-out running.
                mutable boolean everWinded = false;
                mutable int leastWind = 1000;
                for (int t in 0..280) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                    mutable int link = h.firstMember();
                    while (link >= 0) {
                        BeastId b = h.memberAt(link);
                        if (w.staminaOf(b) < leastWind) {
                            leastWind = w.staminaOf(b);
                        }
                        if (cast<int>(w.stateOf(b)) == cast<int>(BeastState.Winded)) {
                            everWinded = true;
                        }
                        link = h.afterMember(link);
                    }
                }
                // It noticed, it ran, and it ran AWAY -- a herd that flees toward the wolf is a herd
                // that has the sign wrong, which looks like flight and is the opposite of it.
                Test.assertTrue(w.frights() > 0);
                Test.assertTrue(h.x() - w.xOf(wolf) > wasAway + 5.0);
                // RUNNING COSTS. The stamina is the whole of the hunt: what is spent here is what a
                // hunter in S2 is racing against.
                Test.assertTrue(leastWind < 1000);
                Test.assertTrue(everWinded);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // AND A WOLF DOES NOT RUN FROM A WOLF. `SHY` is what a prey animal keeps between itself
            // and a predator; asking it of the predator is how a pack ends up fleeing itself.
            [Tag(name: "fauna")]
            [Test]
            public static method a_pack_does_not_flee_itself() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(29) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* pack = w.gather(Species.Wolf, 40.5, 40.5, 5.0);
                for (int i in 0..5) {
                    pack.admit(w.bear(Species.Wolf, 40.5 + cast<float>(i) * 0.3, 40.5));
                }
                for (int t in 0..120) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertEqual(cast<int>(w.frights()), 0);
                Test.assertTrue(cast<int>(pack.mood()) != cast<int>(HerdMood.Fleeing));
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // AND A GRAZING ANIMAL GETS ITS WIND BACK. Without this the first wolf a herd ever meets
            // leaves it permanently blown, and every herd in the world dies of a rule nobody wrote.
            [Tag(name: "fauna")]
            [Test]
            public static method grazing_is_also_getting_its_wind_back() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(31) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* h = w.gather(Species.Bison, 40.5, 40.5, 6.0);
                BeastId b = w.bear(Species.Bison, 40.5, 40.5);
                h.admit(b);
                w.setStaminaOf(b, 100);
                for (int t in 0..200) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertTrue(w.staminaOf(b) > 100);
                // And it never goes past full, or an animal that grazed all day would outrun one
                // that had not.
                Test.assertTrue(w.staminaOf(b) <= 1000);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // ---- the hunt ---------------------------------------------------------------------------
            //
            // Ground a wolf AND a reindeer both live on. The pasture above is Prairie, which is a
            // grassland: a wolf standing on it is a wolf that cannot take a step, because the
            // habitat rule refuses every move. Taiga is the cold band, where both belong.
            private static method taiga() returns Grid* {
                mutable Grid* g = new Grid(Herding.SIDE, Herding.SIDE) on heap;
                for (int y in 0..Herding.SIDE) {
                    for (int x in 0..Herding.SIDE) {
                        g.setBiome(x, y, cast<int>(Biome.Taiga));
                    }
                }
                return g;
            }

            // A KILL FEEDS THE PACK AND TAKES ONE ANIMAL OUT OF THE WORLD. Individuals, never herds,
            // and permanently -- which is the whole point of the slice: a population that can be
            // wiped out.
            [Tag(name: "fauna")]
            [Test]
            public static method a_pack_kills_and_a_kill_feeds_it() returns void {
                mutable Grid* g = Herding.taiga();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(37) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* pack = w.gather(Species.Wolf, 40.5, 40.5, 5.0);
                for (int i in 0..6) {
                    pack.admit(w.bear(Species.Wolf, 40.5, 40.5));
                }
                Herd* deer = w.gather(Species.Reindeer, 41.0, 40.5, 6.0);
                for (int i in 0..8) {
                    deer.admit(w.bear(Species.Reindeer, 41.0, 40.5));
                }
                // THE PACK IS ALREADY HUNGRY, said outright instead of waited for. Left to work
                // through its own larder it needs seventeen seconds, and by then the reindeer have
                // heard it and are half a map away -- so the test would be measuring whether a full
                // pack can catch a herd with a head start, which is a different question and not
                // this one. What is under test is: a hungry pack, prey beside it, does it kill.
                pack.goHungry(Prowl.FULL_LARDER);
                //
                // WHAT IS WATCHED IS THE LARDER RISING, not the world's headcount falling: animals
                // breed, so a world can be one kill lighter and two calves heavier in the same
                // minute, and a test that reads the total would be reading the wrong number.
                mutable int fullest = 0;
                for (int t in 0..3000) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                    if (pack.meals() > fullest) {
                        fullest = pack.meals();
                    }
                }
                Test.assertTrue(w.kills() > 0);
                // AND EATING IS WHAT A KILL IS FOR. A pack that hunts without being fed by it
                // starves beside a pile of carcasses -- so the larder, emptied at the start, has to
                // come back up, and only a kill can do that.
                Test.assertTrue(fullest > 0);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // AN AMBUSHER TAKES WHAT COMES TO IT AND NEVER SETS OUT. The crocodile is the slowest
            // animal in the table, so as a pursuit predator it could only catch prey that was
            // already blown, and it went extinct in every arc long enough to notice. Waiting makes
            // its slowness the point instead of the problem.
            //
            // What is checked is both halves: it kills what walks into its stretch of water, and it
            // is still standing where it started -- a hunter that CHASES would have moved.
            [Tag(name: "fauna")]
            [Test]
            public static method an_ambusher_waits_and_takes_what_comes() returns void {
                mutable Grid* g = new Grid(Herding.SIDE, Herding.SIDE) on heap;
                for (int y in 0..Herding.SIDE) {
                    for (int x in 0..Herding.SIDE) {
                        g.setBiome(x, y, cast<int>(Biome.Marsh));
                    }
                }
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(47) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* croc = w.gather(Species.Crocodile, 40.5, 40.5, 4.0);
                croc.admit(w.bear(Species.Crocodile, 40.5, 40.5));
                croc.admit(w.bear(Species.Crocodile, 40.7, 40.5));
                croc.goHungry(Prowl.FULL_LARDER);
                float satAt = croc.x();
                // Boar, which the table puts in the wetlands for exactly this reason: without them
                // the marsh has a predator and nothing at all to hunt.
                Herd* boar = w.gather(Species.Boar, 43.0, 40.5, 5.0);
                for (int i in 0..5) {
                    boar.admit(w.bear(Species.Boar, 43.0, 40.5));
                }
                for (int t in 0..2000) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertTrue(w.kills() > 0);
                // It never went anywhere to do it.
                Test.assertTrue(croc.x() - satAt < 2.0 && satAt - croc.x() < 2.0);
                Test.assertTrue(cast<int>(croc.mood()) != cast<int>(HerdMood.Hunting));
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // A PREDATOR WITH NOTHING TO CATCH STARVES, and its pack shrinks. That is the loop that
            // keeps predator and prey in some relation without anybody writing an equation for it --
            // and, three slices from now, it is how over-hunting by people reaches the wolves.
            [Tag(name: "fauna")]
            [Test]
            public static method a_pack_with_nothing_to_catch_starves() returns void {
                mutable Grid* g = Herding.taiga();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(41) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* pack = w.gather(Species.Wolf, 40.5, 40.5, 5.0);
                for (int i in 0..6) {
                    pack.admit(w.bear(Species.Wolf, 40.5, 40.5));
                }
                // Empty ground, no prey anywhere: 400 of larder against six mouths a second is 67
                // seconds, and then 45 more before it costs the pack one of its own.
                for (int t in 0..7200) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertTrue(w.starvations() > 0);
                Test.assertTrue(w.howMany(Species.Wolf) < 6);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // AND THE LAST ONE IS THE LAST ONE. When a species is gone it is gone for good -- no
            // respawn, no hidden reserve, no quiet re-seed -- and the world says so, with what did
            // it, on the tick it happens rather than in a total at the end.
            //
            // It also proves the herd that emptied is not left standing: a roster with nobody in it,
            // walked and thought for every tick forever, is the leak that predators guarantee.
            [Tag(name: "fauna")]
            [Test]
            public static method the_last_of_a_species_is_gone_for_good() returns void {
                mutable Grid* g = Herding.taiga();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(43) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* pack = w.gather(Species.Wolf, 40.5, 40.5, 5.0);
                for (int i in 0..6) {
                    pack.admit(w.bear(Species.Wolf, 40.5, 40.5));
                }
                Herd* deer = w.gather(Species.Reindeer, 41.0, 40.5, 6.0);
                deer.admit(w.bear(Species.Reindeer, 41.0, 40.5));
                Test.assertEqual(w.herdsAlive(), 2);
                for (int t in 0..3000) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertEqual(w.howMany(Species.Reindeer), 0);
                Test.assertEqual(w.speciesLost(), 1);
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }

            // A HERD THAT HAS LOST ITS LAST ANIMAL IS NOT LEFT STANDING -- walked, thought for and
            // counted every tick forever, holding a roster of nobody. Harmless while nothing died;
            // predators make it certain, so it is checked directly rather than as a side effect of
            // an arc that has to go a particular way.
            [Tag(name: "fauna")]
            [Test]
            public static method an_emptied_herd_is_disbanded() returns void {
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                Herd* one = w.gather(Species.Reindeer, 20.5, 20.5, 5.0);
                Herd* two = w.gather(Species.Reindeer, 60.5, 60.5, 5.0);
                BeastId only = w.bear(Species.Reindeer, 20.5, 20.5);
                two.admit(w.bear(Species.Reindeer, 60.5, 60.5));
                Test.assertEqual(w.herdsAlive(), 2);
                one.admit(only);
                w.eaten(only, 1, log);
                Test.assertEqual(w.herdsAlive(), 1);
                // AND THE SURVIVING HERD KNOWS ITS NEW NUMBER, both ends of it: the last herd was
                // moved into the freed slot, so its animals have to be pointing at where it is now
                // rather than at where it was.
                Herd* left = w.herdAt(cast<HerdId>(0));
                int link = left.firstMember();
                Test.assertEqual(cast<int>(w.herdOf(left.memberAt(link))), cast<int>(left.id()));
                Test.assertEqual(cast<int>(left.id()), 0);
                delete none;
                delete log;
                delete w;
                return;
            }

            // A HERD OVER ITS SPECIES' NUMBER SPLITS, AND THE DAUGHTER LEAVES. Nothing in S1 makes a
            // herd grow yet -- breeding is S1.8 -- so this is the only place the path runs. A branch
            // that is written and never taken until three slices later is a branch that is wrong when
            // it is finally taken.
            [Tag(name: "fauna")]
            [Test]
            public static method a_herd_that_outgrows_itself_splits() returns void {
                mutable Grid* g = Herding.pasture();
                Wild* w = new Wild(Herding.SIDE, Herding.SIDE) on heap;
                mutable Rng* rng = new Rng(19) on heap;
                mutable Chronicle* log = new Chronicle() on heap;
                mutable Population* none = Herding.nobody();
                int most = Beasts.herd(cast<int>(Species.Bison));
                Herd* h = w.gather(Species.Bison, 40.5, 40.5, 8.0);
                for (int i in 0..most + 6) {
                    h.admit(w.bear(Species.Bison, 40.5, 40.5));
                }
                Test.assertEqual(w.herdsAlive(), 1);
                // A HERD DECIDES ONCE A SECOND, not every tick, so one tick is not enough to be sure
                // this herd's turn came up -- which tick it decides on depends on its place in the
                // array. DECIDE_EVERY of them covers every herd in the world exactly once.
                for (int t in 0..Grazing.DECIDE_EVERY) {
                    Grazing.tick(w, none, g, cast<long>(t + 1), rng, log);
                }
                Test.assertEqual(w.herdsAlive(), 2);
                Herd* daughter = w.herdAt(cast<HerdId>(1));
                int left = (most + 6) / 2;
                Test.assertEqual(daughter.count(), left);
                Test.assertEqual(h.count(), most + 6 - left);
                // She is on her way somewhere, and her animals know they are crossing.
                Test.assertEqual(cast<int>(daughter.mood()), cast<int>(HerdMood.MovingOn));
                int link = daughter.firstMember();
                Test.assertEqual(cast<int>(w.stateOf(daughter.memberAt(link))),
                                 cast<int>(BeastState.Migrating));
                // And both rosters still agree with the animals about who belongs to whom.
                Test.assertEqual(cast<int>(w.herdOf(daughter.memberAt(link))),
                                 cast<int>(daughter.id()));
                delete none;
                delete log;
                delete rng;
                delete w;
                delete g;
                return;
            }
        }
    }
}
