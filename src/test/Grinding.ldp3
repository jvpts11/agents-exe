import Agents.Sim.Shift;
program AgentsExe;

// WORK THAT CANNOT BE DONE BY THINKING ABOUT IT, for measuring whether hands actually share.
//
// The first version of this check added up the numbers from 0 to n and asked whether six hands beat
// one. One hand did it in nought microseconds: a sum of a run of integers has a closed form and the
// optimiser knows it, so what was being timed was a multiplication. A timing check whose work can
// be folded away measures the optimiser, not the crew.
//
// Each step here depends on the one before -- a multiply, an add and a shift, chained -- so the
// answer cannot be reached without walking every step, and the walk is the same length however the
// work is split. Deterministic, so one hand and six must agree on the total.
public bundle Agents {
    public namespace Checks {

        public class Grinding implements Shift {
            private mutable long[] tallies;
            private mutable int upTo;
            private mutable int rounds;

            public constructor Grinding(int hands, int upTo, int rounds) {
                tallies = new long[hands]();
                this.upTo = upTo;
                this.rounds = rounds;
            }

            public destructor ~Grinding() returns void {
                delete tallies;
                return;
            }

            public override method part(int mine, int parts) returns void {
                int from = upTo * mine / parts;
                int upToHere = upTo * (mine + 1) / parts;
                mutable long sum = cast<long>(0);
                for (int i in from..upToHere) {
                    mutable long v = cast<long>(i) + cast<long>(1);
                    for (int r in 0..rounds) {
                        v = v * cast<long>(6364136223846793005);
                        v = v ^ (v >> 29);
                    }
                    sum = sum + v;
                }
                tallies[mine] = sum;
                return;
            }

            public method total() returns long {
                mutable long all = cast<long>(0);
                for (int i in 0..tallies.length()) {
                    all = all + tallies[i];
                }
                return all;
            }
        }
    }
}
