import System.IO.Console;
import System.Test.Test;
import Agents.Sim.Sim;
program AgentsExe;

// HOW THE WORLD ADVANCES, which is the one piece of the harness that is arithmetic rather than
// plumbing -- and arithmetic that took three attempts to get right the first time round.
//
// The world advances a WHOLE number of times or not at all. Everything here is about that: a
// fraction carried between frames rather than rounded away, a ceiling so one slow frame cannot
// spend the whole of the next one simulating, and a count of what the ceiling refused.
public bundle Agents {
    public namespace Checks {

        public class Ticking {

            // The ordinary case, and the one a rounding bug would break silently: one tick asked
            // for, one tick run.
            [Tag(name: "sim")]
            [Test]
            public static method a_whole_pace_advances_the_world_once_per_call() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(1.0), 1);
                Test.assertEqual(s.advance(1.0), 1);
                Test.assertEqual(cast<int>(s.age()), 2);
                return;
            }

            // A FRACTION IS CARRIED, NOT ROUNDED. Rounded down, a pace below one never advances the
            // world at all; rounded up, every pace becomes at least one tick a frame and the slow
            // gears all run at the same speed. Carried, half a tick twice is one tick.
            [Tag(name: "sim")]
            [Test]
            public static method a_fraction_of_a_tick_is_carried_to_the_next_call() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(0.5), 0);
                Test.assertEqual(s.advance(0.5), 1);
                Test.assertEqual(cast<int>(s.age()), 1);
                return;
            }

            // The ceiling exists so a machine that cannot keep up still answers its keyboard --
            // including the key that would slow it back down.
            [Tag(name: "sim")]
            [Test]
            public static method one_call_never_runs_more_than_the_ceiling() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(1000.0), Sim.CEILING);
                return;
            }

            // AND WHAT THE CEILING REFUSED IS COUNTED. This is the test that fails today: the
            // comment above the loop promises "the shortfall is counted" and names the defect it
            // repeats -- a speed on the screen the world never ran at -- and then the code drops
            // the backlog with `owed = 0.0` and counts nothing.
            //
            // Without it, a gear the machine cannot sustain looks identical to one it can: the
            // window says x6, the world goes at x1.3, and every number measured off that run is
            // labelled with a speed it never had.
            [Tag(name: "sim")]
            [Test]
            public static method the_ticks_the_ceiling_refused_are_counted() returns void {
                Sim s = new Sim() on stack;
                s.advance(1000.0);
                Test.assertTrue(s.missed() > 0);
                return;
            }

            // A world that is keeping up owes nothing and has missed nothing. The counter has to
            // stay at zero for the number above it to mean anything.
            [Tag(name: "sim")]
            [Test]
            public static method a_world_that_keeps_up_never_reports_a_shortfall() returns void {
                Sim s = new Sim() on stack;
                for (int i in 0..100) {
                    s.advance(2.0);
                }
                Test.assertEqual(cast<int>(s.age()), 200);
                Test.assertEqual(cast<int>(s.missed()), 0);
                return;
            }
        }
    }
}
