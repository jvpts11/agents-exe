import System.IO.Console;
import System.Test.Test;
import Agents.Sim.Sim;
program AgentsExe;

// HOW THE WORLD ADVANCES, which is the one piece of the harness that is arithmetic rather than
// plumbing -- and arithmetic that took three attempts to get right the first time round.
//
// The world advances a WHOLE number of times or not at all. Everything here is about that: a
// fraction carried between frames rather than rounded away, a ceiling so one slow frame cannot
// spend the whole of the next one simulating, and a count of what the ceiling refused.
public bundle Agents {
    public namespace Checks {

        public class Ticking {

            // The ordinary case, and the one a rounding bug would break silently: one tick asked
            // for, one tick run.
            [Tag(name: "sim")]
            [Test]
            public static method a_whole_pace_advances_the_world_once_per_call() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(1.0, Sim.BUDGET_MS), 1);
                Test.assertEqual(s.advance(1.0, Sim.BUDGET_MS), 1);
                Test.assertEqual(cast<int>(s.age()), 2);
                return;
            }

            // A FRACTION IS CARRIED, NOT ROUNDED. Rounded down, a pace below one never advances the
            // world at all; rounded up, every pace becomes at least one tick a frame and the slow
            // gears all run at the same speed. Carried, half a tick twice is one tick.
            [Tag(name: "sim")]
            [Test]
            public static method a_fraction_of_a_tick_is_carried_to_the_next_call() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(0.5, Sim.BUDGET_MS), 0);
                Test.assertEqual(s.advance(0.5, Sim.BUDGET_MS), 1);
                Test.assertEqual(cast<int>(s.age()), 1);
                return;
            }

            // THE CEILING IS TIME, AND ASKING FOR A LOT OF FREE WORK GETS ALL OF IT. This is the
            // test that defect S0-5 fails: under a ceiling of 64 TICKS, gear 6's three hundred
            // could never be run -- not "this machine cannot keep up" but arithmetic, on every
            // machine, always. An empty tick costs nothing, so nothing is refused.
            [Tag(name: "sim")]
            [Test]
            public static method a_pace_that_fits_in_the_budget_runs_whole() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(300.0, Sim.BUDGET_MS), 300);
                Test.assertEqual(cast<int>(s.missed()), 0);
                return;
            }

            // No budget still advances the world ONCE. A frame that advances it not at all is a
            // frozen world, and a machine too slow for a single tick should crawl rather than stop.
            [Tag(name: "sim")]
            [Test]
            public static method no_time_at_all_still_advances_the_world_once() returns void {
                Sim s = new Sim() on stack;
                Test.assertEqual(s.advance(50.0, 0), 1);
                return;
            }

            // AND WHAT THE BUDGET REFUSED IS COUNTED. The comment on the old loop promised "the
            // shortfall is counted" and named the defect it repeats -- a speed on the screen the
            // world never ran at -- and then dropped the backlog with `owed = 0.0` and counted
            // nothing.
            //
            // Without it, a pace the machine cannot sustain looks identical to one it can: the
            // window says x6, the world goes at x1.3, and every number measured off that run is
            // labelled with a speed it never had.
            [Tag(name: "sim")]
            [Test]
            public static method the_ticks_the_budget_refused_are_counted() returns void {
                Sim s = new Sim() on stack;
                s.advance(50.0, 0);
                Test.assertEqual(cast<int>(s.missed()), 49);
                return;
            }

            // A world that is keeping up owes nothing and has missed nothing. The counter has to
            // stay at zero for the number above it to mean anything.
            [Tag(name: "sim")]
            [Test]
            public static method a_world_that_keeps_up_never_reports_a_shortfall() returns void {
                Sim s = new Sim() on stack;
                for (int i in 0..100) {
                    s.advance(2.0, Sim.BUDGET_MS);
                }
                Test.assertEqual(cast<int>(s.age()), 200);
                Test.assertEqual(cast<int>(s.missed()), 0);
                return;
            }
        }
    }
}
