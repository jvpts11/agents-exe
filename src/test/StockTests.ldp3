import System.IO.Console;
import System.Test.Test;
import Agents.Sim.Nations;
import Agents.Sim.Rank;
import Agents.Sim.Stores;
import Agents.World.Good;
program AgentsExe;

// Civilizations, as arithmetic on a table.
//
// A civilization is not declared, joined or founded -- it is the set of nations that turn out to
// share a trunk, the same way a rank is what a nation's holdings add up to. Everything here checks
// that the trunk really does survive the two things that would otherwise destroy it: a people
// breaking away, and a language drifting until it is a different language.

public bundle Agents {
    public namespace Checks {

        public class Stocks {

            // A SACK IS NOT A SHOPPING TRIP.
            //
            // A raiding party walks off with the one edible good a place has most of -- that is what
            // `richest` and `seize` are for, and between them they were the only way anything ever
            // left a shelf against its owner's will. An army standing in a town it has just broken
            // open does something else entirely: it takes a share of EVERYTHING, the grain and the
            // iron and the cloth alike, and that is the whole difference between a village being
            // raided and a town being sacked.
            [Tag(name: "war")]
            [Test]
            public static method a_sack_takes_a_share_of_every_shelf() returns void {
                Stores* shelves = new Stores(4) on heap;
                shelves.stow(1, cast<int>(Good.Grain), 100);
                shelves.stow(1, cast<int>(Good.IronIngot), 40);
                shelves.stow(1, cast<int>(Good.Cloth), 9);
                shelves.stow(2, cast<int>(Good.Grain), 80);

                int carried = shelves.ransack(1, 2);
                Test.checking("the army walked off with half of everything, not half of one thing");
                Test.assertEqual(carried, 50 + 20 + 4);
                Test.checking("and the grain is down by exactly that half");
                Test.assertEqual(shelves.amountOf(1, cast<int>(Good.Grain)), 50);
                Test.checking("the iron too, which no raid has ever touched");
                Test.assertEqual(shelves.amountOf(1, cast<int>(Good.IronIngot)), 20);
                Test.checking("and an odd number leaves the remainder behind");
                Test.assertEqual(shelves.amountOf(1, cast<int>(Good.Cloth)), 5);
                Test.checking("the town next door was not in this battle and lost nothing");
                Test.assertEqual(shelves.amountOf(2, cast<int>(Good.Grain)), 80);

                Test.checking("sacking an empty town carries nothing off and does not fail");
                Test.assertEqual(shelves.ransack(3, 2), 0);
                delete shelves;
                return;
            }

            // TWO COUNTRIES CAN NOW DO SOMETHING TO EACH OTHER THAT IS NOT VIOLENCE.
            //
            // Until this, the answer to "how do these two get on" was war or nothing: a grudge sent
            // an army, the army went home, the grudge stayed and another army came. Nothing anybody
            // did could make it better, so a border once soured was soured for ever and the map was
            // a ratchet that only ever tightened.
            //
            // Bounded at BOTH ends, and that is the part worth testing. A long peace must not make a
            // country unattackable for ever and a long feud must not become unforgivable -- either
            // one turns the ratchet back on with a different sign.
            [Tag(name: "war")]
            [Test]
            public static method a_border_can_warm_as_well_as_sour() returns void {
                Nations* realm = new Nations(8, 4, 4) on heap;
                Test.checking("two countries start indifferent to each other");
                Test.assertEqual(realm.bondOf(1, 2), 0);
                realm.warm(1, 2, 40);
                Test.checking("a caravan across the border warms it, and both sides know");
                Test.assertEqual(realm.bondOf(1, 2), 40);
                Test.assertEqual(realm.bondOf(2, 1), 40);
                realm.warm(1, 2, 0 - 150);
                Test.checking("a town taken undoes far more than it built");
                Test.assertEqual(realm.bondOf(1, 2), 0 - 110);
                realm.warm(1, 2, 0 - 100000);
                Test.checking("a feud bottoms out rather than becoming unforgivable");
                Test.assertEqual(realm.bondOf(1, 2), 0 - Nations.BOND_CAP);
                realm.warm(1, 2, 100000);
                Test.checking("and a friendship tops out rather than making anybody untouchable");
                Test.assertEqual(realm.bondOf(1, 2), Nations.BOND_CAP);
                Test.checking("which reads as one alliance, not two");
                Test.assertEqual(realm.alliances(), 1);
                Test.checking("and nobody is allied with themselves");
                Test.assertEqual(realm.bondOf(3, 3), 0);
                delete realm;
                return;
            }

            // The one rule the whole idea rests on. A nation that breaks away is a new country with
            // a new number and, eventually, a new language -- but it is the SAME PEOPLE, and if the
            // trunk did not survive that, no civilization would ever have more than one country in
            // it and the word would mean nothing.
            [Tag(name: "stock")]
            [Test]
            public static method breaking_away_does_not_leave_the_family() returns void {
                Nations* realm = new Nations(8, 4, 4) on heap;
                realm.raise(0, 0, 0 - 1, 0, 1);
                realm.settleTrunk(0, 0);
                realm.raise(1, 0, 0, 100, 1);        // broke from 0, keeps its tongue
                Test.checking("a daughter is of her mother's stock");
                Test.assertEqual(realm.trunkOf(1), realm.trunkOf(0));
                Test.checking("and the two are the same people");
                Test.assertTrue(realm.sameStock(0, 1));
                // A grand-daughter of the same line, two removes down.
                realm.raise(2, 0, 1, 200, 1);
                Test.checking("and so is a daughter of the daughter");
                Test.assertTrue(realm.sameStock(0, 2));
                // Somebody from another hearth entirely is not.
                realm.raise(3, 3, 0 - 1, 0, 1);
                realm.settleTrunk(3, 3);
                Test.checking("a people from another hearth is not of the family");
                Test.assertTrue(!realm.sameStock(0, 3));
                delete realm;
                return;
            }

            // Speech moves and the family does not. This is the second thing that would sink the
            // idea: if a language splitting reset the trunk, a civilization would dissolve exactly
            // when it got old enough to be interesting.
            [Tag(name: "stock")]
            [Test]
            public static method a_language_splits_and_the_stock_holds() returns void {
                Nations* realm = new Nations(4, 4, 4) on heap;
                realm.raise(0, 0, 0 - 1, 0, 1);
                realm.settleTrunk(0, 0);
                realm.raise(1, 0, 0, 10, 1);
                realm.settleTrunk(1, 0);
                realm.countTown(1, 5, 400);          // somebody has to be alive to speak
                int spoke = realm.tongueOf(1);
                Test.checking("mother and daughter begin speaking one language");
                Test.assertEqual(spoke, realm.tongueOf(0));
                // Long enough that the drift must have passed the split, whatever the nudges were.
                mutable int t = 0;
                while (t < Nations.SPLIT_DRIFT) {
                    realm.wag(1, 7, t);
                    t = t + 1;
                }
                Test.checking("far enough apart and it is a different language");
                Test.assertTrue(realm.tongueOf(1) != spoke);
                Test.checking("but the same stock, which is the whole point");
                Test.assertTrue(realm.sameStock(0, 1));
                delete realm;
                return;
            }

            // A name has to be a fact about the thing, not about when you asked. Two runs of one
            // seed produce the same world, and a people whose name changed between the report and
            // the map would be two peoples as far as anybody reading it is concerned.
            [Tag(name: "stock")]
            [Test]
            public static method a_people_is_called_the_same_thing_every_time() returns void {
                String a = Nations.stockName(19);
                String b = Nations.stockName(19);
                Test.checking("the same stock gives the same name twice");
                Test.assertTrue(a.equals(b));
                Test.checking("and it is a word, not an empty string");
                Test.assertAtLeast(a.length(), 4);
                mutable int different = 0;
                for (int i in 0..40) {
                    if (!Nations.stockName(i).equals(a)) {
                        different = different + 1;
                    }
                }
                // Not all forty need be distinct -- syllables collide -- but a generator that
                // returned one word for everything would name the whole world the same thing.
                Test.checking("and different stocks are mostly called different things");
                Test.assertAtLeast(different, 30);
                return;
            }

            // The banner is what the map is coloured from. Everybody of one stock has to read as a
            // family, and the countries within it still have to be told apart -- if either half
            // fails the overlay is useless in a different way.
            [Tag(name: "stock")]
            [Test]
            public static method one_stock_is_one_family_of_colour() returns void {
                int a = Nations.banner(11, 3);
                int b = Nations.banner(11, 4);
                int other = Nations.banner(29, 3);
                Test.checking("two countries of one stock are not the same colour");
                Test.assertTrue(a != b);
                // Same family: each channel within a shade of the other, since the only difference
                // between them is the per-nation lightness.
                int dr = Stocks.gap((a >> 16) & 255, (b >> 16) & 255);
                int dg = Stocks.gap((a >> 8) & 255, (b >> 8) & 255);
                int db = Stocks.gap(a & 255, b & 255);
                Test.checking("but they are shades of one hue");
                Test.assertAtMost(dr + dg + db, 120);
                int er = Stocks.gap((a >> 16) & 255, (other >> 16) & 255);
                int eg = Stocks.gap((a >> 8) & 255, (other >> 8) & 255);
                int eb = Stocks.gap(a & 255, (other & 255));
                Test.checking("and another stock is a different hue altogether");
                Test.assertAtLeast(er + eg + eb, 60);
                Test.checking("nothing comes out as mud");
                Test.assertAtLeast((a >> 16) & 255, 30);
                Test.assertAtLeast((a >> 8) & 255, 30);
                Test.assertAtLeast(a & 255, 30);
                return;
            }

            private static method gap(int a, int b) returns int {
                if (a > b) {
                    return a - b;
                }
                return b - a;
            }

            // Counting. A world of one stock and a world where every country is its own are both
            // possible states and both have to come out right, because the first is what conquest
            // tends toward and the second is what the world looks like before the hearths are seeded.
            [Tag(name: "stock")]
            [Test]
            public static method the_count_of_peoples_is_what_it_looks_like() returns void {
                Nations* realm = new Nations(8, 4, 4) on heap;
                for (int i in 0..4) {
                    realm.raise(i, i, 0 - 1, 0, 1);
                    realm.settleTrunk(i, 0);          // all one people, all one language
                    realm.countTown(i, i, 100);
                }
                Test.checking("four countries of one stock are one civilization");
                Test.assertEqual(realm.civilizations(), 1);
                Test.checking("and it holds all four of them");
                Test.assertEqual(realm.nationsOfStock(0), 4);
                // Founded together, so they begin speaking ONE language -- that is the whole point
                // of seeding the tongue with the stock, and without it "two peoples who speak the
                // same language" was a thing that never happened anywhere in a whole arc.
                Test.checking("and they begin speaking one language between them");
                Test.assertEqual(realm.livingTongues(), 1);
                // Until one of them drifts far enough to be speaking something else.
                mutable int t = 0;
                while (t < Nations.SPLIT_DRIFT) {
                    realm.wag(2, 11, t);
                    t = t + 1;
                }
                Test.checking("and two once one of them has drifted apart");
                Test.assertEqual(realm.livingTongues(), 2);
                Test.checking("without the civilization coming apart with it");
                Test.assertEqual(realm.civilizations(), 1);
                Test.checking("and it is the widest there is");
                Test.assertEqual(realm.widestStock(), 0);
                delete realm;
                return;
            }
        }
    }
}
