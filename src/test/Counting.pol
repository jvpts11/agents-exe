import Agents.Sim.Shift;
program AgentsExe;

// A JOB WITH A KNOWN ANSWER, so a crew can be checked rather than trusted.
//
// Each hand adds up its own share of the numbers from 0 to n and leaves the total in its own slot,
// so no two hands write the same word and the sum of the slots is the sum of the whole -- which is
// a number arithmetic knows in advance. `weight` is how many times each number is added, so the
// same check can be run with a round that costs nothing (to measure what a round itself costs) and
// with a round that costs real work (to see the hands actually sharing it).
public bundle Agents {
    public namespace Checks {

        public class Counting implements Shift {
            private mutable long[] tallies;
            private mutable int upTo;
            private mutable int weight;

            public constructor Counting(int hands, int upTo, int weight) {
                tallies = new long[hands]();
                this.upTo = upTo;
                this.weight = weight;
            }

            public destructor ~Counting() returns void {
                delete tallies;
                return;
            }

            public override method part(int mine, int parts) returns void {
                int from = upTo * mine / parts;
                int upToHere = upTo * (mine + 1) / parts;
                mutable long sum = cast<long>(0);
                for (int i in from..upToHere) {
                    for (int w in 0..weight) {
                        sum = sum + cast<long>(i);
                    }
                }
                tallies[mine] = sum;
                return;
            }

            public method total() returns long {
                mutable long all = cast<long>(0);
                for (int i in 0..tallies.length()) {
                    all = all + tallies[i];
                }
                return all;
            }

            public method clear() returns void {
                for (int i in 0..tallies.length()) {
                    tallies[i] = cast<long>(0);
                }
                return;
            }
        }
    }
}
