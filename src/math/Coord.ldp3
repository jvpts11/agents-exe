import System.IO.Console;

// A grid cell with value semantics -- assignment copies, so a nation's capital is a self-contained
// point, never a shared reference. Distances come in the two flavours the sim actually needs: squared
// Euclidean (nearest-of comparisons never want the sqrt) and Manhattan (whole grid steps). The way the
// original leaned on UnityEngine.Vector2Int; here it is a real value struct with an overloaded minus.
program AgentsExe;

public bundle Agents {
    public namespace Math {

        public struct Coord {
            public mutable int x;
            public mutable int y;

            public constructor Coord(int x, int y) {
                this.x = x;
                this.y = y;
            }

            public operator - (Coord o) returns Coord {
                return new Coord(this.x - o.x, this.y - o.y);
            }

            public method distanceSqTo(Coord o) returns int {
                int dx = this.x - o.x;
                int dy = this.y - o.y;
                return dx * dx + dy * dy;
            }

            public method manhattanTo(Coord o) returns int {
                mutable int dx = this.x - o.x;
                mutable int dy = this.y - o.y;
                if (dx < 0) {
                    dx = 0 - dx;
                }
                if (dy < 0) {
                    dy = 0 - dy;
                }
                return dx + dy;
            }
        }
    }
}
